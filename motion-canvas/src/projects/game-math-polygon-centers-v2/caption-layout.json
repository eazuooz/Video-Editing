      396,
      928,
      1128,
      84
    ],
    "center": [
      960,
      970
    ],
    "shadow": [
      14,
      14
    ]
  },
  {
    "cue": 146,
    "scene": "12",
    "start": 687.179875,
    "end": 693.0598749999999,
    "text": "여섯 꼭짓점이면 칠백이십 도입니다. 각도 합이 맞는다는\n이유만으로 볼록하다고 판정할 수 없습니다.",
