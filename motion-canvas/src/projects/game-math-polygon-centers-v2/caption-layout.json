      386,
      928,
      1148,
      84
    ],
    "center": [
      960,
      970
    ],
    "shadow": [
      14,
      14
    ]
  },
  {
    "cue": 149,
    "scene": "QF02",
    "start": 703.0999999999999,
    "end": 709.1599999999999,
    "text": "무엇을 같게 할지 정해 중심을 골랐고, 순서대로 이어진\n경계에서 홈도 확인했습니다.",
    "box": [
      345,
      897,
      1230,
      146
    ],
    "center": [
      960,
      970
    ],
    "shadow": [
      14,
      14
