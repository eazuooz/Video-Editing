    {
      "kind": "original-paragraph",
      "originalIndex": 40,
      "scene": "15a",
      "chapterIndex": 6,
      "paragraphIndex": 3,
      "text": "독립 도식에서는 벽 양쪽의 프로브와 한 수광점을 깊이로 나눠 놓겠습니다. 가까운 점이라는 이유만으로 양쪽을 똑같이 섞는 경우와, 가림을 고려해 기여를 줄이는 경우를 비교합니다.",
      "originalExplanationPreserved": true,
      "sourceModel": "ddgi",
      "posePair": [
        4,
        5
      ],
      "motionSeconds": [
        516.1600000000001,
        518.6400000000001
      ],
      "sourceSelected": false,
