  "QF11": {
    "id": "QF11",
    "ttsProject": "game-math-quaternion-cross-game-additions-v3",
    "ttsScene": "03",
    "sourceType": "supplement",
    "sceneSourceModule": "quaternion_four_game_v3",
    "voice": "shared/output/narration/game-math-quaternion-cross-game-additions-v3/qwen3-1.7b-balanced-v1/chunks/03-scene.wav",
    "voiceSha256": "40fda2f2667e5a35f17bffcc123a2e5460e6e7e712302a2a5861e753a2ffc547",
    "voiceSeconds": 24.840041666666668,
