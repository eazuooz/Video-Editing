  "QF21": {
    "id": "QF21",
    "ttsProject": "game-math-quaternion-cross-game-additions-v3",
    "ttsScene": "05",
    "sourceType": "supplement",
    "sceneSourceModule": "quaternion_four_game_v3",
    "voice": "shared/output/narration/game-math-quaternion-cross-game-additions-v3/qwen3-1.7b-balanced-v1/chunks/05-scene.wav",
    "voiceSha256": "73cb6ac988ad6e2cf74b454e77ec581a844d03d6c61414a64bddae7cbd3c1730",
    "voiceSeconds": 27.16,
    "seconds": 27.76,
    "lineStarts": [
      0.0,
      16.82
    ],
    "lineEnds": [
      16.36,
      27.14
    ],
    "matchingCharacterCoverage": 0.9875776397515528,
    "captions": {
      "ko": [
        {
          "start": 0.0,
          "end": 2.66,
          "text": "세워졌다고 방향이 모두 같지는 않습니다.",
          "line": 0
        },
        {
          "start": 2.88,
          "end": 8.464,
          "text": "정확히 되돌리는 계산은 모형에서 확인하겠습니다. 이제\n계산용 모형의 처음 방향을 일,",
          "line": 0
        },
        {
          "start": 8.464,
          "end": 12.260000000000002,
          "text": "영, 영으로 둡니다. 제트축으로 구십 도 돌리면 영, 일,",
          "line": 0
        },
        {
          "start": 12.260000000000002,
          "end": 16.36,
          "text": "영이 됩니다. 반대 구십 도를 적용하면 일, 영, 영으로\n돌아옵니다.",
          "line": 0
        },
        {
          "start": 16.82,
          "end": 22.58,
          "text": "이 되돌리는 회전이 역원입니다. 부품을 놓은 위치나 지난\n이동까지 지우는 뜻은 아닙니다.",
          "line": 1
        },
        {
          "start": 22.7,
          "end": 27.14,
          "text": "실제 영상의 각도를 잰 것이 아니라, 검산할 수 있는\n모형을 정한 것입니다.",
          "line": 1
        }
      ],
      "en": [
        {
          "start": 0.0,
          "end": 2.66,
          "text": "Standing upright alone does not establish an\nidentical full orientation.",
          "line": 0
        },
        {
          "start": 2.88,
          "end": 8.464,
          "text": "We verify an exact inverse using the defined\nmodel. Define the initial",
          "line": 0
        },
        {
          "start": 8.464,
          "end": 12.260000000000002,
          "text": "model direction as one, zero, zero. A\nninety-degree z-axis turn gives zero,",
          "line": 0
        },
        {
          "start": 12.260000000000002,
          "end": 16.36,
          "text": "one, zero; the opposite ninety-degree turn\nrestores one, zero, zero.",
          "line": 0
        },
        {
          "start": 16.82,
          "end": 22.58,
          "text": "The cancelling rotation is the inverse. It\ndoes not erase placement or traveled motion.",
          "line": 1
        },
        {
          "start": 22.7,
          "end": 27.14,
          "text": "These are defined, checkable model angles, not\nmeasurements from the footage.",
          "line": 1
        }
      ]
    },
    "sentenceCues": [
      {
        "start": 0.0,
        "end": 2.66,
        "text": "세워졌다고 방향이 모두 같지는 않습니다."
      },
      {
        "start": 2.88,
        "end": 5.96,
        "text": "정확히 되돌리는 계산은 모형에서 확인하겠습니다."
      },
      {
        "start": 6.24,
        "end": 10.06,
        "text": "이제 계산용 모형의 처음 방향을 일, 영, 영으로 둡니다."
      },
      {
        "start": 10.22,
        "end": 13.2,
        "text": "제트축으로 구십 도 돌리면 영, 일, 영이 됩니다."
      },
      {
        "start": 13.4,
        "end": 16.36,
        "text": "반대 구십 도를 적용하면 일, 영, 영으로 돌아옵니다."
      },
      {
        "start": 16.82,
        "end": 18.84,
        "text": "이 되돌리는 회전이 역원입니다."
      },
      {
        "start": 19.02,
        "end": 22.58,
        "text": "부품을 놓은 위치나 지난 이동까지 지우는 뜻은 아닙니다."
      },
      {
        "start": 22.7,
        "end": 27.14,
        "text": "실제 영상의 각도를 잰 것이 아니라, 검산할 수 있는 모형을 정한 것입니다."
      }
    ],
    "fragmentCues": {
      "처음 방향": 7.34,
      "부품을 놓은": 19.02,
      "제트축으로": 10.22,
      "반대 구십": 13.4
    },
    "annotationReveal": {},
    "alignment": "Current-hash word timestamps; raw meaning and human listening reviewed separately"
  },
