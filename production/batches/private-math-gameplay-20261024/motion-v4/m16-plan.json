    {
      "scene": "05",
      "key": "05",
      "source": "tiny",
      "offset": 0,
      "duration": 6.5,
      "title": "화면 비율과 실제 건물 형태 구분",
      "meaning": "",
      "segments": [
        {
          "kind": "motion",
          "in": 10.5,
