  "paragraphs": [
    {
      "episode": "10",
      "take": 0,
      "cues": [
        {
          "text": "마법이 손을 들기도 전에",
          "startFrame": 8,
          "endFrame": 89,
          "firstWord": 0,
          "lastWord": 3
        },
        {
          "text": "튀어나오면 왜 어색할까요?",
          "startFrame": 89,
          "endFrame": 197,
          "firstWord": 4,
          "lastWord": 6
        },
        {
          "text": "멋진 효과만으로는",
          "startFrame": 226,
          "endFrame": 285,
          "firstWord": 7,
          "lastWord": 8
        },
        {
          "text": "캐릭터가 마법을 쐈다는 동작이",
          "startFrame": 285,
          "endFrame": 401,
          "firstWord": 9,
          "lastWord": 12
        },
        {
          "text": "완성되지 않습니다.",
          "startFrame": 401,
          "endFrame": 472,
          "firstWord": 13,
          "lastWord": 14
        }
      ],
      "asrSpellingReview": []
    },
    {
      "episode": "10",
      "take": 1,
      "cues": [
        {
          "text": "같은 캐릭터가 지팡이를 들도록 하고",
          "startFrame": 665,
          "endFrame": 805,
          "firstWord": 0,
          "lastWord": 4
        },
        {
          "text": "발사만 먼저 켜 봅시다.",
          "startFrame": 805,
          "endFrame": 926,
          "firstWord": 5,
          "lastWord": 7
        },
        {
          "text": "준비하는 몸과 이미 날아간",
          "startFrame": 941,
          "endFrame": 1034,
          "firstWord": 8,
          "lastWord": 11
        },
        {
          "text": "효과가 따로 보입니다.",
          "startFrame": 1034,
          "endFrame": 1109,
          "firstWord": 12,
          "lastWord": 14
        },
        {
          "text": "이번에는 지팡이가 올라오는 순간에",
          "startFrame": 1124,
          "endFrame": 1234,
          "firstWord": 15,
          "lastWord": 18
        },
        {
          "text": "발사를 맞춰 보세요.",
          "startFrame": 1234,
          "endFrame": 1297,
          "firstWord": 19,
          "lastWord": 20
        }
      ],
      "asrSpellingReview": []
    },
    {
      "episode": "10",
      "take": 2,
      "cues": [
        {
          "text": "엘든 링의 제작 과정에서는",
          "startFrame": 1322,
          "endFrame": 1411,
          "firstWord": 0,
          "lastWord": 3
        },
        {
          "text": "동작의 시간에",
          "startFrame": 1411,
          "endFrame": 1477,
          "firstWord": 4,
          "lastWord": 5
        },
        {
          "text": "효과와 소리 같은 이벤트를 연결합니다.",
          "startFrame": 1477,
          "endFrame": 1613,
          "firstWord": 6,
          "lastWord": 10
        },
        {
          "text": "준비, 발사, 회복이 이어져야",
          "startFrame": 1630,
          "endFrame": 1732,
          "firstWord": 11,
          "lastWord": 14
        },
        {
          "text": "플레이어도 무엇이 일어나고 있는지",
          "startFrame": 1732,
          "endFrame": 1840,
          "firstWord": 15,
          "lastWord": 18
        },
        {
          "text": "읽을 수 있습니다.",
          "startFrame": 1840,
          "endFrame": 1897,
          "firstWord": 19,
          "lastWord": 21
        }
      ],
      "asrSpellingReview": []
    },
    {
      "episode": "10",
      "take": 3,
      "cues": [
        {
          "text": "시연의 시간표에서 발사 표시를 옮기면",
          "startFrame": 2085,
          "endFrame": 2214,
          "firstWord": 0,
          "lastWord": 4
        },
        {
          "text": "같은 동작도 다르게 보입니다.",
          "startFrame": 2214,
          "endFrame": 2332,
          "firstWord": 5,
          "lastWord": 8
        },
        {
          "text": "손과 지팡이, 투사체가",
          "startFrame": 2352,
          "endFrame": 2441,
          "firstWord": 9,
          "lastWord": 11
        },
        {
          "text": "한 행동으로 이어지는 순간을 확인해 보세요.",
          "startFrame": 2441,
          "endFrame": 2588,
          "firstWord": 12,
          "lastWord": 16
        },
        {
          "text": "효과는 어떤 모양인지뿐 아니라",
          "startFrame": 2606,
          "endFrame": 2717,
          "firstWord": 17,
          "lastWord": 21
        },
        {
          "text": "언제 나오는지도 중요합니다.",
          "startFrame": 2717,
          "endFrame": 2823,
          "firstWord": 22,
          "lastWord": 24
        }
      ],
      "asrSpellingReview": []
    }
  ],
