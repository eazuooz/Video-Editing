  "paragraphs": [
    {
      "episode": "07",
      "take": 0,
      "cues": [
        {
          "text": "엘든 링 제작진은 왜",
          "startFrame": 8,
          "endFrame": 81,
          "firstWord": 0,
          "lastWord": 3
        },
        {
          "text": "땅을 만드는 방식을 바꿨을까요?",
          "startFrame": 81,
          "endFrame": 197,
          "firstWord": 4,
          "lastWord": 7
        },
        {
          "text": "산이 그럴듯한 것과",
          "startFrame": 206,
          "endFrame": 279,
          "firstWord": 8,
          "lastWord": 10
        },
        {
          "text": "캐릭터가 원하는 곳에",
          "startFrame": 279,
          "endFrame": 347,
          "firstWord": 11,
          "lastWord": 13
        },
        {
          "text": "착지하는 것은 다른 문제였습니다.",
          "startFrame": 347,
          "endFrame": 448,
          "firstWord": 14,
          "lastWord": 17
        }
      ],
      "asrSpellingReview": []
    },
    {
      "episode": "07",
      "take": 1,
      "cues": [
        {
          "text": "높이맵은 격자점마다",
          "startFrame": 473,
          "endFrame": 564,
          "firstWord": 0,
          "lastWord": 2
        },
        {
          "text": "높이를 저장해 땅을 만듭니다.",
          "startFrame": 564,
          "endFrame": 694,
          "firstWord": 3,
          "lastWord": 6
        },
        {
          "text": "이것도 손으로 고칠 수 있습니다.",
          "startFrame": 709,
          "endFrame": 806,
          "firstWord": 7,
          "lastWord": 11
        },
        {
          "text": "다만 제작진은 당시 방식으로",
          "startFrame": 822,
          "endFrame": 923,
          "firstWord": 12,
          "lastWord": 15
        },
        {
          "text": "플레이에 필요한 세밀한 단차와",
          "startFrame": 923,
          "endFrame": 1034,
          "firstWord": 16,
          "lastWord": 19
        },
        {
          "text": "위치 변경 요구에",
          "startFrame": 1034,
          "endFrame": 1111,
          "firstWord": 20,
          "lastWord": 22
        },
        {
          "text": "대응하기 어려웠다고 설명했습니다.",
          "startFrame": 1111,
          "endFrame": 1220,
          "firstWord": 23,
          "lastWord": 25
        }
      ],
      "asrSpellingReview": []
    },
    {
      "episode": "07",
      "take": 2,
      "cues": [
        {
          "text": "그래서 지형을 점과 면으로",
          "startFrame": 1245,
          "endFrame": 1349,
          "firstWord": 0,
          "lastWord": 3
        },
        {
          "text": "이루어진 메시로 만들었습니다.",
          "startFrame": 1349,
          "endFrame": 1438,
          "firstWord": 4,
          "lastWord": 6
        },
        {
          "text": "필요한 모서리와 면을",
          "startFrame": 1451,
          "endFrame": 1524,
          "firstWord": 7,
          "lastWord": 9
        },
        {
          "text": "직접 조정할 수 있죠.",
          "startFrame": 1524,
          "endFrame": 1599,
          "firstWord": 10,
          "lastWord": 13
        },
        {
          "text": "예를 들어 점프 착지면의",
          "startFrame": 1616,
          "endFrame": 1694,
          "firstWord": 14,
          "lastWord": 16
        },
        {
          "text": "위치와 폭을 바꾸는 요구를",
          "startFrame": 1694,
          "endFrame": 1781,
          "firstWord": 17,
          "lastWord": 20
        },
        {
          "text": "같은 지형 위에서 다뤄 보는 겁니다.",
          "startFrame": 1781,
          "endFrame": 1901,
          "firstWord": 21,
          "lastWord": 25
        }
      ],
      "asrSpellingReview": [
        {
          "wordIndex": 5,
          "recognized": "메쉬로",
          "caption": "메시로",
          "reason": "Two Korean spellings of the English technical noun mesh; complete independent context identifies the same noun, no missing words. Pronunciation listening remains pending.",
          "rawAsrUnchanged": true
        }
      ]
    },
    {
      "episode": "07",
      "take": 3,
      "cues": [
        {
          "text": "시연에서는 캐릭터의 점프는 그대로 두고",
          "startFrame": 1926,
          "endFrame": 2069,
          "firstWord": 0,
          "lastWord": 4
        },
        {
          "text": "착지면만 다듬습니다.",
          "startFrame": 2069,
          "endFrame": 2162,
          "firstWord": 5,
          "lastWord": 6
        },
        {
          "text": "수정 뒤 발이 닿는",
          "startFrame": 2172,
          "endFrame": 2237,
          "firstWord": 7,
          "lastWord": 10
        },
        {
          "text": "위치를 다시 확인하죠.",
          "startFrame": 2237,
          "endFrame": 2315,
          "firstWord": 11,
          "lastWord": 13
        },
        {
          "text": "높이맵이 나쁘다는 뜻이 아닙니다.",
          "startFrame": 2325,
          "endFrame": 2441,
          "firstWord": 14,
          "lastWord": 18
        },
        {
          "text": "이 게임의 플레이에 맞는 땅을",
          "startFrame": 2451,
          "endFrame": 2547,
          "firstWord": 19,
          "lastWord": 23
        },
        {
          "text": "고치기 위해 작업 방식을 선택한 것입니다.",
          "startFrame": 2547,
          "endFrame": 2699,
          "firstWord": 24,
          "lastWord": 29
        }
      ],
      "asrSpellingReview": []
    }
  ],
