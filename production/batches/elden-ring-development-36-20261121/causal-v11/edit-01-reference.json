  "paragraphs": [
    {
      "episode": "01",
      "take": 0,
      "cues": [
        {
          "text": "말을 타고 폐허를 벗어나도",
          "startFrame": 8,
          "endFrame": 113,
          "firstWord": 0,
          "lastWord": 3
        },
        {
          "text": "다음 들판이 이어집니다.",
          "startFrame": 113,
          "endFrame": 202,
          "firstWord": 4,
          "lastWord": 6
        },
        {
          "text": "이렇게 큰 세상을",
          "startFrame": 224,
          "endFrame": 277,
          "firstWord": 7,
          "lastWord": 9
        },
        {
          "text": "한꺼번에 메모리에 올려 둔 걸까요?",
          "startFrame": 277,
          "endFrame": 391,
          "firstWord": 10,
          "lastWord": 13
        }
      ],
      "asrSpellingReview": []
    },
    {
      "episode": "01",
      "take": 1,
      "cues": [
        {
          "text": "전부 올리면 멀리 있어",
          "startFrame": 415,
          "endFrame": 498,
          "firstWord": 0,
          "lastWord": 3
        },
        {
          "text": "보지도 않는 땅까지",
          "startFrame": 498,
          "endFrame": 570,
          "firstWord": 4,
          "lastWord": 6
        },
        {
          "text": "자리를 차지합니다.",
          "startFrame": 570,
          "endFrame": 638,
          "firstWord": 7,
          "lastWord": 8
        },
        {
          "text": "반대로 다음 구역에 도착해서야",
          "startFrame": 651,
          "endFrame": 758,
          "firstWord": 9,
          "lastWord": 12
        },
        {
          "text": "준비하면 풍경이 늦게",
          "startFrame": 758,
          "endFrame": 841,
          "firstWord": 13,
          "lastWord": 15
        },
        {
          "text": "나타날 수 있죠.",
          "startFrame": 841,
          "endFrame": 898,
          "firstWord": 16,
          "lastWord": 18
        },
        {
          "text": "그래서 이동할 주변 구역을",
          "startFrame": 919,
          "endFrame": 993,
          "firstWord": 19,
          "lastWord": 22
        },
        {
          "text": "먼저 준비해야 합니다.",
          "startFrame": 993,
          "endFrame": 1066,
          "firstWord": 23,
          "lastWord": 25
        }
      ],
      "asrSpellingReview": []
    },
    {
      "episode": "01",
      "take": 2,
      "cues": [
        {
          "text": "이 게임은 월드를 격자로 나누고",
          "startFrame": 1091,
          "endFrame": 1217,
          "firstWord": 0,
          "lastWord": 4
        },
        {
          "text": "주변 데이터를 관리했습니다.",
          "startFrame": 1217,
          "endFrame": 1327,
          "firstWord": 5,
          "lastWord": 7
        },
        {
          "text": "말은 빠르게 구역을 넘고",
          "startFrame": 1337,
          "endFrame": 1428,
          "firstWord": 8,
          "lastWord": 11
        },
        {
          "text": "큰 적은 한 구역 밖까지 움직이니,",
          "startFrame": 1428,
          "endFrame": 1567,
          "firstWord": 12,
          "lastWord": 17
        },
        {
          "text": "지금 발밑의 칸만",
          "startFrame": 1591,
          "endFrame": 1657,
          "firstWord": 18,
          "lastWord": 20
        },
        {
          "text": "보면 충분하지 않습니다.",
          "startFrame": 1657,
          "endFrame": 1742,
          "firstWord": 21,
          "lastWord": 23
        }
      ],
      "asrSpellingReview": []
    },
    {
      "episode": "01",
      "take": 3,
      "cues": [
        {
          "text": "시연에서 캐릭터가 움직이면",
          "startFrame": 1767,
          "endFrame": 1853,
          "firstWord": 0,
          "lastWord": 2
        },
        {
          "text": "앞쪽 칸이 준비되고",
          "startFrame": 1853,
          "endFrame": 1934,
          "firstWord": 3,
          "lastWord": 5
        },
        {
          "text": "멀어진 칸은 비워집니다.",
          "startFrame": 1934,
          "endFrame": 2028,
          "firstWord": 6,
          "lastWord": 8
        },
        {
          "text": "칸은 화면에 보이는 벽이",
          "startFrame": 2042,
          "endFrame": 2122,
          "firstWord": 9,
          "lastWord": 12
        },
        {
          "text": "아니라 데이터를 나누는 기준입니다.",
          "startFrame": 2122,
          "endFrame": 2255,
          "firstWord": 13,
          "lastWord": 16
        },
        {
          "text": "풍경은 이어 두고,",
          "startFrame": 2271,
          "endFrame": 2331,
          "firstWord": 17,
          "lastWord": 18
        },
        {
          "text": "안에서 준비하는 부분만 바꾸는 거죠.",
          "startFrame": 2331,
          "endFrame": 2475,
          "firstWord": 19,
          "lastWord": 23
        }
      ],
      "asrSpellingReview": []
    }
  ],
