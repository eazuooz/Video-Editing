  "paragraphs": [
    {
      "episode": "09",
      "take": 0,
      "cues": [
        {
          "text": "이 성에서는 넓은 곳을 지나",
          "startFrame": 8,
          "endFrame": 104,
          "firstWord": 0,
          "lastWord": 4
        },
        {
          "text": "좁은 통로로 들어가면",
          "startFrame": 104,
          "endFrame": 196,
          "firstWord": 5,
          "lastWord": 7
        },
        {
          "text": "걷는 방식까지 달라집니다.",
          "startFrame": 196,
          "endFrame": 310,
          "firstWord": 8,
          "lastWord": 10
        },
        {
          "text": "장식이 달라져서일까요?",
          "startFrame": 321,
          "endFrame": 406,
          "firstWord": 11,
          "lastWord": 12
        },
        {
          "text": "먼저 보이는 정보를 비교해 봅시다.",
          "startFrame": 406,
          "endFrame": 535,
          "firstWord": 13,
          "lastWord": 16
        }
      ],
      "asrSpellingReview": []
    },
    {
      "episode": "09",
      "take": 1,
      "cues": [
        {
          "text": "넓은 뜰에서는 먼 길을 보고",
          "startFrame": 559,
          "endFrame": 682,
          "firstWord": 0,
          "lastWord": 4
        },
        {
          "text": "목적지를 고를 수 있습니다.",
          "startFrame": 682,
          "endFrame": 798,
          "firstWord": 5,
          "lastWord": 8
        },
        {
          "text": "통로에서는 모서리가 앞을 가려",
          "startFrame": 812,
          "endFrame": 909,
          "firstWord": 9,
          "lastWord": 12
        },
        {
          "text": "다음 공간을 확인해야 합니다.",
          "startFrame": 909,
          "endFrame": 1021,
          "firstWord": 13,
          "lastWord": 16
        },
        {
          "text": "높은 발판에서는",
          "startFrame": 1040,
          "endFrame": 1090,
          "firstWord": 17,
          "lastWord": 18
        },
        {
          "text": "아래의 착지점을 살펴야 하죠.",
          "startFrame": 1090,
          "endFrame": 1210,
          "firstWord": 19,
          "lastWord": 22
        },
        {
          "text": "공간이 바뀌니 판단할 대상도 바뀝니다.",
          "startFrame": 1226,
          "endFrame": 1364,
          "firstWord": 23,
          "lastWord": 27
        }
      ],
      "asrSpellingReview": []
    },
    {
      "episode": "09",
      "take": 2,
      "cues": [
        {
          "text": "제작진은 성 안에도 방과 통로,",
          "startFrame": 1389,
          "endFrame": 1544,
          "firstWord": 0,
          "lastWord": 4
        },
        {
          "text": "옥상과 지하처럼",
          "startFrame": 1544,
          "endFrame": 1607,
          "firstWord": 5,
          "lastWord": 6
        },
        {
          "text": "서로 다른 공간 경험을 배치했습니다.",
          "startFrame": 1607,
          "endFrame": 1736,
          "firstWord": 7,
          "lastWord": 11
        },
        {
          "text": "폭과 시야, 고저차가 변하면",
          "startFrame": 1750,
          "endFrame": 1848,
          "firstWord": 12,
          "lastWord": 15
        },
        {
          "text": "같은 성을 탐험해도",
          "startFrame": 1848,
          "endFrame": 1919,
          "firstWord": 16,
          "lastWord": 18
        },
        {
          "text": "계속 다른 정보를 읽게 됩니다.",
          "startFrame": 1919,
          "endFrame": 2036,
          "firstWord": 19,
          "lastWord": 23
        }
      ],
      "asrSpellingReview": [
        {
          "wordIndex": 22,
          "recognized": "잃게",
          "caption": "읽게",
          "evidence": "D:\\YamyamProduction\\elden-ring-development-36-causal-v11\\voice\\09\\0267a3c8691d\\independent-context\\e3db01a22c48\\review.json",
          "reason": "Independent complete second sentence recognizes 읽게; exact retained PCM. Raw ASR remains unchanged."
        }
      ]
    },
    {
      "episode": "09",
      "take": 3,
      "cues": [
        {
          "text": "시연의 캐릭터가 뜰에서 통로,",
          "startFrame": 2060,
          "endFrame": 2179,
          "firstWord": 0,
          "lastWord": 3
        },
        {
          "text": "높은 발판으로 이동하는 동안",
          "startFrame": 2179,
          "endFrame": 2276,
          "firstWord": 4,
          "lastWord": 7
        },
        {
          "text": "시야를 따라가 보세요.",
          "startFrame": 2314,
          "endFrame": 2383,
          "firstWord": 8,
          "lastWord": 10
        },
        {
          "text": "먼 길, 가려진 모서리,",
          "startFrame": 2389,
          "endFrame": 2486,
          "firstWord": 11,
          "lastWord": 14
        },
        {
          "text": "아래 착지점이 차례로 중요해집니다.",
          "startFrame": 2486,
          "endFrame": 2621,
          "firstWord": 15,
          "lastWord": 18
        },
        {
          "text": "다른 느낌의 이유는",
          "startFrame": 2643,
          "endFrame": 2702,
          "firstWord": 19,
          "lastWord": 21
        },
        {
          "text": "눈앞에 주어진 정보와",
          "startFrame": 2702,
          "endFrame": 2786,
          "firstWord": 22,
          "lastWord": 24
        },
        {
          "text": "다음 행동의 차이입니다.",
          "startFrame": 2786,
          "endFrame": 2875,
          "firstWord": 25,
          "lastWord": 27
        }
      ],
      "asrSpellingReview": []
    }
  ],
