  "paragraphs": [
    {
      "episode": "12",
      "take": 0,
      "cues": [
        {
          "text": "엘든 링의 구석구석을",
          "startFrame": 8,
          "endFrame": 83,
          "firstWord": 0,
          "lastWord": 2
        },
        {
          "text": "가 보고 싶게 만드는",
          "startFrame": 83,
          "endFrame": 149,
          "firstWord": 3,
          "lastWord": 5
        },
        {
          "text": "길은 어떻게 다듬었을까요?",
          "startFrame": 149,
          "endFrame": 260,
          "firstWord": 6,
          "lastWord": 8
        },
        {
          "text": "지도에 그려 둔 선만 보고",
          "startFrame": 277,
          "endFrame": 352,
          "firstWord": 9,
          "lastWord": 12
        },
        {
          "text": "탐험이 재미있을지 판단하기는 어렵습니다.",
          "startFrame": 352,
          "endFrame": 511,
          "firstWord": 13,
          "lastWord": 16
        }
      ],
      "asrSpellingReview": [
        {
          "wordIndex": 0,
          "recognized": "엘덴",
          "caption": "엘든",
          "reason": "Korean title spelling of Elden Ring; no different named entity or missing word. Human pronunciation review is separate."
        }
      ]
    },
    {
      "episode": "12",
      "take": 1,
      "cues": [
        {
          "text": "탑에 올라 옆 탑을 봅시다.",
          "startFrame": 626,
          "endFrame": 745,
          "firstWord": 0,
          "lastWord": 4
        },
        {
          "text": "저곳에 가고 싶다면",
          "startFrame": 755,
          "endFrame": 811,
          "firstWord": 5,
          "lastWord": 7
        },
        {
          "text": "두 탑을 잇는 길을",
          "startFrame": 811,
          "endFrame": 875,
          "firstWord": 8,
          "lastWord": 11
        },
        {
          "text": "더해 볼 수 있죠.",
          "startFrame": 875,
          "endFrame": 927,
          "firstWord": 12,
          "lastWord": 14
        },
        {
          "text": "실제 제작진도 성을 여러 번 플레이하며",
          "startFrame": 939,
          "endFrame": 1079,
          "firstWord": 15,
          "lastWord": 20
        },
        {
          "text": "탑 사이의 새 길을 검토했습니다.",
          "startFrame": 1079,
          "endFrame": 1220,
          "firstWord": 21,
          "lastWord": 25
        }
      ],
      "asrSpellingReview": [
        {
          "wordIndex": 22,
          "recognized": "사이에",
          "caption": "사이의",
          "reason": "Spoken Korean realization of 의 as 에; unchanged grammatical phrase, positive whole-word interval."
        },
        {
          "wordIndex": 23,
          "recognized": "세",
          "caption": "새",
          "reason": "Same pronounced syllable; source and full sentence describe a new route, not three routes. Preserve raw recognition and review final mix context."
        }
      ]
    },
    {
      "episode": "12",
      "take": 2,
      "cues": [
        {
          "text": "이처럼 사람이 플레이하며 길을 제안하고 검토하는 일과,",
          "startFrame": 1244,
          "endFrame": 1456,
          "firstWord": 0,
          "lastWord": 6
        },
        {
          "text": "넓은 월드의 오류와 부하를",
          "startFrame": 1481,
          "endFrame": 1585,
          "firstWord": 7,
          "lastWord": 10
        },
        {
          "text": "찾는 일은 다릅니다.",
          "startFrame": 1585,
          "endFrame": 1652,
          "firstWord": 11,
          "lastWord": 13
        },
        {
          "text": "기술 점검에는 자동 순회와",
          "startFrame": 1679,
          "endFrame": 1781,
          "firstWord": 14,
          "lastWord": 17
        },
        {
          "text": "위치 정보를",
          "startFrame": 1781,
          "endFrame": 1826,
          "firstWord": 18,
          "lastWord": 19
        },
        {
          "text": "모아 보여 주는 도구도 사용됐습니다.",
          "startFrame": 1826,
          "endFrame": 1945,
          "firstWord": 20,
          "lastWord": 23
        }
      ],
      "asrSpellingReview": [
        {
          "wordIndex": 4,
          "recognized": "제한하고",
          "caption": "제안하고",
          "evidence": "D:\\YamyamProduction\\elden-ring-development-36-causal-v11\\voice\\12\\6e481e351ff6\\independent-context\\37f73d280d8e\\review.json",
          "reason": "Independent complete sentence recognizes 제안하고 on exact retained PCM; no blanket substitution."
        }
      ]
    },
    {
      "episode": "12",
      "take": 3,
      "cues": [
        {
          "text": "사람이 새 옆길을 확인하는 흐름과,",
          "startFrame": 2031,
          "endFrame": 2158,
          "firstWord": 0,
          "lastWord": 4
        },
        {
          "text": "반복 검사에서 문제 위치를",
          "startFrame": 2158,
          "endFrame": 2277,
          "firstWord": 5,
          "lastWord": 8
        },
        {
          "text": "찾아 다시 확인하는 흐름을 나눠 보세요.",
          "startFrame": 2277,
          "endFrame": 2424,
          "firstWord": 9,
          "lastWord": 13
        },
        {
          "text": "탐험의 재미는 플레이하며 다듬고,",
          "startFrame": 2440,
          "endFrame": 2559,
          "firstWord": 14,
          "lastWord": 17
        },
        {
          "text": "넓어진 공간의 기술 문제는",
          "startFrame": 2559,
          "endFrame": 2690,
          "firstWord": 18,
          "lastWord": 21
        },
        {
          "text": "반복 점검으로 찾는 것입니다.",
          "startFrame": 2690,
          "endFrame": 2793,
          "firstWord": 22,
          "lastWord": 25
        }
      ],
