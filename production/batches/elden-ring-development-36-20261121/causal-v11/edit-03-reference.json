  "paragraphs": [
    {
      "episode": "03",
      "take": 0,
      "cues": [
        {
          "text": "얼굴의 상처는 색 무늬인데,",
          "startFrame": 8,
          "endFrame": 105,
          "firstWord": 0,
          "lastWord": 3
        },
        {
          "text": "빛을 받으면 왜",
          "startFrame": 105,
          "endFrame": 178,
          "firstWord": 4,
          "lastWord": 6
        },
        {
          "text": "움푹 팬 것처럼 보일까요?",
          "startFrame": 178,
          "endFrame": 269,
          "firstWord": 7,
          "lastWord": 10
        },
        {
          "text": "같은 얼굴에서",
          "startFrame": 275,
          "endFrame": 317,
          "firstWord": 11,
          "lastWord": 12
        },
        {
          "text": "색만 넣은 경우와",
          "startFrame": 317,
          "endFrame": 391,
          "firstWord": 13,
          "lastWord": 15
        },
        {
          "text": "비교해 봅시다.",
          "startFrame": 391,
          "endFrame": 453,
          "firstWord": 16,
          "lastWord": 17
        }
      ],
      "asrSpellingReview": []
    },
    {
      "episode": "03",
      "take": 1,
      "cues": [
        {
          "text": "빛을 계산할 때는",
          "startFrame": 487,
          "endFrame": 546,
          "firstWord": 0,
          "lastWord": 2
        },
        {
          "text": "표면이 어느 방향을 향하는지",
          "startFrame": 546,
          "endFrame": 654,
          "firstWord": 3,
          "lastWord": 6
        },
        {
          "text": "알아야 합니다.",
          "startFrame": 654,
          "endFrame": 692,
          "firstWord": 7,
          "lastWord": 8
        },
        {
          "text": "표면에 수직으로 세운 화살표,",
          "startFrame": 710,
          "endFrame": 830,
          "firstWord": 9,
          "lastWord": 12
        },
        {
          "text": "이것이 법선입니다.",
          "startFrame": 830,
          "endFrame": 902,
          "firstWord": 13,
          "lastWord": 14
        },
        {
          "text": "색만 바꾸면",
          "startFrame": 924,
          "endFrame": 967,
          "firstWord": 15,
          "lastWord": 16
        },
        {
          "text": "이 화살표는 그대로여서,",
          "startFrame": 967,
          "endFrame": 1047,
          "firstWord": 17,
          "lastWord": 19
        },
        {
          "text": "상처의 굴곡에 맞는",
          "startFrame": 1047,
          "endFrame": 1126,
          "firstWord": 20,
          "lastWord": 22
        },
        {
          "text": "명암은 생기지 않습니다.",
          "startFrame": 1126,
          "endFrame": 1203,
          "firstWord": 23,
          "lastWord": 25
        }
      ],
      "asrSpellingReview": []
    },
    {
      "episode": "03",
      "take": 2,
      "cues": [
        {
          "text": "엘든 링의 얼굴 재질은",
          "startFrame": 1230,
          "endFrame": 1316,
          "firstWord": 0,
          "lastWord": 3
        },
        {
          "text": "상처의 적용 범위와 색뿐 아니라",
          "startFrame": 1316,
          "endFrame": 1424,
          "firstWord": 4,
          "lastWord": 8
        },
        {
          "text": "법선 정보도 사용합니다.",
          "startFrame": 1424,
          "endFrame": 1524,
          "firstWord": 9,
          "lastWord": 11
        },
        {
          "text": "상처 부분의 계산 방향을 달리하면",
          "startFrame": 1551,
          "endFrame": 1657,
          "firstWord": 12,
          "lastWord": 16
        },
        {
          "text": "같은 빛을 받아도",
          "startFrame": 1657,
          "endFrame": 1728,
          "firstWord": 17,
          "lastWord": 19
        },
        {
          "text": "밝은 면과 어두운 면이 갈립니다.",
          "startFrame": 1728,
          "endFrame": 1841,
          "firstWord": 20,
          "lastWord": 24
        }
      ],
      "asrSpellingReview": []
    },
    {
      "episode": "03",
      "take": 3,
      "cues": [
        {
          "text": "시연에서 색, 적용 범위,",
          "startFrame": 1873,
          "endFrame": 1984,
          "firstWord": 0,
          "lastWord": 3
        },
        {
          "text": "법선 층을 따로 켜 보세요.",
          "startFrame": 1984,
          "endFrame": 2088,
          "firstWord": 4,
          "lastWord": 7
        },
        {
          "text": "빛을 움직이면",
          "startFrame": 2101,
          "endFrame": 2146,
          "firstWord": 8,
          "lastWord": 9
        },
        {
          "text": "법선을 더한 쪽은",
          "startFrame": 2146,
          "endFrame": 2228,
          "firstWord": 10,
          "lastWord": 12
        },
        {
          "text": "밝고 어두운 부분이 달라집니다.",
          "startFrame": 2228,
          "endFrame": 2353,
          "firstWord": 13,
          "lastWord": 16
        },
        {
          "text": "얼굴 모양을 실제로 파내지 않아도,",
          "startFrame": 2372,
          "endFrame": 2487,
          "firstWord": 17,
          "lastWord": 21
        },
        {
          "text": "달라진 명암 때문에",
          "startFrame": 2487,
          "endFrame": 2553,
          "firstWord": 22,
          "lastWord": 24
        },
        {
          "text": "상처가 패인 듯 보이는 겁니다.",
          "startFrame": 2553,
          "endFrame": 2668,
          "firstWord": 25,
          "lastWord": 29
        }
      ],
      "asrSpellingReview": []
    }
  ],
