  "paragraphs": [
    {
      "episode": "08",
      "take": 0,
      "cues": [
        {
          "text": "리카드의 검에 붙어",
          "startFrame": 8,
          "endFrame": 86,
          "firstWord": 0,
          "lastWord": 2
        },
        {
          "text": "꿈틀거리는 수많은 팔.",
          "startFrame": 86,
          "endFrame": 200,
          "firstWord": 3,
          "lastWord": 5
        },
        {
          "text": "이 팔마다 뼈대를 넣고",
          "startFrame": 215,
          "endFrame": 295,
          "firstWord": 6,
          "lastWord": 9
        },
        {
          "text": "연결해 움직였을까요?",
          "startFrame": 295,
          "endFrame": 380,
          "firstWord": 10,
          "lastWord": 11
        },
        {
          "text": "팔이 늘어날수록",
          "startFrame": 400,
          "endFrame": 457,
          "firstWord": 12,
          "lastWord": 13
        },
        {
          "text": "준비 작업도 복잡해질 수 있습니다.",
          "startFrame": 457,
          "endFrame": 597,
          "firstWord": 14,
          "lastWord": 18
        }
      ],
      "asrSpellingReview": []
    },
    {
      "episode": "08",
      "take": 1,
      "cues": [
        {
          "text": "먼저 하나의 팔에 뼈대를 넣습니다.",
          "startFrame": 938,
          "endFrame": 1081,
          "firstWord": 0,
          "lastWord": 4
        },
        {
          "text": "이 작업을 여러 팔에",
          "startFrame": 1088,
          "endFrame": 1159,
          "firstWord": 5,
          "lastWord": 8
        },
        {
          "text": "반복한다고 생각해 보세요.",
          "startFrame": 1159,
          "endFrame": 1256,
          "firstWord": 9,
          "lastWord": 10
        },
        {
          "text": "팔의 수나 윤곽을 바꿀 때",
          "startFrame": 1280,
          "endFrame": 1366,
          "firstWord": 11,
          "lastWord": 15
        },
        {
          "text": "설정할 대상도 달라집니다.",
          "startFrame": 1366,
          "endFrame": 1474,
          "firstWord": 16,
          "lastWord": 18
        },
        {
          "text": "제작진은 이 부담을 줄이고",
          "startFrame": 1507,
          "endFrame": 1598,
          "firstWord": 19,
          "lastWord": 22
        },
        {
          "text": "형태를 자유롭게 조정하기 위해",
          "startFrame": 1598,
          "endFrame": 1713,
          "firstWord": 23,
          "lastWord": 26
        },
        {
          "text": "움직임을 텍스처에 저장했습니다.",
          "startFrame": 1721,
          "endFrame": 1844,
          "firstWord": 27,
          "lastWord": 29
        }
      ],
      "asrSpellingReview": []
    },
    {
      "episode": "08",
      "take": 2,
      "cues": [
        {
          "text": "텍스처는 색 그림만 담는 파일이 아닙니다.",
          "startFrame": 1868,
          "endFrame": 2062,
          "firstWord": 0,
          "lastWord": 5
        },
        {
          "text": "각 순간에 표면의 점이",
          "startFrame": 2078,
          "endFrame": 2155,
          "firstWord": 6,
          "lastWord": 9
        },
        {
          "text": "어디에 있고 어느 방향을 향하는지",
          "startFrame": 2155,
          "endFrame": 2273,
          "firstWord": 10,
          "lastWord": 14
        },
        {
          "text": "데이터로 넣을 수도 있습니다.",
          "startFrame": 2273,
          "endFrame": 2383,
          "firstWord": 15,
          "lastWord": 18
        },
        {
          "text": "리카드의 팔에는 이런",
          "startFrame": 2398,
          "endFrame": 2468,
          "firstWord": 19,
          "lastWord": 21
        },
        {
          "text": "버텍스 애니메이션 텍스처가 사용됐습니다.",
          "startFrame": 2468,
          "endFrame": 2615,
          "firstWord": 22,
          "lastWord": 25
        }
      ],
      "asrSpellingReview": [
        {
          "wordIndex": 20,
          "recognized": "8에는",
          "caption": "팔에는",
          "reason": "Numeral eight and the Korean word for arm share the same reading; arm context.",
          "rawAsrUnchanged": true
        }
      ]
    },
    {
      "episode": "08",
      "take": 3,
      "cues": [
        {
          "text": "세 포즈의 점 위치를",
          "startFrame": 2762,
          "endFrame": 2840,
          "firstWord": 0,
          "lastWord": 3
        },
        {
          "text": "시간별 칸에 저장하고,",
          "startFrame": 2840,
          "endFrame": 2921,
          "firstWord": 4,
          "lastWord": 6
        },
        {
          "text": "재생할 때 지금",
          "startFrame": 2937,
          "endFrame": 2995,
          "firstWord": 7,
          "lastWord": 9
        },
        {
          "text": "시간의 칸을 읽어 봅시다.",
          "startFrame": 2995,
          "endFrame": 3093,
          "firstWord": 10,
          "lastWord": 12
        },
        {
          "text": "점들이 저장된 위치로 움직이며",
          "startFrame": 3115,
          "endFrame": 3218,
          "firstWord": 13,
          "lastWord": 16
        },
        {
          "text": "팔 모양이 되살아납니다.",
          "startFrame": 3218,
          "endFrame": 3326,
          "firstWord": 17,
          "lastWord": 19
        },
        {
          "text": "복잡한 뼈대 연결 대신",
          "startFrame": 3344,
          "endFrame": 3423,
          "firstWord": 20,
          "lastWord": 23
        },
        {
          "text": "저장된 표면 변형을 읽어",
          "startFrame": 3423,
          "endFrame": 3524,
          "firstWord": 24,
          "lastWord": 27
        },
        {
          "text": "제작과 수정을 다룬 겁니다.",
          "startFrame": 3526,
          "endFrame": 3625,
          "firstWord": 28,
          "lastWord": 31
        }
      ],
      "asrSpellingReview": []
    }
  ],
