# Unreal Engine project-local generated files (UE 5.8, Third Person template).
# Keep Content (.uasset/.umap), Config and the .uproject; everything below is
# regenerated by the editor. Repository-wide video/audio/archive/image
# exclusions still apply on top of this file.

# Build products, caches and editor state
/Binaries/
/DerivedDataCache/
/Intermediate/
/Saved/
/Plugins/*/Binaries/
/Plugins/*/Intermediate/

# Generated IDE projects and personal settings
/.vs/
/.vscode/
/.idea/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace
*.code-workspace
*.log

# Movie Render Queue / capture output stays local
/Captures/
/Renders/
