# Unity project-local generated files. Keep source Assets and their .meta files,
# Packages (including packages-lock.json), and ProjectSettings.
# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore
# Repository-wide video/audio/archive/image exclusions still apply.

# Import cache, editor state, builds and captures
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Bb]uild/
/[Bb]uilds/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Ss]creenshots/
.utmp/
*.log

# Generated IDE projects, personal settings and caches
.vs/
.idea/
.gradle/
.consulo/
/ExportedObj/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.DotSettings.user
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
/[Aa]ssets/Plugins/Editor/JetBrains*

# Crash reports, exported packages and authoring backups
/sysinfo.txt
mono_crash.*
crashlytics-build.properties
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta
*.blend1
*.blend1.meta

# Generated Addressables content; keep source definitions and authored assets
/ServerData/
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/addressables_content_state.bin*

# Generated Visual Scripting databases, test scenes and UI schemas
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
/UIElementsSchema/
/[Aa]ssets/[Ss]ceneDependencyCache*

# Purchased/local video-production asset library. Preserve assets and .meta on disk;
# raw redistribution rights are separate from use in rendered video.
/[Aa]ssets/ThirdParty/YamyamAssetLibrary/
/[Aa]ssets/ThirdParty/YamyamAssetLibrary.meta
