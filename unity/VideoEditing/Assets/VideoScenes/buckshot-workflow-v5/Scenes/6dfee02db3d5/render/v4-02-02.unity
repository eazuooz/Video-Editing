    content: "\uBA85\uB839\uC904 \xB7 CLI"
    color: {r: 0.9607843, g: 0.9607843, b: 0.9607843, a: 1}
  - text: {fileID: 701337674}
    content: REA
    color: {r: 0.9607843, g: 0.9607843, b: 0.9607843, a: 1}
  - text: {fileID: 2122069333}
    content: "\uAC8C\uC784 \uC790\uB8CC"
    color: {r: 0.9607843, g: 0.9607843, b: 0.9607843, a: 1}
  - text: {fileID: 1176310006}
    content: "\uC9C1\uC811 \uC2E4\uD589"
