  - text: {fileID: 174845004}
    content: "CLI\uB294 \uC9C1\uC811 \uC2E4\uD589 \xB7 MCP\uB294 AI\uC640 \uC678\uBD80 \uB3C4\uAD6C\uB97C \uC5F0\uACB0"
    color: {r: 0.9607843, g: 0.9607843, b: 0.9607843, a: 1}
  - text: {fileID: 11204867}
    content: "\uC6D0\uB9AC \uC124\uBA85 \xB7 Unity"
