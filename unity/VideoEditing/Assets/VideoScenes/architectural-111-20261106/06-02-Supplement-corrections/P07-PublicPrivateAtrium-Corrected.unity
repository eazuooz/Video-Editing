  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Yamyam.Architectural111.ProspectRefugeSupplement.Corrections.CorrectionDriver
  originalRig: {fileID: 433692872}
  config:
    frames: 720
    fps: 60
    width: 1920
    height: 1080
    courtyardTurnStartFrame: 600
    courtyardTurnEndFrame: 690
    sourceKind: our-authored-corrected-illustration
    sceneFolder: Assets/VideoScenes/architectural-111-20261106/06-02-Supplement-corrections
    sourceSceneFolder: Assets/VideoScenes/architectural-111-20261106/06-02-Supplement
    frameConvention: frame0 is corrected initial state; source step n produces corrected frame n+1; no reused stale state
    scaleCameraPosition: {x: 0, y: 3, z: -8}
    scaleCameraTarget: {x: 0, y: 1.1, z: 0}
    atriumPlayerPosition: {x: -2.4, y: 3, z: -3.4}
    atriumLookAt: {x: 0, y: 0.8, z: 1.8}
    courtyardReobserveTarget: {x: 0, y: 1.1, z: 0.5}
    scaleVerticalFieldOfView: 38
    interiorCeilingUndersideY: 1.65
    interiorCeilingThickness: 0.1
    interiorCeilingWidth: 6
    interiorCeilingMinZ: -5
    interiorCeilingMaxZ: -1
    scenes:
    - mode: scale
      sourceSceneFile: P02-BodyRelativeScale.unity
      sceneFile: P02-BodyRelativeScale-Corrected.unity
      correction: fixed frontal main camera reveals unchanged body between moving boundaries; observer retains genuine occlusion
      purpose: Readable body-relative initial narrow, intermediate and open illustration; no comfort measurement
      paragraphs: 02000000i
    - mode: atrium
      sourceSceneFile: P07-PublicPrivateAtrium.unity
      sceneFile: P07-PublicPrivateAtrium-Corrected.unity
      correction: stationary player in original clear private room with actual Idle pose; original public NPC circulation remains
      purpose: Private elevated room observes lower public circulation without a wall-crossing route
      paragraphs: 0700000008000000i
    - mode: courtyard
      sourceSceneFile: P14-LoweredCourtyardEntry.unity
      sceneFile: P14-LoweredCourtyardEntry-Corrected.unity
      correction: after original scripted crossing, main camera and actor turn toward courtyard to show renewed outward observation
      purpose: Observe, scripted crossing, turn and new observation; not safe or undetected movement evidence
      paragraphs: 0e0000000f00000010000000i
    - mode: refuge
      sourceSceneFile: P12-DepressedRefugeSection.unity
      sceneFile: P12-DepressedRefugeSection-Corrected.unity
      correction: add a real shared-collider low broad interior ceiling above depressed seating, visibly distinct from the original exterior overhang; downward-facing sectional surface is identical in both cameras
      purpose: Inside player view shows actual underside; observer reads labelled sectional edge and body-to-ceiling anchors, not structural or comfort measurements
      paragraphs: 080000000c0000000d000000i
  previewInPlayMode: 1
