      endFrameExclusive: 600
      velocityX: 1.6
    - id: observe-result
      startFrame: 600
      endFrameExclusive: 720
      velocityX: 0
    jumpFrames: d2000000c2010000i
    fireFrames: 96000000b4000000d2000000c2010000e0010000fe010000i
