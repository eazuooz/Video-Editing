  m_Script: {fileID: 11500000, guid: 182fd106df3d8a844beeae0d0adfa2ff, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Yamyam.Architectural111.ProspectRefugeSupplement.Experiment
  config:
    frames: 720
    fps: 60
    width: 1920
    height: 1080
    sourceKind: our-authored-illustration
    sceneFolder: Assets/VideoScenes/architectural-111-20261106/06-02-Supplement
    frameConvention: Capture frame0 initialstate before movement; advance once per1/60s, shared actor/state/camera frame, capture719/60 last.
    playerHeight: 1.8
    playerRadius: 0.35
    playerEyeHeight: 1.65
    gravity: 18
    jumpSpeed: 7.2
    walkSpeed: 1.6
    shotSpeed: 8
    enemyShotSpeed: 5
    observerPosition: {x: 10, y: 12, z: -12}
    observerLookAt: {x: 0, y: 1.3, z: 0}
    scenes:
    - mode: scale
      sceneFile: P02-BodyRelativeScale.unity
      purpose: Body-relative narrow, comfortable and open boundaries; no comfort measurement.
      paragraphs: 02000000i
    - mode: protected
      sceneFile: P03-ProtectedObservation.unity
      purpose: Declared threat-direction body-point protection and a different outward-view direction; not whole-mesh invisibility or one-way reciprocal ray.
      paragraphs: 03000000i
    - mode: atrium
      sceneFile: P07-PublicPrivateAtrium.unity
      purpose: Open public atrium, enclosed elevated loft rooms and viewing-height relation.
      paragraphs: 0700000008000000i
    - mode: structure
      sceneFile: P09-ColumnsFreeFacade.unity
      purpose: Columns reveal before wall panels withdraw; structural illustration, no engineering validation.
      paragraphs: 09000000i
    - mode: openings
      sceneFile: P10-OpenPlanRibbonRoofRamp.unity
      purpose: Open plan, ribbon opening, usable roof/ramp and moving eye views.
      paragraphs: 0a0000000b000000i
    - mode: refuge
      sceneFile: P12-DepressedRefugeSection.unity
      purpose: Depressed seating, hearth, deep overhang/trees; actual inside/outside point rays.
      paragraphs: 0c0000000d000000i
    - mode: courtyard
      sceneFile: P14-LoweredCourtyardEntry.unity
      purpose: Scripted observe/cross/reassess route, lowered entry, blue courtyard/orange goal and two guards crossing direct route.
      paragraphs: 0e0000000f00000010000000i
    - mode: plaza
      sceneFile: P17-OpenPlaza.unity
      purpose: Open elevated plaza paths and intersecting views; own generic arena.
      paragraphs: 11000000i
    - mode: alcove
      sceneFile: P18-ConcealedItemAlcove.unity
      purpose: Projecting wall conceals recognizable treasure; walk around wall to reveal it.
      paragraphs: 12000000i
    - mode: flying
      sceneFile: P20-FlyingEnemyLedges.unity
      purpose: Same run/jump/fire tape; flying drone and variable-height ledges.
      paragraphs: 14000000i
    - mode: shield
      sceneFile: P21-ShieldEnemyCover.unity
      purpose: Same run/jump/fire tape; shielded Knight burst fire and actual cover collision.
      paragraphs: 15000000i
    - mode: boss
      sceneFile: P22-OpenBoss.unity
      purpose: Same run/jump/fire tape; open room with large articulated enemy and no added refuge.
      paragraphs: 16000000i
    - mode: footings
      sceneFile: P23-OpenGroundPortableFootings.unity
      purpose: 'Our visible-ground contrast: conceptual tool lifts/places board, then scripted geometric actor crosses actual support surfaces; no simulated commercial force, insect/AI/damage.'
      paragraphs: 1700000018000000i
    encounterCommands:
    - id: observe
      startFrame: 0
      endFrameExclusive: 120
      velocityX: 0
    - id: run-right
      startFrame: 120
      endFrameExclusive: 300
      velocityX: 1.6
    - id: run-left
      startFrame: 300
      endFrameExclusive: 420
      velocityX: -1.6
    - id: run-right-again
      startFrame: 420
      endFrameExclusive: 600
      velocityX: 1.6
    - id: observe-result
      startFrame: 600
      endFrameExclusive: 720
      velocityX: 0
    jumpFrames: d2000000c2010000i
    fireFrames: 96000000b4000000d2000000c2010000e0010000fe010000i
