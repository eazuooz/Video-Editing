# Node / Motion Canvas
node_modules/
motion-canvas/dist/
*.log

# Python / Manim
.venv/
__pycache__/
*.pyc

# Local PDF reference inspections (not source assets for publication)
tmp/pdfs/

# Rendered output (large binaries, regenerate via scripts/)
/output/
projects/*/production/delivery-stage-*/
projects/*/production/delivery-history/
# motion-canvas/ and narration/ folders stay visible to git for SRT, timing JSON
# and reports, but video/audio binaries are no longer tracked (see below).
# manim/ stays placeholder-only.
shared/output/*
!shared/output/motion-canvas/
!shared/output/manim/
!shared/output/narration/
# Small reconstruction/QA records only; media/cache beneath stays local.
!shared/output/visible-rewards/
shared/output/visible-rewards/*
!shared/output/visible-rewards/audio-final-v2/
shared/output/visible-rewards/audio-final-v2/*
!shared/output/visible-rewards/audio-final-v2/report.json
!shared/output/visible-rewards/visual-qa-v3/
shared/output/visible-rewards/visual-qa-v3/*
!shared/output/visible-rewards/visual-qa-v3/render-report.json
# Motion Canvas may leave temporary PNG sequence folders next to the final MP4.
shared/output/motion-canvas/*/
# Local render checkpoints/silent intermediates (final media is local-only too).
shared/output/motion-canvas/ai-era-cs-fundamentals-*-part-*.mp4
shared/output/motion-canvas/ai-era-cs-fundamentals-*-visual.mp4
# Local backup archives may exist, but are never uploaded to Git.
motion-canvas/src/projects/ai-era-cs-fundamentals/assets/editor-mix.wav
motion-canvas/src/projects/ai-era-cs-fundamentals/assets/mix-v6-artist-music-review.wav
# Scene chunks and A/B previews are reproducible TTS intermediates. Keep the
# SRT, timing JSON, and ASR review file instead. WAV is local-only.
shared/output/narration/**/chunks/
shared/output/narration/**/preview-*.wav
shared/output/narration/**/preview-*.mp3
# Superseded FPS narration prototype; the 1.7B balanced-v2 output is canonical.
shared/output/narration/frame-rate-modern-rendering/qwen3-balanced/
shared/output/manim/*
!shared/output/manim/.gitkeep

# Private voice-cloning material (personal reference recording) and the
# multi-GB TTS models/venvs used to generate narration -- CUDA-only, so
# transferred separately, along with source and rendered audio/video.
shared/voice-reference/
shared/audio-samples/
# Creator-upload music used only for local listening review; rights not cleared.
shared/assets/music/artist-review/
voice-clone/.venv/
voice-clone/*.log
qwen3-tts/.venv/
qwen3-tts/models/

# OS
.DS_Store
Thumbs.db

# 2026-10-05: new raster images are local by default. Existing required assets
# remain tracked. A reviewed essential image needs an exact exception below and
# a path/purpose/SHA256 entry in shared/git-essential-images.json; never bulk-add
# extracted frames, contact sheets, overlays or render/QA image sequences.
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.[pP][nN][gG]
*.[wW][eE][bB][pP]
*.[gG][iI][fF]
*.[bB][mM][pP]
*.[tT][iI][fF]
*.[tT][iI][fF][fF]

# Machine-local credentials and editor state
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
.vs/

# Unity project at unity/. The nested unity/VideoEditing project has its own
# .gitignore; source Assets/.meta, Packages and ProjectSettings remain eligible
# subject to the repository-wide media/image policy.
unity/[Ll]ibrary/
unity/[Tt]emp/
unity/[Oo]bj/
unity/[Ll]ogs/
unity/[Uu]ser[Ss]ettings/
unity/[Bb]uild/
unity/[Bb]uilds/
unity/[Mm]emoryCaptures/
unity/[Rr]ecordings/
unity/*.csproj
unity/*.sln
unity/*.slnx

# Unreal: source Content/Config/.uproject travel; generated caches do not.
# The UE5.8 project lives at unreal/VideoEditing and carries its own .gitignore.
unreal/DerivedDataCache/
unreal/Intermediate/
unreal/Saved/
unreal/Binaries/
unreal/*/DerivedDataCache/
unreal/*/Intermediate/
unreal/*/Saved/
unreal/*/Binaries/

# Rebuildable assembly fragments (completed review/final videos remain local).
shared/output/motion-canvas/let-them-play-V4-GRAPHICS-*.mp4
shared/output/motion-canvas/let-them-play-V4-PICTURE-*.mp4
shared/output/motion-canvas/let-them-play-V5-GAME-*.mp4
shared/output/motion-canvas/let-them-play-V5-GRAPHICS-*.mp4
shared/output/motion-canvas/let-them-play-V5-GRAPHICS-*.mp4.render.json
shared/output/motion-canvas/let-them-play-EDITORIAL-25D-SAMPLE-picture.mp4
shared/output/motion-canvas/visible-rewards-GAME-v1-*.mp4
shared/output/motion-canvas/visible-rewards-GRAPHICS-v1-*.mp4
shared/output/motion-canvas/visible-rewards-GAME-v2-*.mp4
shared/output/motion-canvas/visible-rewards-GRAPHICS-v2-*.mp4
shared/output/motion-canvas/visible-rewards-GAME-v3-*.mp4
shared/output/motion-canvas/visible-rewards-GRAPHICS-v3-*.mp4

# Lossless copies in shared/media-archives are LOCAL/external backups only.
# restore-media.cjs requires archive parts transferred separately from Git.
shared/output/motion-canvas/let-them-play.mp4
shared/output/motion-canvas/visible-rewards.mp4
# Both v2 and v3, including any compressed chunks, are local-only.
shared/output/motion-canvas/visible-rewards-v2.mp4
shared/output/motion-canvas/visible-rewards-final.mp4
# Rebuildable, rights-pending Astra showcase graphics review fragments.
shared/output/motion-canvas/astra-review-v1-graphics-*.mp4
shared/output/motion-canvas/astra-review-v2-graphics-*.mp4

# 2026-09-26 user request: never commit video/audio binaries.
# Files stay on disk; transfer them outside Git, never as split archives in Git.
*.mp4
*.MP4
*.wav
*.WAV
# Browser playback previews follow the same local-only media policy.
*.webm
*.WEBM

