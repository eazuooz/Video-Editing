shared/output/motion-canvas/visible-rewards-GAME-v3-*.mp4
shared/output/motion-canvas/visible-rewards-GRAPHICS-v3-*.mp4

# Lossless copies in shared/media-archives are LOCAL/external backups only.
# restore-media.cjs requires archive parts transferred separately from Git.
shared/output/motion-canvas/let-them-play.mp4
shared/output/motion-canvas/visible-rewards.mp4
# Both v2 and v3, including any compressed chunks, are local-only.
shared/output/motion-canvas/visible-rewards-v2.mp4
shared/output/motion-canvas/visible-rewards-final.mp4
# Rebuildable, rights-pending Astra showcase graphics review fragments.
shared/output/motion-canvas/astra-review-v1-graphics-*.mp4
shared/output/motion-canvas/astra-review-v2-graphics-*.mp4

