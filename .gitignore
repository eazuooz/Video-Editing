# Node / Motion Canvas
node_modules/
motion-canvas/dist/
*.log

# Python / Manim
.venv/
__pycache__/
*.pyc

# Local PDF reference inspections (not source assets for publication)
tmp/pdfs/

# Rendered output (large binaries, regenerate via scripts/)
# motion-canvas/ and narration/ ARE tracked so finished video/audio can be
# pulled on another machine (e.g. editing in Final Cut Pro) without needing
# the GPU/model that produced them. manim/ stays placeholder-only.
shared/output/*
!shared/output/motion-canvas/
!shared/output/manim/
!shared/output/narration/
# Motion Canvas may leave temporary PNG sequence folders next to the final MP4.
shared/output/motion-canvas/*/
# Local render checkpoints/silent intermediates; completed review MP4s stay tracked.
shared/output/motion-canvas/ai-era-cs-fundamentals-*-part-*.mp4
shared/output/motion-canvas/ai-era-cs-fundamentals-*-visual.mp4
# Byte-exact copies are stored as <=80 MiB gzip parts in shared/media-archives/.
motion-canvas/src/projects/ai-era-cs-fundamentals/assets/editor-mix.wav
motion-canvas/src/projects/ai-era-cs-fundamentals/assets/mix-v6-artist-music-review.wav
# Scene chunks and A/B previews are reproducible TTS intermediates. Keep the
# final WAV, SRT, timing JSON, and ASR review file instead.
shared/output/narration/**/chunks/
shared/output/narration/**/preview-*.wav
shared/output/narration/**/preview-*.mp3
# Superseded FPS narration prototype; the 1.7B balanced-v2 output is canonical.
shared/output/narration/frame-rate-modern-rendering/qwen3-balanced/
shared/output/manim/*
!shared/output/manim/.gitkeep

# Private voice-cloning material (personal reference recording) and the
# multi-GB TTS models/venvs used to generate narration -- CUDA-only, so
# useless on a non-NVIDIA machine anyway. Only the rendered output above
# (the actual audio/video) needs to travel between machines.
shared/voice-reference/
shared/audio-samples/
# Creator-upload music used only for local listening review; rights not cleared.
shared/assets/music/artist-review/
voice-clone/.venv/
voice-clone/*.log
qwen3-tts/.venv/
qwen3-tts/models/

# OS
.DS_Store
Thumbs.db
