  "sceneScript": {
    "file": "projects/choice-driven-classics/script/narration.ko.json",
    "data": {
      "title": "내 선택으로 결말이 달라지는 세계 고전 소설",
      "scenes": [
        {
          "id": "01",
          "title": "도입",
          "lines": [
            "고전의 주인공이 된다면, 당신은 어떤 선택을 하겠습니까?"
          ]
        },
        {
          "id": "02",
          "title": "본론",
          "lines": [
            "세계 고전을 읽고, 대화와 행동을 선택하는 PC 게임입니다."
          ]
        },
        {
          "id": "03",
          "title": "선택의 결과",
          "lines": [
            "내 선택이 인물 관계와 다음 장면, 결말을 바꿉니다."
          ]
        },
        {
          "id": "04",
          "title": "작가 중심의 제작",
          "lines": [
            "AI가 초고를 돕고, 작가가 모든 문장을 검수합니다.",
            "흑백 펜화로 소설의 감각을 살립니다."
          ]
        },
        {
          "id": "05",
          "title": "작품별 출간",
          "lines": [
            "무료 데모로 검증하고, 작품별 완결판으로 출간합니다."
          ]
        },
        {
          "id": "06",
          "title": "첫 데모를 향해",
          "lines": [
            "내 선택으로 결말이 달라지는 세계 고전 소설.",
            "첫 30분 데모부터 시작하겠습니다."
          ]
        }
      ]
    }
  },
