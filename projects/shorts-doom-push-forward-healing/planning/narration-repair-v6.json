    },
    {
      "id": "u010",
      "paragraph": "p003",
      "ko": "체력이 낮을 때 필요한 회복을 얻는 구조가 전진을 돕습니다.",
      "sourceRaw": {
        "path": "D:\\Github\\VideoEditing\\shared\\output\\original-tech-twelve-20261115\\shorts-doom-push-forward-healing\\voice-sentence-v2\\chunks\\u010-scene.wav",
        "sha256": "45e7123251159d5aee568f28c2482468761573b754124caec0ec57163a788877",
