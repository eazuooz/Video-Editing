    },
    {
      "id": "s6u0161",
      "paragraph": "p005",
      "ko": "자원을 얻는 행동에도 비용이 있습니다.",
      "originUnit": "u016"
    },
    {
      "id": "s6u0162",
      "paragraph": "p005",
      "ko": "연료를 써야 전기톱의 탄약 보상을 얻습니다.",
      "originUnit": "u016"
