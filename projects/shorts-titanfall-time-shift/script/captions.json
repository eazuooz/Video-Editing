  "cues": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "버튼을 누르자,",
      "ko": "버튼을 누르자,",
      "en": "Press the button.",
      "start": 0.2,
      "end": 1.1833333333333333,
      "startFrame": 12,
      "endFrame": 71
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "불타던 복도가 멀쩡해집니다.",
      "ko": "불타던 복도가 멀쩡해집니다.",
      "en": "The burning corridor becomes intact.",
      "start": 1.1833333333333333,
      "end": 3.3833333333333333,
      "startFrame": 71,
      "endFrame": 203
    },
    {
      "id": "p1-3",
      "lineIndex": 0,
      "spoken": "타이탄폴 투의 시간여행이죠.",
      "ko": "타이탄폴 2의 시간여행이죠.",
      "en": "This is Titanfall 2’s time shift.",
      "start": 3.6333333333333333,
      "end": 5.533333333333333,
      "startFrame": 218,
      "endFrame": 332
    },
    {
      "id": "p2-1",
      "lineIndex": 1,
      "spoken": "그런데 이 장치는",
      "ko": "그런데 이 장치는",
      "en": "Yet this device",
      "start": 5.8,
      "end": 6.783333333333333,
      "startFrame": 348,
      "endFrame": 407
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "플레이어를 위아래로 옮깁니다.",
      "ko": "플레이어를 위아래로 옮깁니다.",
      "en": "moves the player up and down.",
      "emphasis": {
        "text": "위아래",
        "role": "result"
      },
      "start": 6.783333333333333,
      "end": 9.033333333333333,
      "startFrame": 407,
      "endFrame": 542
    },
    {
      "id": "p3-1",
      "lineIndex": 2,
      "spoken": "과거와 현재의 맵을",
      "ko": "과거와 현재의 맵을",
      "en": "The past and present maps",
      "start": 9.233333333333333,
      "end": 10.516666666666667,
      "startFrame": 554,
      "endFrame": 631
    },
    {
      "id": "p3-2",
      "lineIndex": 2,
      "spoken": "같은 위치에 맞춰,",
      "ko": "같은 위치에 맞춰,",
      "en": "are aligned with each other,",
      "start": 10.516666666666667,
      "end": 11.566666666666666,
      "startFrame": 631,
      "endFrame": 694
    },
    {
      "id": "p3-3",
      "lineIndex": 2,
      "spoken": "하나는 위에, 하나는 아래에 놓은 거예요.",
      "ko": "하나는 위에, 하나는 아래에 놓은 거예요.",
      "en": "one above the other.",
      "start": 11.883333333333333,
      "end": 14.666666666666666,
      "startFrame": 713,
      "endFrame": 880
    },
    {
      "id": "p4-1",
      "lineIndex": 3,
      "spoken": "버튼을 누르면",
      "ko": "버튼을 누르면",
      "en": "Press the button",
      "start": 14.883333333333333,
      "end": 15.633333333333333,
      "startFrame": 893,
      "endFrame": 938
    },
    {
      "id": "p4-2",
      "lineIndex": 3,
      "spoken": "두 맵 사이의 높이 차이만큼",
      "ko": "두 맵 사이의 높이 차이만큼",
      "en": "and teleport by the height difference",
      "start": 15.633333333333333,
      "end": 17.783333333333335,
      "startFrame": 938,
      "endFrame": 1067
    },
    {
      "id": "p4-3",
      "lineIndex": 3,
      "spoken": "위치를 순간이동시킵니다.",
      "ko": "위치를 순간이동시킵니다.",
      "en": "between the two maps.",
      "emphasis": {
        "text": "순간이동",
        "role": "term"
      },
      "start": 17.783333333333335,
      "end": 19.516666666666666,
      "startFrame": 1067,
      "endFrame": 1171
    },
    {
      "id": "p5-1",
      "lineIndex": 4,
      "spoken": "우리 시연에서 두 층의 간격이 십 미터라면,",
      "ko": "우리 시연에서 두 층의 간격이 10m라면,",
      "en": "If our demo floors are 10 metres apart,",
      "start": 19.566666666666666,
      "end": 22.016666666666666,
      "startFrame": 1174,
      "endFrame": 1321
    },
    {
      "id": "p5-2",
      "lineIndex": 4,
      "spoken": "앞뒤 위치는 그대로 두고",
      "ko": "앞뒤 위치는 그대로 두고",
      "en": "keep the horizontal position",
      "start": 22.333333333333332,
      "end": 23.716666666666665,
      "startFrame": 1340,
      "endFrame": 1423
    },
    {
      "id": "p5-3",
      "lineIndex": 4,
      "spoken": "높이에 십 미터를 더하는 겁니다.",
      "ko": "높이에 10m를 더하는 겁니다.",
      "en": "and add 10 metres to the height.",
      "start": 23.716666666666665,
      "end": 25.466666666666665,
      "startFrame": 1423,
      "endFrame": 1528
    },
    {
      "id": "p6-1",
      "lineIndex": 5,
      "spoken": "카메라 방향도 이어지니",
      "ko": "카메라 방향도 이어지니",
      "en": "The camera keeps its direction,",
      "start": 25.666666666666668,
      "end": 26.833333333333332,
      "startFrame": 1540,
      "endFrame": 1610
    },
    {
      "id": "p6-2",
      "lineIndex": 5,
      "spoken": "플레이어에게는 장소가 바뀐 게 아니라",
      "ko": "플레이어에게는 장소가 바뀐 게 아니라",
      "en": "so the player perceives",
      "start": 26.833333333333332,
      "end": 28.8,
      "startFrame": 1610,
      "endFrame": 1728
    },
    {
      "id": "p6-3",
      "lineIndex": 5,
      "spoken": "시간이 바뀐 것처럼 보이죠.",
      "ko": "시간이 바뀐 것처럼 보이죠.",
      "en": "a change of time in the same place.",
      "start": 28.833333333333332,
      "end": 30.3,
      "startFrame": 1730,
      "endFrame": 1818
    },
    {
      "id": "p7-1",
      "lineIndex": 6,
      "spoken": "한 시대에서 막힌 길을",
      "ko": "한 시대에서 막힌 길을",
      "en": "A path blocked in one era",
      "start": 30.6,
      "end": 31.983333333333334,
      "startFrame": 1836,
      "endFrame": 1919
    },
    {
      "id": "p7-2",
      "lineIndex": 6,
      "spoken": "다른 시대에서 지나간 뒤",
      "ko": "다른 시대에서 지나간 뒤",
      "en": "can be crossed in the other",
      "start": 31.983333333333334,
      "end": 33.4,
      "startFrame": 1919,
      "endFrame": 2004
    },
    {
      "id": "p7-3",
      "lineIndex": 6,
      "spoken": "다시 돌아올 수도 있습니다.",
      "ko": "다시 돌아올 수도 있습니다.",
      "en": "before switching back.",
      "start": 33.4,
      "end": 34.766666666666666,
      "startFrame": 2004,
      "endFrame": 2086
    },
    {
      "id": "p8-1",
      "lineIndex": 7,
      "spoken": "맵 두 개와 순간이동을 맞물려,",
      "ko": "맵 두 개와 순간이동을 맞물려,",
      "en": "Two maps and a teleport work together",
      "emphasis": {
        "text": "순간이동",
        "role": "term"
      },
      "start": 35.13333333333333,
      "end": 37.3,
      "startFrame": 2108,
      "endFrame": 2238
    },
    {
      "id": "p8-2",
      "lineIndex": 7,
      "spoken": "공간 이동을 시간여행으로 느끼게 만든 거예요.",
      "ko": "공간 이동을 시간여행으로 느끼게 만든 거예요.",
      "en": "to make a spatial jump feel like time travel.",
