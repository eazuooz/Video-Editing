  "cues": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "스플래툰의 잉크는 바닥뿐 아니라 벽에도 붙죠.",
      "ko": "스플래툰의 잉크는 바닥뿐 아니라 벽에도 붙죠.",
      "en": "Splatoon ink sticks to floors and walls.",
      "start": 0.2,
      "end": 2.7666666666666666,
      "startFrame": 12,
      "endFrame": 166
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "어떻게 맞은 자리에 색이 남을까요?",
      "ko": "어떻게 맞은 자리에 색이 남을까요?",
      "en": "How does color stay where it hits?",
      "start": 3.1333333333333333,
      "end": 4.916666666666667,
      "startFrame": 188,
      "endFrame": 295
    },
    {
      "id": "p2-1",
      "lineIndex": 1,
      "spoken": "닌텐도 특허에 공개된 방식은",
      "ko": "닌텐도 특허에 공개된 방식은",
      "en": "A method disclosed in a Nintendo patent",
      "start": 5.166666666666667,
      "end": 7.2,
      "startFrame": 310,
      "endFrame": 432
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "표면에 투명한 색칠 종이를 연결하는 겁니다.",
      "ko": "표면에 투명한 색칠 종이를 연결하는 겁니다.",
      "en": "links a surface to a transparent painting sheet.",
      "start": 7.2,
      "end": 9.766666666666667,
      "startFrame": 432,
      "endFrame": 586
    },
    {
      "id": "p2-3",
      "lineIndex": 1,
      "spoken": "색을 저장하는 이 그림을 텍스처라고 해요.",
      "ko": "색을 저장하는 이 그림을 텍스처라고 해요.",
      "en": "This color image is a texture.",
      "start": 10.116666666666667,
      "end": 12.516666666666667,
      "startFrame": 607,
      "endFrame": 751
    },
    {
      "id": "p3-1",
      "lineIndex": 2,
      "spoken": "먼저 잉크가 어디에 맞았는지 충돌을 검사합니다.",
      "ko": "먼저 잉크가 어디에 맞았는지 충돌을 검사합니다.",
      "en": "First, detect where the ink hits.",
      "start": 12.733333333333333,
      "end": 16.633333333333333,
      "startFrame": 764,
      "endFrame": 998
    },
    {
      "id": "p3-2",
      "lineIndex": 2,
      "spoken": "그 입체 좌표를",
      "ko": "그 입체 좌표를",
      "en": "Convert that three-dimensional point",
      "start": 16.9,
      "end": 17.816666666666666,
      "startFrame": 1014,
      "endFrame": 1069
    },
    {
      "id": "p3-3",
      "lineIndex": 2,
      "spoken": "표면에 붙인 가상 평면의 좌표로 바꿔요.",
      "ko": "표면에 붙인 가상 평면의 좌표로 바꿔요.",
      "en": "to coordinates on a virtual plane.",
      "start": 17.816666666666666,
      "end": 20.416666666666668,
      "startFrame": 1069,
      "endFrame": 1225
    },
    {
      "id": "p4-1",
      "lineIndex": 3,
      "spoken": "다음은 그림에서 색칠할 주소를 찾습니다.",
      "ko": "다음은 그림에서 색칠할 주소를 찾습니다.",
      "en": "Find the address to paint in the image.",
      "start": 20.583333333333332,
      "end": 23.2,
      "startFrame": 1235,
      "endFrame": 1392
    },
    {
      "id": "p4-2",
      "lineIndex": 3,
      "spoken": "유브이 좌표라고 하죠.",
      "ko": "UV 좌표라고 하죠.",
      "en": "These are UV coordinates.",
      "start": 23.383333333333333,
      "end": 24.7,
      "startFrame": 1403,
      "endFrame": 1482
    },
    {
      "id": "p4-3",
      "lineIndex": 3,
      "spoken": "그림의 가로 절반, 세로 절반이면",
      "ko": "그림의 가로 절반, 세로 절반이면",
      "en": "Halfway across and halfway up",
      "start": 25.0,
      "end": 26.883333333333333,
      "startFrame": 1500,
      "endFrame": 1613
    },
    {
      "id": "p4-4",
      "lineIndex": 3,
      "spoken": "가로 주소는 영점오, 세로 주소도 영점오입니다.",
      "ko": "가로 주소 U = 0.5\n세로 주소 V = 0.5",
      "en": "The horizontal and vertical addresses are both 0.5.",
      "start": 26.883333333333333,
      "end": 30.416666666666668,
      "startFrame": 1613,
      "endFrame": 1825
    },
    {
      "id": "p5-1",
      "lineIndex": 4,
      "spoken": "그 주소 주변에 잉크 모양을 찍고,",
      "ko": "그 주소 주변에 잉크 모양을 찍고,",
      "en": "Stamp an ink shape around that address",
      "start": 30.65,
      "end": 32.63333333333333,
      "startFrame": 1839,
      "endFrame": 1958
    },
    {
      "id": "p5-2",
      "lineIndex": 4,
      "spoken": "원래 벽 그림과 합칩니다.",
      "ko": "원래 벽 그림과 합칩니다.",
      "en": "and combine it with the wall image.",
      "start": 32.63333333333333,
      "end": 34.46666666666667,
      "startFrame": 1958,
      "endFrame": 2068
    },
    {
      "id": "p5-3",
      "lineIndex": 4,
      "spoken": "바닥이나 벽의 방향이 달라도,",
      "ko": "바닥이나 벽의 방향이 달라도,",
      "en": "For a floor or a differently oriented wall,",
      "start": 34.8,
      "end": 36.6,
      "startFrame": 2088,
      "endFrame": 2196
    },
    {
      "id": "p5-4",
      "lineIndex": 4,
      "spoken": "각 표면의 좌표에 연결하면 돼요.",
      "ko": "각 표면의 좌표에 연결하면 돼요.",
      "en": "use the corresponding surface coordinates.",
      "start": 36.6,
      "end": 39.2,
      "startFrame": 2196,
      "endFrame": 2352
    },
    {
      "id": "p6-1",
      "lineIndex": 5,
      "spoken": "그림 조각의 경계에서는 자국이 끊길 수 있겠죠?",
      "ko": "그림 조각의 경계에서는 자국이 끊길 수 있겠죠?",
      "en": "A mark could break at a patch boundary.",
      "start": 39.43333333333333,
      "end": 42.05,
      "startFrame": 2366,
      "endFrame": 2523
    },
    {
      "id": "p6-2",
      "lineIndex": 5,
      "spoken": "그래서 옆에 있는 가상 표면까지 연결해서 처리합니다.",
      "ko": "옆에 있는 가상 표면까지\n연결해서 처리합니다.",
      "en": "Connect the neighboring virtual surfaces.",
      "start": 42.31666666666667,
      "end": 44.88333333333333,
      "startFrame": 2539,
      "endFrame": 2693
    },
    {
      "id": "p7-1",
      "lineIndex": 6,
      "spoken": "카메라를 돌려도 잉크는 제자리에 남습니다.",
      "ko": "카메라를 돌려도 잉크는 제자리에 남습니다.",
      "en": "Turn the camera: the ink stays in place.",
      "start": 45.11666666666667,
      "end": 47.88333333333333,
      "startFrame": 2707,
      "endFrame": 2873
    },
    {
      "id": "p7-2",
      "lineIndex": 6,
      "spoken": "화면이 아니라,",
      "ko": "화면이 아니라,",
      "en": "It is not stored on the screen,",
      "start": 48.2,
      "end": 48.78333333333333,
      "startFrame": 2892,
      "endFrame": 2927
    },
    {
      "id": "p7-3",
      "lineIndex": 6,
      "spoken": "표면의 텍스처에 색을 기록하기 때문이에요.",
      "ko": "표면의 텍스처에\n색을 기록하기 때문이에요.",
      "en": "because color is recorded in the surface texture.",
      "start": 48.78333333333333,
      "end": 51.68333333333333,
      "startFrame": 2927,
      "endFrame": 3101
    }
  ]
