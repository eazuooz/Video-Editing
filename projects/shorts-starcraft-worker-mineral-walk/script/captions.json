  "cues": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "이 일꾼들은 광물과 기지를 계속 왕복하죠.",
      "ko": "이 일꾼들은 광물과 기지를 계속 왕복하죠.",
      "en": "Workers go between minerals and base.",
      "start": 0.2,
      "end": 3.2333333333333334,
      "startFrame": 12,
      "endFrame": 194
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "서로 길을 막으면 돈벌이까지 멈추니,",
      "ko": "서로 길을 막으면 돈벌이까지 멈추니,",
      "en": "Blocking one another stops their income too,",
      "start": 3.4166666666666665,
      "end": 5.783333333333333,
      "startFrame": 205,
      "endFrame": 347
    },
    {
      "id": "p1-2b",
      "lineIndex": 0,
      "spoken": "개발자는 특별한 규칙을 넣었습니다.",
      "ko": "개발자는 특별한 규칙을 넣었습니다.",
      "en": "so developers added a special rule.",
      "start": 5.783333333333333,
      "end": 8.083333333333334,
      "startFrame": 347,
      "endFrame": 485
    },
    {
      "id": "p2-1",
      "lineIndex": 1,
      "spoken": "보통 유닛은 다른 유닛의 몸을 피해 움직입니다.",
      "ko": "보통 유닛은 다른 유닛의 몸을 피해 움직입니다.",
      "en": "Normally, a unit moves around other units’ bodies.",
      "start": 8.283333333333333,
      "end": 11.133333333333333,
      "startFrame": 497,
      "endFrame": 668
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "좁은 곳에서 일꾼들이 마주 오면,",
      "ko": "좁은 곳에서 일꾼들이 마주 오면,",
      "en": "When workers meet in a tight space,",
      "start": 11.3,
      "end": 13.1,
      "startFrame": 678,
      "endFrame": 786
    },
    {
      "id": "p2-2b",
      "lineIndex": 1,
      "spoken": "서로 막혀 움직이지 못할 수 있죠.",
      "ko": "서로 막혀 움직이지 못할 수 있죠.",
      "en": "they can block one another and get stuck.",
      "start": 13.1,
      "end": 15.266666666666667,
      "startFrame": 786,
      "endFrame": 916
    },
    {
      "id": "p3-1",
      "lineIndex": 2,
      "spoken": "그래서 자원을 캐러 가거나,",
      "ko": "그래서 자원을 캐러 가거나,",
      "en": "So while heading to resources,",
      "start": 15.433333333333334,
      "end": 16.883333333333333,
      "startFrame": 926,
      "endFrame": 1013
    },
    {
      "id": "p3-1b",
      "lineIndex": 2,
      "spoken": "자원을 들고 돌아오는 동안에는,",
      "ko": "자원을 들고 돌아오는 동안에는,",
      "en": "or returning while carrying them,",
      "start": 16.883333333333333,
      "end": 18.766666666666666,
      "startFrame": 1013,
      "endFrame": 1126
    },
    {
      "id": "p3-2",
      "lineIndex": 2,
      "spoken": "다른 유닛과의 충돌을 무시하도록 했습니다.",
      "ko": "다른 유닛과의 충돌을 무시하도록 했습니다.",
      "en": "they ignore collisions with other units.",
      "start": 18.9,
      "end": 21.683333333333334,
      "startFrame": 1134,
      "endFrame": 1301
    },
    {
      "id": "p4-1",
      "lineIndex": 3,
      "spoken": "우리 시연에선 유닛과 길은 그대로 두고,",
      "ko": "우리 시연에선 유닛과 길은 그대로 두고,",
      "en": "In our demonstration, keep the units and path fixed,",
      "start": 21.883333333333333,
      "end": 24.466666666666665,
      "startFrame": 1313,
      "endFrame": 1468
    },
    {
      "id": "p4-1b",
      "lineIndex": 3,
      "spoken": "이동 상태만 바꿔 볼게요.",
      "ko": "이동 상태만 바꿔 볼게요.",
      "en": "and change only the movement state.",
      "start": 24.466666666666665,
      "end": 26.2,
      "startFrame": 1468,
      "endFrame": 1572
    },
    {
      "id": "p4-2",
      "lineIndex": 3,
      "spoken": "일반 이동에선 막히지만,",
      "ko": "일반 이동에선 막히지만,",
      "en": "Normal movement gets blocked,",
      "start": 26.4,
      "end": 27.833333333333332,
      "startFrame": 1584,
      "endFrame": 1670
    },
    {
      "id": "p4-2b",
      "lineIndex": 3,
      "spoken": "채집 상태에선 겹쳐서 지나갑니다.",
      "ko": "채집 상태에선 겹쳐서 지나갑니다.",
      "en": "but harvesting workers overlap and pass through.",
      "start": 27.833333333333332,
      "end": 30.083333333333332,
      "startFrame": 1670,
      "endFrame": 1805
    },
    {
      "id": "p5-1",
      "lineIndex": 4,
      "spoken": "채집 중인 일꾼들에게 정지를 명령하면,",
      "ko": "채집 중인 일꾼들에게 정지를 명령하면,",
      "en": "Order the harvesting workers to stop,",
      "start": 30.2,
      "end": 32.43333333333333,
      "startFrame": 1812,
      "endFrame": 1946
    },
    {
      "id": "p5-1b",
      "lineIndex": 4,
      "spoken": "서로 겹치지 않도록 흩어지죠.",
      "ko": "서로 겹치지 않도록 흩어지죠.",
      "en": "and they spread out to avoid overlap.",
      "start": 32.43333333333333,
      "end": 34.666666666666664,
      "startFrame": 1946,
      "endFrame": 2080
    },
    {
      "id": "p5-2",
      "lineIndex": 4,
      "spoken": "이 예외는 유닛 사이의 충돌에 적용됩니다.",
      "ko": "이 예외는 유닛 사이의 충돌에 적용됩니다.",
      "en": "This exception applies to collisions between units.",
      "start": 34.88333333333333,
      "end": 37.43333333333333,
      "startFrame": 2093,
      "endFrame": 2246
    },
    {
      "id": "p5-3",
      "lineIndex": 4,
      "spoken": "벽과 건물을 뚫는 능력은 아니에요.",
      "ko": "벽과 건물을 뚫는 능력은 아니에요.",
      "en": "It does not let them pass through walls or buildings.",
      "start": 37.666666666666664,
      "end": 39.766666666666666,
      "startFrame": 2260,
      "endFrame": 2386
    },
    {
      "id": "p6-1",
      "lineIndex": 5,
      "spoken": "이렇게 채집에 꼭 필요한 이동만",
      "ko": "이렇게 채집에 꼭 필요한 이동만",
      "en": "The movement needed for harvesting",
      "start": 39.96666666666667,
      "end": 42.13333333333333,
      "startFrame": 2398,
      "endFrame": 2528
    },
    {
      "id": "p6-1b",
      "lineIndex": 5,
      "spoken": "막힘없이 만든 겁니다.",
      "ko": "막힘없이 만든 겁니다.",
      "en": "can now keep flowing.",
      "start": 42.13333333333333,
      "end": 43.61666666666667,
      "startFrame": 2528,
      "endFrame": 2617
    },
    {
      "id": "p6-2",
      "lineIndex": 5,
      "spoken": "길찾기를 전부 뜯어고치지 않고도,",
      "ko": "길찾기를 전부 뜯어고치지 않고도,",
      "en": "Without rebuilding all of pathfinding,",
      "start": 43.8,
      "end": 45.71666666666667,
      "startFrame": 2628,
      "endFrame": 2743
    },
    {
      "id": "p6-2b",
      "lineIndex": 5,
      "spoken": "기지의 돈줄을 지킨 작은 예외였죠.",
      "ko": "기지의 돈줄을 지킨 작은 예외였죠.",
      "en": "a small exception kept the economy flowing.",
      "start": 45.71666666666667,
      "end": 48.3,
      "startFrame": 2743,
      "endFrame": 2898
    }
  ]
