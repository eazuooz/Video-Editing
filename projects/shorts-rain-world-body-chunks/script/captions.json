  "cues": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "붙잡고 오르는 이 캐릭터.",
      "ko": "붙잡고 오르는 이 캐릭터.",
      "en": "This character clings on and climbs.",
      "start": 0.2,
      "end": 2.0166666666666666,
      "startFrame": 12,
      "endFrame": 121
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "몸속 구조는 놀랄 만큼 단순합니다.",
      "ko": "몸속 구조는 놀랄 만큼 단순합니다.",
      "en": "Its underlying body is surprisingly simple.",
      "start": 2.0166666666666666,
      "end": 4.616666666666666,
      "startFrame": 121,
      "endFrame": 277
    },
    {
      "id": "p2-1",
      "lineIndex": 1,
      "spoken": "레인 월드의 슬러그캣은,",
      "ko": "레인 월드의 슬러그캣은,",
      "en": "Rain World represents the slugcat",
      "start": 4.8,
      "end": 6.133333333333334,
      "startFrame": 288,
      "endFrame": 368
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "기본 몸체를 두 개의 둥근 덩어리로 표현해요.",
      "ko": "기본 몸체를 두 개의 둥근 덩어리로 표현해요.",
      "en": "with a basic body made of two round chunks.",
      "start": 6.133333333333334,
      "end": 9.183333333333334,
      "startFrame": 368,
      "endFrame": 551
    },
    {
      "id": "p2-3",
      "lineIndex": 1,
      "spoken": "두 덩어리 사이의 거리를 유지하면서 움직입니다.",
      "ko": "두 덩어리 사이의 거리를 유지하면서 움직입니다.",
      "en": "They move while maintaining a set distance.",
      "start": 9.433333333333334,
      "end": 12.2,
      "startFrame": 566,
      "endFrame": 732
    },
    {
      "id": "p3-1",
      "lineIndex": 2,
      "spoken": "앞쪽이 올라가면 뒤쪽이 따라오고,",
      "ko": "앞쪽이 올라가면 뒤쪽이 따라오고,",
      "en": "When the front rises, the back follows.",
      "start": 12.416666666666666,
      "end": 14.233333333333333,
      "startFrame": 745,
      "endFrame": 854
    },
    {
      "id": "p3-2",
      "lineIndex": 2,
      "spoken": "한쪽이 걸리면 몸 전체가 회전할 수 있죠.",
      "ko": "한쪽이 걸리면 몸 전체가 회전할 수 있죠.",
      "en": "When one part catches, the body can rotate.",
      "start": 14.233333333333333,
      "end": 16.683333333333334,
      "startFrame": 854,
      "endFrame": 1001
    },
    {
      "id": "p3-3",
      "lineIndex": 2,
      "spoken": "우리 시연에서도 연결 길이를 유지하며 방향이 바뀝니다.",
      "ko": "우리 시연에서도 연결 길이를 유지하며 방향이 바뀝니다.",
      "en": "Our demo turns without changing that length.",
      "start": 17.0,
      "end": 20.416666666666668,
      "startFrame": 1020,
      "endFrame": 1225
    },
    {
      "id": "p4-1",
      "lineIndex": 3,
      "spoken": "여기에 팔과 다리, 꼬리를 그립니다.",
      "ko": "여기에 팔과 다리, 꼬리를 그립니다.",
      "en": "Limbs and a tail are drawn over this base.",
      "start": 20.483333333333334,
      "end": 22.766666666666666,
      "startFrame": 1229,
      "endFrame": 1366
    },
    {
      "id": "p4-2",
      "lineIndex": 3,
      "spoken": "입력과 몸의 움직임에 맞춰,",
      "ko": "입력과 몸의 움직임에 맞춰,",
      "en": "Their poses respond to input and body movement,",
      "start": 22.983333333333334,
      "end": 24.416666666666668,
      "startFrame": 1379,
      "endFrame": 1465
    },
    {
      "id": "p4-3",
      "lineIndex": 3,
      "spoken": "그때그때 자세를 계산하는 거예요.",
      "ko": "그때그때 자세를 계산하는 거예요.",
      "en": "and are calculated as the character moves.",
      "start": 24.416666666666668,
      "end": 26.3,
      "startFrame": 1465,
      "endFrame": 1578
    },
    {
      "id": "p5-1",
      "lineIndex": 4,
      "spoken": "이것이 절차적 애니메이션입니다.",
      "ko": "이것이 절차적 애니메이션입니다.",
      "en": "This is procedural animation.",
      "start": 26.5,
      "end": 28.466666666666665,
      "startFrame": 1590,
      "endFrame": 1708
    },
    {
      "id": "p5-2",
      "lineIndex": 4,
      "spoken": "몸의 계산 구조와 눈에 보이는 모습을 나누니,",
      "ko": "몸의 계산 구조와 눈에 보이는 모습을 나누니,",
      "en": "Separating the calculated body from its appearance",
      "start": 28.466666666666665,
      "end": 30.933333333333334,
      "startFrame": 1708,
      "endFrame": 1856
    },
    {
      "id": "p5-3",
      "lineIndex": 4,
      "spoken": "단순한 몸체에서도 다양한 동작이 나옵니다.",
      "ko": "단순한 몸체에서도 다양한 동작이 나옵니다.",
      "en": "lets a simple base produce varied motion.",
      "start": 30.933333333333334,
      "end": 33.46666666666667,
      "startFrame": 1856,
      "endFrame": 2008
    },
    {
      "id": "p6-1",
      "lineIndex": 5,
      "spoken": "이렇게 매달리고 몸을 돌며,",
      "ko": "이렇게 매달리고 몸을 돌며,",
      "en": "As it hangs on and turns,",
      "start": 33.7,
      "end": 35.36666666666667,
      "startFrame": 2022,
      "endFrame": 2122
    },
    {
      "id": "p6-2",
      "lineIndex": 5,
      "spoken": "상황에 맞는 움직임이 만들어집니다.",
      "ko": "상황에 맞는 움직임이 만들어집니다.",
      "en": "its movement adapts to the situation.",
      "start": 35.36666666666667,
      "end": 37.53333333333333,
      "startFrame": 2122,
      "endFrame": 2252
    },
    {
      "id": "p6-3",
      "lineIndex": 5,
      "spoken": "복잡해 보이는 동작의 출발점은,",
      "ko": "복잡해 보이는 동작의 출발점은,",
      "en": "Those complex-looking movements begin with",
      "start": 37.61666666666667,
      "end": 39.56666666666667,
      "startFrame": 2257,
      "endFrame": 2374
    },
    {
      "id": "p6-4",
      "lineIndex": 5,
      "spoken": "연결된 두 덩어리였던 거죠.",
      "ko": "연결된 두 덩어리였던 거죠.",
      "en": "two connected chunks.",
