      "startFrame": 934,
      "endFrame": 1025
    },
    {
      "id": "p3-2",
      "lineIndex": 2,
      "spoken": "틀 안에 겹친 바다 픽셀은 화면에 그리지 않아요.",
      "ko": "틀 안에 겹친 바다 픽셀은 화면에 그리지 않아요.",
      "en": "Ocean pixels inside that shape are not drawn.",
      "emphasis": {
        "text": "그리지 않아요",
        "role": "result"
      },
      "start": 17.3,
      "end": 20.216666666666665,
      "startFrame": 1038,
      "endFrame": 1213
    },
    {
      "id": "p4-1",
      "lineIndex": 3,
      "spoken": "이것이 물 표면 마스킹입니다.",
      "ko": "이것이 물 표면 마스킹입니다.",
