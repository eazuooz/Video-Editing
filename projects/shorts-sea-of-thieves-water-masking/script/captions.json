      "start": 20.416666666666668,
      "end": 22.5,
      "startFrame": 1225,
      "endFrame": 1350
    },
    {
      "id": "p4-2",
      "lineIndex": 3,
      "spoken": "마스크만 켰더니, 바깥 파도는 그대로인데",
      "ko": "마스크만 켰더니, 바깥 파도는 그대로인데",
