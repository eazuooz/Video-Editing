      "end": 25.383333333333333,
      "startFrame": 1364,
      "endFrame": 1523
    },
    {
      "id": "p4-2b",
      "lineIndex": 3,
      "spoken": "배 안의 바다는 사라졌죠.",
      "ko": "배 안의 바다는 사라졌죠.",
      "en": "but the ocean inside disappears.",
