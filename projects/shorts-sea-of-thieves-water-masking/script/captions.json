  "cues": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "바다는 이렇게 높은데,",
      "ko": "바다는 이렇게 높은데,",
      "en": "The waves are this high,",
      "start": 0.2,
      "end": 1.4,
      "startFrame": 12,
      "endFrame": 84
    },
    {
      "id": "p1-1b",
      "lineIndex": 0,
      "spoken": "선실 바닥은 보이죠.",
      "ko": "선실 바닥은 보이죠.",
      "en": "yet we can see the cabin floor.",
      "emphasis": {
        "text": "선실 바닥",
        "role": "result"
      },
      "start": 1.4,
      "end": 3.1,
      "startFrame": 84,
      "endFrame": 186
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "이 게임은 선실에 겹친 바다 표면을 숨깁니다.",
      "ko": "이 게임은 선실에 겹친 바다 표면을 숨깁니다.",
      "en": "This game hides ocean inside the cabin.",
      "emphasis": {
        "text": "바다 표면",
        "role": "term"
      },
      "start": 3.3833333333333333,
      "end": 6.6,
      "startFrame": 203,
      "endFrame": 396
    },
    {
      "id": "p2-1",
      "lineIndex": 1,
      "spoken": "원리를 단순한 배로 볼게요.",
      "ko": "원리를 단순한 배로 볼게요.",
      "en": "Let us see the principle with a simplified ship.",
      "start": 6.716666666666667,
      "end": 8.483333333333333,
      "startFrame": 403,
      "endFrame": 509
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "넓은 바다 면을 그대로 그리면,",
      "ko": "넓은 바다 면을 그대로 그리면,",
      "en": "Draw the whole ocean surface,",
      "start": 8.633333333333333,
      "end": 10.266666666666667,
      "startFrame": 518,
      "endFrame": 616
    },
    {
      "id": "p2-2b",
      "lineIndex": 1,
      "spoken": "선체를 뚫고 내부까지 들어옵니다.",
      "ko": "선체를 뚫고 내부까지 들어옵니다.",
      "en": "and it passes through the hull into the cabin.",
      "emphasis": {
        "text": "내부까지",
        "role": "problem"
      },
      "start": 10.266666666666667,
      "end": 12.816666666666666,
      "startFrame": 616,
      "endFrame": 769
    },
    {
      "id": "p3-1",
      "lineIndex": 2,
      "spoken": "그래서 배 안쪽에 맞춘 보이지 않는 틀,",
      "ko": "그래서 배 안쪽에 맞춘 보이지 않는 틀,",
