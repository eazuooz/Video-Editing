      "start": 13.0,
      "end": 15.566666666666666,
      "startFrame": 780,
      "endFrame": 934
    },
    {
      "id": "p3-1b",
      "lineIndex": 2,
      "spoken": "마스크 메시를 둡니다.",
      "ko": "마스크 메시를 둡니다.",
