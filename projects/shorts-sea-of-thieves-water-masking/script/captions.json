      "start": 27.216666666666665,
      "end": 29.433333333333334,
      "startFrame": 1633,
      "endFrame": 1766
    },
    {
      "id": "p5-2",
      "lineIndex": 4,
      "spoken": "이번엔 반대로,",
      "ko": "이번엔 반대로,",
