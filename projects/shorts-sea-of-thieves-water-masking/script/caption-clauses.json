{
  "clauses": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "바다는 이렇게 높은데,",
      "ko": "바다는 이렇게 높은데,",
      "en": "The waves are this high,"
    },
    {
      "id": "p1-1b",
      "lineIndex": 0,
      "spoken": "선실 바닥은 보이죠.",
      "ko": "선실 바닥은 보이죠.",
      "en": "yet we can see the cabin floor.",
      "emphasis": {
        "text": "선실 바닥",
        "role": "result"
      }
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "씨 오브 시브즈는 선실에 겹친 바다 표면을 숨깁니다.",
      "ko": "씨 오브 시브즈는 선실에 겹친 바다 표면을 숨깁니다.",
      "en": "Sea of Thieves hides the ocean surface where it crosses the cabin.",
      "emphasis": {
        "text": "바다 표면",
        "role": "term"
      }
    },
    {
      "id": "p2-1",
      "lineIndex": 1,
      "spoken": "원리를 단순한 배로 볼게요.",
      "ko": "원리를 단순한 배로 볼게요.",
      "en": "Let us see the principle with a simplified ship."
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "넓은 바다 면을 그대로 그리면,",
      "ko": "넓은 바다 면을 그대로 그리면,",
      "en": "Draw the whole ocean surface,"
    },
    {
      "id": "p2-2b",
      "lineIndex": 1,
      "spoken": "선체를 뚫고 내부까지 들어옵니다.",
      "ko": "선체를 뚫고 내부까지 들어옵니다.",
      "en": "and it passes through the hull into the cabin.",
      "emphasis": {
        "text": "내부까지",
        "role": "problem"
      }
    },
    {
      "id": "p3-1",
      "lineIndex": 2,
      "spoken": "그래서 배 안쪽에 맞춘 보이지 않는 틀,",
      "ko": "그래서 배 안쪽에 맞춘 보이지 않는 틀,",
      "en": "Add an invisible shape fitted to the inside:"
    },
    {
      "id": "p3-1b",
      "lineIndex": 2,
      "spoken": "마스크 메시를 둡니다.",
      "ko": "마스크 메시를 둡니다.",
      "en": "a mask mesh.",
      "emphasis": {
        "text": "마스크 메시",
        "role": "term"
      }
    },
    {
      "id": "p3-2",
      "lineIndex": 2,
      "spoken": "틀 안에 겹친 바다 픽셀은 화면에 그리지 않아요.",
      "ko": "틀 안에 겹친 바다 픽셀은 화면에 그리지 않아요.",
      "en": "Ocean pixels inside that shape are not drawn.",
      "emphasis": {
        "text": "그리지 않아요",
        "role": "result"
      }
    },
    {
      "id": "p4-1",
      "lineIndex": 3,
      "spoken": "이것이 물 표면 마스킹입니다.",
      "ko": "이것이 물 표면 마스킹입니다.",
      "en": "This is water masking.",
      "emphasis": {
        "text": "물 표면 마스킹",
        "role": "term"
      }
    },
    {
      "id": "p4-2",
      "lineIndex": 3,
      "spoken": "마스크만 켰더니, 바깥 파도는 그대로인데",
      "ko": "마스크만 켰더니, 바깥 파도는 그대로인데",
      "en": "Turn on only the mask; the outside waves stay the same,",
      "emphasis": {
        "text": "마스크만",
        "role": "result"
      }
    },
    {
      "id": "p4-2b",
      "lineIndex": 3,
      "spoken": "배 안의 바다는 사라졌죠.",
      "ko": "배 안의 바다는 사라졌죠.",
      "en": "but the ocean inside disappears."
    },
    {
      "id": "p5-1",
      "lineIndex": 4,
      "spoken": "그런데 침수된 물은 보여야 하잖아요.",
      "ko": "그런데 침수된 물은 보여야 하잖아요.",
      "en": "But we still need to show flooding water.",
      "emphasis": {
        "text": "침수된 물",
        "role": "term"
      }
    },
    {
      "id": "p5-2",
      "lineIndex": 4,
      "spoken": "이번엔 반대로,",
      "ko": "이번엔 반대로,",
      "en": "Now reverse the visible region:"
    },
    {
      "id": "p5-2b",
      "lineIndex": 4,
      "spoken": "틀 안에만 보이는 수면을 따로 두고",
      "ko": "틀 안에만 보이는 수면을 따로 두고",
      "en": "use a separate surface visible only inside,",
      "emphasis": {
        "text": "틀 안에만",
        "role": "result"
      }
    },
    {
      "id": "p5-2c",
      "lineIndex": 4,
      "spoken": "높이를 올립니다.",
      "ko": "높이를 올립니다.",
      "en": "then raise its level."
    },
    {
      "id": "p6-1",
      "lineIndex": 5,
      "spoken": "배 밖에는 거친 바다, 안에는 따로 차오르는 물.",
      "ko": "배 밖에는 거친 바다,\n안에는 따로 차오르는 물.",
      "en": "Rough ocean outside, separate rising water inside.",
      "emphasis": {
        "text": "따로",
        "role": "result"
      }
    },
    {
      "id": "p6-2",
      "lineIndex": 5,
      "spoken": "각 수면이 보일 영역을 나눠서,",
      "ko": "각 수면이 보일 영역을 나눠서,",
      "en": "Separate the visible region for each surface,",
      "emphasis": {
        "text": "영역",
        "role": "term"
      }
    },
    {
      "id": "p6-2b",
      "lineIndex": 5,
      "spoken": "바다와 침수를",
      "ko": "바다와 침수를",
      "en": "so ocean waves and flooding"
    },
    {
      "id": "p6-2c",
      "lineIndex": 5,
      "spoken": "함께 보여 주는 겁니다.",
      "ko": "함께 보여 주는 겁니다.",
      "en": "can appear together."
    }
  ],
