  "cues": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "스타크래프트 투 리플레이에선,",
      "ko": "스타크래프트 II 리플레이에선,",
      "en": "In a StarCraft II replay,",
      "start": 0.2,
      "end": 2.033333333333333,
      "startFrame": 12,
      "endFrame": 122
    },
    {
      "id": "p1-1b",
      "lineIndex": 0,
      "spoken": "지난 경기를 보면서 시점을 옮길 수 있죠.",
      "ko": "지난 경기를 보면서 시점을 옮길 수 있죠.",
      "en": "you can move the view around a past match.",
      "start": 2.033333333333333,
      "end": 4.716666666666667,
      "startFrame": 122,
      "endFrame": 283
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "사실 게임을 한 번 더 실행하고 있기 때문입니다.",
      "ko": "사실 게임을 한 번 더 실행하고 있기 때문입니다.",
      "en": "That is because the game is actually running again.",
      "start": 4.933333333333334,
      "end": 7.483333333333333,
      "startFrame": 296,
      "endFrame": 449
    },
    {
      "id": "p2-1",
      "lineIndex": 1,
      "spoken": "저장하는 핵심은 매 순간의 화면이 아니라,",
      "ko": "저장하는 핵심은 매 순간의 화면이 아니라,",
      "en": "The essential record is not every rendered frame,",
      "start": 7.666666666666667,
      "end": 10.016666666666667,
      "startFrame": 460,
      "endFrame": 601
    },
    {
      "id": "p2-1b",
      "lineIndex": 1,
      "spoken": "플레이어가 내린 명령입니다.",
      "ko": "플레이어가 내린 명령입니다.",
      "en": "but the commands given by players.",
      "start": 10.016666666666667,
      "end": 12.1,
      "startFrame": 601,
      "endFrame": 726
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "언제 이동하고, 누구를 공격했는지를 남기는 거죠.",
      "ko": "언제 이동하고, 누구를 공격했는지를 남기는 거죠.",
      "en": "It records timed moves and attack targets.",
      "start": 12.333333333333334,
      "end": 15.616666666666667,
      "startFrame": 740,
      "endFrame": 937
    },
    {
      "id": "p3-1",
      "lineIndex": 2,
      "spoken": "우리 예시에선",
      "ko": "우리 예시에선",
      "en": "In our example,",
      "start": 15.8,
      "end": 16.566666666666666,
      "startFrame": 948,
      "endFrame": 994
    },
    {
      "id": "p3-1b",
      "lineIndex": 2,
      "spoken": "이 초에 이동,",
      "ko": "2초에 이동,",
      "en": "move at two seconds,",
      "start": 16.566666666666666,
      "end": 17.766666666666666,
      "startFrame": 994,
      "endFrame": 1066
    },
    {
      "id": "p3-1c",
      "lineIndex": 2,
      "spoken": "사 초에 공격을 기록해 볼게요.",
      "ko": "4초에 공격을 기록해 볼게요.",
      "en": "and record an attack at four.",
      "start": 17.766666666666666,
      "end": 19.683333333333334,
      "startFrame": 1066,
      "endFrame": 1181
    },
    {
      "id": "p3-2",
      "lineIndex": 2,
      "spoken": "재생할 때 같은 순간에 같은 명령을 넣습니다.",
      "ko": "재생할 때 같은 순간에 같은 명령을 넣습니다.",
      "en": "Same commands, at the same times.",
      "start": 19.983333333333334,
      "end": 23.2,
      "startFrame": 1199,
      "endFrame": 1392
    },
    {
      "id": "p4-1",
      "lineIndex": 3,
      "spoken": "출발 상태와 규칙이 같으면,",
      "ko": "출발 상태와 규칙이 같으면,",
      "en": "With the same starting state and rules,",
      "start": 23.4,
      "end": 25.016666666666666,
      "startFrame": 1404,
      "endFrame": 1501
    },
    {
      "id": "p4-1b",
      "lineIndex": 3,
      "spoken": "움직임과 전투 결과도 다시 나옵니다.",
      "ko": "움직임과 전투 결과도 다시 나옵니다.",
      "en": "movement and combat results return.",
      "start": 25.016666666666666,
      "end": 27.633333333333333,
      "startFrame": 1501,
      "endFrame": 1658
    },
    {
      "id": "p4-2",
      "lineIndex": 3,
      "spoken": "같은 조건에서 같은 결과가 나오는",
      "ko": "같은 조건에서 같은 결과가 나오는",
      "en": "The same conditions give the same result:",
      "start": 27.633333333333333,
      "end": 29.566666666666666,
      "startFrame": 1658,
      "endFrame": 1774
    },
    {
      "id": "p4-2b",
      "lineIndex": 3,
      "spoken": "결정론적 시뮬레이션이죠.",
      "ko": "결정론적 시뮬레이션이죠.",
      "en": "deterministic simulation.",
      "start": 29.566666666666666,
      "end": 31.533333333333335,
      "startFrame": 1774,
      "endFrame": 1892
    },
    {
      "id": "p5-1",
      "lineIndex": 4,
      "spoken": "그런데 규칙이 패치로 바뀌었다면",
      "ko": "그런데 규칙이 패치로 바뀌었다면",
      "en": "But if a patch changes the rules,",
      "start": 31.783333333333335,
      "end": 33.68333333333333,
      "startFrame": 1907,
      "endFrame": 2021
    },
    {
      "id": "p5-1b",
      "lineIndex": 4,
      "spoken": "결과도 달라질 수 있겠죠.",
      "ko": "결과도 달라질 수 있겠죠.",
      "en": "the result could change too.",
      "start": 33.68333333333333,
      "end": 35.36666666666667,
      "startFrame": 2021,
      "endFrame": 2122
    },
    {
      "id": "p5-2",
      "lineIndex": 4,
      "spoken": "그래서 원래 맵과 게임 실행파일,",
      "ko": "그래서 원래 맵과 게임 실행파일,",
      "en": "So the original map, executable,",
      "start": 35.7,
      "end": 37.733333333333334,
      "startFrame": 2142,
      "endFrame": 2264
    },
    {
      "id": "p5-2b",
      "lineIndex": 4,
      "spoken": "데이터 버전을 맞춰야 합니다.",
      "ko": "데이터 버전을 맞춰야 합니다.",
      "en": "and game-data version must match.",
      "start": 37.733333333333334,
      "end": 39.63333333333333,
      "startFrame": 2264,
      "endFrame": 2378
    },
    {
      "id": "p6-1",
      "lineIndex": 5,
      "spoken": "무작위 계산의 출발값인 시드도 같아야 해요.",
      "ko": "무작위 계산의 출발값인 시드도 같아야 해요.",
      "en": "The random seed (starting value) must match.",
      "start": 39.8,
      "end": 42.68333333333333,
      "startFrame": 2388,
      "endFrame": 2561
    },
    {
      "id": "p6-2",
      "lineIndex": 5,
      "spoken": "이 조건을 맞추고 명령을 다시 실행해서,",
      "ko": "이 조건을 맞추고 명령을 다시 실행해서,",
      "en": "Match those conditions and replay the commands,",
      "start": 42.916666666666664,
      "end": 45.18333333333333,
      "startFrame": 2575,
      "endFrame": 2711
    },
    {
      "id": "p6-2b",
      "lineIndex": 5,
      "spoken": "지난 경기를 살아 있는 게임처럼 보는 겁니다.",
      "ko": "지난 경기를 살아 있는 게임처럼 보는 겁니다.",
      "en": "and the old match runs as a game again.",
      "start": 45.18333333333333,
      "end": 47.833333333333336,
      "startFrame": 2711,
      "endFrame": 2870
    }
  ]
}
