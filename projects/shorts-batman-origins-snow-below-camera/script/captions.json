      "start": 8.883333333333333,
      "end": 11.566666666666666,
      "startFrame": 533,
      "endFrame": 694
    },
    {
      "id": "p2-3",
      "lineIndex": 1,
      "spoken": "가까워도 멀어져도 크기는 같게 그립니다.",
      "ko": "가까워도 멀어져도 크기는 같게 그립니다.",
