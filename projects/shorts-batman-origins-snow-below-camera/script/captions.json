      "end": 4.533333333333333,
      "startFrame": 196,
      "endFrame": 272
    },
    {
      "id": "p1-2b",
      "lineIndex": 0,
      "spoken": "바닥 아래에서 찍어 기록합니다.",
      "ko": "바닥 아래에서 찍어 기록합니다.",
