      "startFrame": 12,
      "endFrame": 169
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "이 게임은 이 흔적을",
      "ko": "이 게임은 이 흔적을",
      "en": "This game records these marks",
