      },
      "start": 21.533333333333335,
      "end": 24.533333333333335,
      "startFrame": 1292,
      "endFrame": 1472
    },
    {
      "id": "p4-1",
      "lineIndex": 3,
      "spoken": "이 그림이 눈의 눌린 정도를 기록하는 높이맵입니다.",
