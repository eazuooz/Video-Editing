  "cues": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "배트맨이 눈밭을 지나가면 발자국이 남죠.",
      "ko": "배트맨이 눈밭을 지나가면 발자국이 남죠.",
