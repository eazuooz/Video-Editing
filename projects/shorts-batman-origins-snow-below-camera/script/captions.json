      "end": 7.366666666666666,
      "startFrame": 402,
      "endFrame": 442
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "눈 아래의 카메라가",
      "ko": "눈 아래의 카메라가",
      "en": "A camera below the snow",
      "start": 7.366666666666666,
      "end": 8.883333333333333,
      "startFrame": 442,
      "endFrame": 533
    },
    {
      "id": "p2-2b",
      "lineIndex": 1,
      "spoken": "발목 높이의 얇은 영역을 바라봐요.",
      "ko": "발목 높이의 얇은 영역을 바라봐요.",
