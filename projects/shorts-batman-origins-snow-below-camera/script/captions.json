      "end": 19.2,
      "startFrame": 1022,
      "endFrame": 1152
    },
    {
      "id": "p3-2",
      "lineIndex": 2,
      "spoken": "검은 바탕에 흰색으로 그립니다.",
      "ko": "검은 바탕에 흰색으로 그립니다.",
