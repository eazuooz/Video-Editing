      "end": 16.866666666666667,
      "startFrame": 872,
      "endFrame": 1012
    },
    {
      "id": "p3-1",
      "lineIndex": 2,
      "spoken": "이 영역에 들어온 발이나 몸을",
      "ko": "이 영역에 들어온 발이나 몸을",
