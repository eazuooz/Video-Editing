      "start": 24.566666666666666,
      "end": 28.1,
      "startFrame": 1474,
      "endFrame": 1686
    },
    {
      "id": "p4-2",
      "lineIndex": 3,
      "spoken": "누적을 끄면 발이 떠난 자국은 없어지고,",
      "ko": "누적을 끄면 발이 떠난 자국은 없어지고,",
