  "paragraphs": [
    {
      "id": "p001",
      "clauses": [
        [
          "마리오 육십사에는",
          "In Super Mario 64,"
        ],
        [
          "카메라를 든 캐릭터가 나옵니다.",
          "a character appears carrying a camera."
        ],
        [
          "이름은 쥬게무입니다.",
          "His name is Lakitu."
        ],
        [
          "마리오 조작과 카메라 조작은 서로 다릅니다.",
          "Mario and the camera have separate controls."
        ],
        [
          "가까이 살펴보고, 주위를 돌고,",
          "We will look closely, circle around,"
        ],
        [
          "멀리서 보는 순서로 살펴보겠습니다.",
          "and pull back, in that order."
        ]
      ]
    },
    {
      "id": "p002",
      "clauses": [
        [
          "카메라는 마리오를 따라가며 촬영합니다.",
          "The camera follows and films Mario."
        ],
        [
          "플레이어는 씨 버튼으로",
          "The player uses the C buttons"
        ],
        [
          "촬영 위치와 방향을 조절합니다.",
          "to adjust its position and direction."
        ],
        [
          "화면을 보는 자리가 바로 시점입니다.",
          "The viewpoint is where we see the scene from."
        ],
        [
          "이 시점도 직접 바꿀 수 있습니다.",
          "That viewpoint is also under player control."
        ]
      ]
    },
    {
      "id": "p003",
      "clauses": [
        [
          "주변이나 위쪽을 둘러보세요.",
          "Look around or upward."
        ],
        [
          "길과 파워스타를 찾는 데 도움이 됩니다.",
          "It can help you find routes and Power Stars."
        ],
        [
          "마리오가 서 있는 자리와",
          "Think about where Mario stands"
        ],
        [
          "카메라가 향하는 방향을 나눠 생각하면 쉽습니다.",
          "separately from what the camera points toward."
        ]
      ]
    },
    {
      "id": "p004",
      "clauses": [
        [
          "씨 위 버튼은 가까이 보는 시점입니다.",
          "C-up enters a close view."
        ],
        [
          "여기서는 스틱으로 주변을 둘러봅니다.",
          "The stick now looks around."
        ],
        [
          "에이, 비, 또는 씨 위를 제외한 씨 버튼으로",
          "Press A, B, or a C button other than C-up"
        ],
        [
          "이동 조작에 돌아옵니다.",
          "to return to movement control."
        ]
      ]
    },
    {
      "id": "p005",
      "clauses": [
        [
          "씨 버튼의 왼쪽과 오른쪽을 눌러 보세요.",
          "Press C-left or C-right."
        ],
        [
          "카메라가 마리오 주위를 돕니다.",
          "The camera circles Mario."
        ],
        [
          "같은 마리오를 다른 쪽에서 볼 수 있죠.",
          "See the same Mario from another side."
        ],
        [
          "더 돌릴 수 없는 곳에서는",
          "When the camera cannot go farther,"
        ],
        [
          "경고음이 한계를 알려 줍니다.",
          "a buzz signals its limit."
        ]
      ]
    },
    {
      "id": "p006",
      "clauses": [
        [
          "씨 버튼의 아래쪽을 누르면",
          "Press C-down"
        ],
        [
          "카메라가 뒤로 빠집니다.",
          "to pull the camera back."
        ],
        [
          "마리오는 작게 보입니다.",
          "Mario looks smaller."
        ],
        [
          "주변 공간은 더 넓게 들어옵니다.",
          "More surroundings fit in view."
        ],
        [
          "가까이 보기, 주위를 돌기, 멀리 보기.",
          "Look closely, circle around, and pull back."
        ],
        [
          "마리오 육십사에서는",
          "In Super Mario 64,"
        ],
        [
          "플레이어가 촬영자이기도 한 겁니다.",
          "the player is also the cinematographer."
        ]
      ]
    }
  ],
