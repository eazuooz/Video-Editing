      }
    },
    {
      "id": "u005",
      "paragraph": "p002",
      "ko": "이런 검사를 레이캐스트라고 합니다.",
      "sourceRaw": {
        "path": "D:\\Github\\VideoEditing\\shared\\output\\original-tech-twelve-20261115\\shorts-spiderman-swing-anchor\\voice-sentence-v2\\chunks\\u005-scene.wav",
        "sha256": "6a1078b5286e240561219db76dc61e2d7bd6c4a51048d0ca8b5f4174fe2a3266",
