      }
    },
    {
      "id": "u007",
      "paragraph": "p002",
      "ko": "선을 늘리는 것만으로는 다루기 어려웠습니다.",
      "sourceRaw": {
        "path": "D:\\Github\\VideoEditing\\shared\\output\\original-tech-twelve-20261115\\shorts-spiderman-swing-anchor\\voice-sentence-v2\\chunks\\u007-scene.wav",
        "sha256": "7ba3c27ce9ffaf917b8a6b9dbd5a981410ce1cb4890d3c90f4d965c168f5870d",
