  "cues": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "이 스타크래프트 다리, 대각선으로 놓여 있죠.",
      "ko": "이 스타크래프트 다리, 대각선으로 놓여 있죠.",
      "en": "This StarCraft bridge lies diagonally.",
      "start": 0.2,
      "end": 3.1166666666666667,
      "startFrame": 12,
      "endFrame": 187
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "그런데 유닛이 지나갈 길은",
      "ko": "그런데 유닛이 지나갈 길은",
      "en": "But the route units could take",
      "start": 3.3,
      "end": 4.816666666666666,
      "startFrame": 198,
      "endFrame": 289
    },
    {
      "id": "p1-2b",
      "lineIndex": 0,
      "spoken": "네모난 격자로 계산했습니다.",
      "ko": "네모난 격자로 계산했습니다.",
      "en": "was calculated using a square grid.",
      "start": 4.816666666666666,
      "end": 6.716666666666667,
      "startFrame": 289,
      "endFrame": 403
    },
    {
      "id": "p2-1",
      "lineIndex": 1,
      "spoken": "예전 엔진은 지형을",
      "ko": "예전 엔진은 지형을",
      "en": "The older engine divided terrain",
      "start": 6.916666666666667,
      "end": 8.216666666666667,
      "startFrame": 415,
      "endFrame": 493
    },
    {
      "id": "p2-1b",
      "lineIndex": 1,
      "spoken": "가로 세로 삼십이 픽셀짜리 칸으로 나눴습니다.",
      "ko": "32 × 32픽셀 칸으로 나눴습니다.",
      "en": "into 32-by-32-pixel tiles.",
      "start": 8.216666666666667,
      "end": 11.2,
      "startFrame": 493,
      "endFrame": 672
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "칸마다 지나갈 수 있는지 정하는 방식이었죠.",
      "ko": "칸마다 지나갈 수 있는지 정하는 방식이었죠.",
      "en": "Each tile was marked passable or blocked.",
      "start": 11.483333333333333,
      "end": 14.3,
      "startFrame": 689,
      "endFrame": 858
    },
    {
      "id": "p3-1",
      "lineIndex": 2,
      "spoken": "스타크래프트에서 그림은",
      "ko": "스타크래프트에서 그림은",
      "en": "In StarCraft, the artwork",
      "start": 14.416666666666666,
      "end": 15.666666666666666,
      "startFrame": 865,
      "endFrame": 940
    },
    {
      "id": "p3-1b",
      "lineIndex": 2,
      "spoken": "비스듬한 시점으로 바뀌었지만,",
      "ko": "비스듬한 시점으로 바뀌었지만,",
      "en": "changed to a tilted perspective,",
      "start": 15.666666666666666,
      "end": 17.216666666666665,
      "startFrame": 940,
      "endFrame": 1033
    },
    {
      "id": "p3-2",
      "lineIndex": 2,
      "spoken": "바탕의 네모 격자는 남았습니다.",
      "ko": "바탕의 네모 격자는 남았습니다.",
      "en": "but the underlying square grid remained.",
      "start": 17.666666666666668,
      "end": 19.833333333333332,
      "startFrame": 1060,
      "endFrame": 1190
    },
    {
      "id": "p3-3",
      "lineIndex": 2,
      "spoken": "대각선 가장자리가 칸을 어중간하게 잘라 버리죠.",
      "ko": "대각선 가장자리가 칸을 어중간하게 잘라 버리죠.",
      "en": "Diagonals cut across square cells.",
      "start": 20.1,
      "end": 23.216666666666665,
      "startFrame": 1206,
      "endFrame": 1393
    },
    {
      "id": "p4-1",
      "lineIndex": 3,
      "spoken": "그래서 길찾기 칸을",
      "ko": "그래서 길찾기 칸을",
      "en": "So the pathfinding cells",
      "start": 23.4,
      "end": 24.8,
      "startFrame": 1404,
      "endFrame": 1488
    },
    {
      "id": "p4-1b",
      "lineIndex": 3,
      "spoken": "가로 세로 팔 픽셀로 더 잘게 나눴습니다.",
      "ko": "8 × 8픽셀로 더 잘게 나눴습니다.",
      "en": "were divided into smaller eight-by-eight-pixel cells.",
      "start": 24.8,
      "end": 27.9,
      "startFrame": 1488,
      "endFrame": 1674
    },
    {
      "id": "p4-2",
      "lineIndex": 3,
      "spoken": "같은 넓이에 가로 네 칸, 세로 네 칸.",
      "ko": "같은 넓이에 가로 4칸, 세로 4칸.",
      "en": "Now: four cells across and four down.",
      "start": 27.9,
      "end": 30.983333333333334,
      "startFrame": 1674,
      "endFrame": 1859
    },
    {
      "id": "p4-3",
      "lineIndex": 3,
      "spoken": "한 칸이 열여섯 칸이 된 겁니다.",
      "ko": "한 칸이 16칸이 된 겁니다.",
      "en": "One tile becomes sixteen cells.",
      "start": 30.983333333333334,
      "end": 32.833333333333336,
      "startFrame": 1859,
      "endFrame": 1970
    },
    {
      "id": "p5-1",
      "lineIndex": 4,
      "spoken": "우리 그림에서도 칸을 줄이자,",
      "ko": "우리 그림에서도 칸을 줄이자,",
      "en": "In our diagram, making the cells smaller",
      "start": 33.11666666666667,
      "end": 34.8,
      "startFrame": 1987,
      "endFrame": 2088
    },
    {
      "id": "p5-1b",
      "lineIndex": 4,
      "spoken": "통과 가능한 경계가 다리를 더 촘촘히 따라가죠.",
      "ko": "통과 가능한 경계가 다리를 더 촘촘히 따라가죠.",
      "en": "fits the walkable edge to the bridge.",
      "start": 34.8,
      "end": 38.1,
      "startFrame": 2088,
      "endFrame": 2286
    },
    {
      "id": "p5-2",
      "lineIndex": 4,
      "spoken": "대신 찾아야 할 칸이 늘어나,",
      "ko": "대신 찾아야 할 칸이 늘어나,",
      "en": "But the number of cells to search increases,",
      "start": 38.28333333333333,
      "end": 40.016666666666666,
      "startFrame": 2297,
      "endFrame": 2401
    },
    {
      "id": "p5-2b",
      "lineIndex": 4,
      "spoken": "길찾기 계산 부담도 커졌습니다.",
      "ko": "길찾기 계산 부담도 커졌습니다.",
      "en": "which adds pathfinding work.",
      "start": 40.016666666666666,
      "end": 42.4,
      "startFrame": 2401,
      "endFrame": 2544
    },
    {
      "id": "p6-1",
      "lineIndex": 5,
      "spoken": "매끈해 보이는 대각선 다리 아래에는,",
      "ko": "매끈해 보이는 대각선 다리 아래에는,",
      "en": "Under the smooth-looking diagonal bridge,",
      "start": 42.61666666666667,
      "end": 44.6,
      "startFrame": 2557,
      "endFrame": 2676
    },
    {
      "id": "p6-1b",
      "lineIndex": 5,
      "spoken": "계단 모양의 통행 지도가 숨어 있던 거예요.",
      "ko": "계단 모양의 통행 지도가 숨어 있던 거예요.",
      "en": "hid a stair-shaped passability map.",
      "start": 44.6,
      "end": 47.38333333333333,
      "startFrame": 2676,
      "endFrame": 2843
    },
    {
      "id": "p6-2",
      "lineIndex": 5,
      "spoken": "보이는 그림과,",
      "ko": "보이는 그림과,",
      "en": "The visible artwork",
      "start": 47.56666666666667,
      "end": 48.28333333333333,
      "startFrame": 2854,
      "endFrame": 2897
    },
    {
      "id": "p6-2b",
      "lineIndex": 5,
      "spoken": "게임이 길을 판단하는 지도는 달랐습니다.",
      "ko": "게임이 길을 판단하는 지도는 달랐습니다.",
      "en": "differed from the map used to judge movement.",
      "start": 48.28333333333333,
      "end": 50.71666666666667,
