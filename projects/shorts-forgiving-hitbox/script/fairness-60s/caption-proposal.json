  "textPolicy": {
    "ko": "Exact narration wording, punctuation preserved where practical; only line breaks added. Concatenation is verified after removing whitespace and punctuation.",
    "en": "Meaning-preserving English; clauses may carry grammar into the next cue.",
    "uiNotice": "표시는 설명용 is a separate visual UI notice; it is not added to the narration or subtitles."
  },
  "cues": [
    {
      "id": "01",
      "lineIndex": 0,
      "ko": "분명 닿았는데,",
      "en": "It clearly touched you,"
    },
    {
      "id": "02",
      "lineIndex": 0,
      "ko": "왜 안 맞았죠?",
      "en": "so why didn't it hit?"
    },
    {
      "id": "03",
      "lineIndex": 1,
      "ko": "공격한 쪽은",
      "en": "The attacker thinks:"
    },
    {
      "id": "04",
      "lineIndex": 1,
      "ko": "왜 안 맞아?",
      "en": "Why didn't that hit?"
    },
    {
      "id": "05",
      "lineIndex": 1,
      "ko": "살아남은 쪽은\n잘 피했다!",
      "en": "The survivor thinks:\nNice dodge!"
    },
    {
      "id": "06",
      "lineIndex": 2,
      "ko": "같은 판정도,",
      "en": "The same hit decision"
    },
    {
      "id": "07",
      "lineIndex": 2,
      "ko": "공정하다는 느낌은\n달라질 수 있어요.",
      "en": "can feel more or less fair."
    },
    {
      "id": "08",
      "lineIndex": 3,
      "ko": "그래서 보이는 몸보다",
      "en": "So some games make"
    },
    {
      "id": "09",
      "lineIndex": 3,
      "ko": "피격 영역을 작게\n잡기도 합니다.",
      "en": "the Hurtbox smaller\nthan the visible body."
    },
    {
      "id": "10",
      "lineIndex": 4,
      "ko": "초록색은 피해를 받는 영역,",
      "en": "Green is the area\nthat receives damage:"
    },
    {
      "id": "11",
      "lineIndex": 4,
      "ko": "허트박스예요.",
      "en": "the Hurtbox."
    },
    {
      "id": "12",
      "lineIndex": 5,
      "ko": "빨간 공격 영역,\n히트박스와",
      "en": "The red attack area,\nthe Hitbox,"
    },
    {
      "id": "13",
      "lineIndex": 5,
      "ko": "겹쳐야 체력이 줄죠.",
      "en": "must overlap it\nto reduce health."
    },
    {
      "id": "14",
      "lineIndex": 6,
      "ko": "셀레스트도 공개 코드에서",
      "en": "Celeste's public code"
    },
    {
      "id": "15",
      "lineIndex": 6,
      "ko": "이동용 충돌 영역보다\n피격 영역의 높이가 작아요.",
      "en": "uses a shorter Hurtbox\nthan its movement collider."
    },
    {
      "id": "16",
      "lineIndex": 7,
      "ko": "같은 공격으로\n비교해 볼게요.",
      "en": "Let's compare\nwith the same attack."
    },
    {
      "id": "17",
      "lineIndex": 8,
      "ko": "몸만큼 넓히면 맞고,",
      "en": "Make it body-wide:\nthe attack hits."
    },
    {
      "id": "18",
      "lineIndex": 8,
      "ko": "조금 줄이면 빗나갑니다.",
      "en": "Shrink it a little:\nthe attack misses."
    },
    {
      "id": "19",
      "lineIndex": 9,
      "ko": "겉모습은 그대로고,",
      "en": "The visible body\nstays the same."
    },
    {
      "id": "20",
      "lineIndex": 9,
      "ko": "피격 영역만 바꾼 겁니다.",
      "en": "Only the Hurtbox changed."
    },
    {
      "id": "21",
      "lineIndex": 10,
      "ko": "하지만 무조건 작게 만든다고",
      "en": "But making it smaller"
    },
    {
      "id": "22",
      "lineIndex": 10,
      "ko": "좋은 건 아닙니다.",
      "en": "isn't always better."
    },
    {
      "id": "23",
      "lineIndex": 11,
      "ko": "너무 줄이면",
      "en": "Shrink it too far,"
    },
    {
      "id": "24",
      "lineIndex": 11,
      "ko": "맞아 보이는 공격까지\n무시해서",
      "en": "and even visible hits\nmay be ignored."
    },
    {
      "id": "25",
      "lineIndex": 11,
      "ko": "어색해지겠죠.",
      "en": "That can look strange."
    },
    {
      "id": "26",
      "lineIndex": 12,
      "ko": "핵심은 피했다고\n느낄 수 있는",
      "en": "The point is to leave"
    },
    {
      "id": "27",
      "lineIndex": 12,
      "ko": "작은 여유예요.",
      "en": "a little room\nto feel you dodged."
    },
    {
      "id": "28",
      "lineIndex": 13,
      "ko": "아까 살아남은 이유도,",
      "en": "You survived earlier"
    },
    {
      "id": "29",
      "lineIndex": 13,
      "ko": "보이는 몸이 아니라\n이 두 영역으로",
      "en": "because these two areas,\nnot the visible body,"
    },
    {
      "id": "30",
      "lineIndex": 13,
      "ko": "판정했기 때문입니다.",
      "en": "determined the result."
    }
  ]
}
