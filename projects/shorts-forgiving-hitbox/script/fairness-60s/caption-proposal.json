  "sourceNarration": "script/fairness-60s/narration.ko.json",
  "lineIndexBase": 0,
  "layout": {
    "font": "Malgun Gothic Bold",
    "fontSizeNative": 60,
    "maximumNativeLineWidthPx": 796,
    "maximumLines": 2,
    "nativeCanvas": [
      1080,
      1920
    ],
    "mobileReferenceWidthPx": 375
