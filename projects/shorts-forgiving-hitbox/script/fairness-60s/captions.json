  "cues": [
    {
      "id": "01",
      "lineIndex": 0,
      "ko": "분명 닿았는데,",
      "en": "It clearly touched you,",
      "start": 0.2,
      "end": 1.0166666666666666,
      "startFrame": 12,
      "endFrame": 61
    },
    {
      "id": "02",
      "lineIndex": 0,
      "ko": "왜 안 맞았죠?",
      "en": "so why didn't it hit?",
      "start": 1.0166666666666666,
      "end": 2.3666666666666667,
      "startFrame": 61,
      "endFrame": 142
    },
    {
      "id": "03",
      "lineIndex": 1,
      "ko": "공격한 쪽은",
      "en": "The attacker thinks:",
      "start": 3.033333333333333,
      "end": 3.8833333333333333,
      "startFrame": 182,
      "endFrame": 233
    },
    {
      "id": "04",
      "lineIndex": 1,
      "ko": "왜 안 맞아?",
      "en": "Why didn't that hit?",
      "start": 3.8833333333333333,
      "end": 4.783333333333333,
      "startFrame": 233,
      "endFrame": 287
    },
    {
      "id": "05",
      "lineIndex": 1,
      "ko": "살아남은 쪽은\n잘 피했다!",
      "en": "The survivor thinks:\nNice dodge!",
      "start": 4.966666666666667,
      "end": 6.683333333333334,
      "startFrame": 298,
      "endFrame": 401
    },
    {
      "id": "06",
      "lineIndex": 2,
      "ko": "같은 판정도,",
      "en": "The same hit decision",
      "start": 6.866666666666666,
      "end": 7.716666666666667,
      "startFrame": 412,
      "endFrame": 463
    },
    {
      "id": "07",
      "lineIndex": 2,
      "ko": "공정하다는 느낌은\n달라질 수 있어요.",
      "en": "can feel more or less fair.",
      "start": 7.716666666666667,
      "end": 10.066666666666666,
      "startFrame": 463,
      "endFrame": 604
    },
    {
      "id": "08",
      "lineIndex": 3,
      "ko": "그래서 보이는 몸보다",
      "en": "So some games make",
      "start": 10.383333333333333,
      "end": 11.5,
      "startFrame": 623,
      "endFrame": 690
    },
    {
      "id": "09",
      "lineIndex": 3,
      "ko": "피격 영역을 작게\n잡기도 합니다.",
      "en": "the Hurtbox smaller\nthan the visible body.",
      "start": 11.5,
      "end": 13.966666666666667,
      "startFrame": 690,
      "endFrame": 838
    },
    {
      "id": "10",
      "lineIndex": 4,
      "ko": "초록색은 피해를 받는 영역,",
      "en": "Green is the area\nthat receives damage:",
      "start": 14.433333333333334,
      "end": 16.116666666666667,
      "startFrame": 866,
      "endFrame": 967
    },
    {
      "id": "11",
      "lineIndex": 4,
      "ko": "허트박스예요.",
      "en": "the Hurtbox.",
      "start": 16.116666666666667,
      "end": 16.9,
      "startFrame": 967,
      "endFrame": 1014
    },
    {
      "id": "12",
      "lineIndex": 5,
      "ko": "빨간 공격 영역,\n히트박스와",
      "en": "The red attack area,\nthe Hitbox,",
      "start": 17.066666666666666,
      "end": 19.0,
      "startFrame": 1024,
      "endFrame": 1140
    },
    {
      "id": "13",
      "lineIndex": 5,
      "ko": "겹쳐야 체력이 줄죠.",
      "en": "must overlap it\nto reduce health.",
      "start": 19.0,
      "end": 20.6,
      "startFrame": 1140,
      "endFrame": 1236
    },
    {
      "id": "14",
      "lineIndex": 6,
      "ko": "셀레스트도 공개 코드에서",
      "en": "Celeste's public code",
      "start": 20.833333333333332,
      "end": 22.233333333333334,
      "startFrame": 1250,
      "endFrame": 1334
    },
    {
      "id": "15",
      "lineIndex": 6,
      "ko": "이동용 충돌 영역보다\n피격 영역의 높이가 작아요.",
      "en": "uses a shorter Hurtbox\nthan its movement collider.",
      "start": 22.233333333333334,
      "end": 25.566666666666666,
      "startFrame": 1334,
      "endFrame": 1534
    },
    {
      "lineIndex": 7,
      "ko": "가로는 여덟 픽셀로 같고,",
      "en": "Both are 8 pixels wide.",
      "id": "16",
      "start": 25.816666666666666,
      "end": 27.533333333333335,
      "startFrame": 1549,
      "endFrame": 1652
    },
    {
      "lineIndex": 7,
      "ko": "세로만 열한 픽셀에서",
      "en": "The height goes from 11",
      "id": "17",
      "start": 27.533333333333335,
      "end": 29.283333333333335,
      "startFrame": 1652,
      "endFrame": 1757
    },
    {
      "lineIndex": 7,
      "ko": "아홉 픽셀로 짧아집니다.",
      "en": "down to 9 pixels.",
      "id": "18",
      "start": 29.283333333333335,
      "end": 30.983333333333334,
      "startFrame": 1757,
      "endFrame": 1859
    },
    {
      "lineIndex": 7,
      "ko": "아래쪽 두 픽셀 차이예요.",
      "en": "A 2-pixel difference\nat the bottom.",
      "id": "19",
      "start": 31.183333333333334,
      "end": 32.833333333333336,
      "startFrame": 1871,
      "endFrame": 1970
    },
    {
      "id": "20",
      "lineIndex": 8,
      "ko": "같은 공격으로\n비교해 볼게요.",
      "en": "Let's compare\nwith the same attack.",
      "start": 33.03333333333333,
      "end": 34.71666666666667,
      "startFrame": 1982,
      "endFrame": 2083
    },
    {
      "id": "21",
      "lineIndex": 9,
      "ko": "몸만큼 넓히면 맞고,",
      "en": "Make it body-wide:\nthe attack hits.",
      "start": 35.46666666666667,
      "end": 36.86666666666667,
      "startFrame": 2128,
      "endFrame": 2212
    },
    {
      "id": "22",
      "lineIndex": 9,
      "ko": "조금 줄이면 빗나갑니다.",
      "en": "Shrink it a little:\nthe attack misses.",
      "start": 36.86666666666667,
      "end": 38.6,
      "startFrame": 2212,
      "endFrame": 2316
    },
    {
      "id": "23",
      "lineIndex": 10,
      "ko": "겉모습은 그대로고,",
      "en": "The visible body\nstays the same.",
      "start": 39.166666666666664,
      "end": 40.28333333333333,
      "startFrame": 2350,
      "endFrame": 2417
    },
    {
      "id": "24",
      "lineIndex": 10,
      "ko": "피격 영역만 바꾼 겁니다.",
      "en": "Only the Hurtbox changed.",
      "start": 40.28333333333333,
      "end": 41.916666666666664,
      "startFrame": 2417,
      "endFrame": 2515
    },
    {
      "id": "25",
      "lineIndex": 11,
      "ko": "하지만 무조건 작게 만든다고",
      "en": "But making it smaller",
      "start": 42.416666666666664,
      "end": 44.03333333333333,
      "startFrame": 2545,
      "endFrame": 2642
    },
    {
      "id": "26",
      "lineIndex": 11,
      "ko": "좋은 건 아닙니다.",
      "en": "isn't always better.",
      "start": 44.03333333333333,
      "end": 44.916666666666664,
      "startFrame": 2642,
      "endFrame": 2695
    },
    {
      "id": "27",
      "lineIndex": 12,
      "ko": "너무 줄이면",
      "en": "Shrink it too far,",
      "start": 45.166666666666664,
      "end": 45.86666666666667,
      "startFrame": 2710,
      "endFrame": 2752
    },
    {
      "id": "28",
      "lineIndex": 12,
      "ko": "맞아 보이는 공격까지\n무시해서",
      "en": "and even visible hits\nmay be ignored.",
      "start": 45.86666666666667,
      "end": 47.583333333333336,
      "startFrame": 2752,
      "endFrame": 2855
    },
    {
      "id": "29",
      "lineIndex": 12,
      "ko": "어색해지겠죠.",
      "en": "That can look strange.",
      "start": 47.583333333333336,
      "end": 48.46666666666667,
      "startFrame": 2855,
      "endFrame": 2908
    },
    {
      "id": "30",
      "lineIndex": 13,
      "ko": "핵심은 피했다고\n느낄 수 있는",
      "en": "The point is to leave",
      "start": 48.9,
      "end": 50.46666666666667,
      "startFrame": 2934,
      "endFrame": 3028
    },
    {
      "id": "31",
      "lineIndex": 13,
      "ko": "작은 여유예요.",
      "en": "a little room\nto feel you dodged.",
      "start": 50.46666666666667,
      "end": 51.416666666666664,
      "startFrame": 3028,
      "endFrame": 3085
    },
    {
      "id": "32",
      "lineIndex": 14,
      "ko": "아까 살아남은 이유도,",
      "en": "You survived earlier",
      "start": 55.0,
      "end": 56.233333333333334,
      "startFrame": 3300,
      "endFrame": 3374
    },
    {
      "id": "33",
      "lineIndex": 14,
      "ko": "보이는 몸이 아니라\n이 두 영역으로",
      "en": "because these two areas,\nnot the visible body,",
      "start": 56.233333333333334,
      "end": 58.36666666666667,
      "startFrame": 3374,
      "endFrame": 3502
    },
    {
      "id": "34",
      "lineIndex": 14,
      "ko": "판정했기 때문입니다.",
      "en": "determined the result.",
      "start": 58.36666666666667,
      "end": 59.516666666666666,
      "startFrame": 3502,
      "endFrame": 3571
    }
