      }
    },
    {
      "id": "u002",
      "paragraph": "p001",
      "ko": "길은 비워 두고, 지역에 맞는 식물은 풍성해야 하죠.",
      "sourceRaw": {
        "path": "D:\\Github\\VideoEditing\\shared\\output\\original-tech-twelve-20261115\\shorts-horizon-gpu-placement\\voice-sentence-v2\\chunks\\u002-scene.wav",
        "sha256": "b34b51ab1c537a73be00452502bee21d366a035a3f5f55007e6f5d2665ee86da",
