        "pcmSHA256": "b58afd68b4c6b3ada2af9e4d2916449266edfb5e0d0457531ffe08e5b1e1c370"
      }
    },
    {
      "id": "u003",
      "paragraph": "p001",
      "ko": "개발진은 아티스트가 정한 데이터와 규칙을 그래픽 처리 장치인 지피유에서 배치로 바꾸었습니다.",
      "sourceRaw": {
        "path": "D:\\Github\\VideoEditing\\shared\\output\\original-tech-twelve-20261115\\shorts-horizon-gpu-placement\\voice-sentence-v2\\chunks\\u003-scene.wav",
        "sha256": "5c68cca9cb2f8b743c3214d43f589c5000e169ba4137cc3f928501a3aa910d90",
