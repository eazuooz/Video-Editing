; Independent game-mechanics reconstruction. No recovered original assets/code.
config_version=5

[application]
config/name="Neon Chamber — Yamyam Experiment"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="Original art and implementation, informed by observed rule evidence."

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.018,0.025,0.035,1)

[audio]
driver/enable_input=false

[debug]
movie_writer/fps=60
movie_writer/mjpeg_quality=0.92
