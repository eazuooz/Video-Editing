  "cues": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "고스트 오브 쓰시마의 이 낙엽들.",
      "ko": "고스트 오브 쓰시마의 이 낙엽들.",
      "en": "These leaves in Ghost of Tsushima",
      "start": 0.2,
      "end": 2.5,
      "startFrame": 12,
      "endFrame": 150
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "개발 중에는 모닥불에 떨어져도",
      "ko": "개발 중에는 모닥불에 떨어져도",
      "en": "had a bug during development:",
      "start": 2.5,
      "end": 4.366666666666666,
      "startFrame": 150,
      "endFrame": 262
    },
    {
      "id": "p1-3",
      "lineIndex": 0,
      "spoken": "타지 않는 문제가 있었습니다.",
      "ko": "타지 않는 문제가 있었습니다.",
      "en": "they could fall into campfires without burning.",
      "start": 4.366666666666666,
      "end": 6.033333333333333,
      "startFrame": 262,
      "endFrame": 362
    },
    {
      "id": "p2-1",
      "lineIndex": 1,
      "spoken": "불 속에 멀쩡한 낙엽이 남으면",
      "ko": "불 속에 멀쩡한 낙엽이 남으면",
      "en": "Intact leaves sitting in a fire",
      "start": 6.266666666666667,
      "end": 8.2,
      "startFrame": 376,
      "endFrame": 492
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "아무래도 이상하죠.",
      "ko": "아무래도 이상하죠.",
      "en": "look strange.",
      "start": 8.2,
      "end": 9.733333333333333,
      "startFrame": 492,
      "endFrame": 584
    },
    {
      "id": "p2-3",
      "lineIndex": 1,
      "spoken": "개발자는 의외의 방법으로 고쳤습니다.",
      "ko": "개발자는 의외의 방법으로 고쳤습니다.",
      "en": "The fix was surprisingly simple.",
      "start": 9.733333333333333,
      "end": 12.316666666666666,
      "startFrame": 584,
      "endFrame": 739
    },
    {
      "id": "p3-1",
      "lineIndex": 2,
      "spoken": "불에 바람을 넣은 겁니다.",
      "ko": "불에 바람을 넣은 겁니다.",
      "en": "They added wind to the fire:",
      "start": 12.566666666666666,
      "end": 14.316666666666666,
      "startFrame": 754,
      "endFrame": 859
    },
    {
      "id": "p3-2",
      "lineIndex": 2,
      "spoken": "위로 부는 바람을 만드는",
      "ko": "위로 부는 바람을 만드는",
      "en": "a wind emitter",
      "start": 14.316666666666666,
      "end": 15.666666666666666,
      "startFrame": 859,
      "endFrame": 940
    },
    {
      "id": "p3-3",
      "lineIndex": 2,
      "spoken": "윈드 이미터를 배치했어요.",
      "ko": "윈드 이미터를 배치했어요.",
      "en": "pushing air upward.",
      "start": 15.666666666666666,
      "end": 17.4,
      "startFrame": 940,
      "endFrame": 1044
    },
    {
      "id": "p4-1",
      "lineIndex": 3,
      "spoken": "우리 시연에서도",
      "ko": "우리 시연에서도",
      "en": "In our reconstruction,",
      "start": 17.6,
      "end": 18.283333333333335,
      "startFrame": 1056,
      "endFrame": 1097
    },
    {
      "id": "p4-2",
      "lineIndex": 3,
      "spoken": "바람을 끄면 낙엽이 그대로 내려갑니다.",
      "ko": "바람을 끄면 낙엽이 그대로 내려갑니다.",
      "en": "leaves fall straight down with the wind off.",
      "start": 18.283333333333335,
      "end": 20.483333333333334,
      "startFrame": 1097,
      "endFrame": 1229
    },
    {
      "id": "p4-3",
      "lineIndex": 3,
      "spoken": "이제 불 위의 바람만 켜 볼게요.",
      "ko": "이제 불 위의 바람만 켜 볼게요.",
      "en": "Now turn on just the updraft above the fire.",
      "start": 20.483333333333334,
      "end": 22.716666666666665,
      "startFrame": 1229,
      "endFrame": 1363
    },
    {
      "id": "p5-1",
      "lineIndex": 4,
      "spoken": "같은 낙엽이 불 위에 다가가면,",
      "ko": "같은 낙엽이 불 위에 다가가면,",
      "en": "The same leaves approach the fire,",
      "start": 22.966666666666665,
      "end": 24.766666666666666,
      "startFrame": 1378,
      "endFrame": 1486
    },
    {
      "id": "p5-2",
      "lineIndex": 4,
      "spoken": "상승하는 바람에 반응해서",
      "ko": "상승하는 바람에 반응해서",
      "en": "react to the upward wind",
      "start": 24.766666666666666,
      "end": 26.433333333333334,
      "startFrame": 1486,
      "endFrame": 1586
    },
    {
      "id": "p5-3",
      "lineIndex": 4,
      "spoken": "위로 밀려나죠.",
      "ko": "위로 밀려나죠.",
      "en": "and are pushed away.",
      "start": 26.433333333333334,
      "end": 27.683333333333334,
      "startFrame": 1586,
      "endFrame": 1661
    },
    {
      "id": "p6-1",
      "lineIndex": 5,
      "spoken": "쓰시마에서도 이 상승기류로",
      "ko": "쓰시마에서도 이 상승기류로",
      "en": "In Tsushima, the updraft",
      "emphasis": {
        "text": "상승기류",
        "role": "term"
      },
      "start": 27.683333333333334,
      "end": 29.683333333333334,
      "startFrame": 1661,
      "endFrame": 1781
    },
    {
      "id": "p6-2",
      "lineIndex": 5,
      "spoken": "대부분의 낙엽이 불에 들어가는 걸 막았습니다.",
      "ko": "대부분의 낙엽이 불에 들어가는 걸 막았습니다.",
      "en": "kept most leaves out of the fire.",
      "start": 29.683333333333334,
      "end": 32.28333333333333,
      "startFrame": 1781,
      "endFrame": 1937
    },
    {
      "id": "p6-3",
      "lineIndex": 5,
      "spoken": "불에 반응하는 작은 디테일까지 생겼고요.",
      "ko": "불에 반응하는 작은 디테일까지 생겼고요.",
      "en": "It added a convincing little interaction too.",
      "start": 32.7,
      "end": 34.8,
      "startFrame": 1962,
      "endFrame": 2088
    },
    {
      "id": "p7-1",
      "lineIndex": 6,
      "spoken": "낙엽을 태우는 복잡한 기능 대신,",
      "ko": "낙엽을 태우는 복잡한 기능 대신,",
      "en": "Instead of adding a burning simulation,",
      "start": 35.11666666666667,
      "end": 37.18333333333333,
      "startFrame": 2107,
      "endFrame": 2231
    },
    {
      "id": "p7-2",
      "lineIndex": 6,
      "spoken": "불에 들어가는 상황부터 줄인 겁니다.",
      "ko": "불에 들어가는 상황부터 줄인 겁니다.",
      "en": "they reduced the situation causing the bug.",
      "start": 37.18333333333333,
      "end": 39.13333333333333,
      "startFrame": 2231,
      "endFrame": 2348
    },
    {
      "id": "p7-3",
      "lineIndex": 6,
      "spoken": "문제의 원인을 바꾸는 것도 게임 개발의 기술이죠.",
      "ko": "문제의 원인을 바꾸는 것도 게임 개발의 기술이죠.",
      "en": "Changing the conditions can solve the problem.",
      "start": 39.56666666666667,
      "end": 42.333333333333336,
      "startFrame": 2374,
      "endFrame": 2540
    }
  ]
}
