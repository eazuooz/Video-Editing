    {
      "id": "c05",
      "lineIndex": 3,
      "spoken": "피해와 쓰러짐 같은 사건으로",
      "ko": "피해와 쓰러짐 같은\n사건으로",
      "en": "uses damage and\nincapacitation events"
    },
    {
      "id": "c06",
      "lineIndex": 3,
      "spoken": "팀의 긴장도를 추정하거든요.",
      "ko": "팀의 긴장도를\n추정하거든요.",
      "en": "to estimate\nteam intensity."
    },
    {
      "id": "c07",
      "lineIndex": 4,
      "spoken": "격전 뒤엔 새 무리의 등장을 억제해",
