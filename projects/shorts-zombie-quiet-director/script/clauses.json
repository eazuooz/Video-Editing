{
  "clauses": [
    {
      "id": "intro-a",
      "lineIndex": 0,
      "spoken": "게임에서는 몬스터와의 전투 빈도를",
      "ko": "게임에서는 몬스터와의\n전투 빈도를",
      "en": "Some games control\nhow often you fight,",
      "start": 0.15,
      "end": 2.45,
      "startFrame": 9,
      "endFrame": 147
    },
    {
      "id": "intro-b",
      "lineIndex": 0,
      "spoken": "의도적으로 조절하기도 합니다.",
      "ko": "의도적으로\n조절하기도 합니다.",
      "en": "deliberately.",
      "start": 2.45,
      "end": 4.233333333333333,
      "startFrame": 147,
      "endFrame": 254
    },
    {
      "id": "c01",
      "lineIndex": 1,
      "spoken": "좀비가 뚝 끊겼다고, 안심했죠?",
      "ko": "좀비가 뚝 끊겼다고,\n안심했죠?",
      "en": "The zombies stopped.\nDid you relax?"
    },
    {
      "id": "c02",
      "lineIndex": 2,
      "spoken": "레프트 포 데드에선",
      "ko": "레프트 포 데드에선",
      "en": "In Left 4 Dead,"
    },
    {
      "id": "c03",
      "lineIndex": 2,
      "spoken": "게임이 쉬는 시간을 만든 걸 수 있어요.",
      "ko": "게임이 쉬는 시간을\n만든 걸 수 있어요.",
      "en": "the game may have\ncreated a breather."
