  "cues": [
    {
      "id": "c01",
      "lineIndex": 0,
      "spoken": "좀비가 뚝 끊겼다고, 안심했죠?",
      "ko": "좀비가 뚝 끊겼다고,\n안심했죠?",
      "en": "The zombies stopped.\nDid you relax?",
      "start": 0.2,
      "end": 2.533333333333333,
      "startFrame": 12,
      "endFrame": 152
    },
    {
      "id": "c02",
      "lineIndex": 1,
      "spoken": "레프트 포 데드에선",
      "ko": "레프트 포 데드에선",
      "en": "In Left 4 Dead,",
      "start": 2.8666666666666667,
      "end": 4.066666666666666,
      "startFrame": 172,
      "endFrame": 244
    },
    {
      "id": "c03",
      "lineIndex": 1,
      "spoken": "게임이 쉬는 시간을 만든 걸 수 있어요.",
      "ko": "게임이 쉬는 시간을\n만든 걸 수 있어요.",
      "en": "the game may have\ncreated a breather.",
      "start": 4.066666666666666,
      "end": 6.2,
      "startFrame": 244,
      "endFrame": 372
    },
    {
      "id": "c04",
      "lineIndex": 2,
      "spoken": "에이아이 디렉터가",
      "ko": "AI 디렉터가",
      "en": "The AI Director",
      "start": 6.733333333333333,
      "end": 7.633333333333334,
      "startFrame": 404,
      "endFrame": 458
    },
    {
      "id": "c05",
      "lineIndex": 2,
      "spoken": "피해와 쓰러짐 같은 사건으로",
      "ko": "피해와 쓰러짐 같은\n사건으로",
      "en": "uses damage and\nincapacitation events",
      "start": 7.633333333333334,
      "end": 9.266666666666667,
      "startFrame": 458,
      "endFrame": 556
    },
    {
      "id": "c06",
      "lineIndex": 2,
      "spoken": "팀의 긴장도를 추정하거든요.",
      "ko": "팀의 긴장도를\n추정하거든요.",
      "en": "to estimate\nteam intensity.",
      "start": 9.266666666666667,
      "end": 11.116666666666667,
      "startFrame": 556,
      "endFrame": 667
    },
    {
      "id": "c07",
      "lineIndex": 3,
      "spoken": "격전 뒤엔 새 무리의 등장을 억제해",
      "ko": "격전 뒤엔 새 무리의\n등장을 억제해",
      "en": "After intense combat,\nit suppresses new hordes",
      "start": 11.383333333333333,
      "end": 13.716666666666667,
      "startFrame": 683,
      "endFrame": 823
    },
    {
      "id": "c08",
      "lineIndex": 3,
      "spoken": "숨 돌릴 틈을 만듭니다.",
      "ko": "숨 돌릴 틈을 만듭니다.",
      "en": "to make room to breathe.",
      "start": 13.716666666666667,
      "end": 15.133333333333333,
      "startFrame": 823,
      "endFrame": 908
    },
    {
      "id": "c09",
      "lineIndex": 4,
      "spoken": "적을 약하게 만드는 대신,",
      "ko": "적을 약하게 만드는 대신,",
      "en": "Instead of weakening enemies,",
      "start": 15.566666666666666,
      "end": 16.933333333333334,
      "startFrame": 934,
      "endFrame": 1016
    },
    {
      "id": "c10",
      "lineIndex": 4,
      "spoken": "싸움과 휴식의 리듬,",
      "ko": "싸움과 휴식의 리듬,",
      "en": "it adjusts the rhythm\nof combat and rest:",
      "start": 16.933333333333334,
      "end": 18.6,
      "startFrame": 1016,
      "endFrame": 1116
    },
    {
      "id": "c11",
      "lineIndex": 4,
      "spoken": "페이싱을 조절하는 거죠.",
      "ko": "페이싱을 조절하는 거죠.",
      "en": "pacing.",
      "start": 18.6,
      "end": 20.166666666666668,
      "startFrame": 1116,
      "endFrame": 1210
    },
    {
      "id": "c12",
      "lineIndex": 5,
      "spoken": "물론 남아 있는 적은 공격하고,",
      "ko": "물론 남아 있는 적은\n공격하고,",
      "en": "Enemies already there\ncan still attack,",
      "start": 20.633333333333333,
      "end": 22.3,
      "startFrame": 1238,
      "endFrame": 1338
    },
    {
      "id": "c13",
      "lineIndex": 5,
      "spoken": "보스는 예외예요.",
      "ko": "보스는 예외예요.",
      "en": "and bosses are an exception.",
      "start": 22.3,
      "end": 23.6,
      "startFrame": 1338,
      "endFrame": 1416
    },
    {
      "id": "c14",
      "lineIndex": 6,
      "spoken": "그런데 프로젝트 좀보이드의 정적은",
      "ko": "그런데 프로젝트 좀보이드의\n정적은",
      "en": "But silence in\nProject Zomboid",
      "start": 23.783333333333335,
      "end": 25.633333333333333,
      "startFrame": 1427,
      "endFrame": 1538
    },
    {
      "id": "c15",
      "lineIndex": 6,
      "spoken": "같은 휴식 신호가 아닙니다.",
      "ko": "같은 휴식 신호가\n아닙니다.",
      "en": "is not the same\nrest signal.",
      "start": 25.633333333333333,
      "end": 27.266666666666666,
      "startFrame": 1538,
      "endFrame": 1636
    },
    {
      "id": "c16",
      "lineIndex": 7,
      "spoken": "먼 총성 같은 메타 이벤트가",
      "ko": "먼 총성 같은\n메타 이벤트가",
      "en": "Meta events, such as\ndistant gunshots,",
      "start": 27.266666666666666,
      "end": 29.3,
      "startFrame": 1636,
      "endFrame": 1758
    },
    {
      "id": "c17",
      "lineIndex": 7,
      "spoken": "기존 좀비들을",
      "ko": "기존 좀비들을",
      "en": "can draw existing zombies",
      "start": 29.3,
      "end": 30.183333333333334,
      "startFrame": 1758,
      "endFrame": 1811
    },
    {
      "id": "c18",
      "lineIndex": 7,
      "spoken": "소리 쪽으로 움직일 수 있죠.",
      "ko": "소리 쪽으로\n움직일 수 있죠.",
      "en": "toward the sound.",
      "start": 30.183333333333334,
      "end": 31.583333333333332,
      "startFrame": 1811,
      "endFrame": 1895
    },
    {
      "id": "c19",
      "lineIndex": 8,
      "spoken": "그래서 조용한 길도",
      "ko": "그래서 조용한 길도",
      "en": "So even a quiet road",
      "start": 32.0,
      "end": 32.983333333333334,
      "startFrame": 1920,
      "endFrame": 1979
    },
    {
      "id": "c20",
      "lineIndex": 8,
      "spoken": "주변 무리가 이동하면",
      "ko": "주변 무리가 이동하면",
      "en": "can become dangerous again",
      "start": 32.983333333333334,
      "end": 34.11666666666667,
      "startFrame": 1979,
      "endFrame": 2047
    },
    {
      "id": "c21",
      "lineIndex": 8,
      "spoken": "다시 위험해질 수 있어요.",
      "ko": "다시 위험해질 수 있어요.",
      "en": "as nearby groups move.",
      "start": 34.11666666666667,
      "end": 35.516666666666666,
      "startFrame": 2047,
      "endFrame": 2131
    },
    {
      "id": "c22",
      "lineIndex": 9,
      "spoken": "레포데에선 다음 공격의 박자를,",
      "ko": "레포데에선\n다음 공격의 박자를,",
      "en": "In Left 4 Dead, watch\nthe next attack’s rhythm;",
      "start": 35.9,
      "end": 37.666666666666664,
      "startFrame": 2154,
      "endFrame": 2260
    },
    {
      "id": "c23",
      "lineIndex": 9,
      "spoken": "좀보이드에선 주변 무리의",
      "ko": "좀보이드에선 주변 무리의",
      "en": "in Zomboid, watch",
      "start": 37.666666666666664,
      "end": 39.483333333333334,
      "startFrame": 2260,
      "endFrame": 2369
    },
    {
      "id": "c24",
      "lineIndex": 9,
      "spoken": "이동을 보는 겁니다.",
      "ko": "이동을 보는 겁니다.",
      "en": "the movement around you.",
      "start": 39.483333333333334,
      "end": 40.38333333333333,
      "startFrame": 2369,
      "endFrame": 2423
    },
    {
      "id": "c25",
      "lineIndex": 10,
      "spoken": "좀비가 안 보이는 지금도,",
      "ko": "좀비가 안 보이는 지금도,",
      "en": "No zombies in sight",
      "start": 40.766666666666666,
      "end": 42.0,
      "startFrame": 2446,
      "endFrame": 2520
    },
    {
      "id": "c26",
      "lineIndex": 10,
      "spoken": "안전을 보장하진 않아요.",
      "ko": "안전을 보장하진 않아요.",
      "en": "does not guarantee safety.",
      "start": 42.0,
