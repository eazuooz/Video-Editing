  "cues": [
    {
      "id": "intro-a",
      "lineIndex": 0,
      "spoken": "게임에서는 몬스터와의 전투 빈도를",
      "ko": "게임에서는 몬스터와의\n전투 빈도를",
      "en": "Some games control\nhow often you fight,",
      "start": 0.15,
      "end": 2.45,
      "startFrame": 9,
      "endFrame": 147
    },
    {
      "id": "intro-b",
      "lineIndex": 0,
      "spoken": "의도적으로 조절하기도 합니다.",
      "ko": "의도적으로\n조절하기도 합니다.",
      "en": "deliberately.",
      "start": 2.45,
      "end": 4.233333333333333,
      "startFrame": 147,
      "endFrame": 254
    },
    {
      "id": "c01",
      "lineIndex": 1,
      "spoken": "좀비가 뚝 끊겼다고, 안심했죠?",
      "ko": "좀비가 뚝 끊겼다고,\n안심했죠?",
      "en": "The zombies stopped.\nDid you relax?",
      "start": 4.816666666666666,
      "end": 7.15,
      "startFrame": 289,
      "endFrame": 429
    },
    {
      "id": "c02",
      "lineIndex": 2,
      "spoken": "레프트 포 데드에선",
      "ko": "레프트 포 데드에선",
      "en": "In Left 4 Dead,",
      "start": 7.483333333333333,
      "end": 8.683333333333334,
      "startFrame": 449,
      "endFrame": 521
    },
    {
      "id": "c03",
      "lineIndex": 2,
      "spoken": "게임이 쉬는 시간을 만든 걸 수 있어요.",
      "ko": "게임이 쉬는 시간을\n만든 걸 수 있어요.",
      "en": "the game may have\ncreated a breather.",
      "start": 8.683333333333334,
      "end": 10.816666666666666,
      "startFrame": 521,
      "endFrame": 649
    },
    {
      "id": "c04",
      "lineIndex": 3,
      "spoken": "에이아이 디렉터가",
      "ko": "AI 디렉터가",
      "en": "The AI Director",
      "start": 11.35,
      "end": 12.25,
      "startFrame": 681,
      "endFrame": 735
    },
    {
      "id": "c05",
      "lineIndex": 3,
      "spoken": "피해와 쓰러짐 같은 사건으로",
      "ko": "피해와 쓰러짐 같은\n사건으로",
      "en": "uses damage and\nincapacitation events",
      "start": 12.25,
      "end": 13.883333333333333,
      "startFrame": 735,
      "endFrame": 833
    },
    {
      "id": "c06",
      "lineIndex": 3,
      "spoken": "팀의 긴장도를 추정하거든요.",
      "ko": "팀의 긴장도를\n추정하거든요.",
      "en": "to estimate\nteam intensity.",
      "start": 13.883333333333333,
      "end": 15.733333333333333,
      "startFrame": 833,
      "endFrame": 944
    },
    {
      "id": "c07",
      "lineIndex": 4,
      "spoken": "격전 뒤엔 새 무리의 등장을 억제해",
      "ko": "격전 뒤엔 새 무리의\n등장을 억제해",
      "en": "After intense combat,\nit suppresses new hordes",
      "start": 16.0,
      "end": 18.333333333333332,
      "startFrame": 960,
      "endFrame": 1100
    },
    {
      "id": "c08",
      "lineIndex": 4,
      "spoken": "숨 돌릴 틈을 만듭니다.",
      "ko": "숨 돌릴 틈을 만듭니다.",
      "en": "to make room to breathe.",
      "start": 18.333333333333332,
      "end": 19.75,
      "startFrame": 1100,
      "endFrame": 1185
    },
    {
      "id": "c09",
      "lineIndex": 5,
      "spoken": "적을 약하게 만드는 대신,",
      "ko": "적을 약하게 만드는 대신,",
      "en": "Instead of weakening enemies,",
      "start": 20.183333333333334,
      "end": 21.55,
      "startFrame": 1211,
      "endFrame": 1293
    },
    {
      "id": "c10",
      "lineIndex": 5,
      "spoken": "싸움과 휴식의 리듬,",
      "ko": "싸움과 휴식의 리듬,",
      "en": "it adjusts the rhythm\nof combat and rest:",
      "start": 21.55,
      "end": 23.216666666666665,
      "startFrame": 1293,
      "endFrame": 1393
    },
    {
      "id": "c11",
      "lineIndex": 5,
      "spoken": "페이싱을 조절하는 거죠.",
      "ko": "페이싱을 조절하는 거죠.",
      "en": "pacing.",
      "start": 23.216666666666665,
      "end": 24.783333333333335,
      "startFrame": 1393,
      "endFrame": 1487
    },
    {
      "id": "c12",
      "lineIndex": 6,
      "spoken": "물론 남아 있는 적은 공격하고,",
      "ko": "물론 남아 있는 적은\n공격하고,",
      "en": "Enemies already there\ncan still attack,",
      "start": 25.25,
      "end": 26.916666666666668,
      "startFrame": 1515,
      "endFrame": 1615
    },
    {
      "id": "c13",
      "lineIndex": 6,
      "spoken": "보스는 예외예요.",
      "ko": "보스는 예외예요.",
      "en": "and bosses are an exception.",
      "start": 26.916666666666668,
      "end": 28.216666666666665,
      "startFrame": 1615,
      "endFrame": 1693
    },
    {
      "id": "c14",
      "lineIndex": 7,
      "spoken": "그런데 프로젝트 좀보이드의 정적은",
      "ko": "그런데 프로젝트 좀보이드의\n정적은",
      "en": "But silence in\nProject Zomboid",
      "start": 28.4,
      "end": 30.25,
      "startFrame": 1704,
      "endFrame": 1815
    },
    {
      "id": "c15",
      "lineIndex": 7,
      "spoken": "같은 휴식 신호가 아닙니다.",
      "ko": "같은 휴식 신호가\n아닙니다.",
      "en": "is not the same\nrest signal.",
      "start": 30.25,
      "end": 31.883333333333333,
      "startFrame": 1815,
      "endFrame": 1913
    },
    {
      "id": "c16",
      "lineIndex": 8,
      "spoken": "먼 총성 같은 메타 이벤트가",
      "ko": "먼 총성 같은\n메타 이벤트가",
      "en": "Meta events, such as\ndistant gunshots,",
      "start": 31.883333333333333,
      "end": 33.916666666666664,
      "startFrame": 1913,
      "endFrame": 2035
    },
    {
      "id": "c17",
      "lineIndex": 8,
      "spoken": "기존 좀비들을",
      "ko": "기존 좀비들을",
      "en": "can draw existing zombies",
      "start": 33.916666666666664,
      "end": 34.8,
      "startFrame": 2035,
      "endFrame": 2088
    },
    {
      "id": "c18",
      "lineIndex": 8,
      "spoken": "소리 쪽으로 움직일 수 있죠.",
      "ko": "소리 쪽으로\n움직일 수 있죠.",
      "en": "toward the sound.",
      "start": 34.8,
      "end": 36.2,
      "startFrame": 2088,
      "endFrame": 2172
    },
    {
      "id": "c19",
      "lineIndex": 9,
      "spoken": "그래서 조용한 길도",
      "ko": "그래서 조용한 길도",
      "en": "So even a quiet road",
      "start": 36.61666666666667,
      "end": 37.6,
      "startFrame": 2197,
      "endFrame": 2256
    },
    {
      "id": "c20",
      "lineIndex": 9,
      "spoken": "주변 무리가 이동하면",
      "ko": "주변 무리가 이동하면",
      "en": "can become dangerous again",
      "start": 37.6,
      "end": 38.733333333333334,
      "startFrame": 2256,
      "endFrame": 2324
    },
    {
      "id": "c21",
      "lineIndex": 9,
      "spoken": "다시 위험해질 수 있어요.",
      "ko": "다시 위험해질 수 있어요.",
      "en": "as nearby groups move.",
      "start": 38.733333333333334,
      "end": 40.13333333333333,
      "startFrame": 2324,
      "endFrame": 2408
    },
    {
      "id": "c22",
      "lineIndex": 10,
      "spoken": "레포데에선 다음 공격의 박자를,",
      "ko": "레포데에선\n다음 공격의 박자를,",
      "en": "In Left 4 Dead, watch\nthe next attack’s rhythm;",
      "start": 40.516666666666666,
      "end": 42.28333333333333,
      "startFrame": 2431,
      "endFrame": 2537
    },
    {
      "id": "c23",
      "lineIndex": 10,
      "spoken": "좀보이드에선 주변 무리의",
      "ko": "좀보이드에선 주변 무리의",
      "en": "in Zomboid, watch",
      "start": 42.28333333333333,
      "end": 44.1,
      "startFrame": 2537,
      "endFrame": 2646
    },
    {
      "id": "c24",
      "lineIndex": 10,
      "spoken": "이동을 보는 겁니다.",
      "ko": "이동을 보는 겁니다.",
      "en": "the movement around you.",
      "start": 44.1,
      "end": 45.0,
      "startFrame": 2646,
      "endFrame": 2700
    },
    {
      "id": "c25",
      "lineIndex": 11,
      "spoken": "좀비가 안 보이는 지금도,",
      "ko": "좀비가 안 보이는 지금도,",
      "en": "No zombies in sight",
      "start": 45.38333333333333,
      "end": 46.61666666666667,
      "startFrame": 2723,
      "endFrame": 2797
    },
    {
      "id": "c26",
      "lineIndex": 11,
      "spoken": "안전을 보장하진 않아요.",
      "ko": "안전을 보장하진 않아요.",
      "en": "does not guarantee safety.",
      "start": 46.61666666666667,
      "end": 48.15,
      "startFrame": 2797,
      "endFrame": 2889
    }
