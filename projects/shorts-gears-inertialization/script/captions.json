  "cues": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "달리다가 멈추는 캐릭터.",
      "ko": "달리다가 멈추는 캐릭터.",
      "en": "A character stops running.",
      "start": 0.2,
      "end": 1.5833333333333333,
      "startFrame": 12,
      "endFrame": 95
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "동작을 바로 바꾸면",
      "ko": "동작을 바로 바꾸면",
      "en": "Switch animations instantly,",
      "start": 1.5833333333333333,
      "end": 3.066666666666667,
      "startFrame": 95,
      "endFrame": 184
    },
    {
      "id": "p1-3",
      "lineIndex": 0,
      "spoken": "자세가 툭 튀기 쉽습니다.",
      "ko": "자세가 툭 튀기 쉽습니다.",
      "en": "and the pose can snap.",
      "start": 3.066666666666667,
      "end": 5.016666666666667,
      "startFrame": 184,
      "endFrame": 301
    },
    {
      "id": "p2-1",
      "lineIndex": 1,
      "spoken": "기어스 오브 워 포에 쓰인 관성화는",
      "ko": "기어스 오브 워 4에 쓰인 관성화는",
      "en": "Inertialization, used in Gears of War 4,",
      "emphasis": {
        "text": "관성화",
        "role": "term"
      },
      "start": 5.216666666666667,
      "end": 7.066666666666666,
      "startFrame": 313,
      "endFrame": 424
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "새 동작으로 먼저 바꾼 뒤,",
      "ko": "새 동작으로 먼저 바꾼 뒤,",
      "en": "switches to the new motion first,",
      "start": 7.066666666666666,
      "end": 8.916666666666666,
      "startFrame": 424,
      "endFrame": 535
    },
    {
      "id": "p2-3",
      "lineIndex": 1,
      "spoken": "튀는 차이를 부드럽게 없애요.",
      "ko": "튀는 차이를 부드럽게 없애요.",
      "en": "then smoothly removes the discontinuity.",
      "start": 9.3,
      "end": 11.166666666666666,
      "startFrame": 558,
      "endFrame": 670
    },
    {
      "id": "p3-1",
      "lineIndex": 2,
      "spoken": "가령 팔의 목표 각도가 이십 도인데,",
      "ko": "가령 팔의 목표 각도가 이십 도인데,",
      "en": "Suppose the target arm angle is 20 degrees",
      "start": 11.266666666666667,
      "end": 13.466666666666667,
      "startFrame": 676,
      "endFrame": 808
    },
    {
      "id": "p3-2",
      "lineIndex": 2,
      "spoken": "방금 전 팔은 오십 도였다면,",
      "ko": "방금 전 팔은 오십 도였다면,",
      "en": "but the previous angle was 50.",
      "start": 13.866666666666667,
      "end": 15.4,
      "startFrame": 832,
      "endFrame": 924
    },
    {
      "id": "p3-3",
      "lineIndex": 2,
      "spoken": "삼십 도의 차이를 기억합니다.",
      "ko": "삼십 도의 차이를 기억합니다.",
      "en": "Keep the 30-degree difference.",
      "start": 15.4,
      "end": 17.2,
      "startFrame": 924,
      "endFrame": 1032
    },
    {
      "id": "p4-1",
      "lineIndex": 3,
      "spoken": "새 동작에 이 차이를 더하고,",
      "ko": "새 동작에 이 차이를 더하고,",
      "en": "Add that offset to the new motion,",
      "start": 17.383333333333333,
      "end": 18.9,
      "startFrame": 1043,
      "endFrame": 1134
    },
    {
      "id": "p4-2",
      "lineIndex": 3,
      "spoken": "시간이 지나며 영으로 줄입니다.",
      "ko": "시간이 지나며 영으로 줄입니다.",
      "en": "then reduce it to zero over time.",
      "start": 18.9,
      "end": 21.1,
      "startFrame": 1134,
      "endFrame": 1266
    },
    {
      "id": "p4-3",
      "lineIndex": 3,
      "spoken": "그러면 오십 도에서 끊김 없이 이어지죠.",
      "ko": "그러면 오십 도에서 끊김 없이 이어지죠.",
      "en": "The arm continues smoothly from 50°.",
      "start": 21.333333333333332,
      "end": 23.7,
      "startFrame": 1280,
      "endFrame": 1422
    },
    {
      "id": "p5-1",
      "lineIndex": 4,
      "spoken": "자세만 맞추는 게 아닙니다.",
      "ko": "자세만 맞추는 게 아닙니다.",
      "en": "It also keeps track",
      "start": 23.9,
      "end": 25.4,
      "startFrame": 1434,
      "endFrame": 1524
    },
    {
      "id": "p5-2",
      "lineIndex": 4,
      "spoken": "직전에 움직이던 속도도 반영해서",
      "ko": "직전에 움직이던 속도도 반영해서",
      "en": "of the preceding motion’s velocity",
      "start": 25.583333333333332,
      "end": 27.5,
      "startFrame": 1535,
      "endFrame": 1650
    },
    {
      "id": "p5-3",
      "lineIndex": 4,
      "spoken": "갑자기 꺾이는 느낌을 줄여요.",
      "ko": "갑자기 꺾이는 느낌을 줄여요.",
      "en": "to reduce abrupt changes in movement.",
      "start": 27.5,
      "end": 29.683333333333334,
      "startFrame": 1650,
      "endFrame": 1781
    },
    {
      "id": "p6-1",
      "lineIndex": 5,
      "spoken": "보통은 전환 중에 두 동작을 계속 계산하지만,",
      "ko": "보통은 전환 중에 두 동작을 계속 계산하지만,",
      "en": "A conventional blend evaluates both motions.",
      "start": 29.683333333333334,
      "end": 32.333333333333336,
      "startFrame": 1781,
      "endFrame": 1940
    },
    {
      "id": "p6-2",
      "lineIndex": 5,
      "spoken": "관성화는 새 동작과 남은 차이를 계산합니다.",
      "ko": "관성화는 새 동작과 남은 차이를 계산합니다.",
      "en": "Inertialization evaluates the target and residual offset.",
      "emphasis": {
        "text": "관성화",
        "role": "term"
      },
      "start": 32.333333333333336,
      "end": 35.4,
      "startFrame": 1940,
      "endFrame": 2124
    },
    {
      "id": "p6-3",
      "lineIndex": 5,
      "spoken": "이전 동작 전체를 계속 재생할 필요가 줄어들죠.",
      "ko": "이전 동작 전체를 계속 재생할 필요가 줄어들죠.",
      "en": "Stop evaluating the old motion.",
      "start": 35.5,
      "end": 38.21666666666667,
      "startFrame": 2130,
      "endFrame": 2293
    },
    {
      "id": "p7-1",
      "lineIndex": 6,
      "spoken": "관성화, 이너셜라이제이션.",
      "ko": "관성화, 이너셜라이제이션.",
      "en": "Inertialization",
      "emphasis": {
        "text": "관성화",
        "role": "term"
      },
      "start": 38.38333333333333,
      "end": 40.43333333333333,
      "startFrame": 2303,
      "endFrame": 2426
    },
    {
      "id": "p7-2",
      "lineIndex": 6,
      "spoken": "움직임의 연결감은 남기고,",
      "ko": "움직임의 연결감은 남기고,",
      "en": "preserves continuity of motion",
      "start": 40.43333333333333,
      "end": 42.28333333333333,
      "startFrame": 2426,
      "endFrame": 2537
    },
    {
      "id": "p7-3",
      "lineIndex": 6,
      "spoken": "이전 동작을 계산하는 비용을 아끼는 겁니다.",
      "ko": "이전 동작을 계산하는 비용을 아끼는 겁니다.",
      "en": "and saves old-motion evaluation.",
      "start": 42.28333333333333,
      "end": 45.28333333333333,
      "startFrame": 2537,
      "endFrame": 2717
    }
  ]
