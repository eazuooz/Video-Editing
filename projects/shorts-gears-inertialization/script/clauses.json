      "lineIndex": 0,
      "spoken": "달리다가 멈추는 캐릭터.",
      "ko": "달리다가 멈추는 캐릭터.",
      "en": "A character stops running."
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "동작을 바로 바꾸면",
      "ko": "동작을 바로 바꾸면",
      "en": "Switch animations instantly,"
    },
    {
