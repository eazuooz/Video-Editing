  "cues": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "이 배에는 빛과 그림자가 보이죠.",
      "ko": "이 배에는 빛과 그림자가 보이죠.",
      "en": "You can see light and shadow on this ship.",
      "start": 0.2,
      "end": 2.533333333333333,
      "startFrame": 12,
      "endFrame": 152
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "그런데 화면을 이루는 색은 단 두 가지입니다.",
      "ko": "그런데 화면을 이루는 색은 단 두 가지입니다.",
      "en": "Yet the final image uses just two colors.",
      "start": 2.7333333333333334,
      "end": 5.183333333333334,
      "startFrame": 164,
      "endFrame": 311
    },
    {
      "id": "p2-1",
      "lineIndex": 1,
      "spoken": "오브라 딘은,",
      "ko": "오브라 딘 호의 귀환은,",
      "en": "Return of the Obra Dinn",
      "start": 5.4,
      "end": 6.133333333333334,
      "startFrame": 324,
      "endFrame": 368
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "밝고 어두운 점을 섞어서 중간 밝기를 표현합니다.",
      "ko": "밝고 어두운 점을 섞어서 중간 밝기를 표현합니다.",
      "en": "mixes light and dark dots to suggest shades.",
      "start": 6.133333333333334,
      "end": 9.533333333333333,
      "startFrame": 368,
      "endFrame": 572
    },
    {
      "id": "p2-3",
      "lineIndex": 1,
      "spoken": "이 기법을 디더링이라고 해요.",
      "ko": "이 기법을 디더링이라고 해요.",
      "en": "This technique is called dithering.",
      "start": 9.733333333333333,
      "end": 11.383333333333333,
      "startFrame": 584,
      "endFrame": 683
    },
    {
      "id": "p3-1",
      "lineIndex": 2,
      "spoken": "우리 예시에서 열여섯 칸 중",
      "ko": "우리 예시에서 열여섯 칸 중",
      "en": "In our example, out of sixteen cells,",
      "start": 11.6,
      "end": 13.116666666666667,
      "startFrame": 696,
      "endFrame": 787
    },
    {
      "id": "p3-2",
      "lineIndex": 2,
      "spoken": "네 칸만 밝히면 어둡게,",
      "ko": "네 칸만 밝히면 어둡게,",
      "en": "lighting only four makes the patch look dark.",
      "start": 13.116666666666667,
      "end": 14.766666666666667,
      "startFrame": 787,
      "endFrame": 886
    },
    {
      "id": "p3-3",
      "lineIndex": 2,
      "spoken": "열두 칸을 밝히면 더 밝게 느껴집니다.",
      "ko": "열두 칸을 밝히면 더 밝게 느껴집니다.",
      "en": "Lighting twelve makes it appear brighter.",
      "start": 14.766666666666667,
      "end": 17.133333333333333,
      "startFrame": 886,
      "endFrame": 1028
    },
    {
      "id": "p3-4",
      "lineIndex": 2,
      "spoken": "새 색 대신, 밝은 점의 비율이 바뀐 거죠.",
      "ko": "새 색 대신, 밝은 점의 비율이 바뀐 거죠.",
      "en": "More light dots, not more colors.",
      "start": 17.416666666666668,
      "end": 20.133333333333333,
      "startFrame": 1045,
      "endFrame": 1208
    },
    {
      "id": "p4-1",
      "lineIndex": 3,
      "spoken": "이 점들을 작게 모으면,",
      "ko": "이 점들을 작게 모으면,",
      "en": "With tiny dots packed together,",
      "start": 20.2,
      "end": 21.616666666666667,
      "startFrame": 1212,
      "endFrame": 1297
    },
    {
      "id": "p4-2",
      "lineIndex": 3,
      "spoken": "멀리서는 부드러운 명암처럼 보입니다.",
      "ko": "멀리서는 부드러운 명암처럼 보입니다.",
      "en": "the eye perceives smoother shading from a distance.",
      "start": 21.616666666666667,
      "end": 24.016666666666666,
      "startFrame": 1297,
      "endFrame": 1441
    },
    {
      "id": "p4-3",
      "lineIndex": 3,
      "spoken": "한 픽셀은 둘 중 하나의 색만 고르면 돼요.",
      "ko": "한 픽셀은 둘 중 하나의 색만 고르면 돼요.",
      "en": "Each pixel still chooses only one of the two colors.",
      "start": 24.2,
      "end": 26.866666666666667,
      "startFrame": 1452,
      "endFrame": 1612
    },
    {
      "id": "p5-1",
      "lineIndex": 4,
      "spoken": "하지만 카메라가 움직일 때",
      "ko": "하지만 카메라가 움직일 때",
      "en": "But as the camera moves,",
      "start": 26.866666666666667,
      "end": 28.366666666666667,
      "startFrame": 1612,
      "endFrame": 1702
    },
    {
      "id": "p5-2",
      "lineIndex": 4,
      "spoken": "작은 점들이 흔들리면 눈이 피곤해집니다.",
      "ko": "작은 점들이 흔들리면 눈이 피곤해집니다.",
      "en": "shifting dots can become uncomfortable.",
      "start": 28.366666666666667,
      "end": 30.583333333333332,
      "startFrame": 1702,
      "endFrame": 1835
    },
    {
      "id": "p5-3",
      "lineIndex": 4,
      "spoken": "이 게임은 삼차원 카메라와",
      "ko": "이 게임은 삼차원 카메라와",
      "en": "The game adjusted how the 3D camera",
      "start": 31.016666666666666,
      "end": 32.766666666666666,
      "startFrame": 1861,
      "endFrame": 1966
    },
    {
      "id": "p5-4",
      "lineIndex": 4,
      "spoken": "점들의 배치 관계를 조정해, 깜빡임을 줄였습니다.",
      "ko": "점들의 배치 관계를 조정해, 깜빡임을 줄였습니다.",
      "en": "relates to dot placement, reducing flicker.",
      "start": 32.766666666666666,
      "end": 35.6,
      "startFrame": 1966,
      "endFrame": 2136
    },
    {
      "id": "p6-1",
      "lineIndex": 5,
      "spoken": "색을 늘리지 않고도,",
      "ko": "색을 늘리지 않고도,",
      "en": "Without adding more colors,",
      "start": 36.03333333333333,
      "end": 37.28333333333333,
      "startFrame": 2162,
      "endFrame": 2237
    },
    {
      "id": "p6-2",
      "lineIndex": 5,
      "spoken": "점의 배치로 빛과 그림자를 만든 겁니다.",
      "ko": "점의 배치로 빛과 그림자를 만든 겁니다.",
      "en": "the arrangement of dots creates light and shadow.",
      "start": 37.28333333333333,
      "end": 39.68333333333333,
      "startFrame": 2237,
      "endFrame": 2381
    },
    {
      "id": "p6-3",
      "lineIndex": 5,
      "spoken": "두 가지 색으로 깊이가 보이는 이유,",
      "ko": "두 가지 색으로 깊이가 보이는 이유,",
      "en": "That depth from just two colors",
      "start": 40.13333333333333,
      "end": 42.233333333333334,
      "startFrame": 2408,
      "endFrame": 2534
    },
    {
      "id": "p6-4",
      "lineIndex": 5,
      "spoken": "디더링입니다.",
      "ko": "디더링입니다.",
      "en": "comes from dithering.",
      "start": 42.233333333333334,
      "end": 42.96666666666667,
      "startFrame": 2534,
      "endFrame": 2578
    }
  ]
