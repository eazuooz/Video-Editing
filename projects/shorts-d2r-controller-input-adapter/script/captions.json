  "cues": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "클릭으로 움직이던 디아블로 투.",
      "ko": "클릭으로 움직이던 디아블로 II.",
      "en": "Diablo II was built around click movement.",
      "start": 0.2,
      "end": 2.0833333333333335,
      "startFrame": 12,
      "endFrame": 125
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "패드는 어떻게 연결했을까요?",
      "ko": "패드는 어떻게 연결했을까요?",
      "en": "How did the developers connect a gamepad?",
      "start": 2.0833333333333335,
      "end": 3.8833333333333333,
      "startFrame": 125,
      "endFrame": 233
    },
    {
      "id": "p2-1",
      "lineIndex": 1,
      "spoken": "클릭은 목적지를 정하는 방식입니다.",
      "ko": "클릭은 목적지를 정하는 방식입니다.",
      "en": "A click specifies a destination.",
      "start": 4.1,
      "end": 6.183333333333334,
      "startFrame": 246,
      "endFrame": 371
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "게임이 거기까지 길을 찾아가죠.",
      "ko": "게임이 거기까지 길을 찾아가죠.",
      "en": "The game finds a path to it.",
      "start": 6.316666666666666,
      "end": 8.166666666666666,
      "startFrame": 379,
      "endFrame": 490
    },
    {
      "id": "p2-3",
      "lineIndex": 1,
      "spoken": "스틱은 지금 움직일 방향을 정합니다.",
      "ko": "스틱은 지금 움직일 방향을 정합니다.",
      "en": "A stick sets the current direction.",
      "start": 8.566666666666666,
      "end": 10.816666666666666,
      "startFrame": 514,
      "endFrame": 649
    },
    {
      "id": "p3-1",
      "lineIndex": 2,
      "spoken": "그래서 사이에 입력을 바꾸는 통역을 넣었습니다.",
      "ko": "그래서 사이에 입력을 바꾸는 통역을 넣었습니다.",
      "en": "An input translator connects the two.",
      "start": 11.416666666666666,
      "end": 14.316666666666666,
      "startFrame": 685,
      "endFrame": 859
    },
    {
      "id": "p3-2",
      "lineIndex": 2,
      "spoken": "스틱과 버튼을,",
      "ko": "스틱과 버튼을,",
      "en": "Sticks and buttons",
      "start": 14.566666666666666,
      "end": 15.566666666666666,
      "startFrame": 874,
      "endFrame": 934
    },
    {
      "id": "p3-2b",
      "lineIndex": 2,
      "spoken": "기존 게임이 이해하는 행동으로 연결한 거예요.",
      "ko": "기존 게임이 이해하는 행동으로 연결한 거예요.",
      "en": "trigger actions the old game understands.",
      "start": 15.566666666666666,
      "end": 18.133333333333333,
      "startFrame": 934,
      "endFrame": 1088
    },
    {
      "id": "p4-1",
      "lineIndex": 3,
      "spoken": "그런데 이동은 명령만 바꾸면 끝일까요?",
      "ko": "그런데 이동은 명령만 바꾸면 끝일까요?",
      "en": "But is translating the command enough?",
      "start": 18.4,
      "end": 20.766666666666666,
      "startFrame": 1104,
      "endFrame": 1246
    },
    {
      "id": "p4-2",
      "lineIndex": 3,
      "spoken": "패드에서는 자동 길 찾기를 끄고,",
      "ko": "패드에서는 자동 길 찾기를 끄고,",
      "en": "Controller movement turns pathfinding off.",
      "start": 20.866666666666667,
      "end": 22.716666666666665,
      "startFrame": 1252,
      "endFrame": 1363
    },
    {
      "id": "p4-3",
      "lineIndex": 3,
      "spoken": "플레이어가 방향을 직접 조절하게 했습니다.",
      "ko": "플레이어가 방향을 직접 조절하게 했습니다.",
      "en": "The player directly controls the direction.",
      "start": 22.716666666666665,
      "end": 25.7,
      "startFrame": 1363,
      "endFrame": 1542
    },
    {
      "id": "p4-4",
      "lineIndex": 3,
      "spoken": "그래서 벽으로 밀면, 벽에 막히기도 하죠.",
      "ko": "그래서 벽으로 밀면, 벽에 막히기도 하죠.",
      "en": "Push toward a wall and the character can run into it.",
      "start": 26.0,
      "end": 28.7,
      "startFrame": 1560,
      "endFrame": 1722
    },
    {
      "id": "p5-1",
      "lineIndex": 4,
      "spoken": "우리 그림에서도 목적지는 같은데,",
      "ko": "우리 그림에서도 목적지는 같은데,",
      "en": "Our demo uses the same destination.",
      "start": 28.833333333333332,
      "end": 30.666666666666668,
      "startFrame": 1730,
      "endFrame": 1840
    },
    {
      "id": "p5-2",
      "lineIndex": 4,
      "spoken": "클릭은 장애물을 돌아가고,",
      "ko": "클릭은 장애물을 돌아가고,",
      "en": "Click movement finds a route around the obstacle.",
      "start": 30.666666666666668,
      "end": 32.68333333333333,
      "startFrame": 1840,
      "endFrame": 1961
    },
    {
      "id": "p5-3",
      "lineIndex": 4,
      "spoken": "스틱은 방향을 바꿔 줘야 합니다.",
      "ko": "스틱은 방향을 바꿔 줘야 합니다.",
      "en": "Stick movement needs you to change direction.",
      "start": 32.68333333333333,
      "end": 35.06666666666667,
      "startFrame": 1961,
      "endFrame": 2104
    },
    {
      "id": "p5-4",
      "lineIndex": 4,
      "spoken": "조작의 의미가 달라진 겁니다.",
      "ko": "조작의 의미가 달라진 겁니다.",
      "en": "The meaning of the control has changed.",
      "start": 35.31666666666667,
      "end": 37.06666666666667,
      "startFrame": 2119,
      "endFrame": 2224
    },
    {
      "id": "p6-1",
      "lineIndex": 5,
      "spoken": "입력 변환 계층으로",
      "ko": "입력 변환 계층으로",
      "en": "An input adaptation layer",
      "start": 37.266666666666666,
      "end": 38.43333333333333,
      "startFrame": 2236,
      "endFrame": 2306
    },
    {
      "id": "p6-1b",
      "lineIndex": 5,
      "spoken": "옛 게임과 새 조작기를 연결하고,",
      "ko": "옛 게임과 새 조작기를 연결하고,",
      "en": "connects the old game to the new device.",
      "start": 38.43333333333333,
      "end": 40.833333333333336,
      "startFrame": 2306,
      "endFrame": 2450
    },
    {
      "id": "p6-2",
      "lineIndex": 5,
      "spoken": "이동 방식까지 다듬어, 패드의 손맛을 만든 거죠.",
      "ko": "이동 방식까지 다듬어, 패드의 손맛을 만든 거죠.",
      "en": "Movement changes make the pad feel right.",
