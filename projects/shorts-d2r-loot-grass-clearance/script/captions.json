  "cues": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "디아블로 투의 전리품이,",
      "ko": "디아블로 II의 전리품이,",
      "en": "The loot in Diablo II:",
      "start": 0.2,
      "end": 1.8333333333333333,
      "startFrame": 12,
      "endFrame": 110
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "풀에 가려서 보이지 않는다면요?",
      "ko": "풀에 가려서 보이지 않는다면요?",
      "en": "what if the grass hides it?",
      "start": 1.8333333333333333,
      "end": 3.6666666666666665,
      "startFrame": 110,
      "endFrame": 220
    },
    {
      "lineIndex": 1,
      "id": "p2-1",
      "spoken": "디아블로 투 레저렉션에서는 그래픽을 바꾸며",
      "ko": "디아블로 II: 레저렉션에서는\n그래픽을 바꾸며",
      "en": "Resurrected's new visuals",
      "start": 3.9,
      "end": 6.783333333333333,
      "startFrame": 234,
      "endFrame": 407
    },
    {
      "lineIndex": 1,
      "id": "p2-1b",
      "spoken": "풀이 입체적으로 늘어났습니다.",
      "ko": "풀이 입체적으로 늘어났습니다.",
      "en": "added physical grass.",
      "start": 6.783333333333333,
      "end": 8.566666666666666,
      "startFrame": 407,
      "endFrame": 514
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "그런데 전리품까지 가려 버리는 문제가 생겼어요.",
      "ko": "그런데 전리품까지 가려 버리는 문제가 생겼어요.",
      "en": "That grass could also obscure the loot.",
      "start": 8.866666666666667,
      "end": 11.316666666666666,
      "startFrame": 532,
      "endFrame": 679
    },
    {
      "id": "p3-1",
      "lineIndex": 2,
      "spoken": "개발진의 해결책은 아이템이 떨어지면,",
      "ko": "개발진의 해결책은 아이템이 떨어지면,",
      "en": "Their solution was to move the grass",
      "start": 11.483333333333333,
      "end": 13.966666666666667,
      "startFrame": 689,
      "endFrame": 838
    },
    {
      "id": "p3-2",
      "lineIndex": 2,
      "spoken": "주변 풀을 비켜 주는 기술이었습니다.",
      "ko": "주변 풀을 비켜 주는 기술이었습니다.",
      "en": "out of the way when an item dropped.",
      "start": 13.966666666666667,
      "end": 16.3,
      "startFrame": 838,
      "endFrame": 978
    },
    {
      "id": "p4-1",
      "lineIndex": 3,
      "spoken": "우리 설명에서는 아이템의 위치를 기준으로,",
      "ko": "우리 설명에서는 아이템의 위치를 기준으로,",
      "en": "In our illustration, the item’s position",
      "start": 16.5,
      "end": 18.633333333333333,
      "startFrame": 990,
      "endFrame": 1118
    },
    {
      "id": "p4-2",
      "lineIndex": 3,
      "spoken": "가까운 풀만 바깥쪽으로 움직여 볼게요.",
      "ko": "가까운 풀만 바깥쪽으로 움직여 볼게요.",
      "en": "pushes only nearby blades outward.",
      "start": 18.633333333333333,
      "end": 21.183333333333334,
      "startFrame": 1118,
      "endFrame": 1271
    },
    {
      "id": "p4-3",
      "lineIndex": 3,
      "spoken": "주변은 그대로인데 아이템의 윤곽이 드러나죠.",
      "ko": "주변은 그대로인데 아이템의 윤곽이 드러나죠.",
      "en": "The scene stays; the item's outline appears.",
      "start": 21.416666666666668,
      "end": 24.0,
      "startFrame": 1285,
      "endFrame": 1440
    },
    {
      "id": "p5-1",
      "lineIndex": 4,
      "spoken": "이처럼 식물의 위치나 모양을 바꾸는 기술.",
      "ko": "식물의 위치나 모양을 바꾸는 기술.",
      "en": "Moving or reshaping vegetation like this",
      "start": 24.183333333333334,
      "end": 27.216666666666665,
      "startFrame": 1451,
      "endFrame": 1633
    },
    {
      "id": "p5-2",
      "lineIndex": 4,
      "spoken": "영어로 베지테이션 디스플레이스먼트라고 합니다.",
      "ko": "식생 변위 기법입니다.",
      "en": "is called vegetation displacement.",
      "start": 27.216666666666665,
      "end": 30.183333333333334,
      "startFrame": 1633,
      "endFrame": 1811
    },
    {
      "id": "p5-3",
      "lineIndex": 4,
      "spoken": "여기서는 바람보다 무엇을 보여 줄지가 중요했어요.",
      "ko": "여기서는 바람보다 무엇을 보여 줄지가 중요했어요.",
      "en": "Here, visibility mattered more than wind.",
      "start": 30.2,
      "end": 33.333333333333336,
      "startFrame": 1812,
      "endFrame": 2000
    },
    {
      "id": "p6-1",
      "lineIndex": 5,
      "spoken": "사실적으로 풀을 늘리는 것만으로는 부족했습니다.",
      "ko": "사실적으로 풀을 늘리는 것만으로는 부족했습니다.",
      "en": "Adding realistic grass was only part of the job.",
      "start": 33.7,
      "end": 36.5,
      "startFrame": 2022,
      "endFrame": 2190
    },
    {
      "lineIndex": 5,
      "id": "p6-2",
      "spoken": "전리품을 찾는 재미까지 지켜야",
      "ko": "전리품을 찾는 재미까지 지켜야",
      "en": "Preserving the joy of finding loot",
      "start": 36.916666666666664,
      "end": 38.61666666666667,
      "startFrame": 2215,
      "endFrame": 2317
    },
    {
      "lineIndex": 5,
      "id": "p6-2b",
      "spoken": "그래픽 개선이 된 거죠.",
      "ko": "그래픽 개선이 된 거죠.",
      "en": "was part of the visual upgrade.",
      "start": 38.61666666666667,
      "end": 39.71666666666667,
