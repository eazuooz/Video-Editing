{
  "clauses": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "심시티의 이 많은 창문,",
      "ko": "심시티의 이 많은 창문,",
      "en": "All these windows in SimCity—"
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "안쪽 방까지 전부 만들었을까요?",
      "ko": "안쪽 방까지 전부 만들었을까요?",
      "en": "did they build every room inside?"
    },
    {
      "id": "p2-1",
      "lineIndex": 1,
      "spoken": "이런 도시에 쓰인 기술이",
      "ko": "이런 도시에 쓰인 기술이",
      "en": "One technique used in this city is"
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "인테리어 매핑입니다.",
      "ko": "인테리어 매핑입니다.",
      "en": "interior mapping.",
      "emphasis": {
        "text": "인테리어 매핑",
        "role": "term"
      }
    },
    {
      "id": "p2-3",
      "lineIndex": 1,
      "spoken": "평평한 벽에 방의 깊이를 그리는 거죠.",
      "ko": "평평한 벽에 방의 깊이를 그리는 거죠.",
      "en": "It draws room depth on a flat surface."
    },
    {
      "id": "p3-1",
      "lineIndex": 2,
      "spoken": "우리 창문을 옆으로 돌려 보면,",
      "ko": "우리 창문을 옆으로 돌려 보면,",
      "en": "Look at our window from the side:"
    },
    {
      "id": "p3-2",
      "lineIndex": 2,
      "spoken": "실제 모양은 이 평면뿐입니다.",
      "ko": "실제 모양은 이 평면뿐입니다.",
      "en": "the surface itself is just a flat plane.",
      "emphasis": {
        "text": "평면뿐",
        "role": "result"
      }
    },
    {
      "id": "p3-3",
      "lineIndex": 2,
      "spoken": "그런데 정면에서는 방 안이 보이죠.",
      "ko": "그런데 정면에서는 방 안이 보이죠.",
      "en": "Yet the front view shows a room inside."
    },
    {
      "id": "p4-0",
      "lineIndex": 3,
      "spoken": "화면의 작은 점을 픽셀이라고 하죠.",
      "ko": "화면의 작은 점을 픽셀이라고 하죠.",
      "en": "A pixel is a tiny point in the image."
    },
    {
      "id": "p4-1",
      "lineIndex": 3,
      "spoken": "비밀은 카메라에서",
      "ko": "비밀은 카메라에서",
      "en": "The key is the line from the camera"
    },
    {
      "id": "p4-2",
      "lineIndex": 3,
      "spoken": "창문 픽셀을 지나는 시선입니다.",
      "ko": "창문 픽셀을 지나는 시선입니다.",
      "en": "through each window pixel."
    },
    {
      "id": "p4-3",
      "lineIndex": 3,
      "spoken": "그 뒤에 벽과 바닥, 천장이 있다고 가정하고,",
      "ko": "그 뒤에 벽과 바닥, 천장이 있다고 가정하고,",
      "en": "We imagine walls, a floor and a ceiling behind it,"
    },
    {
      "id": "p4-4",
      "lineIndex": 3,
      "spoken": "이 선이 어디에 먼저 닿는지 계산해요.",
      "ko": "이 선이 어디에 먼저 닿는지 계산해요.",
      "en": "Find the first surface the ray hits.",
      "emphasis": {
        "text": "먼저 닿는지",
        "role": "term"
      }
    },
    {
      "id": "p5-1",
      "lineIndex": 4,
      "spoken": "예를 들어 뒷벽에 먼저 닿으면,",
      "ko": "예를 들어 뒷벽에 먼저 닿으면,",
      "en": "If it reaches the back wall first,"
    },
    {
      "id": "p5-2",
      "lineIndex": 4,
      "spoken": "그 지점의 벽무늬를 읽어서",
      "ko": "그 지점의 벽무늬를 읽어서",
      "en": "we sample the wall texture at that point"
    },
    {
      "id": "p5-3",
      "lineIndex": 4,
      "spoken": "창문 픽셀에 그립니다.",
      "ko": "창문 픽셀에 그립니다.",
      "en": "and draw that colour in the window pixel."
    },
    {
      "id": "p6-1",
      "lineIndex": 5,
      "spoken": "카메라를 오른쪽으로 옮기면",
      "ko": "카메라를 오른쪽으로 옮기면",
      "en": "Move the camera to the right,"
    },
    {
      "id": "p6-2",
      "lineIndex": 5,
      "spoken": "시선이 바뀌고 옆벽이 더 보이죠.",
      "ko": "시선이 바뀌고 옆벽이 더 보이죠.",
      "en": "More of the side wall comes into view."
    },
    {
      "id": "p6-3",
      "lineIndex": 5,
      "spoken": "고정된 방 사진과 달리,",
      "ko": "고정된 방 사진과 달리,",
      "en": "Unlike a fixed photograph,"
    },
    {
      "id": "p6-4",
      "lineIndex": 5,
      "spoken": "보는 각도에 맞춰 그림이 달라집니다.",
      "ko": "보는 각도에 맞춰 그림이 달라집니다.",
      "en": "the image changes with the viewing angle."
    },
    {
      "id": "p7-1",
      "lineIndex": 6,
      "spoken": "이 계산을 픽셀마다 반복하면,",
      "ko": "이 계산을 픽셀마다 반복하면,",
      "en": "Repeat that calculation for every pixel,"
    },
    {
      "id": "p7-2",
      "lineIndex": 6,
      "spoken": "방의 입체 모델을 늘리지 않고도",
      "ko": "방의 입체 모델을 늘리지 않고도",
      "en": "and without adding room geometry,"
    },
    {
      "id": "p7-3",
      "lineIndex": 6,
      "spoken": "안쪽에 깊이가 생깁니다.",
      "ko": "안쪽에 깊이가 생깁니다.",
      "en": "the interior gains visible depth."
    },
    {
      "id": "p8-1",
      "lineIndex": 7,
      "spoken": "물론 이 가상 방 안으로 들어갈 수는 없어요.",
      "ko": "물론 이 가상 방 안으로 들어갈 수는 없어요.",
      "en": "You cannot walk into this virtual room."
    },
    {
      "id": "p8-2",
      "lineIndex": 7,
      "spoken": "기본 방식에서는 가구도 평평한 무늬입니다.",
      "ko": "기본 방식에서는 가구도 평평한 무늬입니다.",
      "en": "Here, furniture is a flat texture too."
    },
    {
      "id": "p8-3",
      "lineIndex": 8,
      "spoken": "가까이서 탐험할 방은 실제 모델로,",
      "ko": "가까이서 탐험할 방은 실제 모델로,",
      "en": "Use real geometry for rooms you can explore,"
    },
    {
      "id": "p8-4",
      "lineIndex": 8,
      "spoken": "지나가며 보는 창문 안은 이런 계산으로.",
      "ko": "지나가며 보는 창문 안은 이런 계산으로.",
      "en": "and this calculation for windows you pass by."
    },
    {
      "id": "p8-5",
      "lineIndex": 8,
      "spoken": "모든 방을 만드는 비용을 아끼는 겁니다.",
      "ko": "모든 방을 만드는 비용을 아끼는 겁니다.",
      "en": "That saves the cost of building every room.",
      "emphasis": {
        "text": "모든 방을 만드는 비용",
        "role": "result"
      }
    }
  ]
}
