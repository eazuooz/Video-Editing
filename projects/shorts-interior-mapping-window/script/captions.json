    "asrSha256": "86d941e600ca1bc27f3a4ce4f56380db1ad316d95224ae572719db74f8663959",
    "pronunciationAliases": {},
    "narrationSha256": "788511e4b96925fcf387ed21b154d73a8d3021c97e4059a68ae8e92b0bd27be3",
    "clausesSha256": "1f0078ce8afe2b68ad203662d2f382a80e159bf6c6d8e13d7740aca2f86d5981",
