  },
  "cues": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "심시티의 이 많은 창문,",
      "ko": "심시티의 이 많은 창문,",
      "en": "All these windows in SimCity—",
      "start": 0.2,
      "end": 2.066666666666667,
      "startFrame": 12,
      "endFrame": 124
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "안쪽 방까지 전부 만들었을까요?",
      "ko": "안쪽 방까지 전부 만들었을까요?",
      "en": "did they build every room inside?",
      "start": 2.066666666666667,
      "end": 3.9166666666666665,
      "startFrame": 124,
      "endFrame": 235
    },
    {
      "id": "p2-1",
      "lineIndex": 1,
      "spoken": "이런 도시에 쓰인 기술이",
      "ko": "이런 도시에 쓰인 기술이",
      "en": "One technique used in this city is",
      "start": 4.133333333333334,
      "end": 5.633333333333334,
      "startFrame": 248,
      "endFrame": 338
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "인테리어 매핑입니다.",
      "ko": "인테리어 매핑입니다.",
      "en": "interior mapping.",
      "emphasis": {
        "text": "인테리어 매핑",
        "role": "term"
      },
      "start": 5.633333333333334,
      "end": 7.283333333333333,
      "startFrame": 338,
      "endFrame": 437
    },
    {
      "id": "p2-3",
      "lineIndex": 1,
      "spoken": "평평한 벽에 방의 깊이를 그리는 거죠.",
      "ko": "평평한 벽에 방의 깊이를 그리는 거죠.",
      "en": "It draws room depth on a flat surface.",
      "start": 7.416666666666667,
      "end": 9.866666666666667,
      "startFrame": 445,
      "endFrame": 592
    },
    {
      "id": "p3-1",
      "lineIndex": 2,
      "spoken": "우리 창문을 옆으로 돌려 보면,",
      "ko": "우리 창문을 옆으로 돌려 보면,",
      "en": "Look at our window from the side:",
      "start": 9.966666666666667,
      "end": 11.366666666666667,
      "startFrame": 598,
      "endFrame": 682
    },
    {
      "id": "p3-2",
      "lineIndex": 2,
      "spoken": "실제 모양은 이 평면뿐입니다.",
      "ko": "실제 모양은 이 평면뿐입니다.",
      "en": "the surface itself is just a flat plane.",
      "emphasis": {
        "text": "평면뿐",
        "role": "result"
      },
      "start": 11.366666666666667,
      "end": 13.466666666666667,
      "startFrame": 682,
      "endFrame": 808
    },
    {
      "id": "p3-3",
      "lineIndex": 2,
      "spoken": "그런데 정면에서는 방 안이 보이죠.",
      "ko": "그런데 정면에서는 방 안이 보이죠.",
      "en": "Yet the front view shows a room inside.",
      "start": 13.716666666666667,
      "end": 15.416666666666666,
      "startFrame": 823,
      "endFrame": 925
    },
    {
      "id": "p4-0",
      "lineIndex": 3,
      "spoken": "화면의 작은 점을 픽셀이라고 하죠.",
      "ko": "화면의 작은 점을 픽셀이라고 하죠.",
      "en": "A pixel is a tiny point in the image.",
      "start": 15.616666666666667,
      "end": 17.966666666666665,
      "startFrame": 937,
      "endFrame": 1078
    },
    {
      "id": "p4-1",
      "lineIndex": 3,
      "spoken": "비밀은 카메라에서",
      "ko": "비밀은 카메라에서",
      "en": "The key is the line from the camera",
      "start": 18.233333333333334,
      "end": 19.3,
      "startFrame": 1094,
      "endFrame": 1158
    },
    {
      "id": "p4-2",
      "lineIndex": 3,
      "spoken": "창문 픽셀을 지나는 시선입니다.",
      "ko": "창문 픽셀을 지나는 시선입니다.",
      "en": "through each window pixel.",
      "start": 19.3,
      "end": 21.516666666666666,
      "startFrame": 1158,
      "endFrame": 1291
    },
    {
      "id": "p4-3",
      "lineIndex": 3,
      "spoken": "그 뒤에 벽과 바닥, 천장이 있다고 가정하고,",
      "ko": "그 뒤에 벽과 바닥, 천장이 있다고 가정하고,",
      "en": "We imagine walls, a floor and a ceiling behind it,",
      "start": 21.833333333333332,
      "end": 24.833333333333332,
      "startFrame": 1310,
      "endFrame": 1490
    },
    {
      "id": "p4-4",
      "lineIndex": 3,
      "spoken": "이 선이 어디에 먼저 닿는지 계산해요.",
      "ko": "이 선이 어디에 먼저 닿는지 계산해요.",
      "en": "Find the first surface the ray hits.",
      "emphasis": {
        "text": "먼저 닿는지",
        "role": "term"
      },
      "start": 25.033333333333335,
      "end": 27.283333333333335,
      "startFrame": 1502,
      "endFrame": 1637
    },
    {
      "id": "p5-1",
      "lineIndex": 4,
      "spoken": "예를 들어 뒷벽에 먼저 닿으면,",
      "ko": "예를 들어 뒷벽에 먼저 닿으면,",
      "en": "If it reaches the back wall first,",
      "start": 27.283333333333335,
      "end": 29.083333333333332,
      "startFrame": 1637,
      "endFrame": 1745
    },
    {
      "id": "p5-2",
      "lineIndex": 4,
      "spoken": "그 지점의 벽무늬를 읽어서",
      "ko": "그 지점의 벽무늬를 읽어서",
      "en": "we sample the wall texture at that point",
      "start": 29.083333333333332,
      "end": 30.933333333333334,
      "startFrame": 1745,
      "endFrame": 1856
    },
    {
      "id": "p5-3",
      "lineIndex": 4,
      "spoken": "창문 픽셀에 그립니다.",
      "ko": "창문 픽셀에 그립니다.",
      "en": "and draw that colour in the window pixel.",
      "start": 30.933333333333334,
      "end": 32.6,
      "startFrame": 1856,
      "endFrame": 1956
    },
    {
      "id": "p6-1",
      "lineIndex": 5,
      "spoken": "카메라를 오른쪽으로 옮기면",
      "ko": "카메라를 오른쪽으로 옮기면",
      "en": "Move the camera to the right,",
      "start": 32.8,
      "end": 34.43333333333333,
      "startFrame": 1968,
      "endFrame": 2066
    },
    {
      "id": "p6-2",
      "lineIndex": 5,
      "spoken": "시선이 바뀌고 옆벽이 더 보이죠.",
      "ko": "시선이 바뀌고 옆벽이 더 보이죠.",
      "en": "More of the side wall comes into view.",
      "start": 34.43333333333333,
      "end": 36.61666666666667,
      "startFrame": 2066,
      "endFrame": 2197
    },
    {
      "id": "p6-3",
      "lineIndex": 5,
      "spoken": "고정된 방 사진과 달리,",
      "ko": "고정된 방 사진과 달리,",
      "en": "Unlike a fixed photograph,",
      "start": 36.86666666666667,
      "end": 38.38333333333333,
      "startFrame": 2212,
      "endFrame": 2303
    },
    {
      "id": "p6-4",
      "lineIndex": 5,
      "spoken": "보는 각도에 맞춰 그림이 달라집니다.",
      "ko": "보는 각도에 맞춰 그림이 달라집니다.",
      "en": "the image changes with the viewing angle.",
      "start": 38.38333333333333,
      "end": 41.0,
      "startFrame": 2303,
      "endFrame": 2460
    },
    {
      "id": "p7-1",
      "lineIndex": 6,
      "spoken": "이 계산을 픽셀마다 반복하면,",
      "ko": "이 계산을 픽셀마다 반복하면,",
      "en": "Repeat that calculation for every pixel,",
      "start": 41.2,
      "end": 42.96666666666667,
      "startFrame": 2472,
      "endFrame": 2578
    },
    {
      "id": "p7-2",
      "lineIndex": 6,
      "spoken": "방의 입체 모델을 늘리지 않고도",
      "ko": "방의 입체 모델을 늘리지 않고도",
      "en": "and without adding room geometry,",
      "start": 42.96666666666667,
      "end": 45.4,
      "startFrame": 2578,
      "endFrame": 2724
    },
    {
      "id": "p7-3",
      "lineIndex": 6,
      "spoken": "안쪽에 깊이가 생깁니다.",
      "ko": "안쪽에 깊이가 생깁니다.",
      "en": "the interior gains visible depth.",
      "start": 45.4,
      "end": 47.13333333333333,
      "startFrame": 2724,
      "endFrame": 2828
    },
    {
      "id": "p8-1",
      "lineIndex": 7,
      "spoken": "물론 이 가상 방 안으로 들어갈 수는 없어요.",
      "ko": "물론 이 가상 방 안으로 들어갈 수는 없어요.",
      "en": "You cannot walk into this virtual room.",
      "start": 47.36666666666667,
      "end": 49.833333333333336,
      "startFrame": 2842,
      "endFrame": 2990
    },
    {
      "id": "p8-2",
      "lineIndex": 7,
      "spoken": "기본 방식에서는 가구도 평평한 무늬입니다.",
      "ko": "기본 방식에서는 가구도 평평한 무늬입니다.",
      "en": "Here, furniture is a flat texture too.",
      "start": 50.11666666666667,
      "end": 52.71666666666667,
      "startFrame": 3007,
      "endFrame": 3163
    },
    {
      "id": "p8-3",
      "lineIndex": 8,
      "spoken": "가까이서 탐험할 방은 실제 모델로,",
      "ko": "가까이서 탐험할 방은 실제 모델로,",
      "en": "Use real geometry for rooms you can explore,",
      "start": 52.71666666666667,
      "end": 55.166666666666664,
      "startFrame": 3163,
      "endFrame": 3310
    },
    {
      "id": "p8-4",
      "lineIndex": 8,
      "spoken": "지나가며 보는 창문 안은 이런 계산으로.",
      "ko": "지나가며 보는 창문 안은 이런 계산으로.",
      "en": "and this calculation for windows you pass by.",
      "start": 55.166666666666664,
      "end": 57.71666666666667,
      "startFrame": 3310,
      "endFrame": 3463
    },
    {
      "id": "p8-5",
      "lineIndex": 8,
      "spoken": "모든 방을 만드는 비용을 아끼는 겁니다.",
      "ko": "모든 방을 만드는 비용을 아끼는 겁니다.",
      "en": "That saves the cost of building every room.",
      "emphasis": {
        "text": "모든 방을 만드는 비용",
        "role": "result"
      },
      "start": 57.71666666666667,
      "end": 60.36666666666667,
      "startFrame": 3463,
      "endFrame": 3622
    }
  ]
}
