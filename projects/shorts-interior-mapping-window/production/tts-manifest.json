{
  "schemaVersion": 2,
  "slug": "shorts-interior-mapping-window",
  "revision": "interior-mapping-v1",
  "paths": {
    "script": "projects/shorts-interior-mapping-window/script/narration.spoken.ko.json"
  },
  "editing": {
    "exampleSeconds": 0,
    "narrationPlacement": "continuous-across-example-and-explanation"
  },
  "tts": {
    "engine": "qwen3-tts",
    "language": "Korean",
    "reference": "shared/voice-reference/reference-15-35s.wav",
    "referenceText": "shared/voice-reference/reference-15-35s.ko.txt",
    "model": "qwen3-tts/models/Qwen3-TTS-12Hz-1.7B-Base",
    "outputDir": "projects/shorts-interior-mapping-window/production/local/audio-r2/voice",
    "filenameStem": "interior",
    "renderMode": "line",
    "sceneGapSeconds": 0,
    "tailRatioThreshold": 0.07,
    "tailDecayMsThreshold": 70,
    "maxRenderAttempts": 1,
    "maxNewTokens": 2048,
    "edgeFadeSeconds": 0,
    "gpuMinimumFreeMiB": 4800,
    "gpuProfileReason": "Same approved model/reference/paragraphs; GPU talker, CPU codec to preserve live Unity memory. Validate one paragraph before continuing.",
    "lineGapSeconds": 0.28,
    "paragraphLevelNormalization": {
      "policy": "line-level-takes-v1",
      "frameSeconds": 0.05,
      "gateMaximumDbfs": -25,
      "adaptiveGateBelowPeakDb": 25,
      "targetMedianDbfs": -22,
      "maximumGainDb": 12,
      "speechSpeed": 1,
      "preserveRawPcm": true,
      "minimumIntendedJoinSeconds": 0.28,
      "gapPolicy": "Retain all natural lead/tail PCM; add only unmet portion of0.28s, never trim speech/breath."
    }
  }
}
