    {
      "id": "07",
      "title": "3D로 확장하고 핵심 정리",
      "start": 144.96666666666667,
      "frames": 1502,
      "seconds": 25.033333333333335,
      "voice": "shared/output/narration/game-math-polar-sample/qwen3-1.7b-balanced-v1/chunks/07-scene.wav",
