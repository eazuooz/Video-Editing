        714240
      ]
    },
    {
      "sceneId": "p002-c03",
      "canonicalText": "이런 방 크기의 묶음을 레벨 조각이라고 하죠.",
      "actualWav": {
        "path": "D:\\Github\\VideoEditing\\shared\\output\\architectural-111-20261106\\11-05\\voice-attempts\\6691614beecda682a8130136\\chunks\\p002-c03-scene.wav",
