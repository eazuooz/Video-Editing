    {
      "sceneId": "p002-c04",
      "canonicalText": "생성기는 이 조각들을 고르고 이어 붙입니다.",
      "actualWav": {
        "path": "D:\\Github\\VideoEditing\\shared\\output\\architectural-111-20261106\\11-05\\voice-attempts\\6691614beecda682a8130136\\chunks\\p002-c04-scene.wav",
