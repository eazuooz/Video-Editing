    {
      "id": "s6u0142",
      "paragraph": "p005",
      "ko": "그 흐림은 과거 기록에 계속 쌓지 않습니다.",
      "originUnit": "u014",
      "sourceRaw": {
        "path": "D:\\Github\\VideoEditing\\shared\\output\\original-tech-twelve-20261115\\shorts-inside-temporal-antialiasing\\voice-repair-v6\\chunks\\s6u0142-scene.wav",
