        "pcmSHA256": "0364f3dd8f3e44b5240f5c80091c02276c2a3e2d7f0cf046083cdb64f99bc63b"
      }
    },
    {
      "id": "c84u005",
      "paragraph": "p002",
      "ko": "첫 장에서는 칸의 왼쪽, 다음 장에서는 오른쪽을 보는 식입니다."
    },
    {
      "id": "c84u006",
      "paragraph": "p002",
      "ko": "한 번씩 다르게 살펴본 결과를 모으면 가는 선의 위치를 더 잘 짐작할 수 있죠."
    },
    {
      "id": "s6u0071",
      "paragraph": "p003",
      "ko": "카메라나 물체가 움직이면 화면 속 위치도 바뀝니다.",
      "originUnit": "u007",
      "sourceRaw": {
        "path": "D:\\Github\\VideoEditing\\shared\\output\\original-tech-twelve-20261115\\shorts-inside-temporal-antialiasing\\voice-repair-v6\\chunks\\s6u0071-scene.wav",
