      }
    },
    {
      "id": "c84u002",
      "paragraph": "p001",
      "ko": "이 칸이 픽셀이고, 그 칸으로 만든 한 장의 화면이 프레임입니다.",
      "sourceRaw": {
        "path": "C:\\Users\\1\\Videos\\YamyamProduction\\original-tech-twelve-20261115\\shorts-inside-temporal-antialiasing\\voice-master-v95\\chunks\\c84u002.wav",
        "sha256": "f0b1b90c6681db3e049fedafe2c7b682d8c9f9ad6fcb07ba8962fe4d0ceb7268",
