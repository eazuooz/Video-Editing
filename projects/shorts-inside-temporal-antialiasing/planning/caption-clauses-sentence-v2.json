  "paragraphs": [
    {
      "id": "p001",
      "clauses": [
        [
          "인사이드처럼 가느다란 선이 많은 화면은",
          "Scenes with thin lines, as in INSIDE,"
        ],
        [
          "움직일 때 가장자리가 반짝거리기 쉽습니다.",
          "can have shimmering edges in motion."
        ],
        [
          "개발진은 지금 그린 화면에",
          "The developers add information"
        ],
        [
          "지난 화면의 정보를 보탭니다.",
          "from a previous image to the current one."
        ],
        [
          "단, 예전 화면을 그대로 겹치면",
          "But simply overlaying the old image"
        ],
        [
          "움직이는 물체에 잔상이 생길 수 있죠.",
          "can leave ghosts behind moving objects."
        ]
      ]
    },
    {
      "id": "p002",
      "clauses": [
        [
          "먼저 매번 픽셀 안의",
          "First, each frame samples"
        ],
        [
          "조금 다른 위치를 살펴봅니다.",
          "a slightly different position inside the pixel."
        ],
        [
          "이를 지터라고 합니다.",
          "This is called jitter."
        ],
        [
          "한 장에서 놓친 가는 선의 정보를",
          "One image can capture thin-line information"
        ],
        [
          "다른 장에서 얻을 수 있으니,",
          "that another image missed."
        ],
        [
          "여러 장을 잘 모으면",
          "Combining those images carefully"
        ],
        [
          "가장자리를 더 안정적으로 표현할 수 있습니다.",
          "can make the edges more stable."
        ]
      ]
    },
    {
      "id": "p003",
      "clauses": [
        [
          "카메라나 물체가 움직이면",
          "When the camera or an object moves,"
        ],
        [
          "같은 물체도 화면의 다른 자리에 보입니다.",
          "the same object appears at a different screen position."
        ],
        [
          "그래서 깊이와 움직임 정보를 이용해,",
          "Depth and motion information help locate"
        ],
        [
          "지금 이 점이 지난 화면의 어디에 있었는지 찾습니다.",
          "where this point was in the previous image."
        ],
        [
          "이 대응 위치 찾기가 재투영입니다.",
          "Finding that correspondence is reprojection."
        ]
      ]
    },
    {
      "id": "p004",
      "clauses": [
        [
          "하지만 방금 가려졌다 드러난 곳은",
          "A newly uncovered region, however,"
        ],
        [
          "지난 정보가 틀릴 수 있습니다.",
          "can have incorrect historical information."
        ],
        [
          "개발진은 현재 픽셀 주변의 색 범위를 살펴,",
          "The developers examine nearby current colors"
        ],
        [
          "어울리지 않는 과거 색을",
          "and restrict unsuitable history colors"
        ],
        [
          "그 범위 안으로 제한합니다.",
          "to that range."
        ],
        [
          "잘못된 흔적이 계속 남지 않게 하는 과정입니다.",
          "This helps prevent incorrect traces from persisting."
        ]
      ]
    },
    {
      "id": "p005",
      "clauses": [
        [
          "이렇게 다듬은 과거 정보와 현재 색을 섞어",
          "Blend the adjusted history with the current color"
        ],
        [
          "다음 장에서도 쓸 화면을 저장합니다.",
          "and store the result for the next frame."
        ],
        [
          "빠르게 움직이는 부분에는",
          "Fast-moving regions can use"
        ],
        [
          "별도의 모션 블러를 보완으로 쓰지만,",
          "separate motion blur as a fallback,"
        ],
        [
          "그 흐림을 과거 기록에 계속 쌓지는 않습니다.",
          "but that blur is not accumulated in the history."
        ]
      ]
    },
    {
      "id": "p006",
      "clauses": [
        [
          "작은 위치 차이로 정보를 모으고,",
          "Gather information with small sample shifts,"
        ],
        [
          "같은 지점을 찾고,",
          "find the corresponding point,"
        ],
        [
          "틀린 과거를 제한한 뒤 섞습니다.",
          "restrict unsuitable history, then blend."
        ],
        [
          "지난 화면이 도움이 되는 이유는",
          "Previous images help"
        ],
        [
          "오래됐기 때문이 아니라,",
          "not simply because they are old,"
        ],
        [
          "지금 화면에 맞도록 골라 쓸 수 있기 때문입니다.",
          "but because we can select information that fits now."
        ]
      ]
    }
  ],
