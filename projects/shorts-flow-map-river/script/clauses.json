  "clauses": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "이 물결, 바위를 피해 돌아가죠.",
      "ko": "이 물결, 바위를 피해 돌아가죠.",
      "en": "These ripples bend around the rock."
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "물을 전부 시뮬레이션한 걸까요?",
      "ko": "물을 전부 시뮬레이션한 걸까요?",
      "en": "Did we simulate all that water?"
    },
    {
      "id": "p1-3",
      "lineIndex": 0,
      "spoken": "이 장면은 물결 그림을 움직여 만든 겁니다.",
      "ko": "이 장면은 물결 그림을 움직여 만든 겁니다.",
      "en": "Here, we move a ripple texture instead."
    },
    {
      "id": "p2-1",
      "lineIndex": 1,
      "spoken": "그냥 한쪽으로 밀면,",
      "ko": "그냥 한쪽으로 밀면,",
      "en": "Slide it in just one direction,"
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "무늬가 바위도 그대로 통과합니다.",
      "ko": "무늬가 바위도 그대로 통과합니다.",
      "en": "and the pattern runs straight through the rock.",
      "emphasis": {
        "text": "그대로 통과",
        "role": "problem"
      }
    },
    {
      "id": "p2-3",
      "lineIndex": 1,
      "spoken": "그래서 위치마다 움직일 방향을",
      "ko": "그래서 위치마다 움직일 방향을",
      "en": "So, at each position, we store a direction"
    },
    {
      "id": "p2-4",
      "lineIndex": 1,
      "spoken": "화살표로 따로 정해 두죠.",
      "ko": "화살표로 따로 정해 두죠.",
