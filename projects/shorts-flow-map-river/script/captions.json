  "cues": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "이 물결, 바위를 피해 돌아가죠.",
      "ko": "이 물결, 바위를 피해 돌아가죠.",
      "en": "These ripples bend around the rock.",
      "start": 0.2,
      "end": 2.4833333333333334,
      "startFrame": 12,
      "endFrame": 149
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "물을 전부 시뮬레이션한 걸까요?",
      "ko": "물을 전부 시뮬레이션한 걸까요?",
      "en": "Did we simulate all that water?",
      "start": 2.683333333333333,
      "end": 4.3,
      "startFrame": 161,
      "endFrame": 258
    },
    {
      "id": "p1-3",
      "lineIndex": 0,
      "spoken": "이 장면은 물결 그림을 움직여 만든 겁니다.",
      "ko": "이 장면은 물결 그림을 움직여 만든 겁니다.",
      "en": "Here, we move a ripple texture instead.",
      "start": 4.6,
      "end": 7.283333333333333,
      "startFrame": 276,
      "endFrame": 437
    },
    {
      "id": "p2-1",
      "lineIndex": 1,
      "spoken": "그냥 한쪽으로 밀면,",
      "ko": "그냥 한쪽으로 밀면,",
      "en": "Slide it in just one direction,",
      "start": 7.483333333333333,
      "end": 8.633333333333333,
      "startFrame": 449,
      "endFrame": 518
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "무늬가 바위도 그대로 통과합니다.",
      "ko": "무늬가 바위도 그대로 통과합니다.",
      "en": "and the pattern runs straight through the rock.",
      "emphasis": {
        "text": "그대로 통과",
        "role": "problem"
      },
      "start": 8.633333333333333,
      "end": 11.1,
      "startFrame": 518,
      "endFrame": 666
    },
    {
      "id": "p2-3",
      "lineIndex": 1,
      "spoken": "그래서 위치마다 움직일 방향을",
      "ko": "그래서 위치마다 움직일 방향을",
      "en": "So, at each position, we store a direction",
      "start": 11.316666666666666,
      "end": 13.233333333333333,
      "startFrame": 679,
      "endFrame": 794
    },
    {
      "id": "p2-4",
      "lineIndex": 1,
      "spoken": "화살표로 따로 정해 두죠.",
      "ko": "화살표로 따로 정해 두죠.",
      "en": "represented here by an arrow.",
      "start": 13.233333333333333,
      "end": 14.783333333333333,
      "startFrame": 794,
      "endFrame": 887
    },
    {
      "id": "p3-1",
      "lineIndex": 2,
      "spoken": "이 방향 지도가 플로 맵입니다.",
      "ko": "이 방향 지도가 플로 맵입니다.",
      "en": "That direction texture is a flow map.",
      "emphasis": {
        "text": "플로 맵",
        "role": "term"
      },
      "start": 15.0,
      "end": 17.083333333333332,
      "startFrame": 900,
      "endFrame": 1025
    },
    {
      "id": "p3-2",
      "lineIndex": 2,
      "spoken": "우리 지도는 빨강에 가로,",
      "ko": "우리 지도는 빨강에 가로,",
      "en": "Our map stores horizontal motion in red",
      "start": 17.4,
      "end": 18.983333333333334,
      "startFrame": 1044,
      "endFrame": 1139
    },
    {
      "id": "p3-3",
      "lineIndex": 2,
      "spoken": "초록에 세로 방향을 담아요.",
      "ko": "초록에 세로 방향을 담아요.",
      "en": "and vertical motion in green.",
      "start": 18.983333333333334,
      "end": 20.766666666666666,
      "startFrame": 1139,
      "endFrame": 1246
    },
    {
      "id": "p3-4",
      "lineIndex": 2,
      "spoken": "두 값이 절반이면 정지,",
      "ko": "두 값이 절반이면 정지,",
      "en": "Both at one half means no motion.",
      "start": 21.066666666666666,
      "end": 22.8,
      "startFrame": 1264,
      "endFrame": 1368
    },
    {
      "id": "p3-5",
      "lineIndex": 2,
      "spoken": "빨강만 최대로 올리면 오른쪽입니다.",
      "ko": "빨강만 최대로 올리면 오른쪽입니다.",
      "en": "Raise red to its maximum, and it points right.",
      "emphasis": {
        "text": "오른쪽",
        "role": "result"
      },
      "start": 22.8,
      "end": 25.216666666666665,
      "startFrame": 1368,
      "endFrame": 1513
    },
    {
      "id": "p4-1",
      "lineIndex": 3,
      "spoken": "셰이더는 이 값을 읽고,",
      "ko": "셰이더는 이 값을 읽고,",
      "en": "The shader reads these values",
      "start": 25.433333333333334,
      "end": 27.4,
      "startFrame": 1526,
      "endFrame": 1644
    },
    {
      "id": "p4-2",
      "lineIndex": 3,
      "spoken": "물결 그림을 가져올 위치를 조금씩 옮깁니다.",
      "ko": "물결 그림을 가져올 위치를 조금씩 옮깁니다.",
      "en": "and shifts where it samples the ripple texture.",
      "start": 27.4,
      "end": 30.183333333333334,
      "startFrame": 1644,
      "endFrame": 1811
    },
    {
      "id": "p4-3",
      "lineIndex": 3,
      "spoken": "바위 주변의 화살표를 휘게 그렸으니,",
      "ko": "바위 주변의 화살표를 휘게 그렸으니,",
      "en": "We bent the arrows around the rock,",
      "start": 30.2,
      "end": 32.36666666666667,
      "startFrame": 1812,
      "endFrame": 1942
    },
    {
      "id": "p4-4",
      "lineIndex": 3,
      "spoken": "무늬도 갈라져 돌아가는 거죠.",
      "ko": "무늬도 갈라져 돌아가는 거죠.",
      "en": "so the pattern appears to flow around it.",
      "start": 32.483333333333334,
      "end": 33.93333333333333,
      "startFrame": 1949,
      "endFrame": 2036
    },
    {
      "id": "p5-1",
      "lineIndex": 4,
      "spoken": "그런데 계속 늘리면 무늬가 찌그러집니다.",
      "ko": "그런데 계속 늘리면 무늬가 찌그러집니다.",
      "en": "But continuous distortion stretches the pattern.",
      "start": 34.31666666666667,
      "end": 36.56666666666667,
      "startFrame": 2059,
      "endFrame": 2194
    },
    {
      "id": "p5-2",
      "lineIndex": 4,
      "spoken": "그래서 짧게 움직이고 되감되,",
      "ko": "그래서 짧게 움직이고 되감되,",
      "en": "We use short motions, then reset them.",
      "start": 36.93333333333333,
      "end": 38.9,
      "startFrame": 2216,
      "endFrame": 2334
    },
    {
      "id": "p5-3",
      "lineIndex": 4,
      "spoken": "엇갈린 두 무늬를 번갈아 섞어서",
      "ko": "엇갈린 두 무늬를 번갈아 섞어서",
      "en": "Blending two offset cycles",
      "start": 39.2,
      "end": 41.03333333333333,
      "startFrame": 2352,
      "endFrame": 2462
    },
    {
      "id": "p5-4",
      "lineIndex": 4,
      "spoken": "되감는 순간을 감춰요.",
      "ko": "되감는 순간을 감춰요.",
      "en": "hides the moment each one resets.",
      "emphasis": {
        "text": "되감는 순간",
        "role": "problem"
      },
      "start": 41.03333333333333,
      "end": 42.36666666666667,
      "startFrame": 2462,
      "endFrame": 2542
    },
    {
      "id": "p6-1",
      "lineIndex": 5,
      "spoken": "바위를 옮겨도 새 길이 저절로 생기진 않아요.",
      "ko": "바위를 옮겨도 새 길이 저절로 생기진 않아요.",
      "en": "Moving the rock won't update the path.",
      "start": 42.56666666666667,
      "end": 44.86666666666667,
      "startFrame": 2554,
      "endFrame": 2692
    },
    {
      "id": "p6-2",
      "lineIndex": 5,
      "spoken": "방향 지도도 바꿔 줘야 합니다.",
      "ko": "방향 지도도 바꿔 줘야 합니다.",
      "en": "We have to update the flow map too.",
      "emphasis": {
        "text": "방향 지도",
        "role": "term"
      },
      "start": 45.083333333333336,
      "end": 46.86666666666667,
      "startFrame": 2705,
      "endFrame": 2812
    },
    {
      "id": "p6-3",
      "lineIndex": 5,
      "spoken": "물의 모든 움직임 대신,",
      "ko": "물의 모든 움직임 대신,",
      "en": "Instead of solving all the motion of water,",
      "start": 47.266666666666666,
      "end": 48.766666666666666,
      "startFrame": 2836,
      "endFrame": 2926
    },
    {
      "id": "p6-4",
      "lineIndex": 5,
      "spoken": "보이는 흐름을 설계한 겁니다.",
      "ko": "보이는 흐름을 설계한 겁니다.",
      "en": "we design the flow that you see.",
      "start": 48.766666666666666,
      "end": 50.53333333333333,
      "startFrame": 2926,
      "endFrame": 3032
    }
  ]
