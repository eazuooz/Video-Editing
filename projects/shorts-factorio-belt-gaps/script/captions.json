  "cues": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "벨트에 물건이 이렇게 많아도,",
      "ko": "벨트에 물건이 이렇게 많아도,",
      "en": "Even with all these items,",
      "start": 0.2,
      "end": 1.7833333333333334,
      "startFrame": 12,
      "endFrame": 107
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "팩토리오에서는 위치를 하나씩 전부 고치지 않습니다.",
      "ko": "팩토리오에서는 위치를\n전부 고치지 않습니다.",
      "en": "Factorio need not update each position.",
      "start": 1.7833333333333334,
      "end": 4.983333333333333,
      "startFrame": 107,
      "endFrame": 299
    },
    {
      "id": "p1-3",
      "lineIndex": 0,
      "spoken": "비밀은 빈틈이에요.",
      "ko": "비밀은 빈틈이에요.",
      "en": "The secret is the gaps.",
      "start": 5.133333333333334,
      "end": 6.4,
      "startFrame": 308,
      "endFrame": 384
    },
    {
      "id": "p2-1",
      "lineIndex": 1,
      "spoken": "물건 네 개가 함께 한 칸씩 움직이면,",
      "ko": "물건 네 개가 함께\n한 칸씩 움직이면,",
      "en": "Move four items by one unit.",
      "start": 6.683333333333334,
      "end": 8.783333333333333,
      "startFrame": 401,
      "endFrame": 527
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "좌표 네 개가 모두 바뀌죠.",
      "ko": "좌표 네 개가 모두 바뀌죠.",
      "en": "All four coordinates change.",
      "start": 8.783333333333333,
      "end": 10.6,
      "startFrame": 527,
      "endFrame": 636
    },
    {
      "id": "p2-3",
      "lineIndex": 1,
      "spoken": "그런데 물건 사이의 간격은 그대로입니다.",
      "ko": "그런데 물건 사이의\n간격은 그대로입니다.",
      "en": "Their gaps stay the same.",
      "start": 10.916666666666666,
      "end": 13.283333333333333,
      "startFrame": 655,
      "endFrame": 797
    },
    {
      "id": "p3-1",
      "lineIndex": 2,
      "spoken": "그래서 이어진 벨트를 운송 라인으로 묶고,",
      "ko": "그래서 이어진 벨트를\n운송 라인으로 묶고,",
      "en": "Belts are grouped into transport lines.",
      "start": 13.533333333333333,
      "end": 16.083333333333332,
      "startFrame": 812,
      "endFrame": 965
    },
    {
      "id": "p3-2",
      "lineIndex": 2,
      "spoken": "물건의 위치 대신 간격을 저장합니다.",
      "ko": "물건의 위치 대신\n간격을 저장합니다.",
      "en": "Store gaps instead of positions.",
      "start": 16.083333333333332,
      "end": 18.916666666666668,
      "startFrame": 965,
      "endFrame": 1135
    },
    {
      "id": "p4-1",
      "lineIndex": 3,
      "spoken": "같은 속도로 흐를 때는",
      "ko": "같은 속도로 흐를 때는",
      "en": "At a shared speed,",
      "start": 18.966666666666665,
      "end": 20.066666666666666,
      "startFrame": 1138,
      "endFrame": 1204
    },
    {
      "id": "p4-2",
      "lineIndex": 3,
      "spoken": "왼쪽 끝 간격을 하나 늘리고,",
      "ko": "왼쪽 끝 간격을 하나 늘리고,",
      "en": "increase the left end gap by one,",
      "start": 20.066666666666666,
      "end": 21.866666666666667,
      "startFrame": 1204,
      "endFrame": 1312
    },
    {
      "id": "p4-3",
      "lineIndex": 3,
      "spoken": "오른쪽은 하나 줄이면 됩니다.",
      "ko": "오른쪽은 하나 줄이면 됩니다.",
      "en": "and decrease the right gap by one.",
      "start": 21.866666666666667,
      "end": 23.933333333333334,
      "startFrame": 1312,
      "endFrame": 1436
    },
    {
      "id": "p4-4",
      "lineIndex": 3,
      "spoken": "가운데 간격은 건드리지 않아요.",
      "ko": "가운데 간격은 건드리지 않아요.",
      "en": "Internal gaps stay unchanged.",
      "start": 24.533333333333335,
      "end": 26.3,
      "startFrame": 1472,
      "endFrame": 1578
    },
    {
      "id": "p5-1",
      "lineIndex": 4,
      "spoken": "앞이 막히면 어떨까요?",
      "ko": "앞이 막히면 어떨까요?",
      "en": "What if the output is blocked?",
      "start": 26.466666666666665,
      "end": 27.783333333333335,
      "startFrame": 1588,
      "endFrame": 1667
    },
    {
      "id": "p5-2",
      "lineIndex": 4,
      "spoken": "맨 앞의 빈틈이 없어지고,",
      "ko": "맨 앞의 빈틈이 없어지고,",
      "en": "The end gap closes.",
      "start": 27.783333333333335,
      "end": 29.383333333333333,
      "startFrame": 1667,
      "endFrame": 1763
    },
    {
      "id": "p5-3",
      "lineIndex": 4,
      "spoken": "뒤따르던 물건들이 붙으면서",
      "ko": "뒤따르던 물건들이 붙으면서",
      "en": "Following items pack together,",
      "start": 29.383333333333333,
      "end": 31.033333333333335,
      "startFrame": 1763,
      "endFrame": 1862
    },
    {
      "id": "p5-4",
      "lineIndex": 4,
      "spoken": "내부 간격이 줄어듭니다.",
      "ko": "내부 간격이 줄어듭니다.",
      "en": "shrinking internal gaps.",
      "start": 31.033333333333335,
      "end": 32.61666666666667,
      "startFrame": 1862,
      "endFrame": 1957
    },
    {
      "id": "p6-1",
      "lineIndex": 5,
      "spoken": "이때는 진행 방향에서 가장 앞에 남은 빈틈을 기억해,",
      "ko": "진행 방향에서 가장 앞에 남은 빈틈을 기억해,",
      "en": "Remember the last nonzero gap,",
      "start": 32.8,
      "end": 36.03333333333333,
      "startFrame": 1968,
      "endFrame": 2162
    },
    {
      "id": "p6-2",
      "lineIndex": 5,
      "spoken": "매번 처음부터 찾지 않죠.",
      "ko": "매번 처음부터 찾지 않죠.",
      "en": "instead of searching from the start.",
      "start": 36.03333333333333,
      "end": 38.166666666666664,
      "startFrame": 2162,
      "endFrame": 2290
    },
    {
      "id": "p6-3",
      "lineIndex": 5,
      "spoken": "물건을 넣거나 빼는 동작은 따로 처리합니다.",
      "ko": "물건을 넣거나 빼는 동작은\n따로 처리합니다.",
      "en": "Insertion and removal need extra handling.",
      "start": 38.4,
      "end": 41.083333333333336,
      "startFrame": 2304,
      "endFrame": 2465
    },
    {
      "id": "p7-1",
      "lineIndex": 6,
      "spoken": "화면에는 같은 물건이 움직입니다.",
      "ko": "화면에는 같은 물건이 움직입니다.",
      "en": "The same items still move on screen.",
      "start": 41.18333333333333,
      "end": 43.06666666666667,
      "startFrame": 2471,
      "endFrame": 2584
    },
    {
      "id": "p7-2",
      "lineIndex": 6,
      "spoken": "바뀌는 정보만 고쳐서,",
      "ko": "바뀌는 정보만 고쳐서,",
      "en": "Update only changing information",
      "start": 43.21666666666667,
      "end": 44.61666666666667,
      "startFrame": 2593,
      "endFrame": 2677
    },
    {
      "id": "p7-3",
      "lineIndex": 6,
      "spoken": "큰 공장의 계산을 줄이는 거예요.",
      "ko": "큰 공장의 계산을 줄이는 거예요.",
      "en": "to reduce factory calculations.",
      "start": 44.61666666666667,
      "end": 46.38333333333333,
      "startFrame": 2677,
      "endFrame": 2783
    }
  ]
