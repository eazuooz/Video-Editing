  "cues": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "디아블로 투 레저렉션,",
      "ko": "디아블로 II: 레저렉션,",
      "en": "Diablo II: Resurrected.",
      "start": 0.2,
      "end": 1.9,
      "startFrame": 12,
      "endFrame": 114
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "화면을 더 넓히면 무조건 좋을까요?",
      "ko": "화면을 더 넓히면 무조건 좋을까요?",
      "en": "Is a wider screen always better?",
      "start": 1.9,
      "end": 3.933333333333333,
      "startFrame": 114,
      "endFrame": 236
    },
    {
      "lineIndex": 1,
      "id": "p2-1",
      "spoken": "이천이십일 년 테스트에서는",
      "ko": "2021년 테스트에서는",
      "en": "In the 2021 test,",
      "start": 4.2,
      "end": 5.566666666666666,
      "startFrame": 252,
      "endFrame": 334
    },
    {
      "lineIndex": 1,
      "id": "p2-1b",
      "spoken": "화면을 스물하나 대 아홉까지 넓혔습니다.",
      "ko": "화면을 21:9까지 넓혔습니다.",
      "en": "the view widened to 21:9.",
      "start": 5.566666666666666,
      "end": 8.5,
      "startFrame": 334,
      "endFrame": 510
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "캐릭터와 몬스터는 그대로 두고,",
      "ko": "캐릭터와 몬스터는 그대로 두고,",
      "en": "Keep the player and monster in place.",
      "start": 8.683333333333334,
      "end": 10.433333333333334,
      "startFrame": 521,
      "endFrame": 626
    },
    {
      "id": "p2-3",
      "lineIndex": 1,
      "spoken": "화면만 옆으로 넓히면 더 먼 적이 보이죠.",
      "ko": "화면만 옆으로 넓히면 더 먼 적이 보이죠.",
      "en": "A wider view reveals a distant enemy.",
      "start": 10.433333333333334,
      "end": 13.333333333333334,
      "startFrame": 626,
      "endFrame": 800
    },
    {
      "id": "p3-1",
      "lineIndex": 2,
      "spoken": "하지만 화면에 보이는 범위와,",
      "ko": "하지만 화면에 보이는 범위와,",
      "en": "But what the player can see",
      "start": 13.666666666666666,
      "end": 15.216666666666667,
      "startFrame": 820,
      "endFrame": 913
    },
    {
      "lineIndex": 2,
      "id": "p3-2",
      "spoken": "몬스터가 플레이어에게 반응하는 범위는",
      "ko": "몬스터가 플레이어에게 반응하는 범위는",
      "en": "and the monster's reaction range",
      "start": 15.216666666666667,
      "end": 17.633333333333333,
      "startFrame": 913,
      "endFrame": 1058
    },
    {
      "lineIndex": 2,
      "id": "p3-2b",
      "spoken": "다른 규칙입니다.",
      "ko": "다른 규칙입니다.",
      "en": "follow separate rules.",
      "start": 17.633333333333333,
      "end": 18.583333333333332,
      "startFrame": 1058,
      "endFrame": 1115
    },
    {
      "id": "p4-1",
      "lineIndex": 3,
      "spoken": "당시에는 넓어진 화면 끝의 적을 공격할 수 있었지만,",
      "ko": "당시에는 넓어진 화면 끝의 적을 공격할 수 있었지만,",
      "en": "Players could hit those distant enemies,",
      "start": 18.783333333333335,
      "end": 22.033333333333335,
      "startFrame": 1127,
      "endFrame": 1322
    },
    {
      "id": "p4-2",
      "lineIndex": 3,
      "spoken": "그 거리에서는 적의 반응이 시작되지 않았어요.",
      "ko": "그 거리에서는 적의 반응이 시작되지 않았어요.",
      "en": "but the enemies did not react at that distance.",
      "start": 22.033333333333335,
      "end": 24.766666666666666,
      "startFrame": 1322,
      "endFrame": 1486
    },
    {
      "id": "p4-3",
      "lineIndex": 3,
      "spoken": "보이니까 쏠 수 있는데, 맞는 쪽은 가만히 있었던 거죠.",
      "ko": "보이니까 쏠 수 있는데, 맞는 쪽은 가만히 있었던 거죠.",
      "en": "You could fire; the target stayed passive.",
      "start": 25.033333333333335,
      "end": 28.116666666666667,
      "startFrame": 1502,
      "endFrame": 1687
    },
    {
      "lineIndex": 4,
      "id": "p5-1",
      "spoken": "그래서 개발진은 출시 때",
      "ko": "그래서 개발진은 출시 때",
      "en": "For release, the team",
      "start": 28.116666666666667,
      "end": 29.816666666666666,
      "startFrame": 1687,
      "endFrame": 1789
    },
    {
      "lineIndex": 4,
      "id": "p5-1b",
      "spoken": "보이는 폭을 십구 대 구로 제한했습니다.",
      "ko": "보이는 폭을 19:9로 제한했습니다.",
      "en": "limited the view to 19:9.",
      "start": 29.816666666666666,
      "end": 32.61666666666667,
      "startFrame": 1789,
      "endFrame": 1957
    },
    {
      "id": "p5-2",
      "lineIndex": 4,
      "spoken": "화면 양옆을 어둡게 처리해서,",
      "ko": "화면 양옆을 어둡게 처리해서,",
      "en": "Darkened edges kept the view",
      "start": 32.833333333333336,
      "end": 34.71666666666667,
      "startFrame": 1970,
      "endFrame": 2083
    },
    {
      "id": "p5-3",
      "lineIndex": 4,
      "spoken": "기존 전투 규칙이 감당하는 범위에 맞춘 거예요.",
      "ko": "기존 전투 규칙이 감당하는 범위에 맞춘 거예요.",
      "en": "within the limits of the established combat rules.",
      "start": 34.71666666666667,
      "end": 37.81666666666667,
      "startFrame": 2083,
      "endFrame": 2269
    },
    {
      "id": "p6-1",
      "lineIndex": 5,
      "spoken": "더 넓게 보여 주는 기능도,",
      "ko": "더 넓게 보여 주는 기능도,",
      "en": "Even a wider display option",
      "start": 38.0,
      "end": 39.63333333333333,
      "startFrame": 2280,
      "endFrame": 2378
    },
    {
      "lineIndex": 5,
      "id": "p6-2",
      "spoken": "게임 속 적이 반응하는 방식까지",
      "ko": "게임 속 적이 반응하는 방식까지",
      "en": "had to account for enemy reactions",
      "start": 39.63333333333333,
      "end": 41.78333333333333,
      "startFrame": 2378,
      "endFrame": 2507
    },
    {
      "lineIndex": 5,
      "id": "p6-2b",
      "spoken": "함께 설계해야 했던 겁니다.",
      "ko": "함께 설계해야 했던 겁니다.",
      "en": "in its design.",
      "start": 41.78333333333333,
      "end": 43.416666666666664,
      "startFrame": 2507,
      "endFrame": 2605
    }
  ]
