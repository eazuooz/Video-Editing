  "cues": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "작은 물건을 집었는데,",
      "ko": "작은 물건을 집었는데,",
      "en": "Pick up a small object.",
      "start": 0.2,
      "end": 1.4166666666666667,
      "startFrame": 12,
      "endFrame": 85
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "내려놓으니 거대해집니다.",
      "ko": "내려놓으니 거대해집니다.",
      "en": "Put it down, and it is enormous.",
      "start": 1.4166666666666667,
      "end": 3.2,
      "startFrame": 85,
      "endFrame": 192
    },
    {
      "id": "p1-3",
      "lineIndex": 0,
      "spoken": "슈퍼리미널의 비밀은 뭘까요?",
      "ko": "슈퍼리미널의 비밀은 뭘까요?",
      "en": "What is Superliminal doing?",
      "start": 3.4166666666666665,
      "end": 5.3,
      "startFrame": 205,
      "endFrame": 318
    },
    {
      "id": "p2-1",
      "lineIndex": 1,
      "spoken": "멀리 있는 물체는 작게 보이죠.",
      "ko": "멀리 있는 물체는 작게 보이죠.",
      "en": "Distant objects normally look smaller.",
      "start": 5.566666666666666,
      "end": 7.4,
      "startFrame": 334,
      "endFrame": 444
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "여기서는 멀리 옮길수록",
      "ko": "여기서는 멀리 옮길수록",
      "en": "Here, moving an object farther away",
      "start": 7.533333333333333,
      "end": 9.166666666666666,
      "startFrame": 452,
      "endFrame": 550
    },
    {
      "id": "p2-3",
      "lineIndex": 1,
      "spoken": "물체 자체를 키웁니다.",
      "ko": "물체 자체를 키웁니다.",
      "en": "also makes it physically larger.",
      "start": 9.166666666666666,
      "end": 10.633333333333333,
      "startFrame": 550,
      "endFrame": 638
    },
    {
      "id": "p3-1",
      "lineIndex": 2,
      "spoken": "거리가 두 미터에서 여섯 미터로,",
      "ko": "거리가 2m에서 6m로,",
      "en": "Move it from 2 metres to 6 metres:",
      "start": 10.866666666666667,
      "end": 12.7,
      "startFrame": 652,
      "endFrame": 762
    },
    {
      "id": "p3-2",
      "lineIndex": 2,
      "spoken": "세 배가 되면,",
      "ko": "세 배가 되면,",
      "en": "three times farther,",
      "emphasis": {
        "text": "세 배",
        "role": "result"
      },
      "start": 12.7,
      "end": 13.366666666666667,
      "startFrame": 762,
      "endFrame": 802
    },
    {
      "id": "p3-3",
      "lineIndex": 2,
      "spoken": "물체의 크기도 세 배로 키우는 거예요.",
      "ko": "물체의 크기도 세 배로 키우는 거예요.",
      "en": "and three times larger.",
      "emphasis": {
        "text": "세 배",
        "role": "result"
      },
      "start": 13.366666666666667,
      "end": 15.566666666666666,
      "startFrame": 802,
      "endFrame": 934
    },
    {
      "id": "p4-1",
      "lineIndex": 3,
      "spoken": "그러면 화면에서 보이는 크기는 같아도,",
      "ko": "그러면 화면에서 보이는 크기는 같아도,",
      "en": "Its apparent size stays the same,",
      "start": 15.783333333333333,
      "end": 17.833333333333332,
      "startFrame": 947,
      "endFrame": 1070
    },
    {
      "id": "p4-2",
      "lineIndex": 3,
      "spoken": "옆에서 보면",
      "ko": "옆에서 보면",
      "en": "but viewed from the side,",
      "start": 17.833333333333332,
      "end": 18.7,
      "startFrame": 1070,
      "endFrame": 1122
    },
    {
      "id": "p4-3",
      "lineIndex": 3,
      "spoken": "물체가 정말 커져 있습니다.",
      "ko": "물체가 정말 커져 있습니다.",
      "en": "the object really has grown.",
      "start": 18.7,
      "end": 20.483333333333334,
      "startFrame": 1122,
      "endFrame": 1229
    },
    {
      "id": "p5-1",
      "lineIndex": 4,
      "spoken": "이 기법의 이름은 강제 원근입니다.",
      "ko": "이 기법의 이름은 강제 원근입니다.",
      "en": "This technique is called forced perspective.",
      "emphasis": {
        "text": "강제 원근",
        "role": "term"
      },
      "start": 20.7,
      "end": 23.216666666666665,
      "startFrame": 1242,
      "endFrame": 1393
    },
    {
      "id": "p5-2",
      "lineIndex": 4,
      "spoken": "화면에 보이는 크기를 이용한 착시죠.",
      "ko": "화면에 보이는 크기를 이용한 착시죠.",
      "en": "It uses apparent size to create an illusion.",
      "start": 23.516666666666666,
      "end": 25.483333333333334,
      "startFrame": 1411,
      "endFrame": 1529
    },
    {
      "id": "p5-3",
      "lineIndex": 4,
      "spoken": "게임은 물체의 보이는 표면에 여러 광선을 쏴,",
      "ko": "게임은 물체의 보이는 표면에 여러 광선을 쏴,",
      "en": "The game casts rays across the visible surface",
      "start": 25.483333333333334,
      "end": 28.416666666666668,
      "startFrame": 1529,
      "endFrame": 1705
    },
    {
      "id": "p5-4",
      "lineIndex": 4,
      "spoken": "벽과 부딪히지 않는 위치를 찾습니다.",
      "ko": "벽과 부딪히지 않는 위치를 찾습니다.",
      "en": "to find a position that fits without collision.",
      "start": 28.416666666666668,
      "end": 31.0,
      "startFrame": 1705,
      "endFrame": 1860
    },
    {
      "id": "p6-1",
      "lineIndex": 5,
      "spoken": "물체를 놓으면 바뀐 크기가 실제 공간에 남습니다.",
      "ko": "물체를 놓으면 바뀐 크기가 실제 공간에 남습니다.",
      "en": "Release the object, and its changed size remains.",
      "start": 31.233333333333334,
      "end": 34.7,
      "startFrame": 1874,
      "endFrame": 2082
    },
    {
      "id": "p6-2",
      "lineIndex": 5,
      "spoken": "거대해진 물건을 밟고,",
      "ko": "거대해진 물건을 밟고,",
      "en": "Step onto the enlarged object",
      "start": 34.916666666666664,
      "end": 36.3,
      "startFrame": 2095,
      "endFrame": 2178
    },
    {
      "id": "p6-3",
      "lineIndex": 5,
      "spoken": "높은 출구로 올라갈 수 있죠.",
      "ko": "높은 출구로 올라갈 수 있죠.",
      "en": "to reach a high exit.",
      "start": 36.3,
      "end": 38.083333333333336,
      "startFrame": 2178,
      "endFrame": 2285
    },
    {
      "id": "p7-1",
      "lineIndex": 6,
      "spoken": "보이는 크기를 유지한 채",
      "ko": "보이는 크기를 유지한 채",
      "en": "Keep its apparent size,",
      "start": 38.266666666666666,
      "end": 39.7,
      "startFrame": 2296,
      "endFrame": 2382
    },
    {
      "id": "p7-2",
      "lineIndex": 6,
      "spoken": "거리와 실제 크기를 함께 바꾸면,",
      "ko": "거리와 실제 크기를 함께 바꾸면,",
      "en": "change distance and physical size together,",
      "start": 39.7,
      "end": 41.93333333333333,
      "startFrame": 2382,
      "endFrame": 2516
    },
    {
      "id": "p7-3",
      "lineIndex": 6,
      "spoken": "원근법이 퍼즐의 규칙이 되는 겁니다.",
      "ko": "원근법이 퍼즐의 규칙이 되는 겁니다.",
      "en": "and perspective becomes a puzzle rule.",
      "start": 41.93333333333333,
      "end": 44.53333333333333,
      "startFrame": 2516,
      "endFrame": 2672
    }
  ]
