  "cues": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "이 게임, 버튼 하나로 옛날 그래픽을 볼 수 있습니다.",
      "ko": "이 게임, 버튼 하나로 옛날 그래픽을 볼 수 있습니다.",
      "en": "One button restores the classic look.",
      "start": 0.2,
      "end": 3.716666666666667,
      "startFrame": 12,
      "endFrame": 223
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "전투는 그대로고요.",
      "ko": "전투는 그대로고요.",
      "en": "The battle keeps going.",
      "start": 3.9166666666666665,
      "end": 5.133333333333334,
      "startFrame": 235,
      "endFrame": 308
    },
    {
      "id": "p2-1",
      "lineIndex": 1,
      "spoken": "게임에는 두 가지 일이 있습니다.",
      "ko": "게임에는 두 가지 일이 있습니다.",
      "en": "A game has two different jobs.",
      "start": 5.366666666666666,
      "end": 7.016666666666667,
      "startFrame": 322,
      "endFrame": 421
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "위치와 공격 결과를 계산하는 일,",
      "ko": "위치와 공격 결과를 계산하는 일,",
      "en": "One calculates positions and attack results.",
      "start": 7.233333333333333,
      "end": 9.466666666666667,
      "startFrame": 434,
      "endFrame": 568
    },
    {
      "id": "p2-3",
      "lineIndex": 1,
      "spoken": "그 결과를 화면에 그리는 일이죠.",
      "ko": "그 결과를 화면에 그리는 일이죠.",
      "en": "The other draws those results on screen.",
      "start": 9.466666666666667,
      "end": 11.416666666666666,
      "startFrame": 568,
      "endFrame": 685
    },
    {
      "id": "p3-1",
      "lineIndex": 2,
      "spoken": "디아블로 투 레저렉션은 기존 게임의 동작 위에,",
      "ko": "디아블로 II 레저렉션은 기존 게임의 동작 위에,",
      "en": "D2R builds on the original game.",
      "start": 11.6,
      "end": 14.916666666666666,
      "startFrame": 696,
      "endFrame": 895
    },
    {
      "id": "p3-2",
      "lineIndex": 2,
      "spoken": "새 삼차원 그래픽을 그리는 층을 얹었습니다.",
      "ko": "새 3D 그래픽을 그리는 층을 얹었습니다.",
      "en": "A new layer renders it in 3D.",
      "start": 14.916666666666666,
      "end": 17.783333333333335,
      "startFrame": 895,
      "endFrame": 1067
    },
    {
      "id": "p3-3",
      "lineIndex": 2,
      "spoken": "위치와 행동을 받아 새 모델로 보여주는 거예요.",
      "ko": "위치와 행동을 받아 새 모델로 보여주는 거예요.",
      "en": "It presents positions and actions using new models.",
      "start": 18.033333333333335,
      "end": 20.616666666666667,
      "startFrame": 1082,
      "endFrame": 1237
    },
    {
      "id": "p4-1",
      "lineIndex": 3,
      "spoken": "우리 그림에서 캐릭터가 한 칸 움직이면,",
      "ko": "우리 그림에서 캐릭터가 한 칸 움직이면,",
      "en": "In our diagram, move the character one cell.",
      "start": 20.8,
      "end": 22.9,
      "startFrame": 1248,
      "endFrame": 1374
    },
    {
      "id": "p4-2",
      "lineIndex": 3,
      "spoken": "옛 모습과 새 모습이 같은 위치를 따라갑니다.",
      "ko": "옛 모습과 새 모습이 같은 위치를 따라갑니다.",
      "en": "Both appearances follow the same position.",
      "start": 22.9,
      "end": 26.216666666666665,
      "startFrame": 1374,
      "endFrame": 1573
    },
    {
      "id": "p4-3",
      "lineIndex": 3,
      "spoken": "그리는 방식이 달라져도, 움직임의 기준은 하나죠.",
      "ko": "그리는 방식이 달라져도, 움직임의 기준은 하나죠.",
      "en": "Different looks share one game state.",
      "start": 26.516666666666666,
      "end": 29.916666666666668,
      "startFrame": 1591,
      "endFrame": 1795
    },
    {
      "id": "p5-1",
      "lineIndex": 4,
      "spoken": "그래서 화면을 바꾸어도,",
      "ko": "그래서 화면을 바꾸어도,",
      "en": "That is why switching the view",
      "start": 30.2,
      "end": 31.5,
      "startFrame": 1812,
      "endFrame": 1890
    },
    {
      "id": "p5-2",
      "lineIndex": 4,
      "spoken": "캐릭터와 몬스터의 상태가 처음으로 돌아가지 않습니다.",
      "ko": "캐릭터와 몬스터의 상태가 처음으로 돌아가지 않습니다.",
      "en": "does not reset the characters or monsters.",
      "start": 31.5,
      "end": 34.766666666666666,
      "startFrame": 1890,
      "endFrame": 2086
    },
    {
      "id": "p5-3",
      "lineIndex": 4,
      "spoken": "같은 게임 상태를 다른 모습으로 보는 거예요.",
      "ko": "같은 게임 상태를 다른 모습으로 보는 거예요.",
      "en": "One game state, another presentation.",
      "start": 34.983333333333334,
      "end": 37.21666666666667,
      "startFrame": 2099,
      "endFrame": 2233
    },
    {
      "id": "p6-1",
      "lineIndex": 5,
      "spoken": "이것이 게임 로직과 렌더링의 분리입니다.",
      "ko": "이것이 게임 로직과 렌더링의 분리입니다.",
      "en": "This is separation of game logic and rendering.",
      "start": 37.46666666666667,
      "end": 40.06666666666667,
      "startFrame": 2248,
      "endFrame": 2404
    },
    {
      "id": "p6-2",
      "lineIndex": 5,
      "spoken": "익숙한 게임의 동작 위에, 새로운 화면을 입힌 거죠.",
      "ko": "익숙한 게임의 동작 위에, 새로운 화면을 입힌 거죠.",
      "en": "A new visual layer wraps familiar gameplay.",
      "start": 40.21666666666667,
      "end": 43.21666666666667,
      "startFrame": 2413,
      "endFrame": 2593
    }
  ],
