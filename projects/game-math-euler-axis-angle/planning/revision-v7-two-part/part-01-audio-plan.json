  "scenes": [
    {
      "id": "v7-a01",
      "title": "누운 돛 하나에서 시작하는 회전 이야기",
      "paragraphCount": 4,
      "speechCharacters": 275,
      "textSha256": "9ff37a718a0a98ba3e91667e08ddaaf19b9b18e74301ac7096ae578d1b5dadca",
      "output": "projects/game-math-euler-axis-angle/production/local/revision-v7-part1/audio/chunks/v7-a01-scene.wav",
      "byteEquivalentPriorWholeScene": null,
      "newContinuousSceneRequired": true
    },
    {
      "id": "v7-a02",
      "title": "물가로 옮겨도 돛은 아직 누워 있다",
      "paragraphCount": 9,
      "speechCharacters": 1077,
      "textSha256": "a760bd7f147c9f8de3c0f4ea55897fba7cf1c282c845585abc9439c438d849df",
      "output": "projects/game-math-euler-axis-angle/production/local/revision-v7-part1/audio/chunks/v7-a02-scene.wav",
      "byteEquivalentPriorWholeScene": null,
      "newContinuousSceneRequired": true
    },
    {
      "id": "v7-a03",
      "title": "돌릴 축을 골랐다면 양의 방향도 정해야 한다",
      "paragraphCount": 7,
      "speechCharacters": 750,
      "textSha256": "51b4e632803fb57afe6dc8e12906d2db7ddb52c5068bef60ad3ff2ce3ef0b21d",
      "output": "projects/game-math-euler-axis-angle/production/local/revision-v7-part1/audio/chunks/v7-a03-scene.wav",
      "byteEquivalentPriorWholeScene": null,
      "newContinuousSceneRequired": true
    },
    {
      "id": "v7-a04",
      "title": "먼저 기수를 돌리면 다음 축도 따라 움직인다",
      "paragraphCount": 6,
      "speechCharacters": 570,
      "textSha256": "9642a391ce16a4a33ae205dfa16151f2bdc5533611cca4b58e8fc5d36a9eb883",
      "output": "projects/game-math-euler-axis-angle/production/local/revision-v7-part1/audio/chunks/v7-a04-scene.wav",
      "byteEquivalentPriorWholeScene": null,
      "newContinuousSceneRequired": true
    },
    {
      "id": "v7-a05",
      "title": "숙이는 방향은 돌아간 날개가 정한다",
      "paragraphCount": 7,
      "speechCharacters": 662,
      "textSha256": "d85584cc6f332143616fd3cb82fdd4fd89b21e686f82a75cd11c7c9ae1080bc6",
      "output": "projects/game-math-euler-axis-angle/production/local/revision-v7-part1/audio/chunks/v7-a05-scene.wav",
      "byteEquivalentPriorWholeScene": null,
      "newContinuousSceneRequired": true
    },
    {
      "id": "v7-a06",
      "title": "같은 쪽을 바라봐도 날개는 다르게 기울 수 있다",
      "paragraphCount": 6,
      "speechCharacters": 560,
      "textSha256": "37d16e17d550e62d877756b1d74152a3bf45566be7aa1c4bdc97f6196667115c",
      "output": "projects/game-math-euler-axis-angle/production/local/revision-v7-part1/audio/chunks/v7-a06-scene.wav",
      "byteEquivalentPriorWholeScene": null,
      "newContinuousSceneRequired": true
    },
    {
      "id": "v7-a07",
      "title": "같은 회전이 반대로 보이는 까닭",
      "paragraphCount": 6,
      "speechCharacters": 542,
      "textSha256": "80ec27c149c102b9213511f4533bbf5545697240813c87a3711b2cb9ac8d2516",
      "output": "projects/game-math-euler-axis-angle/production/local/revision-v7-part1/audio/chunks/v7-a07-scene.wav",
      "byteEquivalentPriorWholeScene": null,
      "newContinuousSceneRequired": true
    },
    {
      "id": "v7-a08",
      "title": "카트의 앞쪽과 위쪽을 따로 따라가면",
      "paragraphCount": 7,
      "speechCharacters": 748,
      "textSha256": "b154572782ad21b5bae8f2f7c1af647072a8383e09a1d14207cbeb0b3b29264e",
      "output": "projects/game-math-euler-axis-angle/production/local/revision-v7-part1/audio/chunks/v7-a08-scene.wav",
      "byteEquivalentPriorWholeScene": null,
      "newContinuousSceneRequired": true
    },
    {
      "id": "v7-a09",
      "title": "이름이 같아도 같은 회전이라는 보장은 없다",
      "paragraphCount": 5,
      "speechCharacters": 467,
      "textSha256": "1bd068aa64f3fb74348b62167db26a66efdabefd1e73f17a687cfae7c9943895",
      "output": "projects/game-math-euler-axis-angle/production/local/revision-v7-part1/audio/chunks/v7-a09-scene.wav",
      "byteEquivalentPriorWholeScene": null,
      "newContinuousSceneRequired": true
    },
    {
      "id": "v7-a10",
      "title": "축을 고정하면 순서를 뒤집어 같은 자세에 도착한다",
      "paragraphCount": 6,
      "speechCharacters": 551,
      "textSha256": "a047daa80fd72c759634c7b981a87158c32ad4fee3556194ce6089c4d341e9ec",
      "output": "projects/game-math-euler-axis-angle/production/local/revision-v7-part1/audio/chunks/v7-a10-scene.wav",
      "byteEquivalentPriorWholeScene": null,
      "newContinuousSceneRequired": true
    },
    {
      "id": "v7-a11",
      "title": "서로 다른 중간 모습이 같은 끝 자세로 모인다",
      "paragraphCount": 6,
      "speechCharacters": 596,
      "textSha256": "7d10365b3f941979a8b98c90b370920e46c17d5f90055d38809c2c8b108d3579",
      "output": "projects/game-math-euler-axis-angle/production/local/revision-v7-part1/audio/chunks/v7-a11-scene.wav",
      "byteEquivalentPriorWholeScene": null,
      "newContinuousSceneRequired": true
    },
    {
      "id": "v7-a12",
      "title": "숙인 비행기에서 요와 헤딩이 갈라진다",
      "paragraphCount": 7,
      "speechCharacters": 693,
      "textSha256": "f19b0ac8e56fece0e6cbb0325bc5da196df5f53064a04d0980b9bf73a4601d8b",
      "output": "projects/game-math-euler-axis-angle/production/local/revision-v7-part1/audio/chunks/v7-a12-scene.wav",
      "byteEquivalentPriorWholeScene": null,
      "newContinuousSceneRequired": true
    },
    {
      "id": "v7-a13",
      "title": "세 숫자는 완성된 물체의 회전 버튼 세 개가 아니다",
      "paragraphCount": 6,
      "speechCharacters": 631,
      "textSha256": "5642fbf80691cdc9c64ef3ebd05e32ddefdc21335003d16d9fc47e379b4adffb",
      "output": "projects/game-math-euler-axis-angle/production/local/revision-v7-part1/audio/chunks/v7-a13-scene.wav",
      "byteEquivalentPriorWholeScene": null,
      "newContinuousSceneRequired": true
    },
    {
      "id": "v7-a14",
      "title": "다른 프로그램의 세 숫자를 그대로 가져오면",
      "paragraphCount": 6,
      "speechCharacters": 736,
      "textSha256": "ff34c84a9d9a226a2069e5077b997851ca424a553052af2ce45a2afcd8366831",
      "output": "projects/game-math-euler-axis-angle/production/local/revision-v7-part1/audio/chunks/v7-a14-scene.wav",
      "byteEquivalentPriorWholeScene": null,
      "newContinuousSceneRequired": true
    },
    {
      "id": "v7-a15",
      "title": "돌리고 붙이는 손동작을 숫자로 읽을 수 있다",
      "paragraphCount": 7,
      "speechCharacters": 755,
      "textSha256": "59e11fc3f93286e476db01d7b4bd17ba8ad6cc0fd1297afdb3f467947369f896",
      "output": "projects/game-math-euler-axis-angle/production/local/revision-v7-part1/audio/chunks/v7-a15-scene.wav",
      "byteEquivalentPriorWholeScene": null,
      "newContinuousSceneRequired": true
    },
    {
      "id": "v7-a16",
      "title": "많은 자세를 저장할 때 세 숫자의 의미",
      "paragraphCount": 8,
      "speechCharacters": 791,
      "textSha256": "2640951b4d80ecc76562cc59cac49e5682ac3b0cf18b277393403fe6be67c025",
      "output": "projects/game-math-euler-axis-angle/production/local/revision-v7-part1/audio/chunks/v7-a16-scene.wav",
      "byteEquivalentPriorWholeScene": null,
      "newContinuousSceneRequired": true
    },
    {
      "id": "v7-a17",
      "title": "어떤 세 숫자든 자세가 되지만 원하는 자세인지는 별개다",
      "paragraphCount": 5,
      "speechCharacters": 532,
      "textSha256": "3959867ea54ec1ee5b270f6b414720b973135404a0e04a9618c45de7c7add673",
      "output": "projects/game-math-euler-axis-angle/production/local/revision-v7-part1/audio/chunks/v7-a17-scene.wav",
      "byteEquivalentPriorWholeScene": null,
      "newContinuousSceneRequired": true
    },
    {
      "id": "v7-a18",
      "title": "한 바퀴 돌아오면 숫자는 달라도 모습은 같다",
      "paragraphCount": 6,
      "speechCharacters": 631,
      "textSha256": "ef7e7905dc56849e64f2d151382a2277b4484a52ee5c02fb292217cf68f8ce14",
      "output": "projects/game-math-euler-axis-angle/production/local/revision-v7-part1/audio/chunks/v7-a18-scene.wav",
      "byteEquivalentPriorWholeScene": null,
      "newContinuousSceneRequired": true
    },
    {
      "id": "v7-a19",
      "title": "대표 범위를 정해도 경계에는 한 가지 일이 더 남는다",
      "paragraphCount": 5,
      "speechCharacters": 442,
      "textSha256": "8d5e93cb172e32e25faac4fdda0f1f91327a0b087aa0e55867e440f0a838b4d4",
      "output": "projects/game-math-euler-axis-angle/production/local/revision-v7-part1/audio/chunks/v7-a19-scene.wav",
      "byteEquivalentPriorWholeScene": null,
      "newContinuousSceneRequired": true
    },
    {
      "id": "v7-a20",
      "title": "두 조절이 같은 축선의 효과를 나눠 맡을 때",
      "paragraphCount": 8,
      "speechCharacters": 766,
      "textSha256": "95f45634f4fa9a1021063669a296cb9946cd441dc06402e49ad77f9621f9d6b2",
      "output": "projects/game-math-euler-axis-angle/production/local/revision-v7-part1/audio/chunks/v7-a20-scene.wav",
      "byteEquivalentPriorWholeScene": null,
      "newContinuousSceneRequired": true
    },
    {
      "id": "v7-a21",
      "title": "자세를 기록해도 움직이는 길은 아직 남아 있다",
      "paragraphCount": 8,
      "speechCharacters": 872,
      "textSha256": "f84fd5b1d3c1a53cadb64da73d1ce4e5ea99ff1c47de866ffa96daefef9c31ce",
      "output": "projects/game-math-euler-axis-angle/production/local/revision-v7-part1/audio/chunks/v7-a21-scene.wav",
      "byteEquivalentPriorWholeScene": null,
      "newContinuousSceneRequired": true
    }
  ],
