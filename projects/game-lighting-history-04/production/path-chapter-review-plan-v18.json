      ],
      "recognition": {
        "path": "projects/game-lighting-history-04/production/local/voice-asr-v2/whole-19.json",
        "sha256": "d41ad625350c2c253f7dae6ed7fbe6d8108e18148c5c070a3fb3c66c2cb0b1f7"
