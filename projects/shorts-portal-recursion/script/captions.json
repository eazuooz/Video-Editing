  "cues": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "포털 안에 또 포털이 보입니다.",
      "ko": "포털 안에 또 포털이 보입니다.",
      "en": "There is another portal inside this portal.",
      "start": 0.2,
      "end": 2.3333333333333335,
      "startFrame": 12,
      "endFrame": 140
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "그러면 화면을",
      "ko": "그러면 화면을",
      "en": "Does the renderer",
      "start": 2.5,
      "end": 3.316666666666667,
      "startFrame": 150,
      "endFrame": 199
    },
    {
      "id": "p1-3",
      "lineIndex": 0,
      "spoken": "무한히 다시 그려야 할까요?",
      "ko": "무한히 다시 그려야 할까요?",
      "en": "have to redraw forever?",
      "start": 3.316666666666667,
      "end": 4.733333333333333,
      "startFrame": 199,
      "endFrame": 284
    },
    {
      "id": "p2-1",
      "lineIndex": 1,
      "spoken": "먼저 포털은,",
      "ko": "먼저 포털은,",
      "en": "A portal shows",
      "start": 5.066666666666666,
      "end": 5.916666666666667,
      "startFrame": 304,
      "endFrame": 355
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "다른 출구 쪽에서 본 풍경을",
      "ko": "다른 출구 쪽에서 본 풍경을",
      "en": "the view from the other exit",
      "start": 5.916666666666667,
      "end": 8.183333333333334,
      "startFrame": 355,
      "endFrame": 491
    },
    {
      "id": "p2-3",
      "lineIndex": 1,
      "spoken": "입구의 구멍 안에 보여줍니다.",
      "ko": "입구의 구멍 안에 보여줍니다.",
      "en": "inside the entrance opening.",
      "start": 8.183333333333334,
      "end": 10.033333333333333,
      "startFrame": 491,
      "endFrame": 602
    },
    {
      "id": "p3-1",
      "lineIndex": 2,
      "spoken": "포털 게임은 스텐실 버퍼를 활용했어요.",
      "ko": "포털 게임은 스텐실 버퍼를 활용했어요.",
      "en": "Portal used a stencil buffer.",
      "emphasis": {
        "text": "스텐실 버퍼",
        "role": "term"
      },
      "start": 10.216666666666667,
      "end": 12.583333333333334,
      "startFrame": 613,
      "endFrame": 755
    },
    {
      "id": "p3-2",
      "lineIndex": 2,
      "spoken": "화면에서 포털 안쪽에 표시를 해 두고,",
      "ko": "화면에서 포털 안쪽에 표시를 해 두고,",
      "en": "Mark the pixels inside the opening",
      "start": 12.783333333333333,
      "end": 14.816666666666666,
      "startFrame": 767,
      "endFrame": 889
    },
    {
      "id": "p3-3",
      "lineIndex": 2,
      "spoken": "그 영역에만 다른 풍경을 그리는 방식입니다.",
      "ko": "그 영역에만 다른 풍경을 그리는 방식입니다.",
      "en": "and draw the other view only in that region.",
      "start": 14.816666666666666,
      "end": 17.716666666666665,
      "startFrame": 889,
      "endFrame": 1063
    },
    {
      "id": "p4-1",
      "lineIndex": 3,
      "spoken": "그 풍경 안에 포털이 또 보이면,",
      "ko": "그 풍경 안에 포털이 또 보이면,",
      "en": "If another portal is visible inside,",
      "start": 17.933333333333334,
      "end": 19.533333333333335,
      "startFrame": 1076,
      "endFrame": 1172
    },
    {
      "id": "p4-2",
      "lineIndex": 3,
      "spoken": "같은 작업을 한 단계 더 합니다.",
      "ko": "같은 작업을 한 단계 더 합니다.",
      "en": "repeat the operation one level deeper.",
      "start": 19.533333333333335,
      "end": 21.583333333333332,
      "startFrame": 1172,
      "endFrame": 1295
    },
    {
      "id": "p4-3",
      "lineIndex": 3,
      "spoken": "이 반복을 재귀 렌더링이라고 해요.",
      "ko": "이 반복을 재귀 렌더링이라고 해요.",
      "en": "This is recursive rendering.",
      "emphasis": {
        "text": "재귀 렌더링",
        "role": "term"
      },
      "start": 21.8,
      "end": 23.966666666666665,
      "startFrame": 1308,
      "endFrame": 1438
    },
    {
      "id": "p5-1",
      "lineIndex": 4,
      "spoken": "우리 시연에서 반복을 한 번에서 세 번으로 늘리면,",
      "ko": "우리 시연에서 반복을 한 번에서 세 번으로 늘리면,",
      "en": "Increase our demo from one level to three:",
      "start": 24.166666666666668,
      "end": 27.016666666666666,
      "startFrame": 1450,
      "endFrame": 1621
    },
    {
      "id": "p5-2",
      "lineIndex": 4,
      "spoken": "안쪽 풍경은 더 깊어지지만,",
      "ko": "안쪽 풍경은 더 깊어지지만,",
      "en": "the view reaches deeper,",
      "start": 27.016666666666666,
      "end": 29.133333333333333,
      "startFrame": 1621,
      "endFrame": 1748
    },
    {
      "id": "p5-3",
      "lineIndex": 4,
      "spoken": "그려야 하는 화면도 늘어납니다.",
      "ko": "그려야 하는 화면도 늘어납니다.",
      "en": "but more views must be rendered.",
      "start": 29.566666666666666,
      "end": 31.416666666666668,
      "startFrame": 1774,
      "endFrame": 1885
    },
    {
      "id": "p6-1",
      "lineIndex": 5,
      "spoken": "실제로 무한 번 계산할 수는 없죠.",
      "ko": "실제로 무한 번 계산할 수는 없죠.",
      "en": "It cannot render infinite views.",
      "start": 31.8,
      "end": 33.983333333333334,
      "startFrame": 1908,
      "endFrame": 2039
    },
    {
      "id": "p6-2",
      "lineIndex": 5,
      "spoken": "반복 깊이와 보이는 범위를 제한해서,",
      "ko": "반복 깊이와 보이는 범위를 제한해서,",
      "en": "Limit recursion depth and the visible region",
      "start": 34.333333333333336,
      "end": 36.4,
      "startFrame": 2060,
      "endFrame": 2184
    },
    {
      "id": "p6-3",
      "lineIndex": 5,
      "spoken": "필요한 부분만 그립니다.",
      "ko": "필요한 부분만 그립니다.",
      "en": "to draw the parts that matter.",
      "start": 36.8,
      "end": 38.38333333333333,
      "startFrame": 2208,
      "endFrame": 2303
    },
    {
      "id": "p7-1",
      "lineIndex": 6,
      "spoken": "끝없이 이어지는 것처럼 보여도,",
      "ko": "끝없이 이어지는 것처럼 보여도,",
      "en": "It can look endless,",
      "start": 38.53333333333333,
      "end": 40.266666666666666,
      "startFrame": 2312,
      "endFrame": 2416
    },
    {
      "id": "p7-2",
      "lineIndex": 6,
      "spoken": "그 뒤에는 유한한 화면과",
      "ko": "그 뒤에는 유한한 화면과",
      "en": "yet behind it are a finite set of views",
      "start": 40.43333333333333,
      "end": 42.166666666666664,
      "startFrame": 2426,
      "endFrame": 2530
    },
    {
      "id": "p7-3",
      "lineIndex": 6,
      "spoken": "정교한 가리개가 있는 겁니다.",
      "ko": "정교한 가리개가 있는 겁니다.",
      "en": "and carefully restricted drawing regions.",
      "start": 42.166666666666664,
      "end": 44.266666666666666,
      "startFrame": 2530,
      "endFrame": 2656
    }
  ]
}
