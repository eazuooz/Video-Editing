  "cues": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "스타크래프트 투 해병이 여럿 모여 총을 쏩니다.",
      "ko": "스타크래프트 II 해병이 여럿 모여 총을 쏩니다.",
      "en": "A group of StarCraft II Marines fires together.",
      "start": 0.2,
      "end": 3.066666666666667,
      "startFrame": 12,
      "endFrame": 184
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "이걸 더 자연스럽게 보이게 하는 장치 중 하나가,",
      "ko": "이걸 더 자연스럽게 보이게 하는 장치 중 하나가,",
      "en": "One detail that makes this look natural",
      "start": 3.1333333333333333,
      "end": 5.733333333333333,
      "startFrame": 188,
      "endFrame": 344
    },
    {
      "id": "p1-2b",
      "lineIndex": 0,
      "spoken": "발사 간격의 작은 무작위 차이예요.",
      "ko": "발사 간격의 작은 무작위 차이예요.",
      "en": "is tiny random variation in shot intervals.",
      "start": 5.733333333333333,
      "end": 8.216666666666667,
      "startFrame": 344,
      "endFrame": 493
    },
    {
      "id": "p2-1",
      "lineIndex": 1,
      "spoken": "모두 정확히 같은 간격으로 쏘면 어떻게 될까요?",
      "ko": "모두 정확히 같은 간격으로 쏘면 어떻게 될까요?",
      "en": "What if every firing interval matched?",
      "start": 8.316666666666666,
      "end": 11.1,
      "startFrame": 499,
      "endFrame": 666
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "같은 순간에 시작한 총성이 계속 겹쳐서,",
      "ko": "같은 순간에 시작한 총성이 계속 겹쳐서,",
      "en": "Shots that start together keep overlapping,",
      "start": 11.216666666666667,
      "end": 13.716666666666667,
      "startFrame": 673,
      "endFrame": 823
    },
    {
      "id": "p2-2b",
      "lineIndex": 1,
      "spoken": "로봇처럼 딱딱해 보이죠.",
      "ko": "로봇처럼 딱딱해 보이죠.",
      "en": "which looks robotic.",
      "start": 13.716666666666667,
      "end": 15.483333333333333,
      "startFrame": 823,
      "endFrame": 929
    },
    {
      "id": "p3-1",
      "lineIndex": 2,
      "spoken": "우리 시연에서는",
      "ko": "우리 시연에서는",
      "en": "In our demonstration,",
      "start": 15.666666666666666,
      "end": 16.5,
      "startFrame": 940,
      "endFrame": 990
    },
    {
      "id": "p3-1b",
      "lineIndex": 2,
      "spoken": "다음 발사까지 기다리는 시간만 조금 바꿔 봅니다.",
      "ko": "다음 발사까지 기다리는 시간만 조금 바꿔 봅니다.",
      "en": "change only the wait before the next shot.",
      "start": 16.5,
      "end": 19.633333333333333,
      "startFrame": 990,
      "endFrame": 1178
    },
    {
      "id": "p3-2",
      "lineIndex": 2,
      "spoken": "병사의 위치와 목표, 애니메이션은 그대로예요.",
      "ko": "병사의 위치와 목표, 애니메이션은 그대로예요.",
      "en": "Same positions, target, and animation.",
      "start": 19.966666666666665,
      "end": 23.133333333333333,
      "startFrame": 1198,
      "endFrame": 1388
    },
    {
      "id": "p4-1",
      "lineIndex": 3,
      "spoken": "예를 들어 일 초를 기다리는 대신,",
      "ko": "예를 들어 1초를 기다리는 대신,",
      "en": "For example, instead of always waiting one second,",
      "start": 23.133333333333333,
      "end": 25.1,
      "startFrame": 1388,
      "endFrame": 1506
    },
    {
      "id": "p4-2",
      "lineIndex": 3,
      "spoken": "어떤 병사는 영 점 구팔 초,",
      "ko": "어떤 병사는 0.98초,",
      "en": "One soldier waits 0.98 seconds,",
      "start": 25.1,
      "end": 27.533333333333335,
      "startFrame": 1506,
      "endFrame": 1652
    },
    {
      "id": "p4-2b",
      "lineIndex": 3,
      "spoken": "다른 병사는 일 점 영이 초를 기다리는 식입니다.",
      "ko": "다른 병사는 1.02초를 기다립니다.",
      "en": "another waits 1.02 seconds.",
      "start": 27.533333333333335,
      "end": 30.566666666666666,
      "startFrame": 1652,
      "endFrame": 1834
    },
    {
      "id": "p4-3",
      "lineIndex": 3,
      "spoken": "숫자는 원리를 보여 주기 위한 예시예요.",
      "ko": "숫자는 원리를 보여 주기 위한 예시예요.",
      "en": "These numbers are an illustrative example.",
      "start": 30.833333333333332,
      "end": 33.06666666666667,
      "startFrame": 1850,
      "endFrame": 1984
    },
    {
      "id": "p5-1",
      "lineIndex": 4,
      "spoken": "처음엔 함께 쐈어도,",
      "ko": "처음엔 함께 쐈어도,",
      "en": "Even if they start together,",
      "start": 33.31666666666667,
      "end": 34.43333333333333,
      "startFrame": 1999,
      "endFrame": 2066
    },
    {
      "id": "p5-1b",
      "lineIndex": 4,
      "spoken": "여러 번 반복하면 총 쏘는 박자가 조금씩 어긋나죠.",
      "ko": "여러 번 반복하면 총 쏘는 박자가 조금씩 어긋나죠.",
      "en": "repeated shots gradually fall out of sync.",
      "start": 34.43333333333333,
      "end": 38.4,
      "startFrame": 2066,
      "endFrame": 2304
    },
    {
      "id": "p5-2",
      "lineIndex": 4,
      "spoken": "발사 간격의 작은 무작위성이,",
      "ko": "발사 간격의 작은 무작위성이,",
      "en": "Tiny randomness in shot timing",
      "start": 38.8,
      "end": 40.7,
      "startFrame": 2328,
      "endFrame": 2442
    },
    {
      "id": "p5-2b",
      "lineIndex": 4,
      "spoken": "부대 전체의 움직임을 자연스럽게 만듭니다.",
      "ko": "부대 전체의 움직임을 자연스럽게 만듭니다.",
      "en": "makes the whole group look more natural.",
      "start": 40.7,
      "end": 44.06666666666667,
      "startFrame": 2442,
      "endFrame": 2644
    },
    {
      "id": "p6-1",
      "lineIndex": 5,
      "spoken": "스타크래프트 투는 실제로",
      "ko": "스타크래프트 II는 실제로",
      "en": "StarCraft II actually",
      "start": 44.2,
      "end": 45.71666666666667,
      "startFrame": 2652,
      "endFrame": 2743
    },
    {
      "id": "p6-1b",
      "lineIndex": 5,
      "spoken": "해병의 발사 간격에 이런 작은 차이를 둡니다.",
      "ko": "해병의 발사 간격에 이런 작은 차이를 둡니다.",
      "en": "adds such small differences between Marine shots.",
      "start": 45.71666666666667,
      "end": 48.8,
      "startFrame": 2743,
      "endFrame": 2928
    },
    {
      "id": "p6-2",
      "lineIndex": 5,
      "spoken": "똑같은 유닛을 복제해도,",
      "ko": "똑같은 유닛을 복제해도,",
      "en": "Even when units are identical,",
      "start": 48.8,
      "end": 50.46666666666667,
      "startFrame": 2928,
      "endFrame": 3028
    },
    {
      "id": "p6-2b",
      "lineIndex": 5,
      "spoken": "모두 한 박자에 움직이는 느낌을 줄이는 거죠.",
      "ko": "모두 한 박자에 움직이는 느낌을 줄이는 거죠.",
      "en": "they feel less locked to one rhythm.",
      "start": 50.46666666666667,
      "end": 53.4,
      "startFrame": 3028,
      "endFrame": 3204
    }
  ]
