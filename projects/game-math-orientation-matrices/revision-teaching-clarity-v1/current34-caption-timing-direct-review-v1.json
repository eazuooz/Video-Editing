      "finalPixelsReviewed": false
    },
    {
      "cue": 112,
      "scene": "10b",
      "paragraph": 4,
      "ko": "작은 부품을 세로와 가로로 돌려 보는 장면과,",
      "en": "Compare the shot of the small component turning upright and sideways",
      "start": 504.1166666666667,
