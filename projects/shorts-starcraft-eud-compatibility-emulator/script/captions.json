  "cues": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "스타크래프트인데,",
      "ko": "스타크래프트인데,",
      "en": "It is StarCraft,",
      "start": 0.2,
      "end": 1.2166666666666666,
      "startFrame": 12,
      "endFrame": 73
    },
    {
      "id": "p1-1b",
      "lineIndex": 0,
      "spoken": "길을 따라오는 적을 막는 디펜스 게임이 됐죠.",
      "ko": "길을 따라오는 적을 막는 디펜스 게임이 됐죠.",
      "en": "turned into a lane-defense game.",
      "start": 1.2166666666666666,
      "end": 4.183333333333334,
      "startFrame": 73,
      "endFrame": 251
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "이런 유저맵의 자유를 살리려고,",
      "ko": "이런 유저맵의 자유를 살리려고,",
      "en": "To keep this custom-map freedom alive,",
      "start": 4.516666666666667,
      "end": 6.216666666666667,
      "startFrame": 271,
      "endFrame": 373
    },
    {
      "id": "p1-2b",
      "lineIndex": 0,
      "spoken": "블리자드는 에뮬레이터까지 만들었습니다.",
      "ko": "블리자드는 에뮬레이터까지 만들었습니다.",
      "en": "Blizzard even built an emulator.",
      "start": 6.216666666666667,
      "end": 8.983333333333333,
      "startFrame": 373,
      "endFrame": 539
    },
    {
      "id": "p2-1",
      "lineIndex": 1,
      "spoken": "맵에는 조건에 따라",
      "ko": "맵에는 조건에 따라",
      "en": "Maps contain triggers that act",
      "start": 9.383333333333333,
      "end": 10.516666666666667,
      "startFrame": 563,
      "endFrame": 631
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "동작을 실행하는 트리거가 있습니다.",
      "ko": "동작을 실행하는 트리거가 있습니다.",
      "en": "when conditions are met.",
      "start": 10.516666666666667,
      "end": 12.283333333333333,
      "startFrame": 631,
      "endFrame": 737
    },
    {
      "id": "p2-3",
      "lineIndex": 1,
      "spoken": "제작자들은 유닛의 사망 횟수를 읽는 기능으로,",
      "ko": "제작자들은 유닛의 사망 횟수를 읽는 기능으로,",
      "en": "Creators used the unit death-count reader",
      "start": 12.783333333333333,
      "end": 15.283333333333333,
      "startFrame": 767,
      "endFrame": 917
    },
    {
      "id": "p2-4",
      "lineIndex": 1,
      "spoken": "다른 게임 데이터까지 읽어 냈어요.",
      "ko": "다른 게임 데이터까지 읽어 냈어요.",
      "en": "to access other game data.",
      "start": 15.283333333333333,
      "end": 17.566666666666666,
      "startFrame": 917,
      "endFrame": 1054
    },
    {
      "id": "p3-1",
      "lineIndex": 2,
      "spoken": "이유디, 확장 유닛 사망 트리거를 이용한 방식입니다.",
      "ko": "EUD, 확장 유닛 사망 트리거를 이용한 방식입니다.",
      "en": "This uses EUD: Extended Unit Death triggers.",
      "start": 17.833333333333332,
      "end": 20.933333333333334,
      "startFrame": 1070,
      "endFrame": 1256
    },
    {
      "id": "p3-2",
      "lineIndex": 2,
      "spoken": "하지만 같은 틈이 보안 공격에도 쓰일 수 있어서,",
      "ko": "하지만 같은 틈이 보안 공격에도 쓰일 수 있어서,",
      "en": "But that opening could also enable attacks,",
      "start": 21.316666666666666,
      "end": 24.083333333333332,
      "startFrame": 1279,
      "endFrame": 1445
    },
    {
      "id": "p3-2b",
      "lineIndex": 2,
      "spoken": "사용이 막혔죠.",
      "ko": "사용이 막혔죠.",
      "en": "so its use was blocked.",
      "start": 24.083333333333332,
      "end": 25.133333333333333,
      "startFrame": 1445,
      "endFrame": 1508
    },
    {
      "id": "p4-1",
      "lineIndex": 3,
      "spoken": "문제는 그 기능에 기대던 옛 유저맵도",
      "ko": "문제는 그 기능에 기대던 옛 유저맵도",
      "en": "But custom maps that depended on it",
      "start": 25.366666666666667,
      "end": 27.833333333333332,
      "startFrame": 1522,
      "endFrame": 1670
    },
    {
      "id": "p4-1b",
      "lineIndex": 3,
      "spoken": "작동하지 않는다는 겁니다.",
      "ko": "작동하지 않는다는 겁니다.",
      "en": "could no longer work.",
      "start": 27.833333333333332,
      "end": 29.233333333333334,
      "startFrame": 1670,
      "endFrame": 1754
    },
    {
      "id": "p4-2",
      "lineIndex": 3,
      "spoken": "옛 맵의 요청과 새 게임 사이에",
      "ko": "옛 맵의 요청과 새 게임 사이에",
      "en": "Between the old request and the new game,",
      "start": 29.316666666666666,
      "end": 31.7,
      "startFrame": 1759,
      "endFrame": 1902
    },
    {
      "id": "p4-2b",
      "lineIndex": 3,
      "spoken": "통역기를 둔다면 어떨까요?",
      "ko": "통역기를 둔다면 어떨까요?",
      "en": "what if we put a translator?",
      "start": 31.7,
      "end": 33.416666666666664,
      "startFrame": 1902,
      "endFrame": 2005
    },
    {
      "id": "p5-1",
      "lineIndex": 4,
      "spoken": "그 역할이 이유디 에뮬레이터입니다.",
      "ko": "그 역할이 EUD 에뮬레이터입니다.",
      "en": "That is the EUD emulator’s role.",
      "start": 33.6,
      "end": 35.7,
      "startFrame": 2016,
      "endFrame": 2142
    },
    {
      "id": "p5-2",
      "lineIndex": 4,
      "spoken": "옛 맵이 플레이어 이름을 읽어 달라고 하면,",
      "ko": "옛 맵이 플레이어 이름을 읽어 달라고 하면,",
      "en": "If an old map asks to read the player name,",
      "start": 35.93333333333333,
      "end": 38.36666666666667,
      "startFrame": 2156,
      "endFrame": 2302
    },
    {
      "id": "p5-3",
      "lineIndex": 4,
      "spoken": "새 게임에서 그 값을 찾아 주는 식이죠.",
      "ko": "새 게임에서 그 값을 찾아 주는 식이죠.",
      "en": "it retrieves that value from the new game.",
      "start": 38.36666666666667,
      "end": 41.233333333333334,
      "startFrame": 2302,
      "endFrame": 2474
    },
    {
      "id": "p6-1",
      "lineIndex": 5,
      "spoken": "패치 일 점 이일 점 영에서는, 일부 옛 이유디 맵이 돌아왔습니다.",
      "ko": "패치 1.21.0에서는, 일부 옛 EUD 맵이 돌아왔습니다.",
      "en": "Patch 1.21.0 brought back some older EUD maps.",
      "start": 41.36666666666667,
      "end": 45.666666666666664,
      "startFrame": 2482,
      "endFrame": 2740
    },
    {
      "id": "p6-2",
      "lineIndex": 5,
      "spoken": "모든 기능을 복원한 건 아니지만,",
      "ko": "모든 기능을 복원한 건 아니지만,",
      "en": "It did not restore every feature,",
      "start": 45.93333333333333,
      "end": 47.483333333333334,
      "startFrame": 2756,
      "endFrame": 2849
    },
    {
      "id": "p6-2b",
      "lineIndex": 5,
      "spoken": "보안을 지키면서",
      "ko": "보안을 지키면서",
      "en": "but it preserved security",
      "start": 47.483333333333334,
      "end": 48.516666666666666,
      "startFrame": 2849,
      "endFrame": 2911
    },
    {
      "id": "p6-2c",
      "lineIndex": 5,
      "spoken": "유저가 만든 놀이를 살린 거예요.",
      "ko": "유저가 만든 놀이를 살린 거예요.",
      "en": "while keeping user-created play alive.",
      "start": 48.516666666666666,
      "end": 50.46666666666667,
      "startFrame": 2911,
      "endFrame": 3028
    }
  ]
}
