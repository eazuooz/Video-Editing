  "cues": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "이렇게 작은 행성을 탐험하는 아우터 와일즈.",
      "ko": "이렇게 작은 행성을 탐험하는 아우터 와일즈.",
      "en": "Outer Wilds has tiny planets to explore.",
      "start": 0.2,
      "end": 2.8833333333333333,
      "startFrame": 12,
      "endFrame": 173
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "개발진은 왜 행성의 중력 공식을 바꿨을까요?",
      "ko": "개발진은 왜 행성의 중력 공식을 바꿨을까요?",
      "en": "Why did its developers change their gravity law?",
      "start": 2.8833333333333333,
      "end": 6.1,
      "startFrame": 173,
      "endFrame": 366
    },
    {
      "id": "p2-1",
      "lineIndex": 1,
      "spoken": "현실에서는 행성 중심에서 두 배 멀어지면,",
      "ko": "현실에서는 행성 중심에서 두 배 멀어지면,",
      "en": "Double the distance from the center,",
      "start": 6.366666666666666,
      "end": 9.133333333333333,
      "startFrame": 382,
      "endFrame": 548
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "중력은 사분의 일이 됩니다.",
      "ko": "중력은 사분의 일이 됩니다.",
      "en": "and gravity becomes one quarter as strong.",
      "start": 9.133333333333333,
      "end": 11.133333333333333,
      "startFrame": 548,
      "endFrame": 668
    },
    {
      "id": "p2-3",
      "lineIndex": 1,
      "spoken": "거리의 제곱에 반비례하는, 역제곱 법칙입니다.",
      "ko": "거리의 제곱에 반비례하는, 역제곱 법칙입니다.",
      "en": "That is the inverse-square law.",
      "start": 11.383333333333333,
      "end": 14.3,
      "startFrame": 683,
      "endFrame": 858
    },
    {
      "id": "p3-1",
      "lineIndex": 2,
      "spoken": "지구에서 조금 뛰어오르는 높이는,",
      "ko": "지구에서 조금 뛰어오르는 높이는,",
      "en": "A small jump on Earth",
      "start": 14.516666666666667,
      "end": 16.233333333333334,
      "startFrame": 871,
      "endFrame": 974
    },
    {
      "id": "p3-2",
      "lineIndex": 2,
      "spoken": "지구 반지름에 비하면 아주 작습니다.",
      "ko": "지구 반지름에 비하면 아주 작습니다.",
      "en": "is tiny compared with Earth’s radius.",
      "start": 16.233333333333334,
      "end": 18.8,
      "startFrame": 974,
      "endFrame": 1128
    },
    {
      "id": "p3-3",
      "lineIndex": 2,
      "spoken": "그래서 발밑의 중력이 거의 달라지지 않죠.",
      "ko": "그래서 발밑의 중력이 거의 달라지지 않죠.",
      "en": "Gravity beneath your feet therefore barely changes.",
      "start": 19.233333333333334,
      "end": 21.583333333333332,
      "startFrame": 1154,
      "endFrame": 1295
    },
    {
      "id": "p4-1",
      "lineIndex": 3,
      "spoken": "하지만 아주 작은 행성에서는,",
      "ko": "하지만 아주 작은 행성에서는,",
      "en": "On a very small planet,",
      "start": 21.8,
      "end": 23.183333333333334,
      "startFrame": 1308,
      "endFrame": 1391
    },
    {
      "id": "p4-2",
      "lineIndex": 3,
      "spoken": "같은 높이만 올라가도",
      "ko": "같은 높이만 올라가도",
      "en": "The same rise",
      "start": 23.183333333333334,
      "end": 24.583333333333332,
      "startFrame": 1391,
      "endFrame": 1475
    },
    {
      "id": "p4-2b",
      "lineIndex": 3,
      "spoken": "중심에서의 거리가 크게 늘어납니다.",
      "ko": "중심에서의 거리가 크게 늘어납니다.",
      "en": "greatly increases relative distance.",
      "start": 24.583333333333332,
      "end": 26.816666666666666,
      "startFrame": 1475,
      "endFrame": 1609
    },
    {
      "id": "p4-3",
      "lineIndex": 3,
      "spoken": "중력이 빠르게 약해져,",
      "ko": "중력이 빠르게 약해져,",
      "en": "Gravity weakens quickly,",
      "start": 27.083333333333332,
      "end": 28.3,
      "startFrame": 1625,
      "endFrame": 1698
    },
    {
      "id": "p4-4",
      "lineIndex": 3,
      "spoken": "우주로 벗어나기 쉬워지는 거예요.",
      "ko": "우주로 벗어나기 쉬워지는 거예요.",
      "en": "making escape into space easier.",
      "start": 28.3,
      "end": 30.183333333333334,
      "startFrame": 1698,
      "endFrame": 1811
    },
    {
      "id": "p5-1",
      "lineIndex": 4,
      "spoken": "우리 비교 시연은 행성 크기와",
      "ko": "우리 비교 시연은 행성 크기와",
      "en": "Our demo fixes planet size",
      "start": 30.2,
      "end": 32.46666666666667,
      "startFrame": 1812,
      "endFrame": 1948
    },
    {
      "id": "p5-1b",
      "lineIndex": 4,
      "spoken": "출발 속도를 같게 두었습니다.",
      "ko": "출발 속도를 같게 두었습니다.",
      "en": "and launch speed.",
      "start": 32.46666666666667,
      "end": 34.583333333333336,
      "startFrame": 1948,
      "endFrame": 2075
    },
    {
      "id": "p5-2",
      "lineIndex": 4,
      "spoken": "거리와 함께 중력이 약해지는 방식만 바꾸면,",
      "ko": "거리와 함께 중력이 약해지는 방식만 바꾸면,",
      "en": "Change only gravity’s falloff with distance:",
      "start": 34.916666666666664,
      "end": 37.68333333333333,
      "startFrame": 2095,
      "endFrame": 2261
    },
    {
      "id": "p5-3",
      "lineIndex": 4,
      "spoken": "한쪽은 멀리 떠나고 다른 쪽은 다시 돌아옵니다.",
      "ko": "한쪽은 멀리 떠나고 다른 쪽은 다시 돌아옵니다.",
      "en": "one object travels away while the other returns.",
      "start": 37.68333333333333,
      "end": 40.5,
      "startFrame": 2261,
      "endFrame": 2430
    },
    {
      "id": "p6-1",
      "lineIndex": 5,
      "spoken": "아우터 와일즈 개발진도 작은 행성에서",
      "ko": "아우터 와일즈 개발진도 작은 행성에서",
      "en": "On their tiny planets, the developers of Outer Wilds",
      "start": 40.733333333333334,
      "end": 43.18333333333333,
      "startFrame": 2444,
      "endFrame": 2591
    },
    {
      "id": "p6-2",
      "lineIndex": 5,
      "spoken": "너무 쉽게 탈출 속도에 도달하는 문제를 겪었습니다.",
      "ko": "너무 쉽게 탈출 속도에 도달하는 문제를 겪었습니다.",
      "en": "escape velocity was too easy to reach.",
      "start": 43.18333333333333,
      "end": 46.68333333333333,
      "startFrame": 2591,
      "endFrame": 2801
    },
    {
      "id": "p6-3",
      "lineIndex": 5,
      "spoken": "그래서 행성에는 더 완만하게 약해지는 중력을 택했죠.",
      "ko": "그래서 행성에는 더 완만하게 약해지는 중력을 택했죠.",
      "en": "They chose a gentler planetary gravity falloff.",
      "start": 46.983333333333334,
      "end": 50.0,
      "startFrame": 2819,
      "endFrame": 3000
    },
    {
      "id": "p7-1",
      "lineIndex": 6,
      "spoken": "태양에는 역제곱 법칙을 남겼습니다.",
      "ko": "태양에는 역제곱 법칙을 남겼습니다.",
      "en": "The sun kept inverse-square gravity.",
      "start": 50.166666666666664,
      "end": 52.666666666666664,
      "startFrame": 3010,
      "endFrame": 3160
    },
    {
      "id": "p7-2",
      "lineIndex": 6,
      "spoken": "작은 우주를 재미있게 돌아다닐 수 있도록,",
      "ko": "작은 우주를 재미있게 돌아다닐 수 있도록,",
      "en": "To make a small universe fun to explore,",
      "start": 52.86666666666667,
      "end": 55.016666666666666,
      "startFrame": 3172,
      "endFrame": 3301
    },
    {
      "id": "p7-3",
      "lineIndex": 6,
      "spoken": "중력을 어디에 어떻게 적용할지",
      "ko": "중력을 어디에 어떻게 적용할지",
      "en": "choosing how to apply gravity",
      "start": 55.016666666666666,
      "end": 57.38333333333333,
      "startFrame": 3301,
      "endFrame": 3443
    },
    {
      "id": "p7-3b",
      "lineIndex": 6,
      "spoken": "나누어 설계한 겁니다.",
      "ko": "나누어 설계한 겁니다.",
      "en": "to each part of that universe.",
      "start": 57.38333333333333,
      "end": 58.483333333333334,
      "startFrame": 3443,
      "endFrame": 3509
    }
  ]
