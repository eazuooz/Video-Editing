        "pcmSHA256": "5730cf8855ff516191009f61e6dc6dd4c89bcf8f52c5fb0c3d0a7a818303dedf"
      }
    },
    {
      "id": "u014",
      "paragraph": "p005",
      "ko": "그래서 표면이 향하는 방향을 부모 쪽에서 이어 받고 다듬는 별도 계산을 더했습니다.",
      "sourceRaw": {
        "path": "D:\\Github\\VideoEditing\\shared\\output\\original-tech-twelve-20261115\\shorts-returnal-particle-tentacles\\voice-sentence-v2\\chunks\\u014-scene.wav",
        "sha256": "c700ae83c32dad26cbd8383765eb8e1c2a98d4ba376f17eed8c1a51d6ae2845a",
