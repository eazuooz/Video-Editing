        "pcmSHA256": "3ec2fa87358dc35280011f76a0e7fbed33f4a8ced4667333667dd8660486613c"
      }
    },
    {
      "id": "u016",
      "paragraph": "p006",
      "ko": "이 움직임은 적이 공격을 준비할 때 같은 상태 표현에도 연결됩니다.",
      "sourceRaw": {
        "path": "D:\\Github\\VideoEditing\\shared\\output\\original-tech-twelve-20261115\\shorts-returnal-particle-tentacles\\voice-sentence-v2\\chunks\\u016-scene.wav",
        "sha256": "b269cd5cb4acaec951358dbf74c43ff57c5390abc80795569faf2a8c8109a822",
        "frames": 105600,
        "rate": 24000,
        "duration": 4.4,
        "pcmSHA256": "d19127f9f9e28a1f2cfb650af29a41a8cb414c660bca2c782c339b96a06da88f"
      }
    },
    {
      "id": "s6u0171",
      "paragraph": "p006",
      "ko": "아티스트와 애니메이터는 공격을 알아보기 좋게 타이밍을 맞췄습니다.",
      "originUnit": "u017"
    },
    {
      "id": "s6u0181",
      "paragraph": "p006",
      "ko": "부모의 이전 움직임을 따라가는 입자가 있습니다.",
      "originUnit": "u018"
    },
    {
      "id": "s6u0182",
      "paragraph": "p006",
      "ko": "그 둘레의 표면과 함께 촉수의 생동감을 만듭니다.",
      "originUnit": "u018"
    }
  ],
