  "cues": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "디아블로 투 원작의 캐릭터,",
      "ko": "디아블로 II 원작의 캐릭터,",
      "en": "The original Diablo II character:",
      "start": 0.2,
      "end": 2.4833333333333334,
      "startFrame": 12,
      "endFrame": 149
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "갑옷마다 통째로 다시 그렸을까요?",
      "ko": "갑옷마다 통째로 다시 그렸을까요?",
      "en": "redrawn for every armor combination?",
      "start": 2.4833333333333334,
      "end": 4.333333333333333,
      "startFrame": 149,
      "endFrame": 260
    },
    {
      "id": "p2-1",
      "lineIndex": 1,
      "spoken": "개발진은 머리와 몸통, 다리와 양팔,",
      "ko": "개발진은 머리와 몸통, 다리와 양팔,",
      "en": "The team rendered the head, torso, legs and arms,",
      "start": 4.566666666666666,
      "end": 7.533333333333333,
      "startFrame": 274,
      "endFrame": 452
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "무기와 방패를 따로 렌더링했습니다.",
      "ko": "무기와 방패를 따로 렌더링했습니다.",
      "en": "as well as the weapon and shield, separately.",
      "start": 7.533333333333333,
      "end": 9.766666666666667,
      "startFrame": 452,
      "endFrame": 586
    },
    {
      "id": "p2-3",
      "lineIndex": 1,
      "spoken": "입체 모델을 부위별 그림으로 만든 거예요.",
      "ko": "입체 모델을 부위별 그림으로 만든 거예요.",
      "en": "They turned the 3D model into component images.",
      "start": 10.066666666666666,
      "end": 12.4,
      "startFrame": 604,
      "endFrame": 744
    },
    {
      "id": "p3-1",
      "lineIndex": 2,
      "spoken": "우리 캐릭터도 같은 방식으로 나눠 볼게요.",
      "ko": "우리 캐릭터도 같은 방식으로 나눠 볼게요.",
      "en": "Let’s separate our character the same way.",
      "start": 12.6,
      "end": 14.966666666666667,
      "startFrame": 756,
      "endFrame": 898
    },
    {
      "id": "p3-2",
      "lineIndex": 2,
      "spoken": "다른 부위는 유지하고 갑옷 그림만 바꾸면,",
      "ko": "다른 부위는 유지하고 갑옷 그림만 바꾸면,",
      "en": "Keep the other parts and replace the armor image.",
      "start": 15.2,
      "end": 17.683333333333334,
      "startFrame": 912,
      "endFrame": 1061
    },
    {
      "id": "p3-3",
      "lineIndex": 2,
      "spoken": "새 장비를 입은 모습이 됩니다.",
      "ko": "새 장비를 입은 모습이 됩니다.",
      "en": "Now the character wears different equipment.",
      "start": 17.683333333333334,
      "end": 19.966666666666665,
      "startFrame": 1061,
      "endFrame": 1198
    },
    {
      "id": "p4-1",
      "lineIndex": 3,
      "spoken": "움직일 때는 같은 자세에 해당하는 부품들을,",
      "ko": "움직일 때는 같은 자세에 해당하는 부품들을,",
      "en": "Use parts for the same moving pose",
      "start": 20.1,
      "end": 22.8,
      "startFrame": 1206,
      "endFrame": 1368
    },
    {
      "id": "p4-2",
      "lineIndex": 3,
      "spoken": "같은 순서와 위치에 맞춰 겹쳐 그립니다.",
      "ko": "같은 순서와 위치에 맞춰 겹쳐 그립니다.",
      "en": "and layer them at the matching positions.",
      "start": 22.8,
      "end": 25.733333333333334,
      "startFrame": 1368,
      "endFrame": 1544
    },
    {
      "id": "p4-3",
      "lineIndex": 3,
      "spoken": "그래야 팔과 무기가 따로 놀지 않겠죠.",
      "ko": "그래야 팔과 무기가 따로 놀지 않겠죠.",
      "en": "That keeps the arm and weapon moving together.",
      "start": 25.933333333333334,
      "end": 28.183333333333334,
      "startFrame": 1556,
      "endFrame": 1691
    },
    {
      "id": "p5-1",
      "lineIndex": 4,
      "spoken": "이런 부품 조합형 스프라이트는,",
      "ko": "이런 부품 조합형 스프라이트는,",
      "en": "With component-based sprites,",
      "start": 28.183333333333334,
      "end": 30.283333333333335,
      "startFrame": 1691,
      "endFrame": 1817
    },
    {
      "id": "p5-2",
      "lineIndex": 4,
      "spoken": "부위마다 준비한 그림을 다시 조합해서,",
      "ko": "부위마다 준비한 그림을 다시 조합해서,",
      "en": "recombine the images of each part",
      "start": 30.283333333333335,
      "end": 32.766666666666666,
      "startFrame": 1817,
      "endFrame": 1966
    },
    {
      "id": "p5-3",
      "lineIndex": 4,
      "spoken": "여러 장비의 모습을 만들 수 있습니다.",
      "ko": "여러 장비의 모습을 만들 수 있습니다.",
      "en": "to produce multiple equipment appearances.",
      "start": 32.766666666666666,
      "end": 35.21666666666667,
      "startFrame": 1966,
      "endFrame": 2113
    },
    {
      "id": "p6-1",
      "lineIndex": 5,
      "spoken": "겉으로는 한 캐릭터지만,",
      "ko": "겉으로는 한 캐릭터지만,",
      "en": "It looks like one character,",
      "start": 35.4,
      "end": 36.9,
      "startFrame": 2124,
      "endFrame": 2214
    },
    {
      "lineIndex": 5,
      "id": "p6-2",
      "spoken": "속에서는 여러 그림이",
      "ko": "속에서는 여러 그림이",
      "en": "Inside, several images",
      "start": 36.9,
      "end": 38.53333333333333,
      "startFrame": 2214,
      "endFrame": 2312
    },
    {
      "lineIndex": 5,
      "id": "p6-2b",
      "spoken": "같은 동작으로 맞물리고 있었던 겁니다.",
      "ko": "같은 동작으로 맞물리고 있었던 겁니다.",
      "en": "moved together in the same action.",
      "start": 38.53333333333333,
      "end": 40.88333333333333,
      "startFrame": 2312,
      "endFrame": 2453
    }
  ]
