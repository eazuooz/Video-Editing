    {
      "scene": "04",
      "audioPath": "shared/output/narration/making-game-sequels/qwen3-1.7b-balanced-v1/chunks/04-scene.wav",
      "audioSha256": "b3023990aab9a86f17566d870224502da8c7c4342beb6d445ab61f3e5ce211a1",
      "samples": 984960,
      "sampleRate": 24000,
      "asrPath": "shared/output/narration/making-game-sequels/qwen3-1.7b-balanced-v1/asr/04.json",
      "asrSha256": "678760b64ede126355689c19a3e60e15d5ecbb84e51ca8e01ebe026a7dc4cbd5",
      "paragraphs": [
        {
          "paragraphIndex": 0,
          "ko": "세 번째 작품의 공식 시연입니다. 좁은 통로에서는 벽의 초록색 효과 주변을 움직이며 싸우고, 계단과 바닥 함정이 있는 장면에는 파란색 연쇄 효과가 보입니다.",
          "speechStart": 0.0,
          "speechEnd": 10.78,
          "normalizedMatch": 1.0,
          "pcmStartSample": 0,
          "pcmEndSample": 265296,
          "pcmSeconds": 11.054
        },
        {
          "paragraphIndex": 1,
          "ko": "다른 컷에서는 보라색 지팡이로 싸우고, 가까운 검 공격에서는 파란색 칼날 효과가 이어집니다. 넓은 전장의 나이트 전투도 별도 장면으로 봅니다.",
          "speechStart": 11.04,
          "speechEnd": 21.24,
          "normalizedMatch": 0.9827586206896551,
          "pcmStartSample": 265296,
          "pcmEndSample": 509664,
          "pcmSeconds": 10.182
        },
        {
          "paragraphIndex": 2,
          "ko": "여기서 확인할 것은 같은 시리즈 안에 보이는 다른 전투 모습입니다. 모든 도구가 이 작품에서 처음 생겼다거나, 같은 코드를 썼다고 추정하지는 않습니다.",
          "speechStart": 21.58,
          "speechEnd": 30.84,
          "normalizedMatch": 1.0,
          "pcmStartSample": 509664,
          "pcmEndSample": 747000,
          "pcmSeconds": 9.889
        },
        {
          "paragraphIndex": 3,
          "ko": "자신의 속편에는 이 질문을 붙여 보세요. 새 도구가 늘어났을 때, 플레이어는 이전과 다른 거리나 위치를 선택하게 되는가? 그 답은 우리 기획에서 확인해야 합니다.",
          "speechStart": 31.14,
          "speechEnd": 41.02,
          "normalizedMatch": 1.0,
          "pcmStartSample": 747000,
          "pcmEndSample": 984960,
          "pcmSeconds": 9.915
        }
      ],
