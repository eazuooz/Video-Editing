    {
      "scene": "11",
      "audioPath": "shared/output/narration/making-game-sequels/qwen3-1.7b-balanced-v1/chunks/11-scene.wav",
      "audioSha256": "9060eb63b2cc6f4f5e6a3aac13f373b59c637873336e641cd8cb630c06493ff2",
      "samples": 950400,
      "sampleRate": 24000,
      "asrPath": "shared/output/narration/making-game-sequels/qwen3-1.7b-balanced-v1/asr/11.json",
      "asrSha256": "404aeb30ac39280ad05da0d09b043e468df2e855fda87beedd353d71fb69b56a",
      "paragraphs": [
        {
          "paragraphIndex": 0,
          "ko": "마지막은 자신의 기획을 확인하는 방법입니다. 전작을 아는 사람에게는 남겨 두려던 활동이 여전히 가능한지, 처음 보는 사람에게는 첫 선택을 이해할 수 있는지 살펴봅니다.",
          "speechStart": 0.0,
          "speechEnd": 9.52,
          "normalizedMatch": 0.9420289855072463,
          "pcmStartSample": 0,
          "pcmEndSample": 234384,
          "pcmSeconds": 9.766
        },
        {
          "paragraphIndex": 1,
          "ko": "예를 들어 두 갈래 길에서 한쪽을 준비하게 한 뒤, 왜 그쪽을 골랐는지 물어볼 수 있습니다. 이는 우리가 제안하는 검증 과제이며 실제 이용자 조사 결과가 아닙니다.",
          "speechStart": 9.76,
          "speechEnd": 19.26,
          "normalizedMatch": 1.0,
          "pcmStartSample": 234384,
          "pcmEndSample": 467568,
          "pcmSeconds": 9.716
        },
        {
          "paragraphIndex": 2,
          "ko": "익숙한 사람도 예전과 똑같은 선택만 반복하고, 처음 보는 사람은 무엇을 골라야 할지 모른다면 변경 조건과 안내를 다시 살펴보세요. 새로움과 이해 가능성을 함께 확인하는 겁니다.",
          "speechStart": 19.48,
          "speechEnd": 30.4,
          "normalizedMatch": 0.9861111111111112,
          "pcmStartSample": 467568,
          "pcmEndSample": 736152,
          "pcmSeconds": 11.191
        },
        {
          "paragraphIndex": 3,
          "ko": "결과를 보기 전에는 성공이나 매출을 보장하지 않습니다. 유지할 행동, 바꾼 조건, 확인할 선택을 적고 실제 검증에서 수정할 수 있게 남겨 둡니다.",
          "speechStart": 30.66,
          "speechEnd": 39.58,
          "normalizedMatch": 1.0,
          "pcmStartSample": 736152,
          "pcmEndSample": 950400,
          "pcmSeconds": 8.927
        }
