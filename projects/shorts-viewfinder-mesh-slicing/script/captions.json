  "cues": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "허공에 사진을 놓았더니,",
      "ko": "허공에 사진을 놓았더니,",
      "en": "A photograph goes into empty space—",
      "start": 0.2,
      "end": 1.5166666666666666,
      "startFrame": 12,
      "endFrame": 91
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "그 위로 걸어갑니다.",
      "ko": "그 위로 걸어갑니다.",
      "en": "and you can walk on it.",
      "start": 1.5166666666666666,
      "end": 3.1666666666666665,
      "startFrame": 91,
      "endFrame": 190
    },
    {
      "id": "p1-3",
      "lineIndex": 0,
      "spoken": "뷰파인더는 사진으로 어떻게 진짜 길을 만들까요?",
      "ko": "뷰파인더는 사진으로 어떻게 진짜 길을 만들까요?",
      "en": "How does Viewfinder turn a picture into a real path?",
      "start": 3.316666666666667,
      "end": 6.266666666666667,
      "startFrame": 199,
      "endFrame": 376
    },
    {
      "id": "p2-1",
      "lineIndex": 1,
      "spoken": "게임 속 바닥과 벽은",
      "ko": "게임 속 바닥과 벽은",
      "en": "Floors and walls in a game",
      "start": 6.516666666666667,
      "end": 7.816666666666666,
      "startFrame": 391,
      "endFrame": 469
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "작은 삼각형을 이어 만든 표면입니다.",
      "ko": "작은 삼각형을 이어 만든 표면입니다.",
      "en": "are surfaces assembled from small triangles.",
      "start": 7.816666666666666,
      "end": 10.183333333333334,
      "startFrame": 469,
      "endFrame": 611
    },
    {
      "id": "p2-3",
      "lineIndex": 1,
      "spoken": "이런 구조를 메시라고 부릅니다.",
      "ko": "이런 구조를 메시라고 부릅니다.",
      "en": "This structure is called a mesh.",
      "start": 10.433333333333334,
      "end": 12.516666666666667,
      "startFrame": 626,
      "endFrame": 751
    },
    {
      "id": "p3-1",
      "lineIndex": 2,
      "spoken": "우리 시연에서 사진이 차지할 공간을",
      "ko": "우리 시연에서 사진이 차지할 공간을",
      "en": "In our demo, we mark the photo's region",
      "start": 12.733333333333333,
      "end": 14.733333333333333,
      "startFrame": 764,
      "endFrame": 884
    },
    {
      "id": "p3-2",
      "lineIndex": 2,
      "spoken": "노란 테두리로 표시해 볼게요.",
      "ko": "노란 테두리로 표시해 볼게요.",
      "en": "with a yellow boundary.",
      "start": 14.733333333333333,
      "end": 16.533333333333335,
      "startFrame": 884,
      "endFrame": 992
    },
    {
      "id": "p3-3",
      "lineIndex": 2,
      "spoken": "이 경계를 가로지르는 삼각형을 자르면,",
      "ko": "이 경계를 가로지르는 삼각형을 자르면,",
      "en": "Cut triangles across that boundary",
      "start": 16.783333333333335,
      "end": 19.133333333333333,
      "startFrame": 1007,
      "endFrame": 1148
    },
    {
      "id": "p3-4",
      "lineIndex": 2,
      "spoken": "안쪽과 바깥쪽을 나눌 수 있습니다.",
      "ko": "안쪽과 바깥쪽을 나눌 수 있습니다.",
      "en": "to separate the inside from the outside.",
      "start": 19.133333333333333,
      "end": 21.566666666666666,
      "startFrame": 1148,
      "endFrame": 1294
    },
    {
      "id": "p4-1",
      "lineIndex": 3,
      "spoken": "이제 사진이 놓일 영역의 기존 구조를 잘라 내고,",
      "ko": "이제 사진이 놓일 영역의 기존 구조를 잘라 내고,",
      "en": "We cut out the existing structure in that region",
      "start": 21.683333333333334,
      "end": 24.533333333333335,
      "startFrame": 1301,
      "endFrame": 1472
    },
    {
      "id": "p4-2",
      "lineIndex": 3,
      "spoken": "준비한 바닥 구조를 넣습니다.",
      "ko": "준비한 바닥 구조를 넣습니다.",
      "en": "and insert prepared floor geometry.",
      "start": 24.533333333333335,
      "end": 26.616666666666667,
      "startFrame": 1472,
      "endFrame": 1597
    },
    {
      "id": "p4-3",
      "lineIndex": 3,
      "spoken": "화면에 그림만 덮는 게 아니라,",
      "ko": "화면에 그림만 덮는 게 아니라,",
      "en": "Rather than only covering the screen with an image,",
      "start": 26.783333333333335,
      "end": 28.216666666666665,
      "startFrame": 1607,
      "endFrame": 1693
    },
    {
      "id": "p4-4",
      "lineIndex": 3,
      "spoken": "공간의 모양을 바꾸는 거죠.",
      "ko": "공간의 모양을 바꾸는 거죠.",
      "en": "we change the shape of the space.",
      "start": 28.216666666666665,
      "end": 30.033333333333335,
      "startFrame": 1693,
      "endFrame": 1802
    },
    {
      "id": "p5-1",
      "lineIndex": 4,
      "spoken": "새 바닥에 충돌 판정도 맞추면,",
      "ko": "새 바닥에 충돌 판정도 맞추면,",
      "en": "Update collision to match the new floor",
      "start": 30.2,
      "end": 32.28333333333333,
      "startFrame": 1812,
      "endFrame": 1937
    },
    {
      "id": "p5-2",
      "lineIndex": 4,
      "spoken": "공이 그 위를 실제로 지나갈 수 있습니다.",
      "ko": "공이 그 위를 실제로 지나갈 수 있습니다.",
      "en": "and the test ball can cross it.",
      "start": 32.28333333333333,
      "end": 34.71666666666667,
      "startFrame": 1937,
      "endFrame": 2083
    },
    {
      "id": "p5-3",
      "lineIndex": 4,
      "spoken": "이것이 우리 시연에서 길이 연결되는 과정입니다.",
      "ko": "이것이 우리 시연에서 길이 연결되는 과정입니다.",
      "en": "That connects the path in our demo.",
      "start": 35.0,
      "end": 37.766666666666666,
      "startFrame": 2100,
      "endFrame": 2266
    },
    {
      "id": "p6-1",
      "lineIndex": 5,
      "spoken": "실제 뷰파인더도 사진을 찍거나 놓을 때,",
      "ko": "실제 뷰파인더도 사진을 찍거나 놓을 때,",
      "en": "Viewfinder also modifies many meshes",
      "start": 37.96666666666667,
      "end": 40.71666666666667,
      "startFrame": 2278,
      "endFrame": 2443
    },
    {
      "id": "p6-2",
      "lineIndex": 5,
      "spoken": "한 프레임 안에 많은 메시를 수정합니다.",
      "ko": "한 프레임 안에 많은 메시를 수정합니다.",
      "en": "in a single capture or placement frame.",
      "start": 40.71666666666667,
      "end": 43.3,
      "startFrame": 2443,
      "endFrame": 2598
    },
    {
      "id": "p6-3",
      "lineIndex": 5,
      "spoken": "그래서 메시 절단 코드를 최적화해",
      "ko": "그래서 메시 절단 코드를 최적화해",
      "en": "Optimizing its mesh-slicing code",
      "start": 43.5,
      "end": 45.766666666666666,
      "startFrame": 2610,
      "endFrame": 2746
    },
    {
      "id": "p6-4",
      "lineIndex": 5,
      "spoken": "순간적인 끊김을 줄였죠.",
      "ko": "순간적인 끊김을 줄였죠.",
      "en": "helps avoid a visible stutter.",
      "start": 45.766666666666666,
      "end": 47.36666666666667,
      "startFrame": 2746,
      "endFrame": 2842
    },
    {
      "id": "p7-1",
      "lineIndex": 6,
      "spoken": "사진을 펼치자 길이 되는 마법.",
      "ko": "사진을 펼치자 길이 되는 마법.",
      "en": "A photograph unfolds into a walkable path.",
      "start": 47.516666666666666,
      "end": 49.666666666666664,
      "startFrame": 2851,
      "endFrame": 2980
    },
    {
      "id": "p7-2",
      "lineIndex": 6,
      "spoken": "그 뒤에는, 세계를 이루는 표면을",
      "ko": "그 뒤에는, 세계를 이루는 표면을",
      "en": "Behind that magic is a technique",
      "start": 49.666666666666664,
      "end": 51.68333333333333,
      "startFrame": 2980,
      "endFrame": 3101
    },
    {
      "id": "p7-3",
      "lineIndex": 6,
      "spoken": "실시간으로 잘라 바꾸는 기술이 있습니다.",
      "ko": "실시간으로 잘라 바꾸는 기술이 있습니다.",
      "en": "that cuts and reshapes surfaces live.",
      "start": 51.68333333333333,
      "end": 53.93333333333333,
