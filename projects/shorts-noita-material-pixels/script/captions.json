  "cues": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "불꽃과 폭발에, 동굴의 발판까지 무너집니다.",
      "ko": "불꽃과 폭발에, 동굴의 발판까지 무너집니다.",
      "en": "Fire and explosions destroy even the cave platform.",
      "start": 0.2,
      "end": 3.5833333333333335,
      "startFrame": 12,
      "endFrame": 215
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "노이타는 이 장면을 어떻게 만들까요?",
      "ko": "노이타는 이 장면을 어떻게 만들까요?",
      "en": "How does Noita create this scene?",
      "start": 3.7333333333333334,
      "end": 5.766666666666667,
      "startFrame": 224,
      "endFrame": 346
    },
    {
      "id": "p2-1",
      "lineIndex": 1,
      "spoken": "화면을 작은 격자로 생각해 볼게요.",
      "ko": "화면을 작은 격자로 생각해 볼게요.",
      "en": "Think of the world as a grid of tiny cells.",
      "start": 6.0,
      "end": 8.266666666666667,
      "startFrame": 360,
      "endFrame": 496
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "각 칸에는 색뿐 아니라,",
      "ko": "각 칸에는 색뿐 아니라,",
      "en": "Each cell stores more than color:",
      "start": 8.4,
      "end": 9.583333333333334,
      "startFrame": 504,
      "endFrame": 575
    },
    {
      "id": "p2-3",
      "lineIndex": 1,
      "spoken": "물이나 기름 같은 물질의 종류가 들어 있습니다.",
      "ko": "물이나 기름 같은 물질의 종류가 들어 있습니다.",
      "en": "it also holds a material, such as water or oil.",
      "start": 9.583333333333334,
      "end": 13.116666666666667,
      "startFrame": 575,
      "endFrame": 787
    },
    {
      "id": "p3-1",
      "lineIndex": 2,
      "spoken": "물은 아래가 비면 내려가고,",
      "ko": "물은 아래가 비면 내려가고,",
      "en": "Water falls when the cell below is empty.",
      "start": 13.316666666666666,
      "end": 14.683333333333334,
      "startFrame": 799,
      "endFrame": 881
    },
    {
      "id": "p3-2",
      "lineIndex": 2,
      "spoken": "막히면 옆으로 흐릅니다.",
      "ko": "막히면 옆으로 흐릅니다.",
      "en": "When blocked, it flows sideways.",
      "start": 14.683333333333334,
      "end": 16.416666666666668,
      "startFrame": 881,
      "endFrame": 985
    },
    {
      "id": "p3-3",
      "lineIndex": 2,
      "spoken": "이웃한 칸을 확인하며 상태를 바꾸는 거죠.",
      "ko": "이웃한 칸을 확인하며 상태를 바꾸는 거죠.",
      "en": "Neighboring cells guide each state change.",
      "start": 16.633333333333333,
      "end": 19.066666666666666,
      "startFrame": 998,
      "endFrame": 1144
    },
    {
      "id": "p4-1",
      "lineIndex": 3,
      "spoken": "이번에는 같은 불 옆에 기름을 놓아 볼까요?",
      "ko": "이번에는 같은 불 옆에 기름을 놓아 볼까요?",
      "en": "Put oil beside the same fire in our example.",
      "start": 19.233333333333334,
      "end": 21.533333333333335,
      "startFrame": 1154,
      "endFrame": 1292
    },
    {
      "id": "p4-2",
      "lineIndex": 3,
      "spoken": "불이 옮겨 붙습니다.",
      "ko": "불이 옮겨 붙습니다.",
      "en": "The fire spreads.",
      "start": 21.733333333333334,
      "end": 23.016666666666666,
      "startFrame": 1304,
      "endFrame": 1381
    },
    {
      "id": "p4-3",
      "lineIndex": 3,
      "spoken": "기름을 물로 바꾸면 결과가 달라져요.",
      "ko": "기름을 물로 바꾸면 결과가 달라져요.",
      "en": "Replace the oil with water, and the result changes.",
      "start": 23.116666666666667,
      "end": 25.366666666666667,
      "startFrame": 1387,
      "endFrame": 1522
    },
    {
      "id": "p5-1",
      "lineIndex": 4,
      "spoken": "이런 방식이 픽셀 기반 물질 시뮬레이션입니다.",
      "ko": "이런 방식이 픽셀 기반 물질 시뮬레이션입니다.",
      "en": "This is pixel-based material simulation.",
      "start": 25.516666666666666,
      "end": 28.916666666666668,
      "startFrame": 1531,
      "endFrame": 1735
    },
    {
      "id": "p5-2",
      "lineIndex": 4,
      "spoken": "노이타는 액체와 기체의 움직임에,",
      "ko": "노이타는 액체와 기체의 움직임에,",
      "en": "Noita combines the motion of liquids and gases",
      "start": 28.916666666666668,
      "end": 31.633333333333333,
      "startFrame": 1735,
      "endFrame": 1898
    },
    {
      "id": "p5-3",
      "lineIndex": 4,
      "spoken": "연소 같은 반응도 연결합니다.",
      "ko": "연소 같은 반응도 연결합니다.",
      "en": "with reactions such as combustion.",
      "start": 31.633333333333333,
      "end": 33.86666666666667,
      "startFrame": 1898,
      "endFrame": 2032
    },
    {
      "id": "p6-1",
      "lineIndex": 5,
      "spoken": "작은 칸들의 변화가 이어지면,",
      "ko": "작은 칸들의 변화가 이어지면,",
      "en": "As changes in these tiny cells propagate,",
      "start": 34.03333333333333,
      "end": 35.68333333333333,
      "startFrame": 2042,
      "endFrame": 2141
    },
    {
      "id": "p6-2",
      "lineIndex": 5,
      "spoken": "큰 화재나 지형 변화가 됩니다.",
      "ko": "큰 화재나 지형 변화가 됩니다.",
      "en": "large fires and terrain changes emerge.",
      "start": 35.68333333333333,
      "end": 38.233333333333334,
      "startFrame": 2141,
      "endFrame": 2294
    },
    {
      "id": "p6-3",
      "lineIndex": 5,
      "spoken": "눈앞의 동굴은 그림이면서,",
      "ko": "눈앞의 동굴은 그림이면서,",
      "en": "The cave is both an image",
      "start": 38.86666666666667,
      "end": 40.31666666666667,
      "startFrame": 2332,
      "endFrame": 2419
    },
    {
      "id": "p6-4",
      "lineIndex": 5,
      "spoken": "서로 반응하는 물질의 세계인 거예요.",
      "ko": "서로 반응하는 물질의 세계인 거예요.",
      "en": "and a world of interacting materials.",
      "start": 40.31666666666667,
