      "startFrame": 496,
      "endFrame": 658
    },
    {
      "id": "p2-3",
      "lineIndex": 1,
      "spoken": "아래의 배경만 뒤로 보냅니다.",
      "ko": "아래의 배경만 뒤로 보냅니다.",
