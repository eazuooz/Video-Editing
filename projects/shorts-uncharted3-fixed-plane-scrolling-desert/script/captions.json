  "cues": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "이 비행기가 사막 위를 날아갑니다.",
      "ko": "이 비행기가 사막 위를 날아갑니다.",
      "en": "This plane flies over the desert.",
