  "cues": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "포털에 다가가면 다른 방이 보이고,",
      "ko": "포털에 다가가면 다른 방이 보이고,",
      "en": "Approach a portal and another room appears.",
      "start": 0.2,
      "end": 2.466666666666667,
      "startFrame": 12,
      "endFrame": 148
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "걸어 들어가면 그대로 이어집니다.",
      "ko": "걸어 들어가면 그대로 이어집니다.",
      "en": "Walk into it and the view continues.",
      "start": 2.466666666666667,
      "end": 4.633333333333334,
      "startFrame": 148,
      "endFrame": 278
    },
    {
      "id": "p1-3",
      "lineIndex": 0,
      "spoken": "어떻게 화면이 끊기지 않을까요?",
      "ko": "어떻게 화면이 끊기지 않을까요?",
      "en": "How is that transition seamless?",
      "start": 5.016666666666667,
      "end": 6.683333333333334,
      "startFrame": 301,
      "endFrame": 401
    },
    {
      "id": "p2-1",
      "lineIndex": 1,
      "spoken": "우리 시연을 위에서 보면,",
      "ko": "우리 시연을 위에서 보면,",
      "en": "From above in our demo,",
      "start": 6.916666666666667,
      "end": 8.116666666666667,
      "startFrame": 415,
      "endFrame": 487
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "두 문은 떨어져 있습니다.",
      "ko": "두 문은 떨어져 있습니다.",
      "en": "the two doorways are separated.",
      "start": 8.116666666666667,
      "end": 9.9,
      "startFrame": 487,
      "endFrame": 594
    },
    {
      "id": "p2-3",
      "lineIndex": 1,
      "spoken": "입구에서 본 거리와 각도에 맞춰,",
      "ko": "입구에서 본 거리와 각도에 맞춰,",
      "en": "The exit camera follows",
      "start": 10.133333333333333,
      "end": 12.166666666666666,
      "startFrame": 608,
      "endFrame": 730
    },
    {
      "id": "p2-4",
      "lineIndex": 1,
      "spoken": "출구 쪽 카메라도 움직이는 거예요.",
      "ko": "출구 쪽 카메라도 움직이는 거예요.",
      "en": "your distance and angle relative to the entrance.",
      "start": 12.166666666666666,
      "end": 14.3,
      "startFrame": 730,
      "endFrame": 858
    },
    {
      "id": "p3-1",
      "lineIndex": 2,
      "spoken": "그 카메라의 화면을",
      "ko": "그 카메라의 화면을",
      "en": "Show that camera’s view",
      "start": 14.483333333333333,
      "end": 15.566666666666666,
      "startFrame": 869,
      "endFrame": 934
    },
    {
      "id": "p3-2",
      "lineIndex": 2,
      "spoken": "입구 안쪽에만 보여주면,",
      "ko": "입구 안쪽에만 보여주면,",
      "en": "only inside the entrance,",
      "start": 15.566666666666666,
      "end": 17.116666666666667,
      "startFrame": 934,
      "endFrame": 1027
    },
    {
      "id": "p3-3",
      "lineIndex": 2,
      "spoken": "문 뒤에 공간이 있는 것처럼 보이죠.",
      "ko": "문 뒤에 공간이 있는 것처럼 보이죠.",
      "en": "and a space appears to exist behind it.",
      "start": 17.116666666666667,
      "end": 19.3,
      "startFrame": 1027,
      "endFrame": 1158
    },
    {
      "id": "p4-1",
      "lineIndex": 3,
      "spoken": "이제 몸의 기준점이 문을 통과하는 순간,",
      "ko": "이제 몸의 기준점이 문을 통과하는 순간,",
      "en": "When the body’s reference point crosses the plane,",
      "start": 19.433333333333334,
      "end": 21.933333333333334,
      "startFrame": 1166,
      "endFrame": 1316
    },
    {
      "id": "p4-2",
      "lineIndex": 3,
      "spoken": "입구 기준 위치를 출구 기준으로 바꿉니다.",
      "ko": "입구 기준 위치를 출구 기준으로 바꿉니다.",
      "en": "map entrance-relative position to the exit.",
      "start": 21.933333333333334,
      "end": 24.983333333333334,
      "startFrame": 1316,
      "endFrame": 1499
    },
    {
      "id": "p4-3",
      "lineIndex": 3,
      "spoken": "바라보는 방향도 같은 방식으로 바꿔요.",
      "ko": "바라보는 방향도 같은 방식으로 바꿔요.",
      "en": "Transform its facing direction the same way.",
      "start": 25.4,
      "end": 28.166666666666668,
      "startFrame": 1524,
      "endFrame": 1690
    },
    {
      "id": "p5-1",
      "lineIndex": 4,
      "spoken": "그런데 몸이 반쯤 걸쳐 있을 때는요?",
      "ko": "그런데 몸이 반쯤 걸쳐 있을 때는요?",
      "en": "What about a body halfway through?",
      "start": 28.316666666666666,
      "end": 30.766666666666666,
      "startFrame": 1699,
      "endFrame": 1846
    },
    {
      "id": "p5-2",
      "lineIndex": 4,
      "spoken": "우리 구현은 반대편에도",
      "ko": "우리 구현은 반대편에도",
      "en": "Our implementation also draws",
      "start": 30.766666666666666,
      "end": 32.483333333333334,
      "startFrame": 1846,
      "endFrame": 1949
    },
    {
      "id": "p5-3",
      "lineIndex": 4,
      "spoken": "보여주기용 몸을 하나 더 그립니다.",
      "ko": "보여주기용 몸을 하나 더 그립니다.",
      "en": "a visual copy at the other portal.",
      "start": 32.483333333333334,
      "end": 34.81666666666667,
      "startFrame": 1949,
      "endFrame": 2089
    },
    {
      "id": "p6-1",
      "lineIndex": 5,
      "spoken": "입구에서는 아직 안 들어간 부분만,",
      "ko": "입구에서는 아직 안 들어간 부분만,",
      "en": "At the entrance, keep the part not yet through.",
      "start": 35.0,
      "end": 37.916666666666664,
      "startFrame": 2100,
      "endFrame": 2275
    },
    {
      "id": "p6-2",
      "lineIndex": 5,
      "spoken": "출구에서는 통과한 부분만 남깁니다.",
      "ko": "출구에서는 통과한 부분만 남깁니다.",
      "en": "At the exit, keep the part that has crossed.",
      "start": 37.916666666666664,
      "end": 40.43333333333333,
      "startFrame": 2275,
      "endFrame": 2426
    },
    {
      "id": "p6-3",
      "lineIndex": 5,
      "spoken": "경계 밖을 잘라 그리는 클리핑입니다.",
      "ko": "경계 밖을 잘라 그리는 클리핑입니다.",
      "en": "Clipping removes the parts beyond each boundary.",
      "emphasis": {
        "text": "클리핑",
        "role": "term"
      },
      "start": 40.63333333333333,
      "end": 42.86666666666667,
      "startFrame": 2438,
      "endFrame": 2572
    },
    {
      "id": "p7-1",
      "lineIndex": 6,
      "spoken": "두 시점을 동시에 보면,",
      "ko": "두 시점을 동시에 보면,",
      "en": "Both views share the same instant.",
      "start": 43.016666666666666,
      "end": 44.1,
      "startFrame": 2581,
      "endFrame": 2646
    },
    {
      "id": "p7-2",
      "lineIndex": 6,
      "spoken": "몸과 시선이 같은 순간에 이어집니다.",
      "ko": "몸과 시선이 같은 순간에 이어집니다.",
      "en": "The body and camera continue together.",
      "start": 44.1,
      "end": 46.86666666666667,
      "startFrame": 2646,
      "endFrame": 2812
    },
    {
      "id": "p7-3",
      "lineIndex": 6,
      "spoken": "두 사람이 생긴 게 아니라,",
      "ko": "두 사람이 생긴 게 아니라,",
      "en": "There are not two independent players:",
      "start": 47.083333333333336,
      "end": 48.166666666666664,
      "startFrame": 2825,
      "endFrame": 2890
    },
    {
      "id": "p7-4",
      "lineIndex": 6,
      "spoken": "한 몸의 보이는 부분을 나눠 그린 거예요.",
      "ko": "한 몸의 보이는 부분을 나눠 그린 거예요.",
      "en": "one body is drawn across two sides.",
      "start": 48.166666666666664,
      "end": 50.583333333333336,
      "startFrame": 2890,
      "endFrame": 3035
    },
    {
      "id": "p8-1",
      "lineIndex": 7,
      "spoken": "다른 곳을 보여주는 카메라,",
      "ko": "다른 곳을 보여주는 카메라,",
      "en": "A camera showing the destination,",
      "start": 50.766666666666666,
      "end": 52.4,
      "startFrame": 3046,
      "endFrame": 3144
    },
    {
      "id": "p8-2",
      "lineIndex": 7,
      "spoken": "위치와 방향을 옮기는 좌표 변환,",
      "ko": "위치와 방향을 옮기는 좌표 변환,",
      "en": "a transformation of position and orientation,",
      "emphasis": {
        "text": "좌표 변환",
        "role": "term"
      },
      "start": 52.4,
      "end": 55.81666666666667,
      "startFrame": 3144,
      "endFrame": 3349
    },
    {
      "id": "p8-3",
      "lineIndex": 7,
      "spoken": "경계를 감추는 클리핑.",
      "ko": "경계를 감추는 클리핑.",
      "en": "and clipping at the boundary.",
      "emphasis": {
        "text": "클리핑",
        "role": "term"
      },
      "start": 55.81666666666667,
      "end": 57.43333333333333,
      "startFrame": 3349,
      "endFrame": 3446
    },
    {
      "id": "p8-4",
      "lineIndex": 7,
      "spoken": "세 가지가 맞물려 자연스러운 통로가 됩니다.",
      "ko": "세 가지가 맞물려 자연스러운 통로가 됩니다.",
      "en": "Together they make a seamless passage.",
      "start": 57.43333333333333,
