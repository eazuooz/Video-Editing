  "cues": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "그림은 이십사 프레임인데,",
      "ko": "그림은24프레임인데,",
      "en": "The art plays at 24 fps,",
      "start": 0.2,
      "end": 1.5166666666666666,
      "startFrame": 12,
      "endFrame": 91
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "컵헤드는 왜 이렇게 매끄럽게 움직일까요?",
      "ko": "컵헤드는 왜 이렇게\n매끄럽게 움직일까요?",
      "en": "so why does Cuphead move so smoothly?",
      "start": 1.5166666666666666,
      "end": 4.233333333333333,
      "startFrame": 91,
      "endFrame": 254
    },
    {
      "id": "p2-1",
      "lineIndex": 1,
      "spoken": "손으로 그린 달리기 그림을",
      "ko": "손으로 그린 달리기 그림을",
      "en": "Take hand-drawn running poses",
      "start": 4.516666666666667,
      "end": 6.166666666666667,
      "startFrame": 271,
      "endFrame": 370
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "한 장씩 바꾸면 애니메이션이 됩니다.",
      "ko": "한 장씩 바꾸면\n애니메이션이 됩니다.",
      "en": "and play them as animation.",
      "start": 6.166666666666667,
      "end": 8.733333333333333,
      "startFrame": 370,
      "endFrame": 524
    },
    {
      "id": "p2-3",
      "lineIndex": 1,
      "spoken": "그런데 그림을 바꾸는 속도와,",
      "ko": "그런데 그림을 바꾸는 속도와,",
      "en": "But changing the drawing",
      "start": 8.883333333333333,
      "end": 10.4,
      "startFrame": 533,
      "endFrame": 624
    },
    {
      "id": "p2-4",
      "lineIndex": 1,
      "spoken": "위치를 옮기는 속도는 따로 정할 수 있어요.",
      "ko": "위치를 옮기는 속도는\n따로 정할 수 있어요.",
      "en": "can run at a different rate from movement.",
      "start": 10.4,
      "end": 13.333333333333334,
      "startFrame": 624,
      "endFrame": 800
    },
    {
      "id": "p3-1",
      "lineIndex": 2,
      "spoken": "컵헤드는 그림을 초당 이십사 프레임으로 재생하고,",
      "ko": "컵헤드는 그림을\n초당24프레임으로 재생하고,",
      "en": "Cuphead plays its animation at 24 fps,",
      "start": 13.516666666666667,
      "end": 16.666666666666668,
      "startFrame": 811,
      "endFrame": 1000
    },
    {
      "id": "p3-2",
      "lineIndex": 2,
      "spoken": "게임은 초당 육십 프레임으로 실행합니다.",
      "ko": "게임은 초당60프레임으로\n실행합니다.",
      "en": "while the game runs at 60 fps.",
      "start": 16.666666666666668,
      "end": 19.016666666666666,
      "startFrame": 1000,
      "endFrame": 1141
    },
    {
      "id": "p4-1",
      "lineIndex": 3,
      "spoken": "우리 시연에서 그림만 이십사 프레임으로 바꿔 볼게요.",
      "ko": "우리 시연에서 그림만\n24프레임으로 바꿔 볼게요.",
      "en": "Set only our demo's animation to 24 fps.",
      "start": 19.2,
      "end": 22.7,
      "startFrame": 1152,
      "endFrame": 1362
    },
    {
      "id": "p4-2",
      "lineIndex": 3,
      "spoken": "발 모양이 그대로인 순간에도",
      "ko": "발 모양이 그대로인 순간에도",
      "en": "Even while the pose is held,",
      "start": 23.066666666666666,
      "end": 24.633333333333333,
      "startFrame": 1384,
      "endFrame": 1478
    },
    {
      "id": "p4-3",
      "lineIndex": 3,
      "spoken": "위치는 조금씩 앞으로 갑니다.",
      "ko": "위치는 조금씩 앞으로 갑니다.",
      "en": "the position keeps advancing.",
      "start": 24.633333333333333,
      "end": 26.533333333333335,
      "startFrame": 1478,
      "endFrame": 1592
    },
    {
      "id": "p4-4",
      "lineIndex": 3,
      "spoken": "종이 인형을 밀듯이요.",
      "ko": "종이 인형을 밀듯이요.",
      "en": "Like sliding a paper cutout.",
      "start": 26.9,
      "end": 28.366666666666667,
      "startFrame": 1614,
      "endFrame": 1702
    },
    {
      "id": "p5-1",
      "lineIndex": 4,
      "spoken": "반대로 위치까지 초당 이십사 번만 바꾸면,",
      "ko": "반대로 위치까지\n초당24번만 바꾸면,",
      "en": "Now update position only 24 times a second.",
      "start": 28.483333333333334,
      "end": 31.166666666666668,
      "startFrame": 1709,
      "endFrame": 1870
    },
    {
      "id": "p5-2",
      "lineIndex": 4,
      "spoken": "이동도 계단처럼 보이죠.",
      "ko": "이동도 계단처럼 보이죠.",
      "en": "The motion steps too.",
      "start": 31.166666666666668,
      "end": 33.016666666666666,
      "startFrame": 1870,
      "endFrame": 1981
    },
    {
      "id": "p5-3",
      "lineIndex": 4,
      "spoken": "같은 길을 같은 시간에 가도,",
      "ko": "같은 길을 같은 시간에 가도,",
      "en": "The route and duration stay the same,",
      "start": 33.21666666666667,
      "end": 35.21666666666667,
      "startFrame": 1993,
      "endFrame": 2113
    },
    {
      "id": "p5-4",
      "lineIndex": 4,
      "spoken": "중간 위치가 줄었기 때문입니다.",
      "ko": "중간 위치가 줄었기 때문입니다.",
      "en": "but fewer intermediate positions appear.",
      "start": 35.21666666666667,
      "end": 37.3,
      "startFrame": 2113,
      "endFrame": 2238
    },
    {
      "id": "p6-1",
      "lineIndex": 5,
      "spoken": "이렇게 그림의 재생과 이동 갱신을 분리하면,",
      "ko": "그림의 재생과 이동 갱신을\n분리하면,",
      "en": "Separate animation playback from movement",
      "start": 37.53333333333333,
      "end": 40.083333333333336,
      "startFrame": 2252,
      "endFrame": 2405
    },
    {
      "id": "p6-2",
      "lineIndex": 5,
      "spoken": "오래된 만화의 질감과",
      "ko": "오래된 만화의 질감과",
      "en": "to combine vintage cartoon texture",
      "start": 40.083333333333336,
      "end": 41.983333333333334,
      "startFrame": 2405,
      "endFrame": 2519
    },
    {
      "id": "p6-3",
      "lineIndex": 5,
      "spoken": "매끄러운 게임 움직임을 함께 살릴 수 있습니다.",
      "ko": "매끄러운 게임 움직임을\n함께 살릴 수 있습니다.",
      "en": "with smooth game motion.",
      "start": 41.983333333333334,
      "end": 45.233333333333334,
      "startFrame": 2519,
      "endFrame": 2714
    }
  ]
}
