  "cues": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "바닥으로 떨어졌는데,",
      "ko": "바닥으로 떨어졌는데,",
      "en": "Fall into the floor.",
      "start": 0.2,
      "end": 1.3,
      "startFrame": 12,
      "endFrame": 78
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "벽에서 튀어나옵니다.",
      "ko": "벽에서 튀어나옵니다.",
      "en": "Fly out of the wall.",
      "start": 1.3,
      "end": 2.9,
      "startFrame": 78,
      "endFrame": 174
    },
    {
      "id": "p1-3",
      "lineIndex": 0,
      "spoken": "포털은 위치만 옮기는 걸까요?",
      "ko": "포털은 위치만 옮기는 걸까요?",
      "en": "Does a portal only move your position?",
      "start": 3.2,
      "end": 5.033333333333333,
      "startFrame": 192,
      "endFrame": 302
    },
    {
      "id": "p2-1",
      "lineIndex": 1,
      "spoken": "위치만 옮기고 속도를 영으로 만들면,",
      "ko": "위치만 옮기고 속도를 영으로 만들면,",
      "en": "Move the position but reset velocity to zero,",
      "start": 5.266666666666667,
      "end": 7.516666666666667,
      "startFrame": 316,
      "endFrame": 451
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "출구 앞에서 뚝 떨어집니다.",
      "ko": "출구 앞에서 뚝 떨어집니다.",
      "en": "and you drop at the exit.",
      "start": 7.516666666666667,
      "end": 9.6,
      "startFrame": 451,
      "endFrame": 576
    },
    {
      "id": "p2-3",
      "lineIndex": 1,
      "spoken": "움직임도 함께 옮겨야 해요.",
      "ko": "움직임도 함께 옮겨야 해요.",
      "en": "Your motion must be transferred too.",
      "start": 9.766666666666667,
      "end": 11.483333333333333,
      "startFrame": 586,
      "endFrame": 689
    },
    {
      "id": "p3-1",
      "lineIndex": 2,
      "spoken": "속도 벡터는",
      "ko": "속도 벡터는",
      "en": "A velocity vector describes",
      "emphasis": {
        "text": "속도 벡터",
        "role": "term"
      },
      "start": 11.666666666666666,
      "end": 12.483333333333333,
      "startFrame": 700,
      "endFrame": 749
    },
    {
      "id": "p3-2",
      "lineIndex": 2,
      "spoken": "얼마나 빠른지와 어느 방향인지를 나타냅니다.",
      "ko": "얼마나 빠른지와 어느 방향인지를 나타냅니다.",
      "en": "speed and direction.",
      "start": 12.483333333333333,
      "end": 15.466666666666667,
      "startFrame": 749,
      "endFrame": 928
    },
    {
      "id": "p3-3",
      "lineIndex": 2,
      "spoken": "화살표의 길이가 속력, 방향이 이동 방향이에요.",
      "ko": "화살표의 길이가 속력, 방향이 이동 방향이에요.",
      "en": "Length is speed; the arrow points ahead.",
      "start": 15.716666666666667,
      "end": 18.883333333333333,
      "startFrame": 943,
      "endFrame": 1133
    },
    {
      "id": "p4-1",
      "lineIndex": 3,
      "spoken": "입구를 기준으로 이 화살표를 읽고,",
      "ko": "입구를 기준으로 이 화살표를 읽고,",
      "en": "Read that arrow relative to the entrance,",
      "start": 19.083333333333332,
      "end": 21.1,
      "startFrame": 1145,
      "endFrame": 1266
    },
    {
      "id": "p4-2",
      "lineIndex": 3,
      "spoken": "출구에 맞춰 방향을 돌려줍니다.",
      "ko": "출구에 맞춰 방향을 돌려줍니다.",
      "en": "then turn it to match the exit.",
      "start": 21.1,
      "end": 23.5,
      "startFrame": 1266,
      "endFrame": 1410
    },
    {
      "id": "p4-3",
      "lineIndex": 3,
      "spoken": "이런 계산을 좌표 변환이라고 해요.",
      "ko": "이런 계산을 좌표 변환이라고 해요.",
      "en": "This is a coordinate transformation.",
      "emphasis": {
        "text": "좌표 변환",
        "role": "term"
      },
      "start": 23.766666666666666,
      "end": 26.066666666666666,
      "startFrame": 1426,
      "endFrame": 1564
    },
    {
      "id": "p5-1",
      "lineIndex": 4,
      "spoken": "우리 시연에서 아래로 초속 육 미터였다면,",
      "ko": "우리 시연에서 아래로 초속 육 미터였다면,",
      "en": "In our demo, six metres per second downward",
      "emphasis": {
        "text": "육 미터",
        "role": "result"
      },
      "start": 26.233333333333334,
      "end": 28.583333333333332,
      "startFrame": 1574,
      "endFrame": 1715
    },
    {
      "id": "p5-2",
      "lineIndex": 4,
      "spoken": "벽의 출구에서는 옆으로 초속 육 미터입니다.",
      "ko": "벽의 출구에서는 옆으로 초속 육 미터입니다.",
      "en": "becomes 6 m/s sideways at the exit.",
      "emphasis": {
        "text": "육 미터",
        "role": "result"
      },
      "start": 28.633333333333333,
      "end": 31.816666666666666,
      "startFrame": 1718,
      "endFrame": 1909
    },
    {
      "id": "p5-3",
      "lineIndex": 4,
      "spoken": "속력은 유지하고 방향만 바뀌죠.",
      "ko": "속력은 유지하고 방향만 바뀌죠.",
      "en": "The speed stays the same; the direction changes.",
      "emphasis": {
        "text": "방향만",
        "role": "result"
      },
      "start": 32.083333333333336,
      "end": 34.8,
      "startFrame": 1925,
      "endFrame": 2088
    },
    {
      "id": "p6-1",
      "lineIndex": 5,
      "spoken": "그래서 포털에서는",
      "ko": "그래서 포털에서는",
      "en": "That lets you use",
      "start": 34.983333333333334,
      "end": 35.983333333333334,
      "startFrame": 2099,
      "endFrame": 2159
    },
    {
      "id": "p6-2",
      "lineIndex": 5,
      "spoken": "떨어지며 얻은 속력을",
      "ko": "떨어지며 얻은 속력을",
      "en": "the speed gained while falling",
      "start": 35.983333333333334,
      "end": 37.583333333333336,
      "startFrame": 2159,
      "endFrame": 2255
    },
    {
      "id": "p6-3",
      "lineIndex": 5,
      "spoken": "멀리 건너가는 점프로 연결할 수 있습니다.",
      "ko": "멀리 건너가는 점프로 연결할 수 있습니다.",
      "en": "to launch across a gap in Portal.",
      "start": 37.583333333333336,
      "end": 40.266666666666666,
      "startFrame": 2255,
      "endFrame": 2416
    },
    {
      "id": "p7-1",
      "lineIndex": 6,
      "spoken": "순간이동의 핵심은 위치뿐만이 아닙니다.",
      "ko": "순간이동의 핵심은 위치뿐만이 아닙니다.",
      "en": "Teleportation is about more than position.",
      "start": 40.43333333333333,
      "end": 43.13333333333333,
      "startFrame": 2426,
      "endFrame": 2588
    },
    {
      "id": "p7-2",
      "lineIndex": 6,
      "spoken": "들어오던 움직임을 출구 방향으로 이어 주는 것.",
      "ko": "들어오던 움직임을 출구 방향으로 이어 주는 것.",
      "en": "It carries incoming motion into the exit direction.",
      "start": 43.3,
      "end": 45.983333333333334,
      "startFrame": 2598,
      "endFrame": 2759
    },
    {
      "id": "p7-3",
      "lineIndex": 6,
      "spoken": "그 덕분에 두 공간이 연결된 것처럼 느껴지는 거예요.",
      "ko": "그 덕분에 두 공간이 연결된 것처럼 느껴지는 거예요.",
      "en": "That makes two spaces feel connected.",
