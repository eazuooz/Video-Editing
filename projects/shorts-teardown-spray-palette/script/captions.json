  "cues": [
    {
      "id": "p1-1",
      "lineIndex": 0,
      "spoken": "이 스프레이, 색을 칠하는 순간 번호를 바꿉니다.",
      "ko": "이 스프레이, 색을 칠하는 순간 번호를 바꿉니다.",
      "en": "This spray changes a number to paint.",
      "start": 0.2,
      "end": 3.5166666666666666,
      "startFrame": 12,
      "endFrame": 211
    },
    {
      "id": "p1-2",
      "lineIndex": 0,
      "spoken": "티어다운이 쓴 꼼수죠.",
      "ko": "Teardown이 쓴 꼼수죠.",
      "en": "That is Teardown's trick.",
      "start": 3.816666666666667,
      "end": 5.4,
      "startFrame": 229,
      "endFrame": 324
    },
    {
      "id": "p2-1",
      "lineIndex": 1,
      "spoken": "작은 입체 칸인 복셀마다,",
      "ko": "작은 입체 칸인 복셀마다,",
      "en": "Each voxel is a tiny 3D cell.",
      "start": 5.666666666666667,
      "end": 7.983333333333333,
      "startFrame": 340,
      "endFrame": 479
    },
    {
      "id": "p2-2",
      "lineIndex": 1,
      "spoken": "색 대신 재질 번호 한 바이트를 넣어요.",
      "ko": "색 대신 재질 번호\n1바이트를 넣어요.",
      "en": "It stores a one-byte material number.",
      "start": 7.983333333333333,
      "end": 10.883333333333333,
      "startFrame": 479,
      "endFrame": 653
    },
    {
      "id": "p2-3",
      "lineIndex": 1,
      "spoken": "이 번호를 재질 인덱스,",
      "ko": "이 번호를 재질 인덱스,",
      "en": "This number is the material index;",
      "start": 11.116666666666667,
      "end": 12.783333333333333,
      "startFrame": 667,
      "endFrame": 767
    },
    {
      "id": "p2-4",
      "lineIndex": 1,
      "spoken": "번호로 찾아보는 재질표를 팔레트라고 합니다.",
      "ko": "번호로 찾아보는 재질표를\n팔레트라고 합니다.",
      "en": "the material table is called a palette.",
      "start": 12.783333333333333,
      "end": 15.333333333333334,
      "startFrame": 767,
      "endFrame": 920
    },
    {
      "id": "p3-1",
      "lineIndex": 2,
      "spoken": "로딩할 때 원래 재질과,",
      "ko": "로딩할 때 원래 재질과,",
      "en": "At load time, prepare the original",
      "start": 15.55,
      "end": 17.016666666666666,
      "startFrame": 933,
      "endFrame": 1021
    },
    {
      "id": "p3-2",
      "lineIndex": 2,
      "spoken": "점점 노래지는 재질을 미리 준비합니다.",
      "ko": "점점 노래지는 재질을\n미리 준비합니다.",
      "en": "and progressively yellower variants.",
      "start": 17.016666666666666,
      "end": 19.516666666666666,
      "startFrame": 1021,
      "endFrame": 1171
    },
    {
      "id": "p3-3",
      "lineIndex": 2,
      "spoken": "뿌릴 때는 팔레트 변환표를 보고,",
      "ko": "뿌릴 때는 팔레트 변환표를 보고,",
      "en": "Spraying consults a translation table",
      "start": 19.666666666666668,
      "end": 21.716666666666665,
      "startFrame": 1180,
      "endFrame": 1303
    },
    {
      "id": "p3-4",
      "lineIndex": 2,
      "spoken": "해당 복셀의 번호만 바꿔요.",
      "ko": "해당 복셀의 번호만 바꿔요.",
      "en": "and changes the voxel's index.",
      "start": 21.716666666666665,
      "end": 23.666666666666668,
      "startFrame": 1303,
      "endFrame": 1420
    },
    {
      "id": "p4-1",
      "lineIndex": 3,
      "spoken": "예를 들어 삼 번 벽돌을,",
      "ko": "예를 들어 3번 벽돌을,",
      "en": "For example, replace brick index 3",
      "start": 23.833333333333332,
      "end": 25.583333333333332,
      "startFrame": 1430,
      "endFrame": 1535
    },
    {
      "id": "p4-2",
      "lineIndex": 3,
      "spoken": "구 번 노란 벽돌로 바꾸는 식이죠.",
      "ko": "9번 노란 벽돌로 바꾸는 식이죠.",
      "en": "with yellow-brick index 9.",
      "start": 25.583333333333332,
      "end": 27.983333333333334,
      "startFrame": 1535,
      "endFrame": 1679
    },
    {
      "id": "p4-3",
      "lineIndex": 3,
      "spoken": "모양은 그대로인데 색이 달라집니다.",
      "ko": "모양은 그대로인데\n색이 달라집니다.",
      "en": "Its shape stays; its color changes.",
      "start": 28.366666666666667,
      "end": 30.316666666666666,
      "startFrame": 1702,
      "endFrame": 1819
    },
    {
      "id": "p5-1",
      "lineIndex": 4,
      "spoken": "문제는 표의 크기입니다.",
      "ko": "문제는 표의 크기입니다.",
      "en": "The palette has limited space.",
      "start": 30.5,
      "end": 32.0,
      "startFrame": 1830,
      "endFrame": 1920
    },
    {
      "id": "p5-2",
      "lineIndex": 4,
      "spoken": "최대 이백오십오 칸에,",
      "ko": "최대 255칸에,",
      "en": "There are up to 255 material slots.",
      "start": 32.0,
      "end": 33.483333333333334,
      "startFrame": 1920,
      "endFrame": 2009
    },
    {
      "id": "p5-3",
      "lineIndex": 4,
      "spoken": "노랑 네 단계와 검정 네 단계까지 넣으면,",
      "ko": "노랑 4단계와\n검정 4단계까지 넣으면,",
      "en": "Add four yellow and four black shades:",
      "start": 33.483333333333334,
      "end": 36.13333333333333,
      "startFrame": 2009,
      "endFrame": 2168
    },
    {
      "id": "p5-4",
      "lineIndex": 4,
      "spoken": "원래 재질 하나에 아홉 칸이 필요해요.",
      "ko": "원래 재질 하나에\n9칸이 필요해요.",
      "en": "one original now needs nine slots.",
      "start": 36.13333333333333,
      "end": 38.733333333333334,
      "startFrame": 2168,
      "endFrame": 2324
    },
    {
      "id": "p6-1",
      "lineIndex": 5,
      "spoken": "공간이 부족하면 비슷한 색을 합치고,",
      "ko": "공간이 부족하면\n비슷한 색을 합치고,",
      "en": "When space runs out, merge similar colors",
      "start": 38.96666666666667,
      "end": 41.06666666666667,
      "startFrame": 2338,
      "endFrame": 2464
    },
    {
      "id": "p6-2",
      "lineIndex": 5,
      "spoken": "남은 재질에서 가장 가까운 색을 고릅니다.",
      "ko": "남은 재질에서\n가장 가까운 색을 고릅니다.",
      "en": "and choose the closest available match.",
      "start": 41.06666666666667,
      "end": 43.63333333333333,
      "startFrame": 2464,
      "endFrame": 2618
    },
    {
      "id": "p6-3",
      "lineIndex": 5,
      "spoken": "그래서 초기 구현의 복잡한 성에서는,",
      "ko": "그래서 초기 구현의\n복잡한 성에서는,",
      "en": "In the early Castle example,",
      "start": 43.96666666666667,
      "end": 45.9,
      "startFrame": 2638,
      "endFrame": 2754
    },
    {
      "id": "p6-4",
      "lineIndex": 5,
      "spoken": "노랑 대신 갈색이 되거나 그대로인 곳도 있었죠.",
      "ko": "노랑 대신 갈색이 되거나\n그대로인 곳도 있었죠.",
      "en": "Some turned brown\nor stayed unchanged.",
      "start": 45.9,
      "end": 49.43333333333333,
      "startFrame": 2754,
      "endFrame": 2966
    },
    {
      "id": "p7-1",
      "lineIndex": 6,
      "spoken": "물감 하나에도,",
      "ko": "물감 하나에도,",
      "en": "Even a spray can",
      "start": 49.61666666666667,
      "end": 50.61666666666667,
      "startFrame": 2977,
      "endFrame": 3037
    },
    {
      "id": "p7-2",
      "lineIndex": 6,
      "spoken": "적은 메모리와 풍부한 색",
      "ko": "적은 메모리와 풍부한 색",
      "en": "trades off low memory use",
      "start": 50.61666666666667,
      "end": 52.45,
      "startFrame": 3037,
      "endFrame": 3147
    },
    {
      "id": "p7-2b",
      "lineIndex": 6,
      "spoken": "사이의 타협이 숨어 있습니다.",
      "ko": "사이의 타협이 숨어 있습니다.",
      "en": "against richer color choices.",
      "start": 52.45,
      "end": 54.016666666666666,
      "startFrame": 3147,
      "endFrame": 3241
    }
  ]
