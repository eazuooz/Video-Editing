        "duration": 3.12,
        "pcmSHA256": "8e566b412222e394c4efe13f78552fa8adbb0e91fbb136b75651f0eb642a0408"
      }
    },
    {
      "id": "s6u0141",
      "paragraph": "p005",
      "ko": "충돌과 부서짐은 작은 파편과 먼지도 만듭니다.",
      "originUnit": "u014",
      "sourceRaw": {
        "path": "D:\\Github\\VideoEditing\\shared\\output\\original-tech-twelve-20261115\\shorts-control-destruction-pipeline\\voice-master-v14\\chunks\\s6u0141.wav",
