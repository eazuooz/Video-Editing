  "entries": [
    {
      "index": 1,
      "scene_id": "01",
      "scene_title": "연결 해설 08",
      "text": "같은 끝 자세에 서로 다른 숫자가 붙을 수 있었습니다.",
      "start": 0.0,
      "end": 3.6
    },
    {
      "index": 2,
      "scene_id": "01",
      "scene_title": "연결 해설 08",
      "text": "그렇다면 끝 자세만으로 지나온 회전 과정도 알 수 있을까요?",
      "start": 3.88,
      "end": 7.5600000000000005
    },
    {
      "index": 3,
      "scene_id": "01",
      "scene_title": "연결 해설 08",
      "text": "이번에는 한 구간의 시간 흐름을 따라가 보죠.",
      "start": 7.840000000000001,
      "end": 10.56
    },
    {
      "index": 4,
      "scene_id": "02",
      "scene_title": "연결 해설 23",
      "text": "계산에서는 엑스 성분이 와이로 돌고 축에 평행한 성분은 남았습니다.",
      "start": 11.01,
      "end": 15.649999999999999
    },
    {
      "index": 5,
      "scene_id": "02",
      "scene_title": "연결 해설 23",
      "text": "이제 실제 몸체의 방향을 관찰하면서, 그 방향을 화면에 보여 주는 카메라 기준과 분리해 생각해 보죠.",
      "start": 15.929999999999998,
      "end": 21.689999999999998
    },
    {
      "index": 6,
      "scene_id": "03",
      "scene_title": "평면의 회전에서 삼차원 축으로",
      "text": "평면의 각도를 배웠죠.",
      "start": 22.139999999999997,
      "end": 23.74
    },
    {
      "index": 7,
      "scene_id": "03",
      "scene_title": "평면의 회전에서 삼차원 축으로",
      "text": "빨간 몸체 선을 보세요.",
      "start": 24.02,
      "end": 25.62
    },
    {
      "index": 8,
      "scene_id": "03",
      "scene_title": "평면의 회전에서 삼차원 축으로",
      "text": "삼차원은 축도 필요합니다.",
      "start": 25.900000000000002,
      "end": 27.580000000000002
    },
    {
      "index": 9,
      "scene_id": "03",
      "scene_title": "평면의 회전에서 삼차원 축으로",
      "text": "축의 세 성분으로 이어가죠.",
      "start": 27.860000000000003,
      "end": 29.540000000000003
    },
    {
      "index": 10,
      "scene_id": "04",
      "scene_title": "변화가 없다는 연산도 입력과 결과로 읽기",
      "text": "끝 자세는 지난 동작 전부를 저장하지 않았죠.",
      "start": 29.990000000000002,
      "end": 32.550000000000004
    },
    {
      "index": 11,
      "scene_id": "04",
      "scene_title": "변화가 없다는 연산도 입력과 결과로 읽기",
      "text": "이번에는 설원에서 몸체와 바퀴를 보세요.",
      "start": 32.830000000000005,
      "end": 35.39000000000001
    },
    {
      "index": 12,
      "scene_id": "04",
      "scene_title": "변화가 없다는 연산도 입력과 결과로 읽기",
      "text": "빨간 몸체 선과 파란 바퀴 선이 경사와 커브에서 함께 바뀝니다.",
      "start": 35.67000000000001,
      "end": 40.39000000000001
    },
    {
      "index": 13,
      "scene_id": "04",
      "scene_title": "변화가 없다는 연산도 입력과 결과로 읽기",
      "text": "항등 회전은 게임 화면 전체가 멈춘다는 뜻이 아닙니다.",
      "start": 40.67000000000001,
      "end": 44.43000000000001
    },
    {
      "index": 14,
      "scene_id": "04",
      "scene_title": "변화가 없다는 연산도 입력과 결과로 읽기",
      "text": "입력 방향에 추가 회전을 주지 않는 연산입니다.",
      "start": 44.71000000000001,
      "end": 47.43000000000001
    },
    {
      "index": 15,
      "scene_id": "04",
      "scene_title": "변화가 없다는 연산도 입력과 결과로 읽기",
      "text": "몸체 선을 입력으로 생각해 보죠.",
      "start": 47.71000000000001,
      "end": 49.71000000000001
    },
    {
      "index": 16,
      "scene_id": "04",
      "scene_title": "변화가 없다는 연산도 입력과 결과로 읽기",
      "text": "그대로 돌려주려면 어떤 네 숫자가 필요할까요?",
      "start": 49.99000000000001,
      "end": 52.87000000000001
    },
    {
      "index": 17,
      "scene_id": "05",
      "scene_title": "되돌리기에서 두 회전의 합성으로",
      "text": "역원은 회전만 상쇄했죠. 빨간 몸체 선과 이동을 따로 보세요.",
      "start": 53.320000000000014,
      "end": 57.960000000000015
    },
    {
      "index": 18,
      "scene_id": "05",
      "scene_title": "되돌리기에서 두 회전의 합성으로",
      "text": "그럼 두 회전을 잇는 계산은요? 다음 편에서 곱으로 확인합니다.",
      "start": 58.240000000000016,
      "end": 62.240000000000016
    },
    {
      "index": 19,
      "scene_id": "06",
      "scene_title": "벡터의 결과에서 중간 자세의 질문으로",
      "text": "벡터를 돌렸죠. 비행으로 바뀝니다.",
      "start": 62.69000000000002,
      "end": 64.93000000000002
    },
    {
      "index": 20,
      "scene_id": "06",
      "scene_title": "벡터의 결과에서 중간 자세의 질문으로",
      "text": "빨간 날개 선을 보세요. 중간 자세는 어떻게 만들까요?",
      "start": 65.21000000000002,
