      "timestamp": [
        3.08,
        3.28
      ]
    },
    {
      "text": " 보기가",
      "timestamp": [
        3.28,
        3.6
      ]
    },
    {
      "text": " 보입니다.",
      "timestamp": [
        3.6,
        4.22
      ]
    },
    {
      "text": " 이어지는",
      "timestamp": [
        4.44,
        4.84
      ]
    },
    {
      "text": " 별도",
      "timestamp": [
        4.84,
        5.28
      ]
    },
    {
      "text": " 장면에서는",
      "timestamp": [
        5.28,
        6.02
      ]
    },
    {
      "text": " 곡선이",
      "timestamp": [
        6.02,
        6.7
      ]
    },
    {
      "text": " 주변",
      "timestamp": [
        6.7,
        7.1
      ]
    },
    {
      "text": " 놀이기구를",
