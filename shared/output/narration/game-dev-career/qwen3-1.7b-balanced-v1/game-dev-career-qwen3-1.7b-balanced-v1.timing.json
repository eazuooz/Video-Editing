  "narration_placement": "continuous-across-example-and-explanation",
  "entries": [
    {
      "index": 1,
      "scene_id": "01",
      "scene_title": "게임을 좋아하는 마음에서 시작",
      "text": "게임을 좋아하는데, 이걸로 먹고살 수 있을까요?",
      "start": 0.25,
      "end": 2.89
    },
    {
      "index": 2,
      "scene_id": "01",
      "scene_title": "게임을 좋아하는 마음에서 시작",
      "text": "처음부터 기획자인지, 프로그래머인지 정하지 못해도 괜찮습니다.",
      "start": 3.05,
      "end": 6.75
    },
    {
      "index": 3,
      "scene_id": "01",
      "scene_title": "게임을 좋아하는 마음에서 시작",
      "text": "게임을 만드는 사람들도 출발은 좋아하는 마음이었을 수 있으니까요.",
      "start": 6.99,
      "end": 10.55
    },
    {
      "index": 4,
      "scene_id": "01",
      "scene_title": "게임을 좋아하는 마음에서 시작",
      "text": "그런데 게임을 오래 해본 것과 만드는 일을 잘하는 것은 조금 다릅니다.",
      "start": 11.01,
      "end": 14.81
    },
    {
      "index": 5,
      "scene_id": "01",
      "scene_title": "게임을 좋아하는 마음에서 시작",
      "text": "플레이어라면 상자를 열고 아이템을 얻으면 끝입니다.",
      "start": 14.97,
      "end": 18.35
    },
    {
      "index": 6,
      "scene_id": "01",
      "scene_title": "게임을 좋아하는 마음에서 시작",
      "text": "개발자는 그 상자가 왜 안 열리는지부터 봐야 하죠.",
      "start": 18.45,
      "end": 21.59
    },
    {
      "index": 7,
      "scene_id": "01",
      "scene_title": "게임을 좋아하는 마음에서 시작",
      "text": "분명 보물을 찾으러 왔는데, 할 일이 네 가지나 나왔습니다.",
      "start": 22.03,
      "end": 25.61
    },
    {
      "index": 8,
      "scene_id": "01",
      "scene_title": "게임을 좋아하는 마음에서 시작",
      "text": "오늘은 상자 하나를 기획, 프로그래밍, 이차원과 삼차원 아트의 시선으로 살펴보겠습니다.",
      "start": 25.41,
      "end": 31.05
    },
    {
      "index": 9,
      "scene_id": "01",
      "scene_title": "게임을 좋아하는 마음에서 시작",
      "text": "포트폴리오를 꾸미는 요령보다, 실제로 무슨 일을 하고 어떤 기본기를 익혀야 하는지에 집중해볼게요.",
      "start": 31.35,
      "end": 37.19
    },
    {
      "index": 10,
      "scene_id": "02",
      "scene_title": "상자 하나에도 여러 사람의 일이",
      "text": "먼저 이 상자를 여는 장면을 보세요.",
      "start": 38.18333333333333,
      "end": 40.16333333333333
    },
    {
      "index": 11,
      "scene_id": "02",
      "scene_title": "상자 하나에도 여러 사람의 일이",
      "text": "누군가는 어디에 놓아야 플레이어가 발견할지 고민합니다.",
      "start": 40.28333333333333,
      "end": 43.94333333333333
    },
    {
      "index": 12,
      "scene_id": "02",
      "scene_title": "상자 하나에도 여러 사람의 일이",
      "text": "누군가는 열쇠를 확인하고 아이템을 넣는 기능을 만듭니다.",
      "start": 44.20333333333333,
      "end": 47.483333333333334
    },
    {
      "index": 13,
      "scene_id": "02",
      "scene_title": "상자 하나에도 여러 사람의 일이",
      "text": "또 누군가는 그림으로 모양을 정하고, 입체로 만들어 뚜껑이 열리게 합니다.",
      "start": 47.78333333333333,
      "end": 51.883333333333326
    },
    {
      "index": 14,
      "scene_id": "02",
      "scene_title": "상자 하나에도 여러 사람의 일이",
      "text": "결과는 상자 하나지만, 만드는 동안에는 서로 다른 질문을 해결한 겁니다.",
      "start": 52.023333333333326,
      "end": 56.58333333333333
    },
    {
      "index": 15,
      "scene_id": "02",
      "scene_title": "상자 하나에도 여러 사람의 일이",
      "text": "다만 실제 회사에서는 팀 규모와 장르에 따라 업무를 나눕니다.",
      "start": 56.78333333333333,
      "end": 60.66333333333333
    },
    {
      "index": 16,
      "scene_id": "02",
      "scene_title": "상자 하나에도 여러 사람의 일이",
      "text": "아트 안에서도 캐릭터, 배경, 인터페이스와 애니메이션은 서로 다른 분야일 수 있습니다.",
      "start": 60.72333333333333,
      "end": 65.90333333333334
    },
    {
      "index": 17,
      "scene_id": "02",
      "scene_title": "상자 하나에도 여러 사람의 일이",
      "text": "오늘의 네 구분은 입문자를 위한 지도입니다. 한 사람이 전부 능숙해야 한다는 체크리스트는 아닙니다.",
      "start": 65.80333333333333,
      "end": 71.62333333333333
    },
    {
      "index": 18,
      "scene_id": "03",
      "scene_title": "기획 — 아이디어를 같은 뜻으로 전달하기",
      "text": "기획자는 재미있는 아이디어를 떠올리는 데서 멈추지 않습니다.",
      "start": 72.68333333333334,
      "end": 76.16333333333334
    },
    {
      "index": 19,
      "scene_id": "03",
      "scene_title": "기획 — 아이디어를 같은 뜻으로 전달하기",
      "text": "그 아이디어를 팀이 같은 뜻으로 이해하고 만들 수 있게 정리합니다.",
      "start": 76.50333333333333,
      "end": 80.14333333333333
    },
    {
      "index": 20,
      "scene_id": "03",
      "scene_title": "기획 — 아이디어를 같은 뜻으로 전달하기",
      "text": "상자를 열면 좋은 보상을 준다고 써봅시다. 얼핏 다 된 것 같죠?",
      "start": 80.36333333333334,
      "end": 84.32333333333334
    },
    {
      "index": 21,
      "scene_id": "03",
      "scene_title": "기획 — 아이디어를 같은 뜻으로 전달하기",
      "text": "그런데 좋은 보상이 뭔가요? 아무 때나 열리나요? 열쇠는 사라지나요?",
      "start": 84.82333333333334,
      "end": 89.36333333333334
    },
    {
      "index": 22,
      "scene_id": "03",
      "scene_title": "기획 — 아이디어를 같은 뜻으로 전달하기",
      "text": "가방이 가득 찼거나 이미 열린 상자를 다시 누르면 어떻게 해야 할까요?",
      "start": 89.44333333333334,
      "end": 93.44333333333334
    },
    {
      "index": 23,
      "scene_id": "03",
      "scene_title": "기획 — 아이디어를 같은 뜻으로 전달하기",
      "text": "이런 조건과 결과, 예외를 구분해 적는 것이 문서 작성의 기본입니다.",
      "start": 93.64333333333335,
      "end": 98.00333333333333
    },
    {
      "index": 24,
      "scene_id": "03",
      "scene_title": "기획 — 아이디어를 같은 뜻으로 전달하기",
      "text": "문서가 예쁜 것보다, 읽은 사람들이 서로 다른 게임을 만들지 않는 것이 중요하죠.",
      "start": 98.26333333333334,
      "end": 102.60333333333334
    },
    {
      "index": 25,
      "scene_id": "03",
      "scene_title": "기획 — 아이디어를 같은 뜻으로 전달하기",
      "text": "문장과 표, 간단한 흐름도로 기능 하나를 설명하는 연습부터 해보세요.",
      "start": 102.68333333333334,
      "end": 107.56333333333333
    },
    {
      "index": 26,
      "scene_id": "03",
      "scene_title": "기획 — 아이디어를 같은 뜻으로 전달하기",
      "text": "보상과 성장 수치를 다룬다면 비율과 확률, 평균을 이해하고 표에서 바꿔보는 연습도 도움이 됩니다.",
      "start": 107.84333333333333,
      "end": 113.98333333333333
    },
    {
      "index": 27,
      "scene_id": "03",
      "scene_title": "기획 — 아이디어를 같은 뜻으로 전달하기",
      "text": "그리고 직접 플레이를 관찰합니다. 의도한 곳에서 상자를 찾았는지, 보상을 받고 더 하고 싶어 하는지 보는 거죠.",
      "start": 114.26333333333334,
      "end": 120.58333333333334
    },
    {
      "index": 28,
      "scene_id": "03",
      "scene_title": "기획 — 아이디어를 같은 뜻으로 전달하기",
      "text": "기획서는 생각을 고정하는 종이가 아니라, 만들어보고 고칠 때 팀이 함께 보는 기준입니다.",
      "start": 120.86333333333334,
      "end": 125.86333333333334
    },
    {
      "index": 29,
      "scene_id": "04",
      "scene_title": "프로그래밍 — C++로 데이터와 흐름 읽기",
      "text": "프로그래머는 기획한 규칙을 컴퓨터가 일관되게 처리하도록 만듭니다.",
      "start": 126.86666666666666,
      "end": 131.50666666666666
    },
    {
      "index": 30,
      "scene_id": "04",
      "scene_title": "프로그래밍 — C++로 데이터와 흐름 읽기",
      "text": "여기서는 기초 씨 플러스 플러스를 대표적인 출발점으로 삼아볼게요.",
      "start": 131.72666666666666,
      "end": 136.22666666666666
    },
    {
      "index": 31,
      "scene_id": "04",
      "scene_title": "프로그래밍 — C++로 데이터와 흐름 읽기",
      "text": "상자가 열렸는지, 열쇠가 몇 개인지, 아이템이 어디에 들어가는지.",
      "start": 136.36666666666667,
      "end": 140.38666666666666
    },
    {
      "index": 32,
      "scene_id": "04",
      "scene_title": "프로그래밍 — C++로 데이터와 흐름 읽기",
      "text": "이런 상태를 변수와 자료형으로 표현합니다.",
      "start": 140.92666666666665,
      "end": 143.74666666666667
    },
    {
      "index": 33,
      "scene_id": "04",
      "scene_title": "프로그래밍 — C++로 데이터와 흐름 읽기",
      "text": "조건문은 열어도 되는지 판단하고, 반복문과 함수는 필요한 처리를 구성합니다.",
      "start": 144.18666666666667,
      "end": 149.08666666666664
    },
    {
      "index": 34,
      "scene_id": "04",
      "scene_title": "프로그래밍 — C++로 데이터와 흐름 읽기",
      "text": "처음에는 코드를 많이 입력하는 것보다 한 줄 실행한 뒤 무엇이 바뀌었는지 설명해보세요.",
      "start": 149.08666666666664,
      "end": 154.48666666666665
    },
    {
      "index": 35,
      "scene_id": "04",
      "scene_title": "프로그래밍 — C++로 데이터와 흐름 읽기",
      "text": "조금 더 나아가면 참조와 포인터, 객체가 생기고 사라지는 시점도 이해해야 합니다.",
      "start": 154.34666666666666,
      "end": 159.58666666666664
    },
    {
      "index": 36,
      "scene_id": "04",
      "scene_title": "프로그래밍 — C++로 데이터와 흐름 읽기",
      "text": "존재하지 않는 물건을 계속 가리키면 곤란하니까요.",
      "start": 159.78666666666666,
      "end": 162.60666666666665
    },
    {
      "index": 37,
      "scene_id": "04",
      "scene_title": "프로그래밍 — C++로 데이터와 흐름 읽기",
      "text": "자원 관리를 배울 때는 직접 해제하는 방법만이 아니라, 객체의 수명과 함께 안전하게 정리하는 방식도 익힙니다.",
      "start": 162.78666666666666,
      "end": 169.86666666666667
    },
    {
      "index": 38,
      "scene_id": "04",
      "scene_title": "프로그래밍 — C++로 데이터와 흐름 읽기",
      "text": "물론 모든 게임이 같은 언어를 쓰는 것은 아닙니다. 환경에 따라 언어는 달라도 데이터와 실행 흐름을 읽는 기본기는 이어집니다.",
      "start": 170.22666666666666,
      "end": 177.32666666666665
    },
    {
      "index": 39,
      "scene_id": "05",
      "scene_title": "프로그래밍 — 저장하고 찾고 고치기",
      "text": "이제 상자에서 얻은 아이템을 가방에 넣어보겠습니다.",
      "start": 178.31666666666666,
      "end": 181.61666666666667
    },
    {
      "index": 40,
      "scene_id": "05",
      "scene_title": "프로그래밍 — 저장하고 찾고 고치기",
      "text": "아이템이 몇 개 없을 때는 앞에서부터 하나씩 찾아도 괜찮아 보입니다.",
      "start": 181.87666666666667,
      "end": 186.05666666666667
    },
    {
      "index": 41,
      "scene_id": "05",
      "scene_title": "프로그래밍 — 저장하고 찾고 고치기",
      "text": "그런데 수가 늘어나고, 같은 검색을 자주 한다면 어떨까요?",
      "start": 186.39666666666668,
      "end": 190.05666666666667
    },
    {
      "index": 42,
      "scene_id": "05",
      "scene_title": "프로그래밍 — 저장하고 찾고 고치기",
      "text": "자료구조는 데이터를 어떤 모양으로 저장할지, 알고리즘은 어떤 순서로 처리할지에 관한 공부입니다.",
      "start": 190.35666666666665,
      "end": 196.73666666666668
    },
    {
      "index": 43,
      "scene_id": "05",
      "scene_title": "프로그래밍 — 저장하고 찾고 고치기",
      "text": "배열이나 벡터, 큐와 해시 테이블처럼 서로 다른 구조를 작은 예제로 비교해보세요.",
      "start": 197.13666666666666,
      "end": 202.53666666666666
    },
    {
      "index": 44,
      "scene_id": "05",
      "scene_title": "프로그래밍 — 저장하고 찾고 고치기",
      "text": "무조건 하나가 최고가 아니라, 자주 하는 작업과 필요한 순서에 따라 선택이 달라집니다.",
      "start": 202.59666666666666,
      "end": 207.23666666666668
    },
    {
      "index": 45,
      "scene_id": "05",
      "scene_title": "프로그래밍 — 저장하고 찾고 고치기",
      "text": "검색과 정렬을 구현하면서 데이터가 늘 때 해야 할 일이 얼마나 늘어나는지도 봅니다.",
      "start": 207.21666666666667,
      "end": 212.13666666666666
    },
    {
      "index": 46,
      "scene_id": "05",
      "scene_title": "프로그래밍 — 저장하고 찾고 고치기",
      "text": "그리고 상자를 두 번 눌렀더니 보상이 두 번 들어갔다면, 이제 디버깅 차례입니다.",
      "start": 212.41666666666666,
      "end": 217.01666666666665
    },
    {
      "index": 47,
      "scene_id": "05",
      "scene_title": "프로그래밍 — 저장하고 찾고 고치기",
      "text": "증상을 다시 만들고, 중단점을 걸고, 상자의 상태와 아이템 수를 차례로 확인합니다.",
      "start": 217.27666666666667,
      "end": 222.31666666666666
    },
    {
      "index": 48,
      "scene_id": "05",
      "scene_title": "프로그래밍 — 저장하고 찾고 고치기",
      "text": "수정한 뒤에는 정상 입력만이 아니라 연속 클릭이나 가방이 찬 경우도 다시 시험합니다.",
      "start": 222.41666666666666,
      "end": 227.29666666666665
    },
    {
      "index": 49,
      "scene_id": "05",
      "scene_title": "프로그래밍 — 저장하고 찾고 고치기",
      "text": "잘 돌아간다는 말에는, 안 돌아갈 때 이유를 찾아 고칠 수 있다는 뜻도 들어가야 합니다.",
      "start": 227.45666666666665,
      "end": 232.25666666666666
    },
    {
      "index": 50,
      "scene_id": "06",
      "scene_title": "2D 아트 — 관찰과 도형화에서 시작하기",
      "text": "이차원 아트에서는 상자가 어떻게 보여야 하는지부터 생각합니다.",
      "start": 233.68,
      "end": 237.13333333333333
    },
    {
      "index": 51,
      "scene_id": "06",
      "scene_title": "2D 아트 — 관찰과 도형화에서 시작하기",
      "text": "멋진 장식부터 그리고 싶지만, 뚜껑이 몸통보다 이상하게 크면 먼저 눈에 들어오죠.",
      "start": 237.29333333333332,
      "end": 242.81333333333333
    },
    {
      "index": 52,
      "scene_id": "06",
      "scene_title": "2D 아트 — 관찰과 도형화에서 시작하기",
      "text": "기본은 대상을 관찰하고 큰 형태로 나누는 연습입니다.",
      "start": 243.13333333333333,
      "end": 246.27333333333334
    },
    {
      "index": 53,
      "scene_id": "06",
      "scene_title": "2D 아트 — 관찰과 도형화에서 시작하기",
      "text": "이 상자는 커다란 상자와 얇은 뚜껑으로 단순하게 볼 수 있습니다.",
      "start": 246.49333333333334,
      "end": 250.37333333333333
    },
    {
      "index": 54,
      "scene_id": "06",
      "scene_title": "2D 아트 — 관찰과 도형화에서 시작하기",
      "text": "덩어리의 크기와 방향을 잡고, 원근을 맞춰 어느 면을 보고 있는지 정리합니다.",
      "start": 250.69333333333333,
      "end": 255.17333333333335
    },
    {
      "index": 55,
      "scene_id": "06",
      "scene_title": "2D 아트 — 관찰과 도형화에서 시작하기",
      "text": "그다음 빛의 방향에 따라 밝은 면과 어두운 면을 나눕니다.",
      "start": 255.53333333333333,
      "end": 258.9533333333333
    },
    {
      "index": 56,
      "scene_id": "06",
      "scene_title": "2D 아트 — 관찰과 도형화에서 시작하기",
      "text": "세부 무늬를 넣기 전에 흑백으로도 형태가 읽히는지 확인해보세요.",
      "start": 259.25333333333333,
      "end": 262.7733333333333
    },
    {
      "index": 57,
      "scene_id": "06",
      "scene_title": "2D 아트 — 관찰과 도형화에서 시작하기",
      "text": "마지막으로 실제 게임 화면 크기로 줄여봅니다. 확대하면 멋진데 작아지면 바위와 구분이 안 될 수도 있으니까요.",
      "start": 262.55333333333334,
      "end": 269.97333333333336
    },
    {
      "index": 58,
      "scene_id": "06",
      "scene_title": "2D 아트 — 관찰과 도형화에서 시작하기",
      "text": "캐릭터를 그린다면 인체와 제스처, 배경이라면 공간과 구도처럼 분야에 맞게 기본기를 넓혀갑니다.",
      "start": 270.31333333333333,
      "end": 276.3333333333333
    },
    {
      "index": 59,
      "scene_id": "06",
      "scene_title": "2D 아트 — 관찰과 도형화에서 시작하기",
      "text": "툴의 버튼을 아는 것과 무엇을 어떻게 그려야 하는지 판단하는 능력은 함께 길러야 합니다.",
      "start": 276.5133333333333,
      "end": 281.81333333333333
    },
    {
      "index": 60,
      "scene_id": "07",
      "scene_title": "3D 아트 — 여러 각도와 실제 동작 확인하기",
      "text": "삼차원 아트는 그 형태를 입체로 만들고 게임 안에서 쓸 수 있게 다듬습니다.",
      "start": 283.09000000000003,
      "end": 287.4566666666667
    },
    {
      "index": 61,
      "scene_id": "07",
      "scene_title": "3D 아트 — 여러 각도와 실제 동작 확인하기",
      "text": "정면 사진 한 장만 괜찮다고 끝은 아닙니다. 옆과 뒤에서 봐도 비례가 자연스러워야 하죠.",
      "start": 287.87666666666667,
      "end": 293.75666666666666
    },
    {
      "index": 62,
      "scene_id": "07",
      "scene_title": "3D 아트 — 여러 각도와 실제 동작 확인하기",
      "text": "처음에는 큰 덩어리로 시작하고, 필요한 면의 구조를 정리합니다.",
      "start": 294.4166666666667,
      "end": 298.31666666666666
    },
    {
      "index": 63,
      "scene_id": "07",
      "scene_title": "3D 아트 — 여러 각도와 실제 동작 확인하기",
      "text": "면을 무조건 많이 넣거나 적게 넣는 것보다, 실루엣과 움직임, 성능 조건에 맞는지가 중요합니다.",
      "start": 298.8966666666667,
      "end": 304.5166666666667
    },
    {
      "index": 64,
      "scene_id": "07",
      "scene_title": "3D 아트 — 여러 각도와 실제 동작 확인하기",
      "text": "표면을 펼치는 유브이, 표면 정보를 담는 텍스처, 빛에 반응하는 재질도 구분해서 배웁니다.",
      "start": 305.2166666666667,
      "end": 310.6566666666667
    },
    {
      "index": 65,
      "scene_id": "07",
      "scene_title": "3D 아트 — 여러 각도와 실제 동작 확인하기",
      "text": "이름이 한꺼번에 나오니 복잡하지만, 상자 하나에 차례로 적용해보면 역할이 보입니다.",
      "start": 310.8966666666667,
      "end": 315.93666666666667
    },
    {
      "index": 66,
      "scene_id": "07",
      "scene_title": "3D 아트 — 여러 각도와 실제 동작 확인하기",
      "text": "그리고 이 뚜껑을 보세요. 회전축이 가운데 있으면 우리가 원한 방식으로 열리지 않습니다.",
      "start": 316.2766666666667,
      "end": 321.37666666666667
    },
    {
      "index": 67,
      "scene_id": "07",
      "scene_title": "3D 아트 — 여러 각도와 실제 동작 확인하기",
      "text": "경첩 쪽으로 축을 맞추고, 게임에 넣을 크기와 방향도 확인해야 합니다.",
      "start": 321.5766666666667,
      "end": 325.75666666666666
    },
    {
      "index": 68,
      "scene_id": "07",
      "scene_title": "3D 아트 — 여러 각도와 실제 동작 확인하기",
      "text": "삼차원 아티스트가 모두 전문 일러스트레이터처럼 그려야 한다는 뜻은 아닙니다.",
      "start": 325.5966666666667,
      "end": 330.31666666666666
    },
    {
      "index": 69,
      "scene_id": "07",
      "scene_title": "3D 아트 — 여러 각도와 실제 동작 확인하기",
      "text": "중요한 것은 형태를 관찰하고, 공간에서 무엇이 어색한지 판단하는 기본기입니다.",
      "start": 330.7366666666667,
      "end": 335.2966666666667
    },
    {
      "index": 70,
      "scene_id": "08",
      "scene_title": "함께 만드는 일 — 관찰하고 전달하고 수정하기",
      "text": "이제 각자 만든 것을 한 장면에 모아봅시다.",
      "start": 336.3,
      "end": 338.86
    },
    {
      "index": 71,
      "scene_id": "08",
      "scene_title": "함께 만드는 일 — 관찰하고 전달하고 수정하기",
      "text": "그림도 멋지고 기능도 작동하는데, 플레이어가 상자를 못 보고 지나갑니다.",
      "start": 339.1,
      "end": 343.36
    },
    {
      "index": 72,
      "scene_id": "08",
      "scene_title": "함께 만드는 일 — 관찰하고 전달하고 수정하기",
      "text": "이건 누구 한 사람의 실력만으로 단정할 문제가 아닙니다.",
      "start": 343.6,
      "end": 346.68
    },
    {
      "index": 73,
      "scene_id": "08",
      "scene_title": "함께 만드는 일 — 관찰하고 전달하고 수정하기",
      "text": "배치가 문제인지, 배경과 구분이 안 되는지, 카메라에서 너무 작은지 함께 살펴봐야 합니다.",
      "start": 346.92,
      "end": 352.06
    },
    {
      "index": 74,
      "scene_id": "08",
      "scene_title": "함께 만드는 일 — 관찰하고 전달하고 수정하기",
      "text": "기획자는 위치와 보상을 다시 보고, 아티스트는 형태와 대비를 확인하고, 프로그래머는 필요한 동작을 고칩니다.",
      "start": 352.6,
      "end": 359.28000000000003
    },
    {
      "index": 75,
      "scene_id": "08",
      "scene_title": "함께 만드는 일 — 관찰하고 전달하고 수정하기",
      "text": "여기서 중요한 공통 기본기가 관찰과 소통입니다.",
      "start": 359.58000000000004,
      "end": 362.92
    },
    {
      "index": 76,
      "scene_id": "08",
      "scene_title": "함께 만드는 일 — 관찰하고 전달하고 수정하기",
      "text": "그냥 이상해요보다, 어느 상황에서 무엇이 달라지는지 보여주는 편이 도움이 됩니다.",
      "start": 362.76,
      "end": 367.94
    },
    {
      "index": 77,
      "scene_id": "08",
      "scene_title": "함께 만드는 일 — 관찰하고 전달하고 수정하기",
      "text": "무엇을 바꿨고 왜 바꿨는지 남기면 다음 사람이 이어받기도 쉽습니다.",
      "start": 368.40000000000003,
      "end": 372.16
    },
    {
      "index": 78,
      "scene_id": "08",
      "scene_title": "함께 만드는 일 — 관찰하고 전달하고 수정하기",
      "text": "혼자 개발하더라도 이 질문들은 사라지지 않습니다. 혼자서 모자를 바꿔 쓰며 해결하는 거죠.",
      "start": 372.36,
      "end": 377.64
    },
    {
      "index": 79,
      "scene_id": "08",
      "scene_title": "함께 만드는 일 — 관찰하고 전달하고 수정하기",
      "text": "작은 기능을 끝까지 완성한다는 건 화면이 한 번 나오는 것을 넘어, 의도대로 쓰이는지 확인하는 일입니다.",
      "start": 378.02,
      "end": 383.94
    },
    {
      "index": 80,
      "scene_id": "09",
      "scene_title": "결론 — 좋아하는 마음을 만드는 힘으로",
      "text": "게임 개발로 먹고살고 싶다면, 처음부터 모든 분야를 다 배우려고 하지는 마세요.",
      "start": 384.96666666666664,
      "end": 389.32666666666665
    },
    {
      "index": 81,
      "scene_id": "09",
      "scene_title": "결론 — 좋아하는 마음을 만드는 힘으로",
      "text": "기획이 궁금하면 익숙한 기능 하나의 규칙을 한 페이지로 적어봅시다.",
      "start": 389.58666666666664,
      "end": 393.58666666666664
    },
    {
      "index": 82,
      "scene_id": "09",
      "scene_title": "결론 — 좋아하는 마음을 만드는 힘으로",
      "text": "프로그래밍이 궁금하면 작은 인벤토리를 만들고, 저장과 검색이 어떻게 돌아가는지 설명해보세요.",
      "start": 393.82666666666665,
      "end": 399.4866666666666
    },
    {
      "index": 83,
      "scene_id": "09",
      "scene_title": "결론 — 좋아하는 마음을 만드는 힘으로",
      "text": "아트가 궁금하면 주변 사물 하나를 큰 도형으로 관찰하고, 그림이나 입체로 만들어봅시다.",
      "start": 399.7466666666666,
      "end": 404.88666666666666
    },
    {
      "index": 84,
      "scene_id": "09",
      "scene_title": "결론 — 좋아하는 마음을 만드는 힘으로",
      "text": "만들다 막히면 필요한 기본기로 돌아오고, 배운 것을 다시 적용합니다.",
      "start": 405.14666666666665,
      "end": 409.20666666666665
    },
    {
      "index": 85,
      "scene_id": "09",
      "scene_title": "결론 — 좋아하는 마음을 만드는 힘으로",
      "text": "기본기를 전부 끝낼 때까지 아무것도 만들지 않는 것도, 도구만 바꾸며 기초를 건너뛰는 것도 피하면 좋겠습니다.",
      "start": 409.12666666666667,
      "end": 415.72666666666663
    },
    {
      "index": 86,
      "scene_id": "09",
      "scene_title": "결론 — 좋아하는 마음을 만드는 힘으로",
      "text": "회사에서 함께 일하는 길도, 작은 팀이나 혼자 만드는 길도 있습니다.",
      "start": 416.06666666666666,
      "end": 419.90666666666664
    },
    {
      "index": 87,
      "scene_id": "09",
      "scene_title": "결론 — 좋아하는 마음을 만드는 힘으로",
      "text": "어느 쪽이든 게임 하나를 만들었다고 취업이나 수입이 보장되는 것은 아닙니다.",
      "start": 420.02666666666664,
      "end": 424.0466666666666
    },
    {
      "index": 88,
      "scene_id": "09",
      "scene_title": "결론 — 좋아하는 마음을 만드는 힘으로",
      "text": "하지만 내가 어떤 일을 좋아하고, 무엇을 더 배워야 하는지는 직접 해볼수록 구체적으로 보입니다.",
      "start": 424.14666666666665,
      "end": 429.64666666666665
    },
    {
      "index": 89,
      "scene_id": "09",
      "scene_title": "결론 — 좋아하는 마음을 만드는 힘으로",
      "text": "좋아하는 게임에서 한 걸음 더. 이번에는 여러분이 만드는 쪽으로 가봅시다.",
      "start": 429.8666666666666,
      "end": 433.50666666666666
    }
