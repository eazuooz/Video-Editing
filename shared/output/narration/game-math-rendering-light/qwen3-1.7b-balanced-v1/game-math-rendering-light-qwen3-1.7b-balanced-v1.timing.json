  "entries": [
    {
      "index": 1,
      "scene_id": "01",
      "scene_title": "화면의 한 점은 어떻게 색을 얻을까요?",
      "text": "화면의 한 점에 어떤 표면이 보이고, 그 표면은 왜 그 색과 밝기로 보일까요?",
      "start": 0.0,
      "end": 5.42,
      "voice_start": 0.0,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 2,
      "scene_id": "01",
      "scene_title": "화면의 한 점은 어떻게 색을 얻을까요?",
      "text": "먼저 실제 게임에서 가려지는 물체를 보고, 보이는 표면을 고르는 방법부터 구분합니다.",
      "start": 5.88,
      "end": 11.32,
      "voice_start": 5.88,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 3,
      "scene_id": "01",
      "scene_title": "화면의 한 점은 어떻게 색을 얻을까요?",
      "text": "이어서 빛의 양과 단위를 손으로 계산하고, 재질과 시선이 반사를 어떻게 바꾸는지 설명하겠습니다.",
      "start": 11.58,
      "end": 17.96,
      "voice_start": 11.58,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 4,
      "scene_id": "01",
      "scene_title": "화면의 한 점은 어떻게 색을 얻을까요?",
      "text": "마지막에는 이 요소를 렌더링 방정식으로 연결하고, 간단한 밝기 계산을 직접 풀어 보겠습니다.",
      "start": 18.38,
      "end": 24.54,
      "voice_start": 18.38,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 5,
      "scene_id": "02",
      "scene_title": "바위 뒤의 캐릭터가 사라지는 이유",
      "text": "빅 워크에서 다른 캐릭터를 따라 바위와 나무 사이를 걸어갑니다. 캐릭터와 앞쪽 바위가 겹치는 부분을 보세요.",
      "start": 25.009999999999998,
      "end": 32.83,
      "voice_start": 25.009999999999998,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 6,
      "scene_id": "02",
      "scene_title": "바위 뒤의 캐릭터가 사라지는 이유",
      "text": "카메라가 움직이면 보이던 몸이 바위 뒤로 가려졌다가 다시 나타납니다. 화면의 같은 위치를 여러 표면이 차지하려고 합니다.",
      "start": 33.17,
      "end": 41.11,
      "voice_start": 33.17,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 7,
      "scene_id": "02",
      "scene_title": "바위 뒤의 캐릭터가 사라지는 이유",
      "text": "불투명한 표면이라면 카메라에서 그 방향으로 가장 먼저 만나는 표면이 보입니다. 뒤의 물체가 없어졌다는 뜻은 아닙니다.",
      "start": 41.61,
      "end": 49.31,
      "voice_start": 41.61,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 8,
      "scene_id": "02",
      "scene_title": "바위 뒤의 캐릭터가 사라지는 이유",
      "text": "가까운 표면을 고르는 문제와, 선택한 표면을 밝게 만드는 문제는 구분할 수 있습니다.",
      "start": 49.31,
      "end": 55.209999999999994,
      "voice_start": 49.31,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 9,
      "scene_id": "02",
      "scene_title": "바위 뒤의 캐릭터가 사라지는 이유",
      "text": "빛을 더 켜도 앞의 불투명한 바위가 자동으로 투명해지는 것은 아닙니다. 먼저 어떤 표면을 계산할지 알아야 합니다.",
      "start": 55.83,
      "end": 63.43,
      "voice_start": 55.83,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 10,
      "scene_id": "02",
      "scene_title": "바위 뒤의 캐릭터가 사라지는 이유",
      "text": "이 게임의 내부 코드를 추측하지 않고, 같은 가림을 만드는 두 가지 기본 접근을 원래 도식으로 비교하겠습니다.",
      "start": 63.75,
      "end": 70.11,
      "voice_start": 63.75,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 11,
      "scene_id": "03",
      "scene_title": "픽셀에서 출발할까, 삼각형에서 출발할까?",
      "text": "렌더링의 출력은 픽셀마다 색을 가진 영상입니다. 프레임 버퍼에는 이 결과를 저장하고, 표시 전에 후처리를 더할 수도 있습니다.",
      "start": 70.58,
      "end": 78.72,
      "voice_start": 70.58,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 12,
      "scene_id": "03",
      "scene_title": "픽셀에서 출발할까, 삼각형에서 출발할까?",
      "text": "광선 방식은 화면의 표본에서 카메라 광선을 만듭니다. 장면과 교차 검사한 뒤, 가장 가까운 유효 교점을 찾습니다.",
      "start": 78.98,
      "end": 86.92,
      "voice_start": 78.98,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 13,
      "scene_id": "03",
      "scene_title": "픽셀에서 출발할까, 삼각형에서 출발할까?",
      "text": "교점이 있으면 위치, 법선, 재질로 카메라 쪽 빛을 계산합니다. 아무것도 만나지 않으면 배경을 사용합니다.",
      "start": 87.24,
      "end": 94.56,
      "voice_start": 87.24,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 14,
      "scene_id": "03",
      "scene_title": "픽셀에서 출발할까, 삼각형에서 출발할까?",
      "text": "래스터 방식은 삼각형에서 출발합니다. 화면에 투영한 삼각형이 어떤 표본을 덮는지 찾고, 깊이를 비교합니다.",
      "start": 94.57333333333332,
      "end": 101.58,
      "voice_start": 94.57333333333332,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 15,
      "scene_id": "03",
      "scene_title": "픽셀에서 출발할까, 삼각형에서 출발할까?",
      "text": "바깥 순서가 화면 표본인지, 장면의 삼각형인지가 다른 것입니다. 둘 다 가시성과 셰이딩이라는 질문을 해결합니다.",
      "start": 101.92,
      "end": 109.06,
      "voice_start": 101.92,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 16,
      "scene_id": "03",
      "scene_title": "픽셀에서 출발할까, 삼각형에서 출발할까?",
      "text": "픽셀마다 반드시 광선 한 개만 쓰는 것은 아닙니다. 여러 표본으로 경계 등을 계산할 수 있고, 광선을 쓴다는 사실만으로 빛이 정확해지지도 않습니다.",
      "start": 109.24,
      "end": 118.16,
      "voice_start": 109.24,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 17,
      "scene_id": "04",
      "scene_title": "깊이 8과 3을 순서대로 비교하기",
      "text": "같은 표본을 빨간 삼각형과 파란 삼각형이 덮는 예제입니다. 가까울수록 값이 작다고 약속하고, 깊이를 각각 팔과 삼으로 둡니다.",
      "start": 118.63000000000001,
      "end": 128.07000000000002,
      "voice_start": 118.63000000000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 18,
      "scene_id": "04",
      "scene_title": "깊이 8과 3을 순서대로 비교하기",
      "text": "처음 깊이는 무한대로 둡니다. 빨간 삼각형 팔을 먼저 넣으면 통과합니다. 다음 파란 삼각형 삼이 더 가까워 색과 깊이를 교체합니다.",
      "start": 128.41,
      "end": 137.55,
      "voice_start": 128.41,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 19,
      "scene_id": "04",
      "scene_title": "깊이 8과 3을 순서대로 비교하기",
      "text": "순서를 바꾸면 파란 삼각형 삼이 먼저 기록됩니다. 뒤에 온 빨간 삼각형 팔은 더 멀기 때문에 버립니다.",
      "start": 137.93,
      "end": 144.65,
      "voice_start": 137.93,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 20,
      "scene_id": "04",
      "scene_title": "깊이 8과 3을 순서대로 비교하기",
      "text": "두 순서 모두 결과는 파란색과 깊이 삼입니다. 불투명한 표면과 유효한 비교 규칙에서 순서가 달라도 최근접 표면을 고릅니다.",
      "start": 145.05,
      "end": 153.81,
      "voice_start": 145.05,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 21,
      "scene_id": "04",
      "scene_title": "깊이 8과 3을 순서대로 비교하기",
      "text": "이 숫자는 원리를 위한 예제입니다. 실제 깊이 버퍼는 보통 거리를 그대로 저장하지 않고, 투영 뒤에 변환된 깊이를 저장합니다.",
      "start": 154.41000000000003,
      "end": 162.39000000000001,
      "voice_start": 154.41000000000003,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 22,
      "scene_id": "04",
      "scene_title": "깊이 8과 3을 순서대로 비교하기",
      "text": "멀수록 작게 저장하는 반전 깊이도 있습니다. 초기 값과 비교 방향을 함께 정해야 하며, 깊이가 같을 때의 규칙도 별도로 필요합니다.",
      "start": 162.75,
      "end": 171.17000000000002,
      "voice_start": 162.75,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 23,
      "scene_id": "05",
      "scene_title": "구멍으로 보이는 것과 투명하게 보이는 것",
      "text": "노란 구조물의 둥근 구멍으로 다른 캐릭터가 보입니다. 구멍 앞의 벽과 구멍 안의 배경을 구분해 보세요.",
      "start": 171.64,
      "end": 178.0,
      "voice_start": 171.64,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 24,
      "scene_id": "05",
      "scene_title": "구멍으로 보이는 것과 투명하게 보이는 것",
      "text": "구멍에는 막는 벽 표면이 없기 때문에 뒤의 표면을 볼 수 있습니다. 불투명한 벽 한 장의 색을 흐리게 만든 경우와 다릅니다.",
      "start": 178.29999999999998,
      "end": 185.76,
      "voice_start": 178.29999999999998,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 25,
      "scene_id": "05",
      "scene_title": "구멍으로 보이는 것과 투명하게 보이는 것",
      "text": "다음 장면에서는 손으로 투명한 상자 가까이를 살펴봅니다. 상자의 표면과 안쪽 빨간 모양이 함께 보입니다.",
      "start": 186.07999999999998,
      "end": 192.6,
      "voice_start": 186.07999999999998,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 26,
      "scene_id": "05",
      "scene_title": "구멍으로 보이는 것과 투명하게 보이는 것",
      "text": "투명한 물체는 앞 표면 하나만 고르고 끝낼 수 없습니다. 뒤에서 오는 빛과 투과, 경우에 따라 굴절까지 함께 생각해야 합니다.",
      "start": 192.82,
      "end": 200.56,
      "voice_start": 192.82,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 27,
      "scene_id": "05",
      "scene_title": "구멍으로 보이는 것과 투명하게 보이는 것",
      "text": "화면에 보이는 이 차이가 설명의 출발점입니다. 게임이 어떤 투명 렌더링 기법을 썼는지는 이 화면만으로 확정하지 않습니다.",
      "start": 200.56,
      "end": 208.17999999999998,
      "voice_start": 200.56,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 28,
      "scene_id": "06",
      "scene_title": "포워드와 디퍼드는 계산을 묶는 순서입니다",
      "text": "포워드 방식은 삼각형을 처리하며 필요한 재질과 조명을 계산해서 색을 기록합니다. 깊이 검사와 셰이딩의 실제 실행 순서는 최적화에 따라 달라질 수 있습니다.",
      "start": 208.64999999999998,
      "end": 218.90999999999997,
      "voice_start": 208.96999999999997,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 29,
      "scene_id": "06",
      "scene_title": "포워드와 디퍼드는 계산을 묶는 순서입니다",
      "text": "디퍼드 방식은 먼저 보이는 표면 정보를 저장합니다. 위치나 깊이, 법선, 재질 정보를 모은 지 버퍼를 생각하세요.",
      "start": 218.97374999999997,
      "end": 226.80999999999997,
      "voice_start": 218.97374999999997,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 30,
      "scene_id": "06",
      "scene_title": "포워드와 디퍼드는 계산을 묶는 순서입니다",
      "text": "다음 패스에서 이 정보를 읽고 여러 광원의 기여를 계산합니다. 삼각형 표면을 처리하는 단계와 조명을 계산하는 단계를 나눈 것입니다.",
      "start": 227.32999999999998,
      "end": 236.08999999999997,
      "voice_start": 227.32999999999998,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 31,
      "scene_id": "06",
      "scene_title": "포워드와 디퍼드는 계산을 묶는 순서입니다",
      "text": "광원이 많을 때 표면 정보를 다시 처리하는 비용을 줄일 수 있습니다. 대신 여러 버퍼의 메모리와 대역폭, 투명 물체 처리 같은 비용이 있습니다.",
      "start": 236.08999999999997,
      "end": 245.26999999999998,
      "voice_start": 236.08999999999997,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 32,
      "scene_id": "06",
      "scene_title": "포워드와 디퍼드는 계산을 묶는 순서입니다",
      "text": "포워드의 광원마다 항상 모든 삼각형을 다시 그려야 하는 것은 아닙니다. 현대의 타일이나 클러스터 방식도 있으므로 어느 하나가 언제나 빠르다고 단정하지 마세요.",
      "start": 245.70999999999998,
      "end": 255.39,
      "voice_start": 245.70999999999998,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 33,
      "scene_id": "06",
      "scene_title": "포워드와 디퍼드는 계산을 묶는 순서입니다",
      "text": "이는 계산을 나누는 구조입니다. 가시성이나 반사의 물리 법칙을 바꾼 것이 아니며, 복잡한 투과와 안개처럼 공간 안에서 일어나는 산란에는 별도 처리가 필요합니다.",
      "start": 255.67,
      "end": 265.71,
      "voice_start": 255.67,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 34,
      "scene_id": "07",
      "scene_title": "재질은 색 하나보다 더 많은 질문에 답합니다",
      "text": "같은 빨간 표면도 손전등과 카메라 위치에 따라 반짝임이 달라집니다. 색 숫자 하나만으로 모든 방향의 반사를 설명할 수 없습니다.",
      "start": 266.21999999999997,
      "end": 275.2,
      "voice_start": 266.21999999999997,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 35,
      "scene_id": "07",
      "scene_title": "재질은 색 하나보다 더 많은 질문에 답합니다",
      "text": "비알디에프는 한 표면 위치에서, 어느 방향에서 들어온 빛이 어느 방향으로 반사되는지 설명하는 분포입니다.",
      "start": 275.41999999999996,
      "end": 282.23999999999995,
      "voice_start": 275.41999999999996,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 36,
      "scene_id": "07",
      "scene_title": "재질은 색 하나보다 더 많은 질문에 답합니다",
      "text": "입력에는 표면 위치, 들어오는 방향, 나가는 방향과 파장 또는 색 표현이 들어갑니다. 위치가 달라지면 같은 물체의 재질도 달라질 수 있습니다.",
      "start": 282.64,
      "end": 292.76,
      "voice_start": 282.64,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 37,
      "scene_id": "07",
      "scene_title": "재질은 색 하나보다 더 많은 질문에 답합니다",
      "text": "여기서는 들어오는 방향 벡터를 표면에서 광원 쪽으로 향하게 정하겠습니다. 빛이 실제로 진행하는 화살표와는 반대라는 점을 기억하세요.",
      "start": 292.76,
      "end": 301.65999999999997,
      "voice_start": 292.76,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 38,
      "scene_id": "07",
      "scene_title": "재질은 색 하나보다 더 많은 질문에 답합니다",
      "text": "나가는 방향은 표면에서 관찰자 쪽입니다. 법선은 표면 바깥쪽을 향합니다. 이 약속은 뒤의 코사인 부호까지 결정합니다.",
      "start": 302.11999999999995,
      "end": 310.4,
      "voice_start": 302.11999999999995,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 39,
      "scene_id": "07",
      "scene_title": "재질은 색 하나보다 더 많은 질문에 답합니다",
      "text": "넓게 퍼지는 반사와 좁은 방향에 몰리는 반사를 구별하세요. 관찰 방향을 바꾸면 좁은 반사 봉우리를 만나거나 놓칠 수 있습니다.",
      "start": 310.78,
      "end": 318.59999999999997,
      "voice_start": 310.78,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 40,
      "scene_id": "08",
      "scene_title": "밝은 벽과 어두운 벽을 함께 관찰하기",
      "text": "서브노티카 투의 기지에서 카메라가 흰 벽과 어두운 수납장 쪽으로 돌아갑니다. 같은 화면 안의 표면을 비교해 보세요.",
      "start": 319.22999999999996,
      "end": 326.90999999999997,
      "voice_start": 319.22999999999996,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 41,
      "scene_id": "08",
      "scene_title": "밝은 벽과 어두운 벽을 함께 관찰하기",
      "text": "바깥의 어두운 물에서 기지로 들어오면 밝은 벽이 눈에 들어옵니다. 재질 색과 조명 조건이 함께 결과를 만듭니다.",
      "start": 327.15,
      "end": 335.18999999999994,
      "voice_start": 327.15,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 42,
      "scene_id": "08",
      "scene_title": "밝은 벽과 어두운 벽을 함께 관찰하기",
      "text": "천장과 벽을 따라 시선을 움직일 때 밝은 부분의 모양도 달라집니다. 건설용 초록 미리 보기 표시는 게임 화면의 도구 표시입니다.",
      "start": 335.53,
      "end": 344.03,
      "voice_start": 335.53,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 43,
      "scene_id": "08",
      "scene_title": "밝은 벽과 어두운 벽을 함께 관찰하기",
      "text": "완성된 픽셀만 보고 반사 함수나 광원 값을 역으로 확정할 수는 없습니다.",
      "start": 344.27,
      "end": 349.21,
      "voice_start": 344.27,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 44,
      "scene_id": "08",
      "scene_title": "밝은 벽과 어두운 벽을 함께 관찰하기",
      "text": "다음 원래 예제에서는 조건을 직접 정해서, 반사 분포와 에너지 보존을 구분하겠습니다.",
      "start": 349.22999999999996,
      "end": 355.04999999999995,
      "voice_start": 349.22999999999996,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 45,
      "scene_id": "09",
      "scene_title": "반사 분포가 1보다 크면 틀린 걸까요?",
      "text": "비알디에프 값은 영에서 일 사이의 단순한 반사 확률이 아닙니다. 방향에 대한 분포이므로 단위는 입체각의 역수입니다.",
      "start": 355.5199999999999,
      "end": 363.19999999999993,
      "voice_start": 355.5199999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 46,
      "scene_id": "09",
      "scene_title": "반사 분포가 1보다 크면 틀린 걸까요?",
      "text": "빛을 좁은 방향에 모으면 그 방향의 분포 값이 일보다 클 수도 있습니다. 값 하나가 크다고 에너지를 새로 만든 것은 아닙니다.",
      "start": 363.4799999999999,
      "end": 371.13999999999993,
      "voice_start": 363.4799999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 47,
      "scene_id": "09",
      "scene_title": "반사 분포가 1보다 크면 틀린 걸까요?",
      "text": "에너지 보존은 반사되는 모든 방향의 기여를 코사인과 입체각으로 가중해 합한 뒤 검사합니다. 수동 표면은 받은 에너지보다 더 많이 반사하지 않습니다.",
      "start": 371.49999999999994,
      "end": 381.1599999999999,
      "voice_start": 371.49999999999994,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 48,
      "scene_id": "09",
      "scene_title": "반사 분포가 1보다 크면 틀린 걸까요?",
      "text": "반사 분포는 음수가 아니어야 합니다. 일반적인 상반성을 만족하는 재질에서는 두 방향을 바꾸어도 같은 반사 응답을 얻습니다.",
      "start": 381.31999999999994,
      "end": 388.49999999999994,
      "voice_start": 381.31999999999994,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 49,
      "scene_id": "09",
      "scene_title": "반사 분포가 1보다 크면 틀린 걸까요?",
      "text": "자체 발광은 반사에서 공짜로 에너지를 늘린 것이 아니라 별도의 방출 항입니다. 형광 같은 더 복잡한 현상도 지금의 단순 모델 범위와 구분합니다.",
      "start": 388.6599999999999,
      "end": 397.25999999999993,
      "voice_start": 388.6599999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 50,
      "scene_id": "09",
      "scene_title": "반사 분포가 1보다 크면 틀린 걸까요?",
      "text": "오래된 정규화 없는 블린 퐁 식은 이런 보존 조건을 어길 수 있습니다. 익숙한 반짝임 모델을 물리 법칙 전체로 생각하지 마세요.",
      "start": 397.3999999999999,
      "end": 404.79999999999995,
      "voice_start": 397.3999999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 51,
      "scene_id": "10",
      "scene_title": "반사·투과·표면하 산란의 범위",
      "text": "반사는 표면의 같은 쪽으로 빛이 돌아오는 경우입니다. 반사만 다루는 비알디에프에서 시작했습니다.",
      "start": 405.3299999999999,
      "end": 411.8299999999999,
      "voice_start": 405.3299999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 52,
      "scene_id": "10",
      "scene_title": "반사·투과·표면하 산란의 범위",
      "text": "반대편으로 투과되는 빛을 다루는 함수는 비티디에프입니다. 같은 위치에서 반사와 투과를 함께 묶으면 보통 비에스디에프라고 부릅니다.",
      "start": 412.1099999999999,
      "end": 420.9099999999999,
      "voice_start": 412.1099999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 53,
      "scene_id": "10",
      "scene_title": "반사·투과·표면하 산란의 범위",
      "text": "피부나 우유처럼 안으로 들어간 빛이 다른 위치로 나오는 경우도 있습니다. 입사 위치와 출사 위치를 따로 두는 비에스에스알디에프로 구분합니다.",
      "start": 421.5899999999999,
      "end": 430.1499999999999,
      "voice_start": 421.5899999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 54,
      "scene_id": "10",
      "scene_title": "반사·투과·표면하 산란의 범위",
      "text": "그래서 방향만 추가하는 일반화와, 위치까지 두 개로 늘리는 일반화는 다릅니다. 원문의 중복된 약자를 그대로 한 개념으로 외우지 마세요.",
      "start": 430.3299999999999,
      "end": 438.86999999999995,
      "voice_start": 430.3299999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 55,
      "scene_id": "10",
      "scene_title": "반사·투과·표면하 산란의 범위",
      "text": "안개나 물속 산란은 표면만의 반사가 아닙니다. 공간 속 산란과 흡수, 방향 분포를 별도로 다루어야 합니다.",
      "start": 439.2099999999999,
      "end": 446.16999999999996,
      "voice_start": 439.2099999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 56,
      "scene_id": "10",
      "scene_title": "반사·투과·표면하 산란의 범위",
      "text": "이 강의의 뒤 계산은 불투명한 표면의 반사와 방출로 범위를 정합니다. 물속 게임 장면을 곧바로 그 단순 표면식 하나로 전부 설명하지 않겠습니다.",
      "start": 446.4699999999999,
      "end": 454.9899999999999,
      "voice_start": 446.4699999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 57,
      "scene_id": "11",
      "scene_title": "밝은 색과 빛의 스펙트럼을 구분하기",
      "text": "빅 워크의 밝은 바깥에서 빨간 구조물 안쪽으로 움직입니다. 빨간 표면과 그늘의 어두운 부분을 함께 보세요.",
      "start": 455.4600416666666,
      "end": 463.0200416666666,
      "voice_start": 455.4600416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 58,
      "scene_id": "11",
      "scene_title": "밝은 색과 빛의 스펙트럼을 구분하기",
      "text": "이어지는 장면에는 파란 장치와 녹색 지형이 있습니다. 화면의 빨강, 초록, 파랑은 우리가 표시한 색의 좌표입니다.",
      "start": 463.3600416666666,
      "end": 470.8400416666666,
      "voice_start": 463.3600416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 59,
      "scene_id": "11",
      "scene_title": "밝은 색과 빛의 스펙트럼을 구분하기",
      "text": "실제 빛이 언제나 세 가지 파장만으로 이루어졌다는 뜻은 아닙니다. 서로 다른 스펙트럼이 같은 색처럼 보일 수도 있습니다.",
      "start": 471.2000416666666,
      "end": 478.24004166666657,
      "voice_start": 471.2000416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 60,
      "scene_id": "11",
      "scene_title": "밝은 색과 빛의 스펙트럼을 구분하기",
      "text": "게임의 색은 재질과 조명, 카메라와 표시 변환의 결과입니다. 화면이 어두워졌다는 이유만으로 재질이 바뀌었다고 단정하지 마세요.",
      "start": 478.6400416666666,
      "end": 486.5800416666666,
      "voice_start": 478.6400416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 61,
      "scene_id": "11",
      "scene_title": "밝은 색과 빛의 스펙트럼을 구분하기",
      "text": "빛 에너지와 사람이 보는 색을 구분한 뒤, 에너지의 양부터 숫자로 계산하겠습니다.",
      "start": 486.7800416666666,
      "end": 492.0800416666666,
      "voice_start": 486.7800416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 62,
      "scene_id": "12",
      "scene_title": "줄·와트·제곱미터당 와트",
      "text": "빛의 에너지 총량은 줄로 나타냅니다. 사 줄이 이 초 동안 전달됐다면, 평균 일률은 이 와트입니다.",
      "start": 492.5500416666666,
      "end": 500.01004166666655,
      "voice_start": 492.5500416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 63,
      "scene_id": "12",
      "scene_title": "줄·와트·제곱미터당 와트",
      "text": "복사속은 빛 에너지가 시간당 흐르는 총량입니다. 일 와트는 일 초에 일 줄이 흐르는 양입니다.",
      "start": 500.43004166666657,
      "end": 506.6700416666666,
      "voice_start": 500.43004166666657,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 64,
      "scene_id": "12",
      "scene_title": "줄·와트·제곱미터당 와트",
      "text": "그 이 와트가 이 제곱미터에 균일하게 도착한다면, 평균 복사조도는 제곱미터당 일 와트입니다.",
      "start": 506.9700416666666,
      "end": 512.8700416666666,
      "voice_start": 506.9700416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 65,
      "scene_id": "12",
      "scene_title": "줄·와트·제곱미터당 와트",
      "text": "들어오는 면적당 양은 복사조도이고, 떠나는 면적당 양은 복사출사도입니다. 총량과 밀도는 같은 숫자처럼 보여도 단위가 다릅니다.",
      "start": 513.2100416666666,
      "end": 521.4700416666666,
      "voice_start": 513.2100416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 66,
      "scene_id": "12",
      "scene_title": "줄·와트·제곱미터당 와트",
      "text": "복사 측정은 물리 에너지를 다룹니다. 측광은 파장마다 사람 눈의 민감도로 가중해 광속이나 조도로 표현합니다.",
      "start": 521.4700416666666,
      "end": 528.6100416666666,
      "voice_start": 521.4700416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 67,
      "scene_id": "12",
      "scene_title": "줄·와트·제곱미터당 와트",
      "text": "와트와 루멘, 제곱미터당 와트와 럭스를 구분하세요. 측광량을 사람의 주관적인 밝기 느낌이나 화면의 감마 값과 동일하게 보지 않습니다.",
      "start": 528.8900416666665,
      "end": 537.8900416666665,
      "voice_start": 528.8900416666665,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 68,
      "scene_id": "13",
      "scene_title": "면적과 방향을 모두 구별해야 합니다",
      "text": "같은 면적당 총량을 받아도, 사방에서 들어오는 빛과 좁은 한 방향에서 들어오는 빛은 다릅니다. 반짝임을 계산하려면 방향별 양이 필요합니다.",
      "start": 538.3600416666666,
      "end": 547.6600416666665,
      "voice_start": 538.3600416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 69,
      "scene_id": "13",
      "scene_title": "면적과 방향을 모두 구별해야 합니다",
      "text": "평면의 각도는 원의 호와 연결됩니다. 입체각은 관찰점에서 바라본 영역을 단위 구에 투영한 면적으로 생각할 수 있습니다.",
      "start": 547.9000416666665,
      "end": 555.6400416666665,
      "voice_start": 547.9000416666665,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 70,
      "scene_id": "13",
      "scene_title": "면적과 방향을 모두 구별해야 합니다",
      "text": "입체각의 단위는 스테라디안입니다. 구 전체는 사 파이, 반구는 이 파이 스테라디안입니다. 화면의 평면 각도와 혼동하지 마세요.",
      "start": 555.8200416666666,
      "end": 564.1200416666666,
      "voice_start": 555.8200416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 71,
      "scene_id": "13",
      "scene_title": "면적과 방향을 모두 구별해야 합니다",
      "text": "복사휘도는 투영 면적당, 입체각당 복사속입니다. 단위는 와트를 제곱미터와 스테라디안으로 나눈 것입니다.",
      "start": 564.4200416666665,
      "end": 571.0600416666666,
      "voice_start": 564.4200416666665,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 72,
      "scene_id": "13",
      "scene_title": "면적과 방향을 모두 구별해야 합니다",
      "text": "여기서 투영 면적은 광선 방향에 수직으로 바라본 면적입니다. 표면 자체의 넓이와 같은 경우도 있지만 기울면 달라집니다.",
      "start": 571.4200416666665,
      "end": 578.8800416666666,
      "voice_start": 571.4200416666665,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 73,
      "scene_id": "13",
      "scene_title": "면적과 방향을 모두 구별해야 합니다",
      "text": "그러므로 복사조도와 복사휘도를 바로 같은 값으로 대입할 수 없습니다. 방향별 기여를 합할 때 입체각과 코사인이 필요합니다.",
      "start": 579.4200416666665,
      "end": 586.6400416666665,
      "voice_start": 579.4200416666665,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 74,
      "scene_id": "14",
      "scene_title": "손전등이 비스듬한 바위를 비출 때",
      "text": "손전등을 든 채 바위 아래와 옆으로 움직입니다. 밝은 빛이 닿는 부분과 주변의 어두운 면을 보세요.",
      "start": 587.4500416666666,
      "end": 594.0700416666666,
      "voice_start": 587.4500416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 75,
      "scene_id": "14",
      "scene_title": "손전등이 비스듬한 바위를 비출 때",
      "text": "굴곡진 바위는 위치마다 표면 방향이 다릅니다. 같은 빛이 오는 방향에서도 법선과 이루는 각이 달라집니다.",
      "start": 594.2500416666666,
      "end": 601.3900416666667,
      "voice_start": 594.2500416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 76,
      "scene_id": "14",
      "scene_title": "손전등이 비스듬한 바위를 비출 때",
      "text": "밝기가 달라지는 데에는 거리, 가림, 재질과 물속 효과도 있습니다. 이 영상은 각도 하나만 바꾸는 통제 실험은 아닙니다.",
      "start": 601.5900416666666,
      "end": 609.5500416666666,
      "voice_start": 601.5900416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 77,
      "scene_id": "14",
      "scene_title": "손전등이 비스듬한 바위를 비출 때",
      "text": "그래서 다음 도식에서는 빛의 조건을 고정하고 판의 방향만 바꾸겠습니다. 빛이 비스듬하면 넓은 면에 퍼지는 관계를 분리합니다.",
      "start": 609.9500416666666,
      "end": 618.1300416666666,
      "voice_start": 609.9500416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 78,
      "scene_id": "14",
      "scene_title": "손전등이 비스듬한 바위를 비출 때",
      "text": "관찰한 바위의 밝기에서 특정 수치를 읽어내지 않고, 우리가 정한 영 도와 육십 도를 직접 비교하겠습니다.",
      "start": 618.4700416666666,
      "end": 625.4100416666666,
      "voice_start": 618.4700416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 79,
      "scene_id": "15",
      "scene_title": "판을 60도 기울이면 왜 절반일까요?",
      "text": "한 방향에서 오는 같은 빛을 받는 판입니다. 법선과 광원 쪽 방향이 같으면 각도는 영이고, 코사인은 일입니다.",
      "start": 625.9000416666667,
      "end": 634.7000416666666,
      "voice_start": 625.9000416666667,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 80,
      "scene_id": "15",
      "scene_title": "판을 60도 기울이면 왜 절반일까요?",
      "text": "판을 기울여 두 방향 사이의 각도를 육십 도로 만들면 코사인은 영 점 오입니다. 같은 실제 면적의 투영 면적이 절반입니다.",
      "start": 635.0600416666666,
      "end": 644.0600416666666,
      "voice_start": 635.0600416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 81,
      "scene_id": "15",
      "scene_title": "판을 60도 기울이면 왜 절반일까요?",
      "text": "같은 방향별 빛 조건에서, 판의 면적당 도착 기여도 절반이 됩니다. 재질의 반사 법칙을 바꾸지 않아도 생기는 기하 효과입니다.",
      "start": 644.4000416666667,
      "end": 653.7000416666666,
      "voice_start": 644.4000416666667,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 82,
      "scene_id": "15",
      "scene_title": "판을 60도 기울이면 왜 절반일까요?",
      "text": "벡터를 단위 길이로 만들면 법선과 광원 쪽 방향의 내적이 이 코사인입니다. 단위 길이를 잊으면 방향뿐 아니라 길이까지 곱해집니다.",
      "start": 653.7000416666666,
      "end": 662.5600416666666,
      "voice_start": 653.7000416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 83,
      "scene_id": "15",
      "scene_title": "판을 60도 기울이면 왜 절반일까요?",
      "text": "우리 약속에서는 표면에서 광원 쪽을 향하므로 앞면의 내적이 양수입니다. 빛의 진행 방향을 쓰는 식에는 반대 부호가 필요합니다.",
      "start": 662.9000416666667,
      "end": 670.5800416666666,
      "voice_start": 662.9000416666667,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 84,
      "scene_id": "15",
      "scene_title": "판을 60도 기울이면 왜 절반일까요?",
      "text": "불투명한 한쪽 면의 직접 조명에서는 뒤쪽 방향을 영으로 제한합니다. 양면 표면과 투과는 별도의 모델입니다.",
      "start": 670.9800416666667,
      "end": 678.0800416666666,
      "voice_start": 670.9800416666667,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 85,
      "scene_id": "16",
      "scene_title": "나가는 빛은 방출과 반사의 합입니다",
      "text": "이제 한 표면 위치에서 눈 쪽으로 나가는 복사휘도를 계산합니다. 렌더링 방정식은 자체 방출과 반사 기여의 합입니다.",
      "start": 678.7500416666667,
      "end": 686.9500416666667,
      "voice_start": 678.7500416666667,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 86,
      "scene_id": "16",
      "scene_title": "나가는 빛은 방출과 반사의 합입니다",
      "text": "발광하는 표면은 자체 방출 항을 가집니다. 일반적인 비발광 표면에서는 그 항을 영으로 둡니다.",
      "start": 687.2300416666667,
      "end": 693.6500416666667,
      "voice_start": 687.2300416666667,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 87,
      "scene_id": "16",
      "scene_title": "나가는 빛은 방출과 반사의 합입니다",
      "text": "반사 항은 표면 위 반구의 각 방향에서 들어오는 복사휘도에 반사 분포와 코사인을 곱한 뒤, 입체각 전체에 대해 더합니다.",
      "start": 693.9300416666666,
      "end": 701.7700416666667,
      "voice_start": 693.9300416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 88,
      "scene_id": "16",
      "scene_title": "나가는 빛은 방출과 반사의 합입니다",
      "text": "눈 쪽 방향은 고정하고 들어오는 방향을 바꾸며 합하는 것입니다. 비알디에프가 이 둘을 연결합니다.",
      "start": 701.8700416666667,
      "end": 707.7500416666667,
      "voice_start": 701.8700416666667,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 89,
      "scene_id": "16",
      "scene_title": "나가는 빛은 방출과 반사의 합입니다",
      "text": "복사휘도에 스테라디안의 역수인 반사 분포를 곱하고, 스테라디안인 미소 입체각으로 적분합니다. 최종 단위는 다시 복사휘도입니다.",
      "start": 707.7500416666667,
      "end": 715.7100416666667,
      "voice_start": 707.7500416666667,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 90,
      "scene_id": "16",
      "scene_title": "나가는 빛은 방출과 반사의 합입니다",
      "text": "공식의 위치와 파장 인자는 이 계산이 한 점과 한 색 표현에 대한 것임을 뜻합니다. 표시할 픽셀 색에는 카메라와 색 변환 등의 단계도 이어집니다.",
      "start": 716.0900416666667,
      "end": 724.6100416666667,
      "voice_start": 716.0900416666667,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 91,
      "scene_id": "17",
      "scene_title": "천장 조명을 설치하면 벽도 밝아집니다",
      "text": "녹색 물속에서 밝은 기지 쪽으로 움직입니다. 보이는 표면과 그 표면을 향해 오는 빛을 나누어 생각하세요.",
      "start": 725.2800416666668,
      "end": 733.0400416666668,
      "voice_start": 725.2800416666668,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 92,
      "scene_id": "17",
      "scene_title": "천장 조명을 설치하면 벽도 밝아집니다",
      "text": "조명 자체가 빛을 내는 것과, 주변 벽이 빛을 받아 반사하는 것은 서로 다른 역할입니다.",
      "start": 733.2400416666668,
      "end": 738.8600416666668,
      "voice_start": 733.2400416666668,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 93,
      "scene_id": "17",
      "scene_title": "천장 조명을 설치하면 벽도 밝아집니다",
      "text": "이어지는 장면에서는 플레이어가 천장에 조명을 설치합니다. 미리 보기 모양이 설치된 조명으로 바뀌는 부분을 보세요.",
      "start": 739.3000416666667,
      "end": 746.3400416666667,
      "voice_start": 739.3000416666667,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 94,
      "scene_id": "17",
      "scene_title": "천장 조명을 설치하면 벽도 밝아집니다",
      "text": "설치 뒤 천장과 벽이 넓게 밝아진 모습은 두 역할을 연결하는 관찰입니다. 벽이 모두 발광 재질로 바뀌었다는 뜻은 아닙니다.",
      "start": 746.6400416666668,
      "end": 754.6800416666667,
      "voice_start": 746.6400416666668,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 95,
      "scene_id": "17",
      "scene_title": "천장 조명을 설치하면 벽도 밝아집니다",
      "text": "게임이 간접 조명을 어떤 방식으로 구현했는지는 단정하지 않습니다. 다음에는 빛의 이동 관계와 계산 비용을 도식으로 설명합니다.",
      "start": 754.6800416666667,
      "end": 762.2600416666668,
      "voice_start": 754.6800416666667,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 96,
      "scene_id": "18",
      "scene_title": "한 표면의 출사광은 다른 표면의 입사광입니다",
      "text": "광원에서 바로 오는 빛은 직접 조명입니다. 벽이나 바닥을 거쳐서 오는 빛은 간접 조명으로 구분합니다.",
      "start": 762.8500833333335,
      "end": 769.5700833333335,
      "voice_start": 762.8500833333335,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 97,
      "scene_id": "18",
      "scene_title": "한 표면의 출사광은 다른 표면의 입사광입니다",
      "text": "첫 표면에서 나온 빛이 다른 표면에 도착하면, 첫 표면의 출사광이 둘째 표면의 입사광이 됩니다.",
      "start": 769.8100833333335,
      "end": 775.4300833333335,
      "voice_start": 769.8100833333335,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 98,
      "scene_id": "18",
      "scene_title": "한 표면의 출사광은 다른 표면의 입사광입니다",
      "text": "그러면 한 점의 입사광을 구하려고 다른 점의 출사광도 알아야 합니다. 렌더링 방정식은 장면의 점들을 서로 연결합니다.",
      "start": 775.7700833333334,
      "end": 782.8700833333335,
      "voice_start": 775.7700833333334,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 99,
      "scene_id": "18",
      "scene_title": "한 표면의 출사광은 다른 표면의 입사광입니다",
      "text": "여러 번 반사되는 길이 늘어나면 계산량이 커집니다. 가림과 그림자, 반사, 빛이 닿는 경로를 함께 고려해야 합니다.",
      "start": 783.1300833333335,
      "end": 790.4500833333335,
      "voice_start": 783.1300833333335,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 100,
      "scene_id": "18",
      "scene_title": "한 표면의 출사광은 다른 표면의 입사광입니다",
      "text": "실시간 게임은 유한한 예산 안에서 이를 근사합니다. 사전 계산, 제한된 경로, 화면 공간 계산이나 다른 혼합 방법을 선택할 수 있습니다.",
      "start": 790.4500833333335,
      "end": 799.2500833333335,
      "voice_start": 790.4500833333335,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 101,
      "scene_id": "18",
      "scene_title": "한 표면의 출사광은 다른 표면의 입사광입니다",
      "text": "광선 추적도 표본 수와 경로 길이, 재질 모델에 따라 오차가 있습니다. 기법 이름보다 무엇을 계산하고 무엇을 생략했는지 보세요.",
      "start": 799.5900833333335,
      "end": 806.9700833333335,
      "voice_start": 799.5900833333335,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 102,
      "scene_id": "19",
      "scene_title": "밝은 바닥의 그늘도 계산 대상입니다",
      "text": "바위와 나무 사이를 걸으며 밝은 땅과 그늘을 비교합니다. 카메라가 움직여도 표면과 그림자의 관계가 계속 바뀌어 보입니다.",
      "start": 807.7001250000002,
      "end": 816.0801250000002,
      "voice_start": 807.7001250000002,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 103,
      "scene_id": "19",
      "scene_title": "밝은 바닥의 그늘도 계산 대상입니다",
      "text": "그늘은 특정 광원 방향이 가려졌다는 뜻일 수 있습니다. 모든 방향에서 오는 빛이 반드시 영이라는 뜻은 아닙니다.",
      "start": 816.3801250000001,
      "end": 823.1401250000002,
      "voice_start": 816.3801250000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 104,
      "scene_id": "19",
      "scene_title": "밝은 바닥의 그늘도 계산 대상입니다",
      "text": "주변 표면과 하늘에서 오는 기여까지 생각하면, 한 방향의 밝기 하나로 전체를 끝낼 수 없습니다.",
      "start": 823.4801250000002,
      "end": 829.3601250000002,
      "voice_start": 823.4801250000002,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 105,
      "scene_id": "19",
      "scene_title": "밝은 바닥의 그늘도 계산 대상입니다",
      "text": "이 게임의 그림자나 간접 조명 구현을 특정하지 않고, 방향별 기여를 합한다는 질문에 집중하겠습니다.",
      "start": 829.6001250000002,
      "end": 836.0601250000002,
      "voice_start": 829.6001250000002,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 106,
      "scene_id": "19",
      "scene_title": "밝은 바닥의 그늘도 계산 대상입니다",
      "text": "마지막 계산에서는 방향 표본을 두 배로 늘려도 밝기를 두 배로 만들지 않는 이유를 확인합니다.",
