  "entries": [
    {
      "index": 1,
      "scene_id": "01",
      "scene_title": "기능이 같은데 판단이 다른 장면",
      "text": "새로운 게임에서도 기능 이름보다 결정하는 순간을 찾아보겠습니다.",
      "start": 0.0,
      "end": 3.9525
    },
    {
      "index": 2,
      "scene_id": "01",
      "scene_title": "기능이 같은데 판단이 다른 장면",
      "text": "인투 더 브리치에서는 이동할 칸과 적의 공격 방향이 한 화면에 보입니다.",
      "start": 3.9525,
      "end": 8.6525
    },
    {
      "index": 3,
      "scene_id": "01",
      "scene_title": "기능이 같은데 판단이 다른 장면",
      "text": "앞으로 움직인다는 기능보다, 무엇을 보호하고 어디로 옮길지가 질문이 됩니다.",
      "start": 8.6525,
      "end": 13.9025
    },
    {
      "index": 4,
      "scene_id": "01",
      "scene_title": "기능이 같은데 판단이 다른 장면",
      "text": "노이타에서는 발사체가 지나간 뒤 지형과 주변 물질이 달라지는 모습을 보세요.",
      "start": 13.9025,
      "end": 19.0025
    },
    {
      "index": 5,
      "scene_id": "01",
      "scene_title": "기능이 같은데 판단이 다른 장면",
      "text": "공격이 적에게 주는 피해만 보는 것과, 그 뒤에 남은 길까지 보는 것은 다른 관찰입니다.",
      "start": 19.0025,
      "end": 24.4025
    },
    {
      "index": 6,
      "scene_id": "01",
      "scene_title": "기능이 같은데 판단이 다른 장면",
      "text": "같은 발사 버튼에도 조준할 곳과 접근할 경로가 함께 걸려 있을 수 있죠.",
      "start": 24.4025,
      "end": 28.6125
    },
    {
      "index": 7,
      "scene_id": "01",
      "scene_title": "기능이 같은데 판단이 다른 장면",
      "text": "화려한 효과를 그대로 옮겨도 이런 선택까지 저절로 생기지는 않습니다.",
      "start": 28.6125,
      "end": 33.2225
    },
    {
      "index": 8,
      "scene_id": "01",
      "scene_title": "기능이 같은데 판단이 다른 장면",
      "text": "내가 본 정보와 고른 행동, 화면에 남은 결과를 따로 적어 봅니다.",
      "start": 33.2225,
      "end": 37.2725
    },
    {
      "index": 9,
      "scene_id": "01",
      "scene_title": "기능이 같은데 판단이 다른 장면",
      "text": "앞의 작은 도식은 그 세 가지를 내 규칙으로 다시 묶는 출발점입니다.",
      "start": 37.2725,
      "end": 41.44
    },
    {
      "index": 10,
      "scene_id": "02",
      "scene_title": "실제 플레이에서 한 번의 행동을 고르기",
      "text": "이제 인투 더 브리치에서 한 번의 이동과 공격만 골라 보겠습니다.",
      "start": 42.16,
      "end": 46.8925
    },
    {
      "index": 11,
      "scene_id": "02",
      "scene_title": "실제 플레이에서 한 번의 행동을 고르기",
      "text": "공격 방향을 읽는 때와 기체를 옮기는 때, 적의 위치가 바뀐 뒤를 나눠 봅니다.",
      "start": 46.8925,
      "end": 52.7925
    },
    {
      "index": 12,
      "scene_id": "02",
      "scene_title": "실제 플레이에서 한 번의 행동을 고르기",
      "text": "적을 때린다는 말만 적으면, 밀려난 위치가 다음 상황을 바꾸는 부분을 놓치기 쉽습니다.",
      "start": 52.7925,
      "end": 58.24249999999999
    },
    {
      "index": 13,
      "scene_id": "02",
      "scene_title": "실제 플레이에서 한 번의 행동을 고르기",
      "text": "노이타의 장면도 전체 탐험 대신 발사체가 지나간 한 구간부터 관찰할 수 있습니다.",
      "start": 58.24249999999999,
      "end": 64.4025
    },
    {
      "index": 14,
      "scene_id": "02",
      "scene_title": "실제 플레이에서 한 번의 행동을 고르기",
      "text": "어디를 겨눴고, 무엇이 변했고, 그 뒤에는 어디로 움직일 수 있었나요?",
      "start": 64.4025,
      "end": 69.2725
    },
    {
      "index": 15,
      "scene_id": "02",
      "scene_title": "실제 플레이에서 한 번의 행동을 고르기",
      "text": "에프티엘에서는 배의 방과 승무원, 전력 표시를 함께 살펴보세요.",
      "start": 69.2725,
      "end": 73.7825
    },
    {
      "index": 16,
      "scene_id": "02",
      "scene_title": "실제 플레이에서 한 번의 행동을 고르기",
      "text": "함선을 조종한다는 큰 기능을 적기보다, 당장 돌볼 상태 하나를 고릅니다.",
      "start": 73.7825,
      "end": 78.82249999999999
    },
    {
      "index": 17,
      "scene_id": "02",
      "scene_title": "실제 플레이에서 한 번의 행동을 고르기",
      "text": "게임마다 같은 길이로 잘라야 하는 것은 아닙니다.",
      "start": 78.82249999999999,
      "end": 82.0825
    },
    {
      "index": 18,
      "scene_id": "02",
      "scene_title": "실제 플레이에서 한 번의 행동을 고르기",
      "text": "선택 이전의 정보와 선택 이후의 결과가 함께 보이는 순간을 찾는 겁니다.",
      "start": 82.0825,
      "end": 87.19999999999999
    },
    {
      "index": 19,
      "scene_id": "03",
      "scene_title": "관찰을 확인할 질문으로 바꾸기",
      "text": "눈에 보인 변화와 재미있었던 이유는 구분해서 적어야 합니다.",
      "start": 87.91999999999999,
      "end": 91.80249999999998
    },
    {
      "index": 20,
      "scene_id": "03",
      "scene_title": "관찰을 확인할 질문으로 바꾸기",
      "text": "노이타에서 지형이 바뀌었다는 것은 관찰할 수 있는 사건입니다.",
      "start": 91.80249999999998,
      "end": 95.99249999999999
    },
    {
      "index": 21,
      "scene_id": "03",
      "scene_title": "관찰을 확인할 질문으로 바꾸기",
      "text": "새 길이 생겨서 좋았다는 설명은 내가 확인하려는 생각이죠.",
      "start": 95.99249999999999,
      "end": 99.89249999999998
    },
    {
      "index": 22,
      "scene_id": "03",
      "scene_title": "관찰을 확인할 질문으로 바꾸기",
      "text": "길의 수가 달라져서인지, 위험을 피할 선택이 생겨서인지 질문을 나눕니다.",
      "start": 99.89249999999998,
      "end": 104.92249999999999
    },
    {
      "index": 23,
      "scene_id": "03",
      "scene_title": "관찰을 확인할 질문으로 바꾸기",
      "text": "에프티엘의 전력과 방 상태도 같은 방식으로 볼 수 있습니다.",
      "start": 104.92249999999999,
      "end": 109.04249999999999
    },
    {
      "index": 24,
      "scene_id": "03",
      "scene_title": "관찰을 확인할 질문으로 바꾸기",
      "text": "정보가 많아서 몰입한 걸까요, 동시에 돌볼 일이 생겨서일까요?",
      "start": 109.04249999999999,
      "end": 113.00249999999998
    },
    {
      "index": 25,
      "scene_id": "03",
      "scene_title": "관찰을 확인할 질문으로 바꾸기",
      "text": "편집된 소개 장면만 보고 플레이어의 마음이나 내부 코드를 단정하지 않습니다.",
      "start": 113.00249999999998,
      "end": 118.47249999999998
    },
    {
      "index": 26,
      "scene_id": "03",
      "scene_title": "관찰을 확인할 질문으로 바꾸기",
      "text": "그 장면에서 생긴 질문을 앞의 자체 테스트로 옮겨 확인합니다.",
      "start": 118.47249999999998,
      "end": 122.3825
    },
    {
      "index": 27,
      "scene_id": "03",
      "scene_title": "관찰을 확인할 질문으로 바꾸기",
      "text": "좋아 보인다는 느낌을 남겨 두면서, 비교할 조건은 더 작게 만드는 겁니다.",
      "start": 122.3825,
      "end": 127.11999999999999
    },
    {
      "index": 28,
      "scene_id": "04",
      "scene_title": "상용 사례와 통제한 테스트를 연결하기",
      "text": "에프티엘에서는 전투 중에도 여러 방과 상태 표시가 동시에 보입니다.",
      "start": 127.83999999999999,
      "end": 132.0025
    },
    {
      "index": 29,
      "scene_id": "04",
      "scene_title": "상용 사례와 통제한 테스트를 연결하기",
      "text": "우리는 어느 정보를 먼저 확인할지라는 질문을 가져올 수 있습니다.",
      "start": 132.0025,
      "end": 135.64249999999998
    },
    {
      "index": 30,
      "scene_id": "04",
      "scene_title": "상용 사례와 통제한 테스트를 연결하기",
      "text": "하지만 서로 다른 전투 두 장면을 붙였다고 조건을 통제한 비교가 되지는 않습니다.",
      "start": 135.64249999999998,
      "end": 142.0025
    },
    {
      "index": 31,
      "scene_id": "04",
      "scene_title": "상용 사례와 통제한 테스트를 연결하기",
      "text": "적과 함선, 장비가 함께 달라졌다면 결과가 달라진 이유도 여러 가지일 수 있죠.",
      "start": 142.0025,
      "end": 146.4325
    },
    {
      "index": 32,
      "scene_id": "04",
      "scene_title": "상용 사례와 통제한 테스트를 연결하기",
      "text": "앞의 자체 점프 테스트에서는 발판의 너비나 재시도 대기 시간 중 하나만 바꿨습니다.",
      "start": 146.4325,
      "end": 151.9325
    },
    {
      "index": 33,
      "scene_id": "04",
      "scene_title": "상용 사례와 통제한 테스트를 연결하기",
      "text": "이렇게 나머지를 유지해야 내가 바꾼 조건을 살펴보기 쉽습니다.",
      "start": 151.9325,
      "end": 155.77249999999998
    },
    {
      "index": 34,
      "scene_id": "04",
      "scene_title": "상용 사례와 통제한 테스트를 연결하기",
      "text": "노이타처럼 주변 물질이 많은 상황이라면, 작은 실험에는 한 종류만 먼저 남길 수도 있습니다.",
      "start": 155.77249999999998,
      "end": 161.5125
    },
    {
      "index": 35,
      "scene_id": "04",
      "scene_title": "상용 사례와 통제한 테스트를 연결하기",
      "text": "멋진 장면은 질문을 찾는 데 쓰고, 작은 테스트는 그 질문을 확인하는 데 씁니다.",
      "start": 161.5125,
      "end": 166.9525
    },
    {
      "index": 36,
      "scene_id": "04",
      "scene_title": "상용 사례와 통제한 테스트를 연결하기",
      "text": "두 역할을 연결하면 사례를 보는 시간이 설계 작업으로 이어집니다.",
      "start": 166.9525,
      "end": 170.64
    },
    {
      "index": 37,
      "scene_id": "05",
      "scene_title": "판단을 남기고 상황을 바꿔 보기",
      "text": "다른 게임을 만들 때 남길 것은 장면의 겉모양만이 아닙니다.",
      "start": 171.35999999999999,
      "end": 175.2925
    },
    {
      "index": 38,
      "scene_id": "05",
      "scene_title": "판단을 남기고 상황을 바꿔 보기",
      "text": "인투 더 브리치의 위치 선택에서는 다음에 영향을 받을 칸을 읽는 질문이 있습니다.",
      "start": 175.2925,
      "end": 180.03249999999997
    },
    {
      "index": 39,
      "scene_id": "05",
      "scene_title": "판단을 남기고 상황을 바꿔 보기",
      "text": "노이타의 변화하는 공간에서는 행동 뒤에 남을 경로를 생각해 볼 수 있죠.",
      "start": 180.03249999999997,
      "end": 184.0425
    },
    {
      "index": 40,
      "scene_id": "05",
      "scene_title": "판단을 남기고 상황을 바꿔 보기",
      "text": "두 게임의 규칙이 같다는 뜻은 아닙니다.",
      "start": 184.0425,
      "end": 186.5625
    },
    {
      "index": 41,
      "scene_id": "05",
      "scene_title": "판단을 남기고 상황을 바꿔 보기",
      "text": "행동 전에 결과를 예상한다는 판단을 골라 우리 테스트의 다른 상황에 넣어 보는 겁니다.",
      "start": 186.5625,
      "end": 191.89249999999998
    },
    {
      "index": 42,
      "scene_id": "05",
      "scene_title": "판단을 남기고 상황을 바꿔 보기",
      "text": "문이 열릴 때 움직이는 놀이와 빛이 비칠 때 움직이는 놀이에서도 그 질문을 만들 수 있습니다.",
      "start": 191.89249999999998,
      "end": 197.3525
    },
    {
      "index": 43,
      "scene_id": "05",
      "scene_title": "판단을 남기고 상황을 바꿔 보기",
      "text": "에프티엘의 여러 상태를 돌보는 선택은, 제한된 도움을 어디에 먼저 보낼지로 바꿔 볼 수 있겠죠.",
      "start": 197.3525,
      "end": 202.8525
    },
    {
      "index": 44,
      "scene_id": "05",
      "scene_title": "판단을 남기고 상황을 바꿔 보기",
      "text": "원래 게임의 이름과 그림을 빌리지 않아도 새로운 규칙을 실험할 수 있습니다.",
      "start": 202.8525,
      "end": 207.49249999999998
    },
    {
      "index": 45,
      "scene_id": "05",
      "scene_title": "판단을 남기고 상황을 바꿔 보기",
      "text": "그 판단이 새 상황에서도 재미있는지는 직접 플레이한 사람에게 확인합니다.",
      "start": 207.49249999999998,
      "end": 211.76
    },
    {
      "index": 46,
      "scene_id": "06",
      "scene_title": "한 장면을 설계 기록으로 남기기",
      "text": "마지막으로 실제 장면을 보고 남길 메모를 정리해 보겠습니다.",
      "start": 212.48,
      "end": 216.14249999999998
    },
    {
      "index": 47,
      "scene_id": "06",
      "scene_title": "한 장면을 설계 기록으로 남기기",
      "text": "인투 더 브리치라면 공격 방향을 보고 어떤 위치를 고를지 적습니다.",
      "start": 216.14249999999998,
      "end": 220.52249999999998
    },
    {
      "index": 48,
      "scene_id": "06",
      "scene_title": "한 장면을 설계 기록으로 남기기",
      "text": "노이타라면 행동 뒤에 주변이 어떻게 바뀌었고, 다음 이동에 무엇이 남았는지 봅니다.",
      "start": 220.52249999999998,
      "end": 225.9825
    },
    {
      "index": 49,
      "scene_id": "06",
      "scene_title": "한 장면을 설계 기록으로 남기기",
      "text": "에프티엘에서는 동시에 보이는 상태 중 무엇을 먼저 돌보고 싶었는지 적을 수 있죠.",
      "start": 225.9825,
      "end": 231.0325
    },
    {
      "index": 50,
      "scene_id": "06",
      "scene_title": "한 장면을 설계 기록으로 남기기",
      "text": "그다음 그 이유를 확인할 작은 조건 하나를 정합니다.",
      "start": 231.0325,
      "end": 234.3725
    },
    {
      "index": 51,
      "scene_id": "06",
      "scene_title": "한 장면을 설계 기록으로 남기기",
      "text": "조건을 바꾼 테스트를 보여 주고, 어디를 보았는지와 언제 결정했는지를 묻습니다.",
      "start": 234.3725,
      "end": 239.64249999999998
    },
    {
      "index": 52,
      "scene_id": "06",
      "scene_title": "한 장면을 설계 기록으로 남기기",
      "text": "소개 영상에서 생긴 생각과 실제 플레이한 사람의 답은 서로 다른 기록입니다.",
      "start": 239.64249999999998,
      "end": 244.77249999999998
    },
    {
      "index": 53,
      "scene_id": "06",
