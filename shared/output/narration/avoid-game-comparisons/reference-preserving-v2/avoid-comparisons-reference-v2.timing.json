{
  "sample_rate": 24000,
  "duration_seconds": 422.66000000000014,
  "render_mode": "scene",
  "example_seconds": 0.0,
  "narration_placement": "continuous-across-example-and-explanation",
  "entries": [
    {
      "index": 1,
      "scene_id": "01",
      "scene_title": "같은 이름, 다른 게임",
      "text": "안녕하세요, 얌얌코딩입니다.",
      "start": 0.0,
      "end": 1.68,
      "voice_start": 0.0,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 2,
      "scene_id": "01",
      "scene_title": "같은 이름, 다른 게임",
      "text": "마리오 같은 게임이라고 설명하면, 듣는 사람도 나와 같은 장면을 떠올릴까요?",
      "start": 1.68,
      "end": 6.58,
      "voice_start": 1.68,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 3,
      "scene_id": "01",
      "scene_title": "같은 이름, 다른 게임",
      "text": "오늘은 익숙한 게임에 빗대는 설명이 왜 내 게임의 매력을 가리고, 서로 다른 기획으로 전달될 수 있는지 살펴보겠습니다.",
      "start": 6.84,
      "end": 14.36,
      "voice_start": 6.84,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 4,
      "scene_id": "01",
      "scene_title": "같은 이름, 다른 게임",
      "text": "마리오의 서로 다른 플레이를 비교한 뒤, 목표와 행동과 조건을 말하는 방식으로 설명을 바꿔 보죠.",
      "start": 15.0,
      "end": 21.36,
      "voice_start": 15.0,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 5,
      "scene_id": "02",
      "scene_title": "익숙한 이름을 찾는 이유",
      "text": "우선 비교가 편리한 이유부터 생각해 봅시다.",
      "start": 21.740000000000002,
      "end": 24.040000000000003,
      "voice_start": 21.740000000000002,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 6,
      "scene_id": "02",
      "scene_title": "익숙한 이름을 찾는 이유",
      "text": "처음 보는 게임을 설명할 때, 이미 아는 작품을 꺼내면 긴 설명을 줄일 수 있습니다.",
      "start": 24.240000000000002,
      "end": 29.180000000000003,
      "voice_start": 24.240000000000002,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 7,
      "scene_id": "02",
      "scene_title": "익숙한 이름을 찾는 이유",
      "text": "가령 화면 옆에서 캐릭터를 바라보고, 발판 사이를 뛰어넘는다고 말하는 대신 마리오를 떠올려 달라고 하는 거죠.",
      "start": 29.46,
      "end": 36.040000000000006,
      "voice_start": 29.46,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 8,
      "scene_id": "02",
      "scene_title": "익숙한 이름을 찾는 이유",
      "text": "지금 장면에서는 오른쪽으로 이동하면서 구멍을 넘고, 적을 피하거나 밟으며 앞으로 나아갑니다.",
      "start": 36.28,
      "end": 42.0,
      "voice_start": 36.28,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 9,
      "scene_id": "02",
      "scene_title": "익숙한 이름을 찾는 이유",
      "text": "같은 장면을 기억하는 상대라면, 작품 이름 하나가 이런 움직임을 빠르게 불러올 수 있습니다.",
      "start": 42.34,
      "end": 47.52,
      "voice_start": 42.34,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 10,
      "scene_id": "02",
      "scene_title": "익숙한 이름을 찾는 이유",
      "text": "하지만 그 이름이 설명해 주는 것은 이미 존재하는 게임입니다. 이제부터 만들 게임까지 설명해 주는 건 아닙니다.",
      "start": 47.84,
      "end": 53.78,
      "voice_start": 47.84,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 11,
      "scene_id": "03",
      "scene_title": "아직 없는 게임을 전달하기",
      "text": "아직 없는 게임은 직접 보여 주거나 플레이해 보라고 할 수 없습니다.",
      "start": 54.199999999999996,
      "end": 58.17999999999999,
      "voice_start": 54.199999999999996,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 12,
      "scene_id": "03",
      "scene_title": "아직 없는 게임을 전달하기",
      "text": "내 머릿속에는 주인공의 움직임과 화면이 선명해도, 함께 만들 사람은 그 모습을 모릅니다.",
      "start": 58.599999999999994,
      "end": 63.86,
      "voice_start": 58.599999999999994,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 13,
      "scene_id": "03",
      "scene_title": "아직 없는 게임을 전달하기",
      "text": "그래서 기획을 설명할 때는 무엇을 만들지뿐 아니라, 왜 함께 만들 가치가 있는지도 전달해야 합니다.",
      "start": 64.32,
      "end": 70.16,
      "voice_start": 64.32,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 14,
      "scene_id": "03",
      "scene_title": "아직 없는 게임을 전달하기",
      "text": "이렇게 프로젝트의 핵심 매력과 방향을 짧게 전달하는 설명을 피치라고 부릅니다.",
      "start": 70.46,
      "end": 74.72,
      "voice_start": 70.46,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 15,
      "scene_id": "03",
      "scene_title": "아직 없는 게임을 전달하기",
      "text": "팀원이든 제작을 지원할 사람이든, 설명을 듣고 구체적인 플레이와 이 게임만의 이유를 이해할 수 있어야 하죠.",
      "start": 74.94,
      "end": 80.89999999999999,
      "voice_start": 74.94,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 16,
      "scene_id": "03",
      "scene_title": "아직 없는 게임을 전달하기",
      "text": "여기서 다른 작품과 닮았다는 말만 남으면, 첫 번째 문제가 생깁니다.",
      "start": 81.02,
      "end": 85.22,
      "voice_start": 81.02,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 17,
      "scene_id": "04",
      "scene_title": "왜 이 게임을 선택해야 할까",
      "text": "듣는 사람은 이렇게 생각할 수 있습니다. 비슷한 재미라면, 이미 있는 게임을 하면 되는 것 아닌가?",
      "start": 85.53999999999999,
      "end": 91.39999999999999,
      "voice_start": 85.53999999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 18,
      "scene_id": "04",
      "scene_title": "왜 이 게임을 선택해야 할까",
      "text": "만드는 쪽이 유사성만 강조하면, 정작 우리 게임을 선택할 이유가 설명에서 사라집니다.",
      "start": 92.02,
      "end": 97.16,
      "voice_start": 92.02,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 19,
      "scene_id": "04",
      "scene_title": "왜 이 게임을 선택해야 할까",
      "text": "예를 들어 이 장면을 단지 점프하는 마리오라고 소개해 보죠. 그러면 모자를 던져 다른 대상을 조종하는 행동이 잘 드러나지 않습니다.",
      "start": 97.46,
      "end": 105.66,
      "voice_start": 97.46,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 20,
      "scene_id": "04",
      "scene_title": "왜 이 게임을 선택해야 할까",
      "text": "모자를 맞힌 뒤 조종 대상이 바뀌고, 그 대상의 능력으로 지나가지 못했던 곳을 통과한다면, 바로 그 행동과 결과를 말해야 합니다.",
      "start": 105.91999999999999,
      "end": 113.88,
      "voice_start": 105.91999999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 21,
      "scene_id": "04",
      "scene_title": "왜 이 게임을 선택해야 할까",
      "text": "비슷하다는 말에 새로움을 맡기지 말고, 플레이어가 무엇을 다르게 경험하는지 보여 주는 겁니다.",
      "start": 113.88,
      "end": 119.35999999999999,
      "voice_start": 113.88,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 22,
      "scene_id": "04",
      "scene_title": "왜 이 게임을 선택해야 할까",
      "text": "이 설명은 실제 개발사의 제안서를 소개하는 것이 아니라, 눈앞의 플레이를 말로 옮기는 연습입니다.",
      "start": 119.89999999999999,
      "end": 125.44,
      "voice_start": 119.89999999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 23,
      "scene_id": "05",
      "scene_title": "비교를 금지하는 규칙은 아니다",
      "text": "그렇다고 다른 게임의 이름을 무조건 금지하자는 뜻은 아닙니다.",
      "start": 125.99999999999999,
      "end": 129.7,
      "voice_start": 125.99999999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 24,
      "scene_id": "05",
      "scene_title": "비교를 금지하는 규칙은 아니다",
      "text": "같은 시리즈의 후속작이라면 익숙한 조작과 재미가 중요한 약속이 될 수도 있습니다.",
      "start": 129.94,
      "end": 134.7,
      "voice_start": 129.94,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 25,
      "scene_id": "05",
      "scene_title": "비교를 금지하는 규칙은 아니다",
      "text": "또 듣는 사람이 스스로 다른 게임을 떠올리는 것과, 만드는 사람이 그 이름에 설명을 맡기는 것은 다릅니다.",
      "start": 134.89999999999998,
      "end": 140.83999999999997,
      "voice_start": 134.89999999999998,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 26,
      "scene_id": "05",
      "scene_title": "비교를 금지하는 규칙은 아니다",
      "text": "조심해야 할 것은 비교 자체보다, 비교를 빼고 나면 내 게임을 설명할 내용이 남지 않는 상황입니다.",
      "start": 141.05999999999997,
      "end": 146.92,
      "voice_start": 141.05999999999997,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 27,
      "scene_id": "05",
      "scene_title": "비교를 금지하는 규칙은 아니다",
      "text": "그런데 고유한 매력을 덧붙여도, 아직 두 번째 문제가 남습니다. 같은 작품 이름을 들었다고 같은 경험을 떠올리는 건 아니니까요.",
      "start": 147.14,
      "end": 154.7,
      "voice_start": 147.14,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 28,
      "scene_id": "06",
      "scene_title": "누군가에게 마리오는 이 장면",
      "text": "슈퍼 마리오 브라더스를 먼저 떠올린 사람은 이런 화면을 생각할 수 있습니다.",
      "start": 155.01999999999998,
      "end": 159.21999999999997,
      "voice_start": 155.01999999999998,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 29,
      "scene_id": "06",
      "scene_title": "누군가에게 마리오는 이 장면",
      "text": "캐릭터를 옆에서 바라보며 오른쪽으로 진행하고, 구멍이나 적을 점프로 넘어갑니다.",
      "start": 159.43999999999997,
      "end": 164.71999999999997,
      "voice_start": 159.43999999999997,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 30,
      "scene_id": "06",
      "scene_title": "누군가에게 마리오는 이 장면",
      "text": "가까운 발판과 다음 발판의 높이, 그 사이의 빈 공간을 보고 뛰어야 하죠.",
      "start": 164.95999999999998,
      "end": 169.95999999999998,
      "voice_start": 164.95999999999998,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 31,
      "scene_id": "06",
      "scene_title": "누군가에게 마리오는 이 장면",
      "text": "끝의 깃대에 도착하면 그 구간의 목표를 달성합니다.",
      "start": 170.27999999999997,
      "end": 173.23999999999998,
      "voice_start": 170.27999999999997,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 32,
      "scene_id": "06",
      "scene_title": "누군가에게 마리오는 이 장면",
      "text": "이 경험을 기준으로 마리오 같은 게임을 이해하면, 옆으로 이어지는 길과 점프의 타이밍을 먼저 상상하기 쉽습니다.",
      "start": 173.54,
      "end": 180.38,
      "voice_start": 173.54,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 33,
      "scene_id": "06",
      "scene_title": "누군가에게 마리오는 이 장면",
      "text": "하지만 다른 사람이 최근에 주로 플레이한 마리오가 삼차원 공간을 탐험하는 게임이라면 어떨까요?",
      "start": 180.38,
      "end": 186.23999999999998,
      "voice_start": 180.38,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 34,
      "scene_id": "07",
      "scene_title": "다른 사람은 공간과 능력을 떠올린다",
      "text": "슈퍼 마리오 오디세이에서는 캐릭터 주변의 공간을 살펴보고, 갈 곳과 사용할 대상을 찾습니다.",
      "start": 186.6,
      "end": 192.26,
      "voice_start": 186.6,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 35,
      "scene_id": "07",
      "scene_title": "다른 사람은 공간과 능력을 떠올린다",
      "text": "여기서 모자 캐피로 특정 대상을 조종하는 기능이 캡처입니다. 화면을 저장한다는 뜻이 아니라, 그 대상이 되어 능력을 사용하는 행동이죠.",
      "start": 192.54,
      "end": 201.07999999999998,
      "voice_start": 192.54,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 36,
      "scene_id": "07",
      "scene_title": "다른 사람은 공간과 능력을 떠올린다",
      "text": "지금은 티라노사우루스를 캡처합니다. 모자를 던진 뒤 조종 대상이 바뀌고, 커다란 몸으로 돌을 부수며 길을 엽니다.",
      "start": 201.42,
      "end": 208.94,
      "voice_start": 201.42,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 37,
      "scene_id": "07",
      "scene_title": "다른 사람은 공간과 능력을 떠올린다",
      "text": "대상이 달라지면 할 수 있는 행동도 달라지는 거죠. 이 장면의 과제는 점프 타이밍만 맞추는 것이 아니라, 어떤 대상을 이용해 길을 열지 알아내는 데 있습니다.",
      "start": 209.16,
      "end": 218.16,
      "voice_start": 209.16,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 38,
      "scene_id": "07",
      "scene_title": "다른 사람은 공간과 능력을 떠올린다",
      "text": "같은 마리오라는 말에서 한 사람은 횡스크롤 점프를, 다른 사람은 공간 탐색과 능력 활용을 먼저 생각할 수 있는 겁니다.",
      "start": 218.62,
      "end": 225.56,
      "voice_start": 218.62,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 39,
      "scene_id": "07",
      "scene_title": "다른 사람은 공간과 능력을 떠올린다",
      "text": "어느 쪽이 틀린 기억인 것은 아닙니다. 서로 다른 경험을 같은 단어로 압축했을 뿐이죠.",
      "start": 225.98,
      "end": 230.66,
      "voice_start": 225.98,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 40,
      "scene_id": "08",
      "scene_title": "공통된 장면부터 만들기",
      "text": "이 차이를 줄이려면, 상대가 무엇을 떠올렸는지 먼저 확인해야 합니다.",
      "start": 231.14000000000001,
      "end": 235.18,
      "voice_start": 231.14000000000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 41,
      "scene_id": "08",
      "scene_title": "공통된 장면부터 만들기",
      "text": "같은 장면을 함께 본 뒤, 어디로 가는지, 무엇을 조작하는지, 어떤 조건에서 결과가 달라지는지를 짚어 보세요.",
      "start": 235.94000000000003,
      "end": 243.68,
