{
  "sample_rate": 24000,
  "duration_seconds": 291.7700000000001,
  "entries": [
    {
      "index": 1,
      "scene_id": "01",
      "scene_title": "점프는 왜 중요한가",
      "text": "게임에서 점프는 가장 익숙한 버튼 하나로 이루어지는 행동입니다.",
      "start": 0.0,
      "end": 5.36
    },
    {
      "index": 2,
      "scene_id": "01",
      "scene_title": "점프는 왜 중요한가",
      "text": "하지만 점프는 단순히 높은 곳으로 올라가는 기술이 아닙니다.",
      "start": 5.58,
      "end": 9.74
    },
    {
      "index": 3,
      "scene_id": "01",
      "scene_title": "점프는 왜 중요한가",
      "text": "플레이어가 어디까지 갈 수 있는지, 언제 위험을 감수할지, 공중에서 얼마나 선택할 수 있는지를 한 번에 결정합니다.",
      "start": 9.96,
      "end": 18.04
    },
    {
      "index": 4,
      "scene_id": "01",
      "scene_title": "점프는 왜 중요한가",
      "text": "같은 장애물을 넘어도 점프의 높이와 속도, 공중 조작의 정도가 달라지면 게임의 감각은 완전히 달라집니다.",
      "start": 18.259999999999998,
      "end": 25.86
    },
    {
      "index": 5,
      "scene_id": "01",
      "scene_title": "점프는 왜 중요한가",
      "text": "그래서 캐릭터가 점프하는 건 단순한 액션처럼 보여도, 그 안에는 게임의 손맛을 바꾸는 수많은 선택이 숨어 있습니다.",
      "start": 26.08,
      "end": 34.16
    },
    {
      "index": 6,
      "scene_id": "01",
      "scene_title": "점프는 왜 중요한가",
      "text": "이번에는 점프의 기본 물리부터, 게임마다 점프를 다르게 설계하는 이유까지 차례로 살펴보겠습니다.",
      "start": 34.379999999999995,
      "end": 41.26
    },
    {
      "index": 7,
      "scene_id": "02",
      "scene_title": "프레임마다 더해지는 중력",
      "text": "게임에서는 캐릭터가 공중에 있는 동안, 매 프레임 일정한 중력을 적용하는 경우가 많습니다.",
      "start": 41.91,
      "end": 48.23
    },
    {
      "index": 8,
      "scene_id": "02",
      "scene_title": "프레임마다 더해지는 중력",
      "text": "처음에 위쪽 속도를 5라고 해 보죠.",
      "start": 48.449999999999996,
      "end": 51.489999999999995
    },
    {
      "index": 9,
      "scene_id": "02",
      "scene_title": "프레임마다 더해지는 중력",
      "text": "그리고 공중에서는 매 프레임 1만큼의 아래 방향 가속도를 더합니다.",
      "start": 51.709999999999994,
      "end": 56.42999999999999
    },
    {
      "index": 10,
      "scene_id": "02",
      "scene_title": "프레임마다 더해지는 중력",
      "text": "그러면 속도 5로 올라가던 캐릭터는 다음 프레임에 4, 3, 2처럼 조금씩 느려집니다.",
      "start": 56.64999999999999,
      "end": 62.56999999999999
    },
    {
      "index": 11,
      "scene_id": "03",
      "scene_title": "최고점과 낙하",
      "text": "속도가 0이 되는 순간, 캐릭터는 점프의 최고점에 도달합니다.",
      "start": 63.21999999999999,
      "end": 68.17999999999999
    },
    {
      "index": 12,
      "scene_id": "03",
      "scene_title": "최고점과 낙하",
      "text": "하지만 중력은 멈추지 않습니다.",
      "start": 68.39999999999999,
      "end": 71.03999999999999
    },
    {
      "index": 13,
      "scene_id": "03",
      "scene_title": "최고점과 낙하",
      "text": "이제는 아래쪽 속도 1, 2, 3, 4처럼 점점 빠르게 떨어집니다.",
      "start": 71.25999999999999,
      "end": 76.69999999999999
    },
    {
      "index": 14,
      "scene_id": "03",
      "scene_title": "최고점과 낙하",
      "text": "평평한 지면이라면 보통 처음의 상승 속도와 비슷한 크기의 낙하 속도가 되었을 때 착지하게 됩니다.",
      "start": 76.91999999999999,
      "end": 84.19999999999999
    },
    {
      "index": 15,
      "scene_id": "04",
      "scene_title": "가로 이동과 설계 목표",
      "text": "지금까지의 설명은 Y축, 즉 세로 방향 움직임에 관한 것입니다.",
      "start": 84.85,
      "end": 91.08999999999999
    },
    {
      "index": 16,
      "scene_id": "04",
      "scene_title": "가로 이동과 설계 목표",
      "text": "반대로 X축의 가로 이동은 현재 속도를 유지하거나 조금만 감속시키는 경우가 많습니다.",
      "start": 91.30999999999999,
      "end": 97.38999999999999
    },
    {
      "index": 17,
      "scene_id": "04",
      "scene_title": "가로 이동과 설계 목표",
      "text": "실제 게임에는 최고 속도와 관성도 들어가지만, 중요한 건 점프의 사양이 게임의 목적에 따라 달라져야 한다는 사실입니다.",
      "start": 97.60999999999999,
      "end": 105.60999999999999
    },
    {
      "index": 18,
      "scene_id": "05",
      "scene_title": "슈퍼 마리오브라더스",
      "text": "슈퍼 마리오브라더스의 점프를 보면 상승 속도는 비교적 느립니다.",
      "start": 106.25999999999999,
      "end": 110.82
    },
    {
      "index": 19,
      "scene_id": "05",
      "scene_title": "슈퍼 마리오브라더스",
      "text": "즉, 올라가는 동안의 중력이 약하다는 뜻입니다.",
      "start": 111.03999999999999,
      "end": 114.88
    },
    {
      "index": 20,
      "scene_id": "05",
      "scene_title": "슈퍼 마리오브라더스",
      "text": "하지만 최고점 이후에는 속도가 빠르게 전환되어 하강이 상승보다 훨씬 빠르게 이루어집니다.",
      "start": 115.1,
      "end": 121.89999999999999
    },
    {
      "index": 21,
      "scene_id": "05",
      "scene_title": "슈퍼 마리오브라더스",
      "text": "버튼을 누르는 시간에 따라 점프 높이가 달라지는 시스템도 이 구조와 잘 맞습니다.",
      "start": 122.11999999999999,
      "end": 128.2
    },
    {
      "index": 22,
      "scene_id": "06",
      "scene_title": "메트로이드",
      "text": "메트로이드의 점프도 상승 속도가 상당히 느립니다.",
      "start": 128.85,
      "end": 132.85
    },
    {
      "index": 23,
      "scene_id": "06",
      "scene_title": "메트로이드",
      "text": "낙하 속도까지 느리기 때문에 전체적으로 둥실둥실 떠 있는 듯한 느낌을 줍니다.",
      "start": 133.07,
      "end": 139.07
    },
    {
      "index": 24,
      "scene_id": "06",
      "scene_title": "메트로이드",
      "text": "총알을 어느 높이에서 발사할지가 중요한 게임이기 때문에, 플레이어가 그 높이를 조절하기 쉽게 만든 설계일지도 모릅니다.",
      "start": 139.29,
      "end": 147.76999999999998
    },
    {
      "index": 25,
      "scene_id": "07",
      "scene_title": "마계촌",
      "text": "반면 마계촌은 비교적 낮은 점프를 사용하고, 공중에서는 좌우 이동이 거의 불가능합니다.",
      "start": 148.42,
      "end": 154.89999999999998
    },
    {
      "index": 26,
      "scene_id": "07",
      "scene_title": "마계촌",
      "text": "즉, 점프하는 순간 이미 착지 지점이 결정됩니다.",
      "start": 155.11999999999998,
      "end": 158.95999999999998
    },
    {
      "index": 27,
      "scene_id": "07",
      "scene_title": "마계촌",
      "text": "자유롭게 움직일 수 없다는 단점도 있지만, 그만큼 점프를 더 신중하게 사용하게 됩니다.",
      "start": 159.17999999999998,
      "end": 165.57999999999998
    },
    {
      "index": 28,
      "scene_id": "07",
      "scene_title": "마계촌",
      "text": "뒤로 물러나며 공격하는 히트 앤 런 플레이가 가능해지는 것도 이 제한 덕분입니다.",
      "start": 165.79999999999998,
      "end": 171.23999999999998
    },
    {
      "index": 29,
      "scene_id": "08",
      "scene_title": "스트리트 파이터 II",
      "text": "스트리트 파이터 II의 장기에프 스크류 파일드라이버를 보겠습니다.",
      "start": 171.89,
      "end": 176.20999999999998
    },
    {
      "index": 30,
      "scene_id": "08",
      "scene_title": "스트리트 파이터 II",
      "text": "터보 이후 버전에서는 상승 속도보다 낙하 속도가 더 빠르게 설정되어 있습니다.",
      "start": 176.42999999999998,
      "end": 182.82999999999998
    },
    {
      "index": 31,
      "scene_id": "08",
      "scene_title": "스트리트 파이터 II",
      "text": "그래서 상대를 더 강하게 바닥에 내리꽂는 듯한 인상이 생깁니다.",
      "start": 183.04999999999998,
      "end": 187.85
    },
    {
      "index": 32,
      "scene_id": "08",
      "scene_title": "스트리트 파이터 II",
      "text": "이동 궤적이 같더라도 속도만 조절해서 타격감과 손맛을 크게 바꿀 수 있다는 뜻입니다.",
      "start": 188.07,
      "end": 194.63
    },
    {
      "index": 33,
      "scene_id": "09",
      "scene_title": "스매시브라더스의 점프 스쿼트",
      "text": "대난투 스매시브라더스에는 점프하기 직전, 아주 짧은 준비 동작인 점프 스쿼트가 들어갑니다.",
      "start": 195.28,
      "end": 201.6
    },
    {
      "index": 34,
      "scene_id": "09",
      "scene_title": "스매시브라더스의 점프 스쿼트",
      "text": "예전 작품은 캐릭터마다 이 시간이 달라 개성이 있었지만, 지금은 비교적 짧고 비슷한 시간으로 통일되어 있습니다.",
      "start": 201.82,
      "end": 209.57999999999998
    },
    {
      "index": 35,
      "scene_id": "09",
      "scene_title": "스매시브라더스의 점프 스쿼트",
      "text": "이 준비 동작을 완전히 없애면 위 스매시 공격을 입력하려다가 의도치 않게 점프가 나갈 수 있습니다.",
      "start": 209.79999999999998,
      "end": 216.67999999999998
    },
    {
      "index": 36,
      "scene_id": "09",
      "scene_title": "스매시브라더스의 점프 스쿼트",
      "text": "그래서 완전히 0프레임으로 만들 수는 없습니다.",
      "start": 216.89999999999998,
      "end": 220.17999999999998
    },
    {
      "index": 37,
      "scene_id": "10",
      "scene_title": "얼티밋의 숨은 양념과 결론",
      "text": "스매시브라더스를 만들 때마다, 점프가 꼭 지금과 같은 방식이어야 하는지 다시 고민하게 됩니다.",
      "start": 220.82999999999998,
      "end": 227.63
    },
    {
      "index": 38,
      "scene_id": "10",
      "scene_title": "얼티밋의 숨은 양념과 결론",
      "text": "대난투 스매시브라더스 얼티밋은 예전에 별의 커비 슈퍼 디럭스에도 썼던 방식을 다시 채택했습니다.",
      "start": 227.85,
      "end": 235.45
    },
    {
      "index": 39,
      "scene_id": "10",
      "scene_title": "얼티밋의 숨은 양념과 결론",
      "text": "점프를 시작하는 순간 강한 상승 속도를 주고, 직후 몇 프레임에는 아주 강한 중력을 적용하는 방식입니다.",
      "start": 235.67,
      "end": 242.30999999999997
    },
    {
      "index": 40,
      "scene_id": "10",
      "scene_title": "얼티밋의 숨은 양념과 결론",
      "text": "처음에는 휙 올라가고, 곧바로 급하게 감속한 뒤, 이후에는 일반적인 중력으로 전환합니다.",
      "start": 242.52999999999997,
      "end": 248.68999999999997
    },
    {
      "index": 41,
      "scene_id": "10",
      "scene_title": "얼티밋의 숨은 양념과 결론",
      "text": "플레이어의 반응이 조금 늦어도 조작이 자연스럽게 받아들여지도록 하기 위해서입니다.",
      "start": 248.90999999999997,
      "end": 254.42999999999998
    },
    {
      "index": 42,
      "scene_id": "10",
      "scene_title": "얼티밋의 숨은 양념과 결론",
      "text": "그렇다면 재밌는 점프에는 하나의 정답이 있을까요? 꼭 그렇지는 않습니다.",
      "start": 254.64999999999998,
      "end": 259.60999999999996
    },
    {
      "index": 43,
      "scene_id": "10",
      "scene_title": "얼티밋의 숨은 양념과 결론",
      "text": "높이와 속도 자체보다 중요한 건, 그 점프가 플레이어에게 어떤 판단과 감정을 만들게 하는가입니다.",
      "start": 259.83,
      "end": 266.63
    },
    {
      "index": 44,
      "scene_id": "10",
      "scene_title": "얼티밋의 숨은 양념과 결론",
      "text": "점프하기 전에 거리를 재게 만들지, 공중에서 방향을 바꾸게 할지, 착지 순간에 강한 쾌감을 줄지부터 생각해 보세요.",
      "start": 266.85,
      "end": 276.29
    },
    {
      "index": 45,
      "scene_id": "10",
      "scene_title": "얼티밋의 숨은 양념과 결론",
      "text": "초기 속도, 중력, 공중 조작, 준비 프레임을 조금씩 바꾸고 직접 플레이하며 원하는 감각을 찾아보면 됩니다.",
      "start": 276.51000000000005,
      "end": 284.75000000000006
    },
    {
      "index": 46,
      "scene_id": "10",
      "scene_title": "얼티밋의 숨은 양념과 결론",
      "text": "이런 숨은 양념이 움직임을 또렷하게 만들고, 점프 하나에도 깊고 재미있는 게임 디자인을 담아냅니다.",
      "start": 284.9700000000001,
      "end": 291.7700000000001
    }
  ]
}
