{
  "sample_rate": 24000,
  "duration_seconds": 222.56,
  "render_mode": "scene",
  "example_seconds": 19.5,
  "narration_placement": "continuous-across-example-and-explanation",
  "entries": [
    {
      "index": 1,
      "scene_id": "01",
      "scene_title": "버튼은 하나, 판단은 여러 개",
      "text": "버튼이 하나뿐이면, 할 수 있는 일도 하나뿐일까요?",
      "start": 0.0,
      "end": 3.0825
    },
    {
      "index": 2,
      "scene_id": "01",
      "scene_title": "버튼은 하나, 판단은 여러 개",
      "text": "커비의 미니게임, 캐너볼트, 지오메트리 대시를 보면 꼭 그렇지는 않습니다. 같은 버튼으로도 전혀 다른 판단을 하게 되죠.",
      "start": 3.0825,
      "end": 11.1925
    },
    {
      "index": 3,
      "scene_id": "01",
      "scene_title": "버튼은 하나, 판단은 여러 개",
      "text": "손가락은 같은 버튼을 누르는데, 머릿속에서 하는 판단은 전혀 다릅니다.",
      "start": 11.1925,
      "end": 16.1925
    },
    {
      "index": 4,
      "scene_id": "01",
      "scene_title": "버튼은 하나, 판단은 여러 개",
      "text": "이번에는 원버튼 게임을 네 가지 방식으로 나눠보고, 적은 조작으로도 재미를 만드는 방법을 살펴보겠습니다.",
      "start": 16.1925,
      "end": 23.2
    },
    {
      "index": 5,
      "scene_id": "02",
      "scene_title": "연타 — 얼마나 빠르게 누를까",
      "text": "첫 번째는 연타입니다. 정해진 시간 동안 버튼을 얼마나 빠르게 누르는지 겨루는 방식이죠.",
      "start": 23.919999999999998,
      "end": 29.9225
    },
    {
      "index": 6,
      "scene_id": "02",
      "scene_title": "연타 — 얼마나 빠르게 누를까",
      "text": "설명은 짧습니다. 누르면 힘이 쌓이고, 더 빨리 누르면 더 멀리 갑니다. 규칙을 몰라도 화면을 보면 바로 이해할 수 있습니다.",
      "start": 29.9225,
      "end": 37.2425
    },
    {
      "index": 7,
      "scene_id": "02",
      "scene_title": "연타 — 얼마나 빠르게 누를까",
      "text": "다만 같은 동작을 오래 반복하면 피곤해질 수 있고, 사람마다 누를 수 있는 속도도 다릅니다.",
      "start": 37.2425,
      "end": 42.8725
    },
    {
      "index": 8,
      "scene_id": "02",
      "scene_title": "연타 — 얼마나 빠르게 누를까",
      "text": "그래서 무작정 오래 누르게 하기보다는, 짧게 힘을 쏟는 구간과 쉬는 구간을 나누는 편이 어울릴 수 있습니다.",
      "start": 42.8725,
      "end": 49.9525
    },
    {
      "index": 9,
      "scene_id": "02",
      "scene_title": "연타 — 얼마나 빠르게 누를까",
      "text": "연타는 나쁜 조작이 아니라, 순간적인 긴장과 노력을 어디에 쓸지 정해야 하는 조작입니다.",
      "start": 49.9525,
      "end": 55.599999999999994
    },
    {
      "index": 10,
      "scene_id": "03",
      "scene_title": "타이밍 — 지금 누르면 맞을까",
      "text": "두 번째는 타이밍입니다. 커비의 메가톤 펀치는 힘과 위치, 마지막 순간을 맞춥니다. 지오메트리 대시는 다가오는 장애물을 보고 점프할 순간을 고르죠.",
      "start": 56.31999999999999,
      "end": 66.32249999999999
    },
    {
      "index": 11,
      "scene_id": "03",
      "scene_title": "타이밍 — 지금 누르면 맞을까",
      "text": "여기서는 많이 누른다고 잘하는 게 아닙니다. 움직임을 읽고, 원하는 순간까지 기다리는 것이 중요하죠.",
      "start": 66.32249999999999,
      "end": 72.49249999999999
    },
    {
      "index": 12,
      "scene_id": "03",
      "scene_title": "타이밍 — 지금 누르면 맞을까",
      "text": "같은 버튼이어도 목표 구간을 넓히면 여유로운 놀이가 되고, 좁히면 정밀한 도전이 됩니다.",
      "start": 72.49249999999999,
      "end": 78.0025
    },
    {
      "index": 13,
      "scene_id": "03",
      "scene_title": "타이밍 — 지금 누르면 맞을까",
      "text": "실패했을 때 조금 빨랐는지, 조금 늦었는지도 보여주면 좋습니다. 그래야 다음에는 무엇을 바꿔야 할지 알 수 있으니까요.",
      "start": 78.0025,
      "end": 85.93249999999999
    },
    {
      "index": 14,
      "scene_id": "03",
      "scene_title": "타이밍 — 지금 누르면 맞을까",
      "text": "아, 한 박자만 늦게 누를걸. 이 생각이 들었다면, 플레이어는 벌써 다음 시도를 준비하고 있는 셈입니다.",
      "start": 85.93249999999999,
      "end": 92.07999999999998
    },
    {
      "index": 15,
      "scene_id": "04",
      "scene_title": "반응 — 신호가 나오면 눌러라",
      "text": "세 번째는 반응입니다. 사무라이 커비처럼 신호가 나타난 뒤, 상대보다 빨리 누르는 놀이입니다.",
      "start": 92.79999999999998,
      "end": 98.82249999999998
    },
    {
      "index": 16,
      "scene_id": "04",
      "scene_title": "반응 — 신호가 나오면 눌러라",
      "text": "타이밍 게임이 앞으로 올 순간을 읽는 쪽이라면, 반응 게임은 신호가 정말 나왔는지 확인하는 쪽에 가깝습니다.",
      "start": 98.82249999999998,
      "end": 105.47249999999998
    },
    {
      "index": 17,
      "scene_id": "04",
      "scene_title": "반응 — 신호가 나오면 눌러라",
      "text": "빨리 누르고 싶지만, 너무 먼저 누르면 실패합니다. 그래서 아무 일도 일어나지 않는 대기 시간에도 긴장감이 생깁니다.",
      "start": 105.47249999999998,
      "end": 112.87249999999999
    },
    {
      "index": 18,
      "scene_id": "04",
      "scene_title": "반응 — 신호가 나오면 눌러라",
      "text": "이때 신호를 보기 어렵게 만드는 것과, 기다리는 순간을 긴장되게 만드는 것은 다릅니다.",
      "start": 112.87249999999999,
      "end": 118.21249999999998
    },
    {
      "index": 19,
      "scene_id": "04",
      "scene_title": "반응 — 신호가 나오면 눌러라",
      "text": "색이나 소리만 믿기보다는 여러 단서를 함께 주고, 성공과 실패의 기준을 분명하게 보여주는 것이 좋습니다.",
      "start": 118.21249999999998,
      "end": 124.63999999999999
    },
    {
      "index": 20,
      "scene_id": "05",
      "scene_title": "누르기와 떼기 — 무엇을 받아들일까",
      "text": "네 번째는 누른 상태와 뗀 상태를 바꾸는 방식입니다.",
      "start": 125.35999999999999,
      "end": 129.14249999999998
    },
    {
      "index": 21,
      "scene_id": "05",
      "scene_title": "누르기와 떼기 — 무엇을 받아들일까",
      "text": "커비의 에그 캐처에서는 달걀이 올 때 버튼을 누르고, 폭탄이 올 때는 뗍니다. 같은 곳으로 다가와도 받아들일 것과 피할 것을 골라야 하죠.",
      "start": 129.14249999999998,
      "end": 138.52249999999998
    },
    {
      "index": 22,
      "scene_id": "05",
      "scene_title": "누르기와 떼기 — 무엇을 받아들일까",
      "text": "여기서 핵심은 버튼을 한 번 눌러 기능을 켜고 끄는 토글이 아니라, 지금 누르고 있는지 아닌지입니다.",
      "start": 138.52249999999998,
      "end": 145.05249999999998
    },
    {
      "index": 23,
      "scene_id": "05",
      "scene_title": "누르기와 떼기 — 무엇을 받아들일까",
      "text": "플레이어는 다가오는 물체를 보고, 행동을 유지할지 바꿀지 계속 판단합니다.",
      "start": 145.05249999999998,
      "end": 150.03249999999997
    },
    {
      "index": 24,
      "scene_id": "05",
      "scene_title": "누르기와 떼기 — 무엇을 받아들일까",
      "text": "버튼 하나에 기능을 잔뜩 숨긴 것이 아닙니다. 두 가지 상태만으로도 상황에 따라 다른 선택이 생기는 것입니다.",
      "start": 150.03249999999997,
      "end": 157.2
    },
    {
      "index": 25,
      "scene_id": "06",
      "scene_title": "입력이 단순할수록, 결과는 선명하게",
      "text": "이제 같은 버튼을 두 화면에 붙여 보겠습니다. 왼쪽은 눌러도 숫자만 바뀌고, 오른쪽은 버튼이 내려가며 물체가 튀고 결과가 또렷하게 보입니다.",
      "start": 157.92,
      "end": 166.93249999999998
    },
    {
      "index": 26,
      "scene_id": "06",
      "scene_title": "입력이 단순할수록, 결과는 선명하게",
      "text": "규칙이 같아도, 내가 눌렀다는 사실과 그 결과를 얼마나 잘 전달하느냐에 따라 느낌은 달라질 수 있습니다.",
      "start": 166.93249999999998,
      "end": 174.2025
    },
    {
      "index": 27,
      "scene_id": "06",
      "scene_title": "입력이 단순할수록, 결과는 선명하게",
      "text": "캐너볼트도 점프 버튼 하나로 달립니다. 누르는 순간뿐 아니라 누르는 길이로 점프 높이를 바꿔, 앞의 틈과 장애물에 맞춰야 하죠.",
      "start": 174.2025,
      "end": 182.09249999999997
    },
    {
      "index": 28,
      "scene_id": "06",
      "scene_title": "입력이 단순할수록, 결과는 선명하게",
      "text": "이처럼 길게 누르기는 실수를 막는 확인 버튼이 될 수도 있고, 점프의 높이나 발사할 순간을 고르는 조작이 될 수도 있습니다.",
      "start": 182.09249999999997,
      "end": 189.36249999999998
    },
    {
      "index": 29,
      "scene_id": "06",
      "scene_title": "입력이 단순할수록, 결과는 선명하게",
      "text": "단, 화면을 흔들고 소리를 키우는 것이 무조건 좋은 피드백은 아닙니다. 다음 판단에 필요한 정보를 선명하게 주는 것이 먼저입니다.",
      "start": 189.36249999999998,
      "end": 197.2
    },
    {
      "index": 30,
      "scene_id": "07",
      "scene_title": "버튼보다 먼저, 플레이어의 판단을 설계하자",
      "text": "정리해보면 연타는 속도, 타이밍은 순간, 반응은 신호, 누르기와 떼기는 상태를 다룹니다.",
      "start": 197.92,
      "end": 202.8425
    },
    {
      "index": 31,
      "scene_id": "07",
      "scene_title": "버튼보다 먼저, 플레이어의 판단을 설계하자",
      "text": "새로운 조작을 만들 때는 버튼을 몇 개 쓸지보다, 플레이어가 무엇을 보고 언제 결정할지를 먼저 생각해 보세요.",
      "start": 202.8425,
      "end": 211.0625
    },
    {
      "index": 32,
      "scene_id": "07",
      "scene_title": "버튼보다 먼저, 플레이어의 판단을 설계하자",
      "text": "그리고 누른 결과가 바로 이해되는지, 실패한 이유를 알아볼 수 있는지도 확인하면 좋습니다.",
      "start": 211.0625,
      "end": 216.4725
    },
    {
      "index": 33,
      "scene_id": "07",
      "scene_title": "버튼보다 먼저, 플레이어의 판단을 설계하자",
      "text": "버튼은 하나여도 괜찮습니다. 그 하나를 누르는 이유가 재미있다면, 게임은 이미 시작된 것이니까요.",
      "start": 216.4725,
      "end": 222.56
    }
  ]
}
