  "entries": [
    {
      "index": 1,
      "scene_id": "01",
      "scene_title": "이런 것도 만들었네요",
      "text": "기사의 캠프부터 하늘을 달리는 기차까지. 아스트라를 활용했다고 소개된 작품 여덟 가지, 같이 구경해 볼까요?",
      "start": 0,
      "end": 7.32,
      "voice_start": 0.0,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 2,
      "scene_id": "02",
      "scene_title": "모닥불 옆 기사의 하루",
      "text": "첫 번째는 모닥불 옆에서 지내는 기사의 작은 캠프입니다.",
      "start": 8,
      "end": 11.92,
      "voice_start": 8.0,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 3,
      "scene_id": "02",
      "scene_title": "모닥불 옆 기사의 하루",
      "text": "장작을 넣고, 검술을 연습하고, 고기를 구워 먹습니다. 피곤하면 누워서 잠도 자네요.",
      "start": 12.04,
      "end": 17.48,
      "voice_start": 12.04,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 4,
      "scene_id": "02",
      "scene_title": "모닥불 옆 기사의 하루",
      "text": "전투만 하는 기사가 아니라, 쉬는 시간까지 만들어 놓았습니다.",
      "start": 17.740000000000002,
      "end": 21.1,
      "voice_start": 17.740000000000002,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 5,
      "scene_id": "03",
      "scene_title": "하늘을 달리는 기차",
      "text": "이번에는 하늘을 달리는 기차 게임입니다.",
      "start": 34,
      "end": 36.8,
      "voice_start": 34.0,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 6,
      "scene_id": "03",
      "scene_title": "하늘을 달리는 기차",
      "text": "떠 있는 섬 사이를 여행하고, 역에 도착하면 승객을 태웁니다. 차고에서는 기차도 직접 꾸밀 수 있네요.",
      "start": 37.06,
      "end": 43.36,
      "voice_start": 37.06,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 7,
      "scene_id": "03",
      "scene_title": "하늘을 달리는 기차",
      "text": "기차를 운전해야 하는데, 풍경부터 구경하고 싶어집니다.",
      "start": 43.519999999999996,
      "end": 46.86,
      "voice_start": 43.519999999999996,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 8,
      "scene_id": "04",
      "scene_title": "내 방을 꾸미고 낚시까지",
      "text": "이번 작품은 나만의 방을 꾸미고 돌아다니는 가상 공간입니다.",
      "start": 65,
      "end": 69.12,
      "voice_start": 65.0,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 9,
      "scene_id": "04",
      "scene_title": "내 방을 꾸미고 낚시까지",
      "text": "책상과 의자를 놓고 색을 바꾼 다음, 직접 공간 안으로 들어가 볼 수 있습니다. 밖으로 나오면 낚시도 하네요.",
      "start": 69.3,
      "end": 75.78,
      "voice_start": 69.3,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 10,
      "scene_id": "04",
      "scene_title": "내 방을 꾸미고 낚시까지",
      "text": "방 꾸미러 왔다가, 물고기까지 잡고 갑니다.",
      "start": 76.0,
      "end": 78.42,
      "voice_start": 76.0,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 11,
      "scene_id": "05",
      "scene_title": "한 사람이 만든 네 가지 작품",
      "text": "여기에는 한 제작자가 만든 작품 네 개가 모여 있습니다.",
      "start": 92,
      "end": 95.44,
      "voice_start": 92.0,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 12,
      "scene_id": "05",
      "scene_title": "한 사람이 만든 네 가지 작품",
      "text": "주민들이 돌아다니는 운하 마을, 전선에 닿지 않게 고리를 움직이는 게임.",
      "start": 95.7,
      "end": 99.94,
      "voice_start": 95.7,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 13,
      "scene_id": "05",
      "scene_title": "한 사람이 만든 네 가지 작품",
      "text": "요리사를 피해 달아나는 추격전도 있고, 직접 조립한 탈것으로 경사로를 달리는 게임도 있습니다.",
      "start": 100.12,
      "end": 105.94,
      "voice_start": 100.12,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 14,
      "scene_id": "05",
      "scene_title": "한 사람이 만든 네 가지 작품",
      "text": "조용한 마을 구경부터 아슬아슬한 장애물 피하기까지, 분위기가 전부 다르네요.",
      "start": 106.3,
      "end": 111.03999999999999,
      "voice_start": 106.3,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 15,
      "scene_id": "06",
      "scene_title": "캐릭터를 더 예쁘게 다듬기",
      "text": "이번에는 작은 캐릭터의 모습을 다듬는 작업입니다.",
      "start": 132,
      "end": 135.12,
      "voice_start": 132.0,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 16,
      "scene_id": "06",
      "scene_title": "캐릭터를 더 예쁘게 다듬기",
      "text": "옷과 머리카락의 색을 정리하고, 앞뒤로 돌려가며 어색한 부분을 살펴봅니다.",
      "start": 135.36,
      "end": 140.1,
      "voice_start": 135.36,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 17,
      "scene_id": "06",
      "scene_title": "캐릭터를 더 예쁘게 다듬기",
      "text": "아직 손볼 곳은 있지만, 캐릭터를 조금씩 완성해 가는 모습이 보이네요.",
      "start": 140.42,
      "end": 144.46,
      "voice_start": 140.42,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 18,
      "scene_id": "07",
      "scene_title": "만화 같은 캐릭터 표현",
      "text": "여기서는 젠레스 존 제로 같은 느낌으로 캐릭터의 색과 그림자를 표현했습니다.",
      "start": 151.5,
      "end": 156.04,
      "voice_start": 151.5,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 19,
      "scene_id": "07",
      "scene_title": "만화 같은 캐릭터 표현",
      "text": "캐릭터 자체를 새로 만든 것이 아니라, 게임 속에서 어떻게 보일지를 작업한 사례입니다.",
      "start": 156.48,
      "end": 160.84,
      "voice_start": 156.48,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 20,
      "scene_id": "07",
      "scene_title": "만화 같은 캐릭터 표현",
      "text": "얼굴과 옷을 가까이 보여주니, 만화 같은 색감이 눈에 들어오네요.",
      "start": 161.28,
      "end": 164.88,
      "voice_start": 161.28,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 21,
      "scene_id": "08",
      "scene_title": "다른 게임의 그림체도",
      "text": "같은 제작자가 이번에는 엔드필드 느낌의 캐릭터 표현도 선보였습니다.",
      "start": 175.49999999999997,
      "end": 180.09999999999997,
      "voice_start": 175.49999999999997,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 22,
      "scene_id": "08",
      "scene_title": "다른 게임의 그림체도",
      "text": "머리카락과 옷의 색, 그림자를 보여주고, 캐릭터를 돌려가며 여러 각도에서 살펴봅니다.",
      "start": 180.29999999999998,
      "end": 185.57999999999998,
      "voice_start": 180.29999999999998,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 23,
      "scene_id": "08",
      "scene_title": "다른 게임의 그림체도",
      "text": "같은 입체 캐릭터라도, 어떤 색감으로 보여주느냐에 따라 느낌이 달라지네요.",
      "start": 185.97999999999996,
      "end": 190.67999999999998,
      "voice_start": 185.97999999999996,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 24,
      "scene_id": "09",
      "scene_title": "차를 타고 돌아다니는 도시",
      "text": "마지막은 자동차를 타고 돌아다니는 도시입니다.",
      "start": 199.5,
      "end": 202.36,
      "voice_start": 199.5,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 25,
      "scene_id": "09",
      "scene_title": "차를 타고 돌아다니는 도시",
      "text": "바닷가 도로를 달리고, 차에서 내려 거리를 걷고, 총을 쏘는 장면도 보여줍니다.",
      "start": 202.58,
      "end": 207.5,
      "voice_start": 202.58,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 26,
      "scene_id": "09",
      "scene_title": "차를 타고 돌아다니는 도시",
      "text": "건물과 자동차, 사람까지 한 화면에 모이니, 작은 장면보다는 게임 속 동네 하나를 구경하는 느낌입니다.",
      "start": 207.74,
      "end": 214.12,
      "voice_start": 207.74,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 27,
      "scene_id": "09",
      "scene_title": "차를 타고 돌아다니는 도시",
      "text": "다음 골목에는 뭐가 있을지 궁금해지네요.",
      "start": 214.38,
      "end": 216.78,
      "voice_start": 214.38,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 28,
      "scene_id": "10",
      "scene_title": "어떤 작품이 가장 끌리나요?",
      "text": "작은 캠프부터 도시까지, 정말 다양하죠? 여러분은 어떤 작품을 직접 해보고 싶으신가요? 댓글로 알려주세요.",
      "start": 229.49999999999997,
      "end": 237.07999999999998,
      "voice_start": 229.49999999999997,
      "alignment": "whisper-word-timestamps-script-matched"
    }
  ],
