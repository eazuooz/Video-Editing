  "narration_placement": "continuous-across-example-and-explanation",
  "entries": [
    {
      "index": 1,
      "scene_id": "01",
      "scene_title": "입력을 받았다는 신호",
      "text": "에이퍼처 데스크 잡에서는 조작 패널과 버튼 안내가 화면 안에 들어옵니다.",
      "start": 0.0,
      "end": 4.7125
    },
    {
      "index": 2,
      "scene_id": "01",
      "scene_title": "입력을 받았다는 신호",
      "text": "하프라이프 알릭스에서는 집을 수 있는 대상이 손의 움직임과 함께 강조됩니다.",
      "start": 4.7125,
      "end": 9.5025
    },
    {
      "index": 3,
      "scene_id": "01",
      "scene_title": "입력을 받았다는 신호",
      "text": "이런 표시가 있더라도, 누른 뒤 아무 변화가 없으면 다른 질문이 생깁니다.",
      "start": 9.5025,
      "end": 14.0325
    },
    {
      "index": 4,
      "scene_id": "01",
      "scene_title": "입력을 받았다는 신호",
      "text": "버튼을 못 받은 걸까요, 받았지만 지금 실행할 수 없는 걸까요?",
      "start": 14.0325,
      "end": 17.8825
    },
    {
      "index": 5,
      "scene_id": "01",
      "scene_title": "입력을 받았다는 신호",
      "text": "직접 만든 테스트에서 문을 열어 보겠습니다.",
      "start": 17.8825,
      "end": 20.6925
    },
    {
      "index": 6,
      "scene_id": "01",
      "scene_title": "입력을 받았다는 신호",
      "text": "두 화면의 문은 똑같이 잠겨 있고, 누른 버튼도 같습니다.",
      "start": 20.6925,
      "end": 24.0925
    },
    {
      "index": 7,
      "scene_id": "01",
      "scene_title": "입력을 받았다는 신호",
      "text": "한쪽은 그대로 있고, 다른 쪽은 잠긴 이유를 짧게 알려 줍니다.",
      "start": 24.0925,
      "end": 27.9525
    },
    {
      "index": 8,
      "scene_id": "01",
      "scene_title": "입력을 받았다는 신호",
      "text": "입력을 받았다는 응답은, 행동에 성공했다는 칭찬과 구분해야 합니다.",
      "start": 27.9525,
      "end": 32.32
    },
    {
      "index": 9,
      "scene_id": "02",
      "scene_title": "거절할 때는 다음 행동의 단서",
      "text": "이번에는 건물을 놓을 자리를 고르는 테스트입니다.",
      "start": 33.04,
      "end": 36.5025
    },
    {
      "index": 10,
      "scene_id": "02",
      "scene_title": "거절할 때는 다음 행동의 단서",
      "text": "이미 건물이 있는 곳에 놓으려 하면, 두 화면 모두 건설을 거절합니다.",
      "start": 36.5025,
      "end": 40.9925
    },
    {
      "index": 11,
      "scene_id": "02",
      "scene_title": "거절할 때는 다음 행동의 단서",
      "text": "한쪽은 색만 바뀌고, 다른 쪽은 다른 건물과 겹친다고 알려 줍니다.",
      "start": 40.9925,
      "end": 45.4625
    },
    {
      "index": 12,
      "scene_id": "02",
      "scene_title": "거절할 때는 다음 행동의 단서",
      "text": "빈자리로 옮겨도 재료가 부족하면, 부족한 재료가 표시됩니다.",
      "start": 45.4625,
      "end": 49.6025
    },
    {
      "index": 13,
      "scene_id": "02",
      "scene_title": "거절할 때는 다음 행동의 단서",
      "text": "거절 이유가 달라졌으니, 다음에 해 볼 행동도 달라집니다.",
      "start": 49.6025,
      "end": 53.552499999999995
    },
    {
      "index": 14,
      "scene_id": "02",
      "scene_title": "거절할 때는 다음 행동의 단서",
      "text": "건설 불가라는 한 문구로 모든 상황을 뭉개지 않는 것입니다.",
      "start": 53.552499999999995,
      "end": 57.2425
    },
    {
      "index": 15,
      "scene_id": "02",
      "scene_title": "거절할 때는 다음 행동의 단서",
      "text": "설명은 짧게 두고, 색상과 함께 글자로도 거절 이유를 알려 주세요.",
      "start": 57.2425,
      "end": 61.4925
    },
    {
      "index": 16,
      "scene_id": "02",
      "scene_title": "거절할 때는 다음 행동의 단서",
      "text": "이 테스트의 재료 수와 배치는 설명을 위해 직접 만든 조건입니다.",
      "start": 61.4925,
      "end": 65.68
    },
    {
      "index": 17,
      "scene_id": "03",
      "scene_title": "메뉴에서는 확인 의도를 알아보기",
      "text": "게임을 시작하는 메뉴에서 확인 버튼을 잘못 누를 수도 있습니다.",
      "start": 66.4,
      "end": 70.4325
    },
    {
      "index": 18,
      "scene_id": "03",
      "scene_title": "메뉴에서는 확인 의도를 알아보기",
      "text": "이번 비교는 한쪽은 엔터만, 다른 쪽은 엔터와 스페이스를 확인으로 받습니다.",
      "start": 70.4325,
      "end": 75.6025
    },
    {
      "index": 19,
      "scene_id": "03",
      "scene_title": "메뉴에서는 확인 의도를 알아보기",
      "text": "두 번째 화면은 받을 수 있는 버튼을 메뉴 옆에 함께 표시합니다.",
      "start": 75.6025,
      "end": 79.77250000000001
    },
    {
      "index": 20,
      "scene_id": "03",
      "scene_title": "메뉴에서는 확인 의도를 알아보기",
      "text": "같은 확인 의도로 쓰기 쉬운 버튼을 연결해 보는 방법입니다.",
      "start": 79.77250000000001,
      "end": 83.6225
    },
    {
      "index": 21,
      "scene_id": "03",
      "scene_title": "메뉴에서는 확인 의도를 알아보기",
      "text": "하지만 뒤로 가기나 삭제처럼 결과가 다른 버튼까지 섞어서는 안 됩니다.",
      "start": 83.6225,
      "end": 88.36250000000001
    },
    {
      "index": 22,
      "scene_id": "03",
      "scene_title": "메뉴에서는 확인 의도를 알아보기",
      "text": "여러 버튼을 받는 것이 항상 정답이라는 뜻도 아닙니다.",
      "start": 88.36250000000001,
      "end": 92.2425
    },
    {
      "index": 23,
      "scene_id": "03",
      "scene_title": "메뉴에서는 확인 의도를 알아보기",
      "text": "우리 게임의 조작 약속과 충돌하는지 먼저 살펴보세요.",
      "start": 92.2425,
      "end": 95.7025
    },
    {
      "index": 24,
      "scene_id": "03",
      "scene_title": "메뉴에서는 확인 의도를 알아보기",
      "text": "확인할 수 있는 방법을 알아보고, 누른 뒤의 상태도 이어서 보여 줍니다.",
      "start": 95.7025,
      "end": 100.08000000000001
    },
    {
      "index": 25,
      "scene_id": "04",
      "scene_title": "컷신은 응답과 확정을 나누기",
      "text": "컷신을 건너뛰려고 버튼을 눌렀는데 아무 반응이 없을 때도 있습니다.",
      "start": 100.80000000000001,
      "end": 105.41250000000001
    },
    {
      "index": 26,
      "scene_id": "04",
      "scene_title": "컷신은 응답과 확정을 나누기",
      "text": "이 테스트는 짧게 누르면 건너뛰기 안내를 보여 줍니다.",
      "start": 105.41250000000001,
      "end": 109.30250000000001
    },
    {
      "index": 27,
      "scene_id": "04",
      "scene_title": "컷신은 응답과 확정을 나누기",
      "text": "길게 누르면 표시가 차오르고, 끝까지 채웠을 때 컷신을 넘깁니다.",
      "start": 109.30250000000001,
      "end": 113.75250000000001
    },
    {
      "index": 28,
      "scene_id": "04",
      "scene_title": "컷신은 응답과 확정을 나누기",
      "text": "실수로 한 번 눌렀다고 장면 전체가 사라지지 않게 하는 선택입니다.",
      "start": 113.75250000000001,
      "end": 118.36250000000001
    },
    {
      "index": 29,
      "scene_id": "04",
      "scene_title": "컷신은 응답과 확정을 나누기",
      "text": "누른 뜻을 알아봤다는 신호와, 정말 건너뛰겠다는 확정을 나누는 거죠.",
      "start": 118.36250000000001,
      "end": 123.4325
    },
    {
      "index": 30,
      "scene_id": "04",
      "scene_title": "컷신은 응답과 확정을 나누기",
      "text": "버튼을 중간에 놓으면 확인이 취소되고 장면은 계속됩니다.",
      "start": 123.4325,
      "end": 127.36250000000001
    },
    {
      "index": 31,
      "scene_id": "04",
      "scene_title": "컷신은 응답과 확정을 나누기",
      "text": "모든 컷신에 길게 누르기를 강제할 필요는 없습니다.",
      "start": 127.36250000000001,
      "end": 130.8925
    },
    {
      "index": 32,
      "scene_id": "04",
      "scene_title": "컷신은 응답과 확정을 나누기",
      "text": "응답이 없어서 다시 누르는 상황과, 기다려야 하는 상황을 구분해 보세요.",
      "start": 130.8925,
      "end": 135.68004166666668
    },
    {
      "index": 33,
      "scene_id": "05",
      "scene_title": "처리 중을 완료처럼 말하지 않기",
      "text": "저장처럼 결과가 바로 끝나지 않는 동작도 있습니다.",
      "start": 136.40004166666668,
      "end": 139.81254166666668
    },
    {
      "index": 34,
      "scene_id": "05",
      "scene_title": "처리 중을 완료처럼 말하지 않기",
      "text": "이 테스트에서는 요청을 받으면 저장 중이라는 상태를 먼저 보여 줍니다.",
      "start": 139.81254166666668,
      "end": 144.47254166666667
    },
    {
      "index": 35,
      "scene_id": "05",
      "scene_title": "처리 중을 완료처럼 말하지 않기",
      "text": "아직 끝나지 않았으므로 저장 완료라고 표시하지 않습니다.",
      "start": 144.47254166666667,
      "end": 148.1425416666667
    },
    {
      "index": 36,
      "scene_id": "05",
      "scene_title": "처리 중을 완료처럼 말하지 않기",
      "text": "처리 중에 다시 눌러도 새 요청을 계속 쌓지 않고, 진행 중이라고 알려 줍니다.",
      "start": 148.1425416666667,
      "end": 153.3625416666667
    },
    {
      "index": 37,
      "scene_id": "05",
      "scene_title": "처리 중을 완료처럼 말하지 않기",
      "text": "완료 상태가 확인된 뒤에만 문구를 바꿉니다.",
      "start": 153.3625416666667,
      "end": 156.21254166666668
    },
    {
      "index": 38,
      "scene_id": "05",
      "scene_title": "처리 중을 완료처럼 말하지 않기",
      "text": "실제 저장 기능을 구현한 게임이라면 실패했을 때의 응답도 필요합니다.",
      "start": 156.21254166666668,
      "end": 160.9525416666667
    },
    {
      "index": 39,
      "scene_id": "05",
      "scene_title": "처리 중을 완료처럼 말하지 않기",
      "text": "여기서는 대기 시간을 둔 모의 작업으로 상태 전환을 비교합니다.",
      "start": 160.9525416666667,
      "end": 165.0125416666667
    },
    {
      "index": 40,
      "scene_id": "05",
      "scene_title": "처리 중을 완료처럼 말하지 않기",
      "text": "입력 수신, 처리 중, 완료를 구분하면 기다림의 의미를 설명할 수 있습니다.",
      "start": 165.0125416666667,
      "end": 169.76008333333334
    },
    {
      "index": 41,
      "scene_id": "06",
      "scene_title": "필요한 곳에만 응답하기",
      "text": "모든 키마다 소리와 문구를 띄우면 화면은 금방 시끄러워집니다.",
      "start": 170.48008333333334,
      "end": 174.64258333333333
    },
    {
      "index": 42,
      "scene_id": "06",
      "scene_title": "필요한 곳에만 응답하기",
      "text": "이 테스트는 게임 중에는 상호작용 버튼에, 메뉴에서는 확인 버튼에 응답합니다.",
      "start": 174.64258333333333,
      "end": 179.53258333333335
    },
    {
      "index": 43,
      "scene_id": "06",
      "scene_title": "필요한 곳에만 응답하기",
      "text": "현재 상태에서 의미가 없는 키에는 큰 경고를 붙이지 않습니다.",
      "start": 179.53258333333335,
      "end": 183.70258333333334
    },
    {
      "index": 44,
      "scene_id": "06",
      "scene_title": "필요한 곳에만 응답하기",
      "text": "실행할 수 있을 것처럼 보이는 행동이 막혔을 때, 이유를 우선 보여 주는 것입니다.",
      "start": 183.70258333333334,
      "end": 188.56258333333335
    },
    {
      "index": 45,
      "scene_id": "06",
      "scene_title": "필요한 곳에만 응답하기",
      "text": "버튼은 받았는지, 왜 실행할 수 없는지, 다음에 무엇을 해 볼지 살펴보세요.",
      "start": 188.56258333333335,
      "end": 193.40258333333333
    },
    {
      "index": 46,
      "scene_id": "06",
      "scene_title": "필요한 곳에만 응답하기",
      "text": "응답의 목적은 아무 행동이나 성공시키는 데 있지 않습니다.",
      "start": 193.40258333333333,
      "end": 197.26258333333334
    },
    {
      "index": 47,
      "scene_id": "06",
      "scene_title": "필요한 곳에만 응답하기",
      "text": "성공과 거절과 대기를 알아볼 수 있게 만드는 데 있습니다.",
      "start": 197.26258333333334,
      "end": 200.87258333333335
    },
    {
      "index": 48,
      "scene_id": "06",
      "scene_title": "필요한 곳에만 응답하기",
      "text": "우리 게임에서도 아무 일도 없었다고 느끼는 순간부터 찾아보세요.",
      "start": 200.87258333333335,
      "end": 204.88008333333335
    }
  ]
}
