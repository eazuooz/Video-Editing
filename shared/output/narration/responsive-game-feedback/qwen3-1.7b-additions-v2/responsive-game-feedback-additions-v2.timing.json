  "entries": [
    {
      "index": 1,
      "scene_id": "01",
      "scene_title": "가리키기·선택·작업을 나누어 보기",
      "text": "산소 미포함의 개발 중 데모에서, 포인터를 움직일 때 나타나는 작은 정보창을 보세요.",
      "start": 0.0,
      "end": 5.56,
      "voice_start": 0.0,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 2,
      "scene_id": "01",
      "scene_title": "가리키기·선택·작업을 나누어 보기",
      "text": "대상을 가리키고 이름과 상태를 읽는 것은, 그 대상에 어떤 행동을 할 수 있는지 알아보는 과정입니다.",
      "start": 5.82,
      "end": 12.12,
      "voice_start": 5.82,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 3,
      "scene_id": "01",
      "scene_title": "가리키기·선택·작업을 나누어 보기",
      "text": "여기서 보이는 것은 정보를 찾는 반응입니다. 작업에 성공했다는 평가와는 역할이 다릅니다.",
      "start": 12.4,
      "end": 17.38,
      "voice_start": 12.4,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 4,
      "scene_id": "01",
      "scene_title": "가리키기·선택·작업을 나누어 보기",
      "text": "대상을 선택하면 오른쪽에 정보 패널이 열립니다.",
      "start": 17.98,
      "end": 20.7,
      "voice_start": 17.98,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 5,
      "scene_id": "01",
      "scene_title": "가리키기·선택·작업을 나누어 보기",
      "text": "패널 안의 탭과 내용을 바꾸는 모습도 살펴보세요.",
      "start": 21.16,
      "end": 23.88,
      "voice_start": 21.16,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 6,
      "scene_id": "01",
      "scene_title": "가리키기·선택·작업을 나누어 보기",
      "text": "선택을 알아봤다는 변화와, 실제 작업의 진행을 나누어 보는 예시입니다.",
      "start": 24.2,
      "end": 28.14,
      "voice_start": 24.2,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 7,
      "scene_id": "01",
      "scene_title": "가리키기·선택·작업을 나누어 보기",
      "text": "이어지는 다른 구간에서는 땅에 표시된 작업 위치와 움직이는 캐릭터를 함께 볼 수 있습니다.",
      "start": 28.14,
      "end": 33.2,
      "voice_start": 28.14,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 8,
      "scene_id": "01",
      "scene_title": "가리키기·선택·작업을 나누어 보기",
      "text": "포인터 아래의 정보, 선택된 대상, 진행 중인 작업을 각각 따로 읽으면 무반응처럼 느끼는 원인을 좁힐 수 있습니다.",
      "start": 33.6,
      "end": 40.18,
      "voice_start": 33.6,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 9,
      "scene_id": "01",
      "scene_title": "가리키기·선택·작업을 나누어 보기",
      "text": "앞의 잠긴 문 비교에서도 같은 질문을 해 보세요. 입력은 받았는지, 지금 어떤 상태인지부터 보여 주는 것입니다.",
      "start": 40.7,
      "end": 47.28,
      "voice_start": 40.7,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 10,
      "scene_id": "02",
      "scene_title": "자원 부족 안내와 다음 행동",
      "text": "산소 미포함의 음식 제작 패널에는 자원이 부족하다는 상태가 표시됩니다.",
      "start": 48.32,
      "end": 52.78,
      "voice_start": 48.32,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 11,
      "scene_id": "02",
      "scene_title": "자원 부족 안내와 다음 행동",
      "text": "완성품을 얻었다고 말하는 대신, 제작에 필요한 재료와 현재 상태를 함께 읽어 보세요.",
      "start": 53.14,
      "end": 57.82,
      "voice_start": 53.14,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 12,
      "scene_id": "02",
      "scene_title": "자원 부족 안내와 다음 행동",
      "text": "앞의 건설 비교에서 부족한 재료를 알려 주는 이유와 연결됩니다. 거절은 다음 행동의 단서가 될 수 있습니다.",
      "start": 58.06,
      "end": 64.08,
      "voice_start": 58.06,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 13,
      "scene_id": "02",
      "scene_title": "자원 부족 안내와 다음 행동",
      "text": "같은 패널의 재료 수량과 설명은, 무엇을 준비해야 할지 살펴볼 정보를 제공합니다.",
      "start": 64.34,
      "end": 69.4,
      "voice_start": 64.34,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 14,
      "scene_id": "02",
      "scene_title": "자원 부족 안내와 다음 행동",
      "text": "이어지는 포인터 아래의 물질 정보도 화면에서 확인할 수 있습니다. 색만으로 모든 이유를 대신하지 않는 것입니다.",
      "start": 69.58,
      "end": 75.66,
      "voice_start": 69.58,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 15,
      "scene_id": "02",
      "scene_title": "자원 부족 안내와 다음 행동",
      "text": "이 영상에 보이지 않은 완성품이나 성공 조건을 덧붙이지 않고, 실제로 표시된 상태를 근거로 설명합니다.",
      "start": 75.66,
      "end": 82.58,
      "voice_start": 75.66,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 16,
      "scene_id": "02",
      "scene_title": "자원 부족 안내와 다음 행동",
      "text": "다른 구간에서는 캐릭터와 작업 장소를 가리킬 때 내용이 달라지는 모습을 볼 수 있습니다.",
      "start": 82.8,
      "end": 87.66,
      "voice_start": 82.8,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 17,
      "scene_id": "02",
      "scene_title": "자원 부족 안내와 다음 행동",
      "text": "작업이 계속되는 화면에서도 선택한 대상의 상태를 읽을 수 있어야, 기다릴지 다른 일을 할지 판단할 수 있습니다.",
      "start": 87.84,
      "end": 94.22,
      "voice_start": 87.84,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 18,
      "scene_id": "02",
      "scene_title": "자원 부족 안내와 다음 행동",
      "text": "우리 게임의 안내도, 막힌 이유와 다음에 확인할 정보를 나누어 적어 보세요.",
      "start": 94.44,
      "end": 98.68,
      "voice_start": 94.44,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 19,
      "scene_id": "03",
      "scene_title": "선택 상태와 확인의 약속",
      "text": "산소 미포함의 시작 메뉴에서는 여러 캐릭터 카드 중 선택한 카드의 배경이 달라집니다.",
      "start": 99.44,
      "end": 105.28,
      "voice_start": 99.44,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 20,
      "scene_id": "03",
      "scene_title": "선택 상태와 확인의 약속",
      "text": "포인터를 옮기며 능력과 특성을 읽는 동안, 어떤 선택이 표시되어 있는지 함께 확인해 보세요.",
      "start": 105.5,
      "end": 110.74,
      "voice_start": 105.5,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 21,
      "scene_id": "03",
      "scene_title": "선택 상태와 확인의 약속",
      "text": "선택을 바꾸는 단계와 게임을 시작하는 단계가 나뉘어 있습니다. 아직 시작 전인 상태를 화면에서 읽는 것입니다.",
      "start": 111.14,
      "end": 118.06,
      "voice_start": 111.14,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 22,
      "scene_id": "03",
      "scene_title": "선택 상태와 확인의 약속",
      "text": "선택된 카드와 특성을 다시 살핀 뒤에 시작 버튼을 누를 수 있습니다.",
      "start": 118.22,
      "end": 122.38,
      "voice_start": 118.22,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 23,
      "scene_id": "03",
      "scene_title": "선택 상태와 확인의 약속",
      "text": "이 장면에서 실제 키보드 입력은 보이지 않습니다. 엔터와 스페이스를 모두 받는다고 추정하지는 않습니다.",
      "start": 122.58,
      "end": 128.82,
      "voice_start": 122.58,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 24,
      "scene_id": "03",
      "scene_title": "선택 상태와 확인의 약속",
      "text": "앞의 자체 비교는 확인 버튼의 약속을 시험한 것이고, 실제 메뉴에서는 선택 상태가 보이는지 관찰하는 것입니다.",
      "start": 128.82,
      "end": 135.51999999999998,
      "voice_start": 128.82,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 25,
      "scene_id": "03",
      "scene_title": "선택 상태와 확인의 약속",
      "text": "작업 메뉴는 표와 체크 표시로 다른 선택 상태를 보여 줍니다.",
      "start": 135.78,
      "end": 139.26,
      "voice_start": 135.78,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 26,
      "scene_id": "03",
      "scene_title": "선택 상태와 확인의 약속",
      "text": "포인터가 가리키는 항목과 그 설명을 함께 살펴보세요.",
      "start": 139.46,
      "end": 142.66,
      "voice_start": 139.46,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 27,
      "scene_id": "03",
      "scene_title": "선택 상태와 확인의 약속",
      "text": "메뉴의 의미가 달라지면, 필요한 확인 정보도 함께 달라집니다.",
      "start": 142.92,
      "end": 146.68,
      "voice_start": 142.92,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 28,
      "scene_id": "04",
      "scene_title": "선택 뒤에 확정된 변화",
      "text": "이번에는 새 캐릭터를 선택하는 창입니다.",
      "start": 147.6,
      "end": 150.01999999999998,
      "voice_start": 147.6,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 29,
      "scene_id": "04",
      "scene_title": "선택 뒤에 확정된 변화",
      "text": "프린트 버튼을 누르자 창이 닫히고 캐릭터가 늘어납니다.",
      "start": 150.23999999999998,
      "end": 153.34,
      "voice_start": 150.23999999999998,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 30,
      "scene_id": "04",
      "scene_title": "선택 뒤에 확정된 변화",
      "text": "선택 표시와 실제 확정 뒤의 변화를 나누어 보세요.",
      "start": 153.66,
      "end": 156.66,
      "voice_start": 153.66,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 31,
      "scene_id": "04",
      "scene_title": "선택 뒤에 확정된 변화",
      "text": "다른 시작 구간에서는 메뉴를 마친 뒤 세 캐릭터가 게임 공간 안에 나타납니다.",
      "start": 156.94,
      "end": 161.72,
      "voice_start": 156.94,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 32,
      "scene_id": "04",
      "scene_title": "선택 뒤에 확정된 변화",
      "text": "이것은 앞의 새 캐릭터 추가와 다른 시점입니다. 두 장면을 한 번의 연속 입력처럼 연결하지 않습니다.",
      "start": 162.04,
      "end": 168.6,
      "voice_start": 162.04,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 33,
      "scene_id": "04",
      "scene_title": "선택 뒤에 확정된 변화",
      "text": "메뉴에서 무엇을 고르고 있었는지와, 확정한 뒤 어떤 상태가 되었는지를 따로 살펴보는 예시입니다.",
      "start": 168.85999999999999,
      "end": 174.54,
      "voice_start": 168.85999999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 34,
      "scene_id": "04",
      "scene_title": "선택 뒤에 확정된 변화",
      "text": "이어서 캐릭터가 작업하고 설치 계획이 화면에 나타나는 실제 플레이를 보세요.",
      "start": 174.54,
      "end": 179.48,
      "voice_start": 174.54,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 35,
      "scene_id": "04",
      "scene_title": "선택 뒤에 확정된 변화",
      "text": "선택한 대상과 실행 이후의 변화를 구분하면, 입력을 알아봤다는 반응만으로 완료를 선언하지 않게 됩니다.",
      "start": 179.95999999999998,
      "end": 186.07999999999998,
      "voice_start": 179.95999999999998,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 36,
      "scene_id": "04",
      "scene_title": "선택 뒤에 확정된 변화",
      "text": "앞의 컷신 비교도 같은 기준입니다. 누른 뜻을 보여 주는 단계와, 정말 실행하는 단계를 나누어 설계합니다.",
      "start": 186.56,
      "end": 192.56,
      "voice_start": 186.56,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 37,
      "scene_id": "05",
      "scene_title": "작업 계획과 실제 진행",
      "text": "산소 미포함에서는 땅 위의 작업 표시와 캐릭터의 이동이 서로 다른 상태를 보여 줍니다.",
      "start": 193.44,
      "end": 199.72,
      "voice_start": 193.44,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 38,
      "scene_id": "05",
      "scene_title": "작업 계획과 실제 진행",
      "text": "작업할 곳이 표시되었다고 그 작업이 이미 끝났다고 말할 수는 없습니다. 캐릭터가 실제로 하는 행동도 함께 보세요.",
      "start": 200.07999999999998,
      "end": 206.7,
      "voice_start": 200.07999999999998,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 39,
      "scene_id": "05",
      "scene_title": "작업 계획과 실제 진행",
      "text": "앞의 모의 저장처럼 요청을 받은 사실과, 처리 중인 상태를 나누어 읽는 출발점입니다.",
      "start": 207.06,
      "end": 212.28,
      "voice_start": 207.06,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 40,
      "scene_id": "05",
      "scene_title": "작업 계획과 실제 진행",
      "text": "다른 구간의 하얀 건물 윤곽도 완성된 건물과 구별해 볼 수 있습니다.",
      "start": 212.5,
      "end": 216.78,
      "voice_start": 212.5,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 41,
      "scene_id": "05",
      "scene_title": "작업 계획과 실제 진행",
      "text": "윤곽과 주변 작업, 선택된 물질의 정보를 함께 보면서 무엇이 계획이고 무엇이 진행 중인지 살펴봅니다.",
      "start": 217.06,
      "end": 223.42,
      "voice_start": 217.06,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 42,
      "scene_id": "05",
      "scene_title": "작업 계획과 실제 진행",
