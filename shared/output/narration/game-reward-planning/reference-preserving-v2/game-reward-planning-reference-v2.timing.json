  "entries": [
    {
      "index": 1,
      "scene_id": "01",
      "scene_title": "보상을 받으면 무엇이 달라질까?",
      "text": "안녕하세요, 얌얌코딩입니다.",
      "start": 0.0,
      "end": 1.96,
      "voice_start": 0.0,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 2,
      "scene_id": "01",
      "scene_title": "보상을 받으면 무엇이 달라질까?",
      "text": "공격력이 오르지도 않는데 새 캐릭터나 음악 한 곡을 얻고 싶었던 적이 있나요?",
      "start": 2.28,
      "end": 6.88,
      "voice_start": 2.28,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 3,
      "scene_id": "01",
      "scene_title": "보상을 받으면 무엇이 달라질까?",
      "text": "이번에는 강해지는 보상에서 시작해, 스매시브라더스의 해금과 수집 보상, 그리고 다음 목표를 보여 주는 과제판을 살펴보겠습니다.",
      "start": 7.12,
      "end": 15.08,
      "voice_start": 7.12,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 4,
      "scene_id": "01",
      "scene_title": "보상을 받으면 무엇이 달라질까?",
      "text": "다 보고 나면 우리 게임의 보상 하나에 무엇이 달라지는지, 어떤 조건으로 주는지, 무엇을 만들어야 하는지를 함께 적을 수 있을 거예요.",
      "start": 15.4,
      "end": 23.18,
      "voice_start": 15.4,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 5,
      "scene_id": "02",
      "scene_title": "강화와 새로운 능력",
      "text": "가장 익숙한 변화는 더 강해지는 겁니다.",
      "start": 23.5,
      "end": 26.259999999999998,
      "voice_start": 23.5,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 6,
      "scene_id": "02",
      "scene_title": "강화와 새로운 능력",
      "text": "장비를 사거나, 경험치를 쌓아 레벨을 올리거나, 새 기술을 배우는 식이죠.",
      "start": 26.4,
      "end": 31.86,
      "voice_start": 26.4,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 7,
      "scene_id": "02",
      "scene_title": "강화와 새로운 능력",
      "text": "상자에서 얻은 물건이나 모은 재료로 만든 장비도 이 흐름에 들어갑니다.",
      "start": 32.1,
      "end": 36.06,
      "voice_start": 32.1,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 8,
      "scene_id": "02",
      "scene_title": "강화와 새로운 능력",
      "text": "설명을 위해 공격력이 십에서 십이가 된다고 해볼게요.",
      "start": 36.5,
      "end": 39.64,
      "voice_start": 36.5,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 9,
      "scene_id": "02",
      "scene_title": "강화와 새로운 능력",
      "text": "늘어난 양은 이이고, 원래 값 십과 비교하면 이십 퍼센트 증가입니다.",
      "start": 39.879999999999995,
      "end": 44.260000000000005,
      "voice_start": 39.879999999999995,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 10,
      "scene_id": "02",
      "scene_title": "강화와 새로운 능력",
      "text": "단, 실제 피해량까지 언제나 이십 퍼센트 늘어난다는 뜻은 아닙니다.",
      "start": 44.54,
      "end": 48.8,
      "voice_start": 44.54,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 11,
      "scene_id": "02",
      "scene_title": "강화와 새로운 능력",
      "text": "적의 방어력이나 게임의 계산식이 따로 있을 수 있으니까요.",
      "start": 49.22,
      "end": 52.239999999999995,
      "voice_start": 49.22,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 12,
      "scene_id": "02",
      "scene_title": "강화와 새로운 능력",
      "text": "숫자 대신 행동이 달라질 수도 있습니다.",
      "start": 52.239999999999995,
      "end": 54.96,
      "voice_start": 52.239999999999995,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 13,
      "scene_id": "02",
      "scene_title": "강화와 새로운 능력",
      "text": "커비의 카피 능력은 어떤 능력을 얻느냐에 따라 할 수 있는 공격이 바뀝니다.",
      "start": 55.28,
      "end": 59.56,
      "voice_start": 55.28,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 14,
      "scene_id": "02",
      "scene_title": "강화와 새로운 능력",
      "text": "여기서는 적을 빨아들인 뒤 능력을 얻고, 아래 표시가 노멀에서 빔으로 바뀝니다.",
      "start": 59.8,
      "end": 64.58,
      "voice_start": 59.8,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 15,
      "scene_id": "02",
      "scene_title": "강화와 새로운 능력",
      "text": "곧 다른 적에게서는 불을 뿜는 파이어를 얻죠.",
      "start": 64.96000000000001,
      "end": 67.66,
      "voice_start": 64.96000000000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 16,
      "scene_id": "02",
      "scene_title": "강화와 새로운 능력",
      "text": "숫자가 올라가지 않아도 다음에 무엇을 할 수 있을지 기대하게 만듭니다.",
      "start": 68.03999999999999,
      "end": 71.72,
      "voice_start": 68.03999999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 17,
      "scene_id": "02",
      "scene_title": "강화와 새로운 능력",
      "text": "한편 봄버맨 같은 게임에서는 모은 힘을 잃을 가능성도 긴장감을 줍니다.",
      "start": 71.97999999999999,
      "end": 76.5,
      "voice_start": 71.97999999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 18,
      "scene_id": "02",
      "scene_title": "강화와 새로운 능력",
      "text": "이 관계는 간단한 상태 그림으로 보면 됩니다.",
      "start": 76.72,
      "end": 79.32,
      "voice_start": 76.72,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 19,
      "scene_id": "02",
      "scene_title": "강화와 새로운 능력",
      "text": "얻기 전, 강화된 상태, 그리고 실패 뒤의 상태가 서로 다르기 때문에 현재 가진 것을 지키고 싶어지는 것이죠.",
      "start": 79.32,
      "end": 86.56,
      "voice_start": 79.32,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 20,
      "scene_id": "02",
      "scene_title": "강화와 새로운 능력",
      "text": "그런데 이 방식이 모든 게임에 같은 모습으로 들어갈 수는 없습니다.",
      "start": 86.9,
      "end": 90.28,
      "voice_start": 86.9,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 21,
      "scene_id": "03",
      "scene_title": "대전 전에 모두 육성해야 한다면",
      "text": "친구와 바로 대결하고 싶은 게임이라면 어떨까요?",
      "start": 90.6,
      "end": 93.24,
      "voice_start": 90.6,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 22,
      "scene_id": "03",
      "scene_title": "대전 전에 모두 육성해야 한다면",
      "text": "대전에 쓰려는 캐릭터를 먼저 오래 육성해야 한다면, 싸움을 시작하기 전에 준비부터 해야 합니다.",
      "start": 93.47999999999999,
      "end": 98.89999999999999,
      "voice_start": 93.47999999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 23,
      "scene_id": "03",
      "scene_title": "대전 전에 모두 육성해야 한다면",
      "text": "스매시브라더스처럼 파이터, 즉 직접 조작하는 전투 캐릭터를 다양하게 골라 대결하는 게임에서는 이런 누적 강화가 중심 규칙과 충돌할 수 있어요.",
      "start": 99.25999999999999,
      "end": 109.11999999999999,
      "voice_start": 99.25999999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 24,
      "scene_id": "03",
      "scene_title": "대전 전에 모두 육성해야 한다면",
      "text": "그렇다고 스매시브라더스 어디에도 강화가 없다는 말은 아닙니다.",
      "start": 109.38,
      "end": 113.32,
      "voice_start": 109.38,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 25,
      "scene_id": "03",
      "scene_title": "대전 전에 모두 육성해야 한다면",
      "text": "뒤에서 볼 스피릿 같은 별도 규칙에는 강화가 있습니다.",
      "start": 113.58,
      "end": 116.69999999999999,
      "voice_start": 113.58,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 26,
      "scene_id": "03",
      "scene_title": "대전 전에 모두 육성해야 한다면",
      "text": "지금 비교하는 것은 기본 대전을 시작하기 위한 필수 육성이에요.",
      "start": 116.97999999999999,
      "end": 120.58,
      "voice_start": 116.97999999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 27,
      "scene_id": "03",
      "scene_title": "대전 전에 모두 육성해야 한다면",
      "text": "그 부담을 늘리지 않으면서 플레이의 보상을 주려면, 능력치 말고 다른 변화를 준비해야 합니다.",
      "start": 120.6,
      "end": 125.85999999999999,
      "voice_start": 120.6,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 28,
      "scene_id": "04",
      "scene_title": "능력치 대신 선택지를 열기",
      "text": "여기서 보상이 되는 것은 더 높은 공격력 대신 새로운 파이터입니다.",
      "start": 126.17999999999999,
      "end": 130.04,
      "voice_start": 126.17999999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 29,
      "scene_id": "04",
      "scene_title": "능력치 대신 선택지를 열기",
      "text": "해금, 영어로 언록은 사용할 수 없던 항목을 조건 달성 뒤 사용할 수 있게 여는 것입니다.",
      "start": 130.32,
      "end": 136.45999999999998,
      "voice_start": 130.32,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 30,
      "scene_id": "04",
      "scene_title": "능력치 대신 선택지를 열기",
      "text": "대난투 스매시브라더스 엑스에서는 새 도전자가 나타나고, 그 파이터와 싸워 이기면 선택할 수 있게 됩니다.",
      "start": 136.78,
      "end": 143.14,
      "voice_start": 136.78,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 31,
      "scene_id": "04",
      "scene_title": "능력치 대신 선택지를 열기",
      "text": "지금은 툰 링크가 도전자로 등장했어요.",
      "start": 143.56,
      "end": 146.07999999999998,
      "voice_start": 143.56,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 32,
      "scene_id": "04",
      "scene_title": "능력치 대신 선택지를 열기",
      "text": "전투에서 이긴 뒤 참가했다는 알림과 선택 화면의 새 항목을 확인할 수 있습니다.",
      "start": 146.18,
      "end": 150.94,
      "voice_start": 146.18,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 33,
      "scene_id": "04",
      "scene_title": "능력치 대신 선택지를 열기",
      "text": "수치를 끝없이 쌓는 대신, 새로운 움직임과 싸우는 방식을 시험할 선택지가 생기는 거죠.",
      "start": 150.94,
      "end": 156.54,
      "voice_start": 150.94,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 34,
      "scene_id": "04",
      "scene_title": "능력치 대신 선택지를 열기",
      "text": "잠긴 캐릭터가 있다는 점은 제약이기도 합니다.",
      "start": 156.89999999999998,
      "end": 159.24,
      "voice_start": 156.89999999999998,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 35,
      "scene_id": "04",
      "scene_title": "능력치 대신 선택지를 열기",
      "text": "다만 사쿠라이는 도전자들이 비교적 잦게 나타나도록 구성했다고 설명합니다.",
      "start": 159.6,
      "end": 163.92,
      "voice_start": 159.6,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 36,
      "scene_id": "04",
      "scene_title": "능력치 대신 선택지를 열기",
      "text": "기다리는 부담과 새 만남의 즐거움을 함께 보는 겁니다.",
      "start": 164.2,
      "end": 167.26,
      "voice_start": 164.2,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 37,
      "scene_id": "04",
      "scene_title": "능력치 대신 선택지를 열기",
      "text": "얼티밋의 빛의 세계에서 파이터를 구출하는 장면은 획득 경로가 다릅니다.",
      "start": 167.5,
      "end": 171.72,
      "voice_start": 167.5,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 38,
      "scene_id": "04",
      "scene_title": "능력치 대신 선택지를 열기",
      "text": "이곳에서는 지도 위 대상에게 다가가 싸우고, 승리하면 파이터가 합류합니다.",
      "start": 172.12,
      "end": 176.48,
      "voice_start": 172.12,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 39,
      "scene_id": "04",
      "scene_title": "능력치 대신 선택지를 열기",
      "text": "도전자 난입이나 유료 추가 콘텐츠와 같은 조건으로 뭉뚱그리면 안 되겠죠.",
      "start": 176.5,
      "end": 180.79999999999998,
      "voice_start": 176.5,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 40,
      "scene_id": "04",
      "scene_title": "능력치 대신 선택지를 열기",
      "text": "새 선택지를 열고 난 뒤에도 남길 수 있는 보상이 있습니다.",
      "start": 181.04,
      "end": 184.12,
      "voice_start": 181.04,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 41,
      "scene_id": "04",
      "scene_title": "능력치 대신 선택지를 열기",
      "text": "바로 모으고 들여다보는 즐거움입니다.",
      "start": 184.38,
      "end": 186.28,
      "voice_start": 184.38,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 42,
      "scene_id": "05",
      "scene_title": "수집할 대상에도 제작 비용이 든다",
      "text": "스매시브라더스 디엑스부터 닌텐도 쓰리 디에스와 위 유판까지 등장한 피규어는 캐릭터를 모으고 살펴보게 하는 보상입니다.",
      "start": 186.88,
      "end": 195.22,
      "voice_start": 186.88,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 43,
      "scene_id": "05",
      "scene_title": "수집할 대상에도 제작 비용이 든다",
      "text": "영어 메뉴에서는 트로피라고 부릅니다.",
      "start": 195.48,
      "end": 197.96,
      "voice_start": 195.48,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 44,
      "scene_id": "05",
      "scene_title": "수집할 대상에도 제작 비용이 든다",
      "text": "DX의 클래식 모드를 마치면 방금 사용한 파이터가 피규어로 전시됩니다.",
      "start": 198.46,
      "end": 202.7,
      "voice_start": 198.46,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 45,
