  "entries": [
    {
      "index": 1,
      "scene_id": "01",
      "scene_title": "어떤 중심을 쓰고, 어떻게 나눌까요?",
      "text": "삼각형의 중심은 하나일까요? 안으로 움푹 들어간 지형은 어떻게 삼각형으로 나눌까요?",
      "start": 0.0,
      "end": 4.82,
      "voice_start": 0.0,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 2,
      "scene_id": "01",
      "scene_title": "어떤 중심을 쓰고, 어떻게 나눌까요?",
      "text": "먼저 실제 게임의 타일과 지형을 보며, 무게중심과 내심, 외심이 답하는 질문을 구분합니다.",
      "start": 5.12,
      "end": 11.08,
      "voice_start": 5.12,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 3,
      "scene_id": "01",
      "scene_title": "어떤 중심을 쓰고, 어떻게 나눌까요?",
      "text": "이어서 다각형의 경계와 볼록성을 확인하고, 한 점에서 부채꼴로 나누는 방법의 한계를 보겠습니다.",
      "start": 11.48,
      "end": 17.48,
      "voice_start": 11.48,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 4,
      "scene_id": "01",
      "scene_title": "어떤 중심을 쓰고, 어떻게 나눌까요?",
      "text": "마지막에는 오목한 예제를 귀 잘라내기로 분할하고, 빠진 영역과 가느다란 삼각형을 검사하겠습니다.",
      "start": 17.9,
      "end": 24.62,
      "voice_start": 17.9,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 5,
      "scene_id": "02",
      "scene_title": "타일을 놓을 때 필요한 기준",
      "text": "도르프로만틱에서 육각형 타일을 돌려 빈자리에 놓습니다. 타일의 가운데와 바깥쪽 변을 함께 보세요.",
      "start": 25.09,
      "end": 31.509999999999998,
      "voice_start": 25.09,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 6,
      "scene_id": "02",
      "scene_title": "타일을 놓을 때 필요한 기준",
      "text": "가운데에 표시를 놓는 일과, 안쪽에 원을 넣는 일은 서로 다른 질문입니다.",
      "start": 31.93,
      "end": 36.45,
      "voice_start": 31.93,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 7,
      "scene_id": "02",
      "scene_title": "타일을 놓을 때 필요한 기준",
      "text": "타일을 둘러싸는 원의 중심을 찾는 질문도 있습니다. 모양에 따라 세 질문의 답이 달라집니다.",
      "start": 36.85,
      "end": 42.41,
      "voice_start": 36.85,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 8,
      "scene_id": "02",
      "scene_title": "타일을 놓을 때 필요한 기준",
      "text": "정육각형처럼 대칭이 좋은 모양에서는 중심들이 겹쳐 보입니다. 일반 삼각형에서도 같다고 생각하면 안 됩니다.",
      "start": 42.730000000000004,
      "end": 49.269999999999996,
      "voice_start": 42.730000000000004,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 9,
      "scene_id": "02",
      "scene_title": "타일을 놓을 때 필요한 기준",
      "text": "타일이 연결되면 전체 땅의 윤곽도 바뀝니다. 타일 하나의 중심과 연결된 영역의 중심을 구분하세요.",
      "start": 49.71,
      "end": 56.010000000000005,
      "voice_start": 49.71,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 10,
      "scene_id": "02",
      "scene_title": "타일을 놓을 때 필요한 기준",
      "text": "이제 변의 길이가 삼, 사, 오인 삼각형으로 비교합니다. 게임이 그 중심 계산을 쓴다고 추정하지 않고, 우리가 정의한 예제를 풉니다.",
      "start": 56.43,
      "end": 64.25,
      "voice_start": 56.43,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 11,
      "scene_id": "03",
      "scene_title": "세 중심이 답하는 세 질문",
      "text": "삼각형에서 무게중심은 세 꼭짓점 좌표의 평균입니다. 세 중선이 만나는 점이기도 합니다.",
      "start": 64.82000000000001,
      "end": 70.48,
      "voice_start": 64.82000000000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 12,
      "scene_id": "03",
      "scene_title": "세 중심이 답하는 세 질문",
      "text": "내심은 세 변까지의 거리가 같은 점입니다. 그 점을 중심으로 안에 닿는 원을 그릴 수 있습니다.",
      "start": 70.76,
      "end": 76.16000000000001,
      "voice_start": 70.76,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 13,
      "scene_id": "03",
      "scene_title": "세 중심이 답하는 세 질문",
      "text": "외심은 세 꼭짓점까지의 거리가 같은 점입니다. 그 점을 중심으로 꼭짓점을 지나는 원을 그립니다.",
      "start": 76.48,
      "end": 81.82000000000001,
      "voice_start": 76.48,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 14,
      "scene_id": "03",
      "scene_title": "세 중심이 답하는 세 질문",
      "text": "좌표 평균, 변까지의 거리, 꼭짓점까지의 거리입니다. 무엇이 같아야 하는지 먼저 정하세요.",
      "start": 82.12,
      "end": 88.24000000000001,
      "voice_start": 82.12,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 15,
      "scene_id": "03",
      "scene_title": "세 중심이 답하는 세 질문",
      "text": "세 꼭짓점이 영, 영과 사, 영과 영, 삼인 직각삼각형을 같은 그림에서 비교하겠습니다.",
      "start": 88.38050000000001,
      "end": 94.80000000000001,
      "voice_start": 88.38050000000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 16,
      "scene_id": "03",
      "scene_title": "세 중심이 답하는 세 질문",
      "text": "이 예제에서는 세 중심이 서로 다릅니다. 모두 중심이라고 부르지만 역할을 바꾸어 쓸 수는 없습니다.",
      "start": 94.82000000000001,
      "end": 100.82000000000001,
      "voice_start": 94.82000000000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 17,
      "scene_id": "04",
      "scene_title": "무게중심은 무엇의 평균일까요?",
      "text": "무게중심은 세 꼭짓점을 더해서 삼으로 나눕니다. 지금은 사 나누기 삼, 일입니다.",
      "start": 101.35000000000001,
      "end": 106.97000000000001,
      "voice_start": 101.35000000000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 18,
      "scene_id": "04",
      "scene_title": "무게중심은 무엇의 평균일까요?",
      "text": "첫 꼭짓점에서 반대편 변의 중점으로 중선을 그리면, 무게중심은 꼭짓점 쪽에서 삼분의 이 지점입니다.",
      "start": 107.21000000000001,
      "end": 114.11000000000001,
      "voice_start": 107.21000000000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 19,
      "scene_id": "04",
      "scene_title": "무게중심은 무엇의 평균일까요?",
      "text": "나머지 두 중선도 같은 점을 지납니다. 가중치는 세 꼭짓점에 각각 삼분의 일입니다.",
      "start": 114.55000000000001,
      "end": 120.13000000000001,
      "voice_start": 114.55000000000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 20,
      "scene_id": "04",
      "scene_title": "무게중심은 무엇의 평균일까요?",
      "text": "밀도가 일정한 삼각형 판의 질량 중심도 이 점입니다. 밀도가 달라지면 같은 결론을 그대로 쓸 수 없습니다.",
      "start": 120.41000000000001,
      "end": 127.61000000000001,
      "voice_start": 120.41000000000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 21,
      "scene_id": "04",
      "scene_title": "무게중심은 무엇의 평균일까요?",
      "text": "여러 삼각형으로 나눈 다각형에서는 각 삼각형의 넓이로 가중 평균을 내야 합니다. 꼭짓점만 평균하면 일반적으로 틀립니다.",
      "start": 127.61000000000001,
      "end": 136.07,
      "voice_start": 127.61000000000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 22,
      "scene_id": "04",
      "scene_title": "무게중심은 무엇의 평균일까요?",
      "text": "세 점이 일직선이면 좌표 평균은 계산되지만, 넓이 있는 삼각형 판은 아닙니다. 계산 결과와 입력의 유효성을 구분하세요.",
      "start": 136.25,
      "end": 144.13,
      "voice_start": 136.25,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 23,
      "scene_id": "05",
      "scene_title": "가운데 표시와 안전한 여유 공간",
      "text": "시리어스 샘 투에서 길과 다리 사이를 이동합니다. 발밑의 표면과 옆으로 벗어나는 가장자리를 보세요.",
      "start": 144.6,
      "end": 151.57999999999998,
      "voice_start": 144.6,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 24,
      "scene_id": "05",
      "scene_title": "가운데 표시와 안전한 여유 공간",
      "text": "발판의 어느 곳에 표시를 놓을지와, 가장자리에서 여유 거리를 확보할지는 다른 문제입니다.",
      "start": 151.92,
      "end": 158.1,
      "voice_start": 151.92,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 25,
      "scene_id": "05",
      "scene_title": "가운데 표시와 안전한 여유 공간",
      "text": "삼각형 발판이라면 세 꼭짓점의 평균을 가운데 표시의 한 기준으로 쓸 수 있습니다.",
      "start": 158.74,
      "end": 164.26,
      "voice_start": 158.74,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 26,
      "scene_id": "05",
      "scene_title": "가운데 표시와 안전한 여유 공간",
      "text": "하지만 평균점에서 모든 변까지의 거리가 같지는 않습니다. 원형 여유 공간을 생각할 때는 변까지의 거리가 필요합니다.",
      "start": 164.54,
      "end": 172.29999999999998,
      "voice_start": 164.54,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 27,
      "scene_id": "05",
      "scene_title": "가운데 표시와 안전한 여유 공간",
      "text": "실제 길은 복잡한 모양일 수 있습니다. 화면의 발판을 마음대로 삼각형 하나로 바꾸어 경계를 없애지 마세요.",
      "start": 172.29999999999998,
      "end": 179.3,
      "voice_start": 172.29999999999998,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 28,
      "scene_id": "05",
      "scene_title": "가운데 표시와 안전한 여유 공간",
      "text": "다음 예제의 내심은 세 변까지 같은 거리를 만듭니다. 현실 게임의 이동 판정 대신, 그 조건을 직접 숫자로 확인하겠습니다.",
      "start": 179.72,
      "end": 187.76,
      "voice_start": 179.72,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 29,
      "scene_id": "06",
      "scene_title": "내심과 내접원의 반지름",
      "text": "내심은 각을 반으로 나누는 선들이 만나는 점입니다. 각 꼭짓점에는 반대편 변의 길이를 가중치로 줍니다.",
      "start": 188.57004166666664,
      "end": 195.57004166666664,
      "voice_start": 188.57004166666664,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 30,
      "scene_id": "06",
      "scene_title": "내심과 내접원의 반지름",
      "text": "지금 첫 꼭짓점의 반대편은 오, 둘째의 반대편은 삼, 셋째의 반대편은 사입니다. 둘레는 십이입니다.",
      "start": 195.91004166666664,
      "end": 202.93004166666663,
      "voice_start": 195.91004166666664,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 31,
      "scene_id": "06",
      "scene_title": "내심과 내접원의 반지름",
      "text": "가중 합을 십이로 나누면 내심은 일, 일입니다. 엑스축과 와이축까지의 거리가 각각 일입니다.",
      "start": 203.21004166666665,
      "end": 208.59004166666665,
      "voice_start": 203.21004166666665,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 32,
      "scene_id": "06",
      "scene_title": "내심과 내접원의 반지름",
      "text": "빗변의 식은 삼 엑스 더하기 사 와이 빼기 십이는 영입니다. 내심을 넣고 법선 길이 오로 나누면 거리도 일입니다.",
      "start": 208.97004166666665,
      "end": 216.03004166666665,
      "voice_start": 208.97004166666665,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 33,
      "scene_id": "06",
      "scene_title": "내심과 내접원의 반지름",
      "text": "내접원 반지름은 넓이의 두 배를 둘레로 나눕니다. 넓이 육, 둘레 십이이므로 반지름은 일입니다.",
      "start": 216.03004166666665,
      "end": 222.55004166666663,
      "voice_start": 216.03004166666665,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 34,
      "scene_id": "06",
      "scene_title": "내심과 내접원의 반지름",
      "text": "반둘레를 쓰면 넓이 나누기 반둘레입니다. 둘레와 반둘레를 혼동하면 반지름이 절반으로 잘못 나옵니다.",
      "start": 222.73004166666664,
      "end": 229.57004166666664,
      "voice_start": 222.73004166666664,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 35,
      "scene_id": "07",
      "scene_title": "외심은 삼각형 밖에 있을 수도 있습니다",
      "text": "외심은 두 변의 수직이등분선이 만나는 점으로 구할 수 있습니다. 세 꼭짓점까지의 거리가 같습니다.",
      "start": 230.22004166666665,
      "end": 236.96004166666665,
      "voice_start": 230.22004166666665,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 36,
      "scene_id": "07",
      "scene_title": "외심은 삼각형 밖에 있을 수도 있습니다",
      "text": "가로 변의 중점은 이, 영이고 세로 변의 중점은 영, 일 점 오입니다. 수직이등분선의 교점은 이, 일 점 오입니다.",
      "start": 237.18004166666665,
      "end": 245.44004166666664,
      "voice_start": 237.18004166666665,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 37,
      "scene_id": "07",
      "scene_title": "외심은 삼각형 밖에 있을 수도 있습니다",
      "text": "그 점에서 원점까지의 거리는 이 점 오입니다. 나머지 두 꼭짓점까지도 같으므로 외접원 반지름입니다.",
      "start": 245.78004166666665,
      "end": 252.76004166666664,
      "voice_start": 245.78004166666665,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 38,
      "scene_id": "07",
      "scene_title": "외심은 삼각형 밖에 있을 수도 있습니다",
      "text": "직각삼각형의 외심은 빗변의 중점입니다. 예각삼각형에서는 안에 있고, 둔각삼각형에서는 밖에 있을 수 있습니다.",
      "start": 252.98004166666664,
      "end": 260.5000416666667,
      "voice_start": 252.98004166666664,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 39,
      "scene_id": "07",
      "scene_title": "외심은 삼각형 밖에 있을 수도 있습니다",
      "text": "영, 영과 사, 영과 일, 일인 둔각 예제의 외심은 이, 마이너스 일입니다. 바깥에 있어도 외심 조건을 만족합니다.",
      "start": 260.9400416666666,
      "end": 268.70004166666666,
      "voice_start": 260.9400416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 40,
      "scene_id": "07",
      "scene_title": "외심은 삼각형 밖에 있을 수도 있습니다",
      "text": "세 점이 일직선이면 유일한 유한 외접원을 정할 수 없습니다. 거의 일직선인 입력도 계산을 불안정하게 만듭니다.",
      "start": 269.2400416666666,
      "end": 276.34004166666665,
      "voice_start": 269.2400416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 41,
      "scene_id": "08",
      "scene_title": "지형 윤곽은 점의 순서가 중요합니다",
      "text": "노이타의 굴곡진 지형 사이를 움직입니다. 앞으로 튀어나온 부분과 안으로 들어간 홈을 보세요.",
      "start": 276.9900833333333,
      "end": 283.1900833333333,
      "voice_start": 276.9900833333333,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 42,
      "scene_id": "08",
      "scene_title": "지형 윤곽은 점의 순서가 중요합니다",
      "text": "윤곽을 점으로 기록한다면, 경계를 따라 순서대로 이어야 합니다. 점 목록만 같고 연결 순서가 다르면 다른 모양이 됩니다.",
      "start": 283.2700833333333,
      "end": 290.6100833333333,
      "voice_start": 283.2700833333333,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 43,
      "scene_id": "08",
      "scene_title": "지형 윤곽은 점의 순서가 중요합니다",
      "text": "움푹 들어간 구간을 가로질러 직선으로 연결하면 통로와 빈 공간이 메워질 수 있습니다.",
      "start": 290.8900833333333,
      "end": 296.0700833333333,
      "voice_start": 290.8900833333333,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 44,
      "scene_id": "08",
      "scene_title": "지형 윤곽은 점의 순서가 중요합니다",
      "text": "중간에 같은 점을 반복하거나 너무 짧은 변을 만들면 방향과 넓이 계산도 불안정해질 수 있습니다.",
      "start": 296.4500833333333,
      "end": 302.2300833333333,
      "voice_start": 296.4500833333333,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 45,
      "scene_id": "08",
      "scene_title": "지형 윤곽은 점의 순서가 중요합니다",
      "text": "이 게임의 픽셀 지형을 삼각형 메시라고 단정하지 않습니다. 보이는 윤곽으로 올바른 입력이 왜 필요한지 관찰합니다.",
      "start": 302.2900833333333,
      "end": 309.1300833333333,
      "voice_start": 302.2900833333333,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 46,
      "scene_id": "08",
      "scene_title": "지형 윤곽은 점의 순서가 중요합니다",
      "text": "다음 그림은 점 여섯 개로 정의한 단순한 오목 다각형입니다. 경계 순서와 빠진 영역을 눈으로 확인하겠습니다.",
      "start": 309.6100833333333,
      "end": 316.2100833333333,
      "voice_start": 309.6100833333333,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 47,
      "scene_id": "09",
      "scene_title": "분할 전에 경계부터 검증하기",
      "text": "다각형은 마지막 점에서 첫 점으로 돌아오는 닫힌 경계입니다. 꼭짓점은 경계를 따라 순서대로 저장합니다.",
      "start": 316.96012499999995,
      "end": 323.96012499999995,
      "voice_start": 316.96012499999995,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 48,
      "scene_id": "09",
      "scene_title": "분할 전에 경계부터 검증하기",
      "text": "지금은 영, 영에서 시작해 사, 영과 사, 일, 일, 일, 일, 사, 영, 사로 돌아오는 엘자입니다.",
      "start": 324.14012499999995,
      "end": 331.28012499999994,
      "voice_start": 324.14012499999995,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 49,
      "scene_id": "09",
      "scene_title": "분할 전에 경계부터 검증하기",
      "text": "오른쪽 위의 빈 영역은 다각형에 포함되지 않습니다. 오목한 꼭짓점은 일, 일입니다.",
      "start": 331.52012499999995,
      "end": 336.8001249999999,
      "voice_start": 331.52012499999995,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 50,
      "scene_id": "09",
      "scene_title": "분할 전에 경계부터 검증하기",
      "text": "먼저 유한한 좌표와 중복점, 길이가 영인 변, 넓이가 영인 입력을 검사합니다.",
      "start": 337.120125,
      "end": 342.90012499999995,
      "voice_start": 337.120125,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 51,
      "scene_id": "09",
      "scene_title": "분할 전에 경계부터 검증하기",
      "text": "삼차원 점이라면 같은 평면에 있는지도 확인하고, 인접하지 않은 변이 서로 가로지르는지 검사해야 합니다.",
      "start": 342.94012499999997,
      "end": 348.98012499999993,
      "voice_start": 342.94012499999997,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 52,
      "scene_id": "09",
      "scene_title": "분할 전에 경계부터 검증하기",
      "text": "오늘 분할은 구멍과 자기 교차가 없는 단순 다각형을 대상으로 합니다. 구멍이 있는 입력은 별도의 경계와 알고리즘이 필요합니다.",
      "start": 349.48012499999993,
      "end": 356.6201249999999,
      "voice_start": 349.48012499999993,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 53,
      "scene_id": "10",
      "scene_title": "볼록성은 선분으로 생각하세요",
      "text": "볼록한 영역은 안의 두 점을 골라 연결한 선분이 모두 안에 남습니다. 직관적으로 움푹 파인 곳이 없습니다.",
      "start": 357.25012499999997,
      "end": 364.57012499999996,
      "voice_start": 357.25012499999997,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 54,
      "scene_id": "10",
      "scene_title": "볼록성은 선분으로 생각하세요",
      "text": "정육각형과 삼각형은 볼록합니다. 그 안의 두 점을 연결해도 바깥으로 빠져나가지 않습니다.",
      "start": 364.81012499999997,
      "end": 370.65012499999995,
      "voice_start": 364.81012499999997,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 55,
      "scene_id": "10",
      "scene_title": "볼록성은 선분으로 생각하세요",
      "text": "엘자에서는 왼쪽 위와 오른쪽 아래의 점을 연결하면 일부가 오른쪽 위 빈 영역을 통과합니다.",
      "start": 370.77012499999995,
      "end": 376.69012499999997,
      "voice_start": 370.77012499999995,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 56,
      "scene_id": "10",
      "scene_title": "볼록성은 선분으로 생각하세요",
      "text": "그 두 점은 안에 있어도 선분 전체는 안에 있지 않습니다. 따라서 엘자는 오목한 다각형입니다.",
      "start": 377.050125,
      "end": 382.77012499999995,
      "voice_start": 377.050125,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 57,
      "scene_id": "10",
      "scene_title": "볼록성은 선분으로 생각하세요",
      "text": "단순한 평면 경계에서는 같은 순서로 돌며 방향 전환이 한쪽으로 일관적인지도 볼 수 있습니다.",
      "start": 382.77012499999995,
      "end": 389.21012499999995,
      "voice_start": 382.77012499999995,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 58,
      "scene_id": "10",
      "scene_title": "볼록성은 선분으로 생각하세요",
      "text": "한쪽 회전 판정을 자기 교차 경계에 무조건 적용하면 안 됩니다. 먼저 입력의 순서와 교차 여부를 검증하세요.",
      "start": 389.410125,
      "end": 396.110125,
      "voice_start": 389.410125,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 59,
      "scene_id": "11",
      "scene_title": "타일 하나와 연결된 땅은 다릅니다",
      "text": "도르프로만틱의 육각형 타일이 추가되며 땅의 경계가 바뀝니다. 새 타일 하나와 전체 연결 영역을 나누어 보세요.",
      "start": 396.58012499999995,
      "end": 404.4201249999999,
      "voice_start": 396.58012499999995,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 60,
      "scene_id": "11",
      "scene_title": "타일 하나와 연결된 땅은 다릅니다",
      "text": "타일 하나는 볼록하지만 여러 개를 합친 윤곽에는 안쪽 홈이 생길 수 있습니다.",
      "start": 404.76012499999996,
      "end": 409.22012499999994,
      "voice_start": 404.76012499999996,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 61,
      "scene_id": "11",
      "scene_title": "타일 하나와 연결된 땅은 다릅니다",
      "text": "같은 바깥 경계 안에 있다고 생각한 두 위치를 연결해도, 선분이 빈 타일 자리 위를 통과할 수 있습니다.",
      "start": 409.50012499999997,
      "end": 415.96012499999995,
      "voice_start": 409.50012499999997,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 62,
      "scene_id": "11",
      "scene_title": "타일 하나와 연결된 땅은 다릅니다",
      "text": "볼록한 조각들의 합집합이 언제나 볼록한 것은 아닙니다. 전체 윤곽을 별도로 검사해야 합니다.",
      "start": 416.14012499999995,
      "end": 422.16012499999994,
      "voice_start": 416.14012499999995,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 63,
      "scene_id": "11",
      "scene_title": "타일 하나와 연결된 땅은 다릅니다",
      "text": "구멍이 있는 영역이라면 바깥 윤곽만 기록해도 충분하지 않습니다. 제외할 내부 경계가 필요합니다.",
      "start": 422.34012499999994,
      "end": 428.78012499999994,
      "voice_start": 422.34012499999994,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 64,
      "scene_id": "11",
      "scene_title": "타일 하나와 연결된 땅은 다릅니다",
      "text": "다음 계산에서는 모양 전체가 볼록한지 살피는 방법과, 각도의 합만으로 구분할 수 없는 이유를 보겠습니다.",
      "start": 428.98012499999993,
      "end": 435.680125,
      "voice_start": 428.98012499999993,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 65,
      "scene_id": "12",
      "scene_title": "회전 부호와 각도의 합",
      "text": "연속된 세 꼭짓점에서 두 변의 이차원 외적 부호를 봅니다. 경계를 시계 반대 방향으로 정했다면, 볼록한 곳은 왼쪽으로 돕니다.",
      "start": 436.15012499999995,
      "end": 445.65012499999995,
      "voice_start": 436.15012499999995,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 66,
      "scene_id": "12",
      "scene_title": "회전 부호와 각도의 합",
      "text": "엘자의 오목한 꼭짓점에서는 반대로 돕니다. 이 예제는 왼쪽 회전과 오른쪽 회전이 섞여 있습니다.",
      "start": 445.870125,
      "end": 452.01012499999996,
      "voice_start": 445.870125,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 67,
      "scene_id": "12",
      "scene_title": "회전 부호와 각도의 합",
      "text": "일직선인 세 점은 외적이 영입니다. 엄격한 볼록성인지, 일직선 점을 허용하는지 규칙을 정해야 합니다.",
      "start": 452.23012499999993,
      "end": 459.07012499999996,
      "voice_start": 452.23012499999993,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 68,
      "scene_id": "12",
      "scene_title": "회전 부호와 각도의 합",
      "text": "단순한 다각형의 내각 합은 꼭짓점의 개수에서 두 개를 뺀 뒤, 백팔십 도를 곱합니다. 볼록과 오목 모두 같습니다.",
      "start": 459.47012499999994,
      "end": 466.97012499999994,
      "voice_start": 459.47012499999994,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 69,
      "scene_id": "12",
      "scene_title": "회전 부호와 각도의 합",
      "text": "여섯 꼭짓점이면 칠백이십 도입니다. 각도 합이 맞는다는 이유만으로 볼록하다고 판정할 수 없습니다.",
      "start": 467.23012499999993,
      "end": 473.1101249999999,
      "voice_start": 467.23012499999993,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 70,
      "scene_id": "12",
      "scene_title": "회전 부호와 각도의 합",
      "text": "역코사인으로 각도를 구할 때는 영인 변을 거르고 입력을 마이너스 일과 일 사이로 제한합니다. 작은 끼인각만으로 오목한 내각을 구별하지 마세요.",
      "start": 473.3867916666666,
      "end": 482.53012499999994,
      "voice_start": 473.3867916666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 71,
      "scene_id": "13",
      "scene_title": "볼록한 다각형은 부채꼴로 나누기",
      "text": "볼록한 다각형에서는 첫 꼭짓점에서 나머지 꼭짓점으로 대각선을 그을 수 있습니다.",
      "start": 483.0001249999999,
      "end": 487.98012499999993,
      "voice_start": 483.0001249999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 72,
      "scene_id": "13",
      "scene_title": "볼록한 다각형은 부채꼴로 나누기",
      "text": "첫 삼각형은 영, 일, 이이고 다음은 영, 이, 삼입니다. 같은 첫 꼭짓점을 공유하며 앞으로 진행합니다.",
      "start": 488.4201249999999,
      "end": 495.16012499999994,
      "voice_start": 488.4201249999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 73,
      "scene_id": "13",
      "scene_title": "볼록한 다각형은 부채꼴로 나누기",
      "text": "꼭짓점이 여섯 개면 삼각형은 네 개입니다. 일반적으로 꼭짓점의 개수에서 두 개를 뺀 개수입니다.",
      "start": 495.5001249999999,
      "end": 501.16012499999994,
      "voice_start": 495.5001249999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 74,
      "scene_id": "13",
      "scene_title": "볼록한 다각형은 부채꼴로 나누기",
      "text": "볼록하기 때문에 대각선과 삼각형이 바깥으로 빠져나가지 않습니다. 바로 이 조건이 단순한 방법을 안전하게 만듭니다.",
      "start": 501.3601249999999,
      "end": 507.7601249999999,
      "voice_start": 501.3601249999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 75,
      "scene_id": "13",
      "scene_title": "볼록한 다각형은 부채꼴로 나누기",
      "text": "각 삼각형은 같은 경계 방향으로 저장하고, 원래 꼭짓점의 인덱스로 위치와 속성을 참조할 수 있습니다.",
      "start": 507.9601249999999,
      "end": 514.440125,
      "voice_start": 507.9601249999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 76,
      "scene_id": "13",
      "scene_title": "볼록한 다각형은 부채꼴로 나누기",
      "text": "삼각형 개수가 맞는 것만으로 올바른 분할이 되지는 않습니다. 영역을 겹치거나 빠짐없이 덮는지도 확인하세요.",
      "start": 514.580125,
      "end": 520.8001249999999,
      "voice_start": 514.580125,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 77,
      "scene_id": "14",
      "scene_title": "안쪽 홈을 가로지르면 생기는 문제",
      "text": "노이타에서 캐릭터가 파인 통로와 지형의 끝을 지납니다. 바깥으로 열린 빈 공간을 보세요.",
      "start": 521.290125,
      "end": 527.750125,
      "voice_start": 521.290125,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 78,
      "scene_id": "14",
      "scene_title": "안쪽 홈을 가로지르면 생기는 문제",
      "text": "경계의 한 점에서 모든 다른 점으로 직선을 잇는다면, 일부 선은 빈 공간을 가로지를 수 있습니다.",
      "start": 527.8501249999999,
      "end": 533.310125,
      "voice_start": 527.8501249999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 79,
      "scene_id": "14",
      "scene_title": "안쪽 홈을 가로지르면 생기는 문제",
      "text": "그 선을 삼각형 변으로 사용하면 원래 없던 땅을 채웠다고 계산할 수 있습니다.",
      "start": 533.450125,
      "end": 538.150125,
      "voice_start": 533.450125,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 80,
      "scene_id": "14",
      "scene_title": "안쪽 홈을 가로지르면 생기는 문제",
      "text": "반대로 어떤 부분은 여러 삼각형이 겹칠 수도 있습니다. 총 개수만 맞추어서는 이 문제를 발견하지 못합니다.",
      "start": 538.410125,
      "end": 544.170125,
      "voice_start": 538.410125,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 81,
      "scene_id": "14",
      "scene_title": "안쪽 홈을 가로지르면 생기는 문제",
      "text": "실제 게임이 그런 오류를 낸다는 뜻이 아닙니다. 보이는 통로를 통해 잘못된 분할의 결과를 상상해 보는 것입니다.",
      "start": 544.410125,
      "end": 550.630125,
      "voice_start": 544.410125,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 82,
      "scene_id": "14",
      "scene_title": "안쪽 홈을 가로지르면 생기는 문제",
      "text": "이제 같은 엘자에서 시작점을 바꾸어, 부채꼴이 실패하는 경우를 직접 그려 보겠습니다.",
      "start": 550.630125,
      "end": 555.950125,
      "voice_start": 550.630125,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 83,
      "scene_id": "15",
      "scene_title": "오목한 예제에서 부채꼴의 실패",
      "text": "엘자의 한 꼭짓점을 부채꼴의 기준으로 고릅니다. 이 점의 엑스 좌표는 사이고, 와이 좌표는 숫자 일입니다. 경계 순서를 따라 네 개의 삼각형을 만듭니다.",
      "start": 556.4601250000001,
      "end": 566.9601250000001,
      "voice_start": 556.6867916666667,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 84,
      "scene_id": "15",
      "scene_title": "오목한 예제에서 부채꼴의 실패",
      "text": "기준점에서 일, 사와 영, 사 쪽으로 이어지는 삼각형의 일부는 빈 영역으로 나갑니다.",
      "start": 567.1801250000001,
      "end": 573.3201250000001,
      "voice_start": 567.1801250000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 85,
      "scene_id": "15",
      "scene_title": "오목한 예제에서 부채꼴의 실패",
      "text": "경계 방향에 따른 넓이를 더하면 칠이 나올 수 있습니다. 잘못 덮은 부분이 부호로 상쇄되기 때문입니다.",
      "start": 573.5601250000001,
      "end": 579.4201250000001,
      "voice_start": 573.5601250000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 86,
      "scene_id": "15",
      "scene_title": "오목한 예제에서 부채꼴의 실패",
      "text": "원래 엘자의 넓이도 칠이지만, 같은 합이 올바른 영역을 보장하지는 않습니다.",
      "start": 579.7801250000001,
      "end": 584.740125,
      "voice_start": 579.7801250000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 87,
      "scene_id": "15",
      "scene_title": "오목한 예제에서 부채꼴의 실패",
      "text": "반대로 영, 영을 기준으로 하면 이 특정 엘자에서는 유효한 부채꼴이 됩니다. 오목한 모양이 모두 같은 결과를 내는 것은 아닙니다.",
      "start": 584.740125,
      "end": 593.5801250000001,
      "voice_start": 584.740125,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 88,
      "scene_id": "15",
      "scene_title": "오목한 예제에서 부채꼴의 실패",
      "text": "중요한 것은 입력 조건을 확인한 알고리즘입니다. 임의의 시작점으로 오목 다각형을 안전하게 나눌 수 있다고 일반화하지 마세요.",
      "start": 593.9601250000001,
      "end": 601.620125,
      "voice_start": 593.9601250000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 89,
      "scene_id": "16",
      "scene_title": "귀 잘라내기의 첫 단계",
      "text": "귀는 경계의 연속된 세 꼭짓점으로 만드는, 안쪽에 놓인 삼각형입니다. 가운데 꼭짓점이 볼록한 후보여야 합니다.",
      "start": 602.2701250000001,
      "end": 610.6301250000001,
      "voice_start": 602.2701250000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 90,
      "scene_id": "16",
      "scene_title": "귀 잘라내기의 첫 단계",
      "text": "단순 경계에서 대각선이 내부에 있어야 하고, 다른 남은 꼭짓점이 그 삼각형 안이나 허용하지 않은 경계 위에 없어야 합니다.",
      "start": 610.9101250000001,
      "end": 618.5101250000001,
      "voice_start": 610.9101250000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 91,
      "scene_id": "16",
      "scene_title": "귀 잘라내기의 첫 단계",
      "text": "엘자에서 영, 영과 사, 영과 사, 일인 삼각형을 첫 귀로 고릅니다. 넓이는 이입니다.",
      "start": 618.6351250000001,
      "end": 625.7301250000002,
      "voice_start": 618.6351250000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 92,
      "scene_id": "16",
      "scene_title": "귀 잘라내기의 첫 단계",
      "text": "그 삼각형을 결과에 저장하고 가운데 꼭짓점인 사, 영을 남은 경계에서 제거합니다.",
      "start": 625.9901250000001,
      "end": 631.5501250000001,
      "voice_start": 625.9901250000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 93,
      "scene_id": "16",
      "scene_title": "귀 잘라내기의 첫 단계",
      "text": "새 경계는 영, 영에서 사, 일로 바로 이어집니다. 제거한 삼각형과 남은 영역이 원래 엘자를 함께 덮습니다.",
      "start": 631.5501250000001,
      "end": 639.1501250000001,
      "voice_start": 631.5501250000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 94,
      "scene_id": "16",
      "scene_title": "귀 잘라내기의 첫 단계",
      "text": "꼭짓점을 제거했다고 원래 데이터의 인덱스를 덮어쓰지 마세요. 남은 연결 관계와 출력 삼각형을 따로 유지합니다.",
      "start": 639.4701250000002,
      "end": 646.3301250000002,
      "voice_start": 639.4701250000002,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 95,
      "scene_id": "17",
      "scene_title": "빠진 통로 없이 영역을 보존하기",
      "text": "노이타의 얼음 지형과 좁은 통로를 따라 움직입니다. 어디가 지형이고 어디가 지나갈 빈 공간인지 구분하세요.",
      "start": 646.8001250000002,
      "end": 653.6801250000002,
      "voice_start": 646.8001250000002,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 96,
      "scene_id": "17",
      "scene_title": "빠진 통로 없이 영역을 보존하기",
      "text": "분할 결과를 볼 때도 같은 질문이 필요합니다. 원래 지형에 있던 영역은 남고, 빈 통로는 채워지지 않아야 합니다.",
      "start": 653.9001250000002,
      "end": 660.6001250000002,
      "voice_start": 653.9001250000002,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 97,
      "scene_id": "17",
      "scene_title": "빠진 통로 없이 영역을 보존하기",
      "text": "삼각형을 하나씩 추가할 때마다 주변 경계를 다시 보아야 합니다. 처음의 이웃 관계가 끝까지 같지는 않습니다.",
      "start": 661.1201250000003,
      "end": 668.2001250000002,
      "voice_start": 661.1201250000003,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 98,
      "scene_id": "17",
      "scene_title": "빠진 통로 없이 영역을 보존하기",
      "text": "형태가 복잡해져도 지켜야 할 것은 겹침 없는 덮기와 같은 바깥 윤곽입니다.",
      "start": 668.5401250000002,
      "end": 673.4401250000002,
      "voice_start": 668.5401250000002,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 99,
      "scene_id": "17",
      "scene_title": "빠진 통로 없이 영역을 보존하기",
      "text": "여기서는 게임의 실제 이동을 관찰할 뿐, 픽셀 데이터를 직접 삼각형으로 바꾸었다고 말하지 않습니다.",
      "start": 673.4401250000002,
      "end": 679.6401250000002,
      "voice_start": 673.4401250000002,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 100,
      "scene_id": "17",
      "scene_title": "빠진 통로 없이 영역을 보존하기",
      "text": "다음 그림에서는 남은 귀를 차례로 제거하고 네 삼각형이 넓이 칠의 엘자를 정확하게 덮는지 확인합니다.",
      "start": 680.0801250000002,
      "end": 686.2001250000002,
      "voice_start": 680.0801250000002,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 101,
      "scene_id": "18",
      "scene_title": "남은 귀를 제거하고 결과 검사하기",
      "text": "첫 귀를 뗀 뒤 다음 귀는 영, 이, 삼입니다. 그 넓이는 일 점 오입니다.",
      "start": 686.8501250000003,
      "end": 692.3101250000003,
      "voice_start": 686.8501250000003,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 102,
      "scene_id": "18",
      "scene_title": "남은 귀를 제거하고 결과 검사하기",
      "text": "이 꼭짓점을 제거하면 영, 삼, 사가 다음 귀가 됩니다. 넓이는 다시 일 점 오입니다.",
      "start": 692.4301250000003,
      "end": 698.6101250000003,
      "voice_start": 692.4301250000003,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 103,
      "scene_id": "18",
      "scene_title": "남은 귀를 제거하고 결과 검사하기",
      "text": "마지막에는 영, 사, 오 삼각형이 남고 넓이는 이입니다. 네 넓이를 더하면 칠입니다.",
      "start": 698.8701250000003,
      "end": 704.8501250000003,
      "voice_start": 698.8701250000003,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 104,
      "scene_id": "18",
      "scene_title": "남은 귀를 제거하고 결과 검사하기",
      "text": "각 삼각형의 내부가 겹치지 않고 빈 영역을 채우지 않으며, 원래 경계를 덮는 것도 확인합니다.",
      "start": 705.0501250000003,
      "end": 710.7701250000002,
      "voice_start": 705.0501250000003,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 105,
      "scene_id": "18",
      "scene_title": "남은 귀를 제거하고 결과 검사하기",
      "text": "귀를 찾지 못하면 유효하지 않은 입력이나 퇴화, 허용 오차 문제를 의심해야 합니다. 무한 반복하거나 임의의 삼각형을 출력하지 마세요.",
      "start": 711.0301250000002,
      "end": 719.4901250000003,
      "voice_start": 711.0301250000002,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 106,
      "scene_id": "18",
      "scene_title": "남은 귀를 제거하고 결과 검사하기",
      "text": "구멍 있는 다각형을 연결하는 기법은 추가 규칙이 필요합니다. 오늘의 단순 예제가 모든 구멍과 교차 입력까지 해결했다고 확장하지 않습니다.",
      "start": 719.8101250000003,
      "end": 728.0301250000002,
      "voice_start": 719.8101250000003,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 107,
      "scene_id": "19",
      "scene_title": "좁은 곳과 가느다란 조각",
      "text": "노이타에서 넓은 공간과 좁은 틈을 지납니다. 실제 윤곽에는 서로 가까운 점과 긴 경계가 함께 나타납니다.",
      "start": 728.5001250000004,
      "end": 736.2201250000004,
      "voice_start": 728.5001250000004,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 108,
      "scene_id": "19",
      "scene_title": "좁은 곳과 가느다란 조각",
      "text": "그런 모양을 삼각형으로 표현하면 아주 가느다란 조각이 생길 수 있습니다.",
      "start": 736.5801250000004,
      "end": 740.6401250000004,
      "voice_start": 736.5801250000004,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 109,
      "scene_id": "19",
      "scene_title": "좁은 곳과 가느다란 조각",
      "text": "가느다란 삼각형은 꼭 틀린 삼각형은 아닙니다. 하지만 작은 넓이에 비해 긴 변을 가져 계산이 민감해질 수 있습니다.",
      "start": 740.9601250000004,
      "end": 748.6601250000003,
      "voice_start": 740.9601250000004,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 110,
      "scene_id": "19",
      "scene_title": "좁은 곳과 가느다란 조각",
      "text": "좌표 단위와 해상도가 다른 입력에 같은 숫자의 허용 오차를 그대로 적용하는 것도 조심해야 합니다.",
      "start": 749.0001250000004,
      "end": 754.8801250000004,
      "voice_start": 749.0001250000004,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 111,
      "scene_id": "19",
      "scene_title": "좁은 곳과 가느다란 조각",
      "text": "모양을 단순하게 만들기 위해 점을 지우면 통로의 폭이나 경계가 달라질 수 있습니다. 필요한 정보부터 보존하세요.",
      "start": 754.8801250000004,
      "end": 761.7401250000004,
      "voice_start": 754.8801250000004,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 112,
      "scene_id": "19",
      "scene_title": "좁은 곳과 가느다란 조각",
      "text": "다음 비교는 유효한 분할과 품질 좋은 분할을 구분합니다. 원래 영역을 지키는 것이 먼저이고 모양 개선은 그다음입니다.",
      "start": 762.0401250000003,
      "end": 769.2801250000003,
      "voice_start": 762.0401250000003,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 113,
      "scene_id": "20",
      "scene_title": "유효성 검사 뒤에 품질 개선하기",
      "text": "넓이가 거의 영인 삼각형과 넓이가 충분한 삼각형을 나란히 보겠습니다. 작은 각도를 가진 조각은 계산에 민감합니다.",
      "start": 769.9101250000004,
      "end": 777.4901250000005,
      "voice_start": 769.9101250000004,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 114,
      "scene_id": "20",
      "scene_title": "유효성 검사 뒤에 품질 개선하기",
      "text": "귀가 여러 개라면 작은 각도가 더 큰 후보를 선호하는 등 품질 기준을 둘 수 있습니다.",
      "start": 777.5901250000004,
      "end": 782.2101250000004,
      "voice_start": 777.5901250000004,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 115,
      "scene_id": "20",
      "scene_title": "유효성 검사 뒤에 품질 개선하기",
      "text": "하지만 좋은 각도만 보고 경계 밖의 삼각형을 고르면 안 됩니다. 귀의 유효성 조건이 먼저입니다.",
