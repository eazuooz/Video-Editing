  "entries": [
    {
      "index": 1,
      "scene_id": "01",
      "scene_title": "우리가 보는 건 세상의 일부",
      "text": "같은 게임인데 어떤 화면에서는 주변이 잘 보이고, 어떤 화면에서는 눈앞이 답답하게 느껴집니다.",
      "start": 0.0,
      "end": 5.74,
      "voice_start": 0.0,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 2,
      "scene_id": "01",
      "scene_title": "우리가 보는 건 세상의 일부",
      "text": "그래픽 품질이 같아도, 화면에 무엇을 얼마나 담느냐에 따라 플레이는 달라집니다.",
      "start": 5.98,
      "end": 10.84,
      "voice_start": 5.98,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 3,
      "scene_id": "01",
      "scene_title": "우리가 보는 건 세상의 일부",
      "text": "우리가 보고 있는 건 거대한 게임 세계 전체가 아니라, 모니터에 들어온 일부이기 때문입니다.",
      "start": 11.14,
      "end": 15.72,
      "voice_start": 11.14,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 4,
      "scene_id": "01",
      "scene_title": "우리가 보는 건 세상의 일부",
      "text": "화면이 실제 시야에서 차지하는 넓이는 모니터 크기와 앉은 거리에 따라 달라집니다.",
      "start": 16.1,
      "end": 20.9,
      "voice_start": 16.1,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 5,
      "scene_id": "01",
      "scene_title": "우리가 보는 건 세상의 일부",
      "text": "게임 카메라가 그 안에 얼마나 넓은 풍경을 담는지는 또 다른 문제고요.",
      "start": 21.12,
      "end": 24.94,
      "voice_start": 21.12,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 6,
      "scene_id": "01",
      "scene_title": "우리가 보는 건 세상의 일부",
      "text": "오늘의 주제는 자동차가 아니라, 게임을 담는 화면의 틀입니다. 화면 비율과 시야각, 그리고 중요한 대상이 화면에서 차지하는 크기를 살펴보겠습니다.",
      "start": 25.18,
      "end": 33.6,
      "voice_start": 25.18,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 7,
      "scene_id": "02",
      "scene_title": "화면 비율은 창의 모양이다",
      "text": "먼저 화면 비율입니다. 십육 대 구, 이십일 대 구 같은 숫자는 화면의 가로와 세로 길이의 비율입니다.",
      "start": 34.72,
      "end": 41.519999999999996,
      "voice_start": 34.72,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 8,
      "scene_id": "02",
      "scene_title": "화면 비율은 창의 모양이다",
      "text": "가로가 넓어졌다고 모든 게임에서 더 많은 세상이 보이는 것은 아닙니다.",
      "start": 41.76,
      "end": 45.98,
      "voice_start": 41.76,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 9,
      "scene_id": "02",
      "scene_title": "화면 비율은 창의 모양이다",
      "text": "세로 시야각을 유지하면서 가로를 넓히는 방식이라면, 양옆의 공간을 더 보여 줄 수 있습니다.",
      "start": 46.06,
      "end": 51.5,
      "voice_start": 46.06,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 10,
      "scene_id": "02",
      "scene_title": "화면 비율은 창의 모양이다",
      "text": "반대로 기존 화면을 확대해서 위아래를 자르거나, 검은 여백을 두는 게임도 있습니다.",
      "start": 51.84,
      "end": 57.04,
      "voice_start": 51.84,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 11,
      "scene_id": "02",
      "scene_title": "화면 비율은 창의 모양이다",
      "text": "아래 비교는 같은 세로 시야각을 유지하는 자체 예시입니다. 가로를 늘리면 양옆이 열리지만, 물체를 옆으로 잡아 늘리는 것은 아닙니다.",
      "start": 57.18,
      "end": 64.74,
      "voice_start": 57.18,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 12,
      "scene_id": "02",
      "scene_title": "화면 비율은 창의 모양이다",
      "text": "화면 비율을 바꿀 때는 무엇을 더 보여 주고 무엇을 지킬지부터 정해야 합니다. 인터페이스가 화면 밖으로 밀려나지 않는지도 확인해야겠죠.",
      "start": 65.3,
      "end": 73.28,
      "voice_start": 65.3,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 13,
      "scene_id": "03",
      "scene_title": "많이 보이면 무조건 좋을까",
      "text": "그렇다면 카메라의 시야각을 넓히면 해결되지 않을까요? 이를 영어로 필드 오브 뷰, 줄여서 에프오브이라고 부릅니다.",
      "start": 74.16,
      "end": 81.0,
      "voice_start": 74.16,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 14,
      "scene_id": "03",
      "scene_title": "많이 보이면 무조건 좋을까",
      "text": "같은 자리에서 같은 화면에 더 넓은 풍경을 담으면, 주변 상황을 더 많이 볼 수 있습니다.",
      "start": 81.25999999999999,
      "end": 86.42,
      "voice_start": 81.25999999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 15,
      "scene_id": "03",
      "scene_title": "많이 보이면 무조건 좋을까",
      "text": "하지만 원근 카메라에서는 가운데 있는 같은 물체가 더 작게 보입니다.",
      "start": 86.82,
      "end": 90.69999999999999,
      "voice_start": 86.82,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 16,
      "scene_id": "03",
      "scene_title": "많이 보이면 무조건 좋을까",
      "text": "반대로 시야각을 좁히면 앞의 대상은 커지지만, 옆에서 다가오는 것을 놓치기 쉬워집니다.",
      "start": 91.16,
      "end": 96.36,
      "voice_start": 91.16,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 17,
      "scene_id": "03",
      "scene_title": "많이 보이면 무조건 좋을까",
      "text": "옆은 잘 보이는데 앞차가 콩알이 되는 것도, 앞차만 보다가 옆차를 놓치는 것도 곤란하겠죠.",
      "start": 96.52,
      "end": 102.34,
      "voice_start": 96.52,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 18,
      "scene_id": "03",
      "scene_title": "많이 보이면 무조건 좋을까",
      "text": "주변을 읽는 일과 작은 대상을 구분하는 일. 이 둘 사이의 균형을 게임에 맞게 정해야 합니다.",
      "start": 102.34,
      "end": 107.97999999999999,
      "voice_start": 102.34,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 19,
      "scene_id": "04",
      "scene_title": "표적이 작은 것도 설계다",
      "text": "슈팅 게임에서는 이런 차이가 더 직접적으로 느껴집니다.",
      "start": 108.72,
      "end": 111.96,
      "voice_start": 108.72,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 20,
      "scene_id": "04",
      "scene_title": "표적이 작은 것도 설계다",
      "text": "큰 모니터를 샀는데, 정작 맞혀야 할 적은 화면 속 작은 점 하나일 수 있거든요.",
      "start": 112.17999999999999,
      "end": 117.2,
      "voice_start": 112.17999999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 21,
      "scene_id": "04",
      "scene_title": "표적이 작은 것도 설계다",
      "text": "먼 적을 찾아내고 정확히 조준하는 재미라면, 작은 표적이 의도된 도전이 될 수 있습니다.",
      "start": 117.44,
      "end": 122.9,
      "voice_start": 117.44,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 22,
      "scene_id": "04",
      "scene_title": "표적이 작은 것도 설계다",
      "text": "반대로 가까이서 공격을 피하고 적의 동작을 읽는 재미라면, 그 동작이 충분히 크게 보여야 합니다.",
      "start": 123.14,
      "end": 129.38,
      "voice_start": 123.14,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 23,
      "scene_id": "04",
      "scene_title": "표적이 작은 것도 설계다",
      "text": "방법은 적을 키우는 것만이 아닙니다. 전투 거리를 좁히거나, 배경과 구분되는 색과 실루엣을 줄 수도 있습니다.",
      "start": 129.44,
      "end": 136.3,
      "voice_start": 129.44,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 24,
      "scene_id": "04",
      "scene_title": "표적이 작은 것도 설계다",
      "text": "단순히 크게 만들자는 이야기가 아닙니다. 플레이어에게 무엇을 보고 판단하게 할 것인지가 먼저입니다.",
      "start": 136.48,
      "end": 142.22,
      "voice_start": 136.48,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 25,
      "scene_id": "05",
      "scene_title": "전체 화면이 전부 플레이 공간은 아니다",
      "text": "화면이 넓어도 정작 판단에 쓸 수 있는 공간은 작을 수 있습니다.",
      "start": 142.96,
      "end": 146.70000000000002,
      "voice_start": 142.96,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 26,
      "scene_id": "05",
      "scene_title": "전체 화면이 전부 플레이 공간은 아니다",
      "text": "레이싱 게임의 운전석, 슈팅 게임의 커다란 무기, 화면을 채운 안내창을 떠올려 보세요.",
      "start": 146.9,
      "end": 152.20000000000002,
      "voice_start": 146.9,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 27,
      "scene_id": "05",
      "scene_title": "전체 화면이 전부 플레이 공간은 아니다",
      "text": "분위기를 살리는 요소지만, 다음 코너나 적의 움직임을 가린다면 실제로 읽을 수 있는 공간은 줄어듭니다.",
      "start": 152.54000000000002,
      "end": 158.22,
      "voice_start": 152.54000000000002,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 28,
      "scene_id": "05",
      "scene_title": "전체 화면이 전부 플레이 공간은 아니다",
      "text": "차를 몰려고 켰는데 대시보드 감상회가 되어 버리면 곤란하겠죠.",
      "start": 158.42000000000002,
      "end": 162.3,
      "voice_start": 158.42000000000002,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 29,
      "scene_id": "05",
      "scene_title": "전체 화면이 전부 플레이 공간은 아니다",
      "text": "그렇다고 전부 지우자는 뜻은 아닙니다. 속도계나 체력처럼 필요한 정보는 남기고, 장식과 안내의 크기와 위치를 조절하는 겁니다.",
      "start": 162.66,
      "end": 170.34,
      "voice_start": 162.66,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 30,
      "scene_id": "05",
      "scene_title": "전체 화면이 전부 플레이 공간은 아니다",
      "text": "화면을 얼마나 꽉 채웠는가보다, 플레이어가 필요한 단서를 얼마나 빠르게 찾을 수 있는지가 중요합니다.",
      "start": 170.34,
      "end": 176.62,
      "voice_start": 170.34,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 31,
      "scene_id": "06",
      "scene_title": "다음 행동이 보이는 화면",
      "text": "이제 여러분의 게임 화면을 하나 멈춰 보세요.",
      "start": 177.36,
      "end": 179.76000000000002,
      "voice_start": 177.36,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 32,
      "scene_id": "06",
      "scene_title": "다음 행동이 보이는 화면",
      "text": "플레이어가 지금 봐야 하는 대상은 어디에 있고, 얼마나 크게 보이나요?",
      "start": 179.94000000000003,
      "end": 183.54000000000002,
      "voice_start": 179.94000000000003,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 33,
      "scene_id": "06",
      "scene_title": "다음 행동이 보이는 화면",
      "text": "캐릭터나 무기, 안내창이 다음 행동의 단서를 가리고 있지는 않나요?",
      "start": 183.74,
      "end": 188.06,
      "voice_start": 183.74,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 34,
      "scene_id": "06",
      "scene_title": "다음 행동이 보이는 화면",
      "text": "정보가 작아서 못 읽는다면 크기나 대비를 바꿔 보고, 주변을 놓친다면 카메라와 배치를 바꿔 보는 겁니다.",
      "start": 188.14000000000001,
      "end": 194.24,
      "voice_start": 188.14000000000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 35,
      "scene_id": "06",
      "scene_title": "다음 행동이 보이는 화면",
      "text": "그리고 개발할 때 쓰는 큰 모니터에서만 확인하지 말고, 실제로 플레이할 화면 크기와 거리에서도 테스트해 보세요.",
      "start": 194.48000000000002,
      "end": 201.10000000000002,
      "voice_start": 194.48000000000002,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 36,
      "scene_id": "06",
      "scene_title": "다음 행동이 보이는 화면",
      "text": "화면 비율은 창의 모양, 시야각은 담는 범위, 화면 점유율은 대상이 차지하는 크기입니다. 서로 연결되어 있지만 같은 값은 아닙니다.",
      "start": 201.52,
      "end": 209.52,
      "voice_start": 201.52,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 37,
      "scene_id": "06",
      "scene_title": "다음 행동이 보이는 화면",
      "text": "좋은 화면은 모든 것을 크게 보여 주는 화면이 아닙니다. 지금 보고, 판단하고, 행동해야 할 것이 잘 보이는 화면입니다. 작은 창 안에서도 게임의 재미는 충분히 크게 만들 수 있습니다.",
      "start": 209.84,
      "end": 220.42000000000002,
      "voice_start": 209.84,
      "alignment": "whisper-word-timestamps-script-matched"
    }
  ],
