{
  "sample_rate": 24000,
  "duration_seconds": 1000.9300416666671,
  "render_mode": "scene",
  "example_seconds": 0.0,
  "narration_placement": "continuous-across-example-and-explanation",
  "entries": [
    {
      "index": 1,
      "scene_id": "01",
      "scene_title": "이번 강의에서 배울 것",
      "text": "게임 속 공중 회전은 네 숫자로 어떻게 기록할 수 있을까요?",
      "start": 0.0,
      "end": 3.6525
    },
    {
      "index": 2,
      "scene_id": "01",
      "scene_title": "이번 강의에서 배울 것",
      "text": "이번 시간에는 스키와 자전거의 자세를 관찰하고, 쿼터니언의 네 성분과 반각의 의미를 그림으로 이해합니다.",
      "start": 3.6525,
      "end": 10.9025
    },
    {
      "index": 3,
      "scene_id": "01",
      "scene_title": "이번 강의에서 배울 것",
      "text": "역회전과 곱셈으로 회전을 되돌리고 합친 뒤, 두 자세 사이의 차이도 계산합니다.",
      "start": 10.9025,
      "end": 15.9525
    },
    {
      "index": 4,
      "scene_id": "01",
      "scene_title": "이번 강의에서 배울 것",
      "text": "마지막으로 부호와 정규화의 함정을 확인하고, 직접 한 벡터를 돌리는 문제를 풀어 보겠습니다.",
      "start": 15.9525,
      "end": 22.08
    },
    {
      "index": 5,
      "scene_id": "02",
      "scene_title": "스키의 이동과 자세를 나누어 보기",
      "text": "라이더스 리퍼블릭에서 스키를 타고 내려가는 장면입니다. 몸과 스키가 기울어지는 모습을 보세요.",
      "start": 22.529999999999998,
      "end": 28.972499999999997
    },
    {
      "index": 6,
      "scene_id": "02",
      "scene_title": "스키의 이동과 자세를 나누어 보기",
      "text": "앞으로 가는 위치 변화와, 몸이 어느 쪽을 향하는 자세 변화를 따로 읽어 봅니다.",
      "start": 28.972499999999997,
      "end": 34.4825
    },
    {
      "index": 7,
      "scene_id": "02",
      "scene_title": "스키의 이동과 자세를 나누어 보기",
      "text": "공중에서는 진행 경로가 이어지는 동안 몸의 방향과 기울기도 바뀝니다.",
      "start": 34.4825,
      "end": 38.74249999999999
    },
    {
      "index": 8,
      "scene_id": "02",
      "scene_title": "스키의 이동과 자세를 나누어 보기",
      "text": "화면 가운데에 있다고 자세가 같은 것은 아닙니다. 카메라 역시 대상을 따라 움직입니다.",
      "start": 38.74249999999999,
      "end": 44.24249999999999
    },
    {
      "index": 9,
      "scene_id": "02",
      "scene_title": "스키의 이동과 자세를 나누어 보기",
      "text": "이 강의는 보이는 움직임을 설명할 회전 표현을 배우는 시간입니다. 게임의 내부 코드를 확인한 자료는 아닙니다.",
      "start": 44.24249999999999,
      "end": 51.13249999999999
    },
    {
      "index": 10,
      "scene_id": "02",
      "scene_title": "스키의 이동과 자세를 나누어 보기",
      "text": "다음 그림에서는 위치를 고정한 채 몸에 붙은 세 축만 돌려, 자세 변화부터 살펴보겠습니다.",
      "start": 51.13249999999999,
      "end": 56.849999999999994
    },
    {
      "index": 11,
      "scene_id": "03",
      "scene_title": "네 성분은 네 회전 각도가 아니다",
      "text": "쿼터니언은 스칼라 성분 하나와 벡터 성분 세 개로 씁니다. 이 강의에서는 더블유, 엑스, 와이, 제트 순서입니다.",
      "start": 57.3,
      "end": 64.3025
    },
    {
      "index": 12,
      "scene_id": "03",
      "scene_title": "네 성분은 네 회전 각도가 아니다",
      "text": "회전에 쓰는 단위 쿼터니언은 네 성분 제곱의 합이 일입니다. 자유롭게 고를 수 있는 값은 세 개입니다.",
      "start": 64.3025,
      "end": 72.7025
    },
    {
      "index": 13,
      "scene_id": "03",
      "scene_title": "네 성분은 네 회전 각도가 아니다",
      "text": "따라서 네 숫자를 네 회전 각도라고 읽으면 안 됩니다. 엑스, 와이, 제트도 오일러 각이 아닙니다.",
      "start": 72.7025,
      "end": 77.85249999999999
    },
    {
      "index": 14,
      "scene_id": "03",
      "scene_title": "네 성분은 네 회전 각도가 아니다",
      "text": "수로서의 쿼터니언은 아이, 제이, 케이를 쓰며, 각각의 제곱은 마이너스 일입니다.",
      "start": 77.85249999999999,
      "end": 83.1125
    },
    {
      "index": 15,
      "scene_id": "03",
      "scene_title": "네 성분은 네 회전 각도가 아니다",
      "text": "아이 곱하기 제이는 케이지만, 제이 곱하기 아이는 마이너스 케이입니다. 순서가 중요하다는 첫 단서입니다.",
      "start": 83.1125,
      "end": 91.5525
    },
    {
      "index": 16,
      "scene_id": "03",
      "scene_title": "네 성분은 네 회전 각도가 아니다",
      "text": "라이브러리는 성분을 엑스, 와이, 제트, 더블유 순서로 저장할 수도 있습니다. 이름과 메모리 순서를 확인하세요.",
      "start": 91.5525,
      "end": 98.18
    },
    {
      "index": 17,
      "scene_id": "04",
      "scene_title": "축·각에서 반각으로 연결하기",
      "text": "앞 편의 축과 각도를 떠올려 보세요. 길이가 일인 축 벡터와, 그 축 주위로 돌릴 각도가 있습니다.",
      "start": 98.63000000000001,
      "end": 104.58250000000001
    },
    {
      "index": 18,
      "scene_id": "04",
      "scene_title": "축·각에서 반각으로 연결하기",
      "text": "단위 쿼터니언의 스칼라는 각도의 절반에 대한 코사인입니다. 벡터 부분은 단위 축에 반각의 사인을 곱합니다.",
      "start": 104.58250000000001,
      "end": 112.3725
    },
    {
      "index": 19,
      "scene_id": "04",
      "scene_title": "축·각에서 반각으로 연결하기",
      "text": "각도가 영이면 코사인은 일, 사인은 영입니다. 그래서 일, 영, 영, 영이 회전 없는 자세가 됩니다.",
      "start": 112.3725,
      "end": 118.31250000000001
    },
    {
      "index": 20,
      "scene_id": "04",
      "scene_title": "축·각에서 반각으로 연결하기",
      "text": "제트축으로 구십 도를 돌리면 반각은 사십오 도입니다. 스칼라와 제트 성분이 모두 루트 이 나누기 이가 됩니다.",
      "start": 118.31250000000001,
      "end": 125.54250000000002
    },
    {
      "index": 21,
      "scene_id": "04",
      "scene_title": "축·각에서 반각으로 연결하기",
      "text": "반각은 회전을 절반만 한다는 뜻이 아닙니다. 벡터를 실제로 돌리는 식에서 양쪽 곱셈으로 전체 각도가 만들어집니다.",
      "start": 125.54250000000002,
      "end": 132.7525
    },
    {
      "index": 22,
      "scene_id": "04",
      "scene_title": "축·각에서 반각으로 연결하기",
      "text": "오른손 규칙과 열벡터 약속을 유지합니다. 계산에 넣는 삼각함수의 각도 단위는 라디안입니다.",
      "start": 132.7525,
      "end": 138.95000000000002
    },
    {
      "index": 23,
      "scene_id": "05",
      "scene_title": "몸에 붙인 축과 공중 회전",
      "text": "스키가 지면을 벗어나는 순간과 착지하는 순간의 몸 방향을 비교해 보세요.",
      "start": 139.4,
      "end": 143.8125
    },
    {
      "index": 24,
      "scene_id": "05",
      "scene_title": "몸에 붙인 축과 공중 회전",
      "text": "몸에 작은 세 축을 붙였다고 상상하면, 공중에서 축 전체가 같이 돌아갑니다.",
      "start": 143.8125,
      "end": 149.0925
    },
    {
      "index": 25,
      "scene_id": "05",
      "scene_title": "몸에 붙인 축과 공중 회전",
      "text": "몸이 위를 향하는지와 스키가 어느 쪽으로 기울었는지는 한 방향만으로 설명하기 어렵습니다.",
      "start": 149.0925,
      "end": 154.9425
    },
    {
      "index": 26,
      "scene_id": "05",
      "scene_title": "몸에 붙인 축과 공중 회전",
      "text": "쿼터니언은 그 전체 자세를 저장하는 한 방법입니다. 위치나 이동 속도까지 담는 네 숫자는 아닙니다.",
      "start": 154.9425,
      "end": 160.4425
    },
    {
      "index": 27,
      "scene_id": "05",
      "scene_title": "몸에 붙인 축과 공중 회전",
      "text": "화면으로 정확한 회전 축과 각도를 측정했다고 생각하지는 마세요. 다음 그림에서 정한 축과 각도로 직접 계산합니다.",
      "start": 160.4425,
      "end": 168.48250000000002
    },
    {
      "index": 28,
      "scene_id": "05",
      "scene_title": "몸에 붙인 축과 공중 회전",
      "text": "착지 전후의 자세와 이동 방향을 따로 보면서, 회전 표현이 무엇을 기록하는지 연결해 보세요.",
      "start": 168.48250000000002,
      "end": 173.96
    },
    {
      "index": 29,
      "scene_id": "06",
      "scene_title": "구십 도 회전을 두 번 합치면",
      "text": "제트축 구십 도 쿼터니언을 두 번 곱해 보겠습니다. 같은 회전을 두 번 적용하는 계산입니다.",
      "start": 174.41,
      "end": 180.5725
    },
    {
      "index": 30,
      "scene_id": "06",
      "scene_title": "구십 도 회전을 두 번 합치면",
      "text": "두 스칼라를 곱한 값에서 두 벡터의 내적을 빼면 새 스칼라가 됩니다. 여기서는 영입니다.",
      "start": 180.5725,
      "end": 186.8625
    },
    {
      "index": 31,
      "scene_id": "06",
      "scene_title": "구십 도 회전을 두 번 합치면",
      "text": "새 벡터의 제트 성분은 두 반각 성분의 곱을 더해 일이 됩니다. 나머지는 영입니다.",
      "start": 186.8625,
      "end": 192.39249999999998
    },
    {
      "index": 32,
      "scene_id": "06",
      "scene_title": "구십 도 회전을 두 번 합치면",
      "text": "결과는 영, 영, 영, 일입니다. 제트축 백팔십 도 회전을 나타내죠.",
      "start": 192.39249999999998,
      "end": 197.1525
    },
    {
      "index": 33,
      "scene_id": "06",
      "scene_title": "구십 도 회전을 두 번 합치면",
      "text": "두 번 더 곱하면 마이너스 일, 영, 영, 영이 됩니다. 물체의 최종 자세는 처음과 같습니다.",
      "start": 197.1525,
      "end": 204.0025
    },
    {
      "index": 34,
      "scene_id": "06",
      "scene_title": "구십 도 회전을 두 번 합치면",
      "text": "숫자는 일에서 마이너스 일로 바뀌었는데 자세는 같습니다. 이제 이 두 겹 표현의 의미를 살펴보겠습니다.",
      "start": 204.0025,
      "end": 210.65
    },
    {
      "index": 35,
      "scene_id": "07",
      "scene_title": "q와 -q는 같은 자세",
      "text": "단위 쿼터니언 큐와 마이너스 큐는 같은 회전 행렬과 같은 끝 자세를 나타냅니다.",
      "start": 211.1,
      "end": 215.9025
    },
    {
      "index": 36,
      "scene_id": "07",
      "scene_title": "q와 -q는 같은 자세",
      "text": "네 성분을 모두 뒤집는 것이 핵심입니다. 벡터 성분만 뒤집는 켤레와는 구분해야 합니다.",
      "start": 215.9025,
      "end": 223.2825
    },
    {
      "index": 37,
      "scene_id": "07",
      "scene_title": "q와 -q는 같은 자세",
      "text": "벡터를 돌리는 식에서는 양쪽 부호가 함께 바뀌어서 서로 상쇄됩니다.",
      "start": 223.2825,
      "end": 226.2525
    },
    {
      "index": 38,
      "scene_id": "07",
      "scene_title": "q와 -q는 같은 자세",
      "text": "따라서 자세가 같은지 확인할 때 성분이 완전히 같은지만 검사하면 안 됩니다.",
      "start": 226.2525,
      "end": 232.52249999999998
    },
    {
      "index": 39,
      "scene_id": "07",
      "scene_title": "q와 -q는 같은 자세",
      "text": "반대로 큐와 마이너스 큐가 같은 자세라는 사실은, 그 사이를 어떤 경로로 보간해도 같다는 뜻은 아닙니다.",
      "start": 232.52249999999998,
      "end": 239.67249999999999
    },
    {
      "index": 40,
      "scene_id": "07",
      "scene_title": "q와 -q는 같은 자세",
      "text": "끝 자세만으로는 몇 바퀴 돌았는지 알 수 없습니다. 회전 경로와 누적량은 따로 저장해야 합니다.",
      "start": 239.67249999999999,
      "end": 245.57999999999998
    },
    {
      "index": 41,
      "scene_id": "08",
      "scene_title": "같은 자세로 돌아와도 움직임은 남는다",
      "text": "스키가 공중에서 돌아가는 동안 몸의 앞쪽과 스키의 선을 따라가 보세요.",
      "start": 246.02999999999997,
      "end": 250.50249999999997
    },
    {
      "index": 42,
      "scene_id": "08",
      "scene_title": "같은 자세로 돌아와도 움직임은 남는다",
      "text": "어느 한 프레임의 자세만 보면, 그 전에 어떤 동작을 거쳤는지 모두 알 수는 없습니다.",
      "start": 250.50249999999997,
      "end": 256.2025
    },
    {
      "index": 43,
      "scene_id": "08",
      "scene_title": "같은 자세로 돌아와도 움직임은 남는다",
      "text": "이 장면처럼 시간의 흐름을 함께 보면 회전 과정이 보입니다. 끝 자세와 과정은 다른 정보입니다.",
      "start": 256.2025,
      "end": 262.0625
    },
    {
      "index": 44,
      "scene_id": "08",
      "scene_title": "같은 자세로 돌아와도 움직임은 남는다",
      "text": "쿼터니언의 부호 두 개가 같은 자세를 나타낸다는 설명도 이 구분과 연결됩니다.",
      "start": 262.0625,
      "end": 267.37249999999995
    },
    {
      "index": 45,
      "scene_id": "08",
      "scene_title": "같은 자세로 돌아와도 움직임은 남는다",
      "text": "화면에 보이는 회전 횟수를 쿼터니언 한 개가 그대로 기억한다고 생각하지 마세요.",
      "start": 267.37249999999995,
      "end": 272.6525
    },
    {
      "index": 46,
      "scene_id": "08",
      "scene_title": "같은 자세로 돌아와도 움직임은 남는다",
      "text": "트릭의 회전량을 기록해야 한다면, 자세 외에 입력이나 누적 회전 기록을 따로 관리해야 합니다.",
      "start": 272.6525,
      "end": 278.51
    },
    {
      "index": 47,
      "scene_id": "09",
      "scene_title": "항등원과 부호를 구분하기",
      "text": "쿼터니언 곱셈의 항등원은 일, 영, 영, 영입니다. 큐에 곱해도 큐가 그대로 남습니다.",
      "start": 278.96,
      "end": 285.6325
    },
    {
      "index": 48,
      "scene_id": "09",
      "scene_title": "항등원과 부호를 구분하기",
      "text": "마이너스 일, 영, 영, 영도 회전으로는 아무것도 바꾸지 않지만, 수의 곱셈 항등원은 아닙니다.",
      "start": 285.6325,
      "end": 291.4525
    },
    {
      "index": 49,
      "scene_id": "09",
      "scene_title": "항등원과 부호를 구분하기",
      "text": "이 값을 큐에 곱하면 마이너스 큐가 됩니다. 다른 숫자지만 같은 자세가 되죠.",
      "start": 291.4525,
      "end": 296.97249999999997
    },
    {
      "index": 50,
      "scene_id": "09",
      "scene_title": "항등원과 부호를 구분하기",
      "text": "코드에서 영, 영, 영, 영으로 초기화하면 회전 없는 쿼터니언이 아닙니다. 길이가 영인 잘못된 회전 입력입니다.",
      "start": 296.97249999999997,
      "end": 306.10249999999996
    },
    {
      "index": 51,
      "scene_id": "09",
      "scene_title": "항등원과 부호를 구분하기",
      "text": "처음 자세를 저장할 때는 라이브러리의 항등 회전 생성 기능이나, 올바른 성분 순서의 단위 값을 사용하세요.",
      "start": 306.10249999999996,
      "end": 314.8825
    },
    {
      "index": 52,
      "scene_id": "09",
      "scene_title": "항등원과 부호를 구분하기",
      "text": "수로서 같은지, 회전으로서 같은지 질문을 먼저 나누면 부호에 대한 혼동을 줄일 수 있습니다.",
      "start": 314.8825,
      "end": 321.03999999999996
    },
    {
      "index": 53,
      "scene_id": "10",
      "scene_title": "길이와 정규화의 조건",
      "text": "길이는 네 성분 제곱의 합에 루트를 씌워 구합니다. 벡터 세 성분만 재는 길이가 아닙니다.",
      "start": 321.48999999999995,
      "end": 326.95249999999993
    },
    {
      "index": 54,
      "scene_id": "10",
      "scene_title": "길이와 정규화의 조건",
      "text": "일반적인 회전 저장과 행렬 변환 함수는 길이 일인 쿼터니언을 입력으로 기대합니다.",
      "start": 326.95249999999993,
      "end": 332.63249999999994
    },
    {
      "index": 55,
      "scene_id": "10",
      "scene_title": "길이와 정규화의 조건",
      "text": "작은 부동소수점 오차로 길이가 벗어났다면 네 성분 모두를 그 길이로 나눠 정규화합니다.",
      "start": 332.63249999999994,
      "end": 337.28249999999997
    },
    {
      "index": 56,
      "scene_id": "10",
      "scene_title": "길이와 정규화의 조건",
      "text": "영에 가깝거나 유한하지 않은 길이는 나누기 전에 검사해야 합니다. 임의의 잘못된 입력을 정상 회전으로 꾸미지 마세요.",
      "start": 337.28249999999997,
      "end": 344.60249999999996
    },
    {
      "index": 57,
      "scene_id": "10",
      "scene_title": "길이와 정규화의 조건",
      "text": "영이 아닌 비단위 쿼터니언도 정확한 일반 역원을 쓰는 회전식에서는 크기가 상쇄됩니다. 단위 입력을 가정한 코드와는 구분합니다.",
      "start": 344.60249999999996,
      "end": 353.10249999999996
    },
    {
      "index": 58,
      "scene_id": "10",
      "scene_title": "길이와 정규화의 조건",
      "text": "정규화는 크기 약속을 맞춥니다. 회전 각도를 단순히 줄이거나, 잘못된 축과 곱셈 순서를 고치지는 않습니다.",
      "start": 353.10249999999996,
      "end": 360.28999999999996
    },
    {
      "index": 59,
      "scene_id": "11",
      "scene_title": "속도 변화와 자세 저장값",
      "text": "이제 스키 뒤에 다른 비행 장면도 연결해 보겠습니다. 움직임의 속도와 몸의 자세를 따로 보세요.",
      "start": 360.73999999999995,
      "end": 366.8425
    },
    {
      "index": 60,
      "scene_id": "11",
      "scene_title": "속도 변화와 자세 저장값",
      "text": "빨리 움직인다고 쿼터니언의 길이를 크게 만드는 것은 아닙니다. 단위 회전 값의 길이는 계속 일입니다.",
      "start": 366.8425,
      "end": 373.00249999999994
    },
    {
      "index": 61,
      "scene_id": "11",
      "scene_title": "속도 변화와 자세 저장값",
      "text": "속도와 가속도는 이동이나 회전 변화율에 관한 정보이고, 자세는 현재 상태입니다.",
      "start": 373.00249999999994,
      "end": 378.36249999999995
    },
    {
      "index": 62,
      "scene_id": "11",
      "scene_title": "속도 변화와 자세 저장값",
      "text": "날개가 기울어지는 동안 카메라도 따라갑니다. 화면의 크기 변화만으로 자세 값의 길이를 판단할 수는 없습니다.",
      "start": 378.36249999999995,
      "end": 385.26249999999993
    },
    {
      "index": 63,
      "scene_id": "11",
      "scene_title": "속도 변화와 자세 저장값",
      "text": "실제 값의 단위 길이 여부는 코드나 데이터에서 검사해야 합니다. 이 영상은 그 값을 측정한 자료가 아닙니다.",
      "start": 385.26249999999993,
      "end": 392.37249999999995
    },
    {
      "index": 64,
      "scene_id": "11",
      "scene_title": "속도 변화와 자세 저장값",
      "text": "움직임을 관찰한 뒤, 다음 그림에서는 저장한 회전을 어떻게 되돌리는지 계산하겠습니다.",
      "start": 392.37249999999995,
      "end": 398.17999999999995
    },
    {
      "index": 65,
      "scene_id": "12",
      "scene_title": "켤레로 단위 회전을 되돌리기",
      "text": "켤레는 스칼라를 그대로 두고, 벡터 세 성분의 부호를 바꾸는 연산입니다.",
      "start": 398.62999999999994,
      "end": 403.3924999999999
    },
    {
      "index": 66,
      "scene_id": "12",
      "scene_title": "켤레로 단위 회전을 되돌리기",
      "text": "길이가 일인 회전 쿼터니언에서는 켤레가 곧 역원입니다. 반대 회전을 적용해 되돌릴 수 있습니다.",
      "start": 403.3924999999999,
      "end": 409.66249999999997
    },
    {
      "index": 67,
      "scene_id": "12",
      "scene_title": "켤레로 단위 회전을 되돌리기",
      "text": "제트축 구십 도 값의 켤레는 더블유가 그대로이고 제트 성분만 음수가 됩니다. 제트축 마이너스 구십 도 회전입니다.",
      "start": 409.66249999999997,
      "end": 417.4124999999999
    },
    {
      "index": 68,
      "scene_id": "12",
      "scene_title": "켤레로 단위 회전을 되돌리기",
      "text": "원래 값과 켤레를 곱하면 일, 영, 영, 영으로 돌아옵니다.",
      "start": 417.4124999999999,
      "end": 420.81249999999994
    },
    {
      "index": 69,
      "scene_id": "12",
      "scene_title": "켤레로 단위 회전을 되돌리기",
      "text": "큐의 네 성분을 모두 바꾼 마이너스 큐는 같은 자세였죠. 켤레와 마이너스 큐를 혼동하면 역회전이 틀어집니다.",
      "start": 420.81249999999994,
      "end": 427.92249999999996
    },
    {
      "index": 70,
      "scene_id": "12",
      "scene_title": "켤레로 단위 회전을 되돌리기",
      "text": "반 바퀴처럼 역회전과 같은 끝 자세가 되는 특별한 경우도 있지만, 일반적으로 켤레와 전체 부호 반전은 다릅니다.",
      "start": 427.92249999999996,
      "end": 435.1100416666666
    },
    {
      "index": 71,
      "scene_id": "13",
      "scene_title": "일반 역원은 길이의 제곱으로 나눈다",
      "text": "길이가 일이 아니라면 역원은 켤레를 길이의 제곱으로 나눕니다. 길이 자체로 나누는 식이 아닙니다.",
      "start": 435.56004166666656,
      "end": 441.6625416666666
    },
    {
      "index": 72,
      "scene_id": "13",
      "scene_title": "일반 역원은 길이의 제곱으로 나눈다",
      "text": "예를 들어 이, 영, 영, 영의 길이는 이이고, 길이 제곱은 사입니다.",
      "start": 441.6625416666666,
      "end": 445.69254166666656
    },
    {
      "index": 73,
      "scene_id": "13",
      "scene_title": "일반 역원은 길이의 제곱으로 나눈다",
      "text": "켤레도 이, 영, 영, 영이므로 사로 나누면 역원은 영 점 오, 영, 영, 영입니다.",
      "start": 445.69254166666656,
      "end": 449.58254166666654
    },
    {
      "index": 74,
      "scene_id": "13",
      "scene_title": "일반 역원은 길이의 제곱으로 나눈다",
      "text": "둘을 곱하면 스칼라가 일이 됩니다. 길이 이로 나눠 버리면 스칼라가 이가 되어 역원이 아닙니다.",
      "start": 449.58254166666654,
      "end": 456.56254166666656
    },
    {
      "index": 75,
      "scene_id": "13",
      "scene_title": "일반 역원은 길이의 제곱으로 나눈다",
      "text": "단위 값에서는 길이 제곱이 일이어서 앞의 켤레 공식과 같아집니다.",
      "start": 456.56254166666656,
      "end": 460.25254166666656
    },
    {
      "index": 76,
      "scene_id": "13",
      "scene_title": "일반 역원은 길이의 제곱으로 나눈다",
      "text": "이 역원은 영이 아닌 쿼터니언에만 정의됩니다. 영이나 유한하지 않은 입력은 오류로 처리하고 출처를 확인하세요.",
      "start": 460.25254166666656,
      "end": 467.64004166666655
    },
    {
      "index": 77,
      "scene_id": "14",
      "scene_title": "반대 회전과 되돌리는 과정",
      "text": "눈길을 달리는 자전거가 기울어지는 방향과, 다시 자세를 잡는 방향을 보세요.",
      "start": 468.09004166666654,
      "end": 473.01254166666655
    },
    {
      "index": 78,
      "scene_id": "14",
      "scene_title": "반대 회전과 되돌리는 과정",
      "text": "왼쪽으로 기울었다가 돌아오는 변화는 반대 방향 회전을 떠올리는 데 도움이 됩니다.",
      "start": 473.01254166666655,
      "end": 477.3025416666665
    },
    {
      "index": 79,
      "scene_id": "14",
      "scene_title": "반대 회전과 되돌리는 과정",
      "text": "하지만 카메라가 움직이므로, 화면의 좌우만 보고 정확한 축이나 각도를 정할 수는 없습니다.",
      "start": 477.3025416666665,
      "end": 483.65254166666654
    },
    {
      "index": 80,
      "scene_id": "14",
      "scene_title": "반대 회전과 되돌리는 과정",
      "text": "역회전은 저장한 회전의 입력과 출력을 바꾸는 수학 연산입니다. 경로를 역주행하거나 속도를 음수로 만드는 것과 구분하세요.",
      "start": 483.65254166666654,
      "end": 491.32254166666655
    },
    {
      "index": 81,
      "scene_id": "14",
      "scene_title": "반대 회전과 되돌리는 과정",
      "text": "기울기와 이동 경로를 나누어 관찰하면, 회전을 되돌리는 것과 위치를 되돌리는 것이 다른 문제임을 볼 수 있습니다.",
      "start": 491.32254166666655,
      "end": 498.46254166666654
    },
    {
      "index": 82,
      "scene_id": "14",
      "scene_title": "반대 회전과 되돌리는 과정",
      "text": "다음에서는 두 회전을 곱할 때 생기는 순서와 기준 공간을 그림으로 확인하겠습니다.",
      "start": 498.46254166666654,
      "end": 503.53004166666653
    },
    {
      "index": 83,
      "scene_id": "15",
      "scene_title": "내적과 외적으로 곱셈 읽기",
      "text": "스칼라와 벡터를 묶어 두 쿼터니언을 곱하는 해밀턴 곱을 보겠습니다.",
      "start": 503.9800416666665,
      "end": 508.83254166666654
    },
    {
      "index": 84,
      "scene_id": "15",
      "scene_title": "내적과 외적으로 곱셈 읽기",
      "text": "새 스칼라는 두 스칼라의 곱에서 두 벡터의 내적을 뺀 값입니다.",
      "start": 508.83254166666654,
      "end": 513.6025416666665
    },
    {
      "index": 85,
      "scene_id": "15",
      "scene_title": "내적과 외적으로 곱셈 읽기",
      "text": "새 벡터는 첫 스칼라 곱하기 둘째 벡터, 둘째 스칼라 곱하기 첫 벡터, 두 벡터의 외적을 더한 값입니다.",
      "start": 513.6025416666665,
      "end": 519.2125416666665
    },
    {
      "index": 86,
      "scene_id": "15",
      "scene_title": "내적과 외적으로 곱셈 읽기",
      "text": "외적은 벡터 순서를 바꾸면 부호가 달라집니다. 쿼터니언 곱셈이 일반적으로 교환되지 않는 이유가 보입니다.",
      "start": 519.2125416666665,
      "end": 527.8625416666665
    },
    {
      "index": 87,
      "scene_id": "15",
      "scene_title": "내적과 외적으로 곱셈 읽기",
      "text": "곱셈을 세 번 할 때 괄호 위치는 바꿀 수 있습니다. 결합법칙과 교환법칙은 다른 조건입니다.",
      "start": 527.8625416666665,
      "end": 533.7725416666665
    },
    {
      "index": 88,
      "scene_id": "15",
      "scene_title": "내적과 외적으로 곱셈 읽기",
      "text": "같은 축의 회전처럼 서로 교환되는 경우도 있습니다. 항상 다르다고 외우지 말고 실제 연산과 규약을 확인하세요.",
      "start": 533.7725416666665,
      "end": 541.6600416666665
    },
    {
      "index": 89,
      "scene_id": "16",
      "scene_title": "적용 순서와 곱셈의 좌우",
      "text": "이 강의는 벡터를 큐, 벡터, 역큐 순서로 돌리는 해밀턴 곱 규약을 씁니다.",
      "start": 542.1100416666666,
      "end": 545.3925416666666
    },
    {
      "index": 90,
      "scene_id": "16",
      "scene_title": "적용 순서와 곱셈의 좌우",
      "text": "고정 엑스축 구십 도를 먼저, 고정 와이축 구십 도를 나중에 적용하면, 와이 회전 값이 왼쪽에 옵니다.",
      "start": 545.3925416666666,
      "end": 553.0225416666666
    },
    {
      "index": 91,
      "scene_id": "16",
      "scene_title": "적용 순서와 곱셈의 좌우",
      "text": "처음 제트 방향은 엑스 회전 뒤 마이너스 와이를 향합니다. 이어서 와이 회전해도 그 방향은 그대로입니다.",
      "start": 553.0225416666666,
      "end": 561.4525416666665
    },
    {
      "index": 92,
      "scene_id": "16",
      "scene_title": "적용 순서와 곱셈의 좌우",
      "text": "반대 순서에서는 제트 방향이 먼저 엑스를 향합니다. 엑스축 회전은 이 방향을 바꾸지 않습니다. 두 결과가 다르죠.",
      "start": 561.4525416666665,
      "end": 567.6925416666666
    },
    {
      "index": 93,
      "scene_id": "16",
      "scene_title": "적용 순서와 곱셈의 좌우",
      "text": "현재 자세에 월드 기준 델타 회전을 추가하면 왼쪽에 곱합니다. 몸체 기준 델타는 오른쪽에 곱합니다.",
      "start": 567.6925416666666,
      "end": 575.2325416666665
    },
    {
      "index": 94,
      "scene_id": "16",
      "scene_title": "적용 순서와 곱셈의 좌우",
      "text": "다른 라이브러리의 곱셈 함수가 같은 규약을 쓰는지 확인하세요. 작은 축 회전으로 직접 확인하면 순서 혼동을 줄일 수 있습니다.",
      "start": 575.2325416666665,
      "end": 583.2300416666666
    },
    {
      "index": 95,
      "scene_id": "17",
      "scene_title": "동작 순서와 기준을 관찰하기",
      "text": "스노보드가 뛰고 방향을 바꾸는 장면과 자전거의 기울기를 이어서 보겠습니다.",
      "start": 583.6800416666666,
      "end": 588.8225416666667
    },
    {
      "index": 96,
      "scene_id": "17",
      "scene_title": "동작 순서와 기준을 관찰하기",
      "text": "몸을 틀어 앞쪽 방향이 바뀌면, 그 몸을 기준으로 하는 다음 움직임도 다른 방향을 갖습니다.",
      "start": 588.8225416666667,
      "end": 594.7325416666666
    },
    {
      "index": 97,
      "scene_id": "17",
      "scene_title": "동작 순서와 기준을 관찰하기",
      "text": "어떤 변화가 먼저인지 시간 순서를 따라가 보세요. 끝 프레임만으로 중간 순서를 모두 복원할 수는 없습니다.",
      "start": 594.7325416666666,
      "end": 601.4625416666667
    },
    {
      "index": 98,
      "scene_id": "17",
      "scene_title": "동작 순서와 기준을 관찰하기",
      "text": "월드의 고정 축과 몸체의 움직이는 축을 구분하는 것이 곱셈 좌우를 정하는 출발점입니다.",
      "start": 601.4625416666667,
      "end": 607.6225416666666
    },
    {
      "index": 99,
      "scene_id": "17",
      "scene_title": "동작 순서와 기준을 관찰하기",
      "text": "카메라가 따라가는 화면만으로 내부의 정확한 회전 순서를 알 수는 없습니다. 다음 그림의 정의와 실제 관찰을 구분합니다.",
      "start": 607.6225416666666,
      "end": 615.0425416666666
    },
    {
      "index": 100,
      "scene_id": "17",
      "scene_title": "동작 순서와 기준을 관찰하기",
      "text": "몸의 앞쪽과 스키나 바퀴의 선을 함께 보면, 하나의 방향보다 전체 자세를 읽는 연습이 됩니다.",
      "start": 615.0425416666666,
      "end": 621.0400416666666
    },
    {
      "index": 101,
      "scene_id": "18",
      "scene_title": "두 자세 사이의 회전 차이",
      "text": "현재 자세를 에이, 목표 자세를 비라고 하겠습니다. 둘 모두 로컬에서 월드로 가는 회전을 저장합니다.",
      "start": 621.4900416666667,
      "end": 627.8125416666667
    },
    {
      "index": 102,
      "scene_id": "18",
      "scene_title": "두 자세 사이의 회전 차이",
      "text": "월드 기준 델타를 현재 값의 왼쪽에 곱해서 목표가 되어야 합니다. 그래서 델타는 비 곱하기 에이 역원입니다.",
      "start": 627.8125416666667,
      "end": 634.8425416666666
    },
    {
      "index": 103,
      "scene_id": "18",
      "scene_title": "두 자세 사이의 회전 차이",
      "text": "몸체 기준 델타를 오른쪽에 곱한다면, 에이 역원 곱하기 비입니다. 기준을 바꾸면 순서도 바뀝니다.",
      "start": 634.8425416666666,
      "end": 641.3825416666667
    },
    {
      "index": 104,
      "scene_id": "18",
      "scene_title": "두 자세 사이의 회전 차이",
      "text": "예를 들어 제트축 삼십 도에서 제트축 구십 도로 가는 차이는 같은 축의 육십 도입니다.",
      "start": 641.3825416666667,
      "end": 646.9425416666667
    },
    {
      "index": 105,
      "scene_id": "18",
      "scene_title": "두 자세 사이의 회전 차이",
      "text": "다른 축이 섞이면 성분을 뺄셈해서 구하지 않습니다. 켤레와 곱셈을 사용하고, 어느 공간의 차이인지 적습니다.",
      "start": 646.9425416666667,
      "end": 653.5025416666667
    },
    {
      "index": 106,
      "scene_id": "18",
      "scene_title": "두 자세 사이의 회전 차이",
      "text": "계산한 델타를 현재 자세에 다시 적용해 목표가 되는지 검사하세요. 입력과 출력의 연결이 검증 기준입니다.",
      "start": 653.5025416666667,
      "end": 660.6900416666667
    },
    {
      "index": 107,
      "scene_id": "19",
      "scene_title": "내적으로 최소 회전 각도 구하기",
      "text": "두 단위 쿼터니언의 내적은 네 성분의 곱을 모두 더합니다. 벡터 세 성분만 쓰는 내적이 아닙니다.",
      "start": 661.1400416666668,
      "end": 667.8525416666668
    },
    {
      "index": 108,
      "scene_id": "19",
      "scene_title": "내적으로 최소 회전 각도 구하기",
      "text": "부호를 고려해 가장 작은 상대 회전 각도를 구할 때는 내적의 절댓값을 씁니다.",
      "start": 667.8525416666668,
      "end": 673.5025416666667
    },
    {
      "index": 109,
      "scene_id": "19",
      "scene_title": "내적으로 최소 회전 각도 구하기",
      "text": "절댓값에 역코사인을 취한 뒤 두 배 하면 영부터 백팔십 도 사이의 최소 회전 각도가 됩니다.",
      "start": 673.5025416666667,
      "end": 679.4325416666668
    },
    {
      "index": 110,
      "scene_id": "19",
      "scene_title": "내적으로 최소 회전 각도 구하기",
      "text": "같은 자세인 큐와 마이너스 큐는 내적이 마이너스 일이지만, 절댓값은 일이라 최소 각도는 영입니다.",
      "start": 679.4325416666668,
      "end": 686.6225416666667
    },
    {
      "index": 111,
      "scene_id": "19",
      "scene_title": "내적으로 최소 회전 각도 구하기",
      "text": "단위 길이를 확인하고, 작은 계산 오차가 범위를 벗어나면 역코사인 전에 영과 일 사이로 제한합니다.",
      "start": 686.6225416666667,
      "end": 693.1525416666668
    },
    {
      "index": 112,
      "scene_id": "19",
      "scene_title": "내적으로 최소 회전 각도 구하기",
      "text": "이 각도는 끝 자세 사이의 최소 거리입니다. 트릭이 지나간 회전량이나 회전 방향의 기록을 대신하지 않습니다.",
      "start": 693.1525416666668,
      "end": 700.6200416666668
    },
    {
      "index": 113,
      "scene_id": "20",
      "scene_title": "목표 자세와 가까운 자세",
      "text": "보드와 자전거가 점프한 뒤 착지를 향해 자세를 바꾸는 모습을 보세요.",
      "start": 701.0700416666668,
      "end": 705.3225416666669
    },
    {
      "index": 114,
      "scene_id": "20",
      "scene_title": "목표 자세와 가까운 자세",
      "text": "어느 자세를 목표로 정하느냐에 따라 필요한 변화도 달라집니다.",
      "start": 705.3225416666669,
      "end": 709.1925416666668
    },
    {
      "index": 115,
      "scene_id": "20",
      "scene_title": "목표 자세와 가까운 자세",
      "text": "현재와 목표 자세의 차이는 회전을 비교하는 문제입니다. 목표까지 남은 위치 거리는 다른 계산입니다.",
      "start": 709.1925416666668,
      "end": 715.4825416666669
    },
    {
      "index": 116,
      "scene_id": "20",
      "scene_title": "목표 자세와 가까운 자세",
      "text": "화면에서 두 자세가 비슷해 보여도 정확한 각도는 회전 데이터로 계산해야 합니다.",
      "start": 715.4825416666669,
      "end": 721.4625416666669
    },
    {
      "index": 117,
      "scene_id": "20",
      "scene_title": "목표 자세와 가까운 자세",
      "text": "최소 각도는 현재에서 목표로 가장 가까이 가는 끝 자세 차이만 알려줍니다. 실제 동작의 길이 전체는 아닙니다.",
      "start": 721.4625416666669,
      "end": 727.6625416666668
    },
    {
      "index": 118,
      "scene_id": "20",
      "scene_title": "목표 자세와 가까운 자세",
      "text": "점프하는 순간에는 몸체가 향하는 쪽과 바퀴가 놓인 면을 함께 따라가 보세요. 착지할 위치와 착지할 자세를 나누어 생각하는 연습입니다.",
      "start": 727.6625416666668,
      "end": 736.0425416666668
    },
    {
      "index": 119,
      "scene_id": "20",
      "scene_title": "목표 자세와 가까운 자세",
      "text": "서로 다른 발췌 구간을 같은 점프의 처음과 끝으로 연결하지 않습니다. 각 구간 안의 움직임을 보고 현재 자세와 목표 자세를 비교할 질문을 찾습니다.",
      "start": 736.0425416666668,
      "end": 745.0925416666669
    },
    {
      "index": 120,
      "scene_id": "20",
      "scene_title": "목표 자세와 가까운 자세",
      "text": "끝 자세를 맞추는 역회전이나 상대 회전을 구했다고, 지나온 위치와 충돌까지 되돌아가지는 않습니다. 움직임의 경로와 회전의 끝 상태는 별도 기록입니다.",
      "start": 745.0925416666669,
      "end": 755.0225416666668
    },
    {
      "index": 121,
      "scene_id": "20",
      "scene_title": "목표 자세와 가까운 자세",
      "text": "회전값을 저장한 뒤 목표를 비교하는 상황을 떠올리고, 다음에서는 각도를 일부만 적용하는 방법을 살펴보겠습니다.",
      "start": 755.0225416666668,
      "end": 761.9500416666668
    },
    {
      "index": 122,
      "scene_id": "21",
      "scene_title": "회전의 일부를 적용하는 거듭제곱",
      "text": "선택한 축과 각도로 쿼터니언을 만들었다면, 같은 축을 두고 각도에 배율을 곱해 일부 회전을 만들 수 있습니다.",
      "start": 762.4000416666669,
      "end": 769.8625416666669
    },
    {
      "index": 123,
      "scene_id": "21",
      "scene_title": "회전의 일부를 적용하는 거듭제곱",
      "text": "제트축 구십 도의 절반은 제트축 사십오 도입니다. 네 성분 전체를 영 점 오로 곱하는 계산은 아닙니다.",
      "start": 769.8625416666669,
      "end": 776.6325416666668
    },
    {
      "index": 124,
      "scene_id": "21",
      "scene_title": "회전의 일부를 적용하는 거듭제곱",
      "text": "로그를 쓰면 순수 벡터 부분에 축 곱하기 반각을 기록하고, 지수로 다시 단위 쿼터니언을 만들 수 있습니다.",
      "start": 776.6325416666668,
      "end": 783.8025416666669
    },
    {
      "index": 125,
      "scene_id": "21",
      "scene_title": "회전의 일부를 적용하는 거듭제곱",
      "text": "이때 라디안과 반각을 구분하세요. 앞 편의 회전벡터는 전체 각도이고, 여기 로그의 크기는 그 절반입니다.",
      "start": 783.8025416666669,
      "end": 791.0025416666668
    },
    {
      "index": 126,
      "scene_id": "21",
      "scene_title": "회전의 일부를 적용하는 거듭제곱",
      "text": "거듭제곱의 경로는 선택한 부호와 각도의 가지에 의존합니다. 같은 끝 자세라도 큐와 마이너스 큐의 분수 거듭제곱은 다를 수 있습니다.",
      "start": 791.0025416666668,
      "end": 799.5525416666669
    },
    {
      "index": 127,
      "scene_id": "21",
      "scene_title": "회전의 일부를 적용하는 거듭제곱",
      "text": "가장 짧은 경로를 원한다면 대표 부호와 경계 규칙을 먼저 정하세요. 항등 회전이나 반 바퀴의 모호함도 명시적으로 처리합니다.",
      "start": 799.5525416666669,
      "end": 807.8400416666668
    },
    {
      "index": 128,
      "scene_id": "22",
      "scene_title": "벡터는 왜 양쪽에서 곱할까?",
      "text": "복소평면에서는 각도의 코사인과 아이 곱하기 사인을 곱해 이차원 벡터를 돌릴 수 있습니다.",
      "start": 808.2900416666669,
      "end": 814.2425416666669
    },
    {
      "index": 129,
      "scene_id": "22",
      "scene_title": "벡터는 왜 양쪽에서 곱할까?",
      "text": "삼차원에서 벡터를 스칼라 영인 순수 쿼터니언으로 넣고 한쪽에서만 곱하면, 일반적으로 스칼라가 생겨 벡터 회전이 아닙니다.",
      "start": 814.2425416666669,
      "end": 822.3925416666668
    },
    {
      "index": 130,
      "scene_id": "22",
      "scene_title": "벡터는 왜 양쪽에서 곱할까?",
      "text": "예를 들어 일, 영, 일 벡터에 제트축 구십 도 값을 왼쪽에서만 곱하면, 스칼라가 마이너스 루트 이 나누기 이가 됩니다.",
      "start": 822.3925416666668,
      "end": 829.6125416666669
    },
    {
      "index": 131,
      "scene_id": "22",
      "scene_title": "벡터는 왜 양쪽에서 곱할까?",
      "text": "오른쪽에 역원을 함께 곱하면 스칼라는 영으로 돌아오고, 벡터는 영, 일, 일이 됩니다.",
      "start": 829.6125416666669,
      "end": 834.1925416666669
    },
    {
      "index": 132,
      "scene_id": "22",
      "scene_title": "벡터는 왜 양쪽에서 곱할까?",
      "text": "회전 축에 평행한 제트 성분은 남고, 엑스 성분이 와이 방향으로 돌아간 결과입니다.",
      "start": 834.1925416666669,
      "end": 840.3025416666669
    },
    {
      "index": 133,
      "scene_id": "22",
      "scene_title": "벡터는 왜 양쪽에서 곱할까?",
      "text": "양쪽에 곱하는 구조에서 반각 두 개가 실제 각도를 만듭니다. 먼저 한 방향 벡터로 계산해 보면 공식을 외우기보다 의미가 보입니다.",
      "start": 840.3025416666669,
      "end": 848.1300416666669
    },
    {
      "index": 134,
      "scene_id": "23",
      "scene_title": "카메라와 몸체가 함께 움직일 때",
      "text": "자전거가 공중에서 돌고 착지하는 모습을 마지막으로 관찰해 보겠습니다.",
      "start": 848.580041666667,
      "end": 853.212541666667
    },
    {
      "index": 135,
      "scene_id": "23",
      "scene_title": "카메라와 몸체가 함께 움직일 때",
      "text": "몸체의 앞쪽과 바퀴의 선이 같이 바뀝니다. 카메라는 그 움직임을 화면으로 보여주는 다른 기준입니다.",
      "start": 853.212541666667,
      "end": 859.4125416666669
    },
    {
      "index": 136,
      "scene_id": "23",
      "scene_title": "카메라와 몸체가 함께 움직일 때",
      "text": "화면에서 잘 보이게 만드는 문제와 실제 월드에서 자세를 계산하는 문제를 구분하세요.",
      "start": 859.4125416666669,
      "end": 864.502541666667
    },
    {
      "index": 137,
      "scene_id": "23",
      "scene_title": "카메라와 몸체가 함께 움직일 때",
      "text": "쿼터니언으로 자세를 저장했다면, 필요한 방향 벡터를 돌려 앞쪽이나 위쪽을 구할 수 있습니다.",
      "start": 864.502541666667,
      "end": 870.5625416666669
    },
    {
      "index": 138,
      "scene_id": "23",
      "scene_title": "카메라와 몸체가 함께 움직일 때",
      "text": "게임 화면에서 어떤 저장 구조를 썼는지는 알 수 없지만, 우리가 만든 수학 예제에서는 계산을 직접 검증할 수 있습니다.",
      "start": 870.5625416666669,
      "end": 877.7725416666669
    },
    {
      "index": 139,
      "scene_id": "23",
      "scene_title": "카메라와 몸체가 함께 움직일 때",
      "text": "이제 성분 순서와 단위 길이를 다시 확인하고, 같은 계산을 연습문제로 풀어보겠습니다.",
      "start": 877.7725416666669,
      "end": 883.060041666667
    },
    {
      "index": 140,
      "scene_id": "24",
      "scene_title": "코드에서 확인할 약속",
      "text": "쿼터니언 네 성분을 삼십이 비트 실수로 저장하면 성분 데이터는 십육 바이트입니다. 정렬이나 부가 정보는 제외한 수치입니다.",
      "start": 883.510041666667,
      "end": 891.2625416666671
    },
    {
      "index": 141,
      "scene_id": "24",
      "scene_title": "코드에서 확인할 약속",
      "text": "세 각보다 숫자는 하나 많지만, 순서가 있는 회전 합성과 보간에 편리합니다. 모든 용도에서 무조건 빠르다는 뜻은 아닙니다.",
      "start": 891.2625416666671,
      "end": 898.772541666667
    },
    {
      "index": 142,
      "scene_id": "24",
      "scene_title": "코드에서 확인할 약속",
      "text": "사람이 각도를 편집할 때는 오일러 각이 편할 수 있고, 방향을 여러 개 바꿀 때는 행렬을 미리 만들 수도 있습니다.",
      "start": 898.772541666667,
      "end": 905.532541666667
    },
    {
      "index": 143,
      "scene_id": "24",
      "scene_title": "코드에서 확인할 약속",
      "text": "엑스, 와이, 제트, 더블유 저장 순서와 해밀턴 곱, 축 손잡이, 로컬에서 월드로 가는 약속을 함께 확인합니다.",
      "start": 905.532541666667,
      "end": 912.432541666667
    },
    {
      "index": 144,
      "scene_id": "24",
      "scene_title": "코드에서 확인할 약속",
      "text": "정규화와 입력 오류 검사를 유지하고, 값이 같은지와 자세가 같은지를 구분하세요.",
      "start": 912.432541666667,
      "end": 917.1425416666671
    },
    {
      "index": 145,
      "scene_id": "24",
      "scene_title": "코드에서 확인할 약속",
      "text": "쿼터니언은 회전의 표현입니다. 충돌이나 위치 이동, 누적 회전 이력까지 자동으로 해결하는 기능은 아닙니다.",
      "start": 917.1425416666671,
      "end": 923.270041666667
    },
    {
      "index": 146,
      "scene_id": "25",
      "scene_title": "직접 돌리고 되돌려 보기",
      "text": "첫 문제입니다. 제트축 구십 도로 벡터를 돌립니다. 엑스는 일, 와이는 영, 제트는 일인 벡터입니다. 어떤 값이 될까요? 잠깐 멈추고 축과 부호를 확인하세요.",
      "start": 923.720041666667,
      "end": 935.1425416666671
    },
    {
      "index": 147,
      "scene_id": "25",
      "scene_title": "직접 돌리고 되돌려 보기",
      "text": "쿼터니언은 루트 이 나누기 이, 영, 영, 루트 이 나누기 이입니다. 순수 벡터를 양쪽 곱셈에 넣습니다.",
      "start": 935.1425416666671,
      "end": 942.782541666667
    },
    {
      "index": 148,
      "scene_id": "25",
      "scene_title": "직접 돌리고 되돌려 보기",
      "text": "엑스가 와이로 가고 제트는 남으므로, 답은 영, 일, 일입니다. 길이 루트 이는 보존됩니다.",
      "start": 942.782541666667,
      "end": 949.052541666667
    },
    {
      "index": 149,
      "scene_id": "25",
      "scene_title": "직접 돌리고 되돌려 보기",
      "text": "둘째 문제입니다. 이 결과를 원래 벡터로 되돌리려면 네 성분을 모두 뒤집어야 할까요?",
      "start": 949.052541666667,
      "end": 955.432541666667
    },
    {
      "index": 150,
      "scene_id": "25",
      "scene_title": "직접 돌리고 되돌려 보기",
      "text": "아닙니다. 단위 값의 켤레, 즉 벡터 부분만 뒤집은 역원을 씁니다. 결과는 다시 일, 영, 일입니다.",
      "start": 955.432541666667,
      "end": 962.1325416666671
    },
    {
      "index": 151,
      "scene_id": "25",
      "scene_title": "직접 돌리고 되돌려 보기",
      "text": "마지막으로 현재 자세와 목표 자세의 차이를 구할 때는, 월드 델타가 왼쪽에 오는지 몸체 델타가 오른쪽에 오는지 먼저 정해 보세요.",
      "start": 962.1325416666671,
      "end": 972.0800416666671
    },
    {
      "index": 152,
      "scene_id": "26",
      "scene_title": "네 숫자에서 회전 연산까지",
      "text": "쿼터니언은 단위 축과 반각에서 만드는 네 숫자이며, 단위 조건 아래 회전의 자유도는 세 개입니다.",
      "start": 972.5300416666671,
      "end": 979.2225416666671
    },
    {
      "index": 153,
      "scene_id": "26",
      "scene_title": "네 숫자에서 회전 연산까지",
      "text": "큐와 마이너스 큐는 같은 자세지만, 켤레는 역회전을 구하는 다른 연산입니다. 일반 역원은 길이의 제곱으로 나눕니다.",
      "start": 979.2225416666671,
      "end": 987.1325416666671
    },
    {
      "index": 154,
      "scene_id": "26",
      "scene_title": "네 숫자에서 회전 연산까지",
      "text": "회전 합성과 차이는 곱셈의 순서와 기준 공간을 적고, 계산한 결과를 다시 적용해 확인하세요.",
      "start": 987.1325416666671,
      "end": 993.6225416666671
    },
    {
      "index": 155,
      "scene_id": "26",
      "scene_title": "네 숫자에서 회전 연산까지",
      "text": "다음 편에서는 두 자세 사이를 부드럽게 보간하고, 행렬과 오일러 각 등 다른 표현으로 안전하게 변환하겠습니다.",
      "start": 993.6225416666671,
      "end": 1000.9300416666671
    }
  ]
}
