  "entries": [
    {
      "index": 1,
      "scene_id": "01",
      "scene_title": "거리와 두 각도로 3D 위치 표현하기",
      "text": "평면에서는 거리와 각도로 점을 찍었습니다. 삼차원에서는 높이까지 바뀌는 위치와 카메라를 어떻게 표현할까요?",
      "start": 0.0,
      "end": 7.4,
      "voice_start": 0.0,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 2,
      "scene_id": "01",
      "scene_title": "거리와 두 각도로 3D 위치 표현하기",
      "text": "이번 이편에서는 높이를 더하는 원통좌표와 두 각도를 사용하는 구면좌표를 배워 보겠습니다.",
      "start": 7.76,
      "end": 13.42,
      "voice_start": 7.76,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 3,
      "scene_id": "01",
      "scene_title": "거리와 두 각도로 3D 위치 표현하기",
      "text": "실제 게임의 높이와 시점을 관찰하고, 좌표 변환을 거쳐 카메라 위치를 계산하겠습니다.",
      "start": 13.72,
      "end": 19.16,
      "voice_start": 13.72,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 4,
      "scene_id": "01",
      "scene_title": "거리와 두 각도로 3D 위치 표현하기",
      "text": "마지막에는 축의 약속과 방향이 정해지지 않는 경계에서 무엇을 주의해야 하는지도 정리합니다.",
      "start": 19.5,
      "end": 25.18,
      "voice_start": 19.5,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 5,
      "scene_id": "02",
      "scene_title": "실제 관찰 · 높이와 시점의 변화",
      "text": "디센더스에서 자전거가 달리고 점프하는 장면입니다. 바닥을 따라 어디로 가는지와 공중에 얼마나 떠 있는지를 나누어 보세요.",
      "start": 25.65,
      "end": 33.41,
      "voice_start": 25.65,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 6,
      "scene_id": "02",
      "scene_title": "실제 관찰 · 높이와 시점의 변화",
      "text": "평면 위의 두 좌표만으로는 점프 높이를 구분하기 어렵습니다. 삼차원에서는 위아래 정보를 하나 더 써야 하죠.",
      "start": 33.629999999999995,
      "end": 40.269999999999996,
      "voice_start": 33.629999999999995,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 7,
      "scene_id": "02",
      "scene_title": "실제 관찰 · 높이와 시점의 변화",
      "text": "또 자전거의 위치와 이 장면을 보는 카메라의 위치는 서로 다릅니다. 카메라는 조금 떨어진 곳에서 움직이는 대상을 따라갑니다.",
      "start": 40.65,
      "end": 48.11,
      "voice_start": 40.65,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 8,
      "scene_id": "02",
      "scene_title": "실제 관찰 · 높이와 시점의 변화",
      "text": "우리는 이 두 가지를 원통좌표와 구면좌표로 설명해 볼 겁니다. 게임의 내부 카메라 구현을 확인한 자료는 아닙니다.",
      "start": 48.37,
      "end": 54.73,
      "voice_start": 48.37,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 9,
      "scene_id": "02",
      "scene_title": "실제 관찰 · 높이와 시점의 변화",
      "text": "공식부터 외우기보다 바닥에서의 거리, 높이, 보는 방향이 각각 무엇인지 먼저 구분해 주세요.",
      "start": 54.73,
      "end": 60.25,
      "voice_start": 54.73,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 10,
      "scene_id": "02",
      "scene_title": "실제 관찰 · 높이와 시점의 변화",
      "text": "착지하기 전후도 비교해 보세요. 공중에 떠 있는 동안에도 바닥에서 앞으로 가는 이동은 이어집니다. 수평 이동과 높이 변화를 따로 읽으면 됩니다.",
      "start": 60.43,
      "end": 67.85,
      "voice_start": 60.43,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 11,
      "scene_id": "02",
      "scene_title": "실제 관찰 · 높이와 시점의 변화",
      "text": "대상이 화면 가운데에 남더라도 세계에서 멈춘 것은 아닙니다. 대상과 카메라가 함께 움직이며 상대 관계를 유지할 수도 있습니다. 그래서 두 위치를 따로 생각해야 하죠.",
      "start": 68.15,
      "end": 76.85,
      "voice_start": 68.15,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 12,
      "scene_id": "03",
      "scene_title": "원통좌표는 평면 극좌표에 높이를 더합니다",
      "text": "먼저 원통좌표입니다. 이 수학 그림에서는 가로와 세로가 바닥이고, 지 축이 높이입니다. 축 이름을 화면에서 확인하세요.",
      "start": 77.38000000000001,
      "end": 86.36000000000001,
      "voice_start": 77.38000000000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 13,
      "scene_id": "03",
      "scene_title": "원통좌표는 평면 극좌표에 높이를 더합니다",
      "text": "바닥에 있는 점을 거리 알과 각도 세타로 찍은 뒤, 높이만큼 위로 올립니다. 그래서 좌표가 거리, 각도, 높이 세 값이 됩니다.",
      "start": 86.56,
      "end": 94.82000000000001,
      "voice_start": 86.56,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 14,
      "scene_id": "03",
      "scene_title": "원통좌표는 평면 극좌표에 높이를 더합니다",
      "text": "여기서 알은 원점에서 그 점까지의 전체 거리가 아닙니다. 바닥으로 내려서 잰 수평 거리입니다. 높이가 커져도 알은 그대로일 수 있어요.",
      "start": 95.10000000000001,
      "end": 103.34,
      "voice_start": 95.10000000000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 15,
      "scene_id": "03",
      "scene_title": "원통좌표는 평면 극좌표에 높이를 더합니다",
      "text": "수평 거리를 고정하고 각도와 높이를 바꾸면 원통 표면이 됩니다. 왜 원통좌표라고 부르는지 보이죠.",
      "start": 103.48000000000002,
      "end": 109.76000000000002,
      "voice_start": 103.48000000000002,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 16,
      "scene_id": "03",
      "scene_title": "원통좌표는 평면 극좌표에 높이를 더합니다",
      "text": "각도를 고정하고 음수가 아닌 거리와 높이를 바꾸면 수직 반평면이 됩니다. 거리에 음수까지 허용하면 반대쪽도 포함하는 평면이 됩니다.",
      "start": 110.02000000000001,
      "end": 119.04,
      "voice_start": 110.02000000000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 17,
      "scene_id": "04",
      "scene_title": "원통좌표 변환은 2D 공식을 그대로 씁니다",
      "text": "원통좌표를 직교좌표로 바꾸는 방법은 간단합니다. 바닥의 가로 세로 값은 일편에서 배운 코사인과 사인 공식을 그대로 씁니다.",
      "start": 119.75000000000001,
      "end": 128.25,
      "voice_start": 119.75000000000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 18,
      "scene_id": "04",
      "scene_title": "원통좌표 변환은 2D 공식을 그대로 씁니다",
      "text": "높이는 바꾸지 않고 세 번째 좌표로 옮깁니다. 거리 오, 각도 영 도, 높이 삼이면 직교좌표는 오, 영, 삼입니다.",
      "start": 128.59,
      "end": 136.95000000000002,
      "voice_start": 128.59,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 19,
      "scene_id": "04",
      "scene_title": "원통좌표 변환은 2D 공식을 그대로 씁니다",
      "text": "이 점의 원점으로부터 전체 거리는 오가 아닙니다. 수평 거리 오와 높이 삼으로 삼각형을 만들면 루트 삼십사, 약 오 점 팔삼입니다.",
      "start": 137.55,
      "end": 145.99,
      "voice_start": 137.55,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 20,
      "scene_id": "04",
      "scene_title": "원통좌표 변환은 2D 공식을 그대로 씁니다",
      "text": "다시 돌아갈 때는 가로 세로 값의 하이폿으로 수평 거리를, 에이탄 투로 바닥의 방향을 구합니다. 높이는 그대로입니다.",
      "start": 145.99,
      "end": 153.79000000000002,
      "voice_start": 145.99,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 21,
      "scene_id": "04",
      "scene_title": "원통좌표 변환은 2D 공식을 그대로 씁니다",
      "text": "바닥에서의 위치가 영이면 각도는 정해지지 않습니다. 높이가 있더라도 수평 방향은 별도 규칙으로 처리해야 합니다.",
      "start": 153.79000000000002,
      "end": 160.95000000000002,
      "voice_start": 153.79000000000002,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 22,
      "scene_id": "05",
      "scene_title": "실제 관찰 · 수평 이동과 점프를 구분하기",
      "text": "경사로와 점프 구간을 보세요. 자전거는 트랙을 따라 앞으로 가면서 위아래로도 움직입니다.",
      "start": 161.48000000000002,
      "end": 167.24,
      "voice_start": 161.48000000000002,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 23,
      "scene_id": "05",
      "scene_title": "실제 관찰 · 수평 이동과 점프를 구분하기",
      "text": "이 움직임을 설명할 때, 바닥에 내려서 본 위치와 높이를 분리할 수 있습니다. 이것이 원통좌표를 떠올리는 출발점입니다.",
      "start": 167.62,
      "end": 175.84000000000003,
      "voice_start": 167.62,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 24,
      "scene_id": "05",
      "scene_title": "실제 관찰 · 수평 이동과 점프를 구분하기",
      "text": "높이만 달라졌다고 수평 거리가 반드시 달라지는 것은 아닙니다. 반대로 바닥에서 움직여도 높이는 같을 수 있죠.",
      "start": 175.84000000000003,
      "end": 183.10000000000002,
      "voice_start": 175.84000000000003,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 25,
      "scene_id": "05",
      "scene_title": "실제 관찰 · 수평 이동과 점프를 구분하기",
      "text": "물론 실제 지형은 평평한 바닥이 아닙니다. 여기서는 먼저 정한 좌표 평면에 투영해서 말하는 것이고, 지면까지의 거리와 세계 좌표의 높이는 다를 수 있습니다.",
      "start": 183.10000000000002,
      "end": 193.26000000000002,
      "voice_start": 183.10000000000002,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 26,
      "scene_id": "05",
      "scene_title": "실제 관찰 · 수평 이동과 점프를 구분하기",
      "text": "무엇을 높이의 기준으로 정했는지까지 생각해야 수학의 값과 화면의 행동을 정확히 연결할 수 있습니다.",
      "start": 193.52,
      "end": 199.86,
      "voice_start": 193.52,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 27,
      "scene_id": "06",
      "scene_title": "구면좌표는 거리와 두 각도를 사용합니다",
      "text": "이번에는 원점에서 점까지의 전체 거리와 두 각도를 쓰겠습니다. 이것이 구면좌표입니다. 먼저 수학에서 흔히 쓰는 한 가지 약속을 보죠.",
      "start": 200.33,
      "end": 209.41000000000003,
      "voice_start": 200.33,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 28,
      "scene_id": "06",
      "scene_title": "구면좌표는 거리와 두 각도를 사용합니다",
      "text": "지 축을 위로 두고, 세타는 바닥에서 오른쪽을 기준으로 돌린 각도입니다. 파이는 위쪽 지 축에서 얼마나 내려왔는지를 나타내는 각도입니다.",
      "start": 209.69,
      "end": 218.95000000000002,
      "voice_start": 209.69,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 29,
      "scene_id": "06",
      "scene_title": "구면좌표는 거리와 두 각도를 사용합니다",
      "text": "그래서 파이가 영 도면 맨 위, 구십 도면 수평, 백팔십 도면 맨 아래입니다. 이름이 비슷한 다른 각도와 기준을 섞지 마세요.",
      "start": 219.05,
      "end": 228.01000000000002,
      "voice_start": 219.05,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 30,
      "scene_id": "06",
      "scene_title": "구면좌표는 거리와 두 각도를 사용합니다",
      "text": "수평으로 내려서 잰 거리는 전체 거리 곱하기 사인 파이이고, 높이는 전체 거리 곱하기 코사인 파이입니다.",
      "start": 228.01000000000002,
      "end": 234.75,
      "voice_start": 228.01000000000002,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 31,
      "scene_id": "06",
      "scene_title": "구면좌표는 거리와 두 각도를 사용합니다",
      "text": "수평 거리에 다시 코사인 세타와 사인 세타를 곱하면 가로와 세로 좌표가 됩니다. 전체 거리를 고정하면 점들이 구 표면에 놓입니다.",
      "start": 235.07000000000002,
      "end": 242.49,
      "voice_start": 235.07000000000002,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 32,
      "scene_id": "06",
      "scene_title": "구면좌표는 거리와 두 각도를 사용합니다",
      "text": "이 수학 약속에서 돌아올 때는 세타를 세로와 가로의 에이탄 투로 구합니다. 파이는 수평 길이와 높이를 에이탄 투에 넣어 구할 수 있습니다. 원점과 극점의 방향 처리도 필요합니다.",
      "start": 242.91000000000003,
      "end": 253.95000000000002,
      "voice_start": 242.91000000000003,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 33,
      "scene_id": "06",
      "scene_title": "구면좌표는 거리와 두 각도를 사용합니다",
      "text": "지구의 위도처럼 수평을 기준으로 잰 각도는 구십 도에서 파이를 뺀 값입니다. 또 전체 반지름과 지표면 위의 고도는 다릅니다. 기준 구의 반지름을 빼야 고도가 됩니다.",
      "start": 254.05,
      "end": 265.03000000000003,
      "voice_start": 254.05,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 34,
      "scene_id": "07",
      "scene_title": "게임 각도는 축의 약속부터 확인합니다",
      "text": "게임에서 방향을 설명할 때는 헤딩과 피치라는 이름을 자주 만납니다. 하지만 모든 엔진이 같은 축과 부호를 쓰는 것은 아닙니다.",
      "start": 265.5,
      "end": 273.34,
      "voice_start": 265.5,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 35,
      "scene_id": "07",
      "scene_title": "게임 각도는 축의 약속부터 확인합니다",
      "text": "이 책의 게임 약속에서는 가로 축이 오른쪽, 와이 축이 위쪽, 지 축이 앞쪽입니다. 헤딩 영 도는 앞을 보고, 양의 헤딩은 오른쪽으로 돕니다.",
      "start": 273.58,
      "end": 282.9,
      "voice_start": 273.58,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 36,
      "scene_id": "07",
      "scene_title": "게임 각도는 축의 약속부터 확인합니다",
      "text": "피치 영 도는 수평이고, 양의 피치는 아래로 내려가는 방향입니다. 위로 보는 피치는 음수입니다. 이 부호를 화면에 계속 표시하겠습니다.",
