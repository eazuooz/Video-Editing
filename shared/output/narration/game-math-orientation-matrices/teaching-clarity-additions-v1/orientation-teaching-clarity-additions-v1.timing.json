  "narration_placement": "continuous-across-example-and-explanation",
  "entries": [
    {
      "index": 1,
      "scene_id": "02a",
      "scene_title": "비행에서 무엇을 관찰할까",
      "text": "슈퍼플라이트는 장애물 사이를 날아가는 게임입니다.",
      "start": 0.0,
      "end": 3.3025
    },
    {
      "index": 2,
      "scene_id": "02a",
      "scene_title": "비행에서 무엇을 관찰할까",
      "text": "지금은 점수보다 캐릭터를 보세요.",
      "start": 3.3025,
      "end": 5.5925
    },
    {
      "index": 3,
      "scene_id": "02a",
      "scene_title": "비행에서 무엇을 관찰할까",
      "text": "몸통에 표시한 관찰점이 화면에서 어디로 움직이는지, 몸이 어떻게 기울어지는지 따로 보겠습니다.",
      "start": 5.5925,
      "end": 11.7825
    },
    {
      "index": 4,
      "scene_id": "02a",
      "scene_title": "비행에서 무엇을 관찰할까",
      "text": "빨간 이동선은 화면에서 관찰한 변화를 나타내며, 게임 내부의 좌표값은 아닙니다.",
      "start": 11.7825,
      "end": 17.200041666666667
    },
    {
      "index": 5,
      "scene_id": "06a",
      "scene_title": "몸의 자를 바깥 기준으로 읽기",
      "text": "몸에 붙인 자와 방에 고정한 자가 있다고 생각해 보세요.",
      "start": 17.650041666666667,
      "end": 21.242541666666668
    },
    {
      "index": 6,
      "scene_id": "06a",
      "scene_title": "몸의 자를 바깥 기준으로 읽기",
      "text": "같은 화살표도 어떤 자로 읽느냐에 따라 숫자가 달라집니다.",
      "start": 21.242541666666668,
      "end": 25.412541666666666
    },
    {
      "index": 7,
      "scene_id": "06a",
      "scene_title": "몸의 자를 바깥 기준으로 읽기",
      "text": "회전 행렬은 몸의 세 자가 방의 기준에서 어느 쪽을 향하는지 적어 둔 표입니다.",
      "start": 25.412541666666666,
      "end": 30.290041666666667
    },
    {
      "index": 8,
      "scene_id": "09a",
      "scene_title": "축 방향의 몫과 전치",
      "text": "앞에서는 몸 기준의 숫자를 바깥 기준으로 옮겼습니다.",
      "start": 30.740041666666666,
      "end": 34.262541666666664
    },
    {
      "index": 9,
      "scene_id": "09a",
      "scene_title": "축 방향의 몫과 전치",
      "text": "이번에는 바깥 화살표를 몸의 각 축에서 얼마나 차지하는지 읽습니다.",
      "start": 34.262541666666664,
      "end": 39.13254166666667
    },
    {
      "index": 10,
      "scene_id": "09a",
      "scene_title": "축 방향의 몫과 전치",
      "text": "그 몫을 읽는 계산이 내적입니다.",
      "start": 39.13254166666667,
      "end": 41.05254166666667
    },
    {
      "index": 11,
      "scene_id": "09a",
      "scene_title": "축 방향의 몫과 전치",
      "text": "전치는 이 계산에 필요한 행과 열의 자리를 서로 바꿉니다.",
      "start": 41.05254166666667,
      "end": 44.82004166666667
    },
    {
      "index": 12,
      "scene_id": "13a",
      "scene_title": "길이와 직각부터 검사하기",
      "text": "축을 숫자로 적었다고 모두 회전 행렬은 아닙니다.",
      "start": 45.27004166666667,
      "end": 48.52254166666667
    },
    {
      "index": 13,
      "scene_id": "13a",
      "scene_title": "길이와 직각부터 검사하기",
      "text": "자가 늘어나거나 서로 비스듬해지면 물체도 찌그러집니다.",
      "start": 48.52254166666667,
      "end": 52.64254166666667
    },
    {
      "index": 14,
      "scene_id": "13a",
      "scene_title": "길이와 직각부터 검사하기",
      "text": "그래서 축 길이, 축 사이 직각, 오른손 방향을 순서대로 확인합니다.",
      "start": 52.64254166666667,
      "end": 56.922541666666675
    },
    {
      "index": 15,
      "scene_id": "13a",
      "scene_title": "길이와 직각부터 검사하기",
      "text": "곧 나올 식은 이 세 검사를 짧게 적은 것입니다.",
      "start": 56.922541666666675,
      "end": 60.150041666666674
    },
    {
      "index": 16,
      "scene_id": "16a",
      "scene_title": "평행한 조각을 빼는 교정",
      "text": "살짝 기울어진 두 번째 자에서 첫 번째 자와 나란한 조각을 빼면 수직인 부분만 남습니다.",
      "start": 60.60004166666668,
      "end": 66.43254166666668
    },
    {
      "index": 17,
      "scene_id": "16a",
      "scene_title": "평행한 조각을 빼는 교정",
      "text": "남은 자의 길이를 다시 일로 맞춥니다.",
      "start": 66.43254166666668,
      "end": 69.14254166666667
    },
    {
      "index": 18,
      "scene_id": "16a",
      "scene_title": "평행한 조각을 빼는 교정",
      "text": "이것이 다음 교정 계산의 핵심입니다.",
      "start": 69.14254166666667,
      "end": 71.73254166666668
    },
    {
      "index": 19,
      "scene_id": "16a",
      "scene_title": "평행한 조각을 빼는 교정",
      "text": "다만 자가 사라지거나 처음부터 평행하면 별도 처리가 필요합니다.",
      "start": 71.73254166666668,
      "end": 75.96004166666668
    },
    {
      "index": 20,
      "scene_id": "21a",
      "scene_title": "중간 자세도 같은 검사로 확인",
      "text": "시작 자세와 목표 자세를 안다고 중간 자세가 자동으로 안전해지는 것은 아닙니다.",
      "start": 76.41004166666669,
      "end": 81.69254166666668
    },
    {
      "index": 21,
      "scene_id": "21a",
      "scene_title": "중간 자세도 같은 검사로 확인",
      "text": "두 행렬의 숫자를 절반씩 섞어 보면, 앞서 지켜야 했던 축 길이가 사라질 수도 있습니다.",
      "start": 81.69254166666668,
      "end": 87.34254166666669
    },
    {
      "index": 22,
      "scene_id": "21a",
      "scene_title": "중간 자세도 같은 검사로 확인",
      "text": "같은 길이 검사로 그 문제를 확인해 보겠습니다.",
      "start": 87.34254166666669,
      "end": 90.33004166666669
    }
  ]
}
