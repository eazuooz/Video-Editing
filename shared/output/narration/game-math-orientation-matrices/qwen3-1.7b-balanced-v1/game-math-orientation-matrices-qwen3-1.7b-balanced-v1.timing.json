      "end": 395.2200416666666,
      "voice_start": 387.88004166666656,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 77,
      "scene_id": "14",
      "scene_title": "회전과 늘어나 보이는 모습을 구분",
      "text": "캐릭터가 가까워졌다가 멀어지면 화면에서 크기가 달라집니다.",
      "start": 395.81004166666656,
      "end": 399.93004166666657,
      "voice_start": 395.81004166666656,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 78,
      "scene_id": "14",
      "scene_title": "회전과 늘어나 보이는 모습을 구분",
      "text": "이 변화만 보고 회전 행렬에 크기 변환이 들어 있다고 단정할 수는 없습니다.",
      "start": 400.1700416666666,
      "end": 404.27004166666654,
