      "end": 376.96004166666654,
      "voice_start": 373.1600416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 74,
      "scene_id": "13",
      "scene_title": "회전 행렬인지 확인하는 두 조건",
      "text": "하지만 이 조건만으로는 반사도 통과합니다. 행렬식이 플러스 일이어야 순수한 3D 회전입니다.",
      "start": 377.20004166666655,
      "end": 383.3000416666666,
      "voice_start": 377.20004166666655,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 75,
      "scene_id": "13",
      "scene_title": "회전 행렬인지 확인하는 두 조건",
      "text": "따라서 정규직교 조건과 행렬식 플러스 일을 함께 검사해야 합니다.",
      "start": 383.52004166666654,
      "end": 387.68004166666657,
