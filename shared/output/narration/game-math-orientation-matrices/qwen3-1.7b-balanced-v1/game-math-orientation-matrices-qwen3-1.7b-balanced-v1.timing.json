      "end": 228.40999999999997,
      "voice_start": 224.26999999999995,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 46,
      "scene_id": "08",
      "scene_title": "로컬의 앞과 월드의 방향",
      "text": "지금은 이동 속도나 충돌보다 방향을 표현하는 기준에 집중하세요.",
      "start": 228.66999999999996,
      "end": 232.24999999999994,
