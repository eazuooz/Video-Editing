  "narration_placement": "continuous-across-example-and-explanation",
  "entries": [
    {
      "index": 1,
      "scene_id": "01",
      "scene_title": "이번 강의에서 배울 것",
      "text": "같은 방향을 보는데 몸이 기울어지는 이유는 무엇일까요?",
      "start": 0.0,
      "end": 3.48,
      "voice_start": 0.0,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 2,
      "scene_id": "01",
      "scene_title": "이번 강의에서 배울 것",
      "text": "이번 시간에는 게임 속 비행을 보며 방향과 자세를 구분합니다.",
      "start": 3.92,
      "end": 7.9,
      "voice_start": 3.92,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 3,
      "scene_id": "01",
      "scene_title": "이번 강의에서 배울 것",
      "text": "세 좌표축으로 회전 행렬을 만들고, 로컬 좌표를 월드 좌표로 바꿔 봅니다.",
      "start": 7.992000000000001,
      "end": 13.44,
      "voice_start": 7.992000000000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 4,
      "scene_id": "01",
      "scene_title": "이번 강의에서 배울 것",
      "text": "마지막으로 역변환과 잘못된 회전을 검사하고, 두 문제를 직접 풀며 부호와 계산 순서까지 확인하겠습니다.",
      "start": 13.78,
      "end": 20.14,
      "voice_start": 13.78,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 5,
      "scene_id": "02",
      "scene_title": "비행을 볼 때 두 가지를 나누세요",
      "text": "슈퍼플라이트에서 캐릭터가 건물 사이를 날아갑니다.",
      "start": 20.61,
      "end": 23.71,
      "voice_start": 20.61,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 6,
      "scene_id": "02",
      "scene_title": "비행을 볼 때 두 가지를 나누세요",
      "text": "먼저 몸이 있는 위치와 몸이 향하는 방향을 따로 보세요.",
      "start": 24.15,
      "end": 27.05,
      "voice_start": 24.15,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 7,
      "scene_id": "02",
      "scene_title": "비행을 볼 때 두 가지를 나누세요",
      "text": "위치는 계속 달라지고, 장애물을 지나며 몸의 기울기도 바뀝니다.",
      "start": 27.55,
      "end": 31.61,
      "voice_start": 27.55,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 8,
      "scene_id": "02",
      "scene_title": "비행을 볼 때 두 가지를 나누세요",
      "text": "어느 쪽을 향하는지만 알아서는 팔이 얼마나 기울었는지 알 수 없습니다.",
      "start": 31.990000000000002,
      "end": 35.91,
      "voice_start": 31.990000000000002,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 9,
      "scene_id": "02",
      "scene_title": "비행을 볼 때 두 가지를 나누세요",
      "text": "앞으로 뻗은 화살표 하나와 몸 전체의 자세는 정보량이 다릅니다.",
      "start": 36.21,
      "end": 40.230000000000004,
      "voice_start": 36.21,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 10,
      "scene_id": "02",
      "scene_title": "비행을 볼 때 두 가지를 나누세요",
      "text": "이 차이를 단순한 좌표축으로 옮겨 보겠습니다.",
      "start": 40.69,
      "end": 43.01,
      "voice_start": 40.69,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 11,
      "scene_id": "03",
      "scene_title": "방향은 화살표, 자세는 몸 전체",
      "text": "방향벡터는 어느 쪽을 가리키는 화살표입니다. 화살표의 길이 방향으로 비틀어도 방향은 같습니다.",
      "start": 43.78,
      "end": 50.54,
      "voice_start": 43.78,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 12,
      "scene_id": "03",
      "scene_title": "방향은 화살표, 자세는 몸 전체",
      "text": "하지만 날개가 있는 물체를 같은 축으로 비틀면 날개가 기울어집니다. 자세가 달라진 것이죠.",
      "start": 50.86,
      "end": 56.980000000000004,
      "voice_start": 50.86,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 13,
      "scene_id": "03",
      "scene_title": "방향은 화살표, 자세는 몸 전체",
      "text": "따라서 앞쪽 방향이 같아도 위쪽 방향이 다른 두 자세가 있을 수 있습니다.",
      "start": 57.3,
      "end": 61.96,
      "voice_start": 57.3,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 14,
      "scene_id": "03",
      "scene_title": "방향은 화살표, 자세는 몸 전체",
      "text": "3D 단위 방향은 보통 두 각도로 표현할 수 있지만, 자세는 회전 자유도가 세 개입니다.",
      "start": 62.24,
      "end": 68.02,
      "voice_start": 62.24,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 15,
      "scene_id": "03",
      "scene_title": "방향은 화살표, 자세는 몸 전체",
      "text": "여기서 자세는 현재 상태이고, 각변위는 한 자세에서 다른 자세로 가는 변화입니다.",
      "start": 68.22,
      "end": 73.58,
      "voice_start": 68.22,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 16,
      "scene_id": "03",
      "scene_title": "방향은 화살표, 자세는 몸 전체",
      "text": "둘 다 어떤 기준 자세와 좌표계를 기준으로 말하는지 정해야 합니다.",
      "start": 73.78,
      "end": 77.75999999999999,
      "voice_start": 73.78,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 17,
      "scene_id": "04",
      "scene_title": "물체에 붙어 있는 세 좌표축",
      "text": "물체에 작은 좌표축 세 개를 붙여 보겠습니다. 이것이 로컬 좌표계입니다.",
      "start": 78.23,
      "end": 83.13000000000001,
      "voice_start": 78.23,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 18,
      "scene_id": "04",
      "scene_title": "물체에 붙어 있는 세 좌표축",
      "text": "빨강은 엑스, 초록은 와이, 파랑은 제트축입니다. 엑스와 와이의 외적이 제트가 되는 오른손 규칙을 따릅니다.",
      "start": 83.23,
      "end": 90.73,
      "voice_start": 83.23,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 19,
      "scene_id": "04",
      "scene_title": "물체에 붙어 있는 세 좌표축",
      "text": "세 축은 서로 수직이고 길이가 일인 단위벡터입니다.",
      "start": 90.85000000000001,
      "end": 94.11,
      "voice_start": 90.85000000000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 20,
      "scene_id": "04",
      "scene_title": "물체에 붙어 있는 세 좌표축",
      "text": "물체가 회전하면 축도 함께 돌아갑니다. 하지만 물체 자체에서 본 축의 좌표는 그대로입니다.",
      "start": 94.33000000000001,
      "end": 100.05000000000001,
      "voice_start": 94.33000000000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 21,
      "scene_id": "04",
      "scene_title": "물체에 붙어 있는 세 좌표축",
      "text": "자세를 알려면 이 로컬 축들이 월드 좌표계에서 어디를 향하는지 기록해야 합니다.",
      "start": 100.25,
      "end": 105.13,
      "voice_start": 100.25,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 22,
      "scene_id": "04",
      "scene_title": "물체에 붙어 있는 세 좌표축",
      "text": "좌표축의 이름과 몸에 붙인 방향은 약속입니다. 프로젝트의 약속부터 확인하세요.",
      "start": 105.13,
      "end": 110.57000000000001,
      "voice_start": 105.13,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 23,
      "scene_id": "05",
      "scene_title": "몸의 위와 화면의 위",
      "text": "다시 비행 장면을 보세요. 캐릭터의 몸과 주변 건물은 함께 보입니다.",
      "start": 111.32000000000001,
      "end": 115.62,
      "voice_start": 111.32000000000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 24,
      "scene_id": "05",
      "scene_title": "몸의 위와 화면의 위",
      "text": "화면 위쪽을 언제나 캐릭터의 위쪽이라고 생각하면 헷갈리기 쉽습니다.",
      "start": 115.88000000000001,
      "end": 120.04,
      "voice_start": 115.88000000000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 25,
      "scene_id": "05",
      "scene_title": "몸의 위와 화면의 위",
      "text": "몸이 기울어져도 카메라가 보여 주는 화면의 위는 별도의 기준입니다.",
      "start": 120.30000000000001,
      "end": 124.30000000000001,
      "voice_start": 120.30000000000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 26,
      "scene_id": "05",
      "scene_title": "몸의 위와 화면의 위",
      "text": "건물의 모서리, 몸통, 양팔을 비교하며 각각의 기준을 구분해 보세요.",
      "start": 124.5,
      "end": 129.32,
      "voice_start": 124.5,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 27,
      "scene_id": "05",
      "scene_title": "몸의 위와 화면의 위",
      "text": "우리가 계산할 것은 물체 축을 월드 기준으로 표현하는 관계입니다.",
      "start": 129.58,
      "end": 133.26000000000002,
      "voice_start": 129.58,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 28,
      "scene_id": "05",
      "scene_title": "몸의 위와 화면의 위",
      "text": "이 영상만 보고 게임 내부의 정확한 회전 구현을 단정하지는 않습니다.",
      "start": 133.56,
      "end": 137.94,
      "voice_start": 133.56,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 29,
      "scene_id": "06",
      "scene_title": "열벡터와 변환 방향을 먼저 고정",
      "text": "이번 계산에서는 벡터를 세로로 놓고, 행렬을 왼쪽에서 곱합니다. 열벡터 약속입니다.",
      "start": 138.41,
      "end": 143.89,
      "voice_start": 138.41,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 30,
      "scene_id": "06",
      "scene_title": "열벡터와 변환 방향을 먼저 고정",
      "text": "회전 행렬 알은 로컬 벡터를 월드 벡터로 바꾸는 행렬로 정하겠습니다.",
      "start": 144.09,
      "end": 148.79,
      "voice_start": 144.09,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 31,
      "scene_id": "06",
      "scene_title": "열벡터와 변환 방향을 먼저 고정",
      "text": "첫 열에는 월드에서 본 로컬 엑스축, 둘째 열에는 와이축, 셋째 열에는 제트축을 넣습니다.",
      "start": 149.10999999999999,
      "end": 154.87,
      "voice_start": 149.10999999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 32,
      "scene_id": "06",
      "scene_title": "열벡터와 변환 방향을 먼저 고정",
      "text": "책은 왼손 좌표계와 행벡터 약속을 씁니다. 우리는 축과 회전 부호도 함께 확인해야 합니다.",
      "start": 154.93,
      "end": 160.59,
      "voice_start": 154.93,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 33,
      "scene_id": "06",
      "scene_title": "열벡터와 변환 방향을 먼저 고정",
      "text": "같은 변환을 나타내려면 행벡터 행렬과 열벡터 행렬은 서로 전치 관계가 됩니다.",
      "start": 160.81,
      "end": 165.53,
      "voice_start": 160.81,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 34,
      "scene_id": "06",
      "scene_title": "열벡터와 변환 방향을 먼저 고정",
      "text": "그림이 이상하다고 무작정 전치하지 말고, 입력 공간과 출력 공간부터 적으세요.",
      "start": 165.53,
      "end": 170.29,
      "voice_start": 165.53,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 35,
      "scene_id": "07",
      "scene_title": "90도 회전을 숫자로 계산",
      "text": "제트축을 중심으로 양의 구십 도를 회전시켜 봅시다. 오른손 엄지가 양의 제트를 가리킬 때 손가락이 감기는 방향입니다.",
      "start": 170.77999999999997,
      "end": 179.25999999999996,
      "voice_start": 170.77999999999997,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 36,
      "scene_id": "07",
      "scene_title": "90도 회전을 숫자로 계산",
      "text": "로컬 엑스축은 월드 와이축으로 갑니다. 그래서 첫 열은 영, 일, 영입니다.",
      "start": 179.49999999999997,
      "end": 184.87999999999997,
      "voice_start": 179.49999999999997,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 37,
      "scene_id": "07",
      "scene_title": "90도 회전을 숫자로 계산",
      "text": "로컬 와이축은 월드 엑스의 음의 방향으로 갑니다. 둘째 열은 마이너스 일, 영, 영입니다.",
      "start": 185.09999999999997,
      "end": 191.23999999999998,
      "voice_start": 185.09999999999997,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 38,
      "scene_id": "07",
      "scene_title": "90도 회전을 숫자로 계산",
      "text": "제트축은 그대로이므로 셋째 열은 영, 영, 일입니다.",
      "start": 191.51999999999998,
      "end": 195.29999999999998,
      "voice_start": 191.51999999999998,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 39,
      "scene_id": "07",
      "scene_title": "90도 회전을 숫자로 계산",
      "text": "로컬 벡터 이, 일, 영을 곱하면, 엑스축 두 배와 와이축 한 배를 더합니다.",
      "start": 195.47999999999996,
      "end": 200.75999999999996,
      "voice_start": 195.47999999999996,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 40,
      "scene_id": "07",
      "scene_title": "90도 회전을 숫자로 계산",
      "text": "결과는 월드 좌표 마이너스 일, 이, 영입니다. 숫자 곱셈은 축들의 가중합인 셈입니다.",
      "start": 200.77999999999997,
      "end": 206.91999999999996,
      "voice_start": 200.77999999999997,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 41,
      "scene_id": "08",
      "scene_title": "로컬의 앞과 월드의 방향",
      "text": "캐릭터가 건물 옆을 돌며 날아가는 모습을 보세요.",
      "start": 207.38999999999996,
      "end": 210.60999999999996,
      "voice_start": 207.38999999999996,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 42,
      "scene_id": "08",
      "scene_title": "로컬의 앞과 월드의 방향",
      "text": "몸에 붙은 앞쪽 방향은 몸이 돌아갈 때 같이 돌아갑니다.",
      "start": 210.94999999999996,
      "end": 214.24999999999997,
      "voice_start": 210.94999999999996,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 43,
      "scene_id": "08",
      "scene_title": "로컬의 앞과 월드의 방향",
      "text": "반대로 월드에서 정한 한 방향은 물체 자세가 바뀌어도 기준으로 남습니다.",
      "start": 214.44999999999996,
      "end": 218.64999999999995,
      "voice_start": 214.44999999999996,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 44,
      "scene_id": "08",
      "scene_title": "로컬의 앞과 월드의 방향",
      "text": "물체의 앞쪽으로 이동시키는 것과 월드의 한 축으로 이동시키는 것은 다른 명령입니다.",
