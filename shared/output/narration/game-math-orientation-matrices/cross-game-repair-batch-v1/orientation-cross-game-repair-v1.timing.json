  "entries": [
    {
      "index": 1,
      "scene_id": "01b",
      "scene_title": "새 비교 예시의 순서",
      "text": "비행과 자전거의 자세를 비교한 뒤, 조립 비행기와 부품 배치에 같은 기준을 적용하겠습니다.",
      "start": 0.0,
      "end": 6.0
    },
    {
      "index": 2,
      "scene_id": "03b",
      "scene_title": "자전거에서도 위치와 자세를 나눕니다",
      "text": "방향과 자세의 차이는 자전거에서도 보입니다.",
      "start": 6.45,
      "end": 9.4725
    },
    {
      "index": 3,
      "scene_id": "03b",
      "scene_title": "자전거에서도 위치와 자세를 나눕니다",
      "text": "디센더스는 산길을 달리고 점프하는 자전거 게임입니다.",
      "start": 9.4725,
      "end": 13.1725
    },
    {
      "index": 4,
      "scene_id": "03b",
      "scene_title": "자전거에서도 위치와 자세를 나눕니다",
      "text": "먼저 굽은 길에서 이동하는 위치와 기울어진 자전거를 나누어 보세요.",
      "start": 13.1725,
      "end": 17.4525
    },
    {
      "index": 5,
      "scene_id": "03b",
      "scene_title": "자전거에서도 위치와 자세를 나눕니다",
      "text": "다음 점프에서는 바퀴가 위로 뒤집혔다가 착지 전에 다시 아래로 돌아옵니다.",
      "start": 17.4525,
      "end": 22.7425
    },
    {
      "index": 6,
      "scene_id": "03b",
      "scene_title": "자전거에서도 위치와 자세를 나눕니다",
      "text": "이동 방향만으로 이 뒤집힘을 표현할 수 없으니, 자전거의 앞과 위를 함께 기록해야 합니다.",
      "start": 22.7425,
      "end": 28.61
    },
    {
      "index": 7,
      "scene_id": "07b",
      "scene_title": "앞과 날개를 함께 읽는 비행 자세",
      "text": "이제 트레일메이커스의 조립 비행기로 축의 의미를 확인하겠습니다.",
      "start": 29.06,
      "end": 33.4825
    },
    {
      "index": 8,
      "scene_id": "07b",
      "scene_title": "앞과 날개를 함께 읽는 비행 자세",
      "text": "이 게임은 부품으로 만든 탈것을 직접 움직입니다.",
      "start": 33.4825,
      "end": 36.6325
    },
    {
      "index": 9,
      "scene_id": "07b",
      "scene_title": "앞과 날개를 함께 읽는 비행 자세",
      "text": "활주로를 떠난 뒤 날개가 기울고, 다음 시점에서는 거의 수평으로 돌아옵니다.",
      "start": 36.6325,
      "end": 41.4825
    },
    {
      "index": 10,
      "scene_id": "07b",
      "scene_title": "앞과 날개를 함께 읽는 비행 자세",
      "text": "붉은 선은 기체의 앞, 파란 선은 날개 양쪽을 잇는 방향입니다.",
      "start": 41.4825,
      "end": 45.772499999999994
    },
    {
      "index": 11,
      "scene_id": "07b",
      "scene_title": "앞과 날개를 함께 읽는 비행 자세",
      "text": "두 선을 함께 보면 앞쪽 방향만 볼 때 놓친 기울기를 구분할 수 있습니다.",
      "start": 45.772499999999994,
      "end": 49.792500000000004
    },
    {
      "index": 12,
      "scene_id": "07b",
      "scene_title": "앞과 날개를 함께 읽는 비행 자세",
      "text": "카메라도 움직이므로 화면의 선은 관찰 표시이며, 앞의 구십 도 계산은 따로 정한 수학 예입니다.",
      "start": 49.792500000000004,
      "end": 55.78
    },
    {
      "index": 13,
      "scene_id": "10b",
      "scene_title": "비행 자세에서 부품 배치 자세로",
      "text": "날아가는 물체의 자세를 기록했다면, 배치할 부품의 자세도 같은 방식으로 생각할 수 있습니다.",
      "start": 56.230000000000004,
      "end": 62.4425
    },
    {
      "index": 14,
      "scene_id": "10b",
      "scene_title": "비행 자세에서 부품 배치 자세로",
      "text": "스페이스 엔지니어스에서는 부품을 조립해 우주선을 만듭니다.",
      "start": 62.4425,
      "end": 66.94250000000001
    },
    {
      "index": 15,
      "scene_id": "10b",
      "scene_title": "비행 자세에서 부품 배치 자세로",
      "text": "초록 상자 속 흐릿한 부품은 아직 놓기 전의 미리보기입니다.",
      "start": 66.94250000000001,
      "end": 70.83250000000001
    },
    {
      "index": 16,
      "scene_id": "10b",
      "scene_title": "비행 자세에서 부품 배치 자세로",
      "text": "작은 부품을 세로와 가로로 돌려 보는 장면과, 골라 놓은 자세로 실제 부품을 배치하는 장면을 비교하세요.",
      "start": 70.83250000000001,
      "end": 77.66250000000001
    },
    {
      "index": 17,
      "scene_id": "10b",
      "scene_title": "비행 자세에서 부품 배치 자세로",
      "text": "크기 선택이 바뀌는 장면은 회전과 구분합니다.",
      "start": 77.66250000000001,
      "end": 80.9525
    },
    {
      "index": 18,
      "scene_id": "10b",
      "scene_title": "비행 자세에서 부품 배치 자세로",
      "text": "비행 중인 기체와 달리 배치 자세를 고르는 상황이지만, 물체의 축을 같은 기준에서 기록한다는 원리는 같습니다.",
      "start": 80.9525,
      "end": 87.91
    },
    {
      "index": 19,
      "scene_id": "21r",
      "scene_title": "21a 첫 원문 보정 후보",
      "text": "시작 자세와 목표 자세를 안다고 중간 자세가 자동으로 안전해지는 것은 아닙니다.",
      "start": 88.36,
      "end": 93.72
    }
  ]
