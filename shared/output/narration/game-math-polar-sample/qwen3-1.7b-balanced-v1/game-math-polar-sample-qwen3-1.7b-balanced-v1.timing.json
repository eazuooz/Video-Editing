  "entries": [
    {
      "index": 1,
      "scene_id": "01",
      "scene_title": "거리와 각도로 위치를 말해 볼까요?",
      "text": "게임에서 총알이 퍼지거나, 물체가 중심 주위를 돌 때는 위치를 어떻게 표현하면 편할까요?",
      "start": 0.0,
      "end": 6.18,
      "voice_start": 0.0,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 2,
      "scene_id": "01",
      "scene_title": "거리와 각도로 위치를 말해 볼까요?",
      "text": "이번에는 거리와 각도로 위치를 나타내는 극좌표계를 배워 보겠습니다.",
      "start": 6.56,
      "end": 10.88,
      "voice_start": 6.56,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 3,
      "scene_id": "01",
      "scene_title": "거리와 각도로 위치를 말해 볼까요?",
      "text": "실제 게임의 움직임을 먼저 보고, 점을 찍는 방법과 가로 세로 좌표로 바꾸는 방법을 차례로 살펴보죠.",
      "start": 11.18,
      "end": 17.66,
      "voice_start": 11.18,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 4,
      "scene_id": "01",
      "scene_title": "거리와 각도로 위치를 말해 볼까요?",
      "text": "먼저, 총알 하나의 방향과 거리를 함께 떠올려 보세요.",
      "start": 18.0,
      "end": 21.5,
      "voice_start": 18.0,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 5,
      "scene_id": "02",
      "scene_title": "실제 사례 · 총알의 위치",
      "text": "엔터 더 건전의 전투 화면입니다. 캐릭터가 총을 돌리면 총알이 날아가는 방향도 달라지죠.",
      "start": 21.97,
      "end": 27.83,
      "voice_start": 21.97,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 6,
      "scene_id": "02",
      "scene_title": "실제 사례 · 총알의 위치",
      "text": "총알 하나를 골라서, 발사된 곳에서 어느 방향으로 얼마나 멀리 갔는지 생각해 보세요.",
      "start": 28.029999999999998,
      "end": 32.91,
      "voice_start": 28.029999999999998,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 7,
      "scene_id": "02",
      "scene_title": "실제 사례 · 총알의 위치",
      "text": "오른쪽으로 몇 칸, 위로 몇 칸이라고 말할 수도 있지만, 방향과 거리로 말해도 위치를 알 수 있습니다.",
      "start": 33.25,
      "end": 39.55,
      "voice_start": 33.25,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 8,
      "scene_id": "03",
      "scene_title": "한번 돌고, 앞으로 이동하기",
      "text": "원점에서 오른쪽을 바라본다고 해 보죠. 여기서 반시계 방향으로 각도를 돌리고, 그 방향으로 이동합니다.",
      "start": 40.02,
      "end": 45.78,
      "voice_start": 40.02,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 9,
      "scene_id": "03",
      "scene_title": "한번 돌고, 앞으로 이동하기",
      "text": "오른쪽으로 네 칸, 위로 세 칸에 있는 점은, 거리 다섯과 각도 약 삼십칠 도로 나타낼 수 있어요.",
      "start": 46.36,
      "end": 51.92,
      "voice_start": 46.36,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 10,
      "scene_id": "03",
      "scene_title": "한번 돌고, 앞으로 이동하기",
      "text": "이때 거리를 알, 각도를 세타라고 부릅니다. 같은 점을 설명하는 방식만 바뀐 겁니다.",
      "start": 52.22,
      "end": 57.14,
      "voice_start": 52.22,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 11,
      "scene_id": "03",
      "scene_title": "한번 돌고, 앞으로 이동하기",
      "text": "거리는 그대로 두고 각도만 바꾸면, 점은 중심 주위를 원으로 돌겠죠.",
      "start": 57.64,
      "end": 61.400000000000006,
      "voice_start": 57.64,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 12,
      "scene_id": "04",
      "scene_title": "실제 사례 · 퍼지는 탄막",
      "text": "이번에는 보스가 쏘는 붉은 총알들을 보세요. 여러 방향으로 퍼지면서 발사 지점에서 점점 멀어집니다.",
      "start": 61.99000000000001,
      "end": 68.81,
      "voice_start": 61.99000000000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 13,
      "scene_id": "04",
      "scene_title": "실제 사례 · 퍼지는 탄막",
      "text": "이런 움직임을 설계할 때, 각 총알의 방향을 정한 뒤 거리를 늘린다고 생각하면 이해하기 쉽습니다.",
      "start": 69.11000000000001,
      "end": 74.89000000000001,
      "voice_start": 69.11000000000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 14,
      "scene_id": "04",
      "scene_title": "실제 사례 · 퍼지는 탄막",
      "text": "방향의 차이가 퍼지는 모양을, 거리가 얼마나 빨리 늘어나는지가 날아가는 속도를 정하는 거죠.",
      "start": 75.15,
      "end": 80.29,
      "voice_start": 75.15,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 15,
      "scene_id": "05",
      "scene_title": "거리와 각도를 x, y로 바꾸기",
      "text": "그럼 화면에 그릴 때 필요한 가로 세로 좌표는 어떻게 구할까요?",
      "start": 80.76,
      "end": 84.68,
      "voice_start": 80.76,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 16,
      "scene_id": "05",
      "scene_title": "거리와 각도를 x, y로 바꾸기",
      "text": "이 직각삼각형에서 빗변은 거리 다섯이고, 가로 길이는 네, 세로 길이는 셋입니다.",
      "start": 84.98,
      "end": 91.04,
      "voice_start": 84.98,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 17,
      "scene_id": "05",
      "scene_title": "거리와 각도를 x, y로 바꾸기",
      "text": "코사인은 가로 길이를 빗변으로 나눈 값, 사인은 세로 길이를 빗변으로 나눈 값이죠.",
      "start": 91.36,
      "end": 96.72,
      "voice_start": 91.36,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 18,
      "scene_id": "05",
      "scene_title": "거리와 각도를 x, y로 바꾸기",
      "text": "양쪽에 거리를 곱하면, 가로는 거리 곱하기 코사인, 세로는 거리 곱하기 사인이 됩니다.",
      "start": 96.98,
      "end": 102.22,
      "voice_start": 96.98,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 19,
      "scene_id": "05",
      "scene_title": "거리와 각도를 x, y로 바꾸기",
      "text": "각도 단위는 서로 다릅니다. 도 단위와 라디안 단위를 구분해서 사용하세요.",
      "start": 102.42,
      "end": 107.06,
      "voice_start": 102.42,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 20,
      "scene_id": "06",
      "scene_title": "실제 사례 · 움직이는 중심",
      "text": "다시 전투를 보면, 발사하는 캐릭터 자체도 움직입니다. 중심이 항상 화면의 원점에 있는 건 아니죠.",
      "start": 107.53000000000002,
      "end": 114.17000000000002,
      "voice_start": 107.53000000000002,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 21,
      "scene_id": "06",
      "scene_title": "실제 사례 · 움직이는 중심",
      "text": "방금 구한 가로 세로 길이는 중심에서부터의 차이입니다. 여기에 발사 지점의 좌표를 더하면 됩니다.",
      "start": 114.59000000000002,
      "end": 120.55000000000001,
      "voice_start": 114.59000000000002,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 22,
      "scene_id": "06",
      "scene_title": "실제 사례 · 움직이는 중심",
      "text": "게임의 실제 구현을 단정하는 건 아니고, 화면 속 움직임을 우리가 배운 좌표로 설명해 보는 겁니다.",
      "start": 121.03000000000002,
      "end": 126.45000000000002,
      "voice_start": 121.03000000000002,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 23,
      "scene_id": "07",
      "scene_title": "3D로 확장하고 핵심 정리",
      "text": "평면에서 거리를 유지하며 각도를 바꾸는 모습입니다. 여기에 높이를 더하면 원통좌표로 확장할 수 있어요.",
      "start": 127.10000000000002,
      "end": 133.50000000000003,
      "voice_start": 127.10000000000002,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 24,
      "scene_id": "07",
      "scene_title": "3D로 확장하고 핵심 정리",
      "text": "이렇게 공간을 기울여 보니, 회전하는 위치와 높이를 따로 정한다는 뜻이 더 잘 보이죠.",
      "start": 133.86,
      "end": 139.14000000000001,
      "voice_start": 133.86,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 25,
      "scene_id": "07",
      "scene_title": "3D로 확장하고 핵심 정리",
      "text": "오늘은 이것만 기억하세요. 극좌표는 중심에서 얼마나 멀리, 어느 방향에 있는지로 위치를 말합니다.",
      "start": 139.56000000000003,
      "end": 145.40000000000003,
      "voice_start": 139.56000000000003,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 26,
      "scene_id": "07",
      "scene_title": "3D로 확장하고 핵심 정리",
      "text": "같은 위치를 거리와 각도로 생각하면, 회전하거나 퍼지는 움직임을 훨씬 쉽게 설계할 수 있습니다.",
      "start": 145.8,
      "end": 151.42000000000002,
      "voice_start": 145.8,
      "alignment": "whisper-word-timestamps-script-matched"
    }
  ],
