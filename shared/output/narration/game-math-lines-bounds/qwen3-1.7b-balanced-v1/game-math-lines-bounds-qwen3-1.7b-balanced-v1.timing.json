{
  "sample_rate": 24000,
  "duration_seconds": 991.4102500000002,
  "render_mode": "scene",
  "example_seconds": 0.0,
  "narration_placement": "continuous-across-example-and-explanation",
  "entries": [
    {
      "index": 1,
      "scene_id": "01",
      "scene_title": "형태를 계산으로 바꾸는 첫걸음",
      "text": "게임 화면에서 조준하는 선과 물체의 크기를, 프로그램은 어떤 숫자로 다룰까요?",
      "start": 0.0,
      "end": 4.9,
      "voice_start": 0.0,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 2,
      "scene_id": "01",
      "scene_title": "형태를 계산으로 바꾸는 첫걸음",
      "text": "먼저 그래플이 연결되는 장면에서 출발점과 방향을 찾고, 직선과 선분, 레이를 구분합니다.",
      "start": 5.24,
      "end": 11.42,
      "voice_start": 5.24,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 3,
      "scene_id": "01",
      "scene_title": "형태를 계산으로 바꾸는 첫걸음",
      "text": "이어서 둥근 물체를 구로 표현하고, 여러 점을 감싸는 경계 상자를 직접 계산하겠습니다.",
      "start": 11.72,
      "end": 16.96,
      "voice_start": 11.72,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 4,
      "scene_id": "01",
      "scene_title": "형태를 계산으로 바꾸는 첫걸음",
      "text": "마지막으로 상자를 회전시키며 흔한 오류를 확인하고, 안전하게 변환하는 식까지 정리합니다.",
      "start": 17.3,
      "end": 23.1,
      "voice_start": 17.3,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 5,
      "scene_id": "02",
      "scene_title": "그래플에서 출발점과 연결점을 찾기",
      "text": "어 스토리 어바웃 마이 엉클에서 바위 사이를 이동합니다. 손에서 뻗는 밝은 연결선을 보세요.",
      "start": 23.57,
      "end": 29.41,
      "voice_start": 25.335714285714285,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 6,
      "scene_id": "02",
      "scene_title": "그래플에서 출발점과 연결점을 찾기",
      "text": "연결선이 나타날 때 손 쪽의 출발과 바위 쪽의 도착을 나눠 생각할 수 있습니다.",
      "start": 29.73,
      "end": 34.97,
      "voice_start": 29.73,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 7,
      "scene_id": "02",
      "scene_title": "그래플에서 출발점과 연결점을 찾기",
      "text": "조준점을 다른 바위로 옮기면 연결되는 방향도 바뀝니다. 시작점 하나만으로 선 전체가 정해지지는 않습니다.",
      "start": 35.269999999999996,
      "end": 42.07,
      "voice_start": 35.269999999999996,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 8,
      "scene_id": "02",
      "scene_title": "그래플에서 출발점과 연결점을 찾기",
      "text": "화면에서 보이는 길이는 카메라와 원근의 영향을 받습니다. 픽셀 길이를 곧바로 게임 속 거리로 읽지는 마세요.",
      "start": 42.29,
      "end": 48.71,
      "voice_start": 42.29,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 9,
      "scene_id": "02",
      "scene_title": "그래플에서 출발점과 연결점을 찾기",
      "text": "이동하면서 두 끝점 사이의 관계가 바뀌는 모습을 기억하세요. 다음 그림에서는 우리가 정한 좌표로 그 관계를 계산합니다.",
      "start": 48.95,
      "end": 55.69,
      "voice_start": 48.95,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 10,
      "scene_id": "02",
      "scene_title": "그래플에서 출발점과 연결점을 찾기",
      "text": "보이는 그래플은 계산의 출발점입니다. 이 장면만으로 게임 내부의 레이 판정이나 물리 구현을 확인한 것은 아닙니다.",
      "start": 56.17,
      "end": 62.59,
      "voice_start": 56.17,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 11,
      "scene_id": "03",
      "scene_title": "같은 원을 설명하는 세 가지 방법",
      "text": "같은 원도, 무엇을 계산하느냐에 따라 표현을 바꿉니다. 중심과 반지름을 저장하면 형태의 데이터를 직접 갖게 됩니다.",
      "start": 63.14,
      "end": 70.7,
      "voice_start": 63.14,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 12,
      "scene_id": "03",
      "scene_title": "같은 원을 설명하는 세 가지 방법",
      "text": "둘째는 매개변수 표현입니다. 각도를 넣으면 중심에 반지름 곱하기 코사인과 사인을 더해 원 위의 점을 만들 수 있습니다.",
      "start": 70.96000000000001,
      "end": 78.62,
      "voice_start": 70.96000000000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 13,
      "scene_id": "03",
      "scene_title": "같은 원을 설명하는 세 가지 방법",
      "text": "셋째는 암시적 표현입니다. 주어진 점에서 중심을 뺀 벡터의 길이 제곱과 반지름 제곱을 비교합니다.",
      "start": 78.8,
      "end": 85.34,
      "voice_start": 78.8,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 14,
      "scene_id": "03",
      "scene_title": "같은 원을 설명하는 세 가지 방법",
      "text": "두 값이 같으면 원 위이고, 길이 제곱이 작으면 안쪽입니다. 그림의 점을 움직이며 판정이 바뀌는 것을 보세요.",
      "start": 85.4,
      "end": 92.08,
      "voice_start": 85.4,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 15,
      "scene_id": "03",
      "scene_title": "같은 원을 설명하는 세 가지 방법",
      "text": "매개변수식은 점을 만드는 데, 암시적 식은 점을 검사하는 데 편리합니다. 하나가 항상 더 좋은 표현은 아닙니다.",
      "start": 92.08,
      "end": 98.98,
      "voice_start": 92.08,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 16,
      "scene_id": "03",
      "scene_title": "같은 원을 설명하는 세 가지 방법",
      "text": "각도 매개변수를 넣었다고 시간이 생기는 것은 아닙니다. 각도, 시간, 거리 중 어떤 뜻인지 우리가 먼저 정해야 합니다.",
      "start": 99.18,
      "end": 106.0,
      "voice_start": 99.18,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 17,
      "scene_id": "04",
      "scene_title": "중심을 옮기면 일차항도 필요합니다",
      "text": "중심이 원점인 원은 엑스 제곱 더하기 와이 제곱이 반지름 제곱입니다. 중심을 옮기면 식도 달라집니다.",
      "start": 106.47000000000001,
      "end": 113.79000000000002,
      "voice_start": 106.47000000000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 18,
      "scene_id": "04",
      "scene_title": "중심을 옮기면 일차항도 필요합니다",
      "text": "중심이 이, 삼이고 반지름이 일인 원입니다. 엑스 좌표에서는 중심 좌표 이만큼을 뺍니다. 와이 좌표에서는 중심 좌표 삼만큼을 빼고, 각각 제곱합니다.",
      "start": 114.01000000000002,
      "end": 123.95000000000002,
      "voice_start": 114.01000000000002,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 19,
      "scene_id": "04",
      "scene_title": "중심을 옮기면 일차항도 필요합니다",
      "text": "전개하면 엑스 제곱 더하기 와이 제곱, 마이너스 사 엑스, 마이너스 육 와이, 더하기 십이가 영입니다.",
      "start": 124.15,
      "end": 130.25,
      "voice_start": 124.15,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 20,
      "scene_id": "04",
      "scene_title": "중심을 옮기면 일차항도 필요합니다",
      "text": "따라서 일반적인 이차 곡선 식에는 제곱항과 교차항뿐 아니라 일차항과 상수항도 들어갑니다.",
      "start": 130.53,
      "end": 135.91000000000003,
      "voice_start": 130.53,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 21,
      "scene_id": "04",
      "scene_title": "중심을 옮기면 일차항도 필요합니다",
      "text": "원은 중심 두 성분과 반지름 하나로 정해집니다. 구는 중심 세 성분과 반지름 하나를 사용합니다.",
      "start": 135.91000000000003,
      "end": 142.01000000000002,
      "voice_start": 135.91000000000003,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 22,
      "scene_id": "04",
      "scene_title": "중심을 옮기면 일차항도 필요합니다",
      "text": "축마다 다른 반지름을 주면 타원이나 타원체를 표현할 수 있습니다. 구를 비균일하게 늘린 뒤에도 구라고 취급하면 판정이 달라집니다.",
      "start": 142.25,
      "end": 149.41000000000003,
      "voice_start": 142.25,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 23,
      "scene_id": "05",
      "scene_title": "연결 방향과 이동 거리 구분하기",
      "text": "다른 바위에 연결하고 공중을 이동하는 장면입니다. 연결선이 생기는 순간 두 끝을 다시 찾아보세요.",
      "start": 149.88,
      "end": 156.14,
      "voice_start": 149.88,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 24,
      "scene_id": "05",
      "scene_title": "연결 방향과 이동 거리 구분하기",
      "text": "출발점에서 연결점으로 가는 차이 벡터는 방향과 길이를 함께 담습니다.",
      "start": 156.48,
      "end": 161.01999999999998,
      "voice_start": 156.48,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 25,
      "scene_id": "05",
      "scene_title": "연결 방향과 이동 거리 구분하기",
      "text": "같은 쪽을 가리켜도 가까운 바위와 먼 바위까지의 차이 벡터는 길이가 다릅니다.",
      "start": 161.29999999999998,
      "end": 165.95999999999998,
      "voice_start": 161.29999999999998,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 26,
      "scene_id": "05",
      "scene_title": "연결 방향과 이동 거리 구분하기",
      "text": "방향만 필요하면 그 차이를 길이로 나눕니다. 그러면 길이가 일인 방향벡터와 별도의 거리를 갖게 됩니다.",
      "start": 166.14,
      "end": 172.3,
      "voice_start": 166.14,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 27,
      "scene_id": "05",
      "scene_title": "연결 방향과 이동 거리 구분하기",
      "text": "손에서 바위까지의 연결과 캐릭터가 실제로 움직인 경로는 같은 질문이 아닙니다. 이동에 쓰인 힘과 궤적은 뒤의 역학에서 다루겠습니다.",
      "start": 172.35999999999999,
      "end": 181.64,
      "voice_start": 172.35999999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 28,
      "scene_id": "05",
      "scene_title": "연결 방향과 이동 거리 구분하기",
      "text": "지금은 두 위치를 잇는 기하 표현에 집중하세요. 식의 매개변수가 전체 길이의 비율인지 거리인지에 따라 계산 결과의 뜻이 달라집니다.",
      "start": 181.9,
      "end": 190.1,
      "voice_start": 181.9,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 29,
      "scene_id": "06",
      "scene_title": "직선·선분·레이는 범위가 다릅니다",
      "text": "출발점을 알파벳 오, 차이 벡터를 델타라고 부르겠습니다. 위치는 출발점에 티 곱하기 델타를 더해 구합니다.",
      "start": 190.57,
      "end": 198.31,
      "voice_start": 190.57,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 30,
      "scene_id": "06",
      "scene_title": "직선·선분·레이는 범위가 다릅니다",
      "text": "티가 영이면 출발점이고, 일이면 도착점입니다. 영부터 일까지만 허용하면 두 점 사이의 선분입니다.",
      "start": 198.65,
      "end": 205.09,
      "voice_start": 198.65,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 31,
      "scene_id": "06",
      "scene_title": "직선·선분·레이는 범위가 다릅니다",
      "text": "티를 모든 실수로 허용하면 양쪽으로 끝없이 이어지는 직선입니다. 음수는 반대쪽으로 연장합니다.",
      "start": 205.39,
      "end": 211.59,
      "voice_start": 205.39,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 32,
      "scene_id": "06",
      "scene_title": "직선·선분·레이는 범위가 다릅니다",
      "text": "보통 수학의 레이는 티가 영 이상인 반직선입니다. 앞쪽으로 끝없이 이어집니다.",
      "start": 211.76999999999998,
      "end": 216.64999999999998,
      "voice_start": 211.76999999999998,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 33,
      "scene_id": "06",
      "scene_title": "직선·선분·레이는 범위가 다릅니다",
      "text": "책에서는 레이라는 이름을 유한한 방향 선분에도 사용합니다. 엔진에서도 최대 거리를 받는 레이 검사가 흔하므로 실제 허용 범위를 확인해야 합니다.",
      "start": 216.99,
      "end": 225.14999999999998,
      "voice_start": 216.99,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 34,
      "scene_id": "06",
      "scene_title": "직선·선분·레이는 범위가 다릅니다",
      "text": "이름만 외우기보다 출발점, 방향과 매개변수의 범위를 함께 기록하세요. 그래야 선분 밖의 점을 잘못 포함하지 않습니다.",
      "start": 225.29,
      "end": 232.57,
      "voice_start": 225.29,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 35,
      "scene_id": "07",
      "scene_title": "비율과 거리의 단위 확인하기",
      "text": "출발점이 이, 일이고 차이 벡터가 육, 삼이라고 합시다. 절반 지점은 어디일까요?",
      "start": 233.09999999999997,
      "end": 238.33999999999997,
      "voice_start": 233.09999999999997,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 36,
      "scene_id": "07",
      "scene_title": "비율과 거리의 단위 확인하기",
      "text": "티에 영 점 오를 넣으면 출발점에 삼, 일 점 오를 더합니다. 결과는 오, 이 점 오입니다.",
      "start": 239.07999999999996,
      "end": 244.71999999999997,
      "voice_start": 239.07999999999996,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 37,
      "scene_id": "07",
      "scene_title": "비율과 거리의 단위 확인하기",
      "text": "이 영 점 오는 선분 길이의 절반이라는 비율입니다. 영 점 오 초나 영 점 오 미터가 아닙니다.",
      "start": 245.03999999999996,
      "end": 251.39999999999998,
      "voice_start": 245.03999999999996,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 38,
      "scene_id": "07",
      "scene_title": "비율과 거리의 단위 확인하기",
      "text": "차이 벡터의 길이는 루트 사십오입니다. 단위 방향은 차이 벡터를 루트 사십오로 나눠 만듭니다.",
      "start": 251.69999999999996,
      "end": 257.7,
      "voice_start": 251.69999999999996,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 39,
      "scene_id": "07",
      "scene_title": "비율과 거리의 단위 확인하기",
      "text": "이 단위 방향에 거리 에스를 곱하면 에스가 공간의 거리 단위를 갖습니다. 같은 절반 지점에는 루트 사십오의 절반을 넣습니다.",
      "start": 258.31999999999994,
      "end": 266.59999999999997,
      "voice_start": 258.31999999999994,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 40,
      "scene_id": "07",
      "scene_title": "비율과 거리의 단위 확인하기",
      "text": "두 끝점이 같으면 차이 벡터가 영입니다. 길이로 나누기 전에 검사하고, 퇴화한 점으로 처리할지 오류로 거절할지 정하세요.",
      "start": 266.91999999999996,
      "end": 274.03999999999996,
      "voice_start": 266.91999999999996,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 41,
      "scene_id": "08",
      "scene_title": "화면에서 수직인 선도 표현할 수 있을까요?",
      "text": "이번에는 위아래에 있는 바위를 번갈아 조준합니다. 연결선이 화면에서 세워지기도 하고 비스듬해지기도 합니다.",
      "start": 274.50999999999993,
      "end": 280.9099999999999,
      "voice_start": 274.50999999999993,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 42,
      "scene_id": "08",
      "scene_title": "화면에서 수직인 선도 표현할 수 있을까요?",
      "text": "우리의 눈에는 모두 자연스러운 선입니다. 그런데 기울기만으로 저장하면 수직선에서 문제가 생깁니다.",
      "start": 281.2899999999999,
      "end": 287.24999999999994,
      "voice_start": 281.2899999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 43,
      "scene_id": "08",
      "scene_title": "화면에서 수직인 선도 표현할 수 있을까요?",
      "text": "엑스 방향 변화가 영인 선은 와이 변화량을 엑스 변화량으로 나눌 수 없습니다.",
      "start": 287.56999999999994,
      "end": 292.68999999999994,
      "voice_start": 287.56999999999994,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 44,
      "scene_id": "08",
      "scene_title": "화면에서 수직인 선도 표현할 수 있을까요?",
      "text": "다음 그림에서는 같은 선을 법선과 위치로 표현해 이 문제를 피하겠습니다. 법선은 선을 따라가는 방향과 직각입니다.",
      "start": 293.1499999999999,
      "end": 300.44999999999993,
      "voice_start": 293.1499999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 45,
      "scene_id": "08",
      "scene_title": "화면에서 수직인 선도 표현할 수 있을까요?",
      "text": "화면의 수직 방향은 카메라가 만든 방향입니다. 실제 계산에서는 어떤 좌표계의 엑스와 와이인지 먼저 정해야 합니다.",
      "start": 301.10999999999996,
      "end": 308.9099999999999,
      "voice_start": 301.10999999999996,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 46,
      "scene_id": "08",
      "scene_title": "화면에서 수직인 선도 표현할 수 있을까요?",
      "text": "또 두 지점에서 거리가 같은 위치를 찾는 문제도 보겠습니다. 두 지점을 잇는 선과 그 수직이등분선은 서로 다른 선입니다.",
      "start": 309.1499999999999,
      "end": 316.88999999999993,
      "voice_start": 309.1499999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 47,
      "scene_id": "09",
      "scene_title": "법선 표현과 수직이등분선",
      "text": "와이는 기울기 곱하기 엑스 더하기 절편이라는 식이 익숙합니다. 하지만 수직선은 엑스가 상수라는 다른 형태가 필요합니다.",
      "start": 317.3599999999999,
      "end": 325.4799999999999,
      "voice_start": 317.3599999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 48,
      "scene_id": "09",
      "scene_title": "법선 표현과 수직이등분선",
      "text": "법선을 엔이라고 하고, 점과의 내적이 디라는 식을 쓰면 수직선과 수평선도 같은 틀로 표현할 수 있습니다.",
      "start": 325.6799999999999,
      "end": 332.1199999999999,
      "voice_start": 325.6799999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 49,
      "scene_id": "09",
      "scene_title": "법선 표현과 수직이등분선",
      "text": "법선의 방향은 선에 직각입니다. 법선이 영이면 유효한 직선을 정할 수 없습니다.",
      "start": 332.3599999999999,
      "end": 337.2999999999999,
      "voice_start": 332.3599999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 50,
      "scene_id": "09",
      "scene_title": "법선 표현과 수직이등분선",
      "text": "영, 영과 이, 영에서 같은 거리인 점들을 찾읍시다. 두 점의 차이인 이, 영을 법선으로 쓰고, 중점 일, 영을 통과시킵니다.",
      "start": 337.6199999999999,
      "end": 346.8399999999999,
      "voice_start": 337.6199999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 51,
      "scene_id": "09",
      "scene_title": "법선 표현과 수직이등분선",
      "text": "식은 이 엑스가 이, 즉 엑스가 일입니다. 세로선이 두 점 사이를 정확히 이등분합니다.",
      "start": 346.8399999999999,
      "end": 352.7799999999999,
      "voice_start": 346.8399999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 52,
      "scene_id": "09",
      "scene_title": "법선 표현과 수직이등분선",
      "text": "법선을 단위 길이로 바꾸면 디도 같은 길이로 나눕니다. 법선만 바꾸면 선의 위치가 달라집니다. 식의 값과 실제 거리도 법선 길이가 일일 때만 바로 같습니다.",
      "start": 352.9599999999999,
      "end": 363.2599999999999,
      "voice_start": 352.9599999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 53,
      "scene_id": "10",
      "scene_title": "둥근 모습과 실제 판정 범위",
      "text": "시리어스 샘 투에서 둥근 물체가 다가오고, 주변에 밝은 폭발 효과가 나타납니다. 둥근 윤곽부터 찾아보세요.",
      "start": 363.7300416666666,
      "end": 370.81004166666656,
      "voice_start": 363.7300416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 54,
      "scene_id": "10",
      "scene_title": "둥근 모습과 실제 판정 범위",
      "text": "이런 형태를 단순하게 계산하려면 중심과 반지름이 좋은 출발점입니다. 모든 방향으로 같은 거리라는 조건을 만들 수 있기 때문입니다.",
      "start": 370.9100416666666,
      "end": 378.0300416666666,
      "voice_start": 370.9100416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 55,
      "scene_id": "10",
      "scene_title": "둥근 모습과 실제 판정 범위",
      "text": "다만 둥글게 보이는 화면 효과가 곧 구의 표면이나 실제 피해 범위라는 뜻은 아닙니다. 반지름은 우리가 정의한 계산 데이터입니다.",
      "start": 378.3500416666666,
      "end": 386.6500416666666,
      "voice_start": 378.3500416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 56,
      "scene_id": "10",
      "scene_title": "둥근 모습과 실제 판정 범위",
      "text": "중심에서 표적까지의 거리가 반지름보다 작으면 내부에 있고, 같으면 경계에 있습니다. 다음 그림에서 세 경우를 나눠 보겠습니다.",
      "start": 386.7900416666666,
      "end": 393.93004166666657,
      "voice_start": 386.7900416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 57,
      "scene_id": "10",
      "scene_title": "둥근 모습과 실제 판정 범위",
      "text": "화면에서 가까워져 크게 보이는 것과 물체 자체의 반지름이 커지는 것도 다릅니다. 원근에 따른 픽셀 크기를 실제 크기로 혼동하지 마세요.",
      "start": 394.43004166666657,
      "end": 402.1700416666666,
      "voice_start": 394.43004166666657,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 58,
      "scene_id": "10",
      "scene_title": "둥근 모습과 실제 판정 범위",
      "text": "구의 판정은 복잡한 둥근 모양을 다루는 첫 근사입니다. 어떤 부분을 감싸야 하는지와 근사의 오차를 함께 정해야 합니다.",
      "start": 402.31004166666656,
      "end": 408.8300416666666,
      "voice_start": 402.31004166666656,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 59,
      "scene_id": "11",
      "scene_title": "구의 표면과 내부를 구분하기",
      "text": "구는 중심 세 성분과 반지름으로 정합니다. 점에서 중심을 뺀 벡터의 길이 제곱을 계산하세요.",
      "start": 409.5400416666666,
      "end": 416.0800416666666,
      "voice_start": 409.7700416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 60,
      "scene_id": "11",
      "scene_title": "구의 표면과 내부를 구분하기",
      "text": "중심이 일, 이, 삼이고 반지름이 이인 예제를 보겠습니다. 반지름 제곱은 사입니다.",
      "start": 416.44004166666656,
      "end": 422.62004166666657,
      "voice_start": 416.44004166666656,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 61,
      "scene_id": "11",
      "scene_title": "구의 표면과 내부를 구분하기",
      "text": "첫 점이 중심 자체라면 거리 제곱은 영입니다. 사보다 작으므로 내부입니다.",
      "start": 423.00004166666656,
      "end": 428.38004166666656,
      "voice_start": 423.00004166666656,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 62,
      "scene_id": "11",
      "scene_title": "구의 표면과 내부를 구분하기",
      "text": "두 번째 점이 삼, 이, 삼이면 중심에서 엑스 방향으로 이만큼 떨어집니다. 거리 제곱이 사이므로 표면입니다.",
      "start": 428.7200416666666,
      "end": 435.8200416666666,
      "voice_start": 428.7200416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 63,
      "scene_id": "11",
      "scene_title": "구의 표면과 내부를 구분하기",
      "text": "세 번째 점이 사, 이, 삼이면 거리 제곱은 구입니다. 사보다 크므로 바깥입니다. 제곱근 없이도 세 경우를 구분할 수 있습니다.",
      "start": 435.8200416666666,
      "end": 444.5200416666666,
      "voice_start": 435.8200416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 64,
      "scene_id": "11",
      "scene_title": "구의 표면과 내부를 구분하기",
      "text": "표면만 뜻할 때는 등호를, 채워진 구 전체를 뜻할 때는 작거나 같음을 씁니다. 유한한 좌표와 영 이상인 반지름을 확인하고, 경계 오차의 허용 단위도 정하세요.",
      "start": 444.9000416666666,
      "end": 455.9000416666666,
      "voice_start": 444.9000416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 65,
      "scene_id": "12",
      "scene_title": "반지름 두 배가 크기 두 배일까요?",
      "text": "반지름을 두 배로 바꾸면 지름은 두 배가 됩니다. 하지만 넓이와 부피는 다르게 커집니다.",
      "start": 456.8300833333332,
      "end": 462.31008333333324,
      "voice_start": 456.8300833333332,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 66,
      "scene_id": "12",
      "scene_title": "반지름 두 배가 크기 두 배일까요?",
      "text": "원을 가로지르는 지름은 이 알이고, 원주는 이 파이 알입니다. 둘 다 길이 단위를 갖습니다.",
      "start": 462.57008333333323,
      "end": 467.9500833333332,
      "voice_start": 462.57008333333323,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 67,
      "scene_id": "12",
      "scene_title": "반지름 두 배가 크기 두 배일까요?",
      "text": "원 넓이는 파이 알 제곱입니다. 구의 표면적은 사 파이 알 제곱이고, 둘 다 길이의 제곱 단위입니다.",
      "start": 468.1100833333332,
      "end": 474.5500833333332,
      "voice_start": 468.1100833333332,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 68,
      "scene_id": "12",
      "scene_title": "반지름 두 배가 크기 두 배일까요?",
      "text": "구의 부피는 삼분의 사 파이 알 세제곱입니다. 길이의 세제곱 단위이므로 반지름 두 배에서 부피는 여덟 배가 됩니다.",
      "start": 474.75008333333324,
      "end": 481.1700833333332,
      "voice_start": 474.75008333333324,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 69,
      "scene_id": "12",
      "scene_title": "반지름 두 배가 크기 두 배일까요?",
      "text": "표면적은 네 배입니다. 길이, 넓이, 부피를 모두 크기라는 말로 묶으면 비용이나 범위를 잘못 비교하기 쉽습니다.",
      "start": 481.43008333333324,
      "end": 488.13008333333323,
      "voice_start": 481.43008333333324,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 70,
      "scene_id": "12",
      "scene_title": "반지름 두 배가 크기 두 배일까요?",
      "text": "게임에서 반경을 바꿀 때에도 무엇을 일정하게 유지할지 구분하세요. 시각 효과, 판정 범위와 입자 수의 관계는 설계에 달려 있으며 이 공식만으로 게임의 비용을 확정할 수는 없습니다.",
      "start": 488.4100833333332,
      "end": 499.0900833333332,
      "voice_start": 488.4100833333332,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 71,
      "scene_id": "13",
      "scene_title": "복잡한 몸을 간단한 형태로 감싸기",
      "text": "마을 안에서 작은 적과 큰 적이 움직입니다. 머리, 팔과 몸통의 윤곽을 하나씩 모두 검사한다고 생각해 보세요.",
      "start": 499.6000833333332,
      "end": 507.2200833333332,
      "voice_start": 499.6000833333332,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 72,
      "scene_id": "13",
      "scene_title": "복잡한 몸을 간단한 형태로 감싸기",
      "text": "모든 자세에서 상세한 모양을 비교하면 계산할 데이터가 많아집니다. 먼저 단순한 경계 형태로 후보를 거를 수 있습니다.",
      "start": 507.5200833333332,
      "end": 514.8200833333332,
      "voice_start": 507.5200833333332,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 73,
      "scene_id": "13",
      "scene_title": "복잡한 몸을 간단한 형태로 감싸기",
      "text": "둥근 머리에는 구를, 길쭉한 몸에는 상자를 떠올려 봅니다. 여기서는 실제 게임의 충돌체가 아니라 우리가 비교할 근사 형태입니다.",
      "start": 515.1200833333332,
      "end": 523.5800833333332,
      "voice_start": 515.1200833333332,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 74,
      "scene_id": "13",
      "scene_title": "복잡한 몸을 간단한 형태로 감싸기",
      "text": "물체 방향을 따라가는 상자와 월드 축에 나란한 상자도 구분해야 합니다. 같은 몸을 감싸도 빈 공간의 크기가 달라집니다.",
      "start": 523.6200833333332,
      "end": 530.8200833333332,
      "voice_start": 523.6200833333332,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 75,
      "scene_id": "13",
      "scene_title": "복잡한 몸을 간단한 형태로 감싸기",
      "text": "팔을 벌리거나 돌아서면 감싸야 할 윤곽이 바뀝니다. 정지한 한 자세에서 만든 경계가 모든 애니메이션을 포함하는지도 확인해야 합니다.",
      "start": 531.1600833333332,
      "end": 538.7600833333332,
      "voice_start": 531.1600833333332,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 76,
      "scene_id": "13",
      "scene_title": "복잡한 몸을 간단한 형태로 감싸기",
      "text": "다음 그림에서는 모양을 점들의 집합으로 단순화하고, 세 축의 최소와 최대를 독립적으로 찾겠습니다.",
      "start": 539.1400833333332,
      "end": 544.8800833333332,
      "voice_start": 539.1400833333332,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 77,
      "scene_id": "14",
      "scene_title": "축에 나란한 상자의 데이터",
      "text": "축 정렬 경계 상자, 즉 에이 에이 비 비는 엑스, 와이, 제트 축에 나란한 여섯 면으로 점들을 감쌉니다.",
      "start": 545.5700833333333,
      "end": 553.0700833333333,
      "voice_start": 545.91675,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 78,
      "scene_id": "14",
      "scene_title": "축에 나란한 상자의 데이터",
      "text": "각 축의 최소 좌표와 최대 좌표를 저장하면 상자가 정해집니다. 최소 좌표 세 개가 한 실제 입력점에서 나올 필요는 없습니다.",
      "start": 553.3500833333333,
      "end": 561.2700833333333,
      "voice_start": 553.3500833333333,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 79,
      "scene_id": "14",
      "scene_title": "축에 나란한 상자의 데이터",
      "text": "중심은 최소와 최대의 평균입니다. 반크기는 최대에서 최소를 뺀 값의 절반이며, 전체 크기와 혼동하지 마세요.",
      "start": 561.5900833333333,
      "end": 568.5700833333333,
      "voice_start": 561.5900833333333,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 80,
      "scene_id": "14",
      "scene_title": "축에 나란한 상자의 데이터",
      "text": "점이 내부에 있는지 보려면 엑스를 엑스 범위에, 와이를 와이 범위에, 제트를 제트 범위에 각각 비교합니다.",
      "start": 568.7500833333332,
      "end": 575.5100833333333,
      "voice_start": 568.7500833333332,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 81,
      "scene_id": "14",
      "scene_title": "축에 나란한 상자의 데이터",
      "text": "세 검사가 모두 참이어야 안쪽입니다. 와이를 엑스 최소값과 비교하는 복사 오류가 있어도 코드가 실행되므로 특히 주의하세요.",
      "start": 575.5700833333333,
      "end": 584.0900833333333,
      "voice_start": 575.5700833333333,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 82,
      "scene_id": "14",
      "scene_title": "축에 나란한 상자의 데이터",
      "text": "물체 축을 따라 회전하는 상자는 오 비 비입니다. 방향 정보를 더 저장하는 대신 길쭉한 물체 주변의 빈 공간을 줄일 수 있습니다.",
      "start": 584.1900833333333,
      "end": 592.3500833333333,
      "voice_start": 584.1900833333333,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 83,
      "scene_id": "15",
      "scene_title": "다섯 점으로 상자 만들기",
      "text": "책의 다섯 점을 그대로 사용하되, 좌표를 축별로 비교하겠습니다. 첫 점으로 최소와 최대를 초기화합니다.",
      "start": 592.820125,
      "end": 600.060125,
      "voice_start": 592.820125,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 84,
      "scene_id": "15",
      "scene_title": "다섯 점으로 상자 만들기",
      "text": "다음 점마다 엑스, 와이, 제트를 각각 비교합니다. 더 작으면 최소를, 더 크면 최대를 바꿉니다. 활성 코드 줄과 표의 색을 함께 보세요.",
      "start": 600.300125,
      "end": 609.280125,
      "voice_start": 600.300125,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 85,
      "scene_id": "15",
      "scene_title": "다섯 점으로 상자 만들기",
      "text": "모든 점을 읽으면 최소는 마이너스 오, 마이너스 칠, 마이너스 오이고, 최대는 칠, 십일, 팔입니다.",
      "start": 609.400125,
      "end": 615.660125,
      "voice_start": 609.400125,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 86,
      "scene_id": "15",
      "scene_title": "다섯 점으로 상자 만들기",
      "text": "엑스 중심은 일입니다. 와이 중심은 이입니다. 제트 중심은 일 점 오입니다. 전체 크기는 십이, 십팔, 십삼이고 반크기는 육, 구, 육 점 오입니다.",
      "start": 615.9801249999999,
      "end": 625.320125,
      "voice_start": 615.9801249999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 87,
      "scene_id": "15",
      "scene_title": "다섯 점으로 상자 만들기",
      "text": "모든 좌표를 영으로 초기화하면 실제 점들이 원점의 한쪽에 있을 때 원점까지 잘못 포함할 수 있습니다. 첫 유효한 점이나 명시적인 빈 상자 상태를 쓰세요.",
      "start": 625.4801249999999,
      "end": 634.520125,
      "voice_start": 625.4801249999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 88,
      "scene_id": "15",
      "scene_title": "다섯 점으로 상자 만들기",
      "text": "입력이 비었거나 좌표에 무한대와 비수가 있으면 먼저 처리해야 합니다. 점 개수와 반복 범위도 실제 배열에 맞춰야 안전한 경계를 얻습니다.",
      "start": 634.680125,
      "end": 642.3601249999999,
      "voice_start": 634.680125,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 89,
      "scene_id": "16",
      "scene_title": "경계가 겹쳐도 몸이 닿았다는 뜻은 아닙니다",
      "text": "팔을 가진 큰 적과 작은 적이 화면을 가로질러 움직입니다. 각 몸을 간단한 상자로 감싸는 모습을 떠올려 보세요.",
      "start": 642.8701666666667,
      "end": 650.5301666666667,
      "voice_start": 642.8701666666667,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 90,
      "scene_id": "16",
      "scene_title": "경계가 겹쳐도 몸이 닿았다는 뜻은 아닙니다",
      "text": "상자의 모서리에는 실제 몸이 차지하지 않는 빈 공간이 남습니다. 두 상자가 겹쳐도 실제 몸은 떨어져 있을 수 있습니다.",
      "start": 650.7301666666667,
      "end": 657.9301666666667,
      "voice_start": 650.7301666666667,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 91,
      "scene_id": "16",
      "scene_title": "경계가 겹쳐도 몸이 닿았다는 뜻은 아닙니다",
      "text": "특히 길쭉하거나 기울어진 형태를 월드 축 상자로 감싸면 빈 공간이 커집니다. 윤곽과 경계의 차이를 보는 것이 핵심입니다.",
      "start": 658.1701666666667,
      "end": 666.0701666666668,
      "voice_start": 658.1701666666667,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 92,
      "scene_id": "16",
      "scene_title": "경계가 겹쳐도 몸이 닿았다는 뜻은 아닙니다",
      "text": "기존 강의에서 배운 이차원 상자 겹침은 빠르게 후보를 찾는 검사로 사용할 수 있습니다. 이제는 그 결과의 한계를 같이 기억하세요.",
      "start": 666.4701666666667,
      "end": 673.6701666666667,
      "voice_start": 666.4701666666667,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 93,
      "scene_id": "16",
      "scene_title": "경계가 겹쳐도 몸이 닿았다는 뜻은 아닙니다",
      "text": "후보를 찾은 뒤 필요한 정확도의 검사로 넘어갑니다. 복잡한 모양을 어떤 단순한 형태로 대신할지는 게임의 규칙과 비용에 맞춰 정합니다.",
      "start": 674.0101666666667,
      "end": 681.9701666666667,
      "voice_start": 674.0101666666667,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 94,
      "scene_id": "16",
      "scene_title": "경계가 겹쳐도 몸이 닿았다는 뜻은 아닙니다",
      "text": "다음 그림은 서로 떨어진 두 길쭉한 사각형입니다. 경계 상자만 겹치는 반례를 직접 확인하고, 실제 모양과의 충돌을 구분하겠습니다.",
      "start": 682.4901666666667,
      "end": 690.3101666666666,
      "voice_start": 682.4901666666667,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 95,
      "scene_id": "17",
      "scene_title": "후보 판정과 정밀 판정",
      "text": "두 가느다란 사각형을 같은 방향으로 기울였습니다. 실제 사각형 사이에는 빈 틈이 있습니다.",
      "start": 691.2401666666667,
      "end": 697.3401666666667,
      "voice_start": 691.2401666666667,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 96,
      "scene_id": "17",
      "scene_title": "후보 판정과 정밀 판정",
      "text": "하지만 축 정렬 상자는 각각의 엑스와 와이 범위를 조합하므로 두 상자의 영역은 겹칩니다.",
      "start": 697.6601666666667,
      "end": 703.7401666666667,
      "voice_start": 697.6601666666667,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 97,
      "scene_id": "17",
      "scene_title": "후보 판정과 정밀 판정",
      "text": "상자 겹침이 뜻하는 것은 이 둘을 더 검사하자는 후보입니다. 상세 모양이 닿았다는 결론은 아닙니다.",
      "start": 703.9001666666667,
      "end": 710.2401666666667,
      "voice_start": 703.9001666666667,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 98,
      "scene_id": "17",
      "scene_title": "후보 판정과 정밀 판정",
      "text": "올바른 경계가 겹치지 않으면 그 안의 모양도 겹칠 수 없습니다. 단, 경계가 실제 현재 모양을 빠짐없이 감싼다는 조건이 필요합니다.",
      "start": 710.4801666666667,
      "end": 719.2801666666667,
      "voice_start": 710.4801666666667,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 99,
      "scene_id": "17",
      "scene_title": "후보 판정과 정밀 판정",
      "text": "구는 회전해도 모양이 유지되고, 방향 상자는 길쭉한 모양에 더 맞을 수 있습니다. 더 꽉 맞는 경계가 항상 전체 비용을 줄인다고 단정할 수는 없습니다.",
      "start": 719.2801666666667,
      "end": 728.6601666666667,
      "voice_start": 719.2801666666667,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 100,
      "scene_id": "17",
      "scene_title": "후보 판정과 정밀 판정",
      "text": "경계를 갱신하는 비용, 후보 수와 다음 단계의 비용을 함께 비교하세요. 이 예제는 전체 충돌 엔진이 아니라 경계의 역할을 보여주는 반례입니다.",
      "start": 729.1401666666667,
      "end": 737.9001666666667,
      "voice_start": 729.1401666666667,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 101,
      "scene_id": "18",
      "scene_title": "최소·최대 두 점만 돌리면 틀립니다",
      "text": "상자를 회전시킨 뒤에도 경계를 구하려면 어떻게 해야 할까요? 최소점과 최대점만 돌리는 방법을 먼저 시험해 보겠습니다.",
      "start": 738.4902083333334,
      "end": 746.4502083333334,
      "voice_start": 738.4902083333334,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 102,
      "scene_id": "18",
      "scene_title": "최소·최대 두 점만 돌리면 틀립니다",
      "text": "엑스와 와이가 마이너스 일부터 일인 정사각형을 사십오 도 돌립니다. 두 대각 끝점은 엑스가 영인 세로선으로 이동합니다.",
      "start": 746.9302083333334,
      "end": 755.0502083333333,
      "voice_start": 746.9302083333334,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 103,
      "scene_id": "18",
      "scene_title": "최소·최대 두 점만 돌리면 틀립니다",
      "text": "이 두 점만 보고 새 경계를 만들면 폭이 영이라고 계산됩니다. 하지만 나머지 두 꼭짓점은 좌우로 루트 이만큼 뻗습니다.",
      "start": 755.1902083333334,
      "end": 762.3502083333334,
      "voice_start": 755.1902083333334,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 104,
      "scene_id": "18",
      "scene_title": "최소·최대 두 점만 돌리면 틀립니다",
      "text": "회전 뒤 어느 점이 최소와 최대가 되는지 바뀌었기 때문입니다. 최소라는 이름이 회전 뒤에도 유지되는 것은 아닙니다.",
      "start": 762.6702083333333,
      "end": 769.3502083333334,
      "voice_start": 762.6702083333333,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 105,
      "scene_id": "18",
      "scene_title": "최소·최대 두 점만 돌리면 틀립니다",
      "text": "삼차원 상자에서는 여덟 꼭짓점을 모두 변환하고, 변환된 점들의 축별 최소와 최대를 다시 구하면 됩니다.",
      "start": 769.434375,
      "end": 775.8502083333334,
      "voice_start": 769.434375,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 106,
      "scene_id": "18",
      "scene_title": "최소·최대 두 점만 돌리면 틀립니다",
      "text": "이 상자는 변환된 원래 상자를 감쌉니다. 원래 물체의 실제 점들만 변환해 만든 경계와는 크기가 다를 수 있다는 점도 곧 비교하겠습니다.",
      "start": 776.1902083333334,
      "end": 784.4702083333334,
      "voice_start": 776.1902083333334,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 107,
      "scene_id": "19",
      "scene_title": "시점 변화와 물체 경계의 기준축",
      "text": "나무 기둥과 난간이 있는 마을을 걸어갑니다. 같은 구조물을 다른 쪽에서 보며 화면의 가로세로 범위를 비교하세요.",
      "start": 784.9402083333334,
      "end": 791.8202083333334,
      "voice_start": 784.9402083333334,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 108,
      "scene_id": "19",
      "scene_title": "시점 변화와 물체 경계의 기준축",
      "text": "비스듬히 보면 긴 변이 짧게 보이고 다른 면이 드러납니다. 화면 경계가 달라지는 것은 카메라 투영의 영향입니다.",
      "start": 792.1002083333334,
      "end": 799.3802083333335,
      "voice_start": 792.1002083333334,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 109,
      "scene_id": "19",
      "scene_title": "시점 변화와 물체 경계의 기준축",
      "text": "월드 좌표의 경계를 구할 때는 화면 픽셀과 다른 고정 기준축을 사용합니다. 카메라만 바뀌었다면 월드에서 정지한 물체의 경계가 자동으로 바뀌는 것은 아닙니다.",
      "start": 799.5602083333334,
      "end": 809.4602083333334,
      "voice_start": 799.5602083333334,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 110,
      "scene_id": "19",
      "scene_title": "시점 변화와 물체 경계의 기준축",
      "text": "반대로 물체 자체를 월드에서 돌리면 어느 꼭짓점이 엑스 최소를 주는지 바뀔 수 있습니다. 바로 앞 정사각형 실험이 그 경우였습니다.",
      "start": 809.8402083333334,
      "end": 818.1602083333335,
      "voice_start": 809.8402083333334,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 111,
      "scene_id": "19",
      "scene_title": "시점 변화와 물체 경계의 기준축",
      "text": "물체에 붙은 상자와 월드 축에 붙은 상자를 나누어 생각하세요. 지금 움직이는 것은 카메라인지 물체인지부터 확인하는 습관이 도움이 됩니다.",
      "start": 818.4602083333334,
      "end": 827.1202083333334,
      "voice_start": 818.4602083333334,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 112,
      "scene_id": "19",
      "scene_title": "시점 변화와 물체 경계의 기준축",
      "text": "다음 식에서는 카메라 원근을 섞지 않고, 물체의 회전과 크기 변경, 이동으로 이루어진 아핀 변환만 다루겠습니다.",
