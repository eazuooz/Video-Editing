{
  "sample_rate": 24000,
  "duration_seconds": 303.92,
  "render_mode": "scene",
  "example_seconds": 0.0,
  "narration_placement": "continuous-across-example-and-explanation",
  "entries": [
    {
      "index": 1,
      "scene_id": "01",
      "scene_title": "전체 내용 안내",
      "text": "새 게임을 만들 때, 익숙한 조작은 어디까지 남기고 무엇을 새로 설계해야 할까요?",
      "start": 0.0,
      "end": 5.6625
    },
    {
      "index": 2,
      "scene_id": "01",
      "scene_title": "전체 내용 안내",
      "text": "앵거 풋의 이동과 발차기, 건브렐라의 여러 행동, 마이 프렌드 페드로의 이동과 조준을 차례로 보겠습니다.",
      "start": 5.6625,
      "end": 13.0625
    },
    {
      "index": 3,
      "scene_id": "01",
      "scene_title": "전체 내용 안내",
      "text": "보고 나면 익숙한 약속, 버튼 배치, 장치가 맡는 기능을 나누어 자신의 조작 설계를 점검할 수 있습니다.",
      "start": 13.0625,
      "end": 20.0525
    },
    {
      "index": 4,
      "scene_id": "01",
      "scene_title": "전체 내용 안내",
      "text": "먼저 화면을 돌려 대상을 겨누면서 발로 차는 장면부터 보죠.",
      "start": 20.0525,
      "end": 24.32
    },
    {
      "index": 5,
      "scene_id": "02",
      "scene_title": "익숙한 관점에서 새 행동을 본다",
      "text": "앵거 풋에서는 화면 중심을 대상으로 돌리고, 다가가며 총을 쏘거나 발로 찹니다.",
      "start": 25.04,
      "end": 30.0425
    },
    {
      "index": 6,
      "scene_id": "02",
      "scene_title": "익숙한 관점에서 새 행동을 본다",
      "text": "지금은 방 안의 대상과 높은 쪽을 겨누는 방향을 보세요. 이동과 조준에 발차기가 더해집니다.",
      "start": 30.0425,
      "end": 35.7925
    },
    {
      "index": 7,
      "scene_id": "02",
      "scene_title": "익숙한 관점에서 새 행동을 본다",
      "text": "이 화면에서 특정 키를 누른 순서까지 알 수는 없습니다. 여기서 볼 것은 행동 사이의 관계입니다.",
      "start": 35.7925,
      "end": 42.0925
    },
    {
      "index": 8,
      "scene_id": "02",
      "scene_title": "익숙한 관점에서 새 행동을 본다",
      "text": "익숙한 일인칭 조작을 바탕으로 설계한다면, 새 행동이 기존 행동과 어떻게 이어지는지부터 정할 수 있습니다.",
      "start": 42.0925,
      "end": 48.480000000000004
    },
    {
      "index": 9,
      "scene_id": "03",
      "scene_title": "익숙한 약속을 설계의 출발점으로",
      "text": "조작 약속은 어떤 입력을 하면 어떤 종류의 행동이 나올지에 대한 예상입니다.",
      "start": 49.2,
      "end": 54.102500000000006
    },
    {
      "index": 10,
      "scene_id": "03",
      "scene_title": "익숙한 약속을 설계의 출발점으로",
      "text": "이미 그 약속을 아는 사람에게는, 같은 역할의 입력을 일관되게 유지하는 것이 출발점이 됩니다.",
      "start": 54.102500000000006,
      "end": 60.1625
    },
    {
      "index": 11,
      "scene_id": "03",
      "scene_title": "익숙한 약속을 설계의 출발점으로",
      "text": "새로움은 적의 위치, 이동할 경로, 행동을 조합할 상황에도 둘 수 있습니다. 모든 버튼을 낯설게 만들 필요는 없습니다.",
      "start": 60.1625,
      "end": 67.7225
    },
    {
      "index": 12,
      "scene_id": "03",
      "scene_title": "익숙한 약속을 설계의 출발점으로",
      "text": "다만 처음 접하는 사람까지 알고 있다고 가정하지 말고, 새 행동과 필요한 안내는 따로 확인해야 합니다.",
      "start": 67.7225,
      "end": 73.84
    },
    {
      "index": 13,
      "scene_id": "04",
      "scene_title": "발차기를 더해도 방향 관계는 남는다",
      "text": "복도와 방을 오가는 장면에서, 대상을 화면 안에 두며 다가가고 발로 차는 행동을 따라가 보세요.",
      "start": 74.56,
      "end": 80.55250000000001
    },
    {
      "index": 14,
      "scene_id": "04",
      "scene_title": "발차기를 더해도 방향 관계는 남는다",
      "text": "방향을 잡는 행동과 가까운 대상을 처리하는 행동은 연결되지만, 같은 기능은 아닙니다.",
      "start": 80.55250000000001,
      "end": 86.3725
    },
    {
      "index": 15,
      "scene_id": "04",
      "scene_title": "발차기를 더해도 방향 관계는 남는다",
      "text": "새 기획에서는 발차기를 어디에 둘지뿐 아니라, 이동이나 조준과 함께 실행할 수 있을지도 점검해야 합니다.",
      "start": 86.3725,
      "end": 93.0425
    },
    {
      "index": 16,
      "scene_id": "04",
      "scene_title": "발차기를 더해도 방향 관계는 남는다",
      "text": "각 장면은 예고편의 서로 다른 컷입니다. 하나의 연속 조작이나 정해진 공략으로 연결해서 해석하지는 않습니다.",
      "start": 93.0425,
      "end": 100.24000000000001
    },
    {
      "index": 17,
      "scene_id": "05",
      "scene_title": "버튼 재배치는 행동의 연결을 옮긴다",
      "text": "버튼을 재배치한다는 것은 입력과 행동의 연결을 바꾸는 일입니다. 행동 자체를 없애는 것과는 다릅니다.",
      "start": 100.96000000000001,
      "end": 107.78250000000001
    },
    {
      "index": 18,
      "scene_id": "05",
      "scene_title": "버튼 재배치는 행동의 연결을 옮긴다",
      "text": "가상의 설계에서 점프를 다른 버튼으로 옮겼다면, 이동하며 점프하는 조합도 실제로 실행해 봐야 합니다.",
      "start": 107.78250000000001,
      "end": 114.77250000000001
    },
    {
      "index": 19,
      "scene_id": "05",
      "scene_title": "버튼 재배치는 행동의 연결을 옮긴다",
      "text": "한 버튼이 여러 상황에서 다른 역할을 맡는다면, 그 상황별 연결과 화면 안내도 함께 갱신해야 합니다.",
      "start": 114.77250000000001,
      "end": 121.38250000000001
    },
    {
      "index": 20,
      "scene_id": "05",
      "scene_title": "버튼 재배치는 행동의 연결을 옮긴다",
      "text": "메뉴에서 연결만 바뀌었다고 끝내지 말고, 동시에 필요한 행동과 재배치된 안내를 점검하세요.",
      "start": 121.38250000000001,
      "end": 127.28
    },
    {
      "index": 21,
      "scene_id": "06",
      "scene_title": "우산 동작을 이동과 나누어 관찰한다",
      "text": "건브렐라에서는 캐릭터가 이동하고 뛰며, 우산을 펼치거나 방향을 바꾸어 공격합니다.",
      "start": 128.0,
      "end": 133.6225
    },
    {
      "index": 22,
      "scene_id": "06",
      "scene_title": "우산 동작을 이동과 나누어 관찰한다",
      "text": "공중에서 우산을 펴는 장면과 높은 대상을 겨누는 장면을 보세요. 도구가 같아도 맡는 행동은 여러 가지입니다.",
      "start": 133.6225,
      "end": 140.7025
    },
    {
      "index": 23,
      "scene_id": "06",
      "scene_title": "우산 동작을 이동과 나누어 관찰한다",
      "text": "여기서는 보이는 동작을 나눌 뿐, 현재 게임의 키 배치나 재설정 기능을 확인한 것은 아닙니다.",
      "start": 140.7025,
      "end": 146.2925
    },
    {
      "index": 24,
      "scene_id": "06",
      "scene_title": "우산 동작을 이동과 나누어 관찰한다",
      "text": "자신의 설계에서는 이동, 점프, 도구 사용, 조준을 적고 어떤 행동이 함께 필요한지 연결해 보세요.",
      "start": 146.2925,
      "end": 152.8525
    },
    {
      "index": 25,
      "scene_id": "06",
      "scene_title": "우산 동작을 이동과 나누어 관찰한다",
      "text": "우산을 펼쳤다는 이유만으로 모든 공격을 막는다고 단정할 수도 없습니다. 조작의 연결과 행동의 결과는 따로 확인합니다.",
      "start": 152.8525,
      "end": 160.16
    },
    {
      "index": 26,
      "scene_id": "07",
      "scene_title": "장치가 바뀌면 기능도 대조한다",
      "text": "버튼의 위치를 옮기는 일과, 입력 장치가 제공하는 기능을 바꾸는 일은 구별해야 합니다.",
      "start": 160.88,
      "end": 166.2125
    },
    {
      "index": 27,
      "scene_id": "07",
      "scene_title": "장치가 바뀌면 기능도 대조한다",
      "text": "단순한 버튼은 눌림과 떼어짐을 주지만, 조준에는 계속 바뀌는 방향이나 위치가 필요할 수 있습니다.",
      "start": 166.2125,
      "end": 172.2225
    },
    {
      "index": 28,
      "scene_id": "07",
      "scene_title": "장치가 바뀌면 기능도 대조한다",
      "text": "따라서 조준이라는 이름을 같은 버튼에 붙여도, 방향을 정하는 기능이 자동으로 옮겨가지는 않습니다.",
      "start": 172.2225,
      "end": 178.4525
    },
    {
      "index": 29,
      "scene_id": "07",
      "scene_title": "장치가 바뀌면 기능도 대조한다",
      "text": "입력의 이름보다, 무엇을 선택하고 어느 범위에서 얼마나 연속적으로 바꿔야 하는지 먼저 적어 보세요.",
      "start": 178.4525,
      "end": 184.48
    },
    {
      "index": 30,
      "scene_id": "08",
      "scene_title": "몸의 이동과 총의 방향이 갈라진다",
      "text": "마이 프렌드 페드로에서는 몸이 내려가거나 옆으로 움직이는 동안 총은 다른 쪽을 겨눕니다.",
      "start": 185.2,
      "end": 191.58249999999998
    },
    {
      "index": 31,
      "scene_id": "08",
      "scene_title": "몸의 이동과 총의 방향이 갈라진다",
      "text": "통 위를 지나고 줄에 매달리는 장면에서, 이동 방향과 대상을 겨누는 방향을 따로 따라가 보세요.",
      "start": 191.58249999999998,
      "end": 197.9725
    },
    {
      "index": 32,
      "scene_id": "08",
      "scene_title": "몸의 이동과 총의 방향이 갈라진다",
      "text": "두 총이 서로 다른 쪽을 향하는 장면도 있습니다. 하나의 실행 버튼뿐 아니라, 어느 대상을 향할지도 문제입니다.",
      "start": 197.9725,
      "end": 205.5425
    },
    {
      "index": 33,
      "scene_id": "08",
      "scene_title": "몸의 이동과 총의 방향이 갈라진다",
      "text": "이 관찰은 게임의 정확한 입력 방식이나 지원 장치를 증명하지 않습니다. 방향 선택이라는 설계 문제를 보여 줍니다.",
      "start": 205.5425,
      "end": 213.67249999999999
    },
    {
      "index": 34,
      "scene_id": "08",
      "scene_title": "몸의 이동과 총의 방향이 갈라진다",
      "text": "새 장치로 옮길 때에는, 이동하며 대상을 바꾸는 기능을 무엇으로 제공할지 별도로 결정해야 합니다.",
      "start": 213.67249999999999,
      "end": 220.23999999999998
    },
    {
      "index": 35,
      "scene_id": "09",
      "scene_title": "대체 입력은 선택의 범위를 바꿀 수 있다",
      "text": "가상의 대안으로는 방향을 직접 고르기, 후보 대상을 차례로 바꾸기, 자동 선택을 보조하기를 생각할 수 있습니다.",
      "start": 220.95999999999998,
      "end": 228.66249999999997
    },
    {
      "index": 36,
      "scene_id": "09",
      "scene_title": "대체 입력은 선택의 범위를 바꿀 수 있다",
      "text": "세 방식은 같은 결과를 항상 주지 않습니다. 원하는 상대를 고르는 범위와 선택하는 과정이 달라집니다.",
      "start": 228.66249999999997,
      "end": 235.3825
    },
    {
      "index": 37,
      "scene_id": "09",
      "scene_title": "대체 입력은 선택의 범위를 바꿀 수 있다",
      "text": "어떤 방식을 택하든, 이동과 목표 변경을 동시에 요구하는 장면에서 의도한 선택이 가능한지 확인해야 합니다.",
      "start": 235.3825,
      "end": 242.81249999999997
    },
    {
      "index": 38,
      "scene_id": "09",
      "scene_title": "대체 입력은 선택의 범위를 바꿀 수 있다",
      "text": "원래 동작의 이름을 지키는 데 그치지 말고, 플레이어가 내릴 결정을 지켰는지 대조하세요.",
      "start": 242.81249999999997,
      "end": 248.23999999999998
    },
    {
      "index": 39,
      "scene_id": "10",
      "scene_title": "연속 동작 속에서 기능을 점검한다",
      "text": "여러 층을 내려가며 싸우는 이 구간은, 앞서 본 짧은 컷과 달리 같은 이동을 계속 따라갈 수 있습니다.",
      "start": 248.95999999999998,
      "end": 254.72249999999997
    },
    {
      "index": 40,
      "scene_id": "10",
      "scene_title": "연속 동작 속에서 기능을 점검한다",
      "text": "왼쪽과 오른쪽의 상대를 겨눈 뒤, 바닥을 사이에 두고 위아래를 향하는 총의 방향을 보세요.",
      "start": 254.72249999999997,
      "end": 261.5825
    },
    {
      "index": 41,
      "scene_id": "10",
      "scene_title": "연속 동작 속에서 기능을 점검한다",
      "text": "몸을 움직이면서 목표 방향도 바뀝니다. 이동 버튼을 유지했다는 것만으로 필요한 조작이 모두 보존되지는 않습니다.",
      "start": 261.5825,
      "end": 268.4025
    },
    {
      "index": 42,
      "scene_id": "10",
      "scene_title": "연속 동작 속에서 기능을 점검한다",
      "text": "자신의 설계도 이런 동작 조합을 하나씩 실행하며, 목표를 고를 수 있는지와 안내가 맞는지를 확인해 보세요.",
      "start": 268.4025,
      "end": 275.1325
    },
    {
      "index": 43,
      "scene_id": "10",
      "scene_title": "연속 동작 속에서 기능을 점검한다",
      "text": "같은 장면을 반복해서 익숙해 보이게 만드는 대신, 새 경로와 다른 대상에서도 같은 약속이 이어지는지 점검합니다.",
      "start": 275.1325,
      "end": 282.15999999999997
    },
    {
      "index": 44,
      "scene_id": "11",
      "scene_title": "익숙한 약속과 새 결정을 함께 설계하기",
      "text": "익숙한 조작을 활용하려면 먼저 입력이 맡는 역할을 유지하고, 새로 추가한 행동을 분명히 연결하세요.",
      "start": 282.88,
      "end": 289.4525
    },
    {
      "index": 45,
      "scene_id": "11",
      "scene_title": "익숙한 약속과 새 결정을 함께 설계하기",
      "text": "재배치할 때는 함께 필요한 행동과 화면 안내를, 장치가 바뀔 때는 방향과 대상 선택의 기능을 확인합니다.",
      "start": 289.4525,
      "end": 295.8425
    },
    {
      "index": 46,
      "scene_id": "11",
      "scene_title": "익숙한 약속과 새 결정을 함께 설계하기",
      "text": "마지막으로 다른 경로에서도 원하는 결정을 내릴 수 있는지 실행해 보면, 무엇을 남기고 새로 설계할지 구별할 수 있습니다.",
      "start": 295.8425,
      "end": 303.92
    }
  ]
}
