{
  "sample_rate": 24000,
  "duration_seconds": 185.6,
  "render_mode": "scene",
  "example_seconds": 19.5,
  "narration_placement": "continuous-across-example-and-explanation",
  "entries": [
    {
      "index": 1,
      "scene_id": "01",
      "scene_title": "느낌을 시간으로 옮기기",
      "text": "공격을 조금 더 빠르게 만들어 주세요. 개발할 때 자주 듣는 요청입니다.",
      "start": 0.0,
      "end": 4.4025
    },
    {
      "index": 2,
      "scene_id": "01",
      "scene_title": "느낌을 시간으로 옮기기",
      "text": "그런데 준비 자세를 줄일까요, 맞은 뒤 멈춤을 줄일까요?",
      "start": 4.4025,
      "end": 7.9925
    },
    {
      "index": 3,
      "scene_id": "01",
      "scene_title": "느낌을 시간으로 옮기기",
      "text": "메가맨 일레븐의 점프와 몬스터 헌터 라이즈의 공격처럼,",
      "start": 7.9925,
      "end": 11.5825
    },
    {
      "index": 4,
      "scene_id": "01",
      "scene_title": "느낌을 시간으로 옮기기",
      "text": "한 동작 안에도 시작과 변화, 마무리가 있습니다.",
      "start": 11.5825,
      "end": 14.3425
    },
    {
      "index": 5,
      "scene_id": "01",
      "scene_title": "느낌을 시간으로 옮기기",
      "text": "오늘은 그 느낌을 프레임이라는 시간 눈금으로 옮겨 보겠습니다.",
      "start": 14.3425,
      "end": 19.2225
    },
    {
      "index": 6,
      "scene_id": "01",
      "scene_title": "느낌을 시간으로 옮기기",
      "text": "실제 게임은 동작을 관찰하는 예시이고,",
      "start": 19.2225,
      "end": 22.4825
    },
    {
      "index": 7,
      "scene_id": "01",
      "scene_title": "느낌을 시간으로 옮기기",
      "text": "정확한 숫자는 직접 만든 프레임 테스트에서 확인합니다.",
      "start": 22.4825,
      "end": 25.1925
    },
    {
      "index": 8,
      "scene_id": "01",
      "scene_title": "느낌을 시간으로 옮기기",
      "text": "그림 장수와 게임의 시간까지 같은 것이라고 생각하면 안 됩니다.",
      "start": 25.1925,
      "end": 28.96
    },
    {
      "index": 9,
      "scene_id": "02",
      "scene_title": "프레임 수에는 기준 속도가 필요하다",
      "text": "프레임 수에는 기준 속도가 필요합니다.",
      "start": 29.68,
      "end": 32.0525
    },
    {
      "index": 10,
      "scene_id": "02",
      "scene_title": "프레임 수에는 기준 속도가 필요하다",
      "text": "일 초를 예순 번 나누는 기준에서 열두 프레임은 영 점 이 초입니다.",
      "start": 32.0525,
      "end": 36.7825
    },
    {
      "index": 11,
      "scene_id": "02",
      "scene_title": "프레임 수에는 기준 속도가 필요하다",
      "text": "같은 열두 프레임도 서른 번 나누는 기준에서는 영 점 사 초입니다.",
      "start": 36.7825,
      "end": 40.6825
    },
    {
      "index": 12,
      "scene_id": "02",
      "scene_title": "프레임 수에는 기준 속도가 필요하다",
      "text": "숫자가 같아도 실제 기다리는 시간은 두 배가 됩니다.",
      "start": 40.6825,
      "end": 43.942499999999995
    },
    {
      "index": 13,
      "scene_id": "02",
      "scene_title": "프레임 수에는 기준 속도가 필요하다",
      "text": "그래서 이 테스트는 일 초에 예순 번 갱신하는 규칙으로 고정했습니다.",
      "start": 43.942499999999995,
      "end": 48.2325
    },
    {
      "index": 14,
      "scene_id": "02",
      "scene_title": "프레임 수에는 기준 속도가 필요하다",
      "text": "화면에는 시간을 함께 적고, 움직이는 표시로 차이를 보여 줍니다.",
      "start": 48.2325,
      "end": 52.2725
    },
    {
      "index": 15,
      "scene_id": "02",
      "scene_title": "프레임 수에는 기준 속도가 필요하다",
      "text": "설계 메모에도 프레임 수와 기준 속도를 한 쌍으로 남기세요.",
      "start": 52.2725,
      "end": 56.2725
    },
    {
      "index": 16,
      "scene_id": "02",
      "scene_title": "프레임 수에는 기준 속도가 필요하다",
      "text": "렌더링 속도와 게임 규칙의 갱신 속도가 다를 수도 있습니다.",
      "start": 56.2725,
      "end": 59.92
    },
    {
      "index": 17,
      "scene_id": "03",
      "scene_title": "동작의 어느 구간을 재는가",
      "text": "이제 한 번의 공격에서 무엇을 재는지 정해 보죠.",
      "start": 60.64,
      "end": 63.4425
    },
    {
      "index": 18,
      "scene_id": "03",
      "scene_title": "동작의 어느 구간을 재는가",
      "text": "직접 만든 테스트는 입력을 받은 순간을 영으로 기록합니다.",
      "start": 63.4425,
      "end": 67.6525
    },
    {
      "index": 19,
      "scene_id": "03",
      "scene_title": "동작의 어느 구간을 재는가",
      "text": "열두 번의 시간 눈금 뒤에 판정이 시작되고,",
      "start": 67.6525,
      "end": 70.52250000000001
    },
    {
      "index": 20,
      "scene_id": "03",
      "scene_title": "동작의 어느 구간을 재는가",
      "text": "세 번의 눈금 동안 유지된 다음, 열다섯 번 동안 회복합니다.",
      "start": 70.52250000000001,
      "end": 74.2825
    },
    {
      "index": 21,
      "scene_id": "03",
      "scene_title": "동작의 어느 구간을 재는가",
      "text": "전체는 서른 번의 눈금, 영 점 오 초입니다.",
      "start": 74.2825,
      "end": 76.0925
    },
    {
      "index": 22,
      "scene_id": "03",
      "scene_title": "동작의 어느 구간을 재는가",
      "text": "빠르게 해 달라는 요청이 준비 시간을 뜻한다면,",
      "start": 76.0925,
      "end": 79.5825
    },
    {
      "index": 23,
      "scene_id": "03",
      "scene_title": "동작의 어느 구간을 재는가",
      "text": "준비만 줄이고 나머지는 그대로 두어 비교할 수 있습니다.",
      "start": 79.5825,
      "end": 83.4825
    },
    {
      "index": 24,
      "scene_id": "03",
      "scene_title": "동작의 어느 구간을 재는가",
      "text": "시작과 끝을 어디에 찍었는지도 기록해야 같은 수를 셀 수 있습니다.",
      "start": 83.4825,
      "end": 87.5425
    },
    {
      "index": 25,
      "scene_id": "03",
      "scene_title": "동작의 어느 구간을 재는가",
      "text": "다른 게임의 기술 수치를 이 테스트 숫자로 대신 설명하지는 않습니다.",
      "start": 87.5425,
      "end": 91.92
    },
    {
      "index": 26,
      "scene_id": "04",
      "scene_title": "그림 시계와 판정 시계",
      "text": "그림이 많아지면 판정도 빨라질까요?",
      "start": 92.64,
      "end": 95.5525
    },
    {
      "index": 27,
      "scene_id": "04",
      "scene_title": "그림 시계와 판정 시계",
      "text": "이번에는 같은 공격에 자세 그림만 다르게 넣었습니다.",
      "start": 95.5525,
      "end": 99.4725
    },
    {
      "index": 28,
      "scene_id": "04",
      "scene_title": "그림 시계와 판정 시계",
      "text": "한쪽은 적은 자세를 오래 보여 주고, 다른 쪽은 자주 바꿉니다.",
      "start": 99.4725,
      "end": 102.0825
    },
    {
      "index": 29,
      "scene_id": "04",
      "scene_title": "그림 시계와 판정 시계",
      "text": "두 버전의 판정은 같은 열두 번째 시간 눈금에 시작합니다.",
      "start": 102.0825,
      "end": 106.5025
    },
    {
      "index": 30,
      "scene_id": "04",
      "scene_title": "그림 시계와 판정 시계",
      "text": "표현의 부드러움은 달라도 공격을 기다리는 시간은 같습니다.",
      "start": 106.5025,
      "end": 111.3125
    },
    {
      "index": 31,
      "scene_id": "04",
      "scene_title": "그림 시계와 판정 시계",
      "text": "그래서 애니메이션 그림을 넘기는 시계와 판정 시계를 구분합니다.",
      "start": 111.3125,
      "end": 115.3225
    },
    {
      "index": 32,
      "scene_id": "04",
      "scene_title": "그림 시계와 판정 시계",
      "text": "그림을 늘리기 전에 어떤 시간을 바꾸려는지 먼저 확인하세요.",
      "start": 115.3225,
      "end": 119.0825
    },
    {
      "index": 33,
      "scene_id": "04",
      "scene_title": "그림 시계와 판정 시계",
      "text": "그림과 판정을 분리했는지는 실제 코드와 로그로 검증했습니다.",
      "start": 119.0825,
      "end": 123.28
    },
    {
      "index": 34,
      "scene_id": "05",
      "scene_title": "멈춤은 어느 시계에 더해지는가",
      "text": "맞는 순간 잠깐 멈추는 연출도 살펴보겠습니다.",
      "start": 124.0,
      "end": 127.6825
    },
    {
      "index": 35,
      "scene_id": "05",
      "scene_title": "멈춤은 어느 시계에 더해지는가",
      "text": "자체 테스트에서는 충돌 뒤 전투 시계만 네 번의 눈금 동안 멈춥니다.",
      "start": 127.6825,
      "end": 132.2125
    },
    {
      "index": 36,
      "scene_id": "05",
      "scene_title": "멈춤은 어느 시계에 더해지는가",
      "text": "배경의 시간 표시는 계속 움직입니다.",
      "start": 132.2125,
      "end": 134.8225
    },
    {
      "index": 37,
      "scene_id": "05",
      "scene_title": "멈춤은 어느 시계에 더해지는가",
      "text": "공격 데이터는 서른 눈금 그대로지만,",
      "start": 134.8225,
      "end": 136.1225
    },
    {
      "index": 38,
      "scene_id": "05",
      "scene_title": "멈춤은 어느 시계에 더해지는가",
      "text": "실제로 끝날 때까지는 멈춘 시간까지 더해집니다.",
      "start": 136.1225,
      "end": 140.3625
    },
    {
      "index": 39,
      "scene_id": "05",
      "scene_title": "멈춤은 어느 시계에 더해지는가",
      "text": "즉, 멈춤이 있는 동작을 볼 때는 어느 시계를 센 것인지 물어봐야 합니다.",
      "start": 140.3625,
      "end": 145.3825
    },
    {
      "index": 40,
      "scene_id": "05",
      "scene_title": "멈춤은 어느 시계에 더해지는가",
      "text": "상용 게임의 모든 효과가 이 방식이라는 뜻은 아닙니다.",
      "start": 145.3825,
      "end": 148.5825
    },
    {
      "index": 41,
      "scene_id": "05",
      "scene_title": "멈춤은 어느 시계에 더해지는가",
      "text": "우리 게임에서 멈출 대상과 계속 흐를 대상을 명확히 정하는 예시입니다.",
      "start": 148.5825,
      "end": 153.28
    },
    {
      "index": 42,
      "scene_id": "06",
      "scene_title": "눈으로 찾고 로그로 확인하기",
      "text": "마지막으로 녹화 영상에서 센 프레임은 증거의 한 종류일 뿐입니다.",
      "start": 154.0,
      "end": 158.1925
    },
    {
      "index": 43,
      "scene_id": "06",
      "scene_title": "눈으로 찾고 로그로 확인하기",
      "text": "그림이 반복되거나 빠지면 게임 내부의 시간을 그대로 읽기 어렵습니다.",
      "start": 158.1925,
      "end": 162.7025
    },
    {
      "index": 44,
      "scene_id": "06",
      "scene_title": "눈으로 찾고 로그로 확인하기",
      "text": "같은 테스트를 서로 다른 화면 갱신 속도로 보아도,",
      "start": 162.7025,
      "end": 165.7725
    },
    {
      "index": 45,
      "scene_id": "06",
      "scene_title": "눈으로 찾고 로그로 확인하기",
      "text": "고정된 판정 시계가 같으면 같은 시간에 판정이 나옵니다.",
      "start": 165.7725,
      "end": 169.4225
    },
    {
      "index": 46,
      "scene_id": "06",
      "scene_title": "눈으로 찾고 로그로 확인하기",
      "text": "처음에는 정상 속도로 보고 길이를 가늠해 보세요.",
      "start": 169.4225,
      "end": 172.4425
    },
    {
      "index": 47,
      "scene_id": "06",
      "scene_title": "눈으로 찾고 로그로 확인하기",
      "text": "다음에는 입력, 판정 시작, 다음 행동 가능 시점을 기록합니다.",
      "start": 172.4425,
      "end": 176.2825
    },
    {
      "index": 48,
      "scene_id": "06",
      "scene_title": "눈으로 찾고 로그로 확인하기",
      "text": "기준 속도와 실제 경과 시간을 함께 확인하면,",
      "start": 176.2825,
      "end": 179.4625
    },
    {
      "index": 49,
      "scene_id": "06",
      "scene_title": "눈으로 찾고 로그로 확인하기",
      "text": "조금 빠르게라는 말이 함께 검토할 수 있는 수정안이 됩니다.",
      "start": 179.4625,
      "end": 182.7525
    },
    {
      "index": 50,
      "scene_id": "06",
      "scene_title": "눈으로 찾고 로그로 확인하기",
      "text": "감각으로 먼저 찾고, 측정으로 확인해 보세요.",
      "start": 182.7525,
      "end": 185.6
    }
  ]
}
