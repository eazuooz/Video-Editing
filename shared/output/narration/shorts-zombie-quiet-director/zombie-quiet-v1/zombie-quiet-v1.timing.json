  "entries": [
    {
      "index": 1,
      "scene_id": "01",
      "scene_title": "조용함과 안전은 다르다",
      "text": "좀비가 뚝 끊겼다고, 안심했죠?",
      "start": 0.0,
      "end": 1.6225
    },
    {
      "index": 2,
      "scene_id": "01",
      "scene_title": "조용함과 안전은 다르다",
      "text": "레프트 포 데드에선 게임이 쉬는 시간을 만든 걸 수 있어요.",
      "start": 1.6225,
      "end": 6.0925
    },
    {
      "index": 3,
      "scene_id": "01",
      "scene_title": "조용함과 안전은 다르다",
      "text": "에이아이 디렉터가 피해와 쓰러짐 같은 사건으로 팀의 긴장도를 추정하거든요.",
      "start": 6.0925,
      "end": 10.9125
    },
    {
      "index": 4,
      "scene_id": "01",
      "scene_title": "조용함과 안전은 다르다",
      "text": "격전 뒤엔 새 무리의 등장을 억제해 숨 돌릴 틈을 만듭니다.",
      "start": 10.9125,
      "end": 14.9325
    },
    {
      "index": 5,
      "scene_id": "01",
      "scene_title": "조용함과 안전은 다르다",
      "text": "적을 약하게 만드는 대신, 싸움과 휴식의 리듬, 페이싱을 조절하는 거죠.",
      "start": 14.9325,
      "end": 18.6225
    },
    {
      "index": 6,
      "scene_id": "01",
      "scene_title": "조용함과 안전은 다르다",
      "text": "물론 남아 있는 적은 공격하고, 보스는 예외예요.",
      "start": 18.6225,
      "end": 22.2725
    },
    {
      "index": 7,
      "scene_id": "01",
      "scene_title": "조용함과 안전은 다르다",
      "text": "그런데 프로젝트 좀보이드의 정적은 같은 휴식 신호가 아닙니다.",
      "start": 22.2725,
      "end": 27.0325
    },
    {
      "index": 8,
      "scene_id": "01",
      "scene_title": "조용함과 안전은 다르다",
      "text": "먼 총성 같은 메타 이벤트가 기존 좀비들을 소리 쪽으로 움직일 수 있죠.",
      "start": 27.0325,
      "end": 31.2325
    },
    {
      "index": 9,
      "scene_id": "01",
      "scene_title": "조용함과 안전은 다르다",
      "text": "그래서 조용한 길도 주변 무리가 이동하면 다시 위험해질 수 있어요.",
      "start": 31.2325,
      "end": 35.4625
    },
    {
      "index": 10,
      "scene_id": "01",
      "scene_title": "조용함과 안전은 다르다",
      "text": "레포데에선 다음 공격의 박자를, 좀보이드에선 주변 무리의 이동을 보는 겁니다.",
      "start": 35.4625,
      "end": 40.3725
    },
    {
      "index": 11,
      "scene_id": "01",
      "scene_title": "조용함과 안전은 다르다",
      "text": "좀비가 안 보이는 지금도, 안전을 보장하진 않아요.",
      "start": 40.3725,
      "end": 43.6
    }
  ]
}
