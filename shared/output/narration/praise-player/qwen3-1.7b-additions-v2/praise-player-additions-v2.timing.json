  "entries": [
    {
      "index": 1,
      "scene_id": "01",
      "scene_title": "결과와 인정하는 반응 구별하기",
      "text": "닌텐도 스위치 스포츠의 볼링에서 공이 굴러가고 핀이 쓰러지는 장면을 보세요.",
      "start": 0.0,
      "end": 4.96,
      "voice_start": 0.0,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 2,
      "scene_id": "01",
      "scene_title": "결과와 인정하는 반응 구별하기",
      "text": "핀의 변화는 행동의 결과입니다. 이 장면에 없는 스트라이크 문구를 붙이지는 않습니다.",
      "start": 5.2,
      "end": 10.28,
      "voice_start": 5.2,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 3,
      "scene_id": "01",
      "scene_title": "결과와 인정하는 반응 구별하기",
      "text": "결과를 알아보는 일과 잘했다고 인정받는 경험을 나누어 보는 출발점입니다.",
      "start": 10.72,
      "end": 15.3,
      "voice_start": 10.72,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 4,
      "scene_id": "01",
      "scene_title": "결과와 인정하는 반응 구별하기",
      "text": "하이파이 러시에서는 공격 뒤에 타격 수와 점수, 평가 표시가 함께 변합니다.",
      "start": 15.6,
      "end": 20.42,
      "voice_start": 15.6,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 5,
      "scene_id": "01",
      "scene_title": "결과와 인정하는 반응 구별하기",
      "text": "숫자가 늘어나는 모습과 순간적으로 나타나는 퍼펙트 반응을 구별해 보세요.",
      "start": 20.62,
      "end": 24.86,
      "voice_start": 20.62,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 6,
      "scene_id": "01",
      "scene_title": "결과와 인정하는 반응 구별하기",
      "text": "같은 화면에서도 기록을 알려 주는 표시와 특정 행동을 인정하는 반응은 역할이 다릅니다.",
      "start": 25.26,
      "end": 29.9,
      "voice_start": 25.26,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 7,
      "scene_id": "01",
      "scene_title": "결과와 인정하는 반응 구별하기",
      "text": "링 피트의 운동 평가와 스위치 스포츠의 승리 화면도 서로 다른 구간을 말해 줍니다.",
      "start": 30.0,
      "end": 35.3,
      "voice_start": 30.0,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 8,
      "scene_id": "01",
      "scene_title": "결과와 인정하는 반응 구별하기",
      "text": "동작 하나를 마쳤을 때의 반응인지, 경기 전체의 결과인지 먼저 확인하는 것입니다.",
      "start": 35.62,
      "end": 40.38,
      "voice_start": 35.62,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 9,
      "scene_id": "01",
      "scene_title": "결과와 인정하는 반응 구별하기",
      "text": "앞의 비교처럼 보상 규칙을 유지한 채 어떤 성공을 드러낼지 정하면 칭찬의 목적이 선명해집니다.",
      "start": 40.78,
      "end": 46.26,
      "voice_start": 40.78,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 10,
      "scene_id": "02",
      "scene_title": "동작 가까이에 반응 붙이기",
      "text": "하이파이 러시의 공격 장면에서 캐릭터의 동작과 화면 표시가 바뀌는 순서를 보세요.",
      "start": 47.199999999999996,
      "end": 51.9,
      "voice_start": 47.199999999999996,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 11,
      "scene_id": "02",
      "scene_title": "동작 가까이에 반응 붙이기",
      "text": "성공을 나타내는 반응이 어떤 공격 뒤에 붙는지 알아볼 수 있어야 합니다.",
      "start": 52.16,
      "end": 55.919999999999995,
      "voice_start": 52.16,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 12,
      "scene_id": "02",
      "scene_title": "동작 가까이에 반응 붙이기",
      "text": "이어서 보이는 박자 표시 자체는 다음 동작을 위한 안내입니다. 그것만으로 성공은 아닙니다.",
      "start": 56.199999999999996,
      "end": 61.419999999999995,
      "voice_start": 56.199999999999996,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 13,
      "scene_id": "02",
      "scene_title": "동작 가까이에 반응 붙이기",
      "text": "전투 중에 나타나는 평가와 안내를 나누고, 실제 공격 결과가 나오는 순간을 살펴봅니다.",
      "start": 61.58,
      "end": 66.91999999999999,
      "voice_start": 61.58,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 14,
      "scene_id": "02",
      "scene_title": "동작 가까이에 반응 붙이기",
      "text": "다음 행동이 이어져도 방금의 결과를 읽을 틈이 있는지가 앞의 지연 비교와 연결됩니다.",
      "start": 67.39999999999999,
      "end": 72.78,
      "voice_start": 67.39999999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 15,
      "scene_id": "02",
      "scene_title": "동작 가까이에 반응 붙이기",
      "text": "여기서는 음악을 가져오지 않고, 정상 속도의 동작과 화면 반응 사이의 관계를 관찰합니다.",
      "start": 72.78,
      "end": 78.12,
      "voice_start": 72.78,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 16,
      "scene_id": "02",
      "scene_title": "동작 가까이에 반응 붙이기",
      "text": "링 피트에서도 자세를 유지하라는 안내와 동작 뒤의 평가가 서로 다른 시점에 나옵니다.",
      "start": 78.72,
      "end": 83.52,
      "voice_start": 78.72,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 17,
      "scene_id": "02",
      "scene_title": "동작 가까이에 반응 붙이기",
      "text": "홀드와 리턴은 행동 지시이고, 그레이트와 굿은 수행을 평가하는 반응입니다.",
      "start": 84.0,
      "end": 88.22,
      "voice_start": 84.0,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 18,
      "scene_id": "02",
      "scene_title": "동작 가까이에 반응 붙이기",
      "text": "같은 위치에 글자가 뜬다는 이유만으로 안내와 칭찬을 같은 사건으로 처리하지 마세요.",
      "start": 88.69999999999999,
      "end": 93.28,
      "voice_start": 88.69999999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 19,
      "scene_id": "03",
      "scene_title": "어떤 행동을 인정하는가",
      "text": "하이파이 러시의 연속 공격에서는 입력 안내와 실제 타격 결과를 함께 볼 수 있습니다.",
      "start": 94.07999999999998,
      "end": 99.47999999999999,
      "voice_start": 94.07999999999998,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 20,
      "scene_id": "03",
      "scene_title": "어떤 행동을 인정하는가",
      "text": "어떤 버튼을 누르라는 표시와 공격이 맞았다는 반응을 따로 따라가 보세요.",
      "start": 99.91999999999999,
      "end": 104.23999999999998,
      "voice_start": 99.91999999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 21,
      "scene_id": "03",
      "scene_title": "어떤 행동을 인정하는가",
      "text": "입력이 있었다는 사실만으로 그 동작이 성공했다고 말할 수는 없습니다.",
      "start": 104.75999999999999,
      "end": 109.03999999999999,
      "voice_start": 104.75999999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 22,
      "scene_id": "03",
      "scene_title": "어떤 행동을 인정하는가",
      "text": "칭찬을 설계할 때도 막기인지, 피하기인지, 공격의 타이밍인지 대상을 먼저 정합니다.",
      "start": 109.47999999999999,
      "end": 115.33999999999999,
      "voice_start": 109.47999999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 23,
      "scene_id": "03",
      "scene_title": "어떤 행동을 인정하는가",
      "text": "링 피트의 홀드와 천천히 내려가라는 문구는 자세를 알려 줍니다.",
      "start": 115.51999999999998,
      "end": 119.57999999999998,
      "voice_start": 115.51999999999998,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 24,
      "scene_id": "03",
      "scene_title": "어떤 행동을 인정하는가",
      "text": "그 뒤의 그레이트 평가와는 목적이 다르다는 것을 화면에서 확인해 보세요.",
      "start": 119.83999999999999,
      "end": 123.87999999999998,
      "voice_start": 119.83999999999999,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 25,
      "scene_id": "03",
      "scene_title": "어떤 행동을 인정하는가",
      "text": "스위치 스포츠의 라켓 안내도 어느 방향으로 움직일지 알려 주는 정보입니다.",
      "start": 124.07999999999998,
      "end": 128.92,
      "voice_start": 124.07999999999998,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 26,
      "scene_id": "03",
      "scene_title": "어떤 행동을 인정하는가",
      "text": "반면 전투의 평가 표시는 수행한 행동 뒤에 붙습니다. 글자보다 연결된 사건을 봅니다.",
      "start": 129.11999999999998,
      "end": 135.2,
      "voice_start": 129.11999999999998,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 27,
      "scene_id": "03",
      "scene_title": "어떤 행동을 인정하는가",
      "text": "내 게임의 잘했어요라는 말도 무엇을 잘했는지 짧게 바꾸어 적으면 수정할 지점이 보입니다.",
      "start": 135.57999999999998,
      "end": 140.85999999999999,
      "voice_start": 135.57999999999998,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 28,
      "scene_id": "04",
      "scene_title": "작은 성공과 큰 마무리의 강도",
      "text": "하이파이 러시에서는 이어지는 타격과 큰 동작의 효과를 서로 다른 크기로 보여 줍니다.",
      "start": 141.60004166666664,
      "end": 147.00004166666665,
      "voice_start": 141.60004166666664,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 29,
      "scene_id": "04",
      "scene_title": "작은 성공과 큰 마무리의 강도",
      "text": "구석의 점수와 평가가 계속 보이는 동안에도 전투의 중심에서는 다음 공격이 이어집니다.",
      "start": 147.42004166666663,
      "end": 152.64004166666663,
      "voice_start": 147.42004166666663,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 30,
      "scene_id": "04",
      "scene_title": "작은 성공과 큰 마무리의 강도",
      "text": "작은 성공마다 긴 장면을 멈추지 않아도 결과를 알아볼 수 있는지 관찰해 보세요.",
      "start": 152.98004166666664,
      "end": 157.38004166666664,
      "voice_start": 152.98004166666664,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 31,
      "scene_id": "04",
      "scene_title": "작은 성공과 큰 마무리의 강도",
      "text": "다른 전투 구간에서도 짧은 타격 반응과 강한 공격 효과를 차례로 볼 수 있습니다.",
      "start": 157.72004166666665,
      "end": 162.60004166666664,
      "voice_start": 157.72004166666665,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 32,
      "scene_id": "04",
      "scene_title": "작은 성공과 큰 마무리의 강도",
      "text": "이 컷들은 같은 점수 규칙을 둔 두 실험 버전이 아닙니다. 각 화면의 역할을 찾는 예시입니다.",
      "start": 162.94004166666664,
      "end": 168.42004166666663,
      "voice_start": 162.94004166666664,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 33,
      "scene_id": "04",
      "scene_title": "작은 성공과 큰 마무리의 강도",
      "text": "앞의 자체 비교처럼 규칙을 고정한 실험에서는 반응의 크기만 바꾸어 확인할 수 있습니다.",
      "start": 168.42004166666663,
      "end": 174.00004166666665,
      "voice_start": 168.42004166666663,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 34,
      "scene_id": "04",
      "scene_title": "작은 성공과 큰 마무리의 강도",
      "text": "링 피트의 승리와 레벨 상승, 스포츠의 순위 변화는 더 긴 구간의 마무리를 보여 줍니다.",
      "start": 174.64004166666663,
      "end": 179.44004166666664,
      "voice_start": 174.64004166666663,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 35,
      "scene_id": "04",
      "scene_title": "작은 성공과 큰 마무리의 강도",
      "text": "동작 중의 평가와 완료 뒤의 축하를 구분하면 모든 성공을 크게 과장할 필요가 줄어듭니다.",
      "start": 179.98004166666664,
      "end": 185.38004166666664,
      "voice_start": 179.98004166666664,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 36,
      "scene_id": "04",
      "scene_title": "작은 성공과 큰 마무리의 강도",
      "text": "한 번의 행동, 이어진 성과, 큰 구간의 끝에 각각 어떤 반응을 둘지 나누어 적어 보세요.",
      "start": 185.94004166666664,
      "end": 191.32004166666664,
      "voice_start": 185.94004166666664,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 37,
      "scene_id": "05",
      "scene_title": "부분의 성공을 정직하게 다루기",
      "text": "하이파이 러시의 전투에는 낮은 평가가 보이는 구간도 있습니다. 등급과 실제 동작을 함께 봅니다.",
      "start": 192.88004166666664,
      "end": 198.84004166666665,
      "voice_start": 192.88004166666664,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 38,
      "scene_id": "05",
      "scene_title": "부분의 성공을 정직하게 다루기",
      "text": "다른 장면에서는 장치에 맞춘 동작 뒤에 퍼펙트 반응이 나타납니다. 이것은 그 행동의 평가입니다.",
      "start": 199.16004166666664,
      "end": 205.80004166666663,
      "voice_start": 199.16004166666664,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 39,
      "scene_id": "05",
      "scene_title": "부분의 성공을 정직하게 다루기",
      "text": "한 행동의 성공을 전체 플레이가 완벽했다는 선언으로 넓히지 않는 것이 앞의 정직한 반응과 연결됩니다.",
      "start": 206.06004166666665,
      "end": 212.20004166666664,
      "voice_start": 206.06004166666665,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 40,
      "scene_id": "05",
      "scene_title": "부분의 성공을 정직하게 다루기",
      "text": "능력 상태를 보여 주는 메뉴와 전투의 평가도 구별해야 합니다. 상태 정보는 칭찬 자체가 아닙니다.",
      "start": 212.78004166666665,
      "end": 218.80004166666663,
      "voice_start": 212.78004166666665,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 41,
      "scene_id": "05",
      "scene_title": "부분의 성공을 정직하게 다루기",
      "text": "화면에 보인 특정 타격과 등급만 기록하고, 보이지 않은 실패나 완료 조건을 만들어 내지 않습니다.",
      "start": 218.80004166666663,
      "end": 225.04004166666664,
      "voice_start": 218.80004166666663,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 42,
      "scene_id": "05",
      "scene_title": "부분의 성공을 정직하게 다루기",
      "text": "실패 중에도 어떤 부분을 인정할지는 실제로 성공한 행동을 기준으로 정하는 것입니다.",
      "start": 225.48004166666664,
