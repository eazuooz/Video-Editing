{
  "sample_rate": 24000,
  "duration_seconds": 211.51999999999998,
  "render_mode": "scene",
  "example_seconds": 19.5,
  "narration_placement": "continuous-across-example-and-explanation",
  "entries": [
    {
      "index": 1,
      "scene_id": "01",
      "scene_title": "점수와 성공 인정은 구분된다",
      "text": "닌텐도 스위치 스포츠에서는 경기 뒤에 승리 표시와 축하하는 동작이 나옵니다.",
      "start": 0.0,
      "end": 5.2125
    },
    {
      "index": 2,
      "scene_id": "01",
      "scene_title": "점수와 성공 인정은 구분된다",
      "text": "링 피트 어드벤처에서는 운동 동작과 함께 평가 표시가 이어집니다.",
      "start": 5.2125,
      "end": 9.8825
    },
    {
      "index": 3,
      "scene_id": "01",
      "scene_title": "점수와 성공 인정은 구분된다",
      "text": "같은 점수를 받아도, 게임이 내 행동을 알아봐 주면 장면이 달라집니다.",
      "start": 9.8825,
      "end": 14.6225
    },
    {
      "index": 4,
      "scene_id": "01",
      "scene_title": "점수와 성공 인정은 구분된다",
      "text": "성공했다는 계산과, 그 성공을 반겨 주는 표현은 구분할 수 있습니다.",
      "start": 14.6225,
      "end": 18.8225
    },
    {
      "index": 5,
      "scene_id": "01",
      "scene_title": "점수와 성공 인정은 구분된다",
      "text": "오늘은 보상을 더 주는 방법보다, 이미 한 행동을 어떻게 인정할지 살펴보겠습니다.",
      "start": 18.8225,
      "end": 24.2925
    },
    {
      "index": 6,
      "scene_id": "01",
      "scene_title": "점수와 성공 인정은 구분된다",
      "text": "직접 만든 방어 테스트는 두 화면에 같은 입력과 판정을 적용합니다.",
      "start": 24.2925,
      "end": 28.8625
    },
    {
      "index": 7,
      "scene_id": "01",
      "scene_title": "점수와 성공 인정은 구분된다",
      "text": "달라지는 것은 칭찬의 시점, 문구, 크기와 위치입니다.",
      "start": 28.8625,
      "end": 31.1825
    },
    {
      "index": 8,
      "scene_id": "01",
      "scene_title": "점수와 성공 인정은 구분된다",
      "text": "재미의 차이는 직접 확인해야 하지만, 무엇을 바꿨는지는 로그로 확인할 수 있습니다.",
      "start": 31.1825,
      "end": 37.28
    },
    {
      "index": 9,
      "scene_id": "02",
      "scene_title": "성공과 가까운 순간에 반응하기",
      "text": "먼저 칭찬이 언제 나오는지 비교해 보죠.",
      "start": 38.0,
      "end": 40.4925
    },
    {
      "index": 10,
      "scene_id": "02",
      "scene_title": "성공과 가까운 순간에 반응하기",
      "text": "두 캐릭터는 같은 공격을 같은 순간에 막습니다.",
      "start": 40.4925,
      "end": 43.7825
    },
    {
      "index": 11,
      "scene_id": "02",
      "scene_title": "성공과 가까운 순간에 반응하기",
      "text": "한쪽은 곧바로 반응하고, 다른 쪽은 한참 뒤에 반응합니다.",
      "start": 43.7825,
      "end": 47.8025
    },
    {
      "index": 12,
      "scene_id": "02",
      "scene_title": "성공과 가까운 순간에 반응하기",
      "text": "기다리는 동안 다음 공격이 오면, 어느 행동을 칭찬했는지 연결하기 어렵습니다.",
      "start": 47.8025,
      "end": 52.5525
    },
    {
      "index": 13,
      "scene_id": "02",
      "scene_title": "성공과 가까운 순간에 반응하기",
      "text": "그래서 성공 판정과 가까운 순간에 짧은 반응을 붙여 봅니다.",
      "start": 52.5525,
      "end": 56.3125
    },
    {
      "index": 14,
      "scene_id": "02",
      "scene_title": "성공과 가까운 순간에 반응하기",
      "text": "크게 띄우지 않아도, 방금 한 행동을 알아봤다는 신호를 줄 수 있습니다.",
      "start": 56.3125,
      "end": 60.8825
    },
    {
      "index": 15,
      "scene_id": "02",
      "scene_title": "성공과 가까운 순간에 반응하기",
      "text": "모든 게임에 같은 지연 시간을 넣으라는 뜻은 아닙니다.",
      "start": 60.8825,
      "end": 64.4025
    },
    {
      "index": 16,
      "scene_id": "02",
      "scene_title": "성공과 가까운 순간에 반응하기",
      "text": "우리 게임의 다음 행동과 겹치는지, 정상 속도로 확인하는 기준입니다.",
      "start": 64.4025,
      "end": 68.8
    },
    {
      "index": 17,
      "scene_id": "03",
      "scene_title": "실제로 해낸 행동을 말하기",
      "text": "잘했어요라는 말만으로는 무엇을 잘했는지 알기 어렵습니다.",
      "start": 69.52,
      "end": 73.76249999999999
    },
    {
      "index": 18,
      "scene_id": "03",
      "scene_title": "실제로 해낸 행동을 말하기",
      "text": "이번 테스트는 공격을 막고, 다음 공격은 위로 움직여 피합니다.",
      "start": 73.76249999999999,
      "end": 77.6925
    },
    {
      "index": 19,
      "scene_id": "03",
      "scene_title": "실제로 해낸 행동을 말하기",
      "text": "한 화면은 같은 칭찬을 반복하고, 다른 화면은 방어와 회피를 구분합니다.",
      "start": 77.6925,
      "end": 82.8125
    },
    {
      "index": 20,
      "scene_id": "03",
      "scene_title": "실제로 해낸 행동을 말하기",
      "text": "판정이 실제로 확인한 행동을 짧게 적어 주는 것입니다.",
      "start": 82.8125,
      "end": 86.0625
    },
    {
      "index": 21,
      "scene_id": "03",
      "scene_title": "실제로 해낸 행동을 말하기",
      "text": "버튼을 누르기만 했는데 완벽한 방어라고 하면, 표현과 결과가 어긋납니다.",
      "start": 86.0625,
      "end": 91.1125
    },
    {
      "index": 22,
      "scene_id": "03",
      "scene_title": "실제로 해낸 행동을 말하기",
      "text": "입력 이벤트 대신 성공 판정을 기준으로 문구를 선택해 보세요.",
      "start": 91.1125,
      "end": 95.2025
    },
    {
      "index": 23,
      "scene_id": "03",
      "scene_title": "실제로 해낸 행동을 말하기",
      "text": "다음에도 어떤 행동을 해 볼지 스스로 알아볼 수 있는 정보가 됩니다.",
      "start": 95.2025,
      "end": 99.5225
    },
    {
      "index": 24,
      "scene_id": "03",
      "scene_title": "실제로 해낸 행동을 말하기",
      "text": "칭찬이 설명서를 대신할 필요는 없지만, 이유를 숨길 필요도 없습니다.",
      "start": 99.5225,
      "end": 104.0
    },
    {
      "index": 25,
      "scene_id": "04",
      "scene_title": "성과에 맞는 칭찬의 강도",
      "text": "성공할 때마다 가장 큰 축하를 보내면, 특별한 순간이 구분되지 않습니다.",
      "start": 104.72,
      "end": 109.0525
    },
    {
      "index": 26,
      "scene_id": "04",
      "scene_title": "성과에 맞는 칭찬의 강도",
      "text": "스위치 스포츠의 경기 승리처럼, 마무리에는 넓은 축하 화면이 어울릴 수 있습니다.",
      "start": 109.0525,
      "end": 114.4125
    },
    {
      "index": 27,
      "scene_id": "04",
      "scene_title": "성과에 맞는 칭찬의 강도",
      "text": "하지만 진행 중의 작은 성공마다 같은 크기를 쓰면 다음 상황을 가릴 수 있죠.",
      "start": 114.4125,
      "end": 119.2325
    },
    {
      "index": 28,
      "scene_id": "04",
      "scene_title": "성과에 맞는 칭찬의 강도",
      "text": "자체 테스트는 한 번의 방어에는 작은 표시를 냅니다.",
      "start": 119.2325,
      "end": 122.6525
    },
    {
      "index": 29,
      "scene_id": "04",
      "scene_title": "성과에 맞는 칭찬의 강도",
      "text": "연속 방어가 실제로 확인된 순간에만 조금 더 강한 반응을 냅니다.",
      "start": 122.6525,
      "end": 126.6525
    },
    {
      "index": 30,
      "scene_id": "04",
      "scene_title": "성과에 맞는 칭찬의 강도",
      "text": "비교 화면의 점수와 성공 횟수는 같고, 표현의 강도만 다릅니다.",
      "start": 126.6525,
      "end": 131.8325
    },
    {
      "index": 31,
      "scene_id": "04",
      "scene_title": "성과에 맞는 칭찬의 강도",
      "text": "작은 성공, 이어진 성공, 긴 구간의 완료를 나눠 보세요.",
      "start": 131.8325,
      "end": 134.8625
    },
    {
      "index": 32,
      "scene_id": "04",
      "scene_title": "성과에 맞는 칭찬의 강도",
      "text": "칭찬의 크기를 플레이어가 실제로 해낸 일에 맞추는 방법입니다.",
      "start": 134.8625,
      "end": 139.04
    },
    {
      "index": 33,
      "scene_id": "05",
      "scene_title": "실패를 숨기지 않는 긍정",
      "text": "실패한 순간에도 무조건 완벽하다고 하면, 칭찬을 믿기 어려워집니다.",
      "start": 139.76,
      "end": 144.2325
    },
    {
      "index": 34,
      "scene_id": "05",
      "scene_title": "실패를 숨기지 않는 긍정",
      "text": "이번에는 같은 입력을 두 화면에 넣고, 한 번의 공격을 일부러 놓칩니다.",
      "start": 144.2325,
      "end": 148.6625
    },
    {
      "index": 35,
      "scene_id": "05",
      "scene_title": "실패를 숨기지 않는 긍정",
      "text": "체력도 똑같이 줄어드는데, 한쪽은 여전히 완벽하다는 말을 냅니다.",
      "start": 148.6625,
      "end": 152.9725
    },
    {
      "index": 36,
      "scene_id": "05",
      "scene_title": "실패를 숨기지 않는 긍정",
      "text": "다른 쪽은 맞았다는 결과를 보여 주고, 앞서 성공한 방어만 인정합니다.",
      "start": 152.9725,
      "end": 157.0425
    },
    {
      "index": 37,
      "scene_id": "05",
      "scene_title": "실패를 숨기지 않는 긍정",
      "text": "실패를 숨기지 않아도, 그 안에서 해낸 행동을 구체적으로 말할 수 있습니다.",
      "start": 157.0425,
      "end": 161.7525
    },
    {
      "index": 38,
      "scene_id": "05",
      "scene_title": "실패를 숨기지 않는 긍정",
      "text": "모든 실패에 칭찬을 붙일 필요도 없습니다.",
      "start": 161.7525,
      "end": 164.5025
    },
    {
      "index": 39,
      "scene_id": "05",
      "scene_title": "실패를 숨기지 않는 긍정",
      "text": "다시 시도할 단서는 따로 보여 주고, 성공과 실패의 신호는 구분하세요.",
      "start": 164.5025,
      "end": 168.8825
    },
    {
      "index": 40,
      "scene_id": "05",
      "scene_title": "실패를 숨기지 않는 긍정",
      "text": "따뜻한 표현도 실제 판정과 연결되어 있어야 다음 시도에 도움이 됩니다.",
      "start": 168.8825,
      "end": 173.44
    },
    {
      "index": 41,
      "scene_id": "06",
      "scene_title": "다음 행동의 자리를 남기기",
      "text": "마지막으로 칭찬이 다음 플레이를 방해하지 않는지 확인합니다.",
      "start": 174.16,
      "end": 178.3825
    },
    {
      "index": 42,
      "scene_id": "06",
      "scene_title": "다음 행동의 자리를 남기기",
      "text": "같은 공격 위에 큰 글자를 올리면, 다음 위협을 읽는 자리가 가려집니다.",
      "start": 178.3825,
      "end": 183.3425
    },
    {
      "index": 43,
      "scene_id": "06",
      "scene_title": "다음 행동의 자리를 남기기",
      "text": "이번 비교는 판정과 문구를 유지하고, 위치와 면적만 바꿨습니다.",
      "start": 183.3425,
      "end": 187.7525
    },
    {
      "index": 44,
      "scene_id": "06",
      "scene_title": "다음 행동의 자리를 남기기",
      "text": "행동 가까운 작은 표시와 가장자리의 짧은 반응을 비교해 보세요.",
      "start": 187.7525,
      "end": 191.8225
    },
    {
      "index": 45,
      "scene_id": "06",
      "scene_title": "다음 행동의 자리를 남기기",
      "text": "움직이는 대상과 필요한 정보를 가리지 않는지 휴대폰 크기에서도 확인합니다.",
      "start": 191.8225,
      "end": 196.6325
    },
    {
      "index": 46,
      "scene_id": "06",
      "scene_title": "다음 행동의 자리를 남기기",
      "text": "무엇을 인정하는가, 언제 말하는가, 얼마나 크게 말하는가를 함께 기록하세요.",
      "start": 196.6325,
      "end": 201.7925
    },
    {
      "index": 47,
      "scene_id": "06",
      "scene_title": "다음 행동의 자리를 남기기",
      "text": "칭찬 횟수만 늘리기보다, 방금 한 행동과 표현이 맞는지 먼저 확인합니다.",
      "start": 201.7925,
      "end": 206.6125
    },
    {
      "index": 48,
      "scene_id": "06",
      "scene_title": "다음 행동의 자리를 남기기",
      "text": "플레이어가 내가 해냈다고 느낄 순간을, 우리 게임의 실제 동작에서 찾아보세요.",
      "start": 206.6125,
      "end": 211.51999999999998
    }
  ]
}
