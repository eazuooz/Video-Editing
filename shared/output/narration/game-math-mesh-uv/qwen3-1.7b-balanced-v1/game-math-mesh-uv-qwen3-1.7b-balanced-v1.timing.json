  "entries": [
    {
      "index": 1,
      "scene_id": "01",
      "scene_title": "정점과 법선으로 표면을 저장하기",
      "text": "삼차원 물체의 형태와 빛 방향을 저장하려면 정점에 어떤 정보를 넣어야 할까요?",
      "start": 0.0,
      "end": 5.22,
      "voice_start": 0.14666666666666667,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 2,
      "scene_id": "01",
      "scene_title": "정점과 법선으로 표면을 저장하기",
      "text": "먼저 게임의 지붕과 바위를 보고, 삼각형을 인덱스로 연결하는 방법과 메모리 크기를 계산합니다.",
      "start": 5.52,
      "end": 11.12,
      "voice_start": 5.52,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 3,
      "scene_id": "01",
      "scene_title": "정점과 법선으로 표면을 저장하기",
      "text": "이어서 면 법선과 정점 법선을 비교하고, 이웃 면의 방향을 합산하는 알고리즘을 끝까지 따라갑니다.",
      "start": 11.4,
      "end": 18.2,
      "voice_start": 11.4,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 4,
      "scene_id": "01",
      "scene_title": "정점과 법선으로 표면을 저장하기",
      "text": "마지막에는 날카로운 모서리와 삼각분할의 편향을 처리하고, 직접 정한 작은 메시로 답을 확인하겠습니다.",
      "start": 18.4,
      "end": 24.46,
      "voice_start": 18.4,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 5,
      "scene_id": "02",
      "scene_title": "지붕 패널의 선이 전부 삼각형일까요?",
      "text": "선셋 오버드라이브에서 지붕 위를 이동하는 장면입니다. 경사진 지붕의 바깥 윤곽과 표면의 길게 반복되는 선을 따로 보세요.",
      "start": 24.93,
      "end": 32.65,
      "voice_start": 25.05,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 6,
      "scene_id": "02",
      "scene_title": "지붕 패널의 선이 전부 삼각형일까요?",
      "text": "옆으로 이동하면 지붕과 벽의 다른 면이 드러납니다. 모양을 정하는 표면과 그 위의 무늬를 같은 정보라고 생각하기 쉽습니다.",
      "start": 33.07,
      "end": 40.51,
      "voice_start": 33.07,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 7,
      "scene_id": "02",
      "scene_title": "지붕 패널의 선이 전부 삼각형일까요?",
      "text": "다음 지붕에서도 패널과 환기구가 보입니다. 외곽을 바꾸는 형태와 면 안에 보이는 선을 구분해 보세요.",
      "start": 40.85,
      "end": 47.29,
      "voice_start": 40.85,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 8,
      "scene_id": "02",
      "scene_title": "지붕 패널의 선이 전부 삼각형일까요?",
      "text": "이 선 하나마다 실제 모서리가 있는지는 완성 화면만으로 알 수 없습니다. 기하 구조와 텍스처가 모두 비슷한 선을 만들 수 있습니다.",
      "start": 47.55,
      "end": 55.09,
      "voice_start": 47.55,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 9,
      "scene_id": "02",
      "scene_title": "지붕 패널의 선이 전부 삼각형일까요?",
      "text": "그래서 먼저 우리가 직접 정의한 작은 메시로 저장 방식을 보겠습니다. 게임의 숨은 정점 개수를 추측하는 예제가 아닙니다.",
      "start": 55.489999999999995,
      "end": 62.51,
      "voice_start": 55.489999999999995,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 10,
      "scene_id": "03",
      "scene_title": "부피를 만드는 방법과 표면을 저장하는 방법",
      "text": "물체를 기술하는 방법은 하나가 아닙니다. 구성적 입체 기하는 기본 도형의 합집합, 교집합과 차집합으로 모양을 만듭니다.",
      "start": 63.06,
      "end": 71.96000000000001,
      "voice_start": 63.06,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 11,
      "scene_id": "03",
      "scene_title": "부피를 만드는 방법과 표면을 저장하는 방법",
      "text": "상자에서 원기둥을 빼면 구멍이 생기는 예를 생각해 보세요. 이것은 우리 도식의 부피 연산이며 게임 화면의 구현을 확인한 것은 아닙니다.",
      "start": 72.2,
      "end": 80.56,
      "voice_start": 72.2,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 12,
      "scene_id": "03",
      "scene_title": "부피를 만드는 방법과 표면을 저장하는 방법",
      "text": "메타볼처럼 부피나 암시적 함수를 사용하는 방법도 있습니다. 이런 표현과, 화면에 그릴 표면을 저장하는 표현은 목적이 다릅니다.",
      "start": 80.8,
      "end": 89.04,
      "voice_start": 80.8,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 13,
      "scene_id": "03",
      "scene_title": "부피를 만드는 방법과 표면을 저장하는 방법",
      "text": "삼각형 메시는 표면을 작은 평면 조각으로 연결합니다. 반드시 닫힌 물체일 필요는 없고, 열린 천이나 잎 같은 표면도 가능합니다.",
      "start": 89.38,
      "end": 97.88,
      "voice_start": 89.38,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 14,
      "scene_id": "03",
      "scene_title": "부피를 만드는 방법과 표면을 저장하는 방법",
      "text": "편집 도구의 다각형은 정점 수가 다양할 수 있습니다. 렌더링용으로 삼각형을 나누되, 이전 장에서 배운 유효한 삼각분할을 사용합니다.",
      "start": 98.08000000000001,
      "end": 106.28,
      "voice_start": 98.08000000000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 15,
      "scene_id": "03",
      "scene_title": "부피를 만드는 방법과 표면을 저장하는 방법",
      "text": "이제 관심은 삼각형 하나의 성질보다 여러 삼각형이 어떤 정점을 공유하는지입니다. 정점, 모서리와 면의 관계를 데이터로 옮깁니다.",
      "start": 106.58000000000001,
      "end": 114.26,
      "voice_start": 106.58000000000001,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 16,
      "scene_id": "04",
      "scene_title": "네 정점과 두 삼각형의 메모리를 계산하기",
      "text": "사각형을 두 삼각형으로 나눕니다. 정점은 영, 일, 이, 삼 네 개이고 삼각형 목록은 영 일 이, 영 이 삼으로 정합니다.",
      "start": 114.79,
      "end": 124.23,
      "voice_start": 114.79,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 17,
      "scene_id": "04",
      "scene_title": "네 정점과 두 삼각형의 메모리를 계산하기",
      "text": "단순 배열은 삼각형마다 정점 데이터 세 개를 저장합니다. 여기서는 같은 위치와 속성을 가진 영번과 이번 정보를 두 번 저장합니다.",
      "start": 124.4825,
      "end": 133.71,
      "voice_start": 124.4825,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 18,
      "scene_id": "04",
      "scene_title": "네 정점과 두 삼각형의 메모리를 계산하기",
      "text": "인덱스 방식은 정점 목록과 정수 목록을 나눕니다. 삼각형은 실제 데이터를 복사하는 대신 그 목록의 번호 세 개를 가리킵니다.",
      "start": 134.07,
      "end": 142.33,
      "voice_start": 134.07,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 19,
      "scene_id": "04",
      "scene_title": "네 정점과 두 삼각형의 메모리를 계산하기",
      "text": "정점 하나가 삼십이 바이트이고 인덱스가 이 바이트라고 약속합니다. 단순 배열은 육 곱하기 삼십이, 백구십이 바이트입니다.",
      "start": 142.37,
      "end": 150.81,
      "voice_start": 142.37,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 20,
      "scene_id": "04",
      "scene_title": "네 정점과 두 삼각형의 메모리를 계산하기",
      "text": "인덱스 방식은 사 곱하기 삼십이와 육 곱하기 이를 더합니다. 백이십팔 더하기 십이, 모두 백사십 바이트입니다.",
      "start": 151.53,
      "end": 159.09,
      "voice_start": 151.53,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 21,
      "scene_id": "04",
      "scene_title": "네 정점과 두 삼각형의 메모리를 계산하기",
      "text": "한 정점을 여섯 번 쓰는 국소 예도 보겠습니다. 정점 데이터는 삼십이 바이트입니다. 인덱스는 여섯 개에 이 바이트씩, 합이 십이 바이트입니다. 둘을 더한 사십사 바이트는 사각형 전체 백사십과 계산 범위가 다릅니다.",
      "start": 159.35000000000002,
      "end": 173.31,
      "voice_start": 159.35000000000002,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 22,
      "scene_id": "04",
      "scene_title": "네 정점과 두 삼각형의 메모리를 계산하기",
      "text": "총량은 정점 크기와 공유 정도, 인덱스 형식에 따라 달라집니다. 위치뿐 아니라 법선, 유브이, 색과 스키닝 정보도 같은 정점 레코드에 포함될 수 있습니다.",
      "start": 173.77,
      "end": 184.01,
      "voice_start": 173.77,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 23,
      "scene_id": "05",
      "scene_title": "같은 좌표와 같은 정점은 다릅니다",
      "text": "인덱스가 같으면 같은 정점 데이터를 사용합니다. 위치만 같은 두 레코드는 법선이나 유브이가 다르면 별도 정점이어야 합니다.",
      "start": 184.68,
      "end": 192.86,
      "voice_start": 184.68,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 24,
      "scene_id": "05",
      "scene_title": "같은 좌표와 같은 정점은 다릅니다",
      "text": "앞면을 정하는 정점 순서는 먼저 약속합니다. 원문의 시계 방향 규약도 하나의 선택이며 실제 렌더러의 앞면 설정과 함께 맞춰야 합니다.",
      "start": 193.18,
      "end": 201.88,
      "voice_start": 193.18,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 25,
      "scene_id": "05",
      "scene_title": "같은 좌표와 같은 정점은 다릅니다",
      "text": "영 일 이를 일 이 영으로 순환하면 같은 방향입니다. 영 이 일처럼 두 번호를 바꾸면 방향이 반대가 됩니다.",
      "start": 202.16,
      "end": 208.4,
      "voice_start": 202.16,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 26,
      "scene_id": "05",
      "scene_title": "같은 좌표와 같은 정점은 다릅니다",
      "text": "두 삼각형은 영번과 이번 사이 모서리를 공유합니다. 하지만 인덱스 목록에 이웃 면 번호가 바로 저장되어 있는 것은 아닙니다.",
      "start": 208.94,
      "end": 216.0,
      "voice_start": 208.94,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 27,
      "scene_id": "05",
      "scene_title": "같은 좌표와 같은 정점은 다릅니다",
      "text": "이웃을 자주 찾는 편집 도구는 모서리와 연결 면의 참조를 따로 저장할 수 있습니다. 윙드 에지 같은 구조가 그 예입니다.",
      "start": 216.34,
      "end": 223.20000000000002,
      "voice_start": 216.34,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 28,
      "scene_id": "05",
      "scene_title": "같은 좌표와 같은 정점은 다릅니다",
      "text": "열린 모서리는 한 면만 연결되고 비다양체 모서리는 둘보다 많을 수도 있습니다. 모든 모서리에 이웃 면이 정확히 둘이라고 가정하면 안 됩니다.",
      "start": 223.5,
      "end": 231.66,
      "voice_start": 223.5,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 29,
      "scene_id": "05",
      "scene_title": "같은 좌표와 같은 정점은 다릅니다",
      "text": "같은 속성이나 재질로 묶은 삼각형은 렌더링 배치로 보낼 수 있습니다. 편집 자료구조와 GPU 전달 형식을 꼭 같은 클래스로 만들 필요는 없습니다.",
      "start": 231.98000000000002,
      "end": 240.60000000000002,
      "voice_start": 231.98000000000002,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 30,
      "scene_id": "06",
      "scene_title": "벽의 격자를 정점 연결선으로 읽어도 될까요?",
      "text": "빅 워크의 녹색 방을 돌아보겠습니다. 가까운 판 위의 검은 격자와, 그 뒤의 둥근 벽과 바위를 나누어 보세요.",
      "start": 241.21004166666665,
      "end": 249.07004166666667,
      "voice_start": 241.21004166666665,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 31,
      "scene_id": "06",
      "scene_title": "벽의 격자를 정점 연결선으로 읽어도 될까요?",
      "text": "시점이 움직이면 판의 바깥 테두리와 면 안의 선이 함께 보입니다. 테두리는 보이는 형태를 구분하고, 격자는 면의 세부 모습으로 읽힙니다.",
      "start": 249.33004166666666,
      "end": 257.57004166666667,
      "voice_start": 249.33004166666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 32,
      "scene_id": "06",
      "scene_title": "벽의 격자를 정점 연결선으로 읽어도 될까요?",
      "text": "뒤쪽에는 원형 구멍과 원통 모양 받침도 있습니다. 직선 격자와 둥근 윤곽이 같은 장면 안에 나타납니다.",
      "start": 257.89004166666666,
      "end": 264.83004166666666,
      "voice_start": 257.89004166666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 33,
      "scene_id": "06",
      "scene_title": "벽의 격자를 정점 연결선으로 읽어도 될까요?",
      "text": "그러나 검은 선이 모두 삼각형 인덱스의 모서리라는 증거는 아닙니다. 무늬, 별도 표면이나 다른 표현일 수도 있습니다.",
      "start": 265.09004166666665,
      "end": 271.85004166666664,
      "voice_start": 265.09004166666665,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 34,
      "scene_id": "06",
      "scene_title": "벽의 격자를 정점 연결선으로 읽어도 될까요?",
      "text": "앞에서 만든 인덱스 목록이라면 영번과 이번의 연결을 직접 확인할 수 있습니다. 완성 게임 화면에는 그 목록이 공개되어 있지 않습니다.",
      "start": 272.13004166666667,
      "end": 280.07004166666667,
      "voice_start": 272.13004166666667,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 35,
      "scene_id": "06",
      "scene_title": "벽의 격자를 정점 연결선으로 읽어도 될까요?",
      "text": "형태를 저장하는 데이터와 빛 계산에 필요한 방향도 나누어야 합니다. 다음 도식에서는 표면은 그대로 두고 법선만 바꾸어 비교합니다.",
      "start": 280.2500416666667,
      "end": 288.2500416666667,
      "voice_start": 280.2500416666667,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 36,
      "scene_id": "06",
      "scene_title": "벽의 격자를 정점 연결선으로 읽어도 될까요?",
      "text": "카메라가 돌아갈 때 보이는 판의 면과 윤곽을 다시 확인해 보세요. 이 관찰을 바탕으로 면 법선과 정점 법선의 역할을 연결하겠습니다.",
      "start": 288.4300416666666,
      "end": 296.23004166666664,
      "voice_start": 288.4300416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 37,
      "scene_id": "07",
      "scene_title": "각진 바위와 매끄러운 밝기는 같은 정보일까요?",
      "text": "메가봉크의 사막에서 바위와 선인장 사이를 움직입니다. 바위의 꺾인 바깥 윤곽과 면 안의 밝기를 따로 관찰해 보세요.",
      "start": 296.86004166666663,
      "end": 304.5600416666666,
      "voice_start": 296.86004166666663,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 38,
      "scene_id": "07",
      "scene_title": "각진 바위와 매끄러운 밝기는 같은 정보일까요?",
      "text": "카메라가 따라 움직여도 큰 바위의 평평한 면과 꺾이는 가장자리는 남습니다. 화면에 각진 모양이 보인다고 모든 면의 법선 처리까지 알 수는 없습니다.",
      "start": 304.84004166666665,
      "end": 314.2600416666666,
      "voice_start": 304.84004166666665,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 39,
      "scene_id": "07",
      "scene_title": "각진 바위와 매끄러운 밝기는 같은 정보일까요?",
      "text": "이어지는 구간에서는 큰 바위 옆을 지나고, 다시 선인장과 낮은 바위 사이를 이동합니다. 같은 방향의 빛이라도 표면이 향하는 방향은 다를 수 있습니다.",
      "start": 314.5800416666666,
      "end": 323.1200416666666,
      "voice_start": 314.5800416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 40,
      "scene_id": "07",
      "scene_title": "각진 바위와 매끄러운 밝기는 같은 정보일까요?",
      "text": "밝기 차이는 재질과 그림자에도 영향을 받습니다. 그래서 화면의 색만으로 법선 수치를 맞히는 대신, 다음 도식에서 방향 하나만 바꾸어 비교합니다.",
      "start": 323.4400416666666,
      "end": 332.16004166666664,
      "voice_start": 323.4400416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 41,
      "scene_id": "07",
      "scene_title": "각진 바위와 매끄러운 밝기는 같은 정보일까요?",
      "text": "마지막에는 기둥과 꺾인 지붕 같은 큰 형태가 보입니다. 바깥 모양을 만드는 위치와 조명에 사용하는 방향을 서로 다른 입력으로 생각하세요.",
      "start": 332.42004166666663,
      "end": 340.22004166666665,
      "voice_start": 332.42004166666663,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 42,
      "scene_id": "07",
      "scene_title": "각진 바위와 매끄러운 밝기는 같은 정보일까요?",
      "text": "정점의 위치를 움직이지 않고도 밝기를 매끄럽게 할 수 있을까요? 우리가 만든 육각기둥에 면 법선과 정점 법선을 넣어서 확인하겠습니다.",
      "start": 340.36004166666663,
      "end": 348.36004166666663,
      "voice_start": 340.36004166666663,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 43,
      "scene_id": "08",
      "scene_title": "면의 법선과 정점의 법선",
      "text": "면 법선은 그 평면에 수직인 방향입니다. 두 모서리의 외적으로 구하고, 앞면 약속에 맞는 방향을 선택한 뒤 단위 길이로 만듭니다.",
      "start": 348.8300416666666,
      "end": 357.9100416666666,
      "voice_start": 348.8300416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 44,
      "scene_id": "08",
      "scene_title": "면의 법선과 정점의 법선",
      "text": "정점에서는 여러 평면이 만납니다. 날카로운 모서리에 수학적으로 하나뿐인 면 법선이 있다고 말할 수는 없습니다.",
      "start": 358.1500416666666,
      "end": 365.1300416666666,
      "voice_start": 358.1500416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 45,
      "scene_id": "08",
      "scene_title": "면의 법선과 정점의 법선",
      "text": "매끄러운 곡면을 삼각형으로 근사할 때는 그 곡면의 방향을 정점에 저장합니다. 이를 셰이딩 법선으로 사용합니다.",
      "start": 365.4300416666666,
      "end": 371.9100416666666,
      "voice_start": 365.4300416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 46,
      "scene_id": "08",
      "scene_title": "면의 법선과 정점의 법선",
      "text": "육각기둥 옆면은 평평해도 정점 법선을 바깥으로 조금씩 돌리면 밝기가 부드럽게 바뀔 수 있습니다. 위치와 연결은 그대로입니다.",
      "start": 372.0900416666666,
      "end": 380.1100416666666,
      "voice_start": 372.0900416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 47,
      "scene_id": "08",
      "scene_title": "면의 법선과 정점의 법선",
      "text": "빛 계산에서 단위 법선과 단위 빛 방향을 내적하면 각도의 코사인을 얻습니다. 길이가 달라지면 방향 외에 크기까지 섞이므로 다시 정규화합니다.",
      "start": 380.1100416666666,
      "end": 388.8700416666666,
      "voice_start": 380.1100416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 48,
      "scene_id": "08",
      "scene_title": "면의 법선과 정점의 법선",
      "text": "앞면 설정과 셰이딩 법선도 같은 정보는 아닙니다. 화면에서 면이 사라졌다면 인덱스 방향과 제거 설정을, 빛이 이상하면 법선과 조명을 구분해 점검합니다.",
      "start": 389.1500416666666,
      "end": 398.49004166666657,
      "voice_start": 389.1500416666666,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 49,
      "scene_id": "09",
      "scene_title": "밝기를 보간할까, 법선을 보간할까?",
      "text": "평면 셰이딩은 한 면의 방향으로 조명을 계산합니다. 이웃 면 방향이 다르면 경계에서 밝기 차이가 나타납니다.",
      "start": 398.9600833333333,
      "end": 405.80008333333325,
      "voice_start": 398.9600833333333,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 50,
      "scene_id": "09",
      "scene_title": "밝기를 보간할까, 법선을 보간할까?",
      "text": "구로 셰이딩은 정점마다 조명 결과를 구한 다음 그 결과를 면 안으로 보간합니다. 법선 자체를 보간하는 방식과 다릅니다.",
      "start": 406.0200833333333,
      "end": 413.34008333333327,
      "voice_start": 406.0200833333333,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 51,
      "scene_id": "09",
      "scene_title": "밝기를 보간할까, 법선을 보간할까?",
      "text": "픽셀별 셰이딩은 정점 법선을 보간하고 다시 정규화한 뒤, 면 안쪽 표본마다 조명 식을 계산합니다.",
      "start": 413.5800833333333,
      "end": 419.6200833333333,
      "voice_start": 413.5800833333333,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 52,
      "scene_id": "09",
      "scene_title": "밝기를 보간할까, 법선을 보간할까?",
      "text": "오른쪽 방향과 위쪽 방향을 절반씩 섞으면 영 점 오, 영 점 오가 됩니다. 길이는 약 영 점 칠공칠이므로 단위벡터가 아닙니다.",
      "start": 419.8200833333333,
      "end": 427.98008333333325,
      "voice_start": 419.8200833333333,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 53,
      "scene_id": "09",
      "scene_title": "밝기를 보간할까, 법선을 보간할까?",
      "text": "다시 정규화하면 두 성분이 약 영 점 칠공칠입니다. 보간한 방향을 밝기에 넣기 전에 이 단계를 거칩니다.",
      "start": 427.98008333333325,
      "end": 434.16008333333326,
      "voice_start": 427.98008333333325,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 54,
      "scene_id": "09",
      "scene_title": "밝기를 보간할까, 법선을 보간할까?",
      "text": "노션의 퐁 셰이딩이라는 이름은 이 법선 보간 방식을 가리킵니다. 정반사에 쓰는 퐁 반사 모델과 구별해야 합니다.",
      "start": 434.6800833333333,
      "end": 441.4400833333333,
      "voice_start": 434.6800833333333,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 55,
      "scene_id": "09",
      "scene_title": "밝기를 보간할까, 법선을 보간할까?",
      "text": "밝기가 매끄러워져도 육각형 실루엣은 여전히 육각형입니다. 법선만으로 실제 표면 위치나 구멍의 모양이 바뀌지는 않습니다.",
      "start": 441.8200833333333,
      "end": 449.34008333333327,
      "voice_start": 441.8200833333333,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 56,
      "scene_id": "10",
      "scene_title": "평평한 갑판과 굽은 난간의 경계",
      "text": "빅 워크의 붉은 갑판에서 캐릭터가 움직입니다. 넓은 바닥과 굽은 난간, 기울어진 조작판의 경계를 보세요.",
      "start": 450.1300833333333,
      "end": 457.6100833333333,
      "voice_start": 450.1300833333333,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 57,
      "scene_id": "10",
      "scene_title": "평평한 갑판과 굽은 난간의 경계",
      "text": "밝기를 부드럽게 만드는 방향과 실제 형태의 경계는 다른 역할입니다. 곡면으로 이을 곳과 날카롭게 나눌 곳을 구분해야 합니다.",
      "start": 458.1100833333333,
      "end": 465.9300833333333,
      "voice_start": 458.1100833333333,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 58,
      "scene_id": "10",
      "scene_title": "평평한 갑판과 굽은 난간의 경계",
      "text": "이제 정점에 연결된 면을 모두 모아 법선을 만들고, 필요한 경계에서 공유를 끊어 보겠습니다.",
