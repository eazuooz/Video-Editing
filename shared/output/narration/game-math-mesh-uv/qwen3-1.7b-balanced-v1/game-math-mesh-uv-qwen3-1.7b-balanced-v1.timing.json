      "end": 669.0101666666667,
      "voice_start": 660.3901666666667,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 82,
      "scene_id": "14",
      "scene_title": "삼각형 수가 많으면 그 방향이 이길까요?",
      "text": "같은 사각형의 대각선만 바꾸어도 어떤 꼭짓점이 두 삼각형에 연결되는지가 달라집니다. 원래 표면 모양은 같아도 평균이 바뀔 수 있습니다.",
      "start": 669.3101666666668,
      "end": 677.4901666666667,
      "voice_start": 669.3101666666668,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 83,
      "scene_id": "14",
      "scene_title": "삼각형 수가 많으면 그 방향이 이길까요?",
      "text": "한 방법은 그 정점의 내각을 가중치로 쓰는 것입니다. 사각형 꼭짓점의 구십 도를 둘로 나누어도 합은 구십 도입니다.",
      "start": 677.7501666666667,
      "end": 684.6301666666667,
      "voice_start": 677.7501666666667,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 84,
      "scene_id": "14",
      "scene_title": "삼각형 수가 많으면 그 방향이 이길까요?",
      "text": "이렇게 각 면 방향에 내각을 곱해 합산한 뒤 정규화합니다. 면적 가중치처럼 다른 정책도 있으니 무엇을 근사하려는지 먼저 정합니다.",
      "start": 685.0101666666667,
      "end": 693.0901666666667,
      "voice_start": 685.0101666666667,
      "alignment": "whisper-word-timestamps-script-matched"
