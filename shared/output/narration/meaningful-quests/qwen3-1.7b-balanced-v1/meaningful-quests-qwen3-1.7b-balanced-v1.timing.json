{
  "sample_rate": 24000,
  "duration_seconds": 211.36008333333336,
  "render_mode": "scene",
  "example_seconds": 19.5,
  "narration_placement": "continuous-across-example-and-explanation",
  "entries": [
    {
      "index": 1,
      "scene_id": "01",
      "scene_title": "심부름을 행동으로 보기",
      "text": "물건 세 개를 가져오세요. 게임에서 자주 만나는 부탁입니다.",
      "start": 0.0,
      "end": 3.5425
    },
    {
      "index": 2,
      "scene_id": "01",
      "scene_title": "심부름을 행동으로 보기",
      "text": "그런데 같은 심부름도 어떤 때는 다음 목적지가 궁금하고,",
      "start": 3.5425,
      "end": 7.1225
    },
    {
      "index": 3,
      "scene_id": "01",
      "scene_title": "심부름을 행동으로 보기",
      "text": "어떤 때는 빨리 끝내고 싶기만 합니다.",
      "start": 7.1225,
      "end": 9.5525
    },
    {
      "index": 4,
      "scene_id": "01",
      "scene_title": "심부름을 행동으로 보기",
      "text": "차이는 가져오라는 말보다, 그 사이에 무엇을 하느냐에 있을 수 있습니다.",
      "start": 9.5525,
      "end": 14.0025
    },
    {
      "index": 5,
      "scene_id": "01",
      "scene_title": "심부름을 행동으로 보기",
      "text": "스카이림의 길과 채집, 서브노티카의 자원 탐색을 비교하고,",
      "start": 14.0025,
      "end": 17.9725
    },
    {
      "index": 6,
      "scene_id": "01",
      "scene_title": "심부름을 행동으로 보기",
      "text": "직접 만든 배달 테스트에서 조건을 바꿔 보겠습니다.",
      "start": 17.9725,
      "end": 21.4025
    },
    {
      "index": 7,
      "scene_id": "01",
      "scene_title": "심부름을 행동으로 보기",
      "text": "살펴볼 것은 세 가지입니다.",
      "start": 21.4025,
      "end": 23.3925
    },
    {
      "index": 8,
      "scene_id": "01",
      "scene_title": "심부름을 행동으로 보기",
      "text": "이동하며 어떤 선택을 하는지, 완료하면 무엇이 달라지는지,",
      "start": 23.3925,
      "end": 27.2225
    },
    {
      "index": 9,
      "scene_id": "01",
      "scene_title": "심부름을 행동으로 보기",
      "text": "그리고 돌아오는 길에 새로 알게 되는 것이 있는지입니다.",
      "start": 27.2225,
      "end": 30.32
    },
    {
      "index": 10,
      "scene_id": "02",
      "scene_title": "가는 길에 선택이 있는가",
      "text": "먼저 목적지보다 가는 동안의 행동을 보겠습니다.",
      "start": 31.04,
      "end": 34.1425
    },
    {
      "index": 11,
      "scene_id": "02",
      "scene_title": "가는 길에 선택이 있는가",
      "text": "서브노티카에서 재료를 찾을 때는 주변을 살피고,",
      "start": 34.1425,
      "end": 37.3625
    },
    {
      "index": 12,
      "scene_id": "02",
      "scene_title": "가는 길에 선택이 있는가",
      "text": "남은 산소를 보며 더 찾아볼지 수면으로 돌아갈지 판단합니다.",
      "start": 37.3625,
      "end": 41.4625
    },
    {
      "index": 13,
      "scene_id": "02",
      "scene_title": "가는 길에 선택이 있는가",
      "text": "여기서는 누가 시킨 퀘스트가 아니라,",
      "start": 41.4625,
      "end": 43.942499999999995
    },
    {
      "index": 14,
      "scene_id": "02",
      "scene_title": "가는 길에 선택이 있는가",
      "text": "플레이어가 필요한 재료를 스스로 찾는 상황을 예로 든 것입니다.",
      "start": 43.942499999999995,
      "end": 47.8925
    },
    {
      "index": 15,
      "scene_id": "02",
      "scene_title": "가는 길에 선택이 있는가",
      "text": "모으기라는 목표 안에도 관찰과 선택이 들어갑니다.",
      "start": 47.8925,
      "end": 50.9225
    },
    {
      "index": 16,
      "scene_id": "02",
      "scene_title": "가는 길에 선택이 있는가",
      "text": "반대로 표시만 따라가며 누를 버튼도 고를 길도 없다면,",
      "start": 50.9225,
      "end": 54.6725
    },
    {
      "index": 17,
      "scene_id": "02",
      "scene_title": "가는 길에 선택이 있는가",
      "text": "이동 시간이 길어질수록 할 일보다 기다림이 늘어날 수 있습니다.",
      "start": 54.6725,
      "end": 58.7025
    },
    {
      "index": 18,
      "scene_id": "02",
      "scene_title": "가는 길에 선택이 있는가",
      "text": "내 퀘스트의 중간 구간에서 플레이어가 결정하는 순간을 적어 보세요.",
      "start": 58.7025,
      "end": 62.912499999999994
    },
    {
      "index": 19,
      "scene_id": "02",
      "scene_title": "가는 길에 선택이 있는가",
      "text": "목적지 사이를 채울 선택이 실제로 있는지 확인하는 것입니다.",
      "start": 62.912499999999994,
      "end": 66.72004166666667
    },
    {
      "index": 20,
      "scene_id": "03",
      "scene_title": "완료 뒤 무엇이 바뀌는가",
      "text": "다음은 부탁을 끝냈을 때의 변화입니다.",
      "start": 67.44004166666667,
      "end": 70.21254166666667
    },
    {
      "index": 21,
      "scene_id": "03",
      "scene_title": "완료 뒤 무엇이 바뀌는가",
      "text": "스카이림에서 길을 걷고 광물을 캐는 화면을 보죠.",
      "start": 70.21254166666667,
      "end": 73.27254166666667
    },
    {
      "index": 22,
      "scene_id": "03",
      "scene_title": "완료 뒤 무엇이 바뀌는가",
      "text": "이 영상은 특정 퀘스트의 보상을 증명하는 장면이 아니라,",
      "start": 73.27254166666667,
      "end": 77.34254166666668
    },
    {
      "index": 23,
      "scene_id": "03",
      "scene_title": "완료 뒤 무엇이 바뀌는가",
      "text": "이동과 채집이라는 행동을 비교하기 위한 예시입니다.",
      "start": 77.34254166666668,
      "end": 80.18254166666668
    },
    {
      "index": 24,
      "scene_id": "03",
      "scene_title": "완료 뒤 무엇이 바뀌는가",
      "text": "여기서 내 게임에 물어볼 질문은 따로 있습니다.",
      "start": 80.18254166666668,
      "end": 83.28254166666667
    },
    {
      "index": 25,
      "scene_id": "03",
      "scene_title": "완료 뒤 무엇이 바뀌는가",
      "text": "모은 물건을 전달한 뒤에는 점수만 올라가나요?",
      "start": 83.28254166666667,
      "end": 86.11254166666667
    },
    {
      "index": 26,
      "scene_id": "03",
      "scene_title": "완료 뒤 무엇이 바뀌는가",
      "text": "아니면 길이 열리거나, 누군가의 행동이 달라지나요?",
      "start": 86.11254166666667,
      "end": 89.23254166666668
    },
    {
      "index": 27,
      "scene_id": "03",
      "scene_title": "완료 뒤 무엇이 바뀌는가",
      "text": "보상 숫자도 필요하지만, 내가 한 일의 결과를 화면에서 알 수 있다면,",
      "start": 89.23254166666668,
      "end": 93.69254166666667
    },
    {
      "index": 28,
      "scene_id": "03",
      "scene_title": "완료 뒤 무엇이 바뀌는가",
      "text": "왜 이 부탁을 했는지 이해하는 데 도움이 될 수 있습니다.",
      "start": 93.69254166666667,
      "end": 96.86254166666667
    },
    {
      "index": 29,
      "scene_id": "03",
      "scene_title": "완료 뒤 무엇이 바뀌는가",
      "text": "이 차이를 작은 배달 게임에서 직접 만들어 보겠습니다.",
      "start": 96.86254166666667,
      "end": 100.32008333333334
    },
    {
      "index": 30,
      "scene_id": "04",
      "scene_title": "같은 배달, 다른 세계 상태",
      "text": "두 버전 모두 같은 길에서 나무 세 개를 모아 돌아옵니다.",
      "start": 101.04008333333334,
      "end": 104.86258333333335
    },
    {
      "index": 31,
      "scene_id": "04",
      "scene_title": "같은 배달, 다른 세계 상태",
      "text": "이동 속도와 물건 위치, 받는 점수는 같습니다.",
      "start": 104.86258333333335,
      "end": 108.03258333333335
    },
    {
      "index": 32,
      "scene_id": "04",
      "scene_title": "같은 배달, 다른 세계 상태",
      "text": "첫 버전은 전달하면 점수가 올라가고 부탁이 끝납니다.",
      "start": 108.03258333333335,
      "end": 111.39258333333333
    },
    {
      "index": 33,
      "scene_id": "04",
      "scene_title": "같은 배달, 다른 세계 상태",
      "text": "두 번째는 같은 전달 뒤 끊어진 다리가 이어집니다.",
      "start": 111.39258333333333,
      "end": 114.89258333333333
    },
    {
      "index": 34,
      "scene_id": "04",
      "scene_title": "같은 배달, 다른 세계 상태",
      "text": "그래서 다음에 갈 수 있는 장소가 실제로 달라집니다.",
      "start": 114.89258333333333,
      "end": 117.86258333333335
    },
    {
      "index": 35,
      "scene_id": "04",
      "scene_title": "같은 배달, 다른 세계 상태",
      "text": "화면의 다리는 완료 표시를 꾸민 그림만이 아닙니다.",
      "start": 117.86258333333335,
      "end": 121.49258333333334
    },
    {
      "index": 36,
      "scene_id": "04",
      "scene_title": "같은 배달, 다른 세계 상태",
      "text": "충돌을 막던 구간이 열려 캐릭터가 건널 수 있게 만들었습니다.",
      "start": 121.49258333333334,
      "end": 125.18258333333334
    },
    {
      "index": 37,
      "scene_id": "04",
      "scene_title": "같은 배달, 다른 세계 상태",
      "text": "이 비교가 증명하는 것은 세계 상태가 바뀐다는 점입니다.",
      "start": 125.18258333333334,
      "end": 128.75258333333335
    },
    {
      "index": 38,
      "scene_id": "04",
      "scene_title": "같은 배달, 다른 세계 상태",
      "text": "두 번째가 더 재미있는지는 사람에게 플레이를 맡겨 확인해야 합니다.",
      "start": 128.75258333333335,
      "end": 132.80258333333333
    },
    {
      "index": 39,
      "scene_id": "04",
      "scene_title": "같은 배달, 다른 세계 상태",
      "text": "자동 입력으로 성공한 기록을 재미 평가로 바꾸면 안 됩니다.",
      "start": 132.80258333333333,
      "end": 136.32008333333334
    },
    {
      "index": 40,
      "scene_id": "05",
      "scene_title": "돌아오는 길을 다시 설계하기",
      "text": "돌아오는 길도 확인해 보죠.",
      "start": 137.04008333333334,
      "end": 138.87258333333335
    },
    {
      "index": 41,
      "scene_id": "05",
      "scene_title": "돌아오는 길을 다시 설계하기",
      "text": "처음에는 돌아서 가야 했지만, 다리를 고친 뒤에는 짧은 길이 열립니다.",
      "start": 138.87258333333335,
      "end": 143.55258333333333
    },
    {
      "index": 42,
      "scene_id": "05",
      "scene_title": "돌아오는 길을 다시 설계하기",
      "text": "같은 장소가 다른 의미를 갖게 된 것입니다.",
      "start": 143.55258333333333,
      "end": 146.59258333333335
    },
    {
      "index": 43,
      "scene_id": "05",
      "scene_title": "돌아오는 길을 다시 설계하기",
      "text": "다른 테스트에서는 짧은 길에 물건을 내려놓아야 하는 문을 넣었습니다.",
      "start": 146.59258333333335,
      "end": 151.42258333333334
    },
    {
      "index": 44,
      "scene_id": "05",
      "scene_title": "돌아오는 길을 다시 설계하기",
      "text": "빨리 돌아갈지, 물건을 유지하며 긴 길을 갈지 선택하게 하죠.",
      "start": 151.42258333333334,
      "end": 155.83258333333333
    },
    {
      "index": 45,
      "scene_id": "05",
      "scene_title": "돌아오는 길을 다시 설계하기",
      "text": "짧은 길이 있다는 사실만으로 선택이 생기는 것은 아닙니다.",
      "start": 155.83258333333333,
      "end": 159.34258333333335
    },
    {
      "index": 46,
      "scene_id": "05",
      "scene_title": "돌아오는 길을 다시 설계하기",
      "text": "무엇을 얻고 무엇을 포기하는지 읽을 수 있어야 합니다.",
      "start": 159.34258333333335,
      "end": 162.82258333333334
    },
    {
      "index": 47,
      "scene_id": "05",
      "scene_title": "돌아오는 길을 다시 설계하기",
      "text": "그렇다고 모든 이동을 사건으로 채울 필요는 없습니다.",
      "start": 162.82258333333334,
      "end": 166.55258333333333
    },
    {
      "index": 48,
      "scene_id": "05",
      "scene_title": "돌아오는 길을 다시 설계하기",
      "text": "조용히 주변을 보거나 방금 한 일을 돌아볼 시간도 필요할 수 있습니다.",
      "start": 166.55258333333333,
      "end": 171.22258333333335
    },
    {
      "index": 49,
      "scene_id": "05",
      "scene_title": "돌아오는 길을 다시 설계하기",
      "text": "반복 구간이 어떤 역할을 하는지 먼저 정해 보세요.",
      "start": 171.22258333333335,
      "end": 174.56008333333335
    },
    {
      "index": 50,
      "scene_id": "06",
      "scene_title": "세 질문으로 플레이를 확인하기",
      "text": "새 퀘스트를 만들 때는 목표 문장 아래 세 줄을 더 적어 보세요.",
      "start": 175.28008333333335,
      "end": 179.30258333333336
    },
    {
      "index": 51,
      "scene_id": "06",
      "scene_title": "세 질문으로 플레이를 확인하기",
      "text": "갈 때 하는 선택, 끝난 뒤의 변화, 돌아올 때 얻는 정보입니다.",
      "start": 179.30258333333336,
      "end": 183.54258333333334
    },
    {
      "index": 52,
      "scene_id": "06",
      "scene_title": "세 질문으로 플레이를 확인하기",
      "text": "전부 비어 있다면 부탁 횟수를 늘리기 전에,",
      "start": 183.54258333333334,
      "end": 186.66258333333334
    },
    {
      "index": 53,
      "scene_id": "06",
      "scene_title": "세 질문으로 플레이를 확인하기",
      "text": "딱 한 구간을 골라 작은 변화를 넣어 보세요.",
      "start": 186.66258333333334,
      "end": 189.92258333333336
    },
    {
      "index": 54,
      "scene_id": "06",
      "scene_title": "세 질문으로 플레이를 확인하기",
      "text": "그리고 플레이한 사람에게 어디서 멈췄고 어떤 길을 골랐는지 물어보세요.",
      "start": 189.92258333333336,
      "end": 194.61258333333336
    },
    {
      "index": 55,
      "scene_id": "06",
      "scene_title": "세 질문으로 플레이를 확인하기",
      "text": "완료한 뒤 무엇이 달라졌다고 생각했는지도 확인합니다.",
      "start": 194.61258333333336,
      "end": 197.86258333333336
    },
    {
      "index": 56,
      "scene_id": "06",
      "scene_title": "세 질문으로 플레이를 확인하기",
      "text": "설계 의도와 실제로 알아본 결과가 다를 수 있기 때문입니다.",
      "start": 197.86258333333336,
      "end": 202.18258333333335
    },
    {
      "index": 57,
      "scene_id": "06",
      "scene_title": "세 질문으로 플레이를 확인하기",
      "text": "좋은 심부름은 물건 개수만으로 결정되지 않습니다.",
      "start": 202.18258333333335,
      "end": 205.48258333333337
    },
    {
      "index": 58,
      "scene_id": "06",
      "scene_title": "세 질문으로 플레이를 확인하기",
      "text": "작은 부탁 안에서 플레이어가 하는 선택과,",
      "start": 205.48258333333337,
      "end": 208.66258333333334
    },
    {
      "index": 59,
      "scene_id": "06",
      "scene_title": "세 질문으로 플레이를 확인하기",
      "text": "그 선택이 남기는 변화를 함께 설계해 보세요.",
      "start": 208.66258333333334,
      "end": 211.36008333333336
    }
  ]
}
