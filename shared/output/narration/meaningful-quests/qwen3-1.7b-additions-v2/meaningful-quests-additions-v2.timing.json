      "end": 67.91999999999999,
      "voice_start": 64.14321428571428,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 18,
      "scene_id": "02",
      "scene_title": "등반과 활공 사이의 선택",
      "text": "가는 동안 결정할 것이 있어야 목적지 사이의 시간이 플레이가 됩니다.",
      "start": 68.32,
      "end": 71.97999999999999,
      "voice_start": 68.32,
      "alignment": "whisper-word-timestamps-script-matched"
    },
    {
      "index": 19,
      "scene_id": "03",
      "scene_title": "얻은 것이 다음 행동에 남는가",
      "text": "대화 뒤 나침반을 얻었다는 표시가 나타나는 장면을 보겠습니다.",
