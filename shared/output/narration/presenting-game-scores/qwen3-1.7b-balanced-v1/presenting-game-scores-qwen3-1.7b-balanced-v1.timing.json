{
  "sample_rate": 24000,
  "duration_seconds": 201.68,
  "render_mode": "scene",
  "example_seconds": 0.0,
  "narration_placement": "continuous-across-example-and-explanation",
  "entries": [
    {
      "index": 1,
      "scene_id": "01-overview",
      "scene_title": "점수는 무엇을 말해 줄까?",
      "text": "숫자가 커졌다는 것만으로 무엇을 잘했는지 알 수 있을까요?",
      "start": 0.0,
      "end": 3.3925
    },
    {
      "index": 2,
      "scene_id": "01-overview",
      "scene_title": "점수는 무엇을 말해 줄까?",
      "text": "이번에는 테트리스의 점수와 지운 줄 수를 비교하고, 상대와의 차이가 숫자의 의미를 어떻게 바꾸는지 보겠습니다.",
      "start": 3.3925,
      "end": 10.6725
    },
    {
      "index": 3,
      "scene_id": "01-overview",
      "scene_title": "점수는 무엇을 말해 줄까?",
      "text": "마지막으로 발라트로의 계산 연출을 살펴보며, 성과를 읽기 쉽게 만드는 이름과 표현을 정리해 보죠.",
      "start": 10.6725,
      "end": 16.96
    },
    {
      "index": 4,
      "scene_id": "02-score-and-lines",
      "scene_title": "진행량과 평가는 다르다",
      "text": "테트리스 이펙트 커넥티드 화면에는 점수와 지운 줄 수가 따로 있습니다.",
      "start": 17.68,
      "end": 22.4325
    },
    {
      "index": 5,
      "scene_id": "02-score-and-lines",
      "scene_title": "진행량과 평가는 다르다",
      "text": "블록을 놓는 동안 점수가 바뀌어도 줄 수는 그대로인 순간이 있고, 줄이 지워지면 두 숫자가 함께 움직입니다.",
      "start": 22.4325,
      "end": 29.502499999999998
    },
    {
      "index": 6,
      "scene_id": "02-score-and-lines",
      "scene_title": "진행량과 평가는 다르다",
      "text": "얼마나 진행했는지와 어떻게 평가됐는지를 한 숫자로 합치면 이런 차이를 놓치기 쉽습니다.",
      "start": 29.502499999999998,
      "end": 35.2
    },
    {
      "index": 7,
      "scene_id": "03-same-count",
      "scene_title": "같은 양, 다른 점수",
      "text": "지운 줄 수가 같다면 점수도 같아야 할까요?",
      "start": 35.92,
      "end": 38.7425
    },
    {
      "index": 8,
      "scene_id": "03-same-count",
      "scene_title": "같은 양, 다른 점수",
      "text": "두 사람의 줄 수가 같아지는 순간에도 점수는 다릅니다. 같은 양의 결과를 냈다는 말과 같은 평가를 받았다는 말은 다르죠.",
      "start": 38.7425,
      "end": 45.9925
    },
    {
      "index": 9,
      "scene_id": "03-same-count",
      "scene_title": "같은 양, 다른 점수",
      "text": "설계할 때는 횟수를 세는 지표와 플레이를 평가하는 지표를 먼저 구분해 보세요.",
      "start": 45.9925,
      "end": 50.96
    },
    {
      "index": 10,
      "scene_id": "04-evaluation-weights",
      "scene_title": "무엇을 높게 평가할까?",
      "text": "점수를 만드는 규칙은 어떤 플레이를 높게 평가할지 정하는 기준입니다.",
      "start": 51.68,
      "end": 56.8225
    },
    {
      "index": 11,
      "scene_id": "04-evaluation-weights",
      "scene_title": "무엇을 높게 평가할까?",
      "text": "이 화면에는 티 스핀 더블과 백 투 백이라는 알림이 나타납니다. 줄 수만 세는 화면보다 행동의 종류를 더 구체적으로 알려 주죠.",
      "start": 56.8225,
      "end": 65.4725
    },
    {
      "index": 12,
      "scene_id": "04-evaluation-weights",
      "scene_title": "무엇을 높게 평가할까?",
      "text": "전체 배점표를 화면만 보고 알아낼 수는 없지만, 내가 강조할 행동과 점수의 이름은 함께 설계할 수 있습니다.",
      "start": 65.4725,
      "end": 72.96000000000001
    },
    {
      "index": 13,
      "scene_id": "05-events-and-total",
      "scene_title": "이번 행동과 누적 결과",
      "text": "계속 쌓이는 총점만 보면 방금 어떤 행동이 반영됐는지 놓칠 수 있습니다.",
      "start": 73.68,
      "end": 78.63250000000001
    },
    {
      "index": 14,
      "scene_id": "05-events-and-total",
      "scene_title": "이번 행동과 누적 결과",
      "text": "줄이 사라지는 순간의 알림과 바뀌는 점수를 같이 보세요. 하나는 이번 행동을 가리키고, 다른 하나는 지금까지의 결과를 남깁니다.",
      "start": 78.63250000000001,
      "end": 86.9025
    },
    {
      "index": 15,
      "scene_id": "05-events-and-total",
      "scene_title": "이번 행동과 누적 결과",
      "text": "두 표시를 나란히 읽을 수 있어야 큰 숫자 속에서 방금 한 행동의 의미가 사라지지 않습니다.",
      "start": 86.9025,
      "end": 93.12
    },
    {
      "index": 16,
      "scene_id": "06-relative-gap",
      "scene_title": "누구와 비교한 숫자일까?",
      "text": "총점이 커도 상대보다 앞서는지는 별도의 질문입니다.",
      "start": 93.84,
      "end": 97.4625
    },
    {
      "index": 17,
      "scene_id": "06-relative-gap",
      "scene_title": "누구와 비교한 숫자일까?",
      "text": "두 사람이 스물일곱 줄을 지웠을 때도 점수 차이는 이천구백이십 점입니다. 나중에는 줄 수가 적은 쪽이 점수로는 백사십일 점 앞서기도 하죠.",
      "start": 97.4625,
      "end": 106.3725
    },
    {
      "index": 18,
      "scene_id": "06-relative-gap",
      "scene_title": "누구와 비교한 숫자일까?",
      "text": "총점 옆의 차이를 읽으면 비교 기준이 분명해집니다. 다만 경기 중의 앞섬을 최종 승리와 같은 뜻으로 읽지는 말아야 합니다.",
      "start": 106.3725,
      "end": 114.32000000000001
    },
    {
      "index": 19,
      "scene_id": "07-name-and-unit",
      "scene_title": "이름과 단위를 붙이기",
      "text": "숫자에 이름을 붙이면 플레이어가 무엇을 읽어야 하는지 달라집니다.",
      "start": 115.04,
      "end": 119.3525
    },
    {
      "index": 20,
      "scene_id": "07-name-and-unit",
      "scene_title": "이름과 단위를 붙이기",
      "text": "이 화면의 점수와 줄 수처럼, 회수한 물품 수와 종합 평가 점수도 서로 다른 정보를 말할 수 있죠.",
      "start": 119.3525,
      "end": 126.0425
    },
    {
      "index": 21,
      "scene_id": "07-name-and-unit",
      "scene_title": "이름과 단위를 붙이기",
      "text": "어떤 결과를 세는지, 단위는 무엇인지, 높은 값과 낮은 값 중 무엇이 좋은지까지 분명하게 정해 보세요.",
      "start": 126.0425,
      "end": 132.8
    },
    {
      "index": 22,
      "scene_id": "08-scoring-feedback",
      "scene_title": "계산을 읽는 순간",
      "text": "발라트로의 짧은 계산 화면에서는 선택한 카드와 손패 이름, 칩과 배수가 차례로 눈에 들어옵니다.",
      "start": 133.52,
      "end": 139.94250000000002
    },
    {
      "index": 23,
      "scene_id": "08-scoring-feedback",
      "scene_title": "계산을 읽는 순간",
      "text": "카드의 반응 뒤에 숫자가 커지고 강조되는 모습을 보세요. 결과를 한 번에 던지기보다 변화하는 과정을 보여 줍니다.",
      "start": 139.94250000000002,
      "end": 147.8325
    },
    {
      "index": 24,
      "scene_id": "08-scoring-feedback",
      "scene_title": "계산을 읽는 순간",
      "text": "내 게임에서도 중요한 기여를 먼저 보이고 합계를 읽게 할 수 있습니다. 연출이 커질수록 숫자와 단위가 가려지지 않는지도 확인해야 하죠.",
      "start": 147.8325,
      "end": 156.16000000000003
    },
    {
      "index": 25,
      "scene_id": "09-feedback-hierarchy",
      "scene_title": "남아 있는 숫자와 지나가는 알림",
      "text": "모든 정보를 똑같이 크게 보여 주면 중요한 결과를 찾기 어렵습니다.",
      "start": 156.88000000000002,
      "end": 161.32250000000002
    },
    {
      "index": 26,
      "scene_id": "09-feedback-hierarchy",
      "scene_title": "남아 있는 숫자와 지나가는 알림",
      "text": "플레이가 이어지는 동안 총점과 줄 수는 남아 있고, 개별 행동의 알림은 나타났다 사라집니다. 읽는 역할과 시간이 다르죠.",
      "start": 161.32250000000002,
      "end": 169.21250000000003
    },
    {
      "index": 27,
      "scene_id": "09-feedback-hierarchy",
      "scene_title": "남아 있는 숫자와 지나가는 알림",
      "text": "계속 비교할 값은 안정된 위치에 두고, 이번 행동의 강조는 짧게 구분해 주세요. 강조가 본래 숫자를 밀어내지 않게 하는 것도 중요합니다.",
      "start": 169.21250000000003,
      "end": 178.08
    },
    {
      "index": 28,
      "scene_id": "10-audit-and-close",
      "scene_title": "세 가지 질문으로 점검하기",
      "text": "점수를 넣기 전에 무엇을 센 숫자인지, 누구와 비교하는지, 변화를 알아볼 수 있는지 물어보세요.",
      "start": 178.8,
      "end": 184.5225
    },
    {
      "index": 29,
      "scene_id": "10-audit-and-close",
      "scene_title": "세 가지 질문으로 점검하기",
      "text": "테트리스의 줄 수와 점수, 경기 중의 차이, 발라트로의 계산 연출이 각각 이 질문을 보여 줬습니다. 큰 숫자보다 읽을 수 있는 성과가 먼저입니다.",
      "start": 184.5225,
      "end": 193.4225
    },
    {
      "index": 30,
      "scene_id": "10-audit-and-close",
      "scene_title": "세 가지 질문으로 점검하기",
      "text": "직접 만든 화면에서도 이름과 기준을 설명해 보세요. 게임 프로그래밍을 함께 설계하고 구현해 보고 싶다면 설명란의 과외 안내를 확인해 주세요.",
      "start": 193.4225,
      "end": 201.68
    }
  ]
}
