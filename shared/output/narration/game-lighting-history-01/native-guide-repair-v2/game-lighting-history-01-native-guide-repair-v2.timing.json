  "entries": [
    {
      "index": 1,
      "scene_id": "r00",
      "scene_title": "g00",
      "text": "이 색은 광원의 밝기를 나타내는 값이 아닙니다.",
      "start": 0.0,
      "end": 2.96
    },
    {
      "index": 2,
      "scene_id": "r12",
      "scene_title": "g12",
      "text": "카메라 이동만으로 조명을 다시 계산했다고 말할 수는 없습니다.",
      "start": 3.6799999999999997,
      "end": 7.279999999999999
    },
    {
      "index": 3,
      "scene_id": "r17",
      "scene_title": "g17",
      "text": "작은 단계로 갈수록 세밀한 무늬가 합쳐집니다.",
      "start": 7.999999999999999,
      "end": 10.959999999999999
    },
    {
      "index": 4,
      "scene_id": "r25",
      "scene_title": "g25",
      "text": "이 구별은 다음에 설명할 표면 방향과 저장된 조명으로 이어집니다.",
      "start": 11.68,
      "end": 15.84
    },
    {
      "index": 5,
      "scene_id": "r29",
      "scene_title": "g29",
      "text": "하프라이프 투의 설명에서 이어 왔지만, 이 화면은 언리얼 엔진의 별도 사례입니다.",
      "start": 16.56,
      "end": 21.68
    },
    {
      "index": 6,
      "scene_id": "r30",
      "scene_title": "g30",
      "text": "다만 이 조작으로 정확한 혼합 비율이나 매 프레임의 계산 비용까지 측정한 것은 아닙니다.",
      "start": 22.4,
      "end": 28.4
    }
  ]
}
