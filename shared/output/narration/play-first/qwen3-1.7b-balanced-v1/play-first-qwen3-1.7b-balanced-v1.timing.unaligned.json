{
  "sample_rate": 24000,
  "duration_seconds": 212.48004166666666,
  "render_mode": "scene",
  "example_seconds": 19.5,
  "narration_placement": "continuous-across-example-and-explanation",
  "entries": [
    {
      "index": 1,
      "scene_id": "01",
      "scene_title": "스타트를 눌렀는데, 아직도 영상",
      "text": "새 게임을 샀습니다. 스타트 버튼을 누르고 패드를 꽉 쥐었는데, 삼 분째 영상만 보고 있습니다.",
      "start": 0.0,
      "end": 6.4025
    },
    {
      "index": 2,
      "scene_id": "01",
      "scene_title": "스타트를 눌렀는데, 아직도 영상",
      "text": "손은 준비됐는데, 할 일이 없네요. 이쯤 되면 캐릭터보다 제 인내심이 먼저 움직입니다.",
      "start": 6.4025,
      "end": 11.9425
    },
    {
      "index": 3,
      "scene_id": "01",
      "scene_title": "스타트를 눌렀는데, 아직도 영상",
      "text": "스매시브라더스와 별의 커비를 만든 사쿠라이 마사히로는, 아케이드 게임을 만들던 관점에서 이렇게 조언합니다. 처음 삼 분 안에 이 게임이 왜 재미있는지 전해져야 한다고요.",
      "start": 11.9425,
      "end": 22.5525
    },
    {
      "index": 4,
      "scene_id": "01",
      "scene_title": "스타트를 눌렀는데, 아직도 영상",
      "text": "플레이어는 설명을 듣고 재미를 판단하지 않습니다. 직접 해 보고 정합니다. 그 전에 너무 오래 기다리게 하면, 판단하기도 전에 떠나 버립니다.",
      "start": 22.5525,
      "end": 30.9925
    },
    {
      "index": 5,
      "scene_id": "01",
      "scene_title": "스타트를 눌렀는데, 아직도 영상",
      "text": "슈퍼 마리오 오디세이를 볼까요? 짧은 오프닝이 끝나고 마리오가 모자의 나라에 떨어지면, 곧바로 달리고 뛰는 건 플레이어의 손입니다.",
      "start": 30.9925,
      "end": 39.0125
    },
    {
      "index": 6,
      "scene_id": "01",
      "scene_title": "스타트를 눌렀는데, 아직도 영상",
      "text": "오늘은 오디세이를 따라가며, 게임의 첫 삼 분을 어떻게 설계할지 살펴보겠습니다.",
      "start": 39.0125,
      "end": 44.32
    },
    {
      "index": 7,
      "scene_id": "02",
      "scene_title": "그래서, 무슨 게임인데?",
      "text": "이건 게임 안에서만의 이야기가 아닙니다. 온라인 상점에 올라온 트레일러를 떠올려 볼까요?",
      "start": 45.04,
      "end": 50.8125
    },
    {
      "index": 8,
      "scene_id": "02",
      "scene_title": "그래서, 무슨 게임인데?",
      "text": "멋진 그래픽과 이야기가 한참 이어지는데, 정작 무엇을 하는 게임인지는 끝날 무렵에야 나옵니다. 사쿠라이도 그래서 앞부분을 건너뛰는 버릇이 생겼다고 말합니다.",
      "start": 50.8125,
      "end": 61.0925
    },
    {
      "index": 9,
      "scene_id": "02",
      "scene_title": "그래서, 무슨 게임인데?",
      "text": "보는 사람이 궁금한 건 결국 하나입니다. 그래서, 이 게임은 뭘 하는 게임인데?",
      "start": 61.0925,
      "end": 66.0825
    },
    {
      "index": 10,
      "scene_id": "02",
      "scene_title": "그래서, 무슨 게임인데?",
      "text": "오디세이는 이 질문에 몇 초 만에 답합니다. 모자를 던지면 코인이 튀고 상자가 부서지고, 그 모자를 적에게 던지면 그 적이 되어 움직입니다.",
      "start": 66.0825,
      "end": 74.9325
    },
    {
      "index": 11,
      "scene_id": "02",
      "scene_title": "그래서, 무슨 게임인데?",
      "text": "소리를 끄고 몇 초만 봐도 할 일이 읽히는 장면, 이게 가장 좋은 첫인사입니다.",
      "start": 74.9325,
      "end": 79.6425
    },
    {
      "index": 12,
      "scene_id": "02",
      "scene_title": "그래서, 무슨 게임인데?",
      "text": "영상미는 그다음에 보여 줘도 늦지 않습니다. 궁금증부터 풀어 주는 게 순서입니다.",
      "start": 79.6425,
      "end": 84.16004166666667
    },
    {
      "index": 13,
      "scene_id": "03",
      "scene_title": "이야기가 꼭 필요하다면",
      "text": "그렇다고 이야기를 빼라는 뜻은 아닙니다. 롤플레잉 게임처럼 도입부가 꼭 필요한 장르도 있죠.",
      "start": 84.88004166666667,
      "end": 90.62254166666668
    },
    {
      "index": 14,
      "scene_id": "03",
      "scene_title": "이야기가 꼭 필요하다면",
      "text": "이럴 때 쓸 수 있는 방법이 있습니다. 사건이 한창 벌어지는 순간을 맨 앞에 두는 겁니다.",
      "start": 90.62254166666668,
      "end": 96.16254166666667
    },
    {
      "index": 15,
      "scene_id": "03",
      "scene_title": "이야기가 꼭 필요하다면",
      "text": "오디세이도 이미 싸움이 벌어진 비행선 위에서 시작합니다. 쿠파가 왜 결혼식을 올리려는지는 길게 설명하지 않죠. 이 부분은 조작이 아닌 짧은 영상이지만, 사건 한복판에 바로 떨어뜨린다는 점은 같습니다.",
      "start": 96.16254166666667,
      "end": 108.53254166666667
    },
    {
      "index": 16,
      "scene_id": "03",
      "scene_title": "이야기가 꼭 필요하다면",
      "text": "사쿠라이는 한 걸음 더 나아가, 시간상 뒤에 올 장면을 앞으로 가져와 직접 플레이하게 하거나, 주인공보다 먼저 싸웠던 누군가를 조작하게 하라고 말합니다.",
      "start": 108.53254166666667,
      "end": 118.16254166666667
    },
    {
      "index": 17,
      "scene_id": "03",
      "scene_title": "이야기가 꼭 필요하다면",
      "text": "플레이어가 아직 영문을 몰라도 괜찮습니다. 일단 손에 잡히고 나면, 무슨 일인지 궁금해지는 마음이 오히려 이야기를 끌고 가 줍니다.",
      "start": 118.16254166666667,
      "end": 126.40254166666668
    },
    {
      "index": 18,
      "scene_id": "03",
      "scene_title": "이야기가 꼭 필요하다면",
      "text": "이야기를 지우지 않고, 조작을 앞으로 당기는 것. 시간의 순서와 플레이의 순서가 꼭 같을 필요는 없습니다.",
      "start": 126.40254166666668,
      "end": 132.88004166666667
    },
    {
      "index": 19,
      "scene_id": "04",
      "scene_title": "게임만 줄 수 있는 것부터",
      "text": "왜 이렇게까지 플레이를 앞에 두어야 할까요?",
      "start": 133.60004166666667,
      "end": 136.51254166666666
    },
    {
      "index": 20,
      "scene_id": "04",
      "scene_title": "게임만 줄 수 있는 것부터",
      "text": "멋진 영상과 이야기는 영화나 애니메이션도 보여 줄 수 있습니다. 하지만 내가 누른 버튼에 캐릭터가 움직이고, 세계가 반응하는 경험은 게임만 줄 수 있습니다.",
      "start": 136.51254166666666,
      "end": 146.14254166666666
    },
    {
      "index": 21,
      "scene_id": "04",
      "scene_title": "게임만 줄 수 있는 것부터",
      "text": "폭포의 나라에서 공룡에게 모자를 던지면, 이번에는 내가 공룡이 되어 길을 막던 것들을 부수며 달립니다. 보는 것만으로는 알 수 없는 손맛이죠.",
      "start": 146.14254166666666,
      "end": 155.49254166666668
    },
    {
      "index": 22,
      "scene_id": "04",
      "scene_title": "게임만 줄 수 있는 것부터",
      "text": "첫 조작은 곧 게임의 약속입니다. 처음 움직여 본 그 손맛이, 앞으로 이 게임에서 무엇을 하게 될지 알려 주니까요.",
      "start": 155.49254166666668,
      "end": 163.05254166666668
    },
    {
      "index": 23,
      "scene_id": "04",
      "scene_title": "게임만 줄 수 있는 것부터",
      "text": "그러니 첫 몇 분에는, 다른 매체로는 대신할 수 없는 부분을 먼저 맛보게 하는 편이 좋습니다.",
      "start": 163.05254166666668,
      "end": 168.88004166666667
    },
    {
      "index": 24,
      "scene_id": "05",
      "scene_title": "무엇을 먼저 보여 줄지 정하기",
      "text": "물론 정답은 게임마다 다릅니다. 조작 방식이 이미 익숙한 장르라면, 연출이나 이야기로 먼저 끌어당기는 선택도 충분히 가능합니다.",
      "start": 169.60004166666667,
      "end": 177.67254166666666
    },
    {
      "index": 25,
      "scene_id": "05",
      "scene_title": "무엇을 먼저 보여 줄지 정하기",
      "text": "중요한 건 어쩌다 길어진 도입부가 아니라, 무엇을 먼저 보여 줄지 의도해서 정하는 것입니다.",
      "start": 177.67254166666666,
      "end": 183.03254166666667
    },
    {
      "index": 26,
      "scene_id": "05",
      "scene_title": "무엇을 먼저 보여 줄지 정하기",
      "text": "튜토리얼도 마찬가지입니다. 모자의 나라는 모자 던지기와 캡처를 따로 연습시키지 않고, 본편 길 위에서 바로 써 보게 합니다. 이 이야기는 다음에 따로 다뤄 보겠습니다.",
      "start": 183.03254166666667,
      "end": 192.90254166666668
    },
    {
      "index": 27,
      "scene_id": "05",
      "scene_title": "무엇을 먼저 보여 줄지 정하기",
      "text": "재미있는 건 제목입니다. 새 게임을 시작하면, 슈퍼 마리오 오디세이라는 타이틀 연출은 첫 보스를 쓰러뜨린 뒤에야 나옵니다. 제목보다 놀이가 먼저인 셈이죠.",
      "start": 192.90254166666668,
      "end": 202.20254166666666
    },
    {
      "index": 28,
      "scene_id": "05",
      "scene_title": "무엇을 먼저 보여 줄지 정하기",
      "text": "내 게임의 첫 삼 분을 한번 재 보세요. 스타트를 누른 뒤 플레이어는 언제 처음 움직이고, 그 움직임은 이 게임의 재미를 말해 주고 있나요?",
      "start": 202.20254166666666,
      "end": 209.94254166666667
    },
    {
      "index": 29,
      "scene_id": "05",
      "scene_title": "무엇을 먼저 보여 줄지 정하기",
      "text": "기다리게 하지 말고, 먼저 놀게 해 주세요.",
      "start": 209.94254166666667,
      "end": 212.48004166666666
    }
  ]
}
