{
  "sample_rate": 24000,
  "duration_seconds": 445.6800416666668,
  "render_mode": "scene",
  "entries": [
    {
      "index": 1,
      "scene_id": "01",
      "scene_title": "프레임이란?",
      "text": "게임 설정에서 삼십 에프 피 에스와 육십 에프 피 에스를 고를 때, 우리는 정확히 무엇을 바꾸는 걸까요?",
      "start": 0.0,
      "end": 6.6225
    },
    {
      "index": 2,
      "scene_id": "01",
      "scene_title": "프레임이란?",
      "text": "게임에서 프레임은 화면이 한 번 그려진 결과, 즉 한 장의 이미지입니다.",
      "start": 6.6225,
      "end": 11.1025
    },
    {
      "index": 3,
      "scene_id": "01",
      "scene_title": "프레임이란?",
      "text": "움직임을 멈춰 보면 서로 조금씩 다른 정지 이미지가 이어지고, 이번 영상은 이 한 장이 시간과 조작감, 최신 그래픽 기술에 어떻게 연결되는지 살펴봅니다.",
      "start": 11.1025,
      "end": 20.8
    },
    {
      "index": 4,
      "scene_id": "02",
      "scene_title": "60 FPS의 의미",
      "text": "에프 피 에스는 프레임스 퍼 세컨드, 즉 일 초 동안 처리하거나 표시하는 프레임의 빈도입니다.",
      "start": 21.52,
      "end": 27.4525
    },
    {
      "index": 5,
      "scene_id": "02",
      "scene_title": "60 FPS의 의미",
      "text": "일 초 동안 화면에 육십 장을 보여 준다면 육십 에프 피 에스라고 부릅니다.",
      "start": 27.4525,
      "end": 31.612499999999997
    },
    {
      "index": 6,
      "scene_id": "02",
      "scene_title": "60 FPS의 의미",
      "text": "다만 현대 게임에서는 직접 렌더링한 프레임과 실제로 표시된 프레임을 구분해야 할 때도 있습니다.",
      "start": 31.612499999999997,
      "end": 37.599999999999994
    },
    {
      "index": 7,
      "scene_id": "03",
      "scene_title": "프레임과 게임의 시간",
      "text": "초기의 많은 게임은 화면 한 장이 바뀔 때마다 캐릭터를 정해진 거리만큼 움직였습니다.",
      "start": 38.31999999999999,
      "end": 44.092499999999994
    },
    {
      "index": 8,
      "scene_id": "03",
      "scene_title": "프레임과 게임의 시간",
      "text": "프레임 영에서는 엑스가 영, 다음 프레임에서는 일, 그다음에는 이가 되는 식입니다.",
      "start": 44.092499999999994,
      "end": 49.8625
    },
    {
      "index": 9,
      "scene_id": "03",
      "scene_title": "프레임과 게임의 시간",
      "text": "이때 프레임은 그림이자 시간 눈금이므로, 화면 갱신 횟수가 달라지면 이동과 애니메이션, 물리 속도까지 달라질 수 있었습니다.",
      "start": 49.8625,
      "end": 58.31999999999999
    },
    {
      "index": 10,
      "scene_id": "04",
      "scene_title": "30 FPS와 60 FPS",
      "text": "같은 캐릭터가 같은 일 초 동안 같은 거리를 이동한다고 가정해 보겠습니다.",
      "start": 59.03999999999999,
      "end": 63.022499999999994
    },
    {
      "index": 11,
      "scene_id": "04",
      "scene_title": "30 FPS와 60 FPS",
      "text": "삼십 에프 피 에스에는 위치 표본이 삼십 개이고, 육십 에프 피 에스에는 그 사이 위치까지 포함해 육십 개가 있습니다.",
      "start": 63.022499999999994,
      "end": 70.6125
    },
    {
      "index": 12,
      "scene_id": "04",
      "scene_title": "30 FPS와 60 FPS",
      "text": "목적지와 이동 시간은 같지만 변화가 더 작게 나뉘므로, 높은 프레임 레이트는 같은 시간을 더 촘촘하고 부드럽게 보여 줍니다.",
      "start": 70.6125,
      "end": 78.55999999999999
    },
    {
      "index": 13,
      "scene_id": "05",
      "scene_title": "프레임 예산",
      "text": "그렇다면 모든 게임을 무조건 높은 프레임 레이트로 만들면 되지 않을까요?",
      "start": 79.27999999999999,
      "end": 83.62249999999999
    },
    {
      "index": 14,
      "scene_id": "05",
      "scene_title": "프레임 예산",
      "text": "삼십 에프 피 에스는 프레임당 약 삼십삼 점 삼삼 밀리초, 육십은 십육 점 육칠 밀리초, 백이십은 팔 점 삼삼 밀리초를 사용할 수 있습니다.",
      "start": 83.62249999999999,
      "end": 93.20249999999999
    },
    {
      "index": 15,
      "scene_id": "05",
      "scene_title": "프레임 예산",
      "text": "프레임 레이트가 높을수록 물리, 애니메이션, 게임 로직과 렌더링을 끝낼 시간 예산은 더 작아집니다.",
      "start": 93.20249999999999,
      "end": 99.67999999999998
    },
    {
      "index": 16,
      "scene_id": "06",
      "scene_title": "가변 프레임 레이트",
      "text": "적과 조명, 이펙트가 많아져 정해진 시간 안에 계산을 끝내지 못하면 육십이던 수치가 오십이나 사십으로 떨어질 수 있습니다.",
      "start": 100.39999999999998,
      "end": 109.01249999999997
    },
    {
      "index": 17,
      "scene_id": "06",
      "scene_title": "가변 프레임 레이트",
      "text": "프레임 간격이 들쭉날쭉하면 평균 수치가 높아도 고르지 않게 느껴지므로, 한 장을 만드는 데 걸린 프레임 타임도 함께 봐야 합니다.",
      "start": 109.01249999999997,
      "end": 116.71999999999997
    },
    {
      "index": 18,
      "scene_id": "07",
      "scene_title": "deltaTime",
      "text": "현대 게임은 화면의 프레임 레이트가 변해도 게임 시간이 같은 속도로 흐르도록 계산하는 경우가 많습니다.",
      "start": 117.43999999999997,
      "end": 123.48249999999997
    },
    {
      "index": 19,
      "scene_id": "07",
      "scene_title": "deltaTime",
      "text": "대표적인 방법이 델타 타임으로, 속도에 한 프레임 동안 실제로 흐른 시간을 곱합니다.",
      "start": 123.48249999999997,
      "end": 128.66249999999997
    },
    {
      "index": 20,
      "scene_id": "07",
      "scene_title": "deltaTime",
      "text": "그러면 삼십 프레임과 육십 프레임 모두 같은 일 초 뒤에 같은 위치에 도착할 수 있습니다.",
      "start": 128.66249999999997,
      "end": 134.22249999999997
    },
    {
      "index": 21,
      "scene_id": "07",
      "scene_title": "deltaTime",
      "text": "충돌과 물리는 안정성을 위해 고정된 시간 간격으로 따로 계산하기도 하며, 핵심은 화면 빈도와 게임 시간 계산을 무조건 같은 것으로 보지 않는 것입니다.",
      "start": 134.22249999999997,
      "end": 143.19999999999996
    },
    {
      "index": 22,
      "scene_id": "08",
      "scene_title": "120 FPS와 모니터 Hz",
      "text": "피시 게임에서는 백이십이나 이백사십 에프 피 에스처럼 더 높은 수치도 사용됩니다.",
      "start": 143.91999999999996,
      "end": 148.94249999999997
    },
    {
      "index": 23,
      "scene_id": "08",
      "scene_title": "120 FPS와 모니터 Hz",
      "text": "중간 프레임이 많으면 빠른 움직임을 더 세밀하게 보여 주고 새 입력의 결과를 더 일찍 그릴 기회도 많아집니다.",
      "start": 148.94249999999997,
      "end": 155.57249999999996
    },
    {
      "index": 24,
      "scene_id": "08",
      "scene_title": "120 FPS와 모니터 Hz",
      "text": "하지만 에프 피 에스는 게임이 만든 프레임 수이고 헤르츠는 모니터의 갱신 횟수이므로, 서로 영향을 주지만 같은 개념은 아닙니다.",
      "start": 155.57249999999996,
      "end": 163.03999999999996
    },
    {
      "index": 25,
      "scene_id": "09",
      "scene_title": "NTSC와 PAL",
      "text": "과거 콘솔 게임은 지역별 텔레비전 규격의 영향도 크게 받았습니다.",
      "start": 163.75999999999996,
      "end": 168.30249999999995
    },
    {
      "index": 26,
      "scene_id": "09",
      "scene_title": "NTSC와 PAL",
      "text": "일본과 북미의 엔티에스시는 약 육십 필드, 유럽과 호주의 팔 방식은 오십 필드를 기준으로 동작했습니다.",
      "start": 168.30249999999995,
      "end": 175.57249999999996
    },
    {
      "index": 27,
      "scene_id": "09",
      "scene_title": "NTSC와 PAL",
      "text": "게임 로직을 화면 갱신에 묶고 보정하지 않으면 오십을 육십으로 나눈 만큼 느려질 수 있었고, 이는 프레임을 곧바로 시간으로 사용한 문제였습니다.",
      "start": 175.57249999999996,
      "end": 184.63999999999996
    },
    {
      "index": 28,
      "scene_id": "10",
      "scene_title": "PS5 세대의 그래픽 모드",
      "text": "현대 콘솔에서는 하나의 하드웨어에서도 그래픽 품질과 프레임 레이트 사이의 선택을 제공하는 게임이 많습니다.",
      "start": 185.35999999999996,
      "end": 192.03249999999997
    },
    {
      "index": 29,
      "scene_id": "10",
      "scene_title": "PS5 세대의 그래픽 모드",
      "text": "플레이스테이션 파이브의 해상도 또는 품질 모드는 더 높은 화질과 복잡한 효과를, 성능 모드는 더 높은 목표 프레임 레이트를 우선하는 방향입니다.",
      "start": 192.03249999999997,
      "end": 201.11249999999995
    },
    {
      "index": 30,
      "scene_id": "10",
      "scene_title": "PS5 세대의 그래픽 모드",
      "text": "정확한 해상도와 수치는 게임마다 다르므로 품질은 항상 삼십, 성능은 항상 육십이라고 일반화할 수는 없습니다.",
      "start": 201.11249999999995,
      "end": 207.91999999999996
    },
    {
      "index": 31,
      "scene_id": "11",
      "scene_title": "GPU가 한 프레임에 하는 일",
      "text": "한 프레임 안에서는 지오메트리, 조명, 그림자, 반사, 레이 트레이싱과 후처리 같은 작업이 진행됩니다.",
      "start": 208.63999999999996,
      "end": 214.84249999999994
    },
    {
      "index": 32,
      "scene_id": "11",
      "scene_title": "GPU가 한 프레임에 하는 일",
      "text": "효과를 늘려도 프레임 예산은 그대로이므로, 그래픽 품질과 프레임 레이트의 트레이드오프는 제한된 밀리초를 어디에 쓸지 정하는 문제입니다.",
      "start": 214.84249999999994,
      "end": 223.67999999999995
    },
    {
      "index": 33,
      "scene_id": "12",
      "scene_title": "RTX 50 시리즈와 현대 렌더링",
      "text": "알티엑스 오십 시리즈처럼 레이 트레이싱과 인공지능 연산용 하드웨어를 갖춘 그래픽 카드는 복잡한 조명을 실시간으로 처리할 범위를 넓혀 줍니다.",
      "start": 224.39999999999995,
      "end": 233.62249999999995
    },
    {
      "index": 34,
      "scene_id": "12",
      "scene_title": "RTX 50 시리즈와 현대 렌더링",
      "text": "하지만 최신 렌더링은 모든 픽셀과 프레임을 전통적인 방식으로 직접 계산하기보다, 적게 계산한 정보에서 최종 화면을 재구성하기도 합니다.",
      "start": 233.62249999999995,
      "end": 242.71999999999994
    },
    {
      "index": 35,
      "scene_id": "13",
      "scene_title": "4K의 픽셀 비용",
      "text": "포 케이 화면은 약 팔백이십구만 픽셀이고, 레이 트레이싱까지 사용하면 여러 광선 표본과 추가 계산이 필요할 수 있습니다.",
      "start": 243.43999999999994,
      "end": 251.60249999999994
    },
    {
      "index": 36,
      "scene_id": "13",
      "scene_title": "4K의 픽셀 비용",
      "text": "해상도와 조명 계산이 늘어날수록 비용은 커지는데, 최종 픽셀을 모두 처음부터 포 케이로 직접 계산해야만 할까요?",
      "start": 251.60249999999994,
      "end": 259.2800416666666
    },
    {
      "index": 37,
      "scene_id": "14",
      "scene_title": "DLSS Super Resolution",
      "text": "디엘에스에스 슈퍼 레졸루션은 목표 출력보다 낮은 내부 해상도로 렌더링한 뒤 더 높은 해상도의 이미지를 구성합니다.",
      "start": 260.0000416666666,
      "end": 267.7425416666666
    },
    {
      "index": 38,
      "scene_id": "14",
      "scene_title": "DLSS Super Resolution",
      "text": "단순한 확대가 아니라 낮은 해상도의 여러 프레임과 모션 벡터, 이전 프레임 정보를 함께 활용합니다.",
      "start": 267.7425416666666,
      "end": 274.3025416666666
    },
    {
      "index": 39,
      "scene_id": "14",
      "scene_title": "DLSS Super Resolution",
      "text": "직접 계산할 픽셀 수를 줄이면서 출력 해상도에 가까운 세부 묘사를 복원하는 것이 목표입니다.",
      "start": 274.3025416666666,
      "end": 280.0525416666666
    },
    {
      "index": 40,
      "scene_id": "14",
      "scene_title": "DLSS Super Resolution",
      "text": "이 기술은 픽셀을 재구성합니다. 직접 렌더 사이에 새 화면을 만드는 프레임 제너레이션과는 서로 다른 기술입니다.",
      "start": 280.0525416666666,
      "end": 287.6800416666666
    },
    {
      "index": 41,
      "scene_id": "15",
      "scene_title": "Frame Generation",
      "text": "프레임 제너레이션은 직접 렌더링된 두 프레임 사이의 움직임을 분석해 새로운 한 장을 생성합니다.",
      "start": 288.40004166666665,
      "end": 294.66254166666664
    },
    {
      "index": 42,
      "scene_id": "15",
      "scene_title": "Frame Generation",
      "text": "타임라인에서는 직접 렌더 프레임을 파란색, 생성 프레임을 보라색으로 구분해 보겠습니다.",
      "start": 294.66254166666664,
      "end": 300.82254166666667
    },
    {
      "index": 43,
      "scene_id": "15",
      "scene_title": "Frame Generation",
      "text": "렌더 프레임 사이에 생성 프레임을 넣으면 화면에 표시되는 프레임 수와 움직임의 부드러움을 높일 수 있습니다.",
      "start": 300.82254166666667,
      "end": 307.91254166666664
    },
    {
      "index": 44,
      "scene_id": "15",
      "scene_title": "Frame Generation",
      "text": "하지만 생성 프레임은 게임 세계를 새로 계산한 결과가 아니므로 기본 렌더 속도와 입력 지연까지 같은 비율로 좋아진다는 뜻은 아닙니다.",
      "start": 307.91254166666664,
      "end": 316.2400416666666
    },
    {
      "index": 45,
      "scene_id": "16",
      "scene_title": "DLSS 4 Multi Frame Generation",
      "text": "디엘에스에스 포는 알티엑스 오십 시리즈에 멀티 프레임 제너레이션을 도입했습니다.",
      "start": 316.96004166666665,
      "end": 322.39254166666666
    },
    {
      "index": 46,
      "scene_id": "16",
      "scene_title": "DLSS 4 Multi Frame Generation",
      "text": "출시 당시에는 직접 렌더링한 프레임 하나당 최대 세 개의 추가 프레임을 생성할 수 있었습니다.",
      "start": 322.39254166666666,
      "end": 328.86254166666663
    },
    {
      "index": 47,
      "scene_id": "16",
      "scene_title": "DLSS 4 Multi Frame Generation",
      "text": "이후 디엘에스에스 사 점 오는 장면에 따라 생성 수를 조절하고 더 많은 생성 프레임을 지원하는 방향으로 확장됐습니다.",
      "start": 328.86254166666663,
      "end": 336.40254166666665
    },
    {
      "index": 48,
      "scene_id": "16",
      "scene_title": "DLSS 4 Multi Frame Generation",
      "text": "실제 결과는 게임 지원 여부와 기본 렌더 속도, 해상도, 그래픽 카드와 중앙 처리 장치 조건에 따라 달라집니다.",
      "start": 336.40254166666665,
      "end": 343.28004166666665
    },
    {
      "index": 49,
      "scene_id": "17",
      "scene_title": "Rendered FPS와 Displayed FPS",
      "text": "직접 렌더링한 프레임 사이에 생성 프레임이 들어가면 표시 수치는 높아지지만, 모든 장면을 새 입력과 시뮬레이션으로 만든 것은 아닙니다.",
      "start": 344.0000416666667,
      "end": 353.19254166666667
    },
    {
      "index": 50,
      "scene_id": "17",
      "scene_title": "Rendered FPS와 Displayed FPS",
      "text": "그래서 렌더 에프 피 에스와 표시 에프 피 에스를 따로 표기해야 프레임 생성의 결과를 정확히 이해할 수 있습니다.",
      "start": 353.19254166666667,
      "end": 360.1600416666667
    },
    {
      "index": 51,
      "scene_id": "18",
      "scene_title": "FPS 숫자 하나만 보면 안 되는 이유",
      "text": "입력은 게임 시뮬레이션과 렌더링을 거쳐, 필요하면 업스케일링과 프레임 생성 뒤 모니터에 표시됩니다.",
      "start": 360.8800416666667,
      "end": 367.5725416666667
    },
    {
      "index": 52,
      "scene_id": "18",
      "scene_title": "FPS 숫자 하나만 보면 안 되는 이유",
      "text": "렌더 에프 피 에스는 직접 그린 빈도이고 표시 에프 피 에스는 생성 프레임을 포함한 빈도이며, 입력 지연은 버튼부터 화면의 빛까지 걸린 시간입니다.",
      "start": 367.5725416666667,
      "end": 377.4625416666667
    },
    {
      "index": 53,
      "scene_id": "18",
      "scene_title": "FPS 숫자 하나만 보면 안 되는 이유",
      "text": "엔비디아 리플렉스 같은 기술은 시스템 지연을 줄이는 역할을 하지만 이 개념들을 하나로 합치는 것은 아닙니다.",
      "start": 377.4625416666667,
      "end": 383.85254166666675
    },
    {
      "index": 54,
      "scene_id": "18",
      "scene_title": "FPS 숫자 하나만 보면 안 되는 이유",
      "text": "따라서 높은 숫자 하나보다 기본 렌더 속도, 프레임 타임, 표시 방식과 지연을 함께 확인해야 합니다.",
      "start": 383.85254166666675,
      "end": 390.00004166666673
    },
    {
      "index": 55,
      "scene_id": "19",
      "scene_title": "과거와 현대의 프레임 파이프라인",
      "text": "과거의 단순한 게임에서는 게임 로직, 프레임 생성과 화면 출력이 거의 한 줄로 묶인 경우가 많았습니다.",
      "start": 390.72004166666676,
      "end": 398.05254166666674
    },
    {
      "index": 56,
      "scene_id": "19",
      "scene_title": "과거와 현대의 프레임 파이프라인",
      "text": "현대 게임은 입력, 시뮬레이션, 렌더링, 업스케일링, 프레임 생성과 출력이 나뉘며, 각 단계가 반드시 같은 빈도로 실행되지는 않습니다.",
      "start": 398.05254166666674,
      "end": 407.2000416666668
    },
    {
      "index": 57,
      "scene_id": "20",
      "scene_title": "최종 정리",
      "text": "정리하면 프레임은 화면 한 장이고, 에프 피 에스는 일 초 동안 처리하거나 표시하는 프레임의 빈도입니다.",
      "start": 407.9200416666668,
      "end": 414.6525416666668
    },
    {
      "index": 58,
      "scene_id": "20",
      "scene_title": "최종 정리",
      "text": "삼십, 육십, 백이십 에프 피 에스는 각각 약 삼십삼, 십육, 팔 밀리초의 프레임 예산을 가집니다.",
      "start": 414.6525416666668,
      "end": 421.89254166666683
    },
    {
      "index": 59,
      "scene_id": "20",
      "scene_title": "최종 정리",
      "text": "델타 타임과 고정 타임 스텝은 화면 빈도가 달라도 게임 세계의 시간을 안정적으로 진행시키는 데 사용됩니다.",
      "start": 421.89254166666683,
      "end": 428.9525416666668
    },
    {
      "index": 60,
      "scene_id": "20",
      "scene_title": "최종 정리",
      "text": "현대 렌더링에서는 슈퍼 레졸루션, 직접 렌더 프레임, 생성 프레임, 표시 프레임과 입력 지연을 구분해야 합니다.",
      "start": 428.9525416666668,
      "end": 435.7925416666668
    },
    {
      "index": 61,
      "scene_id": "20",
      "scene_title": "최종 정리",
      "text": "게임을 만들 때는 목표 프레임 레이트를 정하고 프레임 타임을 측정하며, 서로 다른 성능 환경에서도 같은 게임 속도가 유지되는지 확인해 보세요.",
      "start": 435.7925416666668,
      "end": 445.6800416666668
    }
  ]
}
