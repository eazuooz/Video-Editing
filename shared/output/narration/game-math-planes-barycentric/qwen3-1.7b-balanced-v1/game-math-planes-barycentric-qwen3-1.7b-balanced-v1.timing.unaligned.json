{
  "sample_rate": 24000,
  "duration_seconds": 970.2500416666669,
  "render_mode": "scene",
  "example_seconds": 0.0,
  "narration_placement": "continuous-across-example-and-explanation",
  "entries": [
    {
      "index": 1,
      "scene_id": "01",
      "scene_title": "바닥까지의 거리와 삼각형 안의 위치",
      "text": "점이 바닥에서 얼마나 떨어져 있는지, 삼각형 안에서는 어디에 있는지 어떻게 계산할까요?",
      "start": 0.0,
      "end": 5.3825
    },
    {
      "index": 2,
      "scene_id": "01",
      "scene_title": "바닥까지의 거리와 삼각형 안의 위치",
      "text": "먼저 실제 게임의 발판과 지형을 관찰하고, 평면의 법선과 부호 있는 거리를 구합니다.",
      "start": 5.3825,
      "end": 10.9625
    },
    {
      "index": 3,
      "scene_id": "01",
      "scene_title": "바닥까지의 거리와 삼각형 안의 위치",
      "text": "이어서 세 점으로 삼각형을 만들고, 넓이와 무게중심 좌표를 숫자로 계산하겠습니다.",
      "start": 10.9625,
      "end": 16.2725
    },
    {
      "index": 4,
      "scene_id": "01",
      "scene_title": "바닥까지의 거리와 삼각형 안의 위치",
      "text": "마지막에는 평면 밖의 점을 잘못 포함하는 오류를 확인하고, 같은 좌표로 색을 보간합니다.",
      "start": 16.2725,
      "end": 22.0
    },
    {
      "index": 5,
      "scene_id": "02",
      "scene_title": "발판의 표면을 기준으로 보기",
      "text": "시리어스 샘 투의 해안에서 길과 다리를 따라 이동합니다. 발밑의 바닥과 다리의 윗면을 보세요.",
      "start": 22.45,
      "end": 29.0525
    },
    {
      "index": 6,
      "scene_id": "02",
      "scene_title": "발판의 표면을 기준으로 보기",
      "text": "캐릭터가 표면 위로 떠 있는지, 그 표면에 가까워지는지 구분할 기준이 필요합니다.",
      "start": 29.0525,
      "end": 34.6325
    },
    {
      "index": 7,
      "scene_id": "02",
      "scene_title": "발판의 표면을 기준으로 보기",
      "text": "그 기준을 수학에서는 평면으로 단순하게 만들 수 있습니다. 실제 발판에는 두께와 끝이 있지만 평면은 무한히 이어집니다.",
      "start": 34.6325,
      "end": 41.5125
    },
    {
      "index": 8,
      "scene_id": "02",
      "scene_title": "발판의 표면을 기준으로 보기",
      "text": "따라서 표면까지의 거리와 발판 위의 허용 범위는 다른 검사입니다. 거리만 맞아도 옆으로 벗어나 있을 수 있습니다.",
      "start": 41.5125,
      "end": 48.692499999999995
    },
    {
      "index": 9,
      "scene_id": "02",
      "scene_title": "발판의 표면을 기준으로 보기",
      "text": "카메라가 돌아가면 윗면의 화면 모양도 바뀝니다. 계산은 같은 좌표계에서 정의한 점과 법선을 사용해야 합니다.",
      "start": 48.692499999999995,
      "end": 55.5025
    },
    {
      "index": 10,
      "scene_id": "02",
      "scene_title": "발판의 표면을 기준으로 보기",
      "text": "이 장면은 기준 표면을 찾는 연습입니다. 게임 내부에서 무한 평면 충돌을 쓰는지는 화면만으로 알 수 없습니다.",
      "start": 55.5025,
      "end": 62.61
    },
    {
      "index": 11,
      "scene_id": "03",
      "scene_title": "평면의 방향과 위치를 나누기",
      "text": "평면은 법선 벡터와 위치를 나타내는 숫자로 표현합니다. 법선은 평면을 따라가는 방향이 아니라 수직인 방향입니다.",
      "start": 63.06,
      "end": 71.1525
    },
    {
      "index": 12,
      "scene_id": "03",
      "scene_title": "평면의 방향과 위치를 나누기",
      "text": "평면 위의 점과 법선을 내적하면 일정한 값이 나옵니다. 그 값을 알파벳 디라고 쓰겠습니다.",
      "start": 71.1525,
      "end": 77.8425
    },
    {
      "index": 13,
      "scene_id": "03",
      "scene_title": "평면의 방향과 위치를 나누기",
      "text": "법선의 세 성분은 영, 일, 영입니다. 상수 디의 값은 이입니다. 이때 와이가 이인 모든 점이 평면 위에 있습니다.",
      "start": 77.8425,
      "end": 83.1725
    },
    {
      "index": 14,
      "scene_id": "03",
      "scene_title": "평면의 방향과 위치를 나누기",
      "text": "와이가 영인 평면은 원점을 지나지만, 와이가 이인 평면은 원점을 지나지 않습니다. 일반 평면은 원점을 지나는 선형 부분공간일 필요가 없습니다.",
      "start": 83.1725,
      "end": 94.7325
    },
    {
      "index": 15,
      "scene_id": "03",
      "scene_title": "평면의 방향과 위치를 나누기",
      "text": "평면 위의 두 점을 빼면 평면을 따라가는 벡터가 됩니다. 그 차이와 법선의 내적은 영입니다.",
      "start": 94.7325,
      "end": 101.61250000000001
    },
    {
      "index": 16,
      "scene_id": "03",
      "scene_title": "평면의 방향과 위치를 나누기",
      "text": "법선의 방향을 뒤집으면 앞과 뒤가 바뀝니다. 식을 그대로 유지하려면 디의 부호도 함께 뒤집어야 합니다.",
      "start": 101.61250000000001,
      "end": 108.1
    },
    {
      "index": 17,
      "scene_id": "04",
      "scene_title": "식의 값과 실제 거리를 구분하기",
      "text": "점에서 평면 식의 값을 구하려면 법선과 점을 내적하고 디를 뺍니다. 양수는 법선 쪽, 음수는 반대쪽입니다.",
      "start": 108.55,
      "end": 116.9225
    },
    {
      "index": 18,
      "scene_id": "04",
      "scene_title": "식의 값과 실제 거리를 구분하기",
      "text": "법선의 세 성분은 영, 이, 영입니다. 상수 디의 값은 사입니다. 이 평면에서도 와이가 이이고, 법선 길이는 이입니다.",
      "start": 116.9225,
      "end": 124.1625
    },
    {
      "index": 19,
      "scene_id": "04",
      "scene_title": "식의 값과 실제 거리를 구분하기",
      "text": "점이 사, 오, 마이너스 삼이면 내적은 십입니다. 사를 빼면 육이지만 실제 거리는 육이 아닙니다.",
      "start": 124.1625,
      "end": 132.4325
    },
    {
      "index": 20,
      "scene_id": "04",
      "scene_title": "식의 값과 실제 거리를 구분하기",
      "text": "법선의 길이 이로 나누면 부호 있는 거리는 삼입니다. 단위 법선일 때만 식의 값 자체가 거리가 됩니다.",
      "start": 132.4325,
      "end": 138.9525
    },
    {
      "index": 21,
      "scene_id": "04",
      "scene_title": "식의 값과 실제 거리를 구분하기",
      "text": "같은 평면을 단위 법선으로 바꾸려면 법선과 디를 둘 다 이로 나눕니다. 법선만 줄이면 평면 위치가 바뀝니다.",
      "start": 138.9525,
      "end": 146.5025
    },
    {
      "index": 22,
      "scene_id": "04",
      "scene_title": "식의 값과 실제 거리를 구분하기",
      "text": "법선 길이가 영인 입력은 평면 방향을 정하지 못합니다. 나누기 전에 유효성을 확인하세요.",
      "start": 146.5025,
      "end": 152.79
    },
    {
      "index": 23,
      "scene_id": "05",
      "scene_title": "지형의 높이와 기준선",
      "text": "노이타에서는 캐릭터가 층층이 놓인 지형 사이로 움직입니다. 물의 수평선과 나무 바닥을 기준으로 보세요.",
      "start": 153.23999999999998,
      "end": 160.4825
    },
    {
      "index": 24,
      "scene_id": "05",
      "scene_title": "지형의 높이와 기준선",
      "text": "캐릭터가 같은 기준선보다 위에 있는지 아래에 있는지는 높이 차이의 부호로 구분할 수 있습니다.",
      "start": 160.4825,
      "end": 166.37249999999997
    },
    {
      "index": 25,
      "scene_id": "05",
      "scene_title": "지형의 높이와 기준선",
      "text": "화면이 따라 움직여도 기준을 함께 보면 상대적인 위치를 찾을 수 있습니다. 화면 맨 아래를 고정된 월드 바닥으로 생각하면 안 됩니다.",
      "start": 166.37249999999997,
      "end": 175.21249999999998
    },
    {
      "index": 26,
      "scene_id": "05",
      "scene_title": "지형의 높이와 기준선",
      "text": "단순한 수평면 예제에서는 와이 좌표에서 기준 높이를 빼면 됩니다. 기울어진 표면에서는 수직 높이 대신 법선 방향 거리를 써야 합니다.",
      "start": 175.21249999999998,
      "end": 184.41249999999997
    },
    {
      "index": 27,
      "scene_id": "05",
      "scene_title": "지형의 높이와 기준선",
      "text": "여러 층의 바닥을 하나의 무한 평면으로 바꾸면 구멍과 가장자리 정보가 사라집니다. 표면 위치와 경계는 따로 확인해야 합니다.",
      "start": 184.41249999999997,
      "end": 192.39249999999998
    },
    {
      "index": 28,
      "scene_id": "05",
      "scene_title": "지형의 높이와 기준선",
      "text": "다음 그림에서는 직접 정의한 평면으로 가장 가까운 점까지 구합니다. 게임의 픽셀 지형이 그 식으로 구현됐다는 뜻은 아닙니다.",
      "start": 192.39249999999998,
      "end": 200.59999999999997
    },
    {
      "index": 29,
      "scene_id": "06",
      "scene_title": "평면 위의 가장 가까운 점",
      "text": "아까 점 사, 오, 마이너스 삼에서 와이가 이인 평면까지의 부호 있는 거리는 삼이었습니다.",
      "start": 201.04999999999995,
      "end": 207.16249999999997
    },
    {
      "index": 30,
      "scene_id": "06",
      "scene_title": "평면 위의 가장 가까운 점",
      "text": "가장 가까운 점으로 가려면 법선 방향으로 삼만큼 내려갑니다. 결과는 사, 이, 마이너스 삼입니다.",
      "start": 207.16249999999997,
      "end": 213.42249999999996
    },
    {
      "index": 31,
      "scene_id": "06",
      "scene_title": "평면 위의 가장 가까운 점",
      "text": "단위 법선이라면 원래 점에서 부호 있는 거리 곱하기 단위 법선을 빼면 됩니다.",
      "start": 213.42249999999996,
      "end": 218.00249999999994
    },
    {
      "index": 32,
      "scene_id": "06",
      "scene_title": "평면 위의 가장 가까운 점",
      "text": "정규화하지 않은 법선을 그대로 쓰려면 식의 값을 법선 길이의 제곱으로 나누고, 그 결과를 법선에 곱해 뺍니다.",
      "start": 218.00249999999994,
      "end": 225.03249999999997
    },
    {
      "index": 33,
      "scene_id": "06",
      "scene_title": "평면 위의 가장 가까운 점",
      "text": "평면 뒤쪽에 있는 점에서는 거리가 음수라서 법선 방향으로 올라갑니다. 앞뒤 모두 같은 식을 씁니다.",
      "start": 225.03249999999997,
      "end": 231.34249999999994
    },
    {
      "index": 34,
      "scene_id": "06",
      "scene_title": "평면 위의 가장 가까운 점",
      "text": "이 투영은 무한 평면의 가장 가까운 점입니다. 삼각형이나 발판의 끝을 넘어가면, 가장자리가 있는 표면의 최근접점은 별도로 검사해야 합니다.",
      "start": 231.34249999999994,
      "end": 240.64999999999995
    },
    {
      "index": 35,
      "scene_id": "07",
      "scene_title": "세 점으로 법선 만들기",
      "text": "한 직선 위에 있지 않은 세 점은 하나의 평면을 정합니다. 한 꼭짓점에서 다른 두 꼭짓점으로 향하는 변 벡터를 만듭니다.",
      "start": 241.09999999999994,
      "end": 249.33249999999992
    },
    {
      "index": 36,
      "scene_id": "07",
      "scene_title": "세 점으로 법선 만들기",
      "text": "첫 변이 육, 영, 영이고 둘째 변이 영, 사, 영이면 외적은 영, 영, 이십사입니다.",
      "start": 249.33249999999992,
      "end": 253.42249999999993
    },
    {
      "index": 37,
      "scene_id": "07",
      "scene_title": "세 점으로 법선 만들기",
      "text": "이 강의는 오른손 좌표계에서 첫 변 외적 둘째 변을 씁니다. 단위 법선은 영, 영, 일입니다.",
      "start": 253.42249999999993,
      "end": 259.93249999999995
    },
    {
      "index": 38,
      "scene_id": "07",
      "scene_title": "세 점으로 법선 만들기",
      "text": "두 변의 순서를 바꾸면 외적과 법선이 반대로 향합니다. 점 순서와 앞면 규칙을 함께 정하세요.",
      "start": 259.93249999999995,
      "end": 265.69249999999994
    },
    {
      "index": 39,
      "scene_id": "07",
      "scene_title": "세 점으로 법선 만들기",
      "text": "점 하나와 법선을 내적하면 디를 구할 수 있습니다. 지금은 세 점의 제트가 모두 영이므로 디도 영입니다.",
      "start": 265.69249999999994,
      "end": 272.4124999999999
    },
    {
      "index": 40,
      "scene_id": "07",
      "scene_title": "세 점으로 법선 만들기",
      "text": "세 점이 한 직선에 있으면 외적이 영입니다. 거의 한 직선에 있는 경우도 오차가 커질 수 있으므로 정규화 전에 검사해야 합니다.",
      "start": 272.4124999999999,
      "end": 281.97999999999996
    },
    {
      "index": 41,
      "scene_id": "08",
      "scene_title": "눈에 보이는 삼각형 표식을 관찰하기",
      "text": "바위의 밝은 삼각형 표식과 그쪽으로 연결되는 그래플을 보세요. 세 꼭짓점과 그 안의 위치를 나눠 생각할 수 있습니다.",
      "start": 282.42999999999995,
      "end": 290.9625
    },
    {
      "index": 42,
      "scene_id": "08",
      "scene_title": "눈에 보이는 삼각형 표식을 관찰하기",
      "text": "카메라가 움직이면 삼각형이 기울고 화면에서 납작해 보입니다. 원래 표면의 형태와 화면 투영은 구분해야 합니다.",
      "start": 290.9625,
      "end": 298.56249999999994
    },
    {
      "index": 43,
      "scene_id": "08",
      "scene_title": "눈에 보이는 삼각형 표식을 관찰하기",
      "text": "세 점의 순서를 정해 둘레를 따라가면 앞면 방향을 정의할 수 있습니다. 순서를 뒤집으면 법선도 반대로 정해집니다.",
      "start": 298.56249999999994,
      "end": 306.37249999999995
    },
    {
      "index": 44,
      "scene_id": "08",
      "scene_title": "눈에 보이는 삼각형 표식을 관찰하기",
      "text": "삼각형 표식이 보인다고 바위 전체의 실제 메시 구성을 알 수 있는 것은 아닙니다. 지금은 눈에 보이는 표식을 수학 예제와 연결합니다.",
      "start": 306.37249999999995,
      "end": 315.42249999999996
    },
    {
      "index": 45,
      "scene_id": "08",
      "scene_title": "눈에 보이는 삼각형 표식을 관찰하기",
      "text": "그래플의 연결 위치가 표식의 어느 꼭짓점에 가까운지 관찰해 보세요. 세 기준점 사이의 위치를 숫자로 표현하는 방법이 뒤에 나옵니다.",
      "start": 315.42249999999996,
      "end": 323.82249999999993
    },
    {
      "index": 46,
      "scene_id": "08",
      "scene_title": "눈에 보이는 삼각형 표식을 관찰하기",
      "text": "먼저 점이 더 많은 표면의 법선을 정리하고, 삼각형의 길이와 넓이부터 계산하겠습니다.",
      "start": 323.82249999999993,
      "end": 329.38999999999993
    },
    {
      "index": 47,
      "scene_id": "09",
      "scene_title": "여러 꼭짓점에는 순서가 필요합니다",
      "text": "다각형의 꼭짓점이 여러 개라면 아무 세 점만 고르는 방법은 불안정할 수 있습니다. 그 세 점이 거의 한 직선에 있거나 오목한 부분일 수 있기 때문입니다.",
      "start": 329.8399999999999,
      "end": 340.70249999999993
    },
    {
      "index": 48,
      "scene_id": "09",
      "scene_title": "여러 꼭짓점에는 순서가 필요합니다",
      "text": "뉴웰 방식은 둘레 순서대로 이웃한 점의 기여를 누적합니다. 마지막 점 다음에는 첫 점을 연결합니다.",
      "start": 340.70249999999993,
      "end": 347.8924999999999
    },
    {
      "index": 49,
      "scene_id": "09",
      "scene_title": "여러 꼭짓점에는 순서가 필요합니다",
      "text": "제트 성분에서는 이웃한 두 점의 엑스 차이와 와이 합을 곱해 더합니다. 다른 성분도 좌표를 순환해서 계산합니다.",
      "start": 347.8924999999999,
      "end": 355.82249999999993
    },
    {
      "index": 50,
      "scene_id": "09",
      "scene_title": "여러 꼭짓점에는 순서가 필요합니다",
      "text": "둘레 순서를 뒤집으면 법선 방향이 뒤집힙니다. 임의로 섞인 점들을 그대로 넣는 방식이 아닙니다.",
      "start": 355.82249999999993,
      "end": 362.4324999999999
    },
    {
      "index": 51,
      "scene_id": "09",
      "scene_title": "여러 꼭짓점에는 순서가 필요합니다",
      "text": "법선을 정한 뒤 디는 각 점과 법선의 내적을 평균해서 구할 수 있습니다. 이것은 평균점과 법선의 내적과 같습니다.",
      "start": 362.4324999999999,
      "end": 369.6724999999999
    },
    {
      "index": 52,
      "scene_id": "09",
      "scene_title": "여러 꼭짓점에는 순서가 필요합니다",
      "text": "원문은 가장 잘 맞는 평면이라고 부르지만, 순서 없는 점군의 최소제곱 평면과 일반적으로 같지는 않습니다. 점의 수와 퇴화 여부도 별도로 확인하세요.",
      "start": 369.6724999999999,
      "end": 379.9999999999999
    },
    {
      "index": 53,
      "scene_id": "10",
      "scene_title": "변의 길이와 각을 연결하기",
      "text": "삼각형의 각 꼭짓점 반대편 변을 같은 번호로 부르겠습니다. 세 변의 길이를 더하면 둘레입니다.",
      "start": 380.4499999999999,
      "end": 387.4224999999999
    },
    {
      "index": 54,
      "scene_id": "10",
      "scene_title": "변의 길이와 각을 연결하기",
      "text": "변의 길이가 삼, 사, 오인 직각삼각형의 둘레는 십이이고, 그 절반은 육입니다.",
      "start": 387.4224999999999,
      "end": 391.39249999999987
    },
    {
      "index": 55,
      "scene_id": "10",
      "scene_title": "변의 길이와 각을 연결하기",
      "text": "한 각과 마주 보는 변의 길이를 사인값으로 나눈 비율은 세 꼭짓점에서 같습니다. 이것이 사인 법칙입니다.",
      "start": 391.39249999999987,
      "end": 398.09249999999986
    },
    {
      "index": 56,
      "scene_id": "10",
      "scene_title": "변의 길이와 각을 연결하기",
      "text": "두 변과 그 사이의 각을 알면 코사인 법칙으로 나머지 변을 구합니다. 길이의 제곱을 다룬다는 점을 기억하세요.",
      "start": 398.09249999999986,
      "end": 406.90249999999986
    },
    {
      "index": 57,
      "scene_id": "10",
      "scene_title": "변의 길이와 각을 연결하기",
      "text": "지금은 삼 제곱 더하기 사 제곱이 오 제곱입니다. 두 변 사이가 직각이라 코사인 항은 영입니다.",
      "start": 406.90249999999986,
      "end": 412.71249999999986
    },
    {
      "index": 58,
      "scene_id": "10",
      "scene_title": "변의 길이와 각을 연결하기",
      "text": "각도 함수의 라디안과 도 단위를 섞지 마세요. 각이나 변을 구한 뒤에도 양의 길이와 삼각형 성립 조건을 확인해야 합니다.",
      "start": 412.71249999999986,
      "end": 420.20999999999987
    },
    {
      "index": 59,
      "scene_id": "11",
      "scene_title": "세 기준점 사이에서 위치 찾기",
      "text": "노이타의 나무 발판 끝과 바위의 모서리를 보세요. 가까이 보이는 세 위치를 기준점으로 선택할 수 있습니다.",
      "start": 420.65999999999985,
      "end": 427.48249999999985
    },
    {
      "index": 60,
      "scene_id": "11",
      "scene_title": "세 기준점 사이에서 위치 찾기",
      "text": "캐릭터가 한 기준점에서 다른 기준점 쪽으로 이동하면, 어느 점에 가까운지가 바뀝니다.",
      "start": 427.48249999999985,
      "end": 432.0024999999998
    },
    {
      "index": 61,
      "scene_id": "11",
      "scene_title": "세 기준점 사이에서 위치 찾기",
      "text": "엑스와 와이 좌표로 설명할 수도 있지만, 세 기준점의 가중치를 쓰면 삼각형과 함께 움직이는 설명이 가능합니다.",
      "start": 432.0024999999998,
      "end": 438.4424999999999
    },
    {
      "index": 62,
      "scene_id": "11",
      "scene_title": "세 기준점 사이에서 위치 찾기",
      "text": "카메라가 이동할 때는 세 기준점도 같이 추적해야 합니다. 서로 다른 화면에서 읽은 픽셀 좌표를 섞으면 위치 관계가 틀어집니다.",
      "start": 438.4424999999999,
      "end": 445.79249999999985
    },
    {
      "index": 63,
      "scene_id": "11",
      "scene_title": "세 기준점 사이에서 위치 찾기",
      "text": "또한 기준점을 골랐다는 사실만으로 실제 바닥 전체가 하나의 삼각형이 되지는 않습니다. 사이에 빈 공간이 있을 수도 있습니다.",
      "start": 445.79249999999985,
      "end": 453.3124999999999
    },
    {
      "index": 64,
      "scene_id": "11",
      "scene_title": "세 기준점 사이에서 위치 찾기",
      "text": "다음 예제는 우리가 직접 정한 삼각형입니다. 넓이를 먼저 구하고, 그 안과 밖의 위치를 세 숫자로 나타내겠습니다.",
      "start": 453.3124999999999,
      "end": 460.1000416666665
    },
    {
      "index": 65,
      "scene_id": "12",
      "scene_title": "같은 넓이를 세 방법으로 구하기",
      "text": "꼭짓점이 영, 영과 사, 영과 영, 삼인 삼각형입니다. 밑변 사에 높이 삼을 곱하고 이로 나누면 넓이는 육입니다.",
      "start": 460.5500416666665,
      "end": 469.33254166666654
    },
    {
      "index": 66,
      "scene_id": "12",
      "scene_title": "같은 넓이를 세 방법으로 구하기",
      "text": "세 변 삼, 사, 오를 알면 헤론 공식을 쓸 수 있습니다. 둘레의 절반 육에서 각 변을 뺀 값을 곱합니다.",
      "start": 469.33254166666654,
      "end": 473.5625416666665
    },
    {
      "index": 67,
      "scene_id": "12",
      "scene_title": "같은 넓이를 세 방법으로 구하기",
      "text": "루트 안은 육 곱하기 삼 곱하기 이 곱하기 일, 즉 삼십육입니다. 제곱근은 육입니다.",
      "start": 473.5625416666665,
      "end": 479.97254166666653
    },
    {
      "index": 68,
      "scene_id": "12",
      "scene_title": "같은 넓이를 세 방법으로 구하기",
      "text": "두 변 벡터의 외적 길이는 평행사변형 넓이입니다. 절반을 취하면 삼각형 넓이가 됩니다. 이 예제의 평행사변형 넓이는 십이입니다. 이를 이로 나누면 삼각형 넓이 육을 얻습니다.",
      "start": 479.97254166666653,
      "end": 491.8925416666665
    },
    {
      "index": 69,
      "scene_id": "12",
      "scene_title": "같은 넓이를 세 방법으로 구하기",
      "text": "이차원에서는 외적에 해당하는 행렬식에 부호가 있습니다. 꼭짓점 순서를 뒤집으면 부호가 바뀌지만 넓이의 크기는 같습니다.",
      "start": 491.8925416666665,
      "end": 501.9825416666665
    },
    {
      "index": 70,
      "scene_id": "12",
      "scene_title": "같은 넓이를 세 방법으로 구하기",
      "text": "삼차원에서 외적의 길이를 쓰면 방향의 부호는 사라집니다. 넓이와 앞면 방향을 같은 숫자라고 생각하지 마세요.",
      "start": 501.9825416666665,
      "end": 508.7100416666665
    },
    {
      "index": 71,
      "scene_id": "13",
      "scene_title": "세 숫자로 삼각형 위치 표현하기",
      "text": "무게중심 좌표는 세 꼭짓점의 가중치를 나타냅니다. 세 가중치의 합은 일이어야 합니다.",
      "start": 509.1600416666665,
      "end": 515.2525416666665
    },
    {
      "index": 72,
      "scene_id": "13",
      "scene_title": "세 숫자로 삼각형 위치 표현하기",
      "text": "각 꼭짓점에 가중치를 곱해서 더하면 위치가 나옵니다. 첫 꼭짓점 자체는 일, 영, 영입니다.",
      "start": 515.2525416666665,
      "end": 520.1225416666665
    },
    {
      "index": 73,
      "scene_id": "13",
      "scene_title": "세 숫자로 삼각형 위치 표현하기",
      "text": "첫째와 둘째 꼭짓점의 중간은 영 점 오, 영 점 오, 영입니다. 세 값이 모두 삼분의 일이면 꼭짓점 평균 위치입니다.",
      "start": 520.1225416666665,
      "end": 525.8225416666664
    },
    {
      "index": 74,
      "scene_id": "13",
      "scene_title": "세 숫자로 삼각형 위치 표현하기",
      "text": "세 숫자를 쓰지만 합이 일이라 독립적으로 고를 수 있는 값은 두 개입니다. 삼각형의 표면이 이차원이기 때문입니다.",
      "start": 525.8225416666664,
      "end": 533.2525416666665
    },
    {
      "index": 75,
      "scene_id": "13",
      "scene_title": "세 숫자로 삼각형 위치 표현하기",
      "text": "셋째 꼭짓점을 기준으로 쓰면 다른 두 꼭짓점에서 셋째를 뺀 변이 두 축이 됩니다. 이 축이 직각이거나 단위 길이일 필요는 없습니다.",
      "start": 533.2525416666665,
      "end": 543.1525416666665
    },
    {
      "index": 76,
      "scene_id": "13",
      "scene_title": "세 숫자로 삼각형 위치 표현하기",
      "text": "퇴화하지 않은 삼각형의 평면 위에서 가중치가 모두 영 이상이면 내부나 경계입니다. 음수 가중치도 의미가 있으며, 그때는 삼각형 밖의 점입니다.",
      "start": 543.1525416666665,
      "end": 551.4800416666665
    },
    {
      "index": 77,
      "scene_id": "14",
      "scene_title": "삼각형의 기준을 함께 옮기기",
      "text": "다른 바위로 연결되며 표식의 화면 위치가 바뀝니다. 연결 표식과 그 주변에서 세 기준점을 골라 보세요.",
      "start": 551.9300416666665,
      "end": 558.6525416666665
    },
    {
      "index": 78,
      "scene_id": "14",
      "scene_title": "삼각형의 기준을 함께 옮기기",
      "text": "표면과 카메라가 움직여도, 같은 세 꼭짓점으로 정의한 상대 가중치는 위치를 설명할 기준이 될 수 있습니다.",
      "start": 558.6525416666665,
      "end": 565.7925416666665
    },
    {
      "index": 79,
      "scene_id": "14",
      "scene_title": "삼각형의 기준을 함께 옮기기",
      "text": "꼭짓점 하나에 가까워질수록, 그 꼭짓점의 가중치는 숫자 일에 가까워집니다. 변 위의 위치는 반대편 꼭짓점의 가중치가 영입니다.",
      "start": 565.7925416666665,
      "end": 574.9525416666665
    },
    {
      "index": 80,
      "scene_id": "14",
      "scene_title": "삼각형의 기준을 함께 옮기기",
      "text": "다만 화면에서 가깝게 보이는 정도와 삼차원 공간에서의 가중치는 같다고 단정할 수 없습니다. 원근 투영이 모양을 바꾸기 때문입니다.",
      "start": 574.9525416666665,
      "end": 583.5525416666665
    },
    {
      "index": 81,
      "scene_id": "14",
      "scene_title": "삼각형의 기준을 함께 옮기기",
      "text": "지금 보이는 그래플 연결점의 실제 좌표를 추출한 것은 아닙니다. 표식은 다음 수치 예제가 무엇을 계산하는지 보여주는 기준입니다.",
      "start": 583.5525416666665,
      "end": 592.2525416666665
    },
    {
      "index": 82,
      "scene_id": "14",
      "scene_title": "삼각형의 기준을 함께 옮기기",
      "text": "이제 세 좌표에 가중치를 곱해 직접 더해 보고, 음수가 들어갔을 때 왜 삼각형 밖으로 나가는지 확인하겠습니다.",
      "start": 592.2525416666665,
      "end": 599.6900416666665
    },
    {
      "index": 83,
      "scene_id": "15",
      "scene_title": "안쪽과 바깥쪽을 직접 계산하기",
      "text": "삼차원 꼭짓점을 영, 영, 영과 육, 영, 영과 영, 사, 영으로 정하겠습니다. 모두 제트가 영인 같은 평면에 있습니다.",
      "start": 600.1400416666665,
      "end": 608.5325416666666
    },
    {
      "index": 84,
      "scene_id": "15",
      "scene_title": "안쪽과 바깥쪽을 직접 계산하기",
      "text": "가중치 영 점 이, 영 점 삼, 영 점 오는 합이 일입니다. 엑스는 육 곱하기 영 점 삼, 와이는 사 곱하기 영 점 오입니다.",
      "start": 608.5325416666666,
      "end": 614.5225416666666
    },
    {
      "index": 85,
      "scene_id": "15",
      "scene_title": "안쪽과 바깥쪽을 직접 계산하기",
      "text": "결과는 일 점 팔, 이, 영입니다. 세 가중치가 영 이상이므로 삼각형 내부입니다.",
      "start": 614.5225416666666,
      "end": 619.4425416666666
    },
    {
      "index": 86,
      "scene_id": "15",
      "scene_title": "안쪽과 바깥쪽을 직접 계산하기",
      "text": "이번에는 마이너스 영 점 이, 영 점 칠, 영 점 오를 넣겠습니다. 합은 여전히 일이지만 첫 가중치가 음수입니다.",
      "start": 619.4425416666666,
      "end": 628.2725416666666
    },
    {
      "index": 87,
      "scene_id": "15",
      "scene_title": "안쪽과 바깥쪽을 직접 계산하기",
      "text": "엑스는 사 점 이, 와이는 이이고 제트는 영입니다. 첫 꼭짓점 반대편 변을 넘어 바깥으로 나갑니다.",
      "start": 628.2725416666666,
      "end": 635.4825416666665
    },
    {
      "index": 88,
      "scene_id": "15",
      "scene_title": "안쪽과 바깥쪽을 직접 계산하기",
      "text": "좌표의 단위는 공간의 길이이고, 가중치는 비율입니다. 음수 가중치를 무조건 잘못된 계산으로 버리면, 바깥 위치를 설명하는 정보를 버리게 됩니다.",
      "start": 635.4825416666665,
      "end": 645.9000416666665
    },
    {
      "index": 89,
      "scene_id": "16",
      "scene_title": "넓이 비율에서 가중치 구하기",
      "text": "반대로 점의 위치를 알고 가중치를 구할 수도 있습니다. 점과 두 꼭짓점이 만드는 부분 삼각형 넓이를 전체 넓이로 나눕니다.",
      "start": 646.3500416666666,
      "end": 654.4325416666666
    },
    {
      "index": 90,
      "scene_id": "16",
      "scene_title": "넓이 비율에서 가중치 구하기",
      "text": "가중치 영 점 이, 영 점 삼, 영 점 오인 내부 점에서는 세 부분의 넓이가 전체의 이십, 삼십, 오십 퍼센트입니다.",
      "start": 654.4325416666666,
      "end": 662.2225416666665
    },
    {
      "index": 91,
      "scene_id": "16",
      "scene_title": "넓이 비율에서 가중치 구하기",
      "text": "중요한 것은 같은 꼭짓점 순서로 구한 부호 있는 넓이를 쓰는 것입니다. 절댓값만 쓰면 바깥쪽의 음수를 잃습니다.",
      "start": 662.2225416666665,
      "end": 669.5525416666666
    },
    {
      "index": 92,
      "scene_id": "16",
      "scene_title": "넓이 비율에서 가중치 구하기",
      "text": "점이 첫 꼭짓점 반대편으로 넘어가면 그 부분의 부호가 뒤집히며 첫 가중치가 음수가 됩니다.",
      "start": 669.5525416666666,
      "end": 675.7025416666665
    },
    {
      "index": 93,
      "scene_id": "16",
      "scene_title": "넓이 비율에서 가중치 구하기",
      "text": "전체 삼각형의 부호를 뒤집어도 분자와 분모가 함께 뒤집혀 같은 가중치가 나옵니다. 순서를 일관되게 쓰세요.",
      "start": 675.7025416666665,
      "end": 682.8625416666666
    },
    {
      "index": 94,
      "scene_id": "16",
      "scene_title": "넓이 비율에서 가중치 구하기",
      "text": "전체 넓이가 영이면 나눌 수 없습니다. 너무 가느다란 삼각형도 작은 좌표 오차를 큰 가중치 오차로 키울 수 있습니다.",
      "start": 682.8625416666666,
      "end": 690.4300416666666
    },
    {
      "index": 95,
      "scene_id": "17",
      "scene_title": "높이가 다른 표면을 한 그림으로 보면",
      "text": "캐릭터가 다른 높이의 발판을 오가고, 멀리 있는 발판도 같은 화면에 들어옵니다. 보이는 겹침과 실제 같은 표면은 구분하세요.",
      "start": 690.8800416666667,
      "end": 699.1125416666666
    },
    {
      "index": 96,
      "scene_id": "17",
      "scene_title": "높이가 다른 표면을 한 그림으로 보면",
      "text": "이차원 게임 화면에서는 위치가 두 성분으로 보이지만, 삼차원 게임이라면 깊이가 다른 점이 화면에서 겹칠 수도 있습니다.",
      "start": 699.1125416666666,
      "end": 706.7125416666667
    },
    {
      "index": 97,
      "scene_id": "17",
      "scene_title": "높이가 다른 표면을 한 그림으로 보면",
      "text": "삼각형 안처럼 보이는 투영 위치만으로 삼차원 표면 위에 있다고 판단하면 오류가 납니다.",
      "start": 706.7125416666667,
      "end": 712.3125416666667
    },
    {
      "index": 98,
      "scene_id": "17",
      "scene_title": "높이가 다른 표면을 한 그림으로 보면",
      "text": "평면까지의 거리 검사와 그 평면 안에서의 가중치 검사를 따로 하면 이 두 질문을 나눌 수 있습니다.",
      "start": 712.3125416666667,
      "end": 718.3425416666666
    },
    {
      "index": 99,
      "scene_id": "17",
      "scene_title": "높이가 다른 표면을 한 그림으로 보면",
      "text": "또한 물체가 발판의 경계를 지나가면 같은 평면 높이더라도 발판 밖입니다. 넓이 비율의 음수 가중치를 기억하세요.",
      "start": 718.3425416666666,
      "end": 726.0825416666667
    },
    {
      "index": 100,
      "scene_id": "17",
      "scene_title": "높이가 다른 표면을 한 그림으로 보면",
      "text": "다음 그림에서는 투영 위치는 똑같고 깊이만 다른 두 점을 나란히 놓아 이 오류를 확인합니다.",
      "start": 726.0825416666667,
      "end": 732.0000416666667
    },
    {
      "index": 101,
      "scene_id": "18",
      "scene_title": "투영은 평면 위 검사까지 해주지 않습니다",
      "text": "아까 내부 점은 일 점 팔, 이, 영입니다. 이번에는 엑스와 와이는 그대로 두고 제트만 칠로 바꿉니다.",
      "start": 732.4500416666667,
      "end": 738.4125416666667
    },
    {
      "index": 102,
      "scene_id": "18",
      "scene_title": "투영은 평면 위 검사까지 해주지 않습니다",
      "text": "엑스 와이 평면으로 보면 두 점은 같은 위치입니다. 하지만 제트가 칠인 점은 삼각형 평면에서 칠만큼 떨어져 있습니다.",
      "start": 738.4125416666667,
      "end": 747.2525416666667
    },
    {
      "index": 103,
      "scene_id": "18",
      "scene_title": "투영은 평면 위 검사까지 해주지 않습니다",
      "text": "투영해서 가중치를 계산할 때는 법선의 절댓값이 가장 큰 성분의 좌표를 버리면 안정적인 면을 고르기 쉽습니다.",
      "start": 747.2525416666667,
      "end": 754.8625416666667
    },
    {
      "index": 104,
      "scene_id": "18",
      "scene_title": "투영은 평면 위 검사까지 해주지 않습니다",
      "text": "그렇다고 버린 좌표가 중요하지 않은 것은 아닙니다. 먼저 평면까지의 거리를 검사하고, 투영한 좌표로 내부 여부를 검사하세요.",
      "start": 754.8625416666667,
      "end": 762.4525416666668
    },
    {
      "index": 105,
      "scene_id": "18",
      "scene_title": "투영은 평면 위 검사까지 해주지 않습니다",
      "text": "평면과 충분히 가깝다고 볼 허용 오차는 공간의 단위와 크기에 맞춰 정합니다. 무게중심 가중치의 오차는 별도의 비율 단위입니다.",
      "start": 762.4525416666668,
      "end": 770.8125416666667
    },
    {
      "index": 106,
      "scene_id": "18",
      "scene_title": "투영은 평면 위 검사까지 해주지 않습니다",
      "text": "입력 좌표가 유한한지, 법선과 넓이 분모가 유효한지도 확인합니다. 내부 판정 하나가 모든 입력 검증을 대신하지 않습니다.",
      "start": 770.8125416666667,
      "end": 778.8500416666667
    },
    {
      "index": 107,
      "scene_id": "19",
      "scene_title": "가까운 모서리 세 개를 함께 추적하기",
      "text": "노이타에서 좁은 발판과 기울어진 지형 사이로 이동합니다. 가까운 세 모서리를 골라 같이 추적해 보세요.",
      "start": 779.3000416666667,
      "end": 786.1025416666668
    },
    {
      "index": 108,
      "scene_id": "19",
      "scene_title": "가까운 모서리 세 개를 함께 추적하기",
      "text": "세 점을 연결한 삼각형이 가늘어지면, 작은 이동도 가중치의 큰 변화로 나타날 수 있습니다.",
      "start": 786.1025416666668,
      "end": 791.8725416666667
    },
    {
      "index": 109,
      "scene_id": "19",
      "scene_title": "가까운 모서리 세 개를 함께 추적하기",
      "text": "넓이가 거의 영인 기준을 쓰면 세 숫자가 계산돼도 안정적이라는 보장은 없습니다. 수치와 입력 모양을 함께 봐야 합니다.",
      "start": 791.8725416666667,
      "end": 799.6125416666667
    },
    {
      "index": 110,
      "scene_id": "19",
      "scene_title": "가까운 모서리 세 개를 함께 추적하기",
      "text": "지형이 바뀌거나 기준점이 다른 곳으로 바뀌면 같은 가중치도 다른 위치를 뜻합니다. 위치와 기준 삼각형은 한 쌍입니다.",
      "start": 799.6125416666667,
      "end": 807.3225416666668
    },
    {
      "index": 111,
      "scene_id": "19",
      "scene_title": "가까운 모서리 세 개를 함께 추적하기",
      "text": "실제 화면의 경계에는 오목한 부분과 빈 공간이 있습니다. 세 기준점 사이를 채운 수학 삼각형이 지형 전체를 대신하지 않습니다.",
      "start": 807.3225416666668,
      "end": 815.7425416666667
    },
    {
      "index": 112,
      "scene_id": "19",
      "scene_title": "가까운 모서리 세 개를 함께 추적하기",
      "text": "오늘의 계산은 한 평면과 한 삼각형에 관한 것입니다. 더 복잡한 경계를 여러 삼각형으로 나누는 문제는 다음 편에서 다룹니다.",
      "start": 815.7425416666667,
      "end": 823.3800416666668
    },
    {
      "index": 113,
      "scene_id": "20",
      "scene_title": "같은 가중치로 색도 보간하기",
      "text": "무게중심 좌표는 위치만 만들지 않습니다. 세 꼭짓점에 다른 값을 주면 같은 가중치로 그 값도 섞을 수 있습니다.",
      "start": 823.8300416666668,
      "end": 831.3725416666668
    },
    {
      "index": 114,
      "scene_id": "20",
      "scene_title": "같은 가중치로 색도 보간하기",
      "text": "첫 꼭짓점에 빨강, 둘째에 초록, 셋째에 파랑을 주겠습니다. 단순한 선형 색 예제입니다.",
      "start": 831.3725416666668,
      "end": 837.8625416666669
    },
    {
      "index": 115,
      "scene_id": "20",
      "scene_title": "같은 가중치로 색도 보간하기",
      "text": "가중치 영 점 이, 영 점 삼, 영 점 오를 쓰면 색 세 성분도 영 점 이, 영 점 삼, 영 점 오가 됩니다.",
      "start": 837.8625416666669,
      "end": 843.6125416666669
    },
    {
      "index": 116,
      "scene_id": "20",
      "scene_title": "같은 가중치로 색도 보간하기",
      "text": "변의 중간에서는 두 꼭짓점의 값을 반씩 섞고, 꼭짓점에서는 그 꼭짓점의 값이 그대로 나옵니다.",
      "start": 843.6125416666669,
      "end": 850.0125416666668
    },
    {
      "index": 117,
      "scene_id": "20",
      "scene_title": "같은 가중치로 색도 보간하기",
      "text": "높이, 텍스처 좌표처럼 꼭짓점마다 정의한 다른 속성도 같은 방식으로 보간할 수 있습니다. 정규화가 필요한 방향은 보간 뒤 다시 확인합니다.",
      "start": 850.0125416666668,
      "end": 861.3325416666669
    },
    {
      "index": 118,
      "scene_id": "20",
      "scene_title": "같은 가중치로 색도 보간하기",
      "text": "지금은 삼각형 표면의 아핀 보간입니다. 원근 투영된 화면의 가중치를 그대로 쓰는 문제는 뒤의 렌더링에서 따로 다룹니다.",
      "start": 861.3325416666669,
      "end": 869.3500416666668
    },
    {
      "index": 119,
      "scene_id": "21",
      "scene_title": "표면의 위치와 색을 함께 보기",
      "text": "시리어스 샘 투의 색이 다른 지붕과 벽을 보세요. 같은 물체 표면에서도 위치에 따라 눈에 들어오는 색과 밝기가 다릅니다.",
      "start": 869.8000416666669,
      "end": 876.9125416666668
    },
    {
      "index": 120,
      "scene_id": "21",
      "scene_title": "표면의 위치와 색을 함께 보기",
      "text": "표면 위의 위치를 구한 뒤 그 위치의 속성을 구한다는 두 단계가 그래픽스의 중요한 질문입니다.",
      "start": 876.9125416666668,
      "end": 884.2025416666669
    },
    {
      "index": 121,
      "scene_id": "21",
      "scene_title": "표면의 위치와 색을 함께 보기",
      "text": "삼각형의 꼭짓점마다 값을 저장했다면 아까의 가중치로 중간 값을 만들 수 있습니다. 이것은 우리가 정의한 수학적 예제입니다.",
      "start": 884.2025416666669,
      "end": 891.9725416666669
    },
    {
      "index": 122,
      "scene_id": "21",
      "scene_title": "표면의 위치와 색을 함께 보기",
      "text": "실제 화면의 색은 텍스처와 조명, 효과 등 여러 요인의 결과일 수 있습니다. 이 영상만으로 꼭짓점 색 보간을 쓴다고 확인한 것은 아닙니다.",
      "start": 891.9725416666669,
      "end": 900.6225416666668
    },
    {
      "index": 123,
      "scene_id": "21",
      "scene_title": "표면의 위치와 색을 함께 보기",
      "text": "카메라가 움직여도 같은 표면의 기준 위치를 유지해야 합니다. 화면 좌표와 물체 표면 좌표를 섞지 않는 것이 중요합니다.",
      "start": 900.6225416666668,
      "end": 908.3725416666668
    },
    {
      "index": 124,
      "scene_id": "21",
      "scene_title": "표면의 위치와 색을 함께 보기",
      "text": "마지막 문제에서는 평면의 거리와 삼각형 가중치를 함께 검증합니다. 어디에 있는지를 먼저 확인하고, 그 위치의 속성을 계산하세요.",
      "start": 908.3725416666668,
      "end": 916.9200416666669
    },
    {
      "index": 125,
      "scene_id": "22",
      "scene_title": "거리·평면·가중치를 함께 확인하기",
      "text": "첫 문제입니다. 법선의 세 성분은 영, 이, 영이고, 상수 디의 값은 사입니다. 이 평면에서 점 사, 오, 마이너스 삼까지의 거리는 얼마일까요?",
      "start": 917.3700416666669,
      "end": 926.9325416666669
    },
    {
      "index": 126,
      "scene_id": "22",
      "scene_title": "거리·평면·가중치를 함께 확인하기",
      "text": "식의 값은 육이지만 법선 길이 이로 나누어 거리는 삼입니다. 가장 가까운 평면 점은 사, 이, 마이너스 삼입니다.",
      "start": 926.9325416666669,
      "end": 934.8425416666669
    },
    {
      "index": 127,
      "scene_id": "22",
      "scene_title": "거리·평면·가중치를 함께 확인하기",
      "text": "둘째는 제트가 영인 삼각형입니다. 가중치 영 점 이, 영 점 삼, 영 점 오가 만드는 점은 일 점 팔, 이, 영입니다.",
      "start": 934.8425416666669,
      "end": 942.7725416666669
    },
    {
      "index": 128,
      "scene_id": "22",
      "scene_title": "거리·평면·가중치를 함께 확인하기",
      "text": "엑스와 와이는 같고 제트가 칠인 점은 투영 위치만 같습니다. 평면 밖이므로 표면 내부라는 판정을 하면 안 됩니다.",
      "start": 942.7725416666669,
      "end": 950.3025416666669
    },
    {
      "index": 129,
      "scene_id": "22",
      "scene_title": "거리·평면·가중치를 함께 확인하기",
      "text": "계산 순서는 유효한 입력, 평면까지의 거리, 삼각형의 가중치, 원하는 속성입니다. 단계마다 단위와 허용 오차도 확인하세요.",
      "start": 950.3025416666669,
      "end": 959.2025416666669
    },
    {
      "index": 130,
      "scene_id": "22",
      "scene_title": "거리·평면·가중치를 함께 확인하기",
      "text": "오늘은 평면의 방향과 위치, 거리와 투영, 삼각형 넓이와 무게중심 좌표를 연결했습니다. 다음 편에서는 서로 다른 중심과 다각형 분할을 설명하겠습니다.",
      "start": 959.2025416666669,
      "end": 970.2500416666669
    }
  ]
}
