{
  "schemaVersion": 2,
  "slug": "{{SLUG}}",
  "status": "planning",
  "delivery": {
    "directory": "output/{{SLUG}}",
    "collector": "node scripts/collect-video-output.cjs {{SLUG}}",
    "required": [
      "captioned.mp4",
      "clean.mp4",
      "ko.srt",
      "en.srt"
    ],
    "preserveSources": true
  },
  "membershipOutro": {
    "enabled": true,
    "durationSeconds": 10,
    "rosterPath": "motion-canvas/src/shared/membership/members.json",
    "scenePath": "motion-canvas/src/shared/membership/membership-outro.tsx",
    "appliedToFinal": false
  },
  "visualStyle": "research-paper-white-v1",
  "visualStyleGuide": "docs/VIDEO_VISUAL_STYLE.md",
  "editing": {
    "exampleSeconds": 19.5,
    "exampleSecondsPolicy": "planning-baseline-only; actual scene slots follow measured narration and body-wide footage ratio",
    "targetGameplayShare": 0.6,
    "targetExplanationShare": 0.4,
    "gameplayShareRange": [
      0.6,
      0.6
    ],
    "ratioScope": "body-excluding-channel-intro-and-membership-outro",
    "ratioPolicy": "actual action footage 60% / PPT and explanation 40%; concept-matched examples throughout main chapters; one-frame rounding only",
    "ratioPolicyVersion": "actual-footage-60-explanation-40-v2",
    "ratioRoundingToleranceFrames": 1,
    "ratioApprovedAt": "2026-10-01",
    "footageClassification": {
      "actualFootage": "visible gameplay/editor/debugger/profiler/playtest actions demonstrating the chapter",
      "explanation": "2.5D diagrams, timelines, numerical comparisons, text slides and diagram-like executable tests, including recorded MP4s",
      "classifyBy": "dominant visible screen role, not file type or executability",
      "noDoubleCountingOverlays": true
    },
    "exampleInterleaving": {
      "required": true,
      "placement": "throughout main explanation chapters; observe action, explain principle, verify application",
      "planningPath": "projects/{{SLUG}}/planning/outline.md",
      "requiredEvidence": [
        "explained claim",
        "source and in/out",
        "visible action",
        "viewer focus",
        "connection to PPT",
        "insertion point"
      ],
      "reviewStatus": "pending all-chapter action-to-explanation review"
    },
    "actualGameplaySeconds": null,
    "actualExplanationSeconds": null,
    "actualGameplayShare": null,
    "actualCommercialGameplaySeconds": null,
    "actualDevelopmentFootageSeconds": null,
    "actualPrototypeExplanationSeconds": null,
    "explanationStyle": "2.5d-comparisons-arrows-and-animated-emphasis-white-research-theme",
    "memeSeconds": 0,
    "preserveExplanationTime": true,
    "exampleExpansion": {
      "preserveExplanationContent": true,
      "preserveApprovedOriginalNarration": true,
      "method": "add concept-matched action footage and new KO/EN commentary between existing explanations; increase runtime",
      "planningFormula": "additionalActualSeconds = max(0, 1.5 * retainedExplanationSeconds - retainedActualSeconds)",
      "updateTogether": [
        "narration",
        "mix",
        "scene starts",
        "KO SRT",
        "EN SRT",
        "chapters",
        "membership outro"
      ]
    },
    "timingStatus": "pending-media-and-narration",
    "narrationPlacement": "continuous-across-example-and-explanation",
    "captionPresentation": "clean-master-and-approved-boxed-ko-caption-version-with-ko-en-srt",
    "captionStyle": {
      "id": "boxed-white-forest-v1",
      "scope": "channel-default-for-new-videos",
      "guide": "docs/CAPTION_STYLE.md",
      "approvedAt": "2026-09-19",
      "approvalEvidence": "응 이렇게 만들어줘 ㄱㄱ; 그리고 이 자막스타일 기억해줘~",
      "placement": {
        "anchor": "bottom-center",
        "centerPx": [
          960,
          970
        ],
        "referenceResolution": [
          1920,
          1080
        ],
        "motionCanvasCenter": [
          0,
          430
        ],
        "applyTo": "all-narrated-footage-and-explanation-scenes",
        "doNotRelocateToAvoidOverlap": true,
        "overlapRemedy": "recompose-footage-or-split-cues",
        "playerSrtPosition": "viewer-controlled"
      },
      "placementApprovedAt": "2026-10-02",
      "placementApprovalEvidence": "과외에는 링크 걸어주고 영상 마지막에 항상 걸어줘 그리고 또 고정댓글로 달아줘 ... 영상제작 진행해줘 자막은 항상 가운데 아래로 해주고 이규칙은 영상제작 규칙에 추가해서 업데이트해줘"
    },
    "outro": {
      "kind": "membership-thanks",
      "seconds": 10,
      "title": "멤버쉽가입 감사드립니다.",
      "guide": "docs/MEMBERSHIP_OUTRO.md",
      "members": "motion-canvas/src/shared/membership/members.json",
      "scene": "membership-outro",
      "narration": false,
      "subtitles": false
    }
  },
  "titles": {
    "ko": "{{TITLE_KO}}",
    "en": "{{TITLE_EN}}"
  },
  "video": {
    "width": 1920,
    "height": 1080,
    "fps": 60,
    "durationSeconds": null
  },
  "engines": [
    "motion-canvas",
    "manim"
  ],
  "tts": {
    "engine": "qwen3-tts",
    "language": "Korean",
    "reference": "shared/voice-reference/reference-15-35s.wav",
    "referenceText": "shared/voice-reference/reference-15-35s.ko.txt",
    "model": "qwen3-tts/models/Qwen3-TTS-12Hz-1.7B-Base",
    "outputDir": "shared/output/narration/{{SLUG}}/qwen3-1.7b-balanced-v1",
    "filenameStem": "{{SLUG}}-qwen3-1.7b-balanced-v1",
    "renderMode": "scene",
    "sceneGapSeconds": 0.72,
    "tailRatioThreshold": 0.07,
    "tailDecayMsThreshold": 70,
    "maxRenderAttempts": 3,
    "maxNewTokens": 1024,
    "edgeFadeSeconds": 0.006
  },
  "audio": {
    "mixStatus": "waiting-for-music-approval",
    "narrationTargetLufs": -16,
    "truePeakDbtp": -1.5,
    "gameAudioUnderNarrationDb": -10,
    "bgmUnderNarrationDb": -15,
    "duckingDb": -3,
    "gameAudioTargetLufs": -23,
    "bgmTargetLufs": -28,
    "bgmPlacement": "continuous",
    "bgmDuringGameplayDb": -3,
    "bgmLoopCrossfadeSeconds": 1,
    "duckingThreshold": 0.08,
    "duckingRatio": 2.2,
    "musicFallbackScenes": [],
    "backgroundMusic": {
      "required": true,
      "approvalStatus": "pending",
      "title": null,
      "artist": null,
      "source": null,
      "license": null,
      "attribution": null,
      "file": null
    }
  },
  "paths": {
    "script": "projects/{{SLUG}}/script/narration.ko.json",
    "sources": "projects/{{SLUG}}/sources/SOURCES.md",
    "publishingKo": "projects/{{SLUG}}/publishing/youtube.ko.md",
    "publishingEn": "projects/{{SLUG}}/publishing/youtube.en.md",
    "audioReport": "projects/{{SLUG}}/audio/mix-report.md",
    "audioMix": "motion-canvas/src/projects/{{SLUG}}/assets/final-mix.m4a",
    "motionCanvasProject": "motion-canvas/src/projects/{{SLUG}}/project.ts",
    "manimProject": "manim/projects/{{SLUG}}/scene.py",
    "narration": "shared/output/narration/{{SLUG}}/qwen3-1.7b-balanced-v1/{{SLUG}}-qwen3-1.7b-balanced-v1.wav",
    "captionsKo": "shared/output/narration/{{SLUG}}/qwen3-1.7b-balanced-v1/{{SLUG}}-qwen3-1.7b-balanced-v1.srt",
    "captionsEn": "shared/output/narration/{{SLUG}}/qwen3-1.7b-balanced-v1/{{SLUG}}-qwen3-1.7b-balanced-v1.en.srt",
    "videoClean": "shared/output/motion-canvas/{{SLUG}}.mp4",
    "videoBurnedCaptions": "shared/output/motion-canvas/{{SLUG}}-subtitled.mp4"
  },
  "publishing": {
    "coachingEndingLinkRequired": true,
    "pinnedCoachingCommentRequired": true,
    "defaults": "shared/publishing/youtube-defaults.json"
  }
}
